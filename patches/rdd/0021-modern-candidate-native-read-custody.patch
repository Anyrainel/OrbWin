+	f := &runtimeImageOpenFrame{owner: i, output: &i.handles[0]}
+	if f.original() || f.entryReady() {
+		t.Fatal("local clean fields are not native admission")
+	}
+	if cap.closedForAuthority(n) {
+		t.Fatal("pending derivative releases parent")
+	}
+	i.state.complete = true
+	i.state.closeAttempted = true
+	i.state.closed = true
+	i.closeErr = nil
+	// This predicate reports cached release facts only; it is not native admission.
+	if !cap.closedForAuthority(n) {
+		t.Fatal("known closed cached edge")
+	}
+	copyCap := *cap
+	if copyCap.closedForAuthority(n) {
+		t.Fatal("copied wrapper")
+	}
+	i.state.unknown = true
+	if cap.closedForAuthority(n) {
+		t.Fatal("unknown releases parent")
+	}
+	i.state.unknown = false
+	i.closeErr = ErrUpgrade
+	if cap.closedForAuthority(n) {
+		t.Fatal("failed close releases parent")
+	}
+	if f.entryReady() {
+		t.Fatal("closed original cannot enter native call")
+	}
+}
