+func TestModernCandidateNativeOriginalGuards(t *testing.T) {
+	var zero *nativeModernIncomingCandidateImage
+	if zero.originalHeld() || zero.ownsRuntimeImageOpenFrame(&runtimeImageOpenFrame{}) {
+		t.Fatal("nil original")
+	}
+	n := &nativeManagedRuntimeAuthority{}
