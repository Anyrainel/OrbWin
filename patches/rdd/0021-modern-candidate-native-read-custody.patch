+// Parent-side cached facts only. Never acquire image.mu from authority.mu.
+func (cap *ModernIncomingCandidateImage) closedForAuthority(n *nativeManagedRuntimeAuthority) bool {
+	if cap == nil || cap.native == nil || n == nil {
+		return false
+	}
+	i := cap.native
+	return i.self == cap && i.authority == n && n.modernCandidateImage == cap && i.oldSelf == n.modernSelfLease && i.image == n.image && i.state.closeAttempted && i.state.closed && !i.state.unknown && i.closeErr == nil
+}
+func (cap *ModernIncomingCandidateImage) Close() (result error) {
+	if cap == nil || cap.native == nil {
+		return ErrUpgrade
+	}
+	i := cap.native
+	n := i.authority
+	if i.self != cap || n == nil || n.publisher == nil || n.created == nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.modernCandidateImage != cap || i.image != n.image || i.oldSelf != n.modernSelfLease {
+		return ErrUpgrade
+	}
+	if i.state.closeAttempted {
+		return i.closeErr
+	}
+	if !n.admitted() || !i.state.beginClose() {
+		return ErrUpgrade
+	}
+	result = ErrUpgrade
+	i.closeErr = ErrUpgrade
+	defer func() {
+		if recover() != nil {
+			i.fence()
+			result = ErrUpgrade
+		}
+		runtime.KeepAlive(cap)
+	}()
+	for index := len(i.handles) - 1; index >= 0; index-- {
+		i.closeIndex = index
+		if i.handles[index] == 0 {
+			continue
+		}
+		if i.handles[index] == windows.InvalidHandle {
+			i.fence()
+			return ErrUpgrade
+		}
+		i.closeErr = windows.CloseHandle(i.handles[index])
+		if i.closeErr != nil {
+			i.closeErr = ErrUpgrade
+			i.fence()
+			return ErrUpgrade
+		}
+		i.closeErr = ErrUpgrade // prearm next effect / panic; never publish transient nil
+	}
+	if !i.state.finishClose(true) {
+		i.fence()
+		return ErrUpgrade
+	}
+	i.closeErr = nil
+	return nil
+}
