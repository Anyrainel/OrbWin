+package main
+
+import (
+	"context"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+	"time"
+)
+
+func TestRuntimeSetupRawClosedRoute(t *testing.T) {
+	for _, v := range []struct {
+		args []string
+		want runtimeSetupRoute
+	}{
+		{nil, runtimeSetupUnrequested}, {[]string{"service", "start"}, runtimeSetupUnrequested},
+		{[]string{"private-runtime-operation", "preflight"}, runtimeSetupUnrequested},
+		{[]string{"private-runtime-operation", "setup"}, runtimeSetupRequested},
+		{[]string{"private-runtime-operation"}, runtimeSetupRefused},
+		{[]string{"private-runtime-operation", "resume"}, runtimeSetupRefused},
+		{[]string{"private-runtime-operation", "setup", "--instance=other"}, runtimeSetupRefused},
+		{[]string{"private-runtime-operation", "setup", "C:\\other"}, runtimeSetupRefused},
+	} {
+		if classifyRuntimeSetup(v.args) != v.want {
+			t.Fatalf("route mismatch %q", v.args)
+		}
+	}
+}
+
+func TestRuntimeSetupContextRefusal(t *testing.T) {
+	if runtimeSetupContextKnown(nil) || runtimeSetupContextKnown(context.Background()) {
+		t.Fatal("unbounded context")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	if !runtimeSetupContextKnown(ctx) {
+		t.Fatal("bounded context refused")
+	}
+	cancel()
+	if runtimeSetupContextKnown(ctx) {
+		t.Fatal("cancelled context")
+	}
+}
+
+// Parse actual main source, without importing/executing its provider graph.
+func TestRuntimeSetupActualMainPrecedesInstanceAndEnvironment(t *testing.T) {
+	f, e := parser.ParseFile(token.NewFileSet(), "main.go", nil, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var body *ast.BlockStmt
+	for _, d := range f.Decls {
+		if fn, ok := d.(*ast.FuncDecl); ok && fn.Name.Name == "main" {
+			body = fn.Body
+		}
+	}
+	if body == nil || len(body.List) == 0 {
+		t.Fatal("main absent")
+	}
+	first, ok := body.List[0].(*ast.IfStmt)
+	if !ok {
+		t.Fatal("early role not first")
+	}
+	assign, ok := first.Init.(*ast.AssignStmt)
+	if !ok || len(assign.Rhs) != 1 {
+		t.Fatal("early call shape")
+	}
+	call, ok := assign.Rhs[0].(*ast.CallExpr)
+	if !ok {
+		t.Fatal("early call absent")
+	}
+	name, ok := call.Fun.(*ast.Ident)
+	if !ok || name.Name != "earlyRuntimeSetup" {
+		t.Fatal("instance/environment reachable before role")
+	}
+}
