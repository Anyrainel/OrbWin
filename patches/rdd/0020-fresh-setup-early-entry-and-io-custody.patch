@@ -0,0 +1,36 @@
+//go:build windows
+
+package main
+
+import (
+	"context"
+	service "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd"
+	"io"
+	"time"
+)
+
+func earlyRuntimeSetup(args []string, input io.Reader, output io.Writer) (bool, int) {
+	switch classifyRuntimeSetup(args) {
+	case runtimeSetupUnrequested:
+		return false, 0
+	case runtimeSetupRefused:
+		return true, 2
+	}
+	// Acquisition/protocol startup budget only. The existing SAME service owns
+	// its lifetime; post-Begin observer EOF/deadline cannot kill healthy actors.
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Minute)
+	defer cancel()
+	return runEarlyRuntimeSetup(ctx, input, output)
+}
+
+func runEarlyRuntimeSetup(ctx context.Context, input io.Reader, output io.Writer) (bool, int) {
+	if !runtimeSetupContextKnown(ctx) || input == nil || output == nil {
+		return true, 2
+	}
+	// This producer returns ONLY after original workers/owners positively settle;
+	// unknown is retained inside it. No caller error or EOF grants retirement.
+	if service.RunFreshSetupOperation(ctx, input, output) != nil {
+		return true, 2
+	}
+	return true, 0
+}
