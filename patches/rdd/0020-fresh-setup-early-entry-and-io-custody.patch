diff --git a/rdd/pkg/service/cmd/private_authority_failure_model.go b/rdd/pkg/service/cmd/private_authority_failure_model.go
new file mode 100644
index 0000000000000000000000000000000000000000..2887ed07d7b33355e7d9bd980c9f41a498feacb3
--- /dev/null
+++ b/rdd/pkg/service/cmd/private_authority_failure_model.go
@@ -0,0 +1,21 @@
+package service
+
+// Failure-only DATA ledger. Actual producer calls its concrete Close once;
+// a false/panic result cannot reset the attempt or permit suffix cleanup.
+type privateAuthorityFailureClose struct{ entered, returned, positive bool }
+
+func (s *privateAuthorityFailureClose) begin() bool {
+	if s.entered {
+		return false
+	}
+	s.entered = true
+	return true
+}
+func (s *privateAuthorityFailureClose) complete(positive bool) bool {
+	if !s.entered || s.returned {
+		return false
+	}
+	s.returned = true
+	s.positive = positive
+	return positive
+}
diff --git a/rdd/pkg/service/cmd/private_authority_failure_model_test.go b/rdd/pkg/service/cmd/private_authority_failure_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d653d8849b120d53e5e671ee66c394e59f2c20c
--- /dev/null
+++ b/rdd/pkg/service/cmd/private_authority_failure_model_test.go
@@ -0,0 +1,23 @@
+package service
+
+import "testing"
+
+func TestPrivateAuthorityFailureCloseStopsUnknownAndReplay(t *testing.T) {
+	for _, positive := range []bool{false, true} {
+		var s privateAuthorityFailureClose
+		if !s.begin() || s.begin() || s.complete(positive) != positive || s.begin() || s.complete(true) {
+			t.Fatal("failure close replay")
+		}
+		if !s.entered || !s.returned || s.positive != positive {
+			t.Fatal("lost actual result")
+		}
+	}
+	var before privateAuthorityFailureClose
+	if before.complete(true) || before.entered || before.returned {
+		t.Fatal("completion before Close")
+	}
+	var panicCut privateAuthorityFailureClose
+	if !panicCut.begin() || panicCut.returned || panicCut.positive || panicCut.begin() {
+		t.Fatal("panic attempt reset")
+	}
+}
