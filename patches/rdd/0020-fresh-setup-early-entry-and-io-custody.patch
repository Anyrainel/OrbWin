diff --git a/rdd/pkg/service/cmd/fresh_setup_io_model.go b/rdd/pkg/service/cmd/fresh_setup_io_model.go
new file mode 100644
index 0000000000000000000000000000000000000000..1e3165f5c034aebc2aeb79cca1f4e865a2e23c43
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_io_model.go
@@ -0,0 +1,64 @@
+package service
+
+import (
+	"errors"
+	"io"
+)
+
+// Ordering DATA only. Actual original files/workers remain in the Windows owner.
+type freshIOPhase uint8
+
+const (
+	freshIOJoinOutput freshIOPhase = iota
+	freshIOCloseOutput
+	freshIOJoinInput
+	freshIOCloseInput
+	freshIOComplete
+)
+
+type freshIOSettlement struct {
+	phase   freshIOPhase
+	unknown bool
+	active  bool
+}
+
+func (s *freshIOSettlement) begin(step freshIOPhase) bool {
+	if s == nil || s.unknown || s.active || s.phase != step || step >= freshIOComplete {
+		if s != nil {
+			s.unknown = true
+		}
+		return false
+	}
+	s.active = true
+	return true
+}
+
+func (s *freshIOSettlement) complete(step freshIOPhase, positive bool) bool {
+	if s == nil || s.unknown || !s.active || s.phase != step || step >= freshIOComplete || !positive {
+		if s != nil {
+			s.unknown = true
+		}
+		return false
+	}
+	s.active = false
+	s.phase++
+	return true
+}
+
+// ReadFull can synthesize UnexpectedEOF from completed EOF. The concrete reader
+// records its own File.Read error; a malformed/partial wire is not kernel unknown.
+func freshIOReadKnown(n, size int, err error) bool {
+	return size > 0 && size <= 128 && n >= 0 && n <= size &&
+		(err == nil && n > 0 || errors.Is(err, io.EOF))
+}
+
+func freshIOWriteKnown(n, size int, err error) bool {
+	return size > 0 && size <= 257 && err == nil && n == size
+}
+
+// A panic during an entered close/join cannot reset or permit a suffix.
+func (s *freshIOSettlement) panicUnknown() {
+	if s != nil {
+		s.unknown = true
+	}
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_io_model_test.go b/rdd/pkg/service/cmd/fresh_setup_io_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b72a3d895bddebcabd76e5a70ee7aacd6a77f1bd
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_io_model_test.go
@@ -0,0 +1,114 @@
+package service
+
+import (
+	"errors"
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestFreshIOSettlementStopFirstAndNoLateReset(t *testing.T) {
+	for fail := freshIOJoinOutput; fail < freshIOComplete; fail++ {
+		var s freshIOSettlement
+		for step := freshIOJoinOutput; step < freshIOComplete; step++ {
+			if !s.begin(step) {
+				t.Fatal("begin prefix")
+			}
+			if step == fail {
+				if s.complete(step, false) || s.complete(step, true) {
+					t.Fatal("unknown replayed")
+				}
+				break
+			}
+			if !s.complete(step, true) {
+				t.Fatal("positive prefix refused")
+			}
+		}
+		if !s.unknown || s.phase == freshIOComplete || s.complete(freshIOCloseInput, true) {
+			t.Fatal("suffix escaped")
+		}
+	}
+	var bad freshIOSettlement
+	if bad.complete(freshIOCloseOutput, true) || !bad.unknown {
+		t.Fatal("close before writer join")
+	}
+	var good freshIOSettlement
+	for step := freshIOJoinOutput; step < freshIOComplete; step++ {
+		if !good.begin(step) || !good.complete(step, true) {
+			t.Fatal("known sequence")
+		}
+	}
+	if good.phase != freshIOComplete || good.unknown || good.complete(freshIOCloseInput, true) {
+		t.Fatal("completion replay")
+	}
+}
+
+func TestFreshIOCompletedEOFAndWireCutsDifferFromNativeUnknown(t *testing.T) {
+	for _, v := range []struct {
+		n, size int
+		e       error
+		known   bool
+	}{
+		{4, 4, nil, true}, {1, 4, nil, true}, {0, 4, io.EOF, true}, {2, 4, io.EOF, true},
+		{0, 4, nil, false}, {5, 4, nil, false}, {-1, 4, nil, false}, {1, 129, nil, false},
+		{0, 4, errors.New("native uncertainty"), false},
+	} {
+		if freshIOReadKnown(v.n, v.size, v.e) != v.known {
+			t.Fatal("read classification")
+		}
+	}
+	for _, v := range []struct {
+		n, size int
+		e       error
+		known   bool
+	}{{3, 3, nil, true}, {2, 3, nil, false}, {3, 3, io.ErrClosedPipe, false}, {0, 0, nil, false}} {
+		if freshIOWriteKnown(v.n, v.size, v.e) != v.known {
+			t.Fatal("write classification")
+		}
+	}
+}
+
+func TestFreshIOReadFullPartialWireIsCompletedEOF(t *testing.T) {
+	data := strings.NewReader("ab")
+	var buffer [4]byte
+	n, e := io.ReadFull(data, buffer[:])
+	if n != 2 || !errors.Is(e, io.ErrUnexpectedEOF) {
+		t.Fatal("partial frame expectation")
+	}
+	// The actual File.Read wrapper sees completed EOF, while ReadFull gives its
+	// caller UnexpectedEOF. Neither requires an uncertain kernel completion.
+	if !freshIOReadKnown(0, 2, io.EOF) {
+		t.Fatal("completed EOF quarantined")
+	}
+	var s freshIOSettlement
+	if !s.begin(freshIOJoinOutput) || s.begin(freshIOJoinOutput) || !s.unknown || s.complete(freshIOJoinOutput, true) {
+		t.Fatal("entered attempt replay")
+	}
+}
+
+func TestFreshIOPanicDuringSettlementRetainsAttempt(t *testing.T) {
+	for cut := freshIOJoinOutput; cut < freshIOComplete; cut++ {
+		var s freshIOSettlement
+		for phase := freshIOJoinOutput; phase < cut; phase++ {
+			if !s.begin(phase) || !s.complete(phase, true) {
+				t.Fatal("known prefix")
+			}
+		}
+		escaped := true
+		func() {
+			defer func() {
+				if recover() != nil {
+					s.panicUnknown()
+					escaped = false
+				}
+			}()
+			if !s.begin(cut) {
+				t.Fatal("entered attempt")
+			}
+			panic("controlled join/close panic")
+		}()
+		if escaped || !s.unknown || !s.active || s.phase != cut || s.begin(cut) || s.complete(cut, true) {
+			t.Fatal("panic escaped/reset original attempt")
+		}
+	}
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_io_windows.go b/rdd/pkg/service/cmd/fresh_setup_io_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..543d8a9a872327f1dfb0ec2248cb49c12bee1c34
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_io_windows.go
@@ -0,0 +1,184 @@
+//go:build windows
+
+package service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+var freshOperationStarted atomic.Bool
+var originalFreshProtocol *freshSetupProtocolIO
+var errFreshReadStopped = errors.New("private setup input stopping")
+
+type freshOwnedProtocolIOFrame struct {
+	buffer            []byte
+	count             int
+	err               error
+	entered, returned bool
+}
+type freshSetupProtocolIO struct {
+	input, output    *os.File
+	observer         *freshSetupObserver
+	readerDone       chan struct{}
+	readerStarted    bool
+	stopping, failed atomic.Bool
+	mu               sync.Mutex
+	reads, writes    []*freshOwnedProtocolIOFrame
+	settlement       freshIOSettlement
+}
+
+// No stream worker, owned native setup effect or stdio mutation precedes this
+// exact original-process pipe check. Console/redirection substitutes refuse.
+func newFreshProtocolIO(ctx context.Context, input io.Reader, output io.Writer) (*freshSetupProtocolIO, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, errPrivateAuthority
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, errPrivateAuthority
+	}
+	in, ok := input.(*os.File)
+	if !ok || in == nil || in != os.Stdin {
+		return nil, errPrivateAuthority
+	}
+	out, ok := output.(*os.File)
+	if !ok || out == nil || out != os.Stdout || out == os.Stderr || out == in {
+		return nil, errPrivateAuthority
+	}
+	hi, e := windows.GetStdHandle(windows.STD_INPUT_HANDLE)
+	if e != nil || hi == 0 || hi == windows.InvalidHandle || hi != windows.Handle(in.Fd()) {
+		return nil, errPrivateAuthority
+	}
+	ho, e := windows.GetStdHandle(windows.STD_OUTPUT_HANDLE)
+	if e != nil || ho == 0 || ho == windows.InvalidHandle || ho != windows.Handle(out.Fd()) || ho == hi {
+		return nil, errPrivateAuthority
+	}
+	for _, f := range []*os.File{in, out} {
+		s, e := f.Stat()
+		if e != nil || s.Mode()&os.ModeNamedPipe == 0 {
+			return nil, errPrivateAuthority
+		}
+	}
+	if ctx.Err() != nil || !freshOperationStarted.CompareAndSwap(false, true) {
+		return nil, errPrivateAuthority
+	}
+	o := &freshSetupProtocolIO{input: in, output: out, readerDone: make(chan struct{})}
+	originalFreshProtocol = o
+	return o, nil
+}
+
+func (o *freshSetupProtocolIO) Read(p []byte) (n int, err error) {
+	if o == nil || originalFreshProtocol != o || o.stopping.Load() {
+		return 0, errFreshReadStopped
+	}
+	o.mu.Lock()
+	if len(o.reads) >= 272 || len(p) == 0 || len(p) > 128 {
+		o.mu.Unlock()
+		o.failed.Store(true)
+		return 0, errFreshSetupProtocol
+	}
+	f := &freshOwnedProtocolIOFrame{buffer: make([]byte, len(p))}
+	o.reads = append(o.reads, f)
+	o.mu.Unlock()
+	f.entered = true
+	f.count, f.err = o.input.Read(f.buffer)
+	f.returned = true
+	if !freshIOReadKnown(f.count, len(f.buffer), f.err) {
+		o.failed.Store(true)
+		return 0, errFreshSetupProtocol
+	}
+	copy(p, f.buffer[:f.count])
+	return f.count, f.err
+}
+
+type freshProtocolOutput struct{ owner *freshSetupProtocolIO }
+
+func (w freshProtocolOutput) Write(p []byte) (int, error) {
+	o := w.owner
+	if o == nil || originalFreshProtocol != o {
+		return 0, errFreshSetupProtocol
+	}
+	o.mu.Lock()
+	if len(o.writes) >= 4 || len(p) == 0 || len(p) > 257 {
+		o.mu.Unlock()
+		o.failed.Store(true)
+		return 0, errFreshSetupProtocol
+	}
+	f := &freshOwnedProtocolIOFrame{buffer: append([]byte(nil), p...)}
+	o.writes = append(o.writes, f)
+	o.mu.Unlock()
+	f.entered = true
+	f.count, f.err = o.output.Write(f.buffer)
+	f.returned = true
+	if !freshIOWriteKnown(f.count, len(f.buffer), f.err) {
+		o.failed.Store(true)
+		return 0, errFreshSetupProtocol
+	}
+	return f.count, nil
+}
+
+// Called only after actual service/native owner defers have positively settled.
+// No concurrent File.Close: blocking stdin is released by peer's real EOF path.
+func (o *freshSetupProtocolIO) settle() error {
+	if o == nil || originalFreshProtocol != o || o.failed.Load() || o.observer == nil {
+		return errPrivateAuthority
+	}
+	if !o.settlement.begin(freshIOJoinOutput) {
+		return errPrivateAuthority
+	}
+	if !o.settlement.complete(freshIOJoinOutput, o.observer.finish() == nil && !o.failed.Load()) {
+		return errPrivateAuthority
+	}
+	o.stopping.Store(true)
+	if !o.settlement.begin(freshIOCloseOutput) {
+		return errPrivateAuthority
+	}
+	if !o.settlement.complete(freshIOCloseOutput, o.output.Close() == nil) {
+		return errPrivateAuthority
+	}
+	if !o.settlement.begin(freshIOJoinInput) {
+		return errPrivateAuthority
+	}
+	joined := !o.readerStarted
+	if !joined {
+		timer := time.NewTimer(5 * time.Second)
+		select {
+		case <-o.readerDone:
+			joined = true
+		case <-timer.C:
+		}
+		timer.Stop()
+	}
+	if !o.settlement.complete(freshIOJoinInput, joined && !o.failed.Load()) {
+		return errPrivateAuthority
+	}
+	if !o.settlement.begin(freshIOCloseInput) {
+		return errPrivateAuthority
+	}
+	if !o.settlement.complete(freshIOCloseInput, o.input.Close() == nil) {
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+func keepFreshProtocolUnknown(o *freshSetupProtocolIO) {
+	if o != nil {
+		o.failed.Store(true)
+	}
+	func() {
+		defer func() { _ = recover() }()
+		_, _ = os.Stderr.WriteString("private setup protocol settlement unknown; original IO retained\n")
+	}()
+	for {
+		runtime.KeepAlive(o)
+		time.Sleep(time.Hour)
+	}
+}
