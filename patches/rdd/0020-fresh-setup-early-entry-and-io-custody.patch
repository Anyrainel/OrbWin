@@ -0,0 +1,19 @@
+//go:build windows
+
+package service
+
+import (
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"runtime"
+	"time"
+)
+
+// Original factory stack is the live keeper, including partial datastore/server.
+// No Close retry, caller return, callback, replacement owner or second manager.
+func keepPrivateAuthorityFactoryUnknown(c *managementconfig.Created, w *windowsPrivateAuthority) {
+	for {
+		runtime.KeepAlive(c)
+		runtime.KeepAlive(w)
+		time.Sleep(time.Hour)
+	}
+}
