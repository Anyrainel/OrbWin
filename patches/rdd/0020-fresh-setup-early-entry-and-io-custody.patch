@@ -0,0 +1,25 @@
+//go:build windows
+
+package service
+
+import (
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"os"
+	"runtime"
+	"time"
+)
+
+// SAME actual producer and original graph, never a map-as-keeper or success DTO.
+// No cancel, native query, close, retry, new manager or output fallback occurs.
+func keepFreshServiceUnknown(owner *managementconfig.FreshSetupOwner, authority *windowsPrivateAuthority, observer *freshSetupObserver) {
+	func() {
+		defer func() { _ = recover() }()
+		_, _ = os.Stderr.WriteString("private setup settlement unknown; original owners retained\n")
+	}()
+	for {
+		runtime.KeepAlive(owner)
+		runtime.KeepAlive(authority)
+		runtime.KeepAlive(observer)
+		time.Sleep(time.Hour)
+	}
+}
