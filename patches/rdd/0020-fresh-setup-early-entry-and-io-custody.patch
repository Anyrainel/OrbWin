@@ -0,0 +1,34 @@
+package main
+
+import "context"
+
+type runtimeSetupRoute uint8
+
+const (
+	runtimeSetupUnrequested runtimeSetupRoute = iota
+	runtimeSetupRefused
+	runtimeSetupRequested
+)
+
+// Raw closed role only; no environment/instance/path/callback selects authority.
+// Preflight remains on its existing route and cannot fall back into setup.
+func classifyRuntimeSetup(args []string) runtimeSetupRoute {
+	if len(args) == 0 || args[0] != "private-runtime-operation" {
+		return runtimeSetupUnrequested
+	}
+	if len(args) >= 2 && args[1] == "preflight" {
+		return runtimeSetupUnrequested
+	}
+	if len(args) == 2 && args[1] == "setup" {
+		return runtimeSetupRequested
+	}
+	return runtimeSetupRefused
+}
+
+func runtimeSetupContextKnown(ctx context.Context) bool {
+	if ctx == nil || ctx.Err() != nil {
+		return false
+	}
+	_, bounded := ctx.Deadline()
+	return bounded
+}
