+package networkproxy
+
+import (
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+)
+
+// LaunchBinding checks authenticated API identity only. Native re-observation
+// remains mandatory; public metadata and a matching PID alone grant nothing.
+func LaunchBinding(owner *app.App, vm *lima.LimaVM, receipt *lima.NetworkProxyLaunchObservation) (app.NetworkProxyBinding, error) {
+	var empty app.NetworkProxyBinding
+	if !validSelectedOwners(owner, vm) || receipt == nil || receipt.AppUID != string(owner.UID) || receipt.LimaVMUID != string(vm.UID) || receipt.Session == 0 {
+		return empty, ErrProxyOwner
+	}
+	binding := app.NetworkProxyBinding{LimaVMUID: receipt.LimaVMUID, HostPID: receipt.HostPID, HostCreationTime: receipt.HostCreationTime, TransportEpoch: receipt.TransportEpoch}
+	if !validBinding(binding) {
+		return empty, ErrProxyOwner
+	}
+	return binding, nil
+}
