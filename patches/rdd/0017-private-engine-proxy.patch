+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+)
+
+// Process metadata only: no config bytes, API, PAC or engine action.
+func TestLaunchObservationActualNativeIdentityAndStaleCreation(t *testing.T) {
+	self, err := CurrentManagementProcess()
+	if err != nil {
+		t.Fatal("native self metadata unavailable")
+	}
+	a, v, _ := selectionFixture()
+	r := &lima.NetworkProxyLaunchObservation{AppUID: string(a.UID), LimaVMUID: string(v.UID), HostPID: int64(self.PID), HostCreationTime: self.CreationTime, Session: self.Session, TransportEpoch: strings.Repeat("1", 32)}
+	if _, err := ObserveProxyLaunch(context.Background(), a, v, r); err != nil {
+		t.Fatal("native current owner observation refused")
+	}
+	stale := *r
+	stale.HostCreationTime = "0000000000000001"
+	if _, err := ObserveProxyLaunch(context.Background(), a, v, &stale); err == nil {
+		t.Fatal("stale process creation accepted")
+	}
+	stale = *r
+	stale.Session++
+	if _, err := ObserveProxyLaunch(context.Background(), a, v, &stale); err == nil {
+		t.Fatal("stale session accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := ObserveProxyLaunch(ctx, a, v, r); err == nil {
+		t.Fatal("canceled native observation accepted")
+	}
+}
diff --git a/rdd/pkg/networkproxy/local_pac_qualification_windows_test.go b/rdd/pkg/networkproxy/local_pac_qualification_windows_test.go
new file mode 100644
index 0000000..5a48ff0
--- /dev/null
+++ b/rdd/pkg/networkproxy/local_pac_qualification_windows_test.go
@@ -0,0 +1,275 @@
+//go:build windows && orbwin_proxy_local_pac
+
+package networkproxy
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+type localPACReport struct {
+	Schema                               int              `json:"schema"`
+	Stage                                string           `json:"stage"`
+	Passed                               bool             `json:"passed"`
+	NativeOperation                      string           `json:"nativeOperation,omitempty"`
+	NativeCode                           uint32           `json:"nativeCode,omitempty"`
+	Requests                             int32            `json:"requests"`
+	Rejected                             int32            `json:"rejected"`
+	Remaining                            int              `json:"remaining"`
+	RouteKinds                           []string         `json:"routeKinds"`
+	FixtureProxyMatches                  int              `json:"fixtureProxyMatches"`
+	Cleanup                              *localPACCleanup `json:"cleanup,omitempty"`
+	CancellationRequested, HandlerJoined bool
+	ResolveMilliseconds                  int64
+}
+type localPACCleanup struct {
+	ResolverFinal, SessionFinal, ResolverClosed, SessionClosed bool
+}
+type boundedPACOutput struct{ bytes []byte }
+
+func (output *boundedPACOutput) Write(value []byte) (int, error) {
+	count := len(value)
+	if room := 8192 - len(output.bytes); room > 0 {
+		if len(value) > room {
+			value = value[:room]
+		}
+		output.bytes = append(output.bytes, value...)
+	}
+	return count, nil
+}
+
+// SOURCE-ONLY qualification harness. The build tag AND explicit parent opt-in
+// are required. Review the adjacent plan before authorizing its first run.
+// No Capture call: fixture configuration replaces reading the user's settings.
+func TestLocalPACQualification(t *testing.T) {
+	runLocalPACChild(t, "ordered")
+}
+
+func TestLocalPACNativeCancellation(t *testing.T) {
+	runLocalPACChild(t, "cancel")
+}
+
+func runLocalPACChild(t *testing.T, scenario string) {
+	t.Helper()
+	if os.Getenv("ORBWIN_LOCAL_PAC_REVIEWED") != "yes" {
+		t.Skip("local PAC network qualification requires separate review")
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal("qualification executable unavailable")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, executable, "-test.run=^TestLocalPACQualificationChild$", "-test.timeout=15s")
+	// Do not inherit ambient proxy variables, credentials, or fixture URLs.
+	command.Env = []string{"ORBWIN_LOCAL_PAC_CHILD=yes", "ORBWIN_LOCAL_PAC_SCENARIO=" + scenario, "SystemRoot=" + os.Getenv("SystemRoot"), "WINDIR=" + os.Getenv("WINDIR")}
+	var output boundedPACOutput
+	command.Stdout, command.Stderr = &output, io.Discard
+	runErr := command.Run()
+	for _, line := range strings.Split(string(output.bytes), "\n") {
+		if strings.HasPrefix(line, "ORBWIN_PAC_RESULT ") {
+			var report localPACReport
+			if json.Unmarshal([]byte(strings.TrimPrefix(line, "ORBWIN_PAC_RESULT ")), &report) == nil && report.Schema == 1 {
+				encoded, _ := json.Marshal(report)
+				t.Log(string(encoded))
+			}
+		}
+	}
+	if runErr != nil {
+		t.Fatal("local PAC subprocess failed or exceeded deadline; child reaped")
+	}
+}
+
+func TestLocalPACQualificationChild(t *testing.T) {
+	if os.Getenv("ORBWIN_LOCAL_PAC_CHILD") != "yes" {
+		t.Skip("subprocess only")
+	}
+	cancellation := os.Getenv("ORBWIN_LOCAL_PAC_SCENARIO") == "cancel"
+	report := localPACReport{Schema: 1, Stage: "listener"}
+	t.Cleanup(func() {
+		report.Passed = !t.Failed()
+		encoded, _ := json.Marshal(report)
+		fmt.Printf("ORBWIN_PAC_RESULT %s\n", encoded)
+	})
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal("local PAC listener unavailable")
+	}
+	var requests, rejected atomic.Int32
+	observed, releaseResponse := make(chan struct{}), make(chan struct{})
+	var observedOnce sync.Once
+	nonce := make([]byte, 16)
+	if _, err := rand.Read(nonce); err != nil {
+		listener.Close()
+		t.Fatal("fixture nonce unavailable")
+	}
+	path := "/" + hex.EncodeToString(nonce) + ".pac"
+	// No DNS/PAC helper calls, redirects, credentials, authentication challenges,
+	// or target requests. The returned proxy is only inspected, never contacted.
+	const pac = `function FindProxyForURL(url, host) { if (host === "192.0.2.1") return "PROXY 127.0.0.1:9; DIRECT"; return "DIRECT"; }`
+	server := &http.Server{ReadHeaderTimeout: time.Second, IdleTimeout: time.Second, MaxHeaderBytes: 4096,
+		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			peer, _, _ := net.SplitHostPort(r.RemoteAddr)
+			if peer != "127.0.0.1" || r.Host != listener.Addr().String() || r.URL.Path != path || r.URL.RawQuery != "" || r.Method != "GET" || r.Header.Get("Authorization") != "" || r.Header.Get("Proxy-Authorization") != "" {
+				rejected.Add(1)
+				w.WriteHeader(http.StatusForbidden)
+				return
+			}
+			requests.Add(1)
+			observedOnce.Do(func() { close(observed) })
+			if cancellation {
+				timer := time.NewTimer(5 * time.Second)
+				defer timer.Stop()
+				select {
+				case <-releaseResponse:
+				case <-r.Context().Done():
+					return
+				case <-timer.C:
+				}
+			}
+			w.Header().Set("Content-Type", "application/x-ns-proxy-autoconfig")
+			w.Header().Set("Cache-Control", "no-store")
+			io.WriteString(w, pac)
+		})}
+	stopped := make(chan struct{})
+	go func() { defer close(stopped); server.Serve(listener) }()
+	defer func() {
+		close(releaseResponse)
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		report.HandlerJoined = server.Shutdown(ctx) == nil
+		cancel()
+		server.Close()
+		<-stopped
+		if !report.HandlerJoined {
+			t.Error("fixture handlers did not drain")
+		}
+	}()
+	user, err := windows.GetCurrentProcessToken().GetTokenUser()
+	report.Stage = "owner-token"
+	if err != nil {
+		t.Fatal("owner token unavailable")
+	}
+	resolver, err := NewNativeAutoResolver(user.User.Sid.String())
+	report.Stage = "construct"
+	if err != nil {
+		t.Fatal("native provider unavailable")
+	}
+	fixture := ownerConfiguration{pac: "http://" + listener.Addr().String() + path}
+	if fixture.auto || fixture.manual != "" || fixture.bypass != "" {
+		t.Fatal("fixture must select PAC URL only")
+	}
+	report.Stage = "fixture"
+	if fixture.validate() != nil {
+		t.Fatal("fixture validation failed")
+	}
+	resolver.mu.Lock()
+	resolver.config, resolver.captured = fixture, true
+	resolver.mu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	capturedPending := make(chan *pendingAuto, 1)
+	if cancellation {
+		go func() {
+			select {
+			case <-ctx.Done():
+				capturedPending <- nil
+				return
+			case <-observed:
+			}
+			var owned *pendingAuto
+			pendingAutos.Lock()
+			for _, pending := range pendingAutos.values {
+				if pending.owner == resolver {
+					owned = pending
+					break
+				}
+			}
+			pendingAutos.Unlock()
+			capturedPending <- owned
+			cancel()
+		}()
+	}
+	started := time.Now()
+	routes, resolveErr := resolver.Resolve(ctx, target("http://192.0.2.1/decision-only"))
+	report.ResolveMilliseconds = time.Since(started).Milliseconds()
+	for _, route := range routes {
+		kind := "invalid"
+		if route.Direct {
+			kind = "direct"
+		} else if strings.HasPrefix(route.Proxy, "https://") {
+			kind = "https"
+		} else if strings.HasPrefix(route.Proxy, "http://") {
+			kind = "http"
+		}
+		report.RouteKinds = append(report.RouteKinds, kind)
+		if route.Proxy == "http://127.0.0.1:9" {
+			report.FixtureProxyMatches++
+		}
+	}
+	report.Stage = "resolve-and-retire"
+	closeCtx, closeCancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer closeCancel()
+	closeErr := resolver.Close(closeCtx)
+	report.Requests, report.Rejected = requests.Load(), rejected.Load()
+	pendingAutos.Lock()
+	report.Remaining = len(pendingAutos.values)
+	for _, pending := range pendingAutos.values {
+		pending.cleanupMu.Lock()
+		report.Cleanup = &localPACCleanup{pending.resolverFinal, pending.sessionFinal, pending.resolverClosed, pending.sessionClosed}
+		pending.cleanupMu.Unlock()
+	}
+	pendingAutos.Unlock()
+	if cancellation {
+		pending := <-capturedPending
+		report.CancellationRequested = pending != nil
+		if pending != nil {
+			pending.cleanupMu.Lock()
+			report.Cleanup = &localPACCleanup{pending.resolverFinal, pending.sessionFinal, pending.resolverClosed, pending.sessionClosed}
+			pending.cleanupMu.Unlock()
+		}
+	}
+	var native NativeError
+	if errors.As(resolveErr, &native) {
+		report.NativeOperation, report.NativeCode = native.Operation, native.Code
+	}
+	if cancellation {
+		report.Stage = "cancellation-retirement"
+		if !report.CancellationRequested || resolveErr == nil || len(routes) != 0 || closeErr != nil || report.Remaining != 0 || report.Cleanup == nil || !report.Cleanup.ResolverFinal || !report.Cleanup.SessionFinal || !report.Cleanup.ResolverClosed || !report.Cleanup.SessionClosed {
+			t.Fatal("canceled native decision or retirement was not confirmed")
+		}
+	} else if resolveErr != nil || closeErr != nil {
+		t.Fatal("native decision or handle retirement failed")
+	}
+	if !cancellation && (len(routes) != 2 || routes[0].Proxy != "http://127.0.0.1:9" || !routes[1].Direct) {
+		report.Stage = "ordered-result"
+		t.Fatal("ordered native decision mismatch")
+	}
+	if requests.Load() < 1 || requests.Load() > 4 || rejected.Load() != 0 {
+		report.Stage = "fixture-requests"
+		t.Fatal("fixture request bounds or privacy checks failed")
+	}
+	pendingAutos.Lock()
+	remaining := len(pendingAutos.values)
+	pendingAutos.Unlock()
+	if remaining != 0 {
+		report.Stage = "pending-retirement"
+		t.Fatal("native pending resources remain after Close")
+	}
+	report.Stage = "complete"
+}
diff --git a/rdd/pkg/networkproxy/management.go b/rdd/pkg/networkproxy/management.go
new file mode 100644
index 0000000..4da34d2
--- /dev/null
+++ b/rdd/pkg/networkproxy/management.go
@@ -0,0 +1,297 @@
+package networkproxy
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/serializer"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/client-go/rest"
+	"sigs.k8s.io/yaml"
+)
+
+const managementLimit = 1 << 20
+
+var ErrManagement = errors.New("owned management configuration or transaction refused")
+var ErrManagementCredentials = errors.New("owned management credential generation expired")
+
+// ManagementBinding must come from the existing explicit instance and current
+// App owner. This is an identity binding, not proof of configuration-file ACLs.
+type ManagementBinding struct {
+	InstanceID string
+	AppUID     types.UID
+}
+
+// Deliberately smaller than clientcmd's schema: even empty unsupported fields
+// are refused by strict decoding. No loader, plugin or file-reference API runs.
+type managementConfig struct {
+	Kind        string   `json:"kind"`
+	APIVersion  string   `json:"apiVersion"`
+	Preferences struct{} `json:"preferences"`
+	Clusters    []struct {
+		Name    string `json:"name"`
+		Cluster struct {
+			Server string `json:"server"`
+			CA     []byte `json:"certificate-authority-data"`
+		} `json:"cluster"`
+	} `json:"clusters"`
+	Users []struct {
+		Name string `json:"name"`
+		User struct {
+			Token string `json:"token"`
+		} `json:"user"`
+	} `json:"users"`
+	Contexts []struct {
+		Name    string `json:"name"`
+		Context struct {
+			Cluster string `json:"cluster"`
+			User    string `json:"user"`
+		} `json:"context"`
+	} `json:"contexts"`
+	CurrentContext string `json:"current-context"`
+}
+
+type ManagementClient struct {
+	binding   ManagementBinding
+	selected  *SelectedManagementInstance
+	client    *rest.RESTClient
+	http      *http.Client
+	transport *http.Transport
+}
+
+func (*ManagementClient) String() string   { return "private owned management client" }
+func (*ManagementClient) GoString() string { return "private owned management client" }
+
+// LoadManagementClient consumes a bounded reader already opened by the owning
+// instance. It does not open paths or establish Windows ACL/reparse ownership.
+// Construction performs no network request. The token stays in memory only.
+func LoadManagementClient(reader io.Reader, binding ManagementBinding) (*ManagementClient, error) {
+	return loadManagementClient(reader, binding, nil)
+}
+
+func loadManagementClient(reader io.Reader, binding ManagementBinding, selected *SelectedManagementInstance) (*ManagementClient, error) {
+	if reader == nil || binding.InstanceID == "" || len(binding.InstanceID) > 128 || binding.AppUID == "" || len(binding.AppUID) > 128 {
+		return nil, ErrManagement
+	}
+	data, err := io.ReadAll(io.LimitReader(reader, managementLimit+1))
+	if err != nil || len(data) > managementLimit {
+		return nil, ErrManagement
+	}
+	defer clear(data)
+	var config managementConfig
+	if yaml.UnmarshalStrict(data, &config) != nil || config.Kind != "Config" || config.APIVersion != "v1" || config.CurrentContext != "root" || len(config.Clusters) != 1 || config.Clusters[0].Name != "root" || len(config.Users) < 1 || len(config.Users) > 2 || len(config.Contexts) != len(config.Users) {
+		return nil, ErrManagement
+	}
+	users := map[string]bool{}
+	token := ""
+	for _, user := range config.Users {
+		if users[user.Name] || (user.Name != "system-admin" && user.Name != "user") || len(user.User.Token) < 1 || len(user.User.Token) > 4096 || strings.IndexFunc(user.User.Token, func(r rune) bool { return r < 33 || r > 126 }) >= 0 {
+			return nil, ErrManagement
+		}
+		users[user.Name] = true
+		if user.Name == "system-admin" {
+			token = user.User.Token
+		}
+	}
+	seen := map[string]bool{}
+	for _, c := range config.Contexts {
+		expected := c.Name
+		if expected == "root" {
+			expected = "system-admin"
+		}
+		if seen[c.Name] || (c.Name != "root" && c.Name != "user") || c.Context.Cluster != "root" || c.Context.User != expected || !users[expected] {
+			return nil, ErrManagement
+		}
+		seen[c.Name] = true
+	}
+	if !seen["root"] || token == "" {
+		return nil, ErrManagement
+	}
+	cluster := config.Clusters[0].Cluster
+	if selected != nil {
+		digest, err := managementCertificateDigest(cluster.CA)
+		if err != nil || cluster.Server != selected.endpoint || digest != selected.certificate {
+			return nil, ErrManagement
+		}
+	}
+	endpoint, err := url.Parse(cluster.Server)
+	if err != nil || endpoint.Scheme != "https" || endpoint.User != nil || endpoint.Path != "" || endpoint.RawQuery != "" || endpoint.ForceQuery || endpoint.Fragment != "" || endpoint.Opaque != "" || endpoint.RawPath != "" || (endpoint.Hostname() != "127.0.0.1" && endpoint.Hostname() != "::1") {
+		return nil, ErrManagement
+	}
+	port, err := strconv.Atoi(endpoint.Port())
+	if err != nil || port < 1 || port > 65535 || endpoint.Port() != strconv.Itoa(port) {
+		return nil, ErrManagement
+	}
+	wantHost := endpoint.Hostname() + ":" + strconv.Itoa(port)
+	if endpoint.Hostname() == "::1" {
+		wantHost = "[::1]:" + strconv.Itoa(port)
+	}
+	if endpoint.Host != wantHost || len(cluster.CA) == 0 {
+		return nil, ErrManagement
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(cluster.CA) {
+		return nil, ErrManagement
+	}
+	scheme := runtime.NewScheme()
+	if app.AddToScheme(scheme) != nil {
+		return nil, ErrManagement
+	}
+	configuration := &rest.Config{
+		Host: cluster.Server, APIPath: "/apis", BearerToken: token,
+		TLSClientConfig: rest.TLSClientConfig{CAData: cluster.CA},
+		Proxy:           func(*http.Request) (*url.URL, error) { return nil, nil },
+		Timeout:         5 * time.Second, QPS: -1, UserAgent: "orbwin-owned-proxy-management",
+		ContentConfig: rest.ContentConfig{GroupVersion: &app.GroupVersion, NegotiatedSerializer: serializer.NewCodecFactory(scheme).WithoutConversion()},
+	}
+	// Own this transport rather than client-go's shared transport cache. No
+	// ambient proxy function, credential-file refresh, or automatic replay over
+	// a previously used connection is available. TLS names come from the URL.
+	ownedTransport := &http.Transport{Proxy: nil, DisableKeepAlives: true,
+		DialContext:         (&net.Dialer{Timeout: 3 * time.Second, KeepAlive: -1}).DialContext,
+		TLSClientConfig:     &tls.Config{RootCAs: pool, MinVersion: tls.VersionTLS12},
+		TLSHandshakeTimeout: 3 * time.Second, ResponseHeaderTimeout: 5 * time.Second,
+		MaxResponseHeaderBytes: 16 << 10,
+	}
+	transport, err := rest.HTTPWrappersForConfig(configuration, ownedTransport)
+	if err != nil {
+		ownedTransport.CloseIdleConnections()
+		return nil, ErrManagement
+	}
+	httpClient := &http.Client{Transport: &managementTransport{base: transport, authority: endpoint.Host}, Timeout: 5 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return ErrManagement },
+	}
+	client, err := rest.RESTClientForConfigAndClient(configuration, httpClient)
+	if err != nil {
+		httpClient.CloseIdleConnections()
+		return nil, ErrManagement
+	}
+	return &ManagementClient{binding: binding, selected: selected, client: client, http: httpClient, transport: ownedTransport}, nil
+}
+
+// The endpoint fence applies before credentials are attached by client-go.
+type managementTransport struct {
+	base      http.RoundTripper
+	authority string
+}
+
+func (t *managementTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Scheme != "https" || r.URL.Host != t.authority || r.Host != "" && r.Host != t.authority || r.URL.User != nil {
+		return nil, ErrManagement
+	}
+	response, err := t.base.RoundTrip(r)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	response.Body = &managementBody{ReadCloser: response.Body, remaining: managementLimit}
+	return response, nil
+}
+func (t *managementTransport) CloseIdleConnections() {
+	if c, ok := t.base.(interface{ CloseIdleConnections() }); ok {
+		c.CloseIdleConnections()
+	}
+}
+
+type managementBody struct {
+	io.ReadCloser
+	remaining int64
+}
+
+func (b *managementBody) Read(p []byte) (int, error) {
+	if b.remaining == 0 {
+		var extra [1]byte
+		n, e := b.ReadCloser.Read(extra[:])
+		if n > 0 {
+			return 0, ErrManagement
+		}
+		return 0, e
+	}
+	if int64(len(p)) > b.remaining {
+		p = p[:b.remaining]
+	}
+	n, e := b.ReadCloser.Read(p)
+	b.remaining -= int64(n)
+	return n, e
+}
+func (c *ManagementClient) Close() { c.transport.CloseIdleConnections() }
+
+// ReadApp never changes engine lifecycle and never retries after disconnect.
+func (c *ManagementClient) ReadApp(ctx context.Context) (*app.App, error) {
+	var owner app.App
+	err := c.client.Get().Resource("apps").Name("app").MaxRetries(0).Do(ctx).Into(&owner)
+	if err != nil {
+		if c.selected != nil && apierrors.IsUnauthorized(err) {
+			return nil, ErrManagementCredentials
+		}
+		if c.selected != nil && (apierrors.IsUnauthorized(err) || apierrors.IsForbidden(err) || apierrors.IsNotFound(err)) {
+			return nil, ErrProxyOwner
+		}
+		return nil, ErrManagement
+	}
+	if owner.Name != "app" || owner.Namespace != "" || owner.UID != c.binding.AppUID || owner.ResourceVersion == "" || len(owner.ResourceVersion) > 128 {
+		if c.selected != nil {
+			return nil, ErrProxyOwner
+		}
+		return nil, ErrManagement
+	}
+	return &owner, nil
+}
+
+// WatchApp is one bounded authenticated watch session. The sole policy consumer
+// owns relist/rejoin; client-go must not replay writes or secretly retry this
+// watch. Both the response byte budget and five-second HTTP deadline apply.
+func (c *ManagementClient) WatchApp(ctx context.Context, resourceVersion string) (watch.Interface, error) {
+	if ctx == nil || ctx.Err() != nil || resourceVersion == "" || !safeASCII(resourceVersion, 128) {
+		return nil, ErrManagement
+	}
+	stream, err := c.client.Get().Resource("apps").Param("watch", "true").Param("fieldSelector", "metadata.name=app").Param("resourceVersion", resourceVersion).Param("timeoutSeconds", "4").MaxRetries(0).Watch(ctx)
+	if err != nil {
+		if c.selected != nil && apierrors.IsUnauthorized(err) {
+			return nil, ErrManagementCredentials
+		}
+		if c.selected != nil && (apierrors.IsUnauthorized(err) || apierrors.IsForbidden(err) || apierrors.IsNotFound(err)) {
+			return nil, ErrProxyOwner
+		}
+		return nil, ErrManagement
+	}
+	return stream, nil
+}
+
+// WriteHostObservation writes only our field. JSONPatch tests are server-side
+// preconditions, not a GET-then-unconditional-write approximation. No replay on
+// conflict, disconnect, cancellation or ambiguous acknowledgement is attempted.
+func (c *ManagementClient) WriteHostObservation(ctx context.Context, owner *app.App, host *app.NetworkProxyHostStatus, observed app.NetworkProxyBinding) error {
+	if c.selected != nil && observed != c.selected.native {
+		return ErrManagement
+	}
+	if owner == nil || owner.UID != c.binding.AppUID || owner.Name != "app" || owner.Namespace != "" || owner.ResourceVersion == "" || len(owner.ResourceVersion) > 128 || GuardHostObservation(owner, host, observed) != nil {
+		return ErrManagement
+	}
+	patch, err := json.Marshal([]map[string]any{
+		{"op": "test", "path": "/metadata/uid", "value": string(c.binding.AppUID)},
+		{"op": "test", "path": "/metadata/resourceVersion", "value": owner.ResourceVersion},
+		{"op": "add", "path": "/status/networkProxyHost", "value": host},
+	})
+	if err != nil || len(patch) > managementLimit {
+		return ErrManagement
+	}
+	var result app.App
+	if c.client.Patch(types.JSONPatchType).Resource("apps").Name("app").SubResource("status").Param("fieldValidation", "Strict").MaxRetries(0).Body(patch).Do(ctx).Into(&result) != nil || result.UID != c.binding.AppUID {
+		return ErrManagement
+	}
+	return nil
+}
