+//go:build windows && orbwin_management_metadata
+
+package networkproxy
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+)
+
+// Built for review first. Running with the explicit opt-in is a separately
+// authorized real-product METADATA observation, never credential data reading.
+func TestReviewedOrbWinManagementMetadata(t *testing.T) {
+	if os.Getenv("ORBWIN_MANAGEMENT_METADATA_REVIEWED") != "yes" {
+		t.Skip("actual fixed product metadata requires explicit reviewed opt-in")
+	}
+	report := ObserveOrbWinManagementMetadata()
+	encoded, err := json.Marshal(report)
+	if err != nil || len(encoded) > 64<<10 {
+		t.Fatal("bounded redacted metadata report unavailable")
+	}
+	fmt.Printf("ORBWIN_MANAGEMENT_METADATA %s\n", encoded)
+	if report.RegistrationAllowed {
+		t.Fatal("metadata unexpectedly authorized registration")
+	}
+}
diff --git a/rdd/pkg/networkproxy/management_metadata_windows.go b/rdd/pkg/networkproxy/management_metadata_windows.go
new file mode 100644
index 0000000..36ebfda
--- /dev/null
+++ b/rdd/pkg/networkproxy/management_metadata_windows.go
@@ -0,0 +1,220 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"runtime"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Metadata is a bounded classification, never an authorization receipt. Names,
+// paths, SIDs, credential contents and security descriptors are not serialized.
+type ManagementMetadata struct {
+	Schema              int                       `json:"schema"`
+	Complete            bool                      `json:"complete"`
+	RegistrationAllowed bool                      `json:"registrationAllowed"`
+	Reason              string                    `json:"reason"`
+	Stages              []ManagementMetadataStage `json:"stages"`
+}
+type ManagementMetadataStage struct {
+	Index                   int                     `json:"index"`
+	Scope                   string                  `json:"scope"`
+	OwnerClass              string                  `json:"ownerClass"`
+	OwnershipPolicyAccepted bool                    `json:"ownershipPolicyAccepted"`
+	ACEs                    []ManagementMetadataACE `json:"aces"`
+}
+type ManagementMetadataACE struct {
+	Type           uint8  `json:"type"`
+	Flags          uint8  `json:"flags"`
+	Mask           uint32 `json:"mask"`
+	PrincipalClass string `json:"principalClass"`
+}
+
+// ObserveOrbWinManagementMetadata is unregistered and must not be invoked until
+// reviewed explicitly. It never requests FILE_READ_DATA, opens a client, calls
+// an API, or changes ACLs. Only the fixed native product path/suffix is inspected.
+func ObserveOrbWinManagementMetadata() ManagementMetadata {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	result := ManagementMetadata{Schema: 1, Reason: "identity-unavailable", Stages: []ManagementMetadataStage{}}
+	process, token, sid, _, err := nativeManagementProcess()
+	if err != nil {
+		return result
+	}
+	defer windows.CloseHandle(process)
+	defer token.Close()
+	local, err := token.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
+	if err != nil {
+		return result
+	}
+	path, err := managementInstancePath(local, ManagementInstanceRoot{Home: local + `\OrbWinData\home`, Suffix: "orbwin"})
+	if err != nil {
+		result.Reason = "fixed-path-refused"
+		return result
+	}
+	return observeManagementMetadataPath(path, sid)
+}
+
+// Metadata-only traversal may report an unsafe ACL and continue inspecting the
+// exact retained children, but never changes that refusal into authorization.
+func observeManagementMetadataPath(path, sid string) ManagementMetadata {
+	result := ManagementMetadata{Schema: 1, Reason: "open-refused", Stages: []ManagementMetadataStage{}}
+	root, parts, err := managementComponents(path)
+	if err != nil {
+		result.Reason = "fixed-path-refused"
+		return result
+	}
+	root16, err := windows.UTF16PtrFromString(root)
+	if err != nil {
+		return result
+	}
+	parent, err := windows.CreateFile(root16, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return result
+	}
+	handles := []windows.Handle{parent}
+	defer func() {
+		for i := len(handles) - 1; i >= 0; i-- {
+			windows.CloseHandle(handles[i])
+		}
+	}()
+	remaining := 256
+	rootStage, err := observeManagementHandle(parent, sid, 0, "ancestor", true, &remaining)
+	if err != nil {
+		result.Reason = "metadata-unsupported"
+		return result
+	}
+	result.Stages = append(result.Stages, rootStage)
+	for index, part := range parts {
+		name, err := windows.NewNTUnicodeString(part)
+		if err != nil {
+			return result
+		}
+		oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: name, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+		oa.Length = uint32(unsafe.Sizeof(oa))
+		directory := index < len(parts)-1
+		options := uint32(windows.FILE_OPEN_REPARSE_POINT)
+		if directory {
+			options |= windows.FILE_DIRECTORY_FILE
+		} else {
+			options |= windows.FILE_NON_DIRECTORY_FILE
+		}
+		var handle windows.Handle
+		var status windows.IO_STATUS_BLOCK
+		// No GENERIC_READ or SYNCHRONIZE/open-read convenience mask: neither
+		// metadata access right grants permission to read credential bytes.
+		if windows.NtCreateFile(&handle, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, options, 0, 0) != nil {
+			return result
+		}
+		handles = append(handles, handle)
+		parent = handle
+		scope := "ancestor"
+		if index >= len(parts)-6 {
+			scope = "product"
+		}
+		if !directory {
+			scope = "config"
+		}
+		stage, err := observeManagementHandle(handle, sid, index+1, scope, directory, &remaining)
+		if err != nil {
+			result.Reason = "metadata-unsupported"
+			return result
+		}
+		result.Stages = append(result.Stages, stage)
+	}
+	result.Complete = true
+	result.Reason = "observed-registration-gated"
+	return result
+}
+
+func observeManagementHandle(handle windows.Handle, sid string, index int, scope string, directory bool, budget *int) (ManagementMetadataStage, error) {
+	stage := ManagementMetadataStage{Index: index, Scope: scope, ACEs: []ManagementMetadataACE{}}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(handle, &info) != nil || info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory {
+		return stage, ErrManagement
+	}
+	if typ, e := windows.GetFileType(handle); e != nil || typ != windows.FILE_TYPE_DISK {
+		return stage, ErrManagement
+	}
+	var path [1024]uint16
+	n, e := windows.GetFinalPathNameByHandle(handle, &path[0], uint32(len(path)), 2)
+	if e != nil || n == 0 || n >= uint32(len(path)) || !strings.HasPrefix(windows.UTF16ToString(path[:n]), `\Device\HarddiskVolume`) {
+		return stage, ErrManagement
+	}
+	sd, e := windows.GetSecurityInfo(handle, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if e != nil {
+		return stage, ErrManagement
+	}
+	owner, _, e := sd.Owner()
+	if e != nil || owner == nil {
+		return stage, ErrManagement
+	}
+	stage.OwnerClass = managementPrincipalClass(owner.String(), sid)
+	acl, _, e := sd.DACL()
+	if e != nil || acl == nil || acl.AceCount > 64 || int(acl.AceCount) > *budget {
+		return stage, ErrManagement
+	}
+	*budget -= int(acl.AceCount)
+	for i := uint32(0); i < uint32(acl.AceCount); i++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if windows.GetAce(acl, i, &ace) != nil || ace == nil || ace.Header.AceSize < 8 {
+			return stage, ErrManagement
+		}
+		observation := ManagementMetadataACE{Type: ace.Header.AceType, Flags: ace.Header.AceFlags, Mask: uint32(ace.Mask), PrincipalClass: "unsupported-ACE"}
+		if ace.Header.AceType == windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceType == windows.ACCESS_DENIED_ACE_TYPE {
+			if ace.Header.AceSize < 16 {
+				return stage, ErrManagement
+			}
+			principal := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+			if !principal.IsValid() || principal.Len() > int(ace.Header.AceSize)-8 {
+				return stage, ErrManagement
+			}
+			observation.PrincipalClass = managementPrincipalClass(principal.String(), sid)
+		}
+		stage.ACEs = append(stage.ACEs, observation)
+	}
+	stage.OwnershipPolicyAccepted = verifyManagementHandle(handle, sid, directory) == nil
+	return stage, nil
+}
+
+func managementPrincipalClass(value, current string) string {
+	switch {
+	case value == current:
+		return "current-user"
+	case value == "S-1-5-18":
+		return "SYSTEM"
+	case value == "S-1-5-32-544":
+		return "administrators"
+	case value == managementTrustedInstaller:
+		return "TrustedInstaller"
+	case value == "S-1-3-0":
+		return "creator-owner-placeholder"
+	case value == "S-1-3-4":
+		return "owner-rights"
+	case value == "S-1-1-0":
+		return "everyone"
+	case value == "S-1-5-11":
+		return "authenticated-users"
+	case value == "S-1-5-4":
+		return "interactive"
+	case value == "S-1-15-2-1":
+		return "all-application-packages"
+	case value == "S-1-15-2-2":
+		return "all-restricted-application-packages"
+	case strings.HasPrefix(value, "S-1-15-3-"):
+		return "application-capability"
+	case strings.HasPrefix(value, "S-1-5-80-"):
+		return "other-service-account"
+	case strings.HasPrefix(value, "S-1-5-32-"):
+		return "other-builtin-group"
+	case strings.HasPrefix(value, "S-1-5-21-"):
+		return "account-unresolved"
+	case strings.HasPrefix(value, "S-1-5-5-"):
+		return "logon-session-unproven"
+	default:
+		return "other-unresolved"
+	}
+}
