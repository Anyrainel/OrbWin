+++ b/rdd/pkg/service/cmd/private_datastore_test.go
@@ -0,0 +1,19 @@
+package service
+
+import "testing"
+
+func TestPrivateDatastoreEndpointRequiresExactDefaultLoopback(t *testing.T) {
+	if actual, err := privateDatastoreEndpoint("http://127.0.0.1:45678"); err != nil || actual != "https://127.0.0.1:45678" {
+		t.Fatal("default loopback endpoint refused")
+	}
+	for _, input := range []string{
+		"", "http://localhost:123", "http://127.0.0.2:123", "https://127.0.0.1:123",
+		"http://127.0.0.1", "http://127.0.0.1:0", "http://127.0.0.1:65536", "http://127.0.0.1:0123",
+		"http://127.0.0.1:123/", "http://127.0.0.1:123?", "http://127.0.0.1:123?a=b",
+		"http://127.0.0.1:123#fragment", "http://user@127.0.0.1:123", "tcp://127.0.0.1:123",
+	} {
+		if _, err := privateDatastoreEndpoint(input); err == nil {
+			t.Fatal("custom/ambiguous endpoint admitted")
+		}
+	}
+}
diff --git a/rdd/pkg/service/cmd/private_retirement.go b/rdd/pkg/service/cmd/private_retirement.go
new file mode 100644
index 0000000..d7462ad
--- /dev/null
+++ b/rdd/pkg/service/cmd/private_retirement.go
@@ -0,0 +1,37 @@
+package service
+
+import "time"
+
+type privateRetirementBudgets struct{ Manager, API, Kine time.Duration }
+
+// Startup completion precedes these channels: no Wait may race future Add.
+// Unknown retirement does not authorize releasing file/anchor capabilities.
+// No goroutine/worker is replaced or retried; process exit owns final reclamation.
+func retirePrivateResources(cancelOwners func(), managerDone, apiDone <-chan struct{}, cancelKine func(), kineDone <-chan struct{}, budgets privateRetirementBudgets) bool {
+	if cancelOwners != nil {
+		cancelOwners()
+	}
+	wait := func(done <-chan struct{}, budget time.Duration) bool {
+		if done == nil {
+			return true
+		}
+		if budget <= 0 {
+			return false
+		}
+		timer := time.NewTimer(budget)
+		defer timer.Stop()
+		select {
+		case <-done:
+			return true
+		case <-timer.C:
+			return false
+		}
+	}
+	manager := wait(managerDone, budgets.Manager)
+	api := wait(apiDone, budgets.API)
+	if cancelKine != nil {
+		cancelKine()
+	}
+	kine := wait(kineDone, budgets.Kine)
+	return manager && api && kine
+}
diff --git a/rdd/pkg/service/cmd/private_retirement_test.go b/rdd/pkg/service/cmd/private_retirement_test.go
new file mode 100644
index 0000000..c69c8db
--- /dev/null
+++ b/rdd/pkg/service/cmd/private_retirement_test.go
@@ -0,0 +1,35 @@
+package service
+
+import (
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestPrivateRetirementRequiresAllPositiveJoinsBeforeRelease(t *testing.T) {
+	for _, fault := range []string{"none", "manager", "API", "kine"} {
