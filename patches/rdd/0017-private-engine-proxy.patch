index 0000000..64b32a2
--- /dev/null
+++ b/rdd/pkg/networkproxy/management_owner_windows.go
@@ -0,0 +1,197 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"fmt"
+
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+	"unsafe"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"golang.org/x/sys/windows"
+)
+
+// NativeManagementIdentity observes only a process. App/Lima identities must
+// still be obtained from the authenticated management API, never inferred here.
+type NativeManagementIdentity struct {
+	PID          uint32
+	CreationTime string
+	Session      uint32
+}
+
+// Supplied by the existing explicitly selected runtime, never renderer input.
+// Home is also verified against the native known-folder product layout.
+type ManagementInstanceRoot struct {
+	Home   string
+	Suffix string
+}
+
+func nativeManagementProcess() (windows.Handle, windows.Token, string, NativeManagementIdentity, error) {
+	var zero NativeManagementIdentity
+	token, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		return 0, 0, "", zero, ErrManagement
+	}
+	user, err := token.GetTokenUser()
+	if err != nil {
+		token.Close()
+		return 0, 0, "", zero, ErrManagement
+	}
+	sid := user.User.Sid.String()
+	if checkNativeOwner(sid) != nil {
+		token.Close()
+		return 0, 0, "", zero, ErrManagement
+	}
+	process, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, uint32(os.Getpid()))
+	if err != nil {
+		token.Close()
+		return 0, 0, "", zero, ErrManagement
+	}
+	var creation, exit, kernel, userTime windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(process, &creation, &exit, &kernel, &userTime) != nil || windows.ProcessIdToSessionId(uint32(os.Getpid()), &session) != nil || session == 0 {
+		windows.CloseHandle(process)
+		token.Close()
+		return 0, 0, "", zero, ErrManagement
+	}
+	var tokenSession, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&tokenSession)), 4, &size) != nil || size != 4 || tokenSession != session {
+		windows.CloseHandle(process)
+		token.Close()
+		return 0, 0, "", zero, ErrManagement
+	}
+	return process, token, sid, NativeManagementIdentity{PID: uint32(os.Getpid()), CreationTime: fmt.Sprintf("%016x", uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime)), Session: session}, nil
+}
+
+func CurrentManagementProcess() (NativeManagementIdentity, error) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	process, token, _, identity, err := nativeManagementProcess()
+	if err != nil {
+		return NativeManagementIdentity{}, err
+	}
+	defer windows.CloseHandle(process)
+	defer token.Close()
+	return identity, nil
+}
+
+func managementSuffix(s string) bool {
+	if len(s) < 1 || len(s) > 64 {
+		return false
+	}
+	for _, r := range s {
+		if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+// LoadOwnedManagementClient is unregistered. OrbWin rebases upstream USERPROFILE
+// to its owned home; using the standalone native profile would read the wrong
+// instance. Verify the explicit home against native LocalAppData, not env vars.
+// This function is never used by fixture tests against a real instance config.
+func LoadOwnedManagementClient(root ManagementInstanceRoot, binding ManagementBinding, expected app.NetworkProxyBinding) (*ManagementClient, error) {
+	suffix := root.Suffix
+	if !managementSuffix(suffix) || binding.InstanceID != "rancher-desktop-"+suffix || binding.AppUID == "" || len(binding.AppUID) > 128 || expected.LimaVMUID == "" || len(expected.LimaVMUID) > 128 || !hexIdentity(expected.TransportEpoch, 32) {
+		return nil, ErrManagement
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	process, token, _, identity, err := nativeManagementProcess()
+	if err != nil {
+		return nil, err
+	}
+	defer windows.CloseHandle(process)
+	defer token.Close()
+	if !matchesManagementProcess(expected, identity) {
+		return nil, ErrManagement
+	}
+	resolved, err := managementconfig.ResolveOrbWinRoot(root.Home, root.Suffix)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	reader, err := managementconfig.OpenInstanceReader(ctx, resolved)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	defer reader.Close()
+	state, err := windows.WaitForSingleObject(process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return nil, ErrManagement
+	}
+	client, err := LoadManagementClient(reader, binding)
+	if err != nil || ctx.Err() != nil {
+		if client != nil {
+			client.Close()
+		}
+		return nil, ErrManagement
+	}
+	state, err = windows.WaitForSingleObject(process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		client.Close()
+		return nil, ErrManagement
+	}
+	return client, nil
+}
+
+func matchesManagementProcess(expected app.NetworkProxyBinding, actual NativeManagementIdentity) bool {
+	return actual.PID != 0 && actual.Session != 0 && hexIdentity(actual.CreationTime, 16) && expected.HostPID == int64(actual.PID) && expected.HostCreationTime == actual.CreationTime
+}
+
+func managementInstancePath(nativeLocal string, root ManagementInstanceRoot) (string, error) {
+	if !managementSuffix(root.Suffix) {
+		return "", ErrManagement
+	}
+	if _, _, err := managementComponents(nativeLocal + `\placeholder`); err != nil {
+		return "", ErrManagement
+	}
+	expectedHome := filepath.Join(nativeLocal, "OrbWinData", "home")
+	if _, _, err := managementComponents(root.Home + `\placeholder`); err != nil || !strings.EqualFold(root.Home, expectedHome) {
+		return "", ErrManagement
+	}
+	path := filepath.Join(root.Home, "AppData", "Local", "rancher-desktop-"+root.Suffix, "config.yaml")
+	if _, _, err := managementComponents(path); err != nil {
+		return "", ErrManagement
+	}
+	return path, nil
+}
+
+func managementComponents(path string) (string, []string, error) {
+	if len(path) < 4 || len(path) > 1024 || path[1] != ':' || path[2] != '\\' || !((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) || strings.ContainsAny(path[2:], ":/\x00") {
+		return "", nil, ErrManagement
+	}
+	parts := strings.Split(path[3:], "\\")
+	if len(parts) < 1 || len(parts) > 32 {
+		return "", nil, ErrManagement
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") || strings.ContainsAny(part, "<>\"|?*") {
+			return "", nil, ErrManagement
+		}
+	}
+	return path[:3], parts, nil
+}
+
+func verifyManagementHandle(handle windows.Handle, _ string, directory bool) error {
+	if managementconfig.CheckReadObjectPolicy(handle, directory) != nil {
+		return ErrManagement
+	}
+	return nil
+}
+func trustedManagementSID(value, current string) bool {
+	// Exact Windows servicing principal, approved at the same OS privileged
+	// trust boundary as SYSTEM/admins. This never trusts arbitrary service SIDs.
+	return value == current || value == "S-1-5-18" || value == "S-1-5-32-544" || value == managementTrustedInstaller
+}
+
+const managementTrustedInstaller = "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"
