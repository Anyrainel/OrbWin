+	source.set(b, nil)
+	w.Modify(b)
+	waitConsumer(t, func() bool { return starts.Load() == 2 })
+	waitConsumer(t, func() bool {
+		source.mu.Lock()
+		defer source.mu.Unlock()
+		return source.lastHost != nil && source.lastHost.Phase == "degraded"
+	})
+	if c.Snapshot().ActiveRevision != 1 {
+		t.Fatal("failed startup replaced committed policy")
+	}
+	// Repeated event / unrelated generation does not replay startup or status.
+	w.Modify(b)
+	b = b.DeepCopy()
+	b.Generation++
+	b.ResourceVersion = "502"
+	source.set(b, nil)
+	w.Modify(b)
+	time.Sleep(30 * time.Millisecond)
+	if starts.Load() != 2 {
+		t.Fatal("failed startup automatically replayed")
+	}
+	changed := native.value
+	changed.Binding.TransportEpoch = "22222222222222222222222222222222"
+	native.change(changed)
+	b.ResourceVersion = "503"
+	source.set(b, nil)
+	w.Modify(b)
+	waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 0 })
+	cancel()
+	awaitConsumerExit(t, done)
+}
