+++ b/rdd/cmd/rdd/auto_worker.go
@@ -0,0 +1,22 @@
+package main
+
+import (
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"io"
+	"os"
+)
+
+// Fixed private stdio protocol, dispatched before Cobra or service options.
+// No URL, PAC source, credentials, filesystem name or desired state in argv.
+func autoWorkerCommand(args []string, input io.Reader, output io.Writer) (bool, int) {
+	if len(args) < 1 || args[0] != "private-auto-worker" {
+		return false, 0
+	}
+	if len(args) != 2 || os.Getenv("RDD_INSTANCE") != "orbwin" {
+		return true, 2
+	}
+	if networkproxy.RunBoundedAutoWorker(args[1], input, output) != nil {
+		return true, 2
+	}
+	return true, 0
+}
