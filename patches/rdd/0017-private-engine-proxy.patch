@@ -0,0 +1,35 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"net"
+	"net/url"
+	"strconv"
+)
+
+var errPrivatePublication = errors.New("private management publication unavailable")
+
+// The existing Serve invocation owns this lifetime; no competing service.
+type privateAuthority interface {
+	Publish(context.Context, []byte, string, []byte) error
+	BindServing(*networkproxy.ServingIdentity) error
+	Close() error
+	ResourcesStarted()
+	ResourcesRetired(bool)
+	MonitorExpiry(context.Context)
+}
+
+func privateDatastoreEndpoint(raw string) (string, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "http" || u.Hostname() != "127.0.0.1" || u.User != nil ||
+		u.Path != "" || u.RawPath != "" || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.RawFragment != "" || u.Opaque != "" {
+		return "", errPrivatePublication
+	}
+	port, err := strconv.Atoi(u.Port())
+	if err != nil || port < 1 || port > 65535 || u.Port() != strconv.Itoa(port) || raw != "http://"+net.JoinHostPort("127.0.0.1", u.Port()) {
+		return "", errPrivatePublication
+	}
+	return "https://" + u.Host, nil
+}
