@@ -0,0 +1,70 @@
+//go:build windows
+
+package controllers
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+// Fresh API objects and native self process metadata only, no actual API/config.
+func TestProxyLaunchObservationPersistsRejoinsAndClearsStaleCreation(t *testing.T) {
+	native, err := networkproxy.CurrentManagementProcess()
+	if err != nil {
+		t.Fatal("native metadata unavailable")
+	}
+	yes := true
+	a := &app.App{ObjectMeta: metav1.ObjectMeta{Name: "app", UID: "app-one", Generation: 1, ResourceVersion: "1"}}
+	v := &lima.LimaVM{ObjectMeta: metav1.ObjectMeta{Name: "orbwin", Namespace: a.GetResourceNamespace(), UID: "vm-one", ResourceVersion: "1", OwnerReferences: []metav1.OwnerReference{{APIVersion: app.GroupVersion.String(), Kind: "App", Name: a.Name, UID: a.UID, Controller: &yes}}}}
+	v.Status.RestartCount = 3
+	v.Status.Conditions = []metav1.Condition{{Type: "OtherOwnerReady", Status: metav1.ConditionTrue, Reason: "Ready", LastTransitionTime: metav1.Now()}}
+	receipt := &lima.NetworkProxyLaunchObservation{AppUID: string(a.UID), LimaVMUID: string(v.UID), HostPID: int64(native.PID), HostCreationTime: native.CreationTime, Session: native.Session, TransportEpoch: strings.Repeat("1", 32)}
+	scheme := runtime.NewScheme()
+	if err := app.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	if err := lima.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	c := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(&app.App{}, &lima.LimaVM{}).WithObjects(a, v).Build()
+	r := &LimaVMReconciler{Client: c, instanceStates: map[string]*instanceState{v.Name: {phase: phaseRunning, proxyLaunch: receipt, procExited: make(chan struct{})}}}
+	if err := r.syncProxyLaunch(context.Background(), v); err != nil {
+		t.Fatal(err)
+	}
+	if v.Status.NetworkProxyLaunch == nil || *v.Status.NetworkProxyLaunch != *receipt || v.Status.RestartCount != 3 || len(v.Status.Conditions) != 1 {
+		t.Fatal("launch observation lost identity or foreign status")
+	}
+	// Existing authenticated API record survives rdd watcher-map loss; no
+	// parent liveness/PID file/second process launch is required on reconnect.
+	r.instanceStates = nil
+	rv := v.ResourceVersion
+	if err := r.syncProxyLaunch(context.Background(), v); err != nil {
+		t.Fatal(err)
+	}
+	if v.ResourceVersion != rv {
+		t.Fatal("rejoin needlessly rewrote launch observation")
+	}
+	v.Status.NetworkProxyLaunch.HostCreationTime = "0000000000000001"
+	if err := c.Status().Update(context.Background(), v); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.syncProxyLaunch(context.Background(), v); err != nil {
+		t.Fatal(err)
+	}
+	current := &lima.LimaVM{}
+	if err := c.Get(context.Background(), client.ObjectKeyFromObject(v), current); err != nil {
+		t.Fatal(err)
+	}
+	if current.Status.NetworkProxyLaunch != nil || current.Status.RestartCount != 3 || len(current.Status.Conditions) != 1 {
+		t.Fatal("stale process retained or unrelated status changed")
+	}
+}
diff --git a/rdd/pkg/controllers/lima/limavm/controllers/startup_retirement.go b/rdd/pkg/controllers/lima/limavm/controllers/startup_retirement.go
