+
+func TestNativeChoicesPreserveOrderTLSAndExplicitDirect(t *testing.T) {
+	routes, err := choices([]nativeChoice{{proxy: true, scheme: 2, host: "Proxy.Example", port: 443}, {proxy: true, scheme: 1, host: "127.0.0.1", port: 8080}, {bypass: true}})
+	if err != nil || len(routes) != 3 || routes[0].Proxy != "https://proxy.example:443" || routes[1].Proxy != "http://127.0.0.1:8080" || !routes[2].Direct {
+		t.Fatal(routes, err)
+	}
+	for _, entries := range [][]nativeChoice{nil, make([]nativeChoice, 9), {{proxy: true, scheme: 3, host: "socks.example", port: 1080}}, {{proxy: true, scheme: 1, host: "user:secret@proxy.example", port: 80}}, {{proxy: true, scheme: 1, host: "proxy.example", port: 0}}, {{proxy: true, bypass: true, scheme: 1, host: "proxy.example", port: 80}}, {{}, {}}} {
+		if _, err := choices(entries); err == nil || strings.Contains(err.Error(), "secret") {
+			t.Fatal("bad native choice accepted or leaked endpoint")
+		}
+	}
+}
+func TestNativeStaticMappingBypassAndMixedModeRefusal(t *testing.T) {
+	config := ownerConfiguration{manual: "http=proxy.example:8080;https=https://secure-proxy.example:4443", bypass: "<local>;*.private.example;exact.example"}
+	for _, test := range []struct {
+		url, proxy string
+		direct     bool
+	}{{"http://public.example/", "http://proxy.example:8080", false}, {"https://public.example/", "https://secure-proxy.example:4443", false}, {"http://intranet/", "", true}, {"http://child.private.example/", "", true}, {"http://private.example/", "http://proxy.example:8080", false}, {"http://exact.example/", "", true}, {"http://child.exact.example/", "http://proxy.example:8080", false}} {
+		routes, err := config.staticRoutes(target(test.url))
+		if err != nil || routes[0].Direct != test.direct || routes[0].Proxy != test.proxy {
+			t.Fatalf("manual/bypass scope changed: %+v %v", routes, err)
+		}
+	}
+	for _, bad := range []ownerConfiguration{{auto: true, manual: "proxy.example:80"}, {pac: "https://user:secret@pac.example/"}, {pac: "file:///private/pac"}, {manual: "socks=proxy.example:1080"}, {manual: "http=proxy.example:80;http=other.example:80"}, {manual: "http=proxy.example:80;https=user:secret@proxy.example:443"}, {manual: "proxy.example:80", bypass: "10.0.0.0/8"}} {
+		err := bad.validate()
+		if err == nil {
+			_, err = bad.staticRoutes(target("https://public.example/"))
+		}
+		if err == nil || strings.Contains(err.Error(), "secret") {
+			t.Fatal("native source silently dropped unsupported configuration")
+		}
+	}
+	config = ownerConfiguration{manual: "https=proxy.example:80"}
+	routes, err := config.staticRoutes(target("https://public.example/"))
+	if err != nil || routes[0].Proxy != "http://proxy.example:80" {
+		t.Fatal("destination scheme was mistaken for proxy TLS scheme")
+	}
+	if err := (ownerConfiguration{pac: "https://pac.example/config.pac?private-token=opaque"}).validate(); err != nil {
+		t.Fatal("credential-free private PAC query refused", err)
+	}
+}
diff --git a/rdd/pkg/networkproxy/policy.go b/rdd/pkg/networkproxy/policy.go
new file mode 100644
index 0000000..c56b612
--- /dev/null
+++ b/rdd/pkg/networkproxy/policy.go
@@ -0,0 +1,84 @@
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"net/url"
+	"strings"
+
+	"golang.org/x/net/http/httpproxy"
+)
+
+type Policy struct {
+	config Config
+	auto   AutoResolver
+}
+
+func New(config Config, auto AutoResolver) (*Policy, error) {
+	if err := config.Validate(); err != nil {
+		return nil, err
+	}
+	if config.Mode == "auto" && auto == nil {
+		return nil, errors.New("native owner-context automatic proxy provider is unavailable")
+	}
+	config.NoProxy = append([]string{}, config.NoProxy...)
+	return &Policy{config: config, auto: auto}, nil
+}
+
+// Decide is per destination. It reads no process/Windows/guest global proxy
+// environment. DIRECT must be an explicit mode, bypass match or provider choice.
+func (policy *Policy) Decide(ctx context.Context, target *url.URL) ([]Route, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, errors.New("proxy decision canceled")
+	}
+	if err := validateTarget(target); err != nil {
+		return nil, err
+	}
+	if policy.config.Mode == "none" {
+		return []Route{{Direct: true}}, nil
+	}
+	// Reuse the selected upstream x/net parser, including loopback bypass. Only
+	// our explicit validated list is consulted, never HTTP_PROXY/NO_PROXY env.
+	matcher := (&httpproxy.Config{HTTPProxy: "http://bypass-matcher.invalid:80", HTTPSProxy: "http://bypass-matcher.invalid:80", NoProxy: strings.Join(policy.config.NoProxy, ",")}).ProxyFunc()
+	match, err := matcher(target)
+	if err != nil {
+		return nil, errors.New("proxy bypass decision unavailable")
+	}
+	if match == nil {
+		return []Route{{Direct: true}}, nil
+	}
+	if policy.config.Mode == "url" {
+		return []Route{{Proxy: policy.config.URL}}, nil
+	}
+	copyTarget := *target
+	routes, err := policy.auto.Resolve(ctx, &copyTarget)
+	if err != nil || ctx.Err() != nil {
+		return nil, errors.New("automatic proxy decision unavailable; direct fallback refused")
+	}
+	if len(routes) == 0 || len(routes) > 8 {
+		return nil, errors.New("automatic proxy decision exceeds route bounds")
+	}
+	result := make([]Route, 0, len(routes))
+	seen := map[string]bool{}
+	for _, route := range routes {
+		if route.Direct {
+			if route.Proxy != "" {
+				return nil, errors.New("ambiguous automatic proxy route")
+			}
+		} else {
+			if _, err := proxyURL(route.Proxy); err != nil {
+				return nil, errors.New("automatic proxy returned unsupported endpoint or credentials")
+			}
+		}
+		key := route.Proxy
+		if route.Direct {
+			key = "DIRECT"
+		}
+		if seen[key] {
+			return nil, errors.New("duplicate automatic proxy route")
+		}
+		seen[key] = true
+		result = append(result, route)
+	}
+	return result, nil
+}
diff --git a/rdd/pkg/networkproxy/selected_instance.go b/rdd/pkg/networkproxy/selected_instance.go
new file mode 100644
index 0000000..d25176a
--- /dev/null
+++ b/rdd/pkg/networkproxy/selected_instance.go
@@ -0,0 +1,99 @@
+package networkproxy
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/pem"
+	"io"
+	"net"
+	"net/url"
+	"strconv"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+)
+
+// SelectedManagementInstance is an immutable selection, not a credential or an
+// authentication protocol. Only the existing embedded manager and serving
+// process may supply its inputs. Passing objects read through the candidate
+// kubeconfig would make this check circular. The hostagent uses the independent
+// actual-launcher and retained private-authority handoff instead.
+type SelectedManagementInstance struct {
+	binding     ManagementBinding
+	native      app.NetworkProxyBinding
+	endpoint    string
+	certificate [32]byte
+}
+
+func (*SelectedManagementInstance) String() string   { return "private selected management instance" }
+func (*SelectedManagementInstance) GoString() string { return "private selected management instance" }
+
+// SelectManagementInstance consumes App/Lima snapshots from the embedded
+// manager's in-memory LoopbackClientConfig and the EXTERNAL serving certificate
+// and endpoint from completed SecureServing. The special apiserver loopback
+// client certificate/SNI is deliberately not the external authority. native is
+// the launcher's independently observed child PID+creation+epoch binding.
+func SelectManagementInstance(instance string, owner *app.App, vm *lima.LimaVM, native app.NetworkProxyBinding, endpoint string, certificatePEM []byte) (*SelectedManagementInstance, error) {
+	if instance != "orbwin" || !validSelectedOwners(owner, vm) || !validBinding(native) || native.LimaVMUID != string(vm.UID) || !canonicalManagementEndpoint(endpoint) {
+		return nil, ErrManagement
+	}
+	digest, err := managementCertificateDigest(certificatePEM)
+	if err != nil {
+		return nil, err
+	}
+	return &SelectedManagementInstance{binding: ManagementBinding{InstanceID: instance, AppUID: owner.UID}, native: native, endpoint: endpoint, certificate: digest}, nil
+}
+
+func validSelectedOwners(owner *app.App, vm *lima.LimaVM) bool {
+	if owner == nil || vm == nil || owner.Name != "app" || owner.Namespace != "" || vm.Namespace != owner.GetResourceNamespace() || owner.UID == "" || !safeASCII(string(owner.UID), 128) || vm.UID == "" || !safeASCII(string(vm.UID), 128) || vm.Name == "" || owner.ResourceVersion == "" || len(owner.ResourceVersion) > 128 || vm.ResourceVersion == "" || len(vm.ResourceVersion) > 128 || owner.DeletionTimestamp != nil || vm.DeletionTimestamp != nil {
+		return false
+	}
+	controllers := 0
+	for _, ref := range vm.OwnerReferences {
+		if ref.Controller != nil && *ref.Controller {
+			controllers++
+			if ref.APIVersion != app.GroupVersion.String() || ref.Kind != "App" || ref.Name != owner.Name || ref.UID != owner.UID {
+				return false
+			}
+		}
+	}
+	return controllers == 1
+}
+
+func canonicalManagementEndpoint(endpoint string) bool {
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "https" || u.User != nil || u.Opaque != "" || u.Path != "" || u.RawPath != "" || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.RawFragment != "" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "::1") {
+		return false
+	}
+	p, err := strconv.Atoi(u.Port())
+	return err == nil && p > 0 && p <= 65535 && u.Port() == strconv.Itoa(p) && u.Host == net.JoinHostPort(u.Hostname(), strconv.Itoa(p)) && endpoint == "https://"+u.Host
+}
+
+// Exactly one external serving certificate is supported. Compare DER rather
+// than PEM whitespace; never accept an added trust root or a partial PEM parse.
+func managementCertificateDigest(data []byte) ([32]byte, error) {
+	var zero [32]byte
+	if len(data) == 0 || len(data) > 64<<10 || !bytes.HasPrefix(data, []byte("-----BEGIN CERTIFICATE-----")) {
+		return zero, ErrManagement
+	}
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 || len(rest) != 0 {
+		return zero, ErrManagement
+	}
+	if _, err := x509.ParseCertificate(block.Bytes); err != nil {
+		return zero, ErrManagement
+	}
+	return sha256.Sum256(block.Bytes), nil
+}
+
+// LoadSelectedManagementClient checks independent authority BEFORE constructing
+// a credential-bearing transport. Re-observe the child binding before every
+// use/commit; equality here is only a startup snapshot, never process liveness.
+// This does not replace the separately required private held-handle reader.
+func LoadSelectedManagementClient(reader io.Reader, selection *SelectedManagementInstance, observed app.NetworkProxyBinding) (*ManagementClient, error) {
+	if selection == nil || observed != selection.native || !validBinding(observed) {
+		return nil, ErrManagement
+	}
+	return loadManagementClient(reader, selection.binding, selection)
+}
