+func TestPrivateTransportHostileReturnedStateCannotCorruptConcurrentOwners(t *testing.T) {
+	p := privateFixture(t)
+	badS, badC := privateServer(t, p), privateClient(t, p)
+	var wg sync.WaitGroup
+	wg.Add(2)
+	results := make(chan error, 1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 20; i++ {
+			for _, c := range []*tls.Config{badS, badC} {
+				key := c.Certificates[0].PrivateKey.(*ecdsa.PrivateKey)
+				key.D.SetInt64(int64(i))
+				key.PublicKey.X.SetInt64(int64(i))
+				leaf := c.Certificates[0].Leaf
+				leaf.NotAfter = time.Time{}
+				leaf.Raw[0] ^= 1
+				leaf.PublicKey.(*ecdsa.PublicKey).X.SetInt64(int64(i))
+				c.Certificates[0].Certificate[0][0] ^= 1
+			}
+			for _, pool := range []*x509.CertPool{badS.ClientCAs, badC.RootCAs} {
+				subjects := pool.Subjects()
+				if len(subjects) > 0 && len(subjects[0]) > 0 {
+					subjects[0][0] ^= 1
+				}
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 10; i++ {
+			a, b := privateExchange(privateServer(t, p), privateClient(t, p))
+			if a != nil || b != nil {
+				results <- fmt.Errorf("independent private exchange refused")
+				return
+			}
+		}
+	}()
+	wg.Wait()
+	select {
+	case e := <-results:
+		t.Fatal(e)
+	default:
+	}
