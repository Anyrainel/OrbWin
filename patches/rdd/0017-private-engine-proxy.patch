@@ -0,0 +1,450 @@
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+type consumerSourceFixture struct {
+	mu       sync.Mutex
+	current  *app.App
+	readErr  error
+	watches  chan *watch.RaceFreeFakeWatcher
+	writes   int
+	lastHost *app.NetworkProxyHostStatus
+	writeErr error
+}
+
+func (s *consumerSourceFixture) ReadApp(ctx context.Context) (*app.App, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if ctx.Err() != nil {
+		return nil, ErrManagement
+	}
+	if s.readErr != nil {
+		return nil, s.readErr
+	}
+	return s.current.DeepCopy(), nil
+}
+func (s *consumerSourceFixture) WatchApp(ctx context.Context, _ string) (watch.Interface, error) {
+	w := watch.NewRaceFreeFake()
+	select {
+	case s.watches <- w:
+		return w, nil
+	case <-ctx.Done():
+		w.Stop()
+		return nil, ErrManagement
+	}
+}
+func (s *consumerSourceFixture) WriteHostObservation(_ context.Context, owner *app.App, host *app.NetworkProxyHostStatus, binding app.NetworkProxyBinding) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if GuardHostObservation(owner, host, binding) != nil {
+		return errors.New("invalid owned status")
+	}
+	s.writes++
+	s.lastHost = host.DeepCopy()
+	return s.writeErr
+}
+func (s *consumerSourceFixture) set(owner *app.App, err error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.current = owner.DeepCopy()
+	s.readErr = err
+}
+
+func consumerApp(t *testing.T, mode, url string, revision, generation int64, phase string) *app.App {
+	t.Helper()
+	a := desiredFixture(t, mode)
+	a.Generation = generation
+	a.ResourceVersion = fmt.Sprintf("%d", generation*100+revision)
+	a.APIVersion = app.GroupVersion.String()
+	a.Kind = "App"
+	if mode == "url" {
+		a.Spec.NetworkProxy.URL = url
+	}
+	digest, err := DesiredDigest(a.Spec.NetworkProxy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Status.NetworkProxy.ConfigDigest = digest
+	a.Status.NetworkProxy.ProxyRevision = revision
+	a.Status.NetworkProxy.ObservedGeneration = generation
+	attachPlan(a, phase)
+	return a
+}
+func newConsumerFixture(t *testing.T, owner *app.App, factory GenerationFactory) (*PolicyConsumer, *consumerSourceFixture, *fixtureOwner, context.CancelFunc, <-chan error) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	source := &consumerSourceFixture{current: owner.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+	native := &fixtureOwner{value: GenerationOwner{AppUID: "app-one", Binding: bindingFixture()}}
+	c, err := NewPolicyConsumer(ctx, source, native.value, native.observe, factory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.endpointState(true)
+	done := make(chan error, 1)
+	go func() { done <- c.Run(ctx) }()
+	t.Cleanup(func() {
+		cancel()
+		cleanup, stop := context.WithTimeout(context.Background(), 2*time.Second)
+		defer stop()
+		c.Close(cleanup)
+	})
+	return c, source, native, cancel, done
+}
+func waitConsumer(t *testing.T, condition func() bool) {
+	t.Helper()
+	timer := time.NewTimer(4 * time.Second)
+	defer timer.Stop()
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	for !condition() {
+		select {
+		case <-timer.C:
+			t.Fatal("bounded consumer condition not reached")
+		case <-ticker.C:
+		}
+	}
+}
+func nextConsumerWatch(t *testing.T, source *consumerSourceFixture) *watch.RaceFreeFakeWatcher {
+	t.Helper()
+	select {
+	case w := <-source.watches:
+		return w
+	case <-time.After(4 * time.Second):
+		t.Fatal("watch not joined")
+		return nil
+	}
+}
+func awaitConsumerExit(t *testing.T, done <-chan error) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("consumer did not join")
+	}
+}
+
+func TestConsumerDisconnectRejoinStaleOwnerAndCPUGeneration(t *testing.T) {
+	var starts atomic.Int32
+	factory := func(a, b context.Context, config Config) (*Policy, GenerationResource, error) {
+		starts.Add(1)
+		return StaticPolicyFactory(a, b, config)
+	}
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	c, source, _, cancel, done := newConsumerFixture(t, a, factory)
+	w := nextConsumerWatch(t, source)
+	waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 1 })
+	if err := c.Run(context.Background()); err != ErrProxyBusy {
+		t.Fatal("second consumer admitted")
+	}
+	source.set(a, ErrManagement)
+	w.Stop()
+	time.Sleep(30 * time.Millisecond)
+	if c.Snapshot().ActiveRevision != 1 {
+		t.Fatal("disconnect revoked committed policy")
+	}
+	a.Generation = 4
+	a.ResourceVersion = "401"
+	a.Spec.VirtualMachine.CPUs = 8
+	source.set(a, nil)
+	w = nextConsumerWatch(t, source)
+	if starts.Load() != 1 {
+		t.Fatal("rejoin/CPU edit restarted immutable policy")
+	}
+	stale := a.DeepCopy()
+	stale.Status.NetworkProxy.Plan.Binding.HostCreationTime = "0000000000000099"
+	stale.ResourceVersion = "402"
+	source.set(stale, nil)
+	w.Modify(stale)
+	waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 0 })
+	// A later current permission recovers without restarting the hostagent.
+	a.Status.NetworkProxy.ProxyRevision = 2
+	a.Spec.NetworkProxy.URL = "http://127.0.0.1:2"
+	a.Status.NetworkProxy.ConfigDigest, _ = DesiredDigest(a.Spec.NetworkProxy)
+	attachPlan(a, "commit")
+	a.ResourceVersion = "403"
+	source.set(a, nil)
+	w.Modify(a)
+	waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 2 })
+	cancel()
+	awaitConsumerExit(t, done)
+}
