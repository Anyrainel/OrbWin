new file mode 100644
index 0000000..5d76a81
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_image_linux.go
@@ -0,0 +1,61 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"os"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+	"golang.org/x/sys/unix"
+)
+
+// /proc/self/exe identifies this running image, including after pathname
+// replacement. The host pins it to its embedded helper artifact; no user path
+// or command argument selects the file being hashed.
+func proxyExecutableHash(ctx context.Context) (string, error) {
+	if ctx == nil || ctx.Err() != nil || unix.Geteuid() != 0 {
+		return "", protocol.ErrUnavailable
+	}
+	f, err := os.Open("/proc/self/exe")
+	if err != nil {
+		return "", protocol.ErrUnavailable
+	}
+	defer f.Close()
+	var before, after unix.Stat_t
+	valid := func(s *unix.Stat_t) bool {
+		return s.Uid == 0 && s.Mode&unix.S_IFMT == unix.S_IFREG && s.Mode&0022 == 0 && s.Nlink == 1 && s.Size > 0 && s.Size <= 64<<20
+	}
+	if unix.Fstat(int(f.Fd()), &before) != nil || !valid(&before) {
+		return "", protocol.ErrUnavailable
+	}
+	h := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total int64
+	for {
+		if ctx.Err() != nil {
+			return "", protocol.ErrUnavailable
+		}
+		n, e := f.Read(buffer)
+		total += int64(n)
+		if total > 64<<20 {
+			return "", protocol.ErrUnavailable
+		}
+		if n > 0 {
+			_, _ = h.Write(buffer[:n])
+		}
+		if e == io.EOF {
+			break
+		}
+		if e != nil {
+			return "", protocol.ErrUnavailable
+		}
+	}
+	if unix.Fstat(int(f.Fd()), &after) != nil || !valid(&after) || total != before.Size || before.Dev != after.Dev || before.Ino != after.Ino || before.Size != after.Size || before.Mtim != after.Mtim || before.Ctim != after.Ctim || ctx.Err() != nil {
+		return "", protocol.ErrUnavailable
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
