+func TestGenerationStartupFailureBusyAndImmutableOldAdmission(t *testing.T) {
+	entered, finish := make(chan struct{}), make(chan struct{})
+	var starts atomic.Int32
+	resources := []*fixtureResource{{}, {}}
+	factory := func(start, lifetime context.Context, config Config) (*Policy, GenerationResource, error) {
+		index := int(starts.Add(1)) - 1
+		policy, _ := New(config, nil)
+		if index == 1 {
+			close(entered)
+			select {
+			case <-finish:
+			case <-start.Done():
+			}
+			return policy, resources[index], errors.New("controlled startup failure")
+		}
+		return policy, resources[index], nil
+	}
+	supervisor, owner := supervisorFixture(t, context.Background(), factory)
+	defer closeSupervisor(t, supervisor)
+	startFixtureGeneration(t, supervisor, owner.value, 1, "url")
+	lease, err := supervisor.Acquire(context.Background(), func() {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	outcome := make(chan error, 1)
+	plan, config := generationInput(t, owner.value, 2, "none")
+	go func() { _, err := supervisor.Replace(context.Background(), plan, config); outcome <- err }()
+	<-entered
+	if _, err := supervisor.Replace(context.Background(), plan, config); !errors.Is(err, ErrProxyBusy) {
+		t.Fatal("parallel startup queued or ran")
+	}
+	during, err := supervisor.Acquire(context.Background(), func() {})
+	if err != nil || during.Revision() != 1 || during.Policy() != lease.Policy() {
+		t.Fatal("startup changed old admissions", err)
+	}
+	close(finish)
+	if err := <-outcome; err == nil {
+		t.Fatal("failed startup reported success")
+	}
+	if supervisor.Snapshot().ActiveRevision != 1 || resources[0].calls.Load() != 0 || resources[1].calls.Load() != 1 {
+		t.Fatal("failure replaced/retired prior committed policy")
+	}
+	during.Release(context.Background())
+	lease.Release(context.Background())
+	// Identical revision/digest acknowledges without another startup.
+	startFixtureGeneration(t, supervisor, owner.value, 1, "url")
+	if starts.Load() != 2 {
+		t.Fatal("idempotent intent restarted a policy")
+	}
+	forged, unchanged := generationInput(t, owner.value, 1, "url")
+	forged.ProxyRevision = 3
+	if _, err := supervisor.Replace(context.Background(), forged, unchanged); err == nil || starts.Load() != 2 {
+		t.Fatal("unrelated revision change rebuilt identical policy")
+	}
+}
