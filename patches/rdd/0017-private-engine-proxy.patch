+
+func fixtureRequest(mode string) Request {
+	phase := "prepare"
+	if mode == "none" {
+		phase = "disable"
+	}
+	r := Request{Schema: 1, Mode: mode, Owner: Owner{AppUID: "app-one", LimaUID: "vm-one", HostPID: 1, HostCreation: "0000000000000001", Epoch: strings.Repeat("1", 32), Revision: 1, Digest: strings.Repeat("a", 64), Phase: phase}, Identity: Identity{RegistrationGUID: "{11111111-1111-1111-1111-111111111111}", MachineID: strings.Repeat("a", 32), DaemonID: "owned-daemon"}}
+	r.ID = r.TransactionID()
+	return r
+}
+func TestClosedBoundedWireRejectsSmugglingAndWrongReceipt(t *testing.T) {
+	r := fixtureRequest("url")
+	var wire bytes.Buffer
+	if WriteFrame(&wire, r) != nil {
+		t.Fatal("encode")
+	}
+	var decoded Request
+	if ReadFrame(bufio.NewReaderSize(bytes.NewReader(wire.Bytes()), MaxFrame+1), &decoded) != nil || decoded != r || decoded.Validate() != nil {
+		t.Fatal("canonical request failed")
+	}
+	for _, bad := range []string{strings.TrimSuffix(wire.String(), "\n") + " \n", strings.Replace(wire.String(), `"schema":1`, `"schema":1,"schema":1`, 1), strings.Replace(wire.String(), `"schema":1`, `"schema":1,"path":"/foreign"`, 1), strings.Repeat("x", MaxFrame+1) + "\n"} {
+		if ReadFrame(bufio.NewReaderSize(strings.NewReader(bad), MaxFrame+1), &decoded) == nil {
+			t.Fatal("smuggled frame accepted")
+		}
+	}
+	none := fixtureRequest("none")
+	receipt := none.Receipt(AbsentDirect)
+	receipt.ConfigHash = Hash(nil)
+	receipt.RuntimeHash = DirectRuntimeHash()
+	receipt.SettlementHash = strings.Repeat("b", 64)
+	if GuardReceipt(none, receipt) != nil {
+		t.Fatal("current none proof refused")
+	}
+	receipt = r.Receipt(AbsentDirect)
+	receipt.ConfigHash = Hash(nil)
+	receipt.RuntimeHash = DirectRuntimeHash()
+	receipt.SettlementHash = strings.Repeat("b", 64)
+	if GuardReceipt(r, receipt) == nil {
+		t.Fatal("URL claimed absent direct applied")
+	}
+}
+
+type memoryBackend struct {
+	request                          Request
+	current                          Observation
+	journal                          *Journal
+	stages                           []string
+	install, restart, acquire, close int
+	fail                             string
+	closeErr                         bool
+	busy                             bool
+	cancel                           context.CancelFunc
+}
+
+func fixtureBackend(r Request) *memoryBackend {
+	return &memoryBackend{request: r, current: Observation{MachineID: r.Identity.MachineID, DaemonID: r.Identity.DaemonID, FileHash: Hash(nil), Runtime: "direct", Quiescent: true}}
+}
+func (b *memoryBackend) Acquire(context.Context) (Lease, error) {
+	b.acquire++
+	if b.busy {
+		return nil, ErrUnavailable
+	}
+	return b, nil
+}
+func (b *memoryBackend) Close() error {
+	b.close++
+	if b.closeErr {
+		return ErrUnavailable
+	}
+	return nil
+}
+func (b *memoryBackend) Observe(ctx context.Context) (Observation, error) {
+	if ctx.Err() != nil || b.fail == "observe" {
+		return Observation{}, ErrUnavailable
+	}
+	return b.current, nil
+}
+func (b *memoryBackend) Load(context.Context) (*Journal, error) {
+	if b.fail == "load" {
+		return nil, ErrUnavailable
+	}
+	if b.journal == nil {
+		return nil, nil
+	}
+	copy := *b.journal
+	return &copy, nil
+}
+func (b *memoryBackend) Persist(_ context.Context, j Journal) error {
+	b.stages = append(b.stages, j.Stage)
+	if b.fail == "before-"+j.Stage {
+		return ErrUnavailable
+	}
+	copy := j
+	b.journal = &copy
+	if b.cancel != nil && j.Stage == "restart-admitted" {
+		b.cancel()
+	}
+	if b.fail == "after-"+j.Stage {
+		return ErrUnavailable
+	}
+	return nil
+}
+func (b *memoryBackend) Install(_ context.Context, before Observation) error {
+	b.install++
+	if b.current != before {
+		return ErrInvalid
+	}
+	if b.fail == "install-before" {
+		return ErrUnavailable
+	}
+	b.current.FilePresent = true
+	b.current.FileOwned = true
+	b.current.Device = 1
+	b.current.Inode = 2
+	b.current.FileHash = CompatibilityHash()
+	if b.fail == "install-after" {
+		return ErrUnavailable
+	}
+	return nil
+}
+func (b *memoryBackend) Restart(context.Context) error {
+	b.restart++
+	if b.fail == "restart-before" {
+		return ErrUnavailable
+	}
+	b.current.Runtime = Compatibility
+	if b.fail == "restart-after" {
+		return ErrUnavailable
+	}
+	return nil
+}
+
+func TestRealTransactionStateMachineDurableAdmissionAndNoRestartReplay(t *testing.T) {
+	r := fixtureRequest("url")
+	b := fixtureBackend(r)
+	receipt, err := ApplyOrObserve(context.Background(), b, r)
+	if err != nil || GuardReceipt(r, receipt) != nil || b.install != 1 || b.restart != 1 {
+		t.Fatal("initial transaction failed", err)
+	}
+	want := []string{"intent", "write-admitted", "config-present", "restart-admitted", "restart-retired", "settled"}
+	if strings.Join(b.stages, ",") != strings.Join(want, ",") {
+		t.Fatal("durable ordering violated", b.stages)
+	}
+	if _, err := ApplyOrObserve(context.Background(), b, r); err != nil || b.install != 1 || b.restart != 1 {
+		t.Fatal("settled operation replayed", err)
+	}
+	none := fixtureRequest("none")
+	none.Owner.Revision = 2
+	none.ID = none.TransactionID()
+	receipt, err = ApplyOrObserve(context.Background(), b, none)
+	if err != nil || receipt.Disposition != Compatibility || GuardReceipt(none, receipt) != nil || b.install != 1 || b.restart != 1 {
+		t.Fatal("None rewrote/restarted compatibility environment", err)
+	}
+}
+
+func TestEveryDurabilityFaultRefusesAckAndDoesNotRepeatAdmittedRestart(t *testing.T) {
+	for _, fault := range []string{"observe", "load", "before-intent", "after-intent", "before-write-admitted", "after-write-admitted", "install-before", "install-after", "before-config-present", "after-config-present", "before-restart-admitted", "after-restart-admitted", "restart-before", "restart-after", "before-restart-retired", "after-restart-retired", "before-settled", "after-settled"} {
+		t.Run(fault, func(t *testing.T) {
+			r := fixtureRequest("url")
+			b := fixtureBackend(r)
+			b.fail = fault
+			receipt, err := ApplyOrObserve(context.Background(), b, r)
+			if err == nil || receipt.Disposition == Compatibility || receipt.Disposition == AbsentDirect {
+				t.Fatal("fault acknowledged applied")
+			}
+			before := b.restart
+			b.fail = ""
+			_, _ = ApplyOrObserve(context.Background(), b, r)
+			if before > 0 && b.restart != before {
+				t.Fatal("uncertain restart replayed")
+			}
+			if b.journal != nil && b.journal.Stage == "restart-admitted" && b.restart > 1 {
+				t.Fatal("admitted restart repeated")
+			}
+		})
+	}
+}
+
+func TestNoneAbsentRequiresQuiescenceAndExplicitPriorRecovery(t *testing.T) {
+	r := fixtureRequest("none")
+	b := fixtureBackend(r)
+	receipt, err := ApplyOrObserve(context.Background(), b, r)
+	if err != nil || GuardReceipt(r, receipt) != nil || receipt.Disposition != AbsentDirect || b.install != 0 || b.restart != 0 {
+		t.Fatal("None did not prove current absent/direct", err)
+	}
+	for _, fault := range []string{"live-writer", "systemd-pending", "runtime-unknown", "foreign", "allowed-images"} {
+		t.Run(fault, func(t *testing.T) {
+			b := fixtureBackend(r)
+			switch fault {
+			case "live-writer":
+				b.busy = true
+			case "systemd-pending":
+				b.current.Quiescent = false
+			case "runtime-unknown":
+				b.current.Runtime = Unknown
+			case "foreign":
+				b.current.Foreign = true
+			case "allowed-images":
+				b.current.AllowedImages = true
+			}
+			receipt, err := ApplyOrObserve(context.Background(), b, r)
+			if err == nil || receipt.Disposition == AbsentDirect || b.install != 0 || b.restart != 0 {
+				t.Fatal("None fabricated proof or installed env to disable")
+			}
+		})
+	}
+	// Interrupted prior URL has no historical installation assertion. Only the
+	// current exclusive lock + current direct/no-file + settled recovery permits
+	// a refused predecessor receipt and then an applied current None receipt.
+	old := fixtureRequest("url")
+	b = fixtureBackend(r)
+	b.journal = &Journal{Schema: 1, Request: old, Stage: "restart-admitted", Before: b.current}
+	receipt, err = ApplyOrObserve(context.Background(), b, r)
+	if err != nil || receipt.Disposition != AbsentDirect || len(b.stages) < 2 || b.stages[0] != "quiescent-unapplied" || b.install != 0 || b.restart != 0 {
+		t.Fatal("prior operation not settled before None", err)
+	}
+}
+
+func TestCanceledAdmissionAndCloseFailureRemainUnknown(t *testing.T) {
+	r := fixtureRequest("url")
+	b := fixtureBackend(r)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	b.cancel = cancel
+	receipt, err := ApplyOrObserve(ctx, b, r)
+	if err == nil || receipt.Disposition != Unknown || b.restart != 0 || b.journal.Stage != "restart-admitted" {
+		t.Fatal("canceled restart admission replayed/acknowledged")
+	}
+	b = fixtureBackend(fixtureRequest("none"))
+	b.closeErr = true
+	receipt, err = ApplyOrObserve(context.Background(), b, b.request)
+	if !errors.Is(err, ErrUnavailable) || receipt.Disposition != Unknown || b.close != 1 {
+		t.Fatal("failed lock retirement claimed applied")
+	}
+}
+
+// Real freshly owned filesystem at the injected transaction boundary. This
+// qualifies absent-final-directory sequencing, not Linux root/openat2 flags.
+type filesystemBackend struct {
+	*memoryBackend
+	parent string
+}
+
+func (b *filesystemBackend) Acquire(context.Context) (Lease, error) { return b, nil }
+func (b *filesystemBackend) Observe(ctx context.Context) (Observation, error) {
+	current, err := b.memoryBackend.Observe(ctx)
+	if err != nil {
+		return current, err
+	}
+	data, err := os.ReadFile(filepath.Join(b.parent, "docker.service.d", "90-orbwin-network-proxy.conf"))
+	if os.IsNotExist(err) {
+		current.FilePresent = false
+		current.FileOwned = false
+		current.FileHash = Hash(nil)
+		current.Device = 0
+		current.Inode = 0
+		return current, nil
+	}
+	if err != nil {
+		return Observation{}, ErrUnavailable
+	}
+	current.FilePresent = true
+	current.FileOwned = true
+	current.FileHash = Hash(data)
+	current.Device = 1
+	current.Inode = 2
+	return current, nil
+}
+func (b *filesystemBackend) Install(ctx context.Context, before Observation) error {
+	if b.journal == nil || b.journal.Stage != "write-admitted" {
+		return ErrInvalid
+	}
+	current, err := b.Observe(ctx)
+	if err != nil || current != before || current.FilePresent {
+		return ErrInvalid
+	}
+	b.install++
+	dir := filepath.Join(b.parent, "docker.service.d")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(dir, "90-orbwin-network-proxy.conf"), CompatibilityBody(), 0600)
+}
+func TestMissingFinalLocalDirectoryNoneNeverCreatesAndInstallRequiresIntent(t *testing.T) {
+	for _, mode := range []string{"none", "url", "url-before-admission"} {
+		t.Run(mode, func(t *testing.T) {
+			route := mode
+			if mode == "url-before-admission" {
+				route = "url"
+			}
+			r := fixtureRequest(route)
+			b := &filesystemBackend{memoryBackend: fixtureBackend(r), parent: t.TempDir()}
+			if mode == "url-before-admission" {
+				b.fail = "before-write-admitted"
+			}
+			receipt, err := ApplyOrObserve(context.Background(), b, r)
+			_, statErr := os.Stat(filepath.Join(b.parent, "docker.service.d"))
+			if mode == "url" {
+				if err != nil || statErr != nil || receipt.Disposition != Compatibility || b.install != 1 {
+					t.Fatal("first install failed with absent final local directory", err)
+				}
+			} else {
+				if !os.IsNotExist(statErr) || b.install != 0 {
+					t.Fatal("None/failed admission created config directory")
+				}
+				if mode == "none" && (err != nil || receipt.Disposition != AbsentDirect) {
+					t.Fatal("absent directory blocked None current direct proof")
+				}
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/proxyguestprotocol/transaction.go b/rdd/pkg/proxyguestprotocol/transaction.go
new file mode 100644
index 0000000..cf29623
--- /dev/null
+++ b/rdd/pkg/proxyguestprotocol/transaction.go
@@ -0,0 +1,259 @@
+package proxyguestprotocol
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+)
+
+// All methods operate under the one acquired native fixed-path writer lease.
+// Persist must durably replace the bounded journal (file+directory fsync);
+// Install must recheck the supplied observation before fixed-content mutation.
+// Neither interface nor hash authenticates an untrusted provider. Only the
+// reviewed guest root provider may be registered; test fakes prove ordering only.
+type Backend interface {
+	Acquire(context.Context) (Lease, error)
+}
+type Lease interface {
+	Observe(context.Context) (Observation, error)
+	Load(context.Context) (*Journal, error)
+	Persist(context.Context, Journal) error
+	Install(context.Context, Observation) error
+	Restart(context.Context) error
+	Close() error
+}
+type Observation struct {
+	MachineID, DaemonID string
+	FilePresent         bool
+	FileOwned           bool
+	FileHash            string
+	Device, Inode       uint64
+	// Runtime is compatibility/direct/unknown, derived from exact owned daemon
+	// identity, initial process env and effective /info proxy settings.
+	Runtime string
+	// Quiescent requires no pending owned writer/systemd transaction that may
+	// later change the current postcondition. Lock acquisition alone cannot
+	// settle a systemd job that outlived a prior helper.
+	Quiescent              bool
+	Foreign, AllowedImages bool
+}
+type Journal struct {
+	Schema  int         `json:"schema"`
+	Request Request     `json:"request"`
+	Stage   string      `json:"stage"`
+	Before  Observation `json:"before"`
+	Receipt Receipt     `json:"receipt"`
+}
+
+func (j Journal) Validate() error {
+	if j.Schema != 1 || j.Request.Validate() != nil {
+		return ErrInvalid
+	}
+	switch j.Stage {
+	case "intent", "write-admitted", "config-present", "restart-admitted", "restart-retired":
+		if j.Receipt != (Receipt{}) {
+			return ErrInvalid
+		}
+	case "settled":
+		if GuardReceipt(j.Request, j.Receipt) != nil {
+			return ErrInvalid
+		}
+	case "quiescent-unapplied":
+		if j.Receipt.Schema != 1 || j.Receipt.ID != j.Request.ID || j.Receipt.Owner != j.Request.Owner || j.Receipt.Identity != j.Request.Identity || j.Receipt.Mode != j.Request.Mode || j.Receipt.Disposition != Refused || j.Receipt.ConfigHash != Hash(nil) || j.Receipt.RuntimeHash != DirectRuntimeHash() || !hexID(j.Receipt.SettlementHash, 64) {
+			return ErrInvalid
+		}
+	default:
+		return ErrInvalid
+	}
+	return nil
+}
+func observationValid(request Request, current Observation) bool {
+	return current.MachineID == request.Identity.MachineID && current.DaemonID == request.Identity.DaemonID && !current.Foreign && !current.AllowedImages && current.Quiescent && ((!current.FilePresent && !current.FileOwned && current.Device == 0 && current.Inode == 0 && current.FileHash == Hash(nil)) || current.FilePresent && current.FileOwned && current.Device != 0 && current.Inode != 0 && current.FileHash == CompatibilityHash())
+}
+func currentDisposition(request Request, current Observation) string {
+	if !observationValid(request, current) {
+		return ""
+	}
+	if current.FilePresent && current.Runtime == Compatibility {
+		return Compatibility
+	}
+	if request.Mode == "none" && !current.FilePresent && current.Runtime == "direct" {
+		return AbsentDirect
+	}
+	return ""
+}
+func settle(ctx context.Context, lease Lease, journal Journal, current Observation) (Receipt, error) {
+	disposition := currentDisposition(journal.Request, current)
+	if disposition == "" {
+		return journal.Request.Receipt(Unknown), ErrUnavailable
+	}
+	receipt := journal.Request.Receipt(disposition)
+	if disposition == Compatibility {
+		receipt.ConfigHash = CompatibilityHash()
+		receipt.RuntimeHash = CompatibilityHash()
+	} else {
+		receipt.ConfigHash = Hash(nil)
+		receipt.RuntimeHash = DirectRuntimeHash()
+	}
+	// Hash binds current postcondition and exact operation, not historical
+	// installation claims. The trusted provider's durable journal is authority.
+	encoded, _ := json.Marshal(struct {
+		Request Request
+		Current Observation
+	}{journal.Request, current})
+	receipt.SettlementHash = Hash(encoded)
+	journal.Stage = "settled"
+	journal.Receipt = receipt
+	if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+		return journal.Request.Receipt(Unknown), ErrUnavailable
+	}
+	return receipt, nil
+}
+
+// ApplyOrObserve owns one writer lease, no goroutine/retry/restart queue. Native
+// providers check context at transitions; synchronous syscalls aren't preempted.
+func ApplyOrObserve(ctx context.Context, backend Backend, request Request) (receipt Receipt, resultErr error) {
+	refused := request.Receipt(Refused)
+	unknown := request.Receipt(Unknown)
+	if ctx == nil || ctx.Err() != nil || backend == nil || request.Validate() != nil {
+		return refused, ErrInvalid
+	}
+	lease, err := backend.Acquire(ctx)
+	if err != nil {
+		return unknown, ErrUnavailable
+	}
+	defer func() {
+		if lease.Close() != nil {
+			receipt = unknown
+			resultErr = ErrUnavailable
+		}
+	}()
+	old, err := lease.Load(ctx)
+	if err != nil {
+		return unknown, ErrUnavailable
+	}
+	if old != nil && old.Validate() != nil {
+		return refused, ErrInvalid
+	}
+	current, err := lease.Observe(ctx)
+	if errors.Is(err, ErrPending) && (old == nil || old.Request == request && (old.Stage == "restart-admitted" || old.Stage == "restart-retired")) {
+		return unknown, ErrPending
+	}
+	if err != nil || !observationValid(request, current) {
+		return unknown, ErrUnavailable
+	}
+	if old != nil && old.Request.ID != request.ID && old.Stage != "settled" && old.Stage != "quiescent-unapplied" {
+		// None may settle an interrupted predecessor only from CURRENT absent
+		// file/direct runtime + native exclusive lock/systemd quiescence. This
+		// records no applied receipt and makes no installation-history claim.
+		if request.Mode != "none" || old.Request.Identity != request.Identity || old.Request.Owner.AppUID != request.Owner.AppUID || old.Request.Owner.LimaUID != request.Owner.LimaUID || currentDisposition(request, current) != AbsentDirect {
+			return unknown, ErrUnavailable
+		}
+		recovered := *old
+		recovered.Stage = "quiescent-unapplied"
+		recovered.Receipt = recovered.Request.Receipt(Refused)
+		recovered.Receipt.ConfigHash = Hash(nil)
+		recovered.Receipt.RuntimeHash = DirectRuntimeHash()
+		encoded, _ := json.Marshal(struct {
+			Previous Request
+			Current  Observation
+		}{recovered.Request, current})
+		recovered.Receipt.SettlementHash = Hash(encoded)
+		if ctx.Err() != nil || lease.Persist(ctx, recovered) != nil {
+			return unknown, ErrUnavailable
+		}
+		old = &recovered
+	}
+	if old != nil && old.Request.ID != request.ID {
+		// Same selected guest and before content must match a protected settled
+		// receipt. A marker/hash supplied by a caller cannot adopt foreign state.
+		if old.Request.Identity != request.Identity || old.Request.Owner.AppUID != request.Owner.AppUID || old.Request.Owner.LimaUID != request.Owner.LimaUID || old.Receipt.ConfigHash != current.FileHash && current.FilePresent || old.Receipt.Disposition == Compatibility && !current.FilePresent {
+			return refused, ErrInvalid
+		}
+	}
+	if old != nil && old.Request.ID == request.ID {
+		if old.Request != request {
+			return refused, ErrInvalid
+		}
+		if old.Stage == "settled" {
+			if currentDisposition(request, current) != old.Receipt.Disposition {
+				return unknown, ErrUnavailable
+			}
+			return old.Receipt, nil
+		}
+		if old.Stage == "quiescent-unapplied" {
+			return refused, ErrUnavailable
+		}
+		// An already admitted restart can only be observed, never repeated.
+		if old.Stage == "restart-admitted" || old.Stage == "restart-retired" {
+			return settle(ctx, lease, *old, current)
+		}
+	}
+	journal := Journal{Schema: 1, Request: request, Stage: "intent", Before: current}
+	if old != nil && old.Request.ID == request.ID {
+		journal = *old
+	} else {
+		if current.FilePresent && old == nil {
+			return refused, ErrInvalid
+		}
+		if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+			return unknown, ErrUnavailable
+		}
+	}
+	if currentDisposition(request, current) != "" {
+		return settle(ctx, lease, journal, current)
+	}
+	// None with absent current file but unresolved runtime is not permission to
+	// install env just to claim disabling succeeded. Unknown remains unknown.
+	if request.Mode == "none" && !current.FilePresent {
+		return unknown, ErrUnavailable
+	}
+	if !current.FilePresent {
+		if journal.Stage != "intent" {
+			return unknown, ErrUnavailable
+		}
+		journal.Stage = "write-admitted"
+		if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+			return unknown, ErrUnavailable
+		}
+		if ctx.Err() != nil || lease.Install(ctx, current) != nil {
+			return unknown, ErrUnavailable
+		}
+		current, err = lease.Observe(ctx)
+		if err != nil || !observationValid(request, current) || !current.FilePresent {
+			return unknown, ErrUnavailable
+		}
+	}
+	if current.FileHash != CompatibilityHash() {
+		return refused, ErrInvalid
+	}
+	journal.Stage = "config-present"
+	if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+		return unknown, ErrUnavailable
+	}
+	if currentDisposition(request, current) != "" {
+		return settle(ctx, lease, journal, current)
+	}
+	journal.Stage = "restart-admitted"
+	if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+		return unknown, ErrUnavailable
+	}
+	if ctx.Err() != nil || lease.Restart(ctx) != nil {
+		return unknown, ErrUnavailable
+	}
+	// Native provider may assert writer quiescence on rejoin only after its
+	// action processes were actually reaped and this stage became durable.
+	// A gap before this record stays unknown, not inferred from systemd Job=0.
+	journal.Stage = "restart-retired"
+	if ctx.Err() != nil || lease.Persist(ctx, journal) != nil {
+		return unknown, ErrUnavailable
+	}
+	current, err = lease.Observe(ctx)
+	if errors.Is(err, ErrPending) {
+		return unknown, ErrPending
+	}
+	if err != nil {
+		return unknown, ErrUnavailable
+	}
+	return settle(ctx, lease, journal, current)
+}
diff --git a/rdd/pkg/service/cmd/private_authority.go b/rdd/pkg/service/cmd/private_authority.go
new file mode 100644
index 0000000..f9ed364
