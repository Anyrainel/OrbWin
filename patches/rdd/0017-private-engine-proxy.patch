new file mode 100644
index 0000000..89aac01
--- /dev/null
+++ b/rdd/cmd/rdd/private_preflight.go
@@ -0,0 +1,31 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+)
+
+// This closed dispatch precedes every Cobra constructor: constructing the
+// normal service command constructs options that probe a native loopback port.
+func privateAuthorityPreflight(args []string, output io.Writer) (bool, int) {
+	if len(args) < 2 || args[0] != "service" || args[1] != "private-authority-preflight" {
+		return false, 0
+	}
+	result := managementconfig.AuthorityPreflight{Schema: 1, Instance: "orbwin", Authority: "unavailable"}
+	if len(args) == 3 && args[2] == "--json" && os.Getenv("RDD_INSTANCE") == "orbwin" {
+		if home, err := os.UserHomeDir(); err == nil {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			result = managementconfig.ObserveAuthorityPreflight(ctx, home, "orbwin")
+			cancel()
+		}
+	}
+	if json.NewEncoder(output).Encode(result) != nil {
+		return true, 2
+	}
+	return true, 0
+}
diff --git a/rdd/cmd/rdd/private_preflight_test.go b/rdd/cmd/rdd/private_preflight_test.go
new file mode 100644
index 0000000..23a0064
--- /dev/null
+++ b/rdd/cmd/rdd/private_preflight_test.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+)
+
+func TestPrivateAuthorityPreflightClosedDispatch(t *testing.T) {
+	// Invalid shapes must not invoke native observation, even with valid product
+	// selection. All yield a bounded refusal before normal command construction.
+	t.Setenv("RDD_INSTANCE", "orbwin")
+	for _, args := range [][]string{{"service", "private-authority-preflight"}, {"service", "private-authority-preflight", "--json", "extra"}, {"service", "private-authority-preflight", "--output=json"}} {
+		var out bytes.Buffer
+		handled, code := privateAuthorityPreflight(args, &out)
+		var result struct {
+			Schema              int
+			Instance, Authority string
+			StartupCompatible   bool
+		}
+		if !handled || code != 0 || out.Len() > 1024 || json.Unmarshal(out.Bytes(), &result) != nil || result.Schema != 1 || result.Authority != "unavailable" || result.StartupCompatible {
+			t.Fatal("closed preflight refusal failed")
+		}
+	}
+	var out bytes.Buffer
+	if handled, _ := privateAuthorityPreflight([]string{"service", "status"}, &out); handled || out.Len() != 0 {
+		t.Fatal("intercepted unrelated command")
+	}
+}
