+func TestPrivateStartupArgumentsClosedPolicy(t *testing.T) {
+	for _, data := range []string{`["--secure-port","6443"]`, `["--secure-port","6443","--controllers=*,-path-management"]`, `["--secure-port","6443","--controllers","*,-path-management"]`} {
+		if !privateStartupArguments([]byte(data)) {
+			t.Fatalf("expected compatible arguments")
+		}
+	}
+	for _, data := range []string{`null`, `[]`, `["--secure-port","0"]`, `["--secure-port","06443"]`, `["--secure-port","65536"]`, `["--secure-port","6443","--tls-private-key-file=external"]`, `["--secure-port","6443","--controllers=*"]`, `["--secure-port","6443","--controllers=*,-path-management","--v=2"]`, `["--secure-port","6443"] false`} {
+		if privateStartupArguments([]byte(data)) {
+			t.Fatalf("accepted incompatible argument shape")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/preflight_windows.go b/rdd/pkg/managementconfig/preflight_windows.go
new file mode 100644
index 0000000..e2e30aa
--- /dev/null
+++ b/rdd/pkg/managementconfig/preflight_windows.go
@@ -0,0 +1,88 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+// ObserveAuthorityPreflight only opens existing typed objects. In particular it
+// does not acquire/create authority.owner.lock, load private keys, construct
+// service options, connect to a service, or repair an existing ACL. An active
+// initialized owner can therefore remain running throughout this observation.
+func ObserveAuthorityPreflight(ctx context.Context, home, suffix string) AuthorityPreflight {
+	no := preflightResult("unavailable", false)
+	root, err := ResolveOrbWinRoot(home, suffix)
+	if err != nil {
+		return no
+	}
+	parents, err := openInstanceParentMode(ctx, root, false, true)
+	if err == errProductParentAbsent {
+		return preflightResult("fresh", true)
+	}
+	if err != nil {
+		return no
+	}
+	defer parents.Close()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	anchor, err := openRelative(parents.leaf(), anchorName, true, nil, false)
+	if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return preflightResult("fresh", true)
+	}
+	if err != nil {
+		return no
+	}
+	defer windows.CloseHandle(anchor)
+	if checkReadObject(anchor, root.sid, true) != nil {
+		return no
+	}
+	marker, err := authorityOpen(anchor, "authority.init", nil, windows.FILE_OPEN, windows.FILE_READ_DATA|windows.READ_CONTROL, windows.FILE_SHARE_READ)
+	if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return preflightResult("legacy", false)
+	}
+	if err != nil {
+		return no
+	}
+	defer windows.CloseHandle(marker)
+	if verifyPrivate(anchor, root.sid, true) != nil || verifyPrivate(marker, root.sid, false) != nil {
+		return no
+	}
+	argsHandle, err := authorityOpen(anchor, "args.json", nil, windows.FILE_OPEN, windows.FILE_READ_DATA|windows.READ_CONTROL, windows.FILE_SHARE_READ)
+	if err != nil {
+		return no
+	}
+	defer windows.CloseHandle(argsHandle)
+	if verifyPrivate(argsHandle, root.sid, false) != nil {
+		return no
+	}
+	args, err := authorityRead(argsHandle, 65536)
+	if err != nil {
+		return no
+	}
+	defer clear(args)
+	record, err := authorityRead(marker, 1024)
+	if err != nil || validateInitialization(record, args) != nil || !privateStartupArguments(args) {
+		return no
+	}
+	// Only metadata is examined for fixed TLS/database directories; reading
+	// credential bytes is reserved for the real owning startup transition.
+	for _, name := range []string{"tls", "db"} {
+		h, e := openRelative(anchor, name, true, nil, false)
+		if e != nil {
+			return no
+		}
+		e = verifyPrivate(h, root.sid, true)
+		closeErr := windows.CloseHandle(h)
+		if e != nil || closeErr != nil {
+			return no
+		}
+	}
+	if ctx.Err() != nil {
+		return no
+	}
+	return preflightResult("initialized", true)
+}
