+func TestManagementRefreshCannotChangeAuthorityOrPolicyOwner(t *testing.T) {
+	before := managementconfig.ServiceGeneration{Schema: 1, Serving: managementconfig.ServingBinding{PID: 12, Creation: 34, Session: 1, Endpoint: "https://127.0.0.1:6443", Certificate: [32]byte{1}}, Image: [32]byte{2}, Config: managementconfig.ConfigVersion{Present: true, Volume: 3, High: 4, Low: 5, Hash: [32]byte{6}}}
+	if validateManagementRefresh(before, before, 1) != ErrManagement {
+		t.Fatal("unchanged generation admitted as refresh")
+	}
+	next := before
+	next.Serving.PID, next.Serving.Creation, next.Config.Low, next.Config.Hash = 56, 78, 9, [32]byte{10}
+	if validateManagementRefresh(before, next, 1) != nil {
+		t.Fatal("new public credential generation refused")
+	}
+	for _, mutate := range []func(*managementconfig.ServiceGeneration){func(g *managementconfig.ServiceGeneration) { g.Serving.Endpoint = "https://127.0.0.1:6444" }, func(g *managementconfig.ServiceGeneration) { g.Serving.Certificate = [32]byte{3} }, func(g *managementconfig.ServiceGeneration) { g.Serving.Session = 2 }, func(g *managementconfig.ServiceGeneration) { g.Image = [32]byte{4} }} {
+		bad := next
+		mutate(&bad)
+		if validateManagementRefresh(before, bad, 1) != ErrProxyOwner {
+			t.Fatal("credential refresh changed authority")
+		}
+	}
+}
