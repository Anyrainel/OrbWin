+)
+
+func TestProxyUnitPendingJobIsTypedButMalformedStateIsTerminal(t *testing.T) {
+	for _, state := range []string{"active", "activating", "deactivating"} {
+		if _, err := parseProxyUnit([]byte("MainPID=0\nInvocationID=\nJob=12\nActiveState=" + state + "\nSubState=start\n")); !errors.Is(err, protocol.ErrPending) {
+			t.Fatal("live systemd job lost typed pending")
+		}
+	}
+	for _, job := range []string{"012", "unknown", "-1"} {
+		if _, err := parseProxyUnit([]byte("MainPID=0\nInvocationID=\nJob=" + job + "\nActiveState=activating\nSubState=start\n")); !errors.Is(err, protocol.ErrUnavailable) {
+			t.Fatal("malformed state admitted as pending")
+		}
+	}
+	for _, raw := range []string{"MainPID=0\nUnexpected=\nJob=12\nActiveState=activating\nSubState=start\n", "MainPID=0\nInvocationID=\nJob=12\nActiveState=activating\nUnexpected=start\n"} {
+		if _, err := parseProxyUnit([]byte(raw)); !errors.Is(err, protocol.ErrUnavailable) {
+			t.Fatal("unexpected/missing pending-state key admitted")
+		}
+	}
+}
+
+func TestProxyOneShotPendingObservationDoesNotClaimIdentityOrReceipt(t *testing.T) {
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+	var output bytes.Buffer
+	done := make(chan error, 1)
+	go func() {
+		done <- runProxyTransaction(context.Background(), reader, &output, nil, func(context.Context) (proxyIdentityObservation, error) {
+			return proxyIdentityObservation{}, protocol.ErrPending
+		}, proxyTestImage)
+	}()
+	if protocol.WriteFrame(writer, proxyMessage{Schema: 1, Operation: "observe", HelperSHA256: strings.Repeat("b", 64)}) != nil {
+		t.Fatal("input")
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("pending response blocked")
+	}
+	var result proxyMessageResult
+	if protocol.ReadFrame(bufio.NewReader(&output), &result) != nil || result.Reason != "Pending" || result.Identity != nil || result.Receipt != nil {
+		t.Fatal("pending response invented a successful observation")
+	}
+}
diff --git a/rdd/src/rdd-guest/proxy_runtime.go b/rdd/src/rdd-guest/proxy_runtime.go
new file mode 100644
index 0000000..1a70ffd
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_runtime.go
@@ -0,0 +1,166 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"strconv"
+	"strings"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+)
+
+const proxyNoProxy = "localhost,127.0.0.1,::1,host.docker.internal,.orbwin.localhost,.orbwin.test"
+
+type proxyUnit struct {
+	PID        int
+	Invocation string
+	Quiescent  bool
+}
+
+func parseProxyUnit(data []byte) (proxyUnit, error) {
+	var result proxyUnit
+	if len(data) > 2048 {
+		return result, protocol.ErrUnavailable
+	}
+	values := map[string]string{}
+	for _, line := range strings.Split(strings.TrimSuffix(string(data), "\n"), "\n") {
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || len(key) > 64 || len(value) > 128 {
+			return result, protocol.ErrUnavailable
+		}
+		if _, duplicate := values[key]; duplicate {
+			return result, protocol.ErrUnavailable
+		}
+		values[key] = value
+	}
+	if len(values) != 5 {
+		return result, protocol.ErrUnavailable
+	}
+	for _, key := range []string{"MainPID", "InvocationID", "Job", "ActiveState", "SubState"} {
+		if _, present := values[key]; !present {
+			return result, protocol.ErrUnavailable
+		}
+	}
+	job, jobErr := strconv.ParseUint(values["Job"], 10, 32)
+	if jobErr == nil && job > 0 && strconv.FormatUint(job, 10) == values["Job"] && (values["ActiveState"] == "active" || values["ActiveState"] == "activating" || values["ActiveState"] == "deactivating") {
+		return result, protocol.ErrPending
+	}
+	if values["ActiveState"] != "active" || values["SubState"] != "running" || values["Job"] != "0" {
+		return result, protocol.ErrUnavailable
+	}
+	pid, err := strconv.Atoi(values["MainPID"])
+	if err != nil || pid < 1 || pid > 2147483647 || strconv.Itoa(pid) != values["MainPID"] || !proxyHex(values["InvocationID"], 32) {
+		return result, protocol.ErrUnavailable
+	}
+	result = proxyUnit{PID: pid, Invocation: values["InvocationID"], Quiescent: true}
+	return result, nil
+}
+func proxyHex(value string, length int) bool {
+	if len(value) != length {
+		return false
+	}
+	for _, r := range value {
+		if !(r >= '0' && r <= '9' || r >= 'a' && r <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+func proxyProcessStart(data []byte) (string, error) {
+	if len(data) > 8192 {
+		return "", protocol.ErrUnavailable
+	}
+	end := bytes.LastIndex(data, []byte(") "))
+	if end < 0 {
+		return "", protocol.ErrUnavailable
+	}
+	fields := strings.Fields(string(data[end+2:]))
+	if len(fields) < 20 {
+		return "", protocol.ErrUnavailable
+	}
+	value := fields[19]
+	ticks, err := strconv.ParseUint(value, 10, 64)
+	if err != nil || ticks == 0 || strconv.FormatUint(ticks, 10) != value {
+		return "", protocol.ErrUnavailable
+	}
+	return value, nil
+}
+func proxyEnv(data []byte) (string, error) {
+	if len(data) > 16384 {
+		return "", protocol.ErrUnavailable
+	}
+	keys := map[string]string{}
+	for _, entry := range bytes.Split(data, []byte{0}) {
+		if len(entry) == 0 {
+			continue
+		}
+		key, value, ok := strings.Cut(string(entry), "=")
+		if !ok {
+			return "", protocol.ErrUnavailable
+		}
+		switch key {
+		case "HTTP_PROXY", "http_proxy", "HTTPS_PROXY", "https_proxy", "NO_PROXY", "no_proxy", "ALL_PROXY", "all_proxy":
+			if _, duplicate := keys[key]; duplicate {
+				return "", protocol.ErrUnavailable
+			}
+			keys[key] = value
+		}
+	}
+	direct := true
+	for _, value := range keys {
+		if value != "" {
+			direct = false
+		}
+	}
+	if direct {
+		return "direct", nil
+	}
+	for _, key := range []string{"HTTP_PROXY", "http_proxy", "HTTPS_PROXY", "https_proxy"} {
+		if keys[key] != protocol.Endpoint {
+			return "", protocol.ErrUnavailable
+		}
+	}
+	if keys["NO_PROXY"] != proxyNoProxy || keys["no_proxy"] != proxyNoProxy || keys["ALL_PROXY"] != "" || keys["all_proxy"] != "" {
+		return "", protocol.ErrUnavailable
+	}
+	return protocol.Compatibility, nil
+}
+func proxyInfo(data []byte) (string, string, error) {
+	if len(data) > 262144 {
+		return "", "", protocol.ErrUnavailable
+	}
+	var values map[string]json.RawMessage
+	if json.Unmarshal(data, &values) != nil || len(values) > 256 {
+		return "", "", protocol.ErrUnavailable
+	}
+	read := func(key string) (string, bool) {
+		var value string
+		raw, ok := values[key]
+		if !ok || json.Unmarshal(raw, &value) != nil || len(value) > 4096 {
+			return "", false
+		}
+		return value, true
+	}
+	id, ok := read("ID")
+	if !ok || len(id) < 1 || len(id) > 128 {
+		return "", "", protocol.ErrUnavailable
+	}
+	for _, r := range id {
+		if r < 33 || r > 126 {
+			return "", "", protocol.ErrUnavailable
+		}
+	}
+	http, h1 := read("HttpProxy")
+	https, h2 := read("HttpsProxy")
+	noProxy, h3 := read("NoProxy")
+	if !h1 || !h2 || !h3 {
+		return "", "", protocol.ErrUnavailable
+	}
+	if http == "" && https == "" && noProxy == "" {
+		return id, "direct", nil
+	}
+	if http == protocol.Endpoint && https == protocol.Endpoint && noProxy == proxyNoProxy {
+		return id, protocol.Compatibility, nil
+	}
+	return "", "", protocol.ErrUnavailable
+}
diff --git a/rdd/src/rdd-guest/proxy_runtime_linux.go b/rdd/src/rdd-guest/proxy_runtime_linux.go
new file mode 100644
index 0000000..b98a8e5
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_runtime_linux.go
@@ -0,0 +1,296 @@
+//go:build linux
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"time"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+	"golang.org/x/sys/unix"
+)
+
+type proxyBoundedBuffer struct {
+	bytes.Buffer
+	limit int
+}
+
+func (b *proxyBoundedBuffer) Write(data []byte) (int, error) {
+	if b.Len()+len(data) > b.limit {
+		return 0, protocol.ErrUnavailable
+	}
+	return b.Buffer.Write(data)
+}
+func proxySystemctl(ctx context.Context, action string) ([]byte, error) {
+	var args []string
+	switch action {
+	case "observe":
+		args = []string{"show", "--no-pager", "--property=MainPID,InvocationID,Job,ActiveState,SubState", "docker.service"}
+	case "reload":
+		args = []string{"daemon-reload"}
+	case "restart":
+		args = []string{"restart", "--no-block", "docker.service"}
+	default:
+		return nil, protocol.ErrInvalid
+	}
+	cmd := exec.CommandContext(ctx, "/usr/bin/systemctl", args...)
+	cmd.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL=C"}
+	cmd.WaitDelay = 500 * time.Millisecond
+	output := &proxyBoundedBuffer{limit: 2048}
+	failure := &proxyBoundedBuffer{limit: 2048}
+	cmd.Stdout = output
+	cmd.Stderr = failure
+	if cmd.Run() != nil || ctx.Err() != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	return output.Bytes(), nil
+}
+func proxyReadSystem(path string, limit int) ([]byte, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, int64(limit+1)))
+	if err != nil || len(data) > limit {
+		return nil, protocol.ErrUnavailable
+	}
+	return data, nil
+}
+func proxyRuntime(ctx context.Context) (string, string, string, error) {
+	unitRaw, err := proxySystemctl(ctx, "observe")
+	if err != nil {
+		return "", "", "", err
+	}
+	unit, err := parseProxyUnit(unitRaw)
+	if err != nil {
+		return "", "", "", err
+	}
+	pidfd, err := unix.PidfdOpen(unit.PID, 0)
+	if err != nil {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	defer unix.Close(pidfd)
+	proc := "/proc/" + strconv.Itoa(unit.PID) + "/"
+	startRaw, err := proxyReadSystem(proc+"stat", 8192)
+	if err != nil {
+		return "", "", "", err
+	}
+	start, err := proxyProcessStart(startRaw)
+	if err != nil {
+		return "", "", "", err
+	}
+	cmdline, err := proxyReadSystem(proc+"cmdline", 16384)
+	if err != nil {
+		return "", "", "", err
+	}
+	args := bytes.Split(cmdline, []byte{0})
+	if len(args) < 2 || string(args[0]) != "/usr/bin/dockerd" {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	for _, arg := range args[1:] {
+		text := string(arg)
+		if strings.HasPrefix(text, "--http-proxy") || strings.HasPrefix(text, "--https-proxy") || strings.HasPrefix(text, "--no-proxy") || strings.HasPrefix(text, "--config-file") {
+			return "", "", "", protocol.ErrUnavailable
+		}
+	}
+	cgroup, err := proxyReadSystem(proc+"cgroup", 8192)
+	if err != nil || !bytes.Contains(cgroup, []byte("/system.slice/docker.service\n")) {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	environment, err := proxyReadSystem(proc+"environ", 16384)
+	if err != nil {
+		return "", "", "", err
+	}
+	runtimeMode, err := proxyEnv(environment)
+	for i := range environment {
+		environment[i] = 0
+	}
+	if err != nil {
+		return "", "", "", err
+	}
+	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(probe context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(probe, "unix", "/run/orbwin/moby-internal.sock")
+	}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 2 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://localhost/info", nil)
+	if err != nil {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		// The exact owned dockerd was live and validated before this local
+		// request. Re-observe it before reporting startup progress; malformed
+		// responses and changed ownership remain terminal refusals below.
+		afterRaw, observeErr := proxySystemctl(ctx, "observe")
+		after, parseErr := parseProxyUnit(afterRaw)
+		fds := []unix.PollFd{{Fd: int32(pidfd), Events: unix.POLLIN}}
+		n, pollErr := unix.Poll(fds, 0)
+		if ctx.Err() == nil && observeErr == nil && (parseErr == protocol.ErrPending || parseErr == nil && after == unit && pollErr == nil && n == 0) {
+			return "", "", "", protocol.ErrPending
+		}
+		return "", "", "", protocol.ErrUnavailable
+	}
+	defer response.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(response.Body, 262145))
+	if err != nil || response.StatusCode != 200 || len(data) > 262144 {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	daemonID, infoMode, err := proxyInfo(data)
+	for i := range data {
+		data[i] = 0
+	}
+	if err != nil || infoMode != runtimeMode {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	afterRaw, err := proxySystemctl(ctx, "observe")
+	if err != nil {
+		return "", "", "", err
+	}
+	after, err := parseProxyUnit(afterRaw)
+	if err == protocol.ErrPending {
+		return "", "", "", protocol.ErrPending
+	}
+	if err != nil || after != unit {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	afterStart, err := proxyReadSystem(proc+"stat", 8192)
+	if err != nil {
+		return "", "", "", err
+	}
+	sameStart, err := proxyProcessStart(afterStart)
+	if err != nil || sameStart != start {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	fds := []unix.PollFd{{Fd: int32(pidfd), Events: unix.POLLIN}}
+	n, err := unix.Poll(fds, 0)
+	if err != nil || n != 0 || ctx.Err() != nil {
+		return "", "", "", protocol.ErrUnavailable
+	}
+	return daemonID, runtimeMode, unit.Invocation + ":" + start, nil
+}
+func proxyMachineID() (string, error) {
+	root, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return "", protocol.ErrUnavailable
+	}
+	defer unix.Close(root)
+	if proxyStat(root, true, false, 0) != nil {
+		return "", protocol.ErrUnavailable
+	}
+	return proxyMachineIDAt(root, 0)
+}
+func proxyMachineIDAt(root int, ownerUID uint32) (string, error) {
+	data, err := proxyReadRelative(root, []string{"etc", "machine-id"}, ownerUID, 64)
+	if err != nil {
+		return "", err
+	}
+	value := strings.TrimSuffix(string(data), "\n")
+	if !proxyHex(value, 32) || value == strings.Repeat("0", 32) {
+		return "", protocol.ErrUnavailable
+	}
+	return value, nil
+}
+func proxyObserveIdentity(ctx context.Context) (proxyIdentityObservation, error) {
+	if unix.Geteuid() != 0 {
+		return proxyIdentityObservation{}, protocol.ErrUnavailable
+	}
+	machine, err := proxyMachineID()
+	if err != nil {
+		return proxyIdentityObservation{}, err
+	}
+	daemon, _, _, err := proxyRuntime(ctx)
+	if err != nil {
+		return proxyIdentityObservation{}, err
+	}
+	return proxyIdentityObservation{MachineID: machine, DaemonID: daemon}, nil
+}
+func (l *proxyNativeLease) Observe(ctx context.Context) (protocol.Observation, error) {
+	var current protocol.Observation
+	if !l.usable() || ctx == nil || ctx.Err() != nil {
+		return current, protocol.ErrUnavailable
+	}
+	machine, err := proxyMachineIDAt(l.root, l.ownerUID)
+	if err != nil {
+		return current, err
+	}
+	daemon, runtimeMode, _, err := l.runtime(ctx)
+	if err != nil {
+		return current, err
+	}
+	current = protocol.Observation{MachineID: machine, DaemonID: daemon, Runtime: runtimeMode, Quiescent: true, FileHash: protocol.Hash(nil)}
+	journal, journalErr := l.Load(ctx)
+	if journalErr != nil {
+		return current, protocol.ErrUnavailable
+	}
+	if journal != nil && journal.Stage == "restart-admitted" {
+		// Job=0 cannot exclude an unobserved surviving systemctl sender from a
+		// prior helper. Only durable restart-retired proves fixed actions reaped.
+		current.Quiescent = false
+	}
+	if err := l.refreshConfig(false); err != nil {
+		return current, err
+	}
+	var data []byte
+	var stat *unix.Stat_t
+	err = unix.ENOENT
+	if l.config >= 0 {
+		data, stat, err = proxyReadAt(l.config, "90-orbwin-network-proxy.conf", true, 8192, l.ownerUID)
+	}
+	if err == nil {
+		if !bytes.Equal(data, protocol.CompatibilityBody()) {
+			return current, protocol.ErrUnavailable
+		}
+		current.FilePresent = true
+		current.FileOwned = true
+		current.FileHash = protocol.Hash(data)
+		current.Device = uint64(stat.Dev)
+		current.Inode = stat.Ino
+	} else if err != unix.ENOENT {
+		return current, protocol.ErrUnavailable
+	}
+	// Fixed upstream policy file: never chain around or bypass allowed-images.
+	for _, path := range []string{"/usr/local/openresty/nginx/conf/allowed-images.conf", "/etc/sysconfig/allowed-images.env"} {
+		if _, err := proxyReadRelative(l.root, strings.Split(strings.TrimPrefix(path, "/"), "/"), l.ownerUID, 65536); err == nil {
+			current.AllowedImages = true
+		} else if err != unix.ENOENT {
+			return current, protocol.ErrUnavailable
+		}
+	}
+	// daemon.json wins over environment. Never rewrite a foreign daemon config.
+	if config, err := proxyReadRelative(l.root, []string{"etc", "docker", "daemon.json"}, l.ownerUID, 65536); err == nil {
+		var values map[string]json.RawMessage
+		if json.Unmarshal(config, &values) != nil {
+			return current, protocol.ErrUnavailable
+		}
+		if raw, exists := values["proxies"]; exists && string(raw) != "null" && string(raw) != "{}" {
+			current.Foreign = true
+		}
+	} else if err != unix.ENOENT {
+		return current, protocol.ErrUnavailable
+	}
+	return current, nil
+}
+func (l *proxyNativeLease) Restart(ctx context.Context) error {
+	if !l.usable() || ctx == nil || ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	if _, err := l.actions(ctx, "reload"); err != nil {
+		return err
+	}
+	if ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	_, err := l.actions(ctx, "restart")
+	return err
+}
diff --git a/rdd/src/rdd-guest/proxy_transaction.go b/rdd/src/rdd-guest/proxy_transaction.go
new file mode 100644
index 0000000..ef324f6
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_transaction.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"time"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+)
+
+type proxyIdentityObservation = protocol.IdentityObservation
+type proxyMessage = protocol.Message
+type proxyMessageResult = protocol.MessageResult
+
+// One fixed operation per existing helper process. Input remains open after its
+// one LF frame: later EOF/additional input cancels owned work. Process final exit
+// reclaims the one blocked stdin monitor. Native syscalls remain non-preemptible.
+func runProxyTransaction(parent context.Context, input io.Reader, output io.Writer, backend protocol.Backend, observe func(context.Context) (proxyIdentityObservation, error), image func(context.Context) (string, error)) error {
+	ctx, cancel := context.WithTimeout(parent, 4*time.Second)
+	defer cancel()
+	reader := bufio.NewReaderSize(input, protocol.MaxFrame+1)
+	var message proxyMessage
+	decoded := make(chan error, 1)
+	go func() { decoded <- protocol.ReadFrame(reader, &message) }()
+	select {
+	case <-ctx.Done():
+		return protocol.ErrUnavailable
+	case err := <-decoded:
+		if err != nil {
+			return protocol.ErrInvalid
+		}
+	}
+	if reader.Buffered() != 0 || message.Schema != 1 {
+		return protocol.ErrInvalid
+	}
+	if message.Operation != "observe" && message.Operation != "apply" || message.Operation == "observe" && message.Request != nil || message.Operation == "apply" && (message.Request == nil || message.Request.Validate() != nil) {
+		return protocol.ErrInvalid
+	}
+	go func() { _, _ = reader.ReadByte(); cancel() }()
+	// Check the actual executing image on every invocation before any guest
+	// observation/transaction. Older helpers reject this new closed field; a
+	// replaced helper cannot acknowledge a prepared plan using an earlier probe.
+	if image == nil {
+		return protocol.ErrUnavailable
+	}
+	digest, err := image(ctx)
+	if err != nil || len(digest) != 64 || message.HelperSHA256 != digest || ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	result := proxyMessageResult{Schema: 1, Reason: "Unavailable"}
+	if message.Operation == "observe" {
+		if observe == nil {
+			return protocol.ErrUnavailable
+		}
+		identity, err := observe(ctx)
+		identity.HelperSHA256 = digest
+		if errors.Is(err, protocol.ErrPending) && ctx.Err() == nil {
+			result.Reason = "Pending"
+		}
+		if err == nil && ctx.Err() == nil && identity.Valid() {
+			result.Reason = "Ready"
+			result.Identity = &identity
+		}
+	} else {
+		receipt, err := protocol.ApplyOrObserve(ctx, backend, *message.Request)
+		if errors.Is(err, protocol.ErrPending) && ctx.Err() == nil {
+			result.Reason = "Pending"
+		}
+		if err == nil && ctx.Err() == nil && protocol.GuardReceipt(*message.Request, receipt) == nil {
+			result.Reason = "Ready"
+			result.Receipt = &receipt
+		}
+	}
+	// Failure output contains no native error, path, captured env, URL or token.
+	if ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	written := make(chan error, 1)
+	go func() { written <- protocol.WriteFrame(output, result) }()
+	select {
+	case <-ctx.Done():
+		return protocol.ErrUnavailable
+	case err := <-written:
+		return err
+	}
+}
