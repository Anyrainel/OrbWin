--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_files_linux_test.go
@@ -0,0 +1,318 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+	"golang.org/x/sys/unix"
+)
+
+// Compile-only until the parent approves the exact binary and fresh-/tmp recipe.
+// All native paths resolve under this test-owned FD. Runtime/actions are mandatory
+// inert injections; no real machine ID, systemctl, /proc or Docker socket read.
+type proxyNativeFSFixture struct {
+	root                          string
+	mode                          string
+	reload, restart, runtimeCalls int
+}
+
+func (f *proxyNativeFSFixture) Acquire(ctx context.Context) (protocol.Lease, error) {
+	root, err := unix.Open(f.root, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	return proxyAcquireAt(ctx, root, uint32(unix.Geteuid()), func(context.Context) (string, string, string, error) {
+		f.runtimeCalls++
+		return "owned", f.mode, "fixture-runtime-identity", nil
+	}, func(_ context.Context, action string) ([]byte, error) {
+		switch action {
+		case "reload":
+			f.reload++
+		case "restart":
+			f.restart++
+			f.mode = protocol.Compatibility
+		default:
+			return nil, protocol.ErrInvalid
+		}
+		return nil, nil
+	})
+}
+func freshProxyNativeFS(t *testing.T) *proxyNativeFSFixture {
+	t.Helper()
+	if os.Getenv("ORBWIN_PROXY_NATIVE_FS_FIXTURE") != "1" {
+		t.Skip("explicit reviewed native filesystem qualification opt-in required")
+	}
+	if os.Getenv("ORBWIN_PROXY_NATIVE_FS_UID") != "1000" || unix.Geteuid() != 1000 || strconv.Itoa(unix.Getuid()) != "1000" {
+		t.Fatal("qualification requires reviewed ordinary UID 1000")
+	}
+	root, err := os.MkdirTemp("", "orbwin-proxy-native-fs-")
+	if err != nil {
+		t.Fatal("fresh root creation")
+	}
+	fixture := &proxyNativeFSFixture{root: root, mode: "direct"}
+	// No recursive cleanup, ACL repair, global path or opaque fixture walk.
+	// Remove known leaves/links first, then only known empty directories.
+	t.Cleanup(func() {
+		configDir := filepath.Join(root, "etc/systemd/system/docker.service.d")
+		if info, err := os.Lstat(configDir); err == nil && info.Mode()&os.ModeSymlink != 0 {
+			if os.Remove(configDir) != nil {
+				t.Error("known symlink cleanup failed")
+			}
+		} else {
+			if err := os.Remove(filepath.Join(configDir, "90-orbwin-network-proxy.conf")); err != nil && !os.IsNotExist(err) {
+				t.Error("known config cleanup failed")
+			}
+		}
+		for _, rel := range []string{"config-copy", "etc/machine-id", "var/lib/orbwin/network-proxy/state.json", "var/lib/orbwin/network-proxy/writer.lock"} {
+			if err := os.Remove(filepath.Join(root, rel)); err != nil && !os.IsNotExist(err) {
+				t.Error("known fixture leaf cleanup failed")
+			}
+		}
+		for _, rel := range []string{"etc/systemd/system/docker.service.d", "etc/systemd/system", "etc/systemd", "etc", "var/lib/orbwin/network-proxy", "var/lib/orbwin", "var/lib", "var", "outside", ""} {
+			path := filepath.Join(root, rel)
+			if !strings.HasPrefix(path, root+string(os.PathSeparator)) && path != root {
+				t.Error("fixture cleanup scope refused")
+				return
+			}
+			if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+				t.Error("known empty fixture directory retained")
+			}
+		}
+	})
+	for _, rel := range []string{"etc", "etc/systemd", "etc/systemd/system", "var", "var/lib"} {
+		if os.Mkdir(filepath.Join(root, rel), 0700) != nil {
+			t.Fatal("fixed fixture directory creation")
+		}
+	}
+	if os.WriteFile(filepath.Join(root, "etc/machine-id"), []byte(strings.Repeat("a", 32)+"\n"), 0600) != nil {
+		t.Fatal("fixture identity write")
+	}
+	return fixture
+}
+func nativeFSRequest(mode string) protocol.Request {
+	r := proxyFixtureRequest()
+	r.Mode = mode
+	if mode == "url" {
+		r.Owner.Phase = "prepare"
+	}
+	r.ID = r.TransactionID()
+	return r
+}
+
+func TestProxyNativeFSAbsentNoneAndUnadmittedInstallNeverCreateDropInDirectory(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	lease, err := f.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("native fresh lease unavailable")
+	}
+	observation, err := lease.Observe(context.Background())
+	if err != nil {
+		t.Fatal("native fresh observation unavailable")
+	}
+	if lease.Install(context.Background(), observation) == nil {
+		t.Fatal("unadmitted install succeeded")
+	}
+	if err := lease.Close(); err != nil {
+		t.Fatal("lease retirement")
+	}
+	r := nativeFSRequest("none")
+	receipt, err := protocol.ApplyOrObserve(context.Background(), f, r)
+	if err != nil || protocol.GuardReceipt(r, receipt) != nil || receipt.Disposition != protocol.AbsentDirect || f.reload != 0 || f.restart != 0 {
+		t.Fatal("current absent/direct None proof failed")
+	}
+	if _, err := os.Lstat(filepath.Join(f.root, "etc/systemd/system/docker.service.d")); !os.IsNotExist(err) {
+		t.Fatal("None/unadmitted operation created drop-in directory")
+	}
+}
+func TestProxyNativeFSDurableInstallJournalAndSameOperationRecovery(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	r := nativeFSRequest("url")
+	receipt, err := protocol.ApplyOrObserve(context.Background(), f, r)
+	if err != nil || protocol.GuardReceipt(r, receipt) != nil || f.reload != 1 || f.restart != 1 {
+		t.Fatal("native durable installation failed")
+	}
+	data, err := os.ReadFile(filepath.Join(f.root, "etc/systemd/system/docker.service.d/90-orbwin-network-proxy.conf"))
+	if err != nil || !bytesEqual(data, protocol.CompatibilityBody()) {
+		t.Fatal("fixed staged content changed")
+	}
+	if _, err := protocol.ApplyOrObserve(context.Background(), f, r); err != nil || f.restart != 1 {
+		t.Fatal("same-operation recovery replayed restart")
+	}
+	none := nativeFSRequest("none")
+	none.Owner.Revision = 2
+	none.ID = none.TransactionID()
+	receipt, err = protocol.ApplyOrObserve(context.Background(), f, none)
+	if err != nil || receipt.Disposition != protocol.Compatibility || f.reload != 1 || f.restart != 1 {
+		t.Fatal("managed None changed fixed content or replayed restart")
+	}
+	lease, err := f.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("receipt lease")
+	}
+	defer lease.Close()
+	journal, err := lease.Load(context.Background())
+	if err != nil || journal.Stage != "settled" || journal.Request.ID != none.ID || journal.Receipt != receipt {
+		t.Fatal("durable journal/receipt failed re-observation")
+	}
+}
+func bytesEqual(a, b []byte) bool { return string(a) == string(b) }
+
+func TestProxyNativeFSExclusiveLockAndSymlinkRefusal(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	held, err := f.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("first native writer lease")
+	}
+	_, second := f.Acquire(context.Background())
+	if second == nil {
+		held.Close()
+		t.Fatal("competing writer acquired same lock")
+	}
+	if held.Close() != nil {
+		t.Fatal("first writer retirement")
+	}
+	if os.Mkdir(filepath.Join(f.root, "outside"), 0700) != nil || os.Symlink(filepath.Join(f.root, "outside"), filepath.Join(f.root, "etc/systemd/system/docker.service.d")) != nil {
+		t.Fatal("fresh symlink fixture")
+	}
+	if _, err := f.Acquire(context.Background()); err == nil {
+		t.Fatal("native symlink final directory followed")
+	}
+}
+func TestProxyNativeFSHardlinkAndForeignContentArePreserved(t *testing.T) {
+	for _, kind := range []string{"hardlink", "foreign"} {
+		t.Run(kind, func(t *testing.T) {
+			f := freshProxyNativeFS(t)
+			r := nativeFSRequest("url")
+			if _, err := protocol.ApplyOrObserve(context.Background(), f, r); err != nil {
+				t.Fatal("initial installation")
+			}
+			path := filepath.Join(f.root, "etc/systemd/system/docker.service.d/90-orbwin-network-proxy.conf")
+			if kind == "hardlink" {
+				if os.Link(path, filepath.Join(f.root, "config-copy")) != nil {
+					t.Fatal("fresh hardlink fixture")
+				}
+			} else {
+				if os.WriteFile(path, []byte("foreign fixture bytes"), 0600) != nil {
+					t.Fatal("fresh foreign fixture write")
+				}
+			}
+			before, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal("fixture snapshot")
+			}
+			if _, err := protocol.ApplyOrObserve(context.Background(), f, r); err == nil {
+				t.Fatal("foreign/link drift adopted")
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || !bytesEqual(before, after) || f.restart != 1 {
+				t.Fatal("refusal changed data or restarted")
+			}
+		})
+	}
+}
+func TestProxyNativeFSCancelledAcquireCreatesNothing(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := f.Acquire(ctx); err == nil {
+		t.Fatal("cancelled native lease acquired")
+	}
+	if _, err := os.Stat(filepath.Join(f.root, "var/lib/orbwin")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("cancelled acquire mutated anchor")
+	}
+	if f.runtimeCalls != 0 || f.restart != 0 || f.reload != 0 {
+		t.Fatal("cancelled fixture called runtime/actions")
+	}
+}
+
+func TestProxyNativeFSAdmittedWithoutRetirementNeverClaimsQuiescence(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	lease, err := f.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("native fixture lease")
+	}
+	before, err := lease.Observe(context.Background())
+	if err != nil {
+		t.Fatal("native fixture observation")
+	}
+	old := nativeFSRequest("url")
+	if lease.Persist(context.Background(), protocol.Journal{Schema: 1, Request: old, Stage: "restart-admitted", Before: before}) != nil {
+		t.Fatal("admitted fixture intent")
+	}
+	if lease.Close() != nil {
+		t.Fatal("native fixture retirement")
+	}
+	none := nativeFSRequest("none")
+	receipt, err := protocol.ApplyOrObserve(context.Background(), f, none)
+	if err == nil || receipt.Disposition != protocol.Unknown || f.reload != 0 || f.restart != 0 {
+		t.Fatal("unknown action sender inferred retired from current direct runtime")
+	}
+	if _, err := os.Lstat(filepath.Join(f.root, "etc/systemd/system/docker.service.d")); !os.IsNotExist(err) {
+		t.Fatal("unknown prior sender installed environment to disable")
+	}
+}
+
+func TestProxyNativeFSClosedLeaseCannotUseRecycledDescriptors(t *testing.T) {
+	f := freshProxyNativeFS(t)
+	oldInterface, err := f.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("old native lease")
+	}
+	old := oldInterface.(*proxyNativeLease)
+	savedRoot, savedAnchor := old.root, old.anchor
+	if old.Close() != nil {
+		t.Fatal("old native retirement")
+	}
+	if old.root != -1 || old.anchor != -1 || old.configParent != -1 || old.config != -1 || old.lock != -1 || len(old.dirs) != 0 {
+		t.Fatal("closed native descriptors retained")
+	}
+	other := freshProxyNativeFS(t)
+	currentInterface, err := other.Acquire(context.Background())
+	if err != nil {
+		t.Fatal("replacement native lease")
+	}
+	current := currentInterface.(*proxyNativeLease)
+	defer current.Close()
+	if current.root != savedRoot || current.anchor != savedAnchor {
+		t.Fatal("native descriptor reuse fixture not established")
+	}
+	before, err := current.Observe(context.Background())
+	if err != nil {
+		t.Fatal("replacement native observation")
+	}
+	request := nativeFSRequest("url")
+	journal := protocol.Journal{Schema: 1, Request: request, Stage: "write-admitted", Before: before}
+	if current.Persist(context.Background(), journal) != nil {
+		t.Fatal("replacement native journal")
+	}
+	if _, err := old.Observe(context.Background()); err == nil {
+		t.Fatal("closed lease observed recycled root")
+	}
+	if _, err := old.Load(context.Background()); err == nil {
+		t.Fatal("closed lease read recycled anchor")
+	}
+	if old.Persist(context.Background(), journal) == nil || old.Install(context.Background(), before) == nil || old.Restart(context.Background()) == nil || old.refreshConfig(true) == nil {
+		t.Fatal("closed lease mutated recycled descriptors")
+	}
+	if old.Close() != nil {
+		t.Fatal("idempotent close failed")
+	}
+	loaded, err := current.Load(context.Background())
+	if err != nil || loaded.Request.ID != request.ID {
+		t.Fatal("old close/write changed replacement lease")
+	}
+	if _, err := os.Lstat(filepath.Join(other.root, "etc/systemd/system/docker.service.d")); !os.IsNotExist(err) {
+		t.Fatal("closed lease created replacement config directory")
+	}
+	if other.reload != 0 || other.restart != 0 {
+		t.Fatal("closed lease invoked replacement actions")
+	}
+}
