diff --git a/rdd/pkg/networkproxy/native_auto_windows.go b/rdd/pkg/networkproxy/native_auto_windows.go
new file mode 100644
index 0000000..1003e8b
--- /dev/null
+++ b/rdd/pkg/networkproxy/native_auto_windows.go
@@ -0,0 +1,515 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unicode/utf16"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var autoDLL = windows.NewLazySystemDLL("winhttp.dll")
+var autoOpen = autoDLL.NewProc("WinHttpOpen")
+var autoGetConfig = autoDLL.NewProc("WinHttpGetIEProxyConfigForCurrentUser")
+var autoSetCallback = autoDLL.NewProc("WinHttpSetStatusCallback")
+var autoCreate = autoDLL.NewProc("WinHttpCreateProxyResolver")
+var autoSetOption = autoDLL.NewProc("WinHttpSetOption")
+var autoGet = autoDLL.NewProc("WinHttpGetProxyForUrlEx")
+var autoResult = autoDLL.NewProc("WinHttpGetProxyResult")
+var autoFreeResult = autoDLL.NewProc("WinHttpFreeProxyResult")
+var autoClose = autoDLL.NewProc("WinHttpCloseHandle")
+var autoGlobalFree = windows.NewLazySystemDLL("kernel32.dll").NewProc("GlobalFree")
+
+const statusError = 0x00200000
+const statusComplete = 0x01000000
+const statusClosing = 0x00000800
+
+type autoOptions struct {
+	flags, detect            uint32
+	pac                      *uint16
+	reserved                 uintptr
+	reservedDWORD, autoLogon uint32
+}
+type ieConfig struct {
+	detect             uint32
+	pac, proxy, bypass *uint16
+}
+type proxyEntry struct {
+	proxy, bypass, scheme uint32
+	host                  *uint16
+	port                  uint16
+}
+type proxyResult struct {
+	count   uint32
+	entries *proxyEntry
+}
+type asyncResult struct {
+	result uintptr
+	code   uint32
+}
+type autoNotification struct{ status, code uint32 }
+
+// NativeError contains only a fixed operation name and numeric status, never
+// native strings, endpoints, URLs, PAC bodies, bypass values or credentials.
+type NativeError struct {
+	Operation string
+	Code      uint32
+}
+
+func (err NativeError) Error() string {
+	return fmt.Sprintf("native automatic proxy %s failed (code %d)", err.Operation, err.Code)
+}
+func nativeFailure(operation string, err error) error {
+	code := uint32(0)
+	var status windows.Errno
+	if errors.As(err, &status) {
+		code = uint32(status)
+	}
+	return NativeError{operation, code}
+}
+
+// NativeAutoResolver runs only inside the bounded worker. Construction checks exports only; Capture
+// is explicit and reads configuration; only Resolve can fetch/evaluate PAC/WPAD.
+// OwnerSID must come from the native registered owner, never renderer JSON.
+type NativeAutoResolver struct {
+	mu               sync.Mutex
+	owner            string
+	config           ownerConfiguration
+	captured, closed bool
+	active           int
+	drained          chan struct{}
+	stopCtx          context.Context
+	cancel           context.CancelFunc
+}
+
+func NewNativeAutoResolver(ownerSID string) (*NativeAutoResolver, error) {
+	sid, err := windows.StringToSid(ownerSID)
+	if err != nil || sid.String() != ownerSID || !(strings.HasPrefix(ownerSID, "S-1-5-21-") || strings.HasPrefix(ownerSID, "S-1-12-1-")) {
+		return nil, errors.New("native registered interactive owner SID required")
+	}
+	for _, proc := range []*windows.LazyProc{autoOpen, autoGetConfig, autoSetCallback, autoCreate, autoSetOption, autoGet, autoResult, autoFreeResult, autoClose, autoGlobalFree} {
+		if proc.Find() != nil {
+			return nil, errors.New("required Windows automatic proxy API is unavailable")
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	return &NativeAutoResolver{owner: ownerSID, drained: make(chan struct{}), stopCtx: ctx, cancel: cancel}, nil
+}
+
+// Must run while locked to an OS thread. Any impersonation token is refused;
+// even an equal SID may have different profile/logon/network credentials.
+func checkNativeOwner(owner string) error {
+	var thread windows.Token
+	err := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, &thread)
+	if err == nil {
+		thread.Close()
+		return errors.New("automatic proxy refuses an impersonating thread")
+	}
+	if err != windows.ERROR_NO_TOKEN {
+		return errors.New("native owner thread identity is unavailable")
+	}
+	token, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		return errors.New("native owner process token is unavailable")
+	}
+	defer token.Close()
+	user, err := token.GetTokenUser()
+	if err != nil || user.User.Sid.String() != owner {
+		return errors.New("native automatic proxy owner identity changed")
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 {
+		return errors.New("automatic proxy requires the interactive owner session")
+	}
+	return nil
+}
+
+func boundedNativeString(pointer *uint16, limit int) (string, error) {
+	if pointer == nil {
+		return "", nil
+	}
+	units := make([]uint16, 0, limit)
+	for index := 0; index <= limit; index++ {
+		unit := *(*uint16)(unsafe.Add(unsafe.Pointer(pointer), uintptr(index)*2))
+		if unit == 0 {
+			for i := 0; i < len(units); i++ {
+				if units[i] >= 0xd800 && units[i] <= 0xdbff {
+					if i+1 >= len(units) || units[i+1] < 0xdc00 || units[i+1] > 0xdfff {
+						return "", errors.New("native proxy string contains malformed UTF-16")
+					}
+					i++
+				} else if units[i] >= 0xdc00 && units[i] <= 0xdfff {
+					return "", errors.New("native proxy string contains malformed UTF-16")
+				}
+			}
+			return string(utf16.Decode(units)), nil
+		}
+		if index == limit {
+			break
+		}
+		units = append(units, unit)
+	}
+	return "", errors.New("native proxy string exceeds bounded length")
+}
+
+func (resolver *NativeAutoResolver) Capture(ctx context.Context) error {
+	resolver.mu.Lock()
+	defer resolver.mu.Unlock()
+	if resolver.closed || resolver.captured {
+		return errors.New("automatic proxy owner capture is closed or already completed")
+	}
+	if ctx.Err() != nil {
+		return errors.New("automatic proxy owner capture canceled")
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if err := checkNativeOwner(resolver.owner); err != nil {
+		return err
+	}
+	var native ieConfig
+	status, _, callErr := autoGetConfig.Call(uintptr(unsafe.Pointer(&native)))
+	defer func() {
+		for _, pointer := range []*uint16{native.pac, native.proxy, native.bypass} {
+			if pointer != nil {
+				autoGlobalFree.Call(uintptr(unsafe.Pointer(pointer)))
+			}
+		}
+	}()
+	if status == 0 {
+		return nativeFailure("configuration-read", callErr)
+	}
+	if native.detect > 1 {
+		return errors.New("native automatic detection flag is malformed")
+	}
+	config := ownerConfiguration{auto: native.detect != 0}
+	var err error
+	if config.pac, err = boundedNativeString(native.pac, 2048); err != nil {
+		return err
+	}
+	if config.manual, err = boundedNativeString(native.proxy, 8192); err != nil {
+		return err
+	}
+	if config.bypass, err = boundedNativeString(native.bypass, 8192); err != nil {
+		return err
+	}
+	if err := config.validate(); err != nil {
+		return err
+	}
+	if !config.auto && config.pac == "" {
+		for _, scheme := range []string{"http", "https"} {
+			if _, err := config.staticRoutes(&url.URL{Scheme: scheme, Host: "validation.invalid"}); err != nil {
+				return err
+			}
+		}
+	}
+	if ctx.Err() != nil {
+		return errors.New("automatic proxy owner capture canceled")
+	}
+	resolver.config = config
+	resolver.captured = true
+	return nil
+}
+
+func (resolver *NativeAutoResolver) release() {
+	resolver.mu.Lock()
+	defer resolver.mu.Unlock()
+	resolver.active--
+	if resolver.closed && resolver.active == 0 {
+		close(resolver.drained)
+	}
+}
+func (resolver *NativeAutoResolver) Close(ctx context.Context) error {
+	resolver.mu.Lock()
+	if !resolver.closed {
+		resolver.closed = true
+		resolver.config = ownerConfiguration{}
+		resolver.cancel()
+		if resolver.active == 0 {
+			close(resolver.drained)
+		}
+	}
+	drained := resolver.drained
+	empty := resolver.active == 0
+	resolver.mu.Unlock()
+	if empty {
+		return nil
+	}
+	select {
+	case <-drained:
+		return nil
+	case <-ctx.Done():
+		return errors.New("native automatic proxy handle retirement remains unconfirmed")
+	}
+}
+
+func (resolver *NativeAutoResolver) Resolve(ctx context.Context, target *url.URL) ([]Route, error) {
+	if err := validateTarget(target); err != nil {
+		return nil, err
+	}
+	if len(target.String()) > 8192 {
+		return nil, errors.New("automatic proxy destination exceeds URL budget")
+	}
+	resolver.mu.Lock()
+	if resolver.closed || !resolver.captured {
+		resolver.mu.Unlock()
+		return nil, errors.New("native automatic proxy requires an explicit completed owner capture")
+	}
+	config := resolver.config
+	resolver.active++
+	resolver.mu.Unlock()
+	limited, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	stop := context.AfterFunc(resolver.stopCtx, cancel)
+	defer stop()
+	if limited.Err() != nil {
+		resolver.release()
+		return nil, errors.New("automatic proxy decision canceled")
+	}
+	runtime.LockOSThread()
+	if err := checkNativeOwner(resolver.owner); err != nil {
+		runtime.UnlockOSThread()
+		resolver.release()
+		return nil, err
+	}
+	if !config.auto && config.pac == "" {
+		runtime.UnlockOSThread()
+		defer resolver.release()
+		return config.staticRoutes(target)
+	}
+	// resolvePAC unlocks the initial owner thread after starting the native
+	// request. Its pending token owns the active slot until HANDLE_CLOSING.
+	return resolver.resolvePAC(limited, config, target)
+}
+
+type pendingAuto struct {
+	owner                         *NativeAutoResolver
+	options                       autoOptions
+	url, pac                      []uint16
+	pins                          runtime.Pinner
+	done                          chan autoNotification
+	closed                        chan struct{}
+	once                          sync.Once
+	handle                        atomic.Uintptr
+	session                       atomic.Uintptr
+	cleanupMu                     sync.Mutex
+	resolverFinal, sessionFinal   bool
+	resolverClosed, sessionClosed bool
+	cleanupDone                   bool
+}
+
+var nextAutoToken atomic.Uint64
+var pendingAutos = struct {
+	sync.Mutex
+	values map[uintptr]*pendingAuto
+}{values: map[uintptr]*pendingAuto{}}
+var automaticCallback = windows.NewCallback(autoStatus)
+
+func retireAuto(token uintptr, pending *pendingAuto) {
+	// A final resolver callback alone is insufficient: the session may still
+	// own native work, and the Go cleanup may still be inside CloseHandle.
+	pending.cleanupMu.Lock()
+	ready := pending.cleanupDone && pending.resolverClosed && pending.sessionClosed && pending.resolverFinal && pending.sessionFinal
+	pending.cleanupMu.Unlock()
+	if !ready {
+		return
+	}
+	pending.once.Do(func() {
+		pendingAutos.Lock()
+		delete(pendingAutos.values, token)
+		pendingAutos.Unlock()
+		pending.pins.Unpin()
+		pending.owner.release()
+		close(pending.closed)
+	})
+}
+func autoStatus(handle uintptr, token uintptr, status uint32, information unsafe.Pointer, length uint32) uintptr {
+	pendingAutos.Lock()
+	pending := pendingAutos.values[token]
+	pendingAutos.Unlock()
+	if pending == nil || (pending.handle.Load() != handle && pending.session.Load() != handle) {
+		return 0
+	}
+	if status == statusClosing {
+		pending.cleanupMu.Lock()
+		if pending.handle.Load() == handle {
+			pending.resolverFinal = true
+		}
+		if pending.session.Load() == handle {
+			pending.sessionFinal = true
+		}
+		pending.cleanupMu.Unlock()
+		retireAuto(token, pending)
+		return 0
+	}
+	if pending.handle.Load() != handle {
+		return 0
+	}
+	if status != statusComplete && status != statusError {
+		return 0
+	}
+	notice := autoNotification{status: status}
+	if status == statusError {
+		if information == nil || uintptr(length) != unsafe.Sizeof(asyncResult{}) {
+			notice.code = uint32(windows.ERROR_INVALID_DATA)
+		} else {
+			notice.code = (*asyncResult)(information).code
+		}
+	}
+	select {
+	case pending.done <- notice:
+	default:
+	}
+	return 0
+}
+
+func (resolver *NativeAutoResolver) resolvePAC(ctx context.Context, config ownerConfiguration, target *url.URL) (routes []Route, resultErr error) {
+	// Entered with this goroutine's OS thread locked by Resolve.
+	locked := true
+	defer func() {
+		if locked {
+			runtime.UnlockOSThread()
+		}
+	}()
+	pending := &pendingAuto{owner: resolver, done: make(chan autoNotification, 1), closed: make(chan struct{})}
+	var err error
+	pending.url, err = windows.UTF16FromString(target.String())
+	if err != nil {
+		resolver.release()
+		return nil, errors.New("automatic proxy destination encoding is invalid")
+	}
+	if config.pac != "" {
+		pending.pac, _ = windows.UTF16FromString(config.pac)
+		pending.options.flags |= 2
+		pending.options.pac = &pending.pac[0]
+		pending.pins.Pin(&pending.pac[0])
+	}
+	if config.auto {
+		pending.options.flags |= 1
+		pending.options.detect = 3
+	}
+	// autoLogon remains zero: never retry TRUE after an authentication failure.
+	pending.pins.Pin(&pending.url[0])
+	pending.pins.Pin(&pending.options)
+	value := nextAutoToken.Add(1)
+	token := uintptr(value)
+	pendingAutos.Lock()
+	if len(pendingAutos.values) >= 8 || token == 0 || uint64(token) != value {
+		pendingAutos.Unlock()
+		pending.pins.Unpin()
+		resolver.release()
+		return nil, errors.New("native automatic proxy outstanding-operation budget exhausted")
+	}
+	pendingAutos.values[token] = pending
+	pendingAutos.Unlock()
+	var session, handle uintptr
+	var sessionCallback, resolverCallback bool
+	defer func() {
+		resolverClosed, sessionClosed := handle == 0, session == 0
+		if handle != 0 {
+			status, _, _ := autoClose.Call(handle)
+			resolverClosed = status != 0
+		}
+		if session != 0 {
+			status, _, _ := autoClose.Call(session)
+			sessionClosed = status != 0
+		}
+		pending.cleanupMu.Lock()
+		pending.resolverClosed, pending.sessionClosed = resolverClosed, sessionClosed
+		// No callbacks were installed/operation started on these setup paths.
+		pending.resolverFinal = pending.resolverFinal || !resolverCallback
+		pending.sessionFinal = pending.sessionFinal || !sessionCallback
+		pending.cleanupDone = true
+		pending.cleanupMu.Unlock()
+		retireAuto(token, pending)
+		select {
+		case <-pending.closed:
+		case <-time.After(2 * time.Second):
+			routes = nil
+			resultErr = errors.New("native automatic proxy cancellation retirement remains unknown; operation slot retained")
+		}
+	}()
+	agent, _ := windows.UTF16PtrFromString("OrbWin engine proxy candidate")
+	var callErr error
+	session, _, callErr = autoOpen.Call(uintptr(unsafe.Pointer(agent)), 1, 0, 0, 0x10000000)
+	if session == 0 {
+		return nil, nativeFailure("session-open", callErr)
+	}
+	pending.session.Store(session)
+	status, _, callErr := autoSetOption.Call(session, 45, uintptr(unsafe.Pointer(&token)), unsafe.Sizeof(token))
+	if status == 0 {
+		return nil, nativeFailure("session-context", callErr)
+	}
+	status, _, _ = autoSetCallback.Call(session, automaticCallback, statusError|statusComplete|0x00000c00, 0)
+	if status == ^uintptr(0) {
+		return nil, errors.New("native automatic proxy callback registration failed")
+	}
+	sessionCallback = true
+	status, _, _ = autoCreate.Call(session, uintptr(unsafe.Pointer(&handle)))
+	if status != 0 || handle == 0 {
+		return nil, NativeError{"resolver-create", uint32(status)}
+	}
+	pending.handle.Store(handle)
+	status, _, callErr = autoSetOption.Call(handle, 45, uintptr(unsafe.Pointer(&token)), unsafe.Sizeof(token))
+	if status == 0 {
+		return nil, nativeFailure("resolver-context", callErr)
+	}
+	resolverCallback = true
+	status, _, _ = autoGet.Call(handle, uintptr(unsafe.Pointer(&pending.url[0])), uintptr(unsafe.Pointer(&pending.options)), token)
+	runtime.KeepAlive(pending)
+	runtime.UnlockOSThread()
+	locked = false
+	if uint32(status) != uint32(windows.ERROR_IO_PENDING) {
+		return nil, NativeError{"decision-start", uint32(status)}
+	}
+	select {
+	case <-ctx.Done():
+		return nil, errors.New("native automatic proxy decision canceled or timed out")
+	case <-pending.closed:
+		return nil, errors.New("native automatic proxy resolver closed before completion")
+	case notice := <-pending.done:
+		if notice.status != statusComplete {
+			return nil, NativeError{"decision-complete", notice.code}
+		}
+	}
+	if ctx.Err() != nil {
+		return nil, errors.New("native automatic proxy decision canceled")
+	}
+	var native proxyResult
+	status, _, _ = autoResult.Call(handle, uintptr(unsafe.Pointer(&native)))
+	defer autoFreeResult.Call(uintptr(unsafe.Pointer(&native)))
+	if status != 0 {
+		return nil, NativeError{"result-read", uint32(status)}
+	}
+	if native.count == 0 || native.count > 8 || native.entries == nil {
+		return nil, errors.New("native automatic proxy result count is invalid")
+	}
+	entries := unsafe.Slice(native.entries, int(native.count))
+	copied := make([]nativeChoice, 0, len(entries))
+	for _, entry := range entries {
+		if entry.proxy > 1 || entry.bypass > 1 {
+			return nil, errors.New("native automatic proxy BOOL result is malformed")
+		}
+		if entry.proxy == 0 {
+			// ProxyScheme/host/port are not applicable for DIRECT. Do not
+			// dereference an inapplicable native hostname pointer.
+			copied = append(copied, nativeChoice{bypass: entry.bypass != 0})
+			continue
+		}
+		host, err := boundedNativeString(entry.host, 253)
+		if err != nil {
+			return nil, err
+		}
+		copied = append(copied, nativeChoice{proxy: entry.proxy != 0, bypass: entry.bypass != 0, scheme: entry.scheme, host: host, port: entry.port})
+	}
+	return choices(copied)
+}
diff --git a/rdd/pkg/networkproxy/native_auto_windows_test.go b/rdd/pkg/networkproxy/native_auto_windows_test.go
new file mode 100644
index 0000000..d44bab3
--- /dev/null
+++ b/rdd/pkg/networkproxy/native_auto_windows_test.go
@@ -0,0 +1,208 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// These tests never call Resolve with captured PAC/WPAD configuration, never
+// inspect the actual user's proxy settings, and never perform native PAC traffic.
+func TestNativeAPIAvailabilityAndExplicitCaptureOwnerRefusal(t *testing.T) {
+	fixtureOwner := "S-1-5-21-1-2-3-1001"
+	actual, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		t.Fatal("could not establish a distinct fixture owner without reading proxy configuration")
+	}
+	if actual.User.Sid.String() == fixtureOwner {
+		fixtureOwner = "S-1-5-21-1-2-3-1002"
+	}
+	resolver, err := NewNativeAutoResolver(fixtureOwner)
+	if err != nil {
+		t.Fatalf("Windows native proxy export qualification failed: %v", err)
+	}
+	defer resolver.Close(context.Background())
+	if _, err := resolver.Resolve(context.Background(), target("https://public.example/")); err == nil {
+		t.Fatal("constructor implicitly captured or activated PAC")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if resolver.Capture(ctx) == nil {
+		t.Fatal("canceled capture queried native configuration")
+	}
+	// The explicitly distinct fixture owner fails before GetIEProxyConfig.
+	if resolver.Capture(context.Background()) == nil {
+		t.Fatal("foreign fixture owner captured current-user proxy settings")
+	}
+}
+
+func TestNativeUTF16BoundsAndCallbackRetirementWithoutNetwork(t *testing.T) {
+	if value, err := boundedNativeString(nil, 8); err != nil || value != "" {
+		t.Fatal(err)
+	}
+	valid := []uint16{'a', 0}
+	if value, err := boundedNativeString(&valid[0], 1); err != nil || value != "a" {
+		t.Fatal(err)
+	}
+	for _, buffer := range [][]uint16{{'a', 'b', 'c'}, {0xd800, 0}, {0xdc00, 0}} {
+		if _, err := boundedNativeString(&buffer[0], 2); err == nil {
+			t.Fatal("malformed or unterminated native string accepted")
+		}
+	}
+	resolver, _ := NewNativeAutoResolver("S-1-5-21-1-2-3-1001")
+	resolver.active = 1
+	pending := &pendingAuto{owner: resolver, done: make(chan autoNotification, 1), closed: make(chan struct{})}
+	pending.handle.Store(77)
+	buffer := []byte{1}
+	pending.pins.Pin(&buffer[0])
+	token := uintptr(nextAutoToken.Add(1))
+	pendingAutos.Lock()
+	pendingAutos.values[token] = pending
+	pendingAutos.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+	defer cancel()
+	if resolver.Close(ctx) == nil {
+		t.Fatal("unretired native operation pretended drained")
+	}
+	autoStatus(76, token, statusClosing, nil, 0)
+	select {
+	case <-pending.closed:
+		t.Fatal("foreign native handle retired this operation")
+	default:
+	}
+	autoStatus(77, token, statusError, nil, 0)
+	notice := <-pending.done
+	if notice.code == 0 {
+		t.Fatal("malformed native error buffer accepted")
+	}
+	autoStatus(77, token, statusClosing, nil, 0)
+	autoStatus(77, token, statusClosing, nil, 0) // late/duplicate callback is harmless
+	pending.cleanupMu.Lock()
+	pending.resolverClosed, pending.sessionClosed = true, true
+	pending.sessionFinal, pending.cleanupDone = true, true
+	pending.cleanupMu.Unlock()
+	retireAuto(token, pending)
+	if err := resolver.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-pending.closed:
+	default:
+		t.Fatal("closing callback did not retire pinned input")
+	}
+	pendingAutos.Lock()
+	_, present := pendingAutos.values[token]
+	pendingAutos.Unlock()
+	if present {
+		t.Fatal("retired callback registry entry leaked")
+	}
+	if unsafe.Offsetof(proxyEntry{}.host) != 16 && unsafe.Sizeof(uintptr(0)) == 8 {
+		t.Fatal("WinHTTP result ABI does not match native SDK")
+	}
+}
+
+func TestNativeRetirementRequiresBothHandlesAndCompletedCleanup(t *testing.T) {
+	for _, failedClose := range []bool{false, true} {
+		resolver, err := NewNativeAutoResolver("S-1-5-21-1-2-3-1001")
+		if err != nil {
+			t.Fatal(err)
+		}
+		resolver.active = 1
+		pending := &pendingAuto{owner: resolver, done: make(chan autoNotification, 1), closed: make(chan struct{})}
+		pending.handle.Store(81)
+		pending.session.Store(82)
+		token := uintptr(nextAutoToken.Add(1))
+		pendingAutos.Lock()
+		pendingAutos.values[token] = pending
+		pendingAutos.Unlock()
+		// Callback before CloseHandle returns must not release the owner.
+		autoStatus(81, token, statusClosing, nil, 0)
+		autoStatus(82, token, statusClosing, nil, 0)
+		pending.cleanupMu.Lock()
+		pending.resolverClosed = true
+		pending.sessionClosed = !failedClose
+		pending.cleanupMu.Unlock()
+		retireAuto(token, pending)
+		ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+		if resolver.Close(ctx) == nil {
+			t.Fatal("owner drained before Go cleanup completed")
+		}
+		cancel()
+		pending.cleanupMu.Lock()
+		pending.cleanupDone = true
+		pending.cleanupMu.Unlock()
+		retireAuto(token, pending)
+		if failedClose {
+			ctx, cancel = context.WithTimeout(context.Background(), time.Millisecond)
+			if resolver.Close(ctx) == nil {
+				t.Fatal("failed session close released ownership")
+			}
+			cancel()
+			pendingAutos.Lock()
+			retained := pendingAutos.values[token] == pending
+			pendingAutos.Unlock()
+			if !retained {
+				t.Fatal("unknown native close lost bounded slot")
+			}
+			// Test-only repair, not a production retry: do not leave artificial
+			// failed-close state occupying a global slot for unrelated tests.
+			pending.cleanupMu.Lock()
+			pending.sessionClosed = true
+			pending.cleanupMu.Unlock()
+			retireAuto(token, pending)
+		}
+		if err := resolver.Close(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestNativeErrorsNeverIncludePrivateSourceText(t *testing.T) {
+	err := nativeFailure("configuration-read", errors.New("http://user:secret@private-proxy"))
+	if strings.Contains(err.Error(), "secret") || strings.Contains(err.Error(), "private-proxy") {
+		t.Fatal("raw native error leaked private source")
+	}
+}
+
+func TestNativeConcurrentFinalCallbacksAndCleanup(t *testing.T) {
+	for iteration := 0; iteration < 32; iteration++ {
+		resolver, err := NewNativeAutoResolver("S-1-5-21-1-2-3-1001")
+		if err != nil {
+			t.Fatal(err)
+		}
+		resolver.active = 1
+		pending := &pendingAuto{owner: resolver, done: make(chan autoNotification, 1), closed: make(chan struct{})}
+		pending.handle.Store(91)
+		pending.session.Store(92)
+		token := uintptr(nextAutoToken.Add(1))
+		pendingAutos.Lock()
+		pendingAutos.values[token] = pending
+		pendingAutos.Unlock()
+		var workers sync.WaitGroup
+		workers.Add(3)
+		go func() { defer workers.Done(); autoStatus(91, token, statusClosing, nil, 0) }()
+		go func() { defer workers.Done(); autoStatus(92, token, statusClosing, nil, 0) }()
+		go func() {
+			defer workers.Done()
+			pending.cleanupMu.Lock()
+			pending.resolverClosed, pending.sessionClosed, pending.cleanupDone = true, true, true
+			pending.cleanupMu.Unlock()
+			retireAuto(token, pending)
+		}()
+		workers.Wait()
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		if err := resolver.Close(ctx); err != nil {
+			cancel()
+			t.Fatal(err)
+		}
+		cancel()
+	}
+}
diff --git a/rdd/pkg/networkproxy/native_choices.go b/rdd/pkg/networkproxy/native_choices.go
new file mode 100644
index 0000000..e87f540
--- /dev/null
+++ b/rdd/pkg/networkproxy/native_choices.go
@@ -0,0 +1,202 @@
+package networkproxy
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+type nativeChoice struct {
+	proxy, bypass bool
+	scheme        uint32
+	host          string
+	port          uint16
+}
+
+func choices(entries []nativeChoice) ([]Route, error) {
+	if len(entries) == 0 || len(entries) > 8 {
+		return nil, errors.New("native automatic proxy result exceeds bounded choice count")
+	}
+	result := make([]Route, 0, len(entries))
+	seen := map[string]bool{}
+	for _, entry := range entries {
+		route := Route{Direct: !entry.proxy}
+		if !entry.proxy {
+			if entry.scheme != 0 || entry.host != "" || entry.port != 0 {
+				return nil, errors.New("native direct proxy choice contains conflicting endpoint data")
+			}
+		} else {
+			if entry.bypass || entry.port == 0 || (entry.scheme != 1 && entry.scheme != 2) {
+				return nil, errors.New("native proxy type or port is unsupported")
+			}
+			scheme := "http"
+			if entry.scheme == 2 {
+				scheme = "https"
+			}
+			route.Proxy = scheme + "://" + net.JoinHostPort(strings.ToLower(entry.host), strconv.Itoa(int(entry.port)))
+			if _, err := proxyURL(route.Proxy); err != nil {
+				return nil, errors.New("native proxy endpoint is malformed or contains credentials")
+			}
+		}
+		key := route.Proxy
+		if route.Direct {
+			key = "DIRECT"
+		}
+		if seen[key] {
+			return nil, errors.New("native proxy result contains duplicate choices")
+		}
+		seen[key] = true
+		result = append(result, route)
+	}
+	return result, nil
+}
+
+// ownerConfiguration is deliberately private and has no JSON fields. Capture
+// reads configuration only; resolve alone authorizes PAC/WPAD network activity.
+type ownerConfiguration struct {
+	auto                bool
+	pac, manual, bypass string
+}
+
+func (ownerConfiguration) String() string { return "private Windows owner proxy configuration" }
+func (config ownerConfiguration) validate() error {
+	if len(config.pac) > 2048 || len(config.manual) > 8192 || len(config.bypass) > 8192 {
+		return errors.New("native owner proxy configuration exceeds bounds")
+	}
+	if config.pac != "" {
+		parsed, err := url.Parse(config.pac)
+		if err != nil || parsed == nil || (parsed.Scheme != "http" && parsed.Scheme != "https") || parsed.Host == "" || parsed.User != nil || parsed.Fragment != "" || parsed.Opaque != "" || !safeASCII(config.pac, 2048) {
+			return errors.New("PAC URL requires supported HTTP(S) authority without credentials")
+		}
+		copyURL := *parsed
+		copyURL.RawQuery = ""
+		copyURL.Path = ""
+		copyURL.RawPath = ""
+		if err := validateTarget(&copyURL); err != nil {
+			return errors.New("PAC URL authority is malformed")
+		}
+	}
+	if (config.auto || config.pac != "") && (config.manual != "" || config.bypass != "") {
+		return errors.New("mixed automatic/manual Windows proxy configuration requires separate qualification")
+	}
+	return nil
+}
+
+func staticBypass(raw string, target *url.URL) (bool, error) {
+	if raw == "" {
+		return false, nil
+	}
+	parts := strings.Split(raw, ";")
+	if len(parts) > 128 {
+		return false, errors.New("native bypass list exceeds bounds")
+	}
+	host := strings.ToLower(target.Hostname())
+	matched := false
+	for _, part := range parts {
+		part = strings.ToLower(strings.TrimSpace(part))
+		if part == "" {
+			return false, errors.New("native bypass contains empty entry")
+		}
+		switch {
+		case part == "<local>":
+			_, ipError := netip.ParseAddr(host)
+			matched = matched || ipError != nil && !strings.Contains(host, ".")
+		case part == "*":
+			matched = true
+		case strings.HasPrefix(part, "*."):
+			if !domain(part[2:]) {
+				return false, errors.New("native bypass pattern is unsupported")
+			}
+			matched = matched || strings.HasSuffix(host, part[1:])
+		default:
+			if ip, err := netip.ParseAddr(part); err == nil {
+				if ip.Zone() != "" || ip.Is4In6() {
+					return false, errors.New("native bypass IP is unsupported")
+				}
+			} else if !domain(part) {
+				return false, errors.New("native bypass pattern is unsupported")
+			}
+			matched = matched || host == part
+		}
+	}
+	return matched, nil
+}
+
+// Manual WinINet syntax is per destination scheme, not proxy TLS scheme:
+// https=proxy:80 still means HTTP proxy for HTTPS destinations. Explicit TLS
+// proxy URLs remain supported. Unqualified SOCKS/malformed lists refuse.
+func (config ownerConfiguration) staticRoutes(target *url.URL) ([]Route, error) {
+	if err := config.validate(); err != nil {
+		return nil, err
+	}
+	matched, err := staticBypass(config.bypass, target)
+	if err != nil {
+		return nil, err
+	}
+	if matched {
+		return []Route{{Direct: true}}, nil
+	}
+	if config.manual == "" {
+		return []Route{{Direct: true}}, nil
+	}
+	parts := strings.Split(config.manual, ";")
+	if len(parts) > 8 {
+		return nil, errors.New("native manual proxy list exceeds bounds")
+	}
+	var selected []string
+	mapping := strings.Contains(config.manual, "=")
+	seen := map[string]bool{}
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			return nil, errors.New("native manual proxy contains empty entry")
+		}
+		if mapping {
+			scheme, value, ok := strings.Cut(part, "=")
+			if !ok || seen[scheme] || (scheme != "http" && scheme != "https") {
+				return nil, errors.New("native manual proxy scheme mapping is unsupported")
+			}
+			seen[scheme] = true
+			if scheme == target.Scheme {
+				selected = append(selected, value)
+			}
+		} else {
+			selected = append(selected, part)
+		}
+	}
+	if mapping && len(selected) == 0 {
+		return []Route{{Direct: true}}, nil
+	}
+	var result []Route
+	seen = map[string]bool{}
+	for _, endpoint := range selected {
+		if !strings.Contains(endpoint, "://") {
+			endpoint = "http://" + endpoint
+		}
+		parsed, err := url.Parse(endpoint)
+		if err != nil {
+			return nil, errors.New("native manual proxy endpoint is malformed")
+		}
+		parsed.Host = strings.ToLower(parsed.Host)
+		if _, err := proxyURL(parsed.String()); err != nil {
+			return nil, errors.New("native manual proxy endpoint or credentials are unsupported")
+		}
+		if parsed.Port() == "" {
+			port := "80"
+			if parsed.Scheme == "https" {
+				port = "443"
+			}
+			parsed.Host = net.JoinHostPort(parsed.Hostname(), port)
+		}
+		parsed.Path = ""
+		if seen[parsed.String()] {
+			return nil, errors.New("native manual proxy choices are duplicated")
+		}
+		seen[parsed.String()] = true
+		result = append(result, Route{Proxy: parsed.String()})
+	}
+	return result, nil
+}
