@@ -0,0 +1,68 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"fmt"
+	"runtime"
+	"unsafe"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"golang.org/x/sys/windows"
+)
+
+// Native calls are synchronous. Context checks bound transitions only, not a
+// hard native wallclock. No parent-liveness check on authenticated reconnect.
+func ObserveProxyLaunch(ctx context.Context, owner *app.App, vm *lima.LimaVM, receipt *lima.NetworkProxyLaunchObservation) (app.NetworkProxyBinding, error) {
+	binding, err := LaunchBinding(owner, vm, receipt)
+	if err != nil || ctx == nil || ctx.Err() != nil {
+		return app.NetworkProxyBinding{}, ErrProxyOwner
+	}
+	actual, err := observeManagementPID(uint32(binding.HostPID))
+	if err != nil || actual.Session != receipt.Session || !matchesManagementProcess(binding, actual) || ctx.Err() != nil {
+		return app.NetworkProxyBinding{}, ErrProxyOwner
+	}
+	return binding, nil
+}
+
+// Holds the process object across creation, token, session and liveness checks.
+// A reused numeric PID cannot substitute a different creation time. The
+// current account remains trusted; this is not same-user cryptographic auth.
+func observeManagementPID(pid uint32) (NativeManagementIdentity, error) {
+	var empty NativeManagementIdentity
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	self, selfToken, sid, identity, err := nativeManagementProcess()
+	if err != nil {
+		return empty, ErrProxyOwner
+	}
+	defer windows.CloseHandle(self)
+	defer selfToken.Close()
+	process, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if err != nil {
+		return empty, ErrProxyOwner
+	}
+	defer windows.CloseHandle(process)
+	var creation, exit, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(process, &creation, &exit, &kernel, &user) != nil || windows.ProcessIdToSessionId(pid, &session) != nil || session == 0 || session != identity.Session {
+		return empty, ErrProxyOwner
+	}
+	var token windows.Token
+	if windows.OpenProcessToken(process, windows.TOKEN_QUERY, &token) != nil {
+		return empty, ErrProxyOwner
+	}
+	defer token.Close()
+	owner, err := token.GetTokenUser()
+	var tokenSession, size uint32
+	if err != nil || owner.User.Sid.String() != sid || windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&tokenSession)), 4, &size) != nil || size != 4 || tokenSession != session {
+		return empty, ErrProxyOwner
+	}
+	state, err := windows.WaitForSingleObject(process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return empty, ErrProxyOwner
+	}
+	return NativeManagementIdentity{PID: pid, CreationTime: fmt.Sprintf("%016x", uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime)), Session: session}, nil
+}
