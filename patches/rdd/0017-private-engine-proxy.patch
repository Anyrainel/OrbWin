diff --git a/rdd/pkg/networkproxy/generations.go b/rdd/pkg/networkproxy/generations.go
new file mode 100644
index 0000000..ad86415
--- /dev/null
+++ b/rdd/pkg/networkproxy/generations.go
@@ -0,0 +1,479 @@
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+)
+
+var ErrProxyBusy = errors.New("proxy generation transition is already running")
+var ErrProxyOwner = errors.New("proxy owner changed or cannot be verified")
+var ErrProxyBudget = errors.New("proxy generation or stream budget exhausted")
+var ErrProxyClosed = errors.New("proxy generation owner is closed")
+var ErrProxyRetirement = errors.New("proxy resource retirement or stream join remains unknown")
+var ErrProxyStartup = errors.New("new proxy generation startup was refused or canceled; prior committed policy preserved")
+
+type GenerationOwner struct {
+	AppUID  string
+	Binding app.NetworkProxyBinding
+}
+type OwnerObserver func(context.Context) (GenerationOwner, error)
+type GenerationResource interface{ Close(context.Context) error }
+
+// Startup uses caller cancellation; lifetime belongs to the generation. A
+// partial resource MUST be returned on failure if the factory allocated it.
+// Neither boundary may manufacture a background retry or ignore its context.
+type GenerationFactory func(startup, lifetime context.Context, config Config) (*Policy, GenerationResource, error)
+type CommitResult struct {
+	Committed         bool
+	Revision          int64
+	RetirementUnknown bool
+}
+type GenerationSnapshot struct {
+	ActiveRevision                                 int64
+	Retained, Draining, Starting, Streams, Unknown int
+	Closed                                         bool
+}
+
+type policyGeneration struct {
+	token                       uint64
+	plan                        app.NetworkProxyPlan
+	policy                      *Policy
+	resource                    GenerationResource
+	ctx                         context.Context
+	cancel                      context.CancelFunc
+	starting, retiring, unknown bool
+	leases                      int
+}
+type PolicyGenerationSupervisor struct {
+	mu          sync.Mutex
+	transition  sync.Mutex
+	owner       GenerationOwner
+	observe     OwnerObserver
+	factory     GenerationFactory
+	ctx         context.Context
+	cancel      context.CancelFunc
+	stopParent  func() bool
+	active      *policyGeneration
+	generations map[uint64]*policyGeneration
+	leases      map[*PolicyLease]bool
+	next        uint64
+	closed      bool
+	changed     chan struct{}
+}
+
+func NewPolicyGenerationSupervisor(parent context.Context, owner GenerationOwner, observe OwnerObserver, factory GenerationFactory) (*PolicyGenerationSupervisor, error) {
+	if parent == nil || owner.AppUID == "" || !safeASCII(owner.AppUID, 128) || !validBinding(owner.Binding) || observe == nil || factory == nil {
+		return nil, ErrProxyOwner
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	supervisor := &PolicyGenerationSupervisor{owner: owner, observe: observe, factory: factory, ctx: ctx, cancel: cancel, generations: map[uint64]*policyGeneration{}, leases: map[*PolicyLease]bool{}, changed: make(chan struct{})}
+	supervisor.stopParent = context.AfterFunc(parent, supervisor.invalidate)
+	if parent.Err() != nil {
+		supervisor.invalidate()
+	}
+	return supervisor, nil
+}
+func (supervisor *PolicyGenerationSupervisor) signalLocked() {
+	close(supervisor.changed)
+	supervisor.changed = make(chan struct{})
+}
+func (supervisor *PolicyGenerationSupervisor) invalidate() {
+	supervisor.mu.Lock()
+	supervisor.closed = true
+	supervisor.active = nil
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	// Only generation/lease contexts are canceled. No upstream lifecycle callback.
+	supervisor.cancel()
+}
+func (supervisor *PolicyGenerationSupervisor) verifyOwner(ctx context.Context) error {
+	current, err := supervisor.observe(ctx)
+	if err != nil {
+		return ErrProxyOwner
+	}
+	if current != supervisor.owner {
+		supervisor.invalidate()
+		return ErrProxyOwner
+	}
+	return nil
+}
+func configIdentity(config Config) (Config, string, error) {
+	spec := &app.NetworkProxySpec{Version: config.Version, Mode: config.Mode, URL: config.URL, NoProxy: append([]string{}, config.NoProxy...)}
+	canonical, err := desiredConfig(spec)
+	if err != nil {
+		return Config{}, "", err
+	}
+	digest, err := DesiredDigest(spec)
+	return canonical, digest, err
+}
+
+// Replace performs one synchronous nonqueued startup. Call GuardProxyPlan with
+// current authenticated API state first; this owner verifies native identity and
+// immutable config/revision, but is not an API informer or permission authority.
+func (supervisor *PolicyGenerationSupervisor) Replace(ctx context.Context, plan app.NetworkProxyPlan, config Config) (CommitResult, error) {
+	return supervisor.ReplaceGuarded(ctx, plan, config, nil)
+}
+
+// ReplaceGuarded revalidates authenticated current permission after startup,
+// before publishing the new immutable generation. It is not a distributed CAS
+// between an API and a socket; a later watch invalidation still revokes policy.
+func (supervisor *PolicyGenerationSupervisor) ReplaceGuarded(ctx context.Context, plan app.NetworkProxyPlan, config Config, guard func(context.Context) error) (CommitResult, error) {
+	if ctx == nil {
+		return CommitResult{}, ErrProxyOwner
+	}
+	canonical, digest, err := configIdentity(config)
+	if err != nil || plan.AppUID != supervisor.owner.AppUID || plan.Binding != supervisor.owner.Binding || plan.ObservedGeneration < 1 || plan.ProxyRevision < 1 || plan.ConfigDigest != digest || plan.Phase != "commit" && plan.Phase != "disable" || canonical.Mode == "none" && plan.Phase != "disable" || canonical.Mode != "none" && plan.Phase != "commit" {
+		return CommitResult{}, ErrProxyOwner
+	}
+	if !supervisor.transition.TryLock() {
+		return CommitResult{}, ErrProxyBusy
+	}
+	defer supervisor.transition.Unlock()
+	if err := supervisor.verifyOwner(ctx); err != nil {
+		return CommitResult{}, err
+	}
+	supervisor.mu.Lock()
+	if supervisor.closed || ctx.Err() != nil {
+		supervisor.mu.Unlock()
+		return CommitResult{}, ErrProxyClosed
+	}
+	if supervisor.active != nil {
+		if plan.ProxyRevision == supervisor.active.plan.ProxyRevision && digest == supervisor.active.plan.ConfigDigest {
+			result := CommitResult{Committed: true, Revision: plan.ProxyRevision}
+			supervisor.mu.Unlock()
+			return result, nil
+		}
+		if plan.ProxyRevision <= supervisor.active.plan.ProxyRevision {
+			supervisor.mu.Unlock()
+			return CommitResult{}, ErrProxyOwner
+		}
+		if digest == supervisor.active.plan.ConfigDigest {
+			supervisor.mu.Unlock()
+			return CommitResult{}, ErrProxyOwner
+		}
+	}
+	if len(supervisor.generations) >= MaxDrainingGenerations+1 || supervisor.next == ^uint64(0) {
+		supervisor.mu.Unlock()
+		return CommitResult{}, ErrProxyBudget
+	}
+	supervisor.next++
+	lifetime, cancel := context.WithCancel(supervisor.ctx)
+	generation := &policyGeneration{token: supervisor.next, plan: plan, ctx: lifetime, cancel: cancel, starting: true}
+	supervisor.generations[generation.token] = generation
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	startup, stopStartup := context.WithTimeout(ctx, 8*time.Second)
+	stopOwner := context.AfterFunc(lifetime, stopStartup)
+	policy, resource, startErr := supervisor.factory(startup, lifetime, canonical)
+	startupExpired := startup.Err() != nil
+	stopOwner()
+	stopStartup()
+	// Snapshot once: the factory cannot later replace the admitted Policy pointer.
+	validPolicy := false
+	if policy != nil {
+		_, actual, validationErr := configIdentity(policy.config)
+		validPolicy = validationErr == nil && actual == digest && (canonical.Mode != "auto" || resource != nil)
+	}
+	ownerErr := supervisor.verifyOwner(ctx)
+	var guardErr error
+	if startErr == nil && validPolicy && ownerErr == nil && guard != nil {
+		guardErr = guard(ctx)
+	}
+	supervisor.mu.Lock()
+	generation.policy = policy
+	generation.resource = resource
+	generation.starting = false
+	prior := supervisor.active
+	commit := startErr == nil && !startupExpired && validPolicy && ownerErr == nil && guardErr == nil && ctx.Err() == nil && !supervisor.closed
+	if commit {
+		supervisor.active = generation
+	}
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	if !commit {
+		generation.cancel()
+		cleanup, stopCleanup := context.WithTimeout(context.Background(), 2*time.Second)
+		retirementErr := supervisor.retire(cleanup, generation)
+		stopCleanup()
+		if retirementErr != nil {
+			return CommitResult{RetirementUnknown: true}, ErrProxyRetirement
+		}
+		if ownerErr != nil {
+			return CommitResult{}, ownerErr
+		}
+		if guardErr != nil {
+			return CommitResult{}, guardErr
+		}
+		return CommitResult{}, ErrProxyStartup
+	}
+	result := CommitResult{Committed: true, Revision: plan.ProxyRevision}
+	if prior != nil {
+		cleanup, stopCleanup := context.WithTimeout(context.Background(), 2*time.Second)
+		retirementErr := supervisor.retire(cleanup, prior)
+		stopCleanup()
+		if err := retirementErr; err != nil {
+			result.RetirementUnknown = true
+			return result, err
+		}
+	}
+	return result, nil
+}
+
+// Suspend revokes proxy admission and closes/joins all proxy streams without
+// closing the supervisor's native owner. A later valid higher/equal retained
+// permission can recover after a transient stale plan or private listener loss.
+// It never touches the hostagent, bridge, NAT, DNS or engine lifecycle.
+func (supervisor *PolicyGenerationSupervisor) Suspend(ctx context.Context) error {
+	if ctx == nil {
+		return ErrProxyRetirement
+	}
+	if !supervisor.transition.TryLock() {
+		return ErrProxyBusy
+	}
+	defer supervisor.transition.Unlock()
+	limited, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	ctx = limited
+	supervisor.mu.Lock()
+	supervisor.active = nil
+	owned := make([]*policyGeneration, 0, len(supervisor.generations))
+	for _, generation := range supervisor.generations {
+		owned = append(owned, generation)
+	}
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	for _, generation := range owned {
+		generation.cancel()
+	}
+	for {
+		supervisor.mu.Lock()
+		if len(supervisor.generations) == 0 && len(supervisor.leases) == 0 {
+			supervisor.mu.Unlock()
+			return nil
+		}
+		candidates := make([]*policyGeneration, 0, len(supervisor.generations))
+		unknown := false
+		for _, generation := range supervisor.generations {
+			if generation.unknown {
+				unknown = true
+			}
+			if !generation.starting && !generation.retiring && generation.leases == 0 {
+				candidates = append(candidates, generation)
+			}
+		}
+		changed := supervisor.changed
+		supervisor.mu.Unlock()
+		if ctx.Err() != nil {
+			return ErrProxyRetirement
+		}
+		if len(candidates) > 0 {
+			for _, generation := range candidates {
+				if err := supervisor.retire(ctx, generation); err != nil {
+					return err
+				}
+			}
+			continue
+		}
+		if unknown {
+			return ErrProxyRetirement
+		}
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return ErrProxyRetirement
+		}
+	}
+}
+
+// Retirement is attempted once. Error/timeout retains the exact generation;
+// later callbacks cannot silently free it or cause another close attempt.
+func (supervisor *PolicyGenerationSupervisor) retire(ctx context.Context, generation *policyGeneration) error {
+	supervisor.mu.Lock()
+	if supervisor.generations[generation.token] != generation {
+		supervisor.mu.Unlock()
+		return nil
+	}
+	if generation.unknown {
+		supervisor.mu.Unlock()
+		return ErrProxyRetirement
+	}
+	if supervisor.active == generation || generation.starting || generation.leases != 0 || generation.retiring {
+		supervisor.mu.Unlock()
+		return nil
+	}
+	if ctx.Err() != nil {
+		supervisor.mu.Unlock()
+		return ErrProxyRetirement
+	}
+	generation.retiring = true
+	supervisor.mu.Unlock()
+	generation.cancel()
+	var err error
+	if generation.resource != nil {
+		err = generation.resource.Close(ctx)
+	}
+	supervisor.mu.Lock()
+	if err == nil {
+		delete(supervisor.generations, generation.token)
+	} else {
+		generation.unknown = true
+	}
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	if err != nil {
+		return ErrProxyRetirement
+	}
+	return nil
+}
+
+type PolicyLease struct {
+	supervisor            *PolicyGenerationSupervisor
+	generation            *policyGeneration
+	ctx                   context.Context
+	cancel                context.CancelFunc
+	stopCaller, stopClose func() bool
+	closeDone             chan struct{}
+	releaseMu             sync.Mutex
+	released              bool
+}
+
+func (lease *PolicyLease) Policy() *Policy          { return lease.generation.policy }
+func (lease *PolicyLease) Revision() int64          { return lease.generation.plan.ProxyRevision }
+func (lease *PolicyLease) Context() context.Context { return lease.ctx }
+
+// Acquire must precede policy/dial/TLS work so every phase consumes a slot.
+// closeOwned closes only this stream's owned sockets. Release is the caller's
+// acknowledgement that its handler/duplex has joined, not just a socket close.
+func (supervisor *PolicyGenerationSupervisor) Acquire(ctx context.Context, closeOwned func()) (*PolicyLease, error) {
+	if ctx == nil || closeOwned == nil || ctx.Err() != nil {
+		return nil, ErrProxyClosed
+	}
+	if err := supervisor.verifyOwner(ctx); err != nil {
+		return nil, err
+	}
+	supervisor.mu.Lock()
+	defer supervisor.mu.Unlock()
+	if supervisor.closed || supervisor.active == nil || ctx.Err() != nil {
+		return nil, ErrProxyClosed
+	}
+	if len(supervisor.leases) >= MaxProxyStreams {
+		return nil, ErrProxyBudget
+	}
+	generation := supervisor.active
+	lifetime, cancel := context.WithCancel(generation.ctx)
+	lease := &PolicyLease{supervisor: supervisor, generation: generation, ctx: lifetime, cancel: cancel, closeDone: make(chan struct{})}
+	lease.stopClose = context.AfterFunc(lifetime, func() { defer close(lease.closeDone); closeOwned() })
+	lease.stopCaller = context.AfterFunc(ctx, cancel)
+	generation.leases++
+	supervisor.leases[lease] = true
+	return lease, nil
+}
+func (lease *PolicyLease) Release(ctx context.Context) error {
+	if ctx == nil {
+		return ErrProxyRetirement
+	}
+	limited, stop := context.WithTimeout(ctx, 2*time.Second)
+	defer stop()
+	ctx = limited
+	if !lease.releaseMu.TryLock() {
+		return ErrProxyBusy
+	}
+	defer lease.releaseMu.Unlock()
+	if lease.released {
+		return nil
+	}
+	lease.stopCaller()
+	if !lease.stopClose() {
+		select {
+		case <-lease.closeDone:
+		case <-ctx.Done():
+			return ErrProxyRetirement
+		}
+	}
+	lease.cancel()
+	supervisor := lease.supervisor
+	supervisor.mu.Lock()
+	delete(supervisor.leases, lease)
+	lease.generation.leases--
+	lease.released = true
+	supervisor.signalLocked()
+	supervisor.mu.Unlock()
+	return supervisor.retire(ctx, lease.generation)
+}
+
+// Close starts proxy-only cancellation, then waits for the caller's stream join
+// acknowledgements and provider retirement. Parent cancellation alone starts the
+// same invalidation; the hostagent MUST call Close with a cleanup deadline to join.
+// A blocking injected native Close cannot be preempted here; the process bound
+// remains required and no unbounded helper goroutine masks that limitation.
+func (supervisor *PolicyGenerationSupervisor) Close(ctx context.Context) error {
+	if ctx == nil {
+		return ErrProxyRetirement
+	}
+	limited, stop := context.WithTimeout(ctx, 2*time.Second)
+	defer stop()
+	ctx = limited
+	supervisor.stopParent()
+	supervisor.invalidate()
+	for {
+		supervisor.mu.Lock()
+		if len(supervisor.generations) == 0 && len(supervisor.leases) == 0 {
+			supervisor.mu.Unlock()
+			return nil
+		}
+		candidates := make([]*policyGeneration, 0, len(supervisor.generations))
+		unknown := false
+		for _, generation := range supervisor.generations {
+			if generation.unknown {
+				unknown = true
+			}
+			if !generation.starting && !generation.retiring && generation.leases == 0 {
+				candidates = append(candidates, generation)
+			}
+		}
+		changed := supervisor.changed
+		supervisor.mu.Unlock()
+		if ctx.Err() != nil {
+			return ErrProxyRetirement
+		}
+		if len(candidates) > 0 {
+			for _, generation := range candidates {
+				if err := supervisor.retire(ctx, generation); err != nil {
+					return err
+				}
+			}
+			continue
+		}
+		if unknown {
+			return ErrProxyRetirement
+		}
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return ErrProxyRetirement
+		}
+	}
+}
+func (supervisor *PolicyGenerationSupervisor) Snapshot() GenerationSnapshot {
+	supervisor.mu.Lock()
+	defer supervisor.mu.Unlock()
+	result := GenerationSnapshot{Retained: len(supervisor.generations), Streams: len(supervisor.leases), Closed: supervisor.closed}
+	if supervisor.active != nil {
+		result.ActiveRevision = supervisor.active.plan.ProxyRevision
+	}
+	for _, generation := range supervisor.generations {
+		if generation.starting {
+			result.Starting++
+		} else if generation != supervisor.active {
+			result.Draining++
+		}
+		if generation.unknown {
+			result.Unknown++
+		}
+	}
+	return result
+}
