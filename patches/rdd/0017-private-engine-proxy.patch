+package managementconfig
+
+// Only a transferred kernel object carries authority. This public metadata is
+// bounded identity used to reject accidental/stale handle mixups.
+type AnchorIdentity struct{ Volume, IndexHigh, IndexLow uint32 }
+type LaunchAnchor interface {
+	Start(func(uintptr, AnchorIdentity) error) error
+	Close() error
+}
diff --git a/rdd/pkg/managementconfig/anchor_reader_windows.go b/rdd/pkg/managementconfig/anchor_reader_windows.go
new file mode 100644
index 0000000..1bc1c36
--- /dev/null
+++ b/rdd/pkg/managementconfig/anchor_reader_windows.go
@@ -0,0 +1,143 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// OpenReader opens only the fixed configuration relative to the inherited
+// selected object, never a pathname or ambient root. The duplicate is a lifetime
+// lease; it does not change the original sharing reservation. The caller owns
+// both Reader and ReceivedAnchor independently and must close each.
+func (a *ReceivedAnchor) OpenReader(ctx context.Context) (*Reader, error) {
+	if a == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.handle == 0 {
+		return nil, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(a.handle, sid, true) != nil {
+		return nil, ErrCreate
+	}
+	var h windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), a.handle, windows.CurrentProcess(), &h, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		return nil, ErrCreate
+	}
+	reader, err := openReaderLeaf(ctx, &ParentLease{chain: []windows.Handle{h}, sid: sid})
+	if err != nil {
+		return nil, err
+	}
+	if verifyPrivate(windows.Handle(reader.file.Fd()), sid, false) != nil || ctx.Err() != nil {
+		reader.Close()
+		return nil, ErrCreate
+	}
+	return reader, nil
+}
+
+// PrepareOrbWinAnchorTransfer retains the existing conservative whole-chain
+// policy. It never creates/repairs/migrates an existing instance. This initial
+// integration supports only the pinned default TLS authority filenames, all
+// protected/private at metadata inspection; custom certificates remain refused.
+func PrepareOrbWinAnchorTransfer(ctx context.Context, root *InstanceRoot) (*AnchorTransfer, error) {
+	lease, err := OpenInstanceParent(ctx, root)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	defer lease.Close()
+	if walkRelative(ctx, lease, []string{anchorName}) != nil {
+		return nil, ErrCreate
+	}
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(lease.leaf(), sid, true) != nil || checkAuthorityFiles(ctx, lease.leaf(), sid) != nil {
+		return nil, ErrCreate
+	}
+	if ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	var duplicate windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), lease.leaf(), windows.CurrentProcess(), &duplicate, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, true, 0) != nil {
+		return nil, ErrCreate
+	}
+	id, err := anchorIdentity(duplicate)
+	if err != nil {
+		windows.CloseHandle(duplicate)
+		return nil, ErrCreate
+	}
+	return &AnchorTransfer{handle: duplicate, identity: id}, nil
+}
+
+// No FILE_READ_DATA: private authority qualification here is metadata only.
+// Metadata-only file handles are NOT namespace leases. The protected retained
+// directory is the authority; this is not an atomic certificate rotation or
+// ongoing ACL mutation guard against same UID.
+func checkAuthorityFiles(ctx context.Context, anchor windows.Handle, sid string) (err error) {
+	tls, err := openRelative(anchor, "tls", true, nil, false)
+	if err != nil {
+		return ErrCreate
+	}
+	defer func() {
+		if windows.CloseHandle(tls) != nil {
+			err = ErrCreate
+		}
+	}()
+	if verifyPrivate(tls, sid, true) != nil {
+		return ErrCreate
+	}
+	// Pinned ApplyTo generates volatile bearer tokens in memory. The obsolete
+	// ShardAdminTokenHashFilePath option does not create or consume a token store.
+	// Absence is valid; present legacy state is unsupported, never a dummy file.
+	obsolete, obsoleteErr := openMetadataRelative(tls, ".admin-token-store")
+	if obsoleteErr == nil {
+		windows.CloseHandle(obsolete)
+		return ErrCreate
+	}
+	if obsoleteErr != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrCreate
+	}
+	for _, name := range []string{"apiserver.crt", "apiserver.key", "sa.key"} {
+		if ctx.Err() != nil {
+			return ErrCreate
+		}
+		// openRelative's file mode includes data-read. Use a dedicated metadata
+		// open with the same native no-reparse single-component primitive.
+		h, err := openMetadataRelative(tls, name)
+		if err != nil {
+			return ErrCreate
+		}
+		verified := verifyPrivate(h, sid, false)
+		closed := windows.CloseHandle(h)
+		if verified != nil || closed != nil {
+			return ErrCreate
+		}
+	}
+	return nil
+}
+
+func openMetadataRelative(parent windows.Handle, name string) (windows.Handle, error) {
+	_, parts, err := readerComponents(`C:\` + name)
+	if err != nil || len(parts) != 1 {
+		return 0, ErrCreate
+	}
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrCreate
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	if err := windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_OPEN_REPARSE_POINT|windows.FILE_NON_DIRECTORY_FILE, 0, 0); err != nil {
+		return 0, err
+	}
+	return h, nil
+}
