diff --git a/rdd/pkg/managementconfig/private_windows.go b/rdd/pkg/managementconfig/private_windows.go
new file mode 100644
index 0000000..8ae10db
--- /dev/null
+++ b/rdd/pkg/managementconfig/private_windows.go
@@ -0,0 +1,347 @@
+//go:build windows
+
+// Package managementconfig owns the selected Windows management authority.
+// Existing service creation/serving and retained hostagent readers use fixed
+// private roles; native acceptance remains scoped to separately recorded proof.
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"io"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+const MaxConfigBytes = 1 << 20
+const anchorName = "rancher-desktop-orbwin"
+const configName = "config.yaml"
+
+var ErrCreate = errors.New("fresh private management creation refused")
+
+// Created owns three handles until Close; Close never removes successful files.
+// It is not a receipt authorizing a reader or allowing ancestor-policy changes.
+type Created struct {
+	mu                   sync.Mutex
+	closed               bool
+	parent, anchor, file windows.Handle
+	parents              *ParentLease
+	once                 sync.Once
+	closeErr             error
+	authorityHandles     []windows.Handle
+	servingLease         bool // Set only by a retained read/shareable authority reopen.
+	generationAttempted  bool
+	datastoreReserved    bool
+	datastoreActive      atomic.Bool
+}
+
+func (*Created) String() string   { return "private fresh management handles" }
+func (*Created) GoString() string { return "private fresh management handles" }
+func (c *Created) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.datastoreActive.Load() {
+		return ErrCreate
+	}
+	c.once.Do(func() {
+		c.closed = true
+		for i := len(c.authorityHandles) - 1; i >= 0; i-- {
+			if windows.CloseHandle(c.authorityHandles[i]) != nil {
+				c.closeErr = ErrCreate
+			}
+		}
+		c.authorityHandles = nil
+		for _, h := range []windows.Handle{c.file, c.anchor} {
+			if h != 0 && windows.CloseHandle(h) != nil {
+				c.closeErr = ErrCreate
+			}
+		}
+		if c.parents != nil && c.parents.Close() != nil {
+			c.closeErr = ErrCreate
+		}
+	})
+	return c.closeErr
+}
+
+type createOps struct {
+	beforeConfig func(windows.Handle) error
+	write        func(windows.Handle, []byte) (int, error)
+	flush        func(windows.Handle) error
+}
+
+func nativeWrite(h windows.Handle, data []byte) (int, error) {
+	var n uint32
+	e := windows.WriteFile(h, data, &n, nil)
+	return int(n), e
+}
+
+// createFreshDefault creates only the fixed child anchor and config, never opens
+// or updates existing ones. It remains PACKAGE PRIVATE: production must add a
+// reviewed retained-chain opener/typed authority, not expose a raw handle/path.
+// parent must be a backend-owned selected-instance parent lease already opened
+// with FILE_LIST_DIRECTORY and without DELETE sharing. Metadata-only handles
+// cannot establish that lease. Duplication preserves lifetime only, not sharing.
+// Synchronous OS operations are bounded at cancellation boundaries, not preempted.
+func createFreshDefault(ctx context.Context, parent *ParentLease, data []byte) (*Created, error) {
+	return createFresh(ctx, parent, data, createOps{write: nativeWrite, flush: windows.FlushFileBuffers})
+}
+func createFresh(ctx context.Context, parent *ParentLease, data []byte, ops createOps) (result *Created, err error) {
+	if ctx == nil || ctx.Err() != nil || parent == nil || len(data) == 0 || len(data) > MaxConfigBytes || ops.write == nil || ops.flush == nil {
+		return nil, &Failure{Stage: "input"}
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil {
+		return nil, &Failure{Stage: "owner"}
+	}
+	if sid != parent.sid {
+		return nil, &Failure{Stage: "owner"}
+	}
+	anchorSD, err := privateDescriptor(sid, true)
+	if err != nil {
+		return nil, &Failure{Stage: "descriptor"}
+	}
+	fileSD, err := privateDescriptor(sid, false)
+	if err != nil {
+		return nil, &Failure{Stage: "descriptor"}
+	}
+	owned := &Created{}
+	stage := "parent"
+	defer func() {
+		if err != nil {
+			unknown := owned.removeFailed()
+			err = &Failure{Stage: stage, CleanupUnknown: unknown}
+			result = nil
+		}
+	}()
+	owned.parents, err = parent.retain()
+	if err != nil {
+		return nil, err
+	}
+	owned.parent = owned.parents.leaf()
+	stage = "parent-kind"
+	if objectKind(owned.parent, true) != nil {
+		return nil, ErrCreate
+	}
+	stage = "anchor-create"
+	if ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	owned.anchor, err = openRelative(owned.parent, anchorName, true, anchorSD, true)
+	if err != nil {
+		return nil, err
+	}
+	stage = "anchor-descriptor"
+	if verifyPrivate(owned.anchor, sid, true) != nil {
+		return nil, ErrCreate
+	}
+	stage = "config-create"
+	if ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	if ops.beforeConfig != nil {
+		if err = ops.beforeConfig(owned.anchor); err != nil {
+			return nil, err
+		}
+	}
+	owned.file, err = openRelative(owned.anchor, configName, false, fileSD, true)
+	if err != nil {
+		return nil, err
+	}
+	stage = "config-descriptor"
+	if verifyPrivate(owned.file, sid, false) != nil {
+		return nil, ErrCreate
+	}
+	stage = "write"
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return nil, ErrCreate
+		}
+		n, e := ops.write(owned.file, remaining)
+		if e != nil || n < 1 || n > len(remaining) {
+			return nil, ErrCreate
+		}
+		remaining = remaining[n:]
+	}
+	stage = "flush"
+	if ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	if err = ops.flush(owned.file); err != nil {
+		return nil, err
+	}
+	stage = "final-descriptor"
+	if ctx.Err() != nil || verifyPrivate(owned.anchor, sid, true) != nil || verifyPrivate(owned.file, sid, false) != nil {
+		return nil, ErrCreate
+	}
+	return owned, nil
+}
+
+func currentOwner() (string, error) {
+	var thread windows.Token
+	if err := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, &thread); err == nil {
+		thread.Close()
+		return "", ErrCreate
+	} else if err != windows.ERROR_NO_TOKEN {
+		return "", ErrCreate
+	}
+	token, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		return "", ErrCreate
+	}
+	defer token.Close()
+	user, err := token.GetTokenUser()
+	if err != nil {
+		return "", ErrCreate
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 {
+		return "", ErrCreate
+	}
+	return user.User.Sid.String(), nil
+}
+func privateDescriptor(sid string, directory bool) (*windows.SECURITY_DESCRIPTOR, error) {
+	flags := ""
+	if directory {
+		flags = "OICI"
+	}
+	return windows.SecurityDescriptorFromString("O:" + sid + "D:P(A;" + flags + ";FA;;;" + sid + ")(A;" + flags + ";FA;;;SY)(A;" + flags + ";FA;;;BA)")
+}
+func openRelative(parent windows.Handle, name string, directory bool, sd *windows.SECURITY_DESCRIPTOR, create bool) (windows.Handle, error) {
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return 0, ErrCreate
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options |= windows.FILE_DIRECTORY_FILE
+		access |= windows.FILE_LIST_DIRECTORY
+	} else {
+		options |= windows.FILE_NON_DIRECTORY_FILE
+	}
+	disposition := uint32(windows.FILE_OPEN)
+	share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE)
+	if create {
+		access |= windows.DELETE
+		disposition = windows.FILE_CREATE
+		share = 0
+		if !directory {
+			access |= windows.FILE_WRITE_DATA
+		}
+	} else if !directory {
+		access |= windows.FILE_READ_DATA
+		share = windows.FILE_SHARE_READ
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, share, disposition, options, 0, 0)
+	runtime.KeepAlive(sd)
+	if e != nil {
+		return 0, e
+	}
+	return h, nil
+}
+func objectKind(h windows.Handle, directory bool) error {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil || info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory || !directory && info.NumberOfLinks != 1 {
+		return ErrCreate
+	}
+	if kind, e := windows.GetFileType(h); e != nil || kind != windows.FILE_TYPE_DISK {
+		return ErrCreate
+	}
+	var path [1024]uint16
+	n, e := windows.GetFinalPathNameByHandle(h, &path[0], uint32(len(path)), 2)
+	if e != nil || n < 1 || n >= uint32(len(path)) {
+		return ErrCreate
+	}
+	const prefix = `\Device\HarddiskVolume`
+	if len(path) < len(prefix) {
+		return ErrCreate
+	}
+	for i, r := range prefix {
+		if path[i] != uint16(r) {
+			return ErrCreate
+		}
+	}
+	var flags uint32
+	if windows.GetVolumeInformationByHandle(h, nil, 0, nil, nil, &flags, nil, 0) != nil || flags&windows.FILE_PERSISTENT_ACLS == 0 {
+		return ErrCreate
+	}
+	return nil
+}
+func verifyPrivate(h windows.Handle, sid string, directory bool) error {
+	if objectKind(h, directory) != nil {
+		return ErrCreate
+	}
+	sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if e != nil {
+		return ErrCreate
+	}
+	owner, _, e := sd.Owner()
+	if e != nil || owner == nil || owner.String() != sid {
+		return ErrCreate
+	}
+	control, _, e := sd.Control()
+	if e != nil || control&windows.SE_DACL_PROTECTED == 0 || control&windows.SE_DACL_PRESENT == 0 {
+		return ErrCreate
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || acl == nil || acl.AceCount != 3 {
+		return ErrCreate
+	}
+	seen := map[string]bool{}
+	for i := uint32(0); i < 3; i++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if windows.GetAce(acl, i, &ace) != nil || ace == nil || ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceSize < 16 || uint32(ace.Mask) != 0x1f01ff {
+			return ErrCreate
+		}
+		flags := uint8(0)
+		if directory {
+			flags = windows.OBJECT_INHERIT_ACE | windows.CONTAINER_INHERIT_ACE
+		}
+		if ace.Header.AceFlags != flags {
+			return ErrCreate
+		}
+		principal := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		if !principal.IsValid() || principal.Len() > int(ace.Header.AceSize)-8 {
+			return ErrCreate
+		}
+		value := principal.String()
+		if seen[value] || (value != sid && value != "S-1-5-18" && value != "S-1-5-32-544") {
+			return ErrCreate
+		}
+		seen[value] = true
+	}
+	return nil
+}
+
+// Cleanup addresses only our just-created open objects. A colliding child is
+// never opened/deleted; failure to remove the now-nonempty anchor is reported.
+func (c *Created) removeFailed() bool {
+	unknown := false
+	for _, h := range []windows.Handle{c.file, c.anchor} {
+		if h != 0 {
+			remove := uint32(1)
+			if windows.SetFileInformationByHandle(h, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4) != nil {
+				unknown = true
+			}
+			if windows.CloseHandle(h) != nil {
+				unknown = true
+			}
+		}
+	}
+	if c.parents != nil && c.parents.Close() != nil {
+		unknown = true
+	}
+	return unknown
+}
+
+var _ io.Closer = (*Created)(nil)
diff --git a/rdd/pkg/managementconfig/private_windows_test.go b/rdd/pkg/managementconfig/private_windows_test.go
