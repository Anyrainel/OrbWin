+			if json.Unmarshal(patch[0].Value, &uid) != nil || json.Unmarshal(patch[1].Value, &rv) != nil || uid != string(current.UID) || rv != current.ResourceVersion || json.Unmarshal(patch[2].Value, &host) != nil || GuardHostObservation(current, &host, current.Status.NetworkProxy.Plan.Binding) != nil {
+				w.WriteHeader(409)
