+func TestManagementNativeCurrentIdentityAndStaleRefusal(t *testing.T) {
+	managementFixtureSID(t)
+	identity, err := CurrentManagementProcess()
+	if err != nil || identity.PID != uint32(os.Getpid()) || identity.Session == 0 || !hexIdentity(identity.CreationTime, 16) {
