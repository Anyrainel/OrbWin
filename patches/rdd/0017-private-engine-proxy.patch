@@ -0,0 +1,82 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestManagementMetadataFreshHandleCannotReadCredentialBytes(t *testing.T) {
+	_, file, sid := managementTemp(t)
+	p, _ := windows.UTF16PtrFromString(file)
+	h, err := windows.CreateFile(p, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		t.Fatal("metadata fixture open failed")
+	}
+	defer windows.CloseHandle(h)
+	budget := 256
+	stage, err := observeManagementHandle(h, sid, 1, "config", false, &budget)
+	if err != nil || !stage.OwnershipPolicyAccepted || stage.OwnerClass != "current-user" {
+		t.Fatal("metadata fixture refused")
+	}
+	var bytes [8]byte
+	var count uint32
+	if windows.ReadFile(h, bytes[:], &count, nil) == nil || count != 0 {
+		t.Fatal("metadata handle could read credential bytes")
+	}
+	encoded, err := json.Marshal(stage)
+	if err != nil || strings.Contains(string(encoded), sid) || strings.Contains(string(encoded), file) || strings.Contains(string(encoded), "fixture bytes") {
+		t.Fatal("private metadata escaped")
+	}
+}
+
+func TestManagementMetadataBoundedUnsafeACLAndPrivilegeClassification(t *testing.T) {
+	_, file, sid := managementTemp(t)
+	privateManagementACL(t, file, sid, "(A;;FR;;;WD)")
+	p, _ := windows.UTF16PtrFromString(file)
+	h, err := windows.CreateFile(p, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		t.Fatal("fixture metadata open failed")
+	}
+	defer windows.CloseHandle(h)
+	budget := 256
+	stage, err := observeManagementHandle(h, sid, 1, "config", false, &budget)
+	if err != nil || stage.OwnershipPolicyAccepted {
+		t.Fatal("unsafe ACL hidden or authorized")
+	}
+	found := false
+	for _, ace := range stage.ACEs {
+		if ace.PrincipalClass == "everyone" && ace.Mask&windows.FILE_READ_DATA != 0 {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("redacted ACL evidence missing")
+	}
+	budget = 0
+	if _, err := observeManagementHandle(h, sid, 1, "config", false, &budget); err != ErrManagement {
+		t.Fatal("metadata budget ignored")
+	}
+	if !trustedManagementSID(managementTrustedInstaller, sid) || trustedManagementSID("S-1-5-80-123-456", sid) {
+		t.Fatal("OS servicing exception widened")
+	}
+	if managementPrincipalClass(managementTrustedInstaller, sid) != "TrustedInstaller" || managementPrincipalClass("S-1-5-80-123-456", sid) != "other-service-account" {
+		t.Fatal("service principal classification incorrect")
+	}
+}
+
+func TestManagementMetadataFreshTraversalDoesNotAuthorize(t *testing.T) {
+	_, file, sid := managementTemp(t)
+	report := observeManagementMetadataPath(file, sid)
+	if !report.Complete || report.RegistrationAllowed || len(report.Stages) < 2 || report.Stages[len(report.Stages)-1].Scope != "config" {
+		t.Fatal("fresh fixture metadata traversal did not complete safely")
+	}
+	encoded, err := json.Marshal(report)
+	if err != nil || len(encoded) > 64<<10 || strings.Contains(string(encoded), sid) || strings.Contains(string(encoded), file) || strings.Contains(string(encoded), "private fixture bytes") {
+		t.Fatal("unbounded or private metadata output")
+	}
+}
diff --git a/rdd/pkg/networkproxy/management_owner_fixture_windows_test.go b/rdd/pkg/networkproxy/management_owner_fixture_windows_test.go
new file mode 100644
index 0000000..ce8fce2
--- /dev/null
+++ b/rdd/pkg/networkproxy/management_owner_fixture_windows_test.go
@@ -0,0 +1,100 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"golang.org/x/sys/windows"
+	"os"
+	"unsafe"
+)
+
+// Legacy fixture helpers only. Production readers use typed managementconfig authority.
+type managementHandles struct {
+	dirs []windows.Handle
+	file *os.File
+}
+
+func (h *managementHandles) Close() error {
+	if h.file != nil {
+		h.file.Close()
+		h.file = nil
+	}
+	for i := len(h.dirs) - 1; i >= 0; i-- {
+		windows.CloseHandle(h.dirs[i])
+	}
+	h.dirs = nil
+	return nil
+}
+
+func openManagementPath(path, sid string) (result *managementHandles, err error) {
+	root, parts, err := managementComponents(path)
+	if err != nil {
+		return nil, err
+	}
+	result = &managementHandles{}
+	owned := result
+	defer func() {
+		if err != nil {
+			owned.Close()
+			result = nil
+		}
+	}()
+	root16, err := windows.UTF16PtrFromString(root)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	parent, e := windows.CreateFile(root16, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e != nil {
+		return result, ErrManagement
+	}
+	result.dirs = append(result.dirs, parent)
+	if verifyManagementHandle(parent, sid, true) != nil {
+		return result, ErrManagement
+	}
+	return result, openManagementChildren(result, parent, parts, sid)
+}
+
+// Only called with a verified retained parent. Production obtains that parent
+// by walking from the volume root; fixture tests qualify the same child logic
+// from their private fresh directory without claiming ancestor qualification.
+func openManagementChildren(result *managementHandles, parent windows.Handle, parts []string, sid string) error {
+	for index, part := range parts {
+		name, e := windows.NewNTUnicodeString(part)
+		if e != nil {
+			return ErrManagement
+		}
+		oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: name, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+		oa.Length = uint32(unsafe.Sizeof(oa))
+		access := uint32(windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL | windows.SYNCHRONIZE)
+		options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+		share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE)
+		directory := index < len(parts)-1
+		if directory {
+			options |= windows.FILE_DIRECTORY_FILE
+			access |= windows.FILE_LIST_DIRECTORY
+		} else {
+			options |= windows.FILE_NON_DIRECTORY_FILE
+			access |= windows.FILE_READ_DATA
+			share = windows.FILE_SHARE_READ
+		}
+		var handle windows.Handle
+		var status windows.IO_STATUS_BLOCK
+		if windows.NtCreateFile(&handle, access, &oa, &status, nil, 0, share, windows.FILE_OPEN, options, 0, 0) != nil {
+			return ErrManagement
+		}
+		if directory {
+			result.dirs = append(result.dirs, handle)
+			parent = handle
+		} else {
+			result.file = os.NewFile(uintptr(handle), "private management configuration")
+		}
+		if verifyManagementHandle(handle, sid, directory) != nil {
+			return ErrManagement
+		}
+	}
+	info, e := result.file.Stat()
+	if e != nil || info.Size() < 1 || info.Size() > managementLimit {
+		return ErrManagement
+	}
+	return nil
+}
