+)
+
+type proxyGuestFixture struct {
+	observeFailure error
+	before         func()
+	failure        error
+	calls          []networkproxy.GuestTransaction
+	identity       networkproxy.GuestIdentity
+	hash           string
+}
+
+func (g *proxyGuestFixture) ObserveIdentity(context.Context, *lima.LimaVM) (networkproxy.GuestIdentity, error) {
+	return g.identity, g.observeFailure
+}
+func (g *proxyGuestFixture) ApplyOrObserve(_ context.Context, tx networkproxy.GuestTransaction) (networkproxy.GuestTransactionReceipt, error) {
+	g.calls = append(g.calls, tx)
+	if g.before != nil {
+		g.before()
+	}
+	return networkproxy.GuestTransactionReceipt{ID: tx.ID, Plan: tx.Plan, Identity: tx.Identity, ConfigSHA256: g.hash, RuntimeConfigSHA256: g.hash, Applied: true, Disposition: "compatibility", SettlementSHA256: strings.Repeat("a", 64)}, g.failure
+}
+func proxyControllerFixture(t *testing.T, mode string) (*AppReconciler, *app.App, *lima.LimaVM, *proxyGuestFixture) {
+	t.Helper()
+	yes := true
+	owner := &app.App{ObjectMeta: metav1.ObjectMeta{Name: "app", UID: "app-one", Generation: 1, ResourceVersion: "1"}}
+	owner.Spec.Running = true
+	if mode != "absent" {
+		owner.Spec.NetworkProxy = &app.NetworkProxySpec{Version: 1, Mode: mode, NoProxy: []string{}}
+		if mode == "url" {
+			owner.Spec.NetworkProxy.URL = "http://proxy.example:8080"
+		}
+	}
+	owner.Status.Conditions = []metav1.Condition{{Type: "OtherOwnerReady", Status: metav1.ConditionTrue, Reason: "Ready", Message: "preserve", LastTransitionTime: metav1.Now()}}
+	vm := &lima.LimaVM{ObjectMeta: metav1.ObjectMeta{Name: "orbwin", Namespace: owner.GetResourceNamespace(), UID: "lima-one", ResourceVersion: "1", OwnerReferences: []metav1.OwnerReference{{APIVersion: app.GroupVersion.String(), Kind: "App", Name: owner.Name, UID: owner.UID, Controller: &yes}}}}
+	vm.Spec.Running = true
+	vm.Status.NetworkProxyLaunch = &lima.NetworkProxyLaunchObservation{AppUID: string(owner.UID), LimaVMUID: string(vm.UID), HostPID: 123, HostCreationTime: "0000000000000001", TransportEpoch: strings.Repeat("1", 32), Session: 1}
+	scheme := runtime.NewScheme()
+	if err := app.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	if err := lima.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	c := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(&app.App{}, &lima.LimaVM{}).WithObjects(owner, vm).Build()
+	guest := &proxyGuestFixture{identity: networkproxy.GuestIdentity{RegistrationGUID: "{11111111-1111-1111-1111-111111111111}", MachineID: strings.Repeat("a", 32), DaemonID: "owned"}}
+	change, err := networkproxy.PrepareGuestChange(networkproxy.Config{Version: 1, Mode: "url", URL: "http://proxy.example:8080", NoProxy: []string{}}, guest.identity, networkproxy.GuestObservation{Identity: guest.identity}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	guest.hash = change.AfterSHA256
+	r := &AppReconciler{Client: c, ProxyAPIReader: c, ProxyGuest: guest, ProxyObserve: func(_ context.Context, a *app.App, v *lima.LimaVM, receipt *lima.NetworkProxyLaunchObservation) (app.NetworkProxyBinding, error) {
+		return networkproxy.LaunchBinding(a, v, receipt)
+	}}
+	return r, owner, vm, guest
+}
+func proxyRead(t *testing.T, r *AppReconciler) *app.App {
+	t.Helper()
+	a := &app.App{}
+	if err := r.Get(context.Background(), client.ObjectKey{Name: "app"}, a); err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+func proxyPass(t *testing.T, r *AppReconciler, a *app.App, vm *lima.LimaVM) {
+	t.Helper()
+	if err := r.reconcileNetworkProxy(context.Background(), a, vm); err != nil {
+		t.Fatal(err)
+	}
+}
+func proxyAck(t *testing.T, r *AppReconciler, phase string) {
+	t.Helper()
+	a := proxyRead(t, r)
+	zero := int32(0)
+	a.Status.NetworkProxyHost = &app.NetworkProxyHostStatus{Plan: *a.Status.NetworkProxy.Plan, Phase: phase, Reason: "Ready", ActiveStreams: &zero, DrainingGenerations: &zero}
+	if err := r.Status().Update(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+}
+func proxyPrepare(t *testing.T, r *AppReconciler, a *app.App, vm *lima.LimaVM) {
+	proxyPass(t, r, a, vm)
+	proxyPass(t, r, a, vm)
+	proxyAck(t, r, "prepared")
+	proxyPass(t, r, a, vm) // Persist possible-mutation history before any adapter call.
+}
+
+func TestProxyControllerURLPrepareGuestCommitAndNoneCompatibility(t *testing.T) {
+	r, a, vm, g := proxyControllerFixture(t, "url")
+	proxyPrepare(t, r, a, vm)
+	before := proxyRead(t, r)
+	if before.Status.NetworkProxy.GuestAppliedRevision != 0 {
+		t.Fatal("host ack pretended guest applied")
+	}
+	proxyPass(t, r, a, vm)
+	current := proxyRead(t, r)
+	if len(g.calls) != 1 || current.Status.NetworkProxy.Plan.Phase != "commit" || !current.Status.NetworkProxy.ManagedEver || current.Status.NetworkProxy.GuestAppliedRevision != 1 {
+		t.Fatal("guest receipt not committed")
+	}
+	proxyAck(t, r, "active")
+	proxyPass(t, r, a, vm)
+	current = proxyRead(t, r)
+	if !apimeta.IsStatusConditionTrue(current.Status.Conditions, conditionNetworkProxyReady) || !apimeta.IsStatusConditionTrue(current.Status.Conditions, "OtherOwnerReady") {
+		t.Fatal("owned ready/foreign condition lost")
+	}
+	plan := *current.Status.NetworkProxy.Plan
+	current.Generation++
+	current.Spec.VirtualMachine.CPUs = 6
+	if err := r.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	proxyPass(t, r, a, vm)
+	proxyPass(t, r, a, vm)
+	if len(g.calls) != 1 || *proxyRead(t, r).Status.NetworkProxy.Plan != plan {
+		t.Fatal("CPU change restarted/revised proxy guest")
+	}
+	current = proxyRead(t, r)
+	current.Generation++
+	current.Spec.NetworkProxy = &app.NetworkProxySpec{Version: 1, Mode: "none", NoProxy: []string{}}
+	if err := r.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	proxyPass(t, r, a, vm)
+	proxyPass(t, r, a, vm)
+	current = proxyRead(t, r)
+	if current.Status.NetworkProxy.Plan.Phase != "disable" || current.Status.NetworkProxy.GuestAppliedRevision != 0 {
+		t.Fatal("none did not await direct and guest ack")
+	}
+	proxyAck(t, r, "direct")
+	proxyPass(t, r, a, vm)
+	proxyPass(t, r, a, vm)
+	current = proxyRead(t, r)
+	if len(g.calls) != 2 || g.calls[1].Mode != "none" || current.Status.NetworkProxy.GuestAppliedRevision != 2 || !apimeta.IsStatusConditionTrue(current.Status.Conditions, conditionNetworkProxyReady) {
+		t.Fatal("managed none compatibility ack incomplete")
+	}
+	if current.Status.NetworkProxyHost.Phase != "direct" {
+		t.Fatal("controller overwrote host status")
+	}
+}
