+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// Native fixture, compile-only until separately reviewed. It touches only a
+// fresh synthetic directory and never reads actual management credentials.
+func TestServingAnchorReopenWithInheritedLeaseAlive(t *testing.T) {
+	if os.Getenv("ORBWIN_QUALIFY_SERVING_ANCHOR") != "1" {
+		t.Skip("fresh native anchor qualification requires explicit review")
+	}
+	parent, _, sid := fixture(t)
+	fresh, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer fresh.Close()
+	if transfer, err := fresh.PrepareServingAnchorInheritance(); transfer != nil || err != ErrCreate {
+		if transfer != nil {
+			transfer.Close()
+		}
+		t.Fatal("exclusive creation object entered production serving handoff")
+	}
+	want, err := anchorIdentity(fresh.anchor)
+	if err != nil || fresh.Close() != nil {
+		t.Fatal("fresh owner retirement")
+	}
+	// This reproduces OpenInitialized's retained read/open-existing path. It is
+	// a private fixture seam, not a production raw handle or path constructor.
+	h, err := openRelative(parent.leaf(), anchorName, true, nil, false)
+	if err != nil || verifyPrivate(h, sid, true) != nil {
+		t.Fatal("shareable serving open")
+	}
+	parents, err := parent.retain()
+	if err != nil {
+		windows.CloseHandle(h)
+		t.Fatal(err)
+	}
+	serving := &Created{parents: parents, parent: parents.leaf(), anchor: h, servingLease: true}
+	defer serving.Close()
+	transfer, err := serving.PrepareServingAnchorInheritance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transfer.Close()
+	if serving.Close() != nil {
+		t.Fatal("prior serving owner retirement")
+	}
+	// The inherited read-only file object remains live. A fresh backend owner
+	// must nevertheless reopen the same exact directory without a path fallback.
+	reopened, err := openRelative(parent.leaf(), anchorName, true, nil, false)
+	if err != nil {
+		t.Fatal("retained inheritance prevented new service authority open")
+	}
+	defer windows.CloseHandle(reopened)
+	if got, err := anchorIdentity(reopened); err != nil || got != want {
+		t.Fatal("selected anchor identity changed")
+	}
+}
diff --git a/rdd/pkg/networkproxy/bounded_auto.go b/rdd/pkg/networkproxy/bounded_auto.go
new file mode 100644
index 0000000..819527f
--- /dev/null
+++ b/rdd/pkg/networkproxy/bounded_auto.go
@@ -0,0 +1,329 @@
+package networkproxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/url"
+	"sync"
+	"time"
+)
+
+var errAutoChild = errors.New("bounded automatic proxy worker unavailable")
+
+const autoPacketLimit = 32 << 10
+
+// Read-only preparation has a real resource boundary too. Preserve a failed
+// lease close without retry, GC finalization, child startup or guest admission.
+type autoImageAdmission struct {
+	mu       sync.Mutex
+	probe    func(context.Context) (io.Closer, error)
+	unknown  bool
+	retained io.Closer
+}
+
+func (a *autoImageAdmission) blocked() bool { a.mu.Lock(); defer a.mu.Unlock(); return a.unknown }
+func (a *autoImageAdmission) check(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil || !a.mu.TryLock() {
+		return errAutoChild
+	}
+	defer a.mu.Unlock()
+	if a.unknown {
+		return ErrProxyRetirement
+	}
+	lease, err := a.probe(ctx)
+	if errors.Is(err, ErrProxyRetirement) {
+		a.unknown = true
+		a.retained = lease
+		return ErrProxyRetirement
+	}
+	if lease != nil {
+		if lease.Close() != nil {
+			a.unknown = true
+			a.retained = lease
+			return ErrProxyRetirement
+		}
+	}
+	if err != nil || lease == nil || ctx.Err() != nil {
+		return errAutoChild
+	}
+	return nil
+}
+
+type autoRequest struct {
+	Version   int    `json:"version"`
+	Sequence  uint64 `json:"sequence"`
+	Operation string `json:"operation"`
+	URL       string `json:"url"`
+}
+type autoResponse struct {
+	Version  int     `json:"version"`
+	Sequence uint64  `json:"sequence"`
+	OK       bool    `json:"ok"`
+	Routes   []Route `json:"routes"`
+}
+
+func writeAutoPacket(w io.Writer, value any) error {
+	data, err := json.Marshal(value)
+	if err != nil || len(data) < 1 || len(data) > autoPacketLimit {
+		return errAutoChild
+	}
+	var header [4]byte
+	binary.BigEndian.PutUint32(header[:], uint32(len(data)))
+	for _, data := range [][]byte{header[:], data} {
+		for len(data) > 0 {
+			n, e := w.Write(data)
+			if e != nil || n < 1 || n > len(data) {
+				return errAutoChild
+			}
+			data = data[n:]
+		}
+	}
+	return nil
+}
+func readAutoPacket(r io.Reader, value any) error {
+	var header [4]byte
+	if _, err := io.ReadFull(r, header[:]); err != nil {
+		return errAutoChild
+	}
+	n := binary.BigEndian.Uint32(header[:])
+	if n < 1 || n > autoPacketLimit {
+		return errAutoChild
+	}
+	data := make([]byte, n)
+	if _, err := io.ReadFull(r, data); err != nil {
+		return errAutoChild
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(value) != nil {
+		return errAutoChild
+	}
+	canonical, err := json.Marshal(value)
+	if err != nil || !bytes.Equal(data, canonical) {
+		return errAutoChild
+	}
+	return nil
+}
+
+// One controlled child per generation; exactly one outstanding framed request.
+// Context expiry poisons this worker and retires its process, never retries a
+// PAC operation or silently creates a replacement. Unknown startup/kill/pipe/Wait
+// joins retain this generation resource under the existing supervisor budget.
+type autoChildProcess interface {
+	Input() io.Writer
+	Output() io.Reader
+	ClosePipes() error
+	Kill() error
+	Wait() error
+}
+type boundedAuto struct {
+	mu                                   sync.Mutex
+	request                              sync.Mutex
+	child                                autoChildProcess
+	startErr                             error
+	started, waited, killed, pipesClosed chan struct{}
+	ioDone                               chan struct{}
+	closing                              bool
+	pipeErr, waitErr                     error
+	stopOnce                             sync.Once
+	sequence                             uint64
+	stopLifetime                         func() bool
+}
+
+func startBoundedAuto(startup, lifetime context.Context, launch func() (autoChildProcess, error)) (*boundedAuto, error) {
+	if startup == nil || lifetime == nil || startup.Err() != nil || lifetime.Err() != nil || launch == nil {
+		return nil, errAutoChild
+	}
+	w := &boundedAuto{started: make(chan struct{}), waited: make(chan struct{}), killed: make(chan struct{}), pipesClosed: make(chan struct{})}
+	w.ioDone = make(chan struct{})
+	close(w.ioDone)
+	w.stopLifetime = context.AfterFunc(lifetime, func() { w.beginClose() })
+	go func() {
+		child, err := launch()
+		w.mu.Lock()
+		w.child, w.startErr = child, err
+		closing := w.closing
+		w.mu.Unlock()
+		if child != nil {
+			go func() { err := child.Wait(); w.mu.Lock(); w.waitErr = err; w.mu.Unlock(); close(w.waited) }()
+		}
+		close(w.started)
+		if child == nil {
+			close(w.waited)
+		}
+		if closing {
+			w.beginClose()
+		}
+	}()
+	select {
+	case <-w.started:
+		w.mu.Lock()
+		bad := w.startErr != nil || w.child == nil || w.closing
+		w.mu.Unlock()
+		if bad {
+			w.beginClose()
+			return w, errAutoChild
+		}
+	case <-startup.Done():
+		w.beginClose()
+		return w, errAutoChild
+	}
+	if _, err := w.exchange(startup, "capture", ""); err != nil {
+		return w, err
+	}
+	return w, nil
+}
+func (w *boundedAuto) beginClose() {
+	w.mu.Lock()
+	w.closing = true
+	child := w.child
+	w.mu.Unlock()
+	if child == nil {
+		select {
+		case <-w.started:
+			w.stopOnce.Do(func() { close(w.killed); close(w.pipesClosed) })
+		default:
+		}
+		return
+	}
+	w.stopOnce.Do(func() {
+		// Kill and pipe close are independently owned: a blocked Close must not
+		// prevent process termination. Both joins are required for retirement.
+		go func() { _ = child.Kill(); close(w.killed) }()
+		go func() { err := child.ClosePipes(); w.mu.Lock(); w.pipeErr = err; w.mu.Unlock(); close(w.pipesClosed) }()
+	})
+}
+func (w *boundedAuto) Close(ctx context.Context) error {
+	if ctx == nil {
+		return ErrProxyRetirement
+	}
+	w.beginClose()
+	for _, done := range []<-chan struct{}{w.started, w.killed, w.pipesClosed, w.waited} {
+		select {
+		case <-done:
+		case <-ctx.Done():
+			return ErrProxyRetirement
+		}
+	}
+	w.mu.Lock()
+	ioDone := w.ioDone
+	w.mu.Unlock()
+	select {
+	case <-ioDone:
+	case <-ctx.Done():
+		return ErrProxyRetirement
+	}
+	w.mu.Lock()
+	pipeErr, waitErr := w.pipeErr, w.waitErr
+	w.mu.Unlock()
+	if pipeErr != nil || waitErr != nil {
+		return ErrProxyRetirement
+	}
+	if w.stopLifetime != nil {
+		w.stopLifetime()
+	}
+	return nil
+}
+func (w *boundedAuto) exchange(ctx context.Context, operation, target string) ([]Route, error) {
+	if ctx == nil || ctx.Err() != nil || !w.request.TryLock() {
+		return nil, errAutoChild
+	}
+	defer w.request.Unlock()
+	w.mu.Lock()
+	if w.closing || w.child == nil || w.sequence == ^uint64(0) {
+		w.mu.Unlock()
+		return nil, errAutoChild
+	}
+	w.sequence++
+	sequence := w.sequence
+	child := w.child
+	done := make(chan struct{})
+	w.ioDone = done
+	w.mu.Unlock()
+	var response autoResponse
+	var wireErr error
+	go func() {
+		defer close(done)
+		wireErr = writeAutoPacket(child.Input(), autoRequest{1, sequence, operation, target})
+		if wireErr == nil {
+			wireErr = readAutoPacket(child.Output(), &response)
+		}
+	}()
+	limited, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	select {
+	case <-done:
+		if limited.Err() != nil || wireErr != nil || response.Version != 1 || response.Sequence != sequence || !response.OK ||
+			(operation == "capture" && len(response.Routes) != 0) || len(response.Routes) > 8 {
+			w.beginClose()
+			return nil, errAutoChild
+		}
+		if operation == "resolve" && len(response.Routes) == 0 {
+			w.beginClose()
+			return nil, errAutoChild
+		}
+		return response.Routes, nil
+	case <-limited.Done():
+		w.beginClose()
+		return nil, errAutoChild
+	}
+}
+func (w *boundedAuto) Resolve(ctx context.Context, target *url.URL) ([]Route, error) {
+	if validateTarget(target) != nil || len(target.String()) > 8192 {
+		return nil, errAutoChild
+	}
+	return w.exchange(ctx, "resolve", target.String())
+}
+
+// Worker owns native calls synchronously. The parent process owns the deadline
+// and actual process retirement; no native callback can outlive a joined child.
+func runAutoWorkerProtocol(input io.Reader, output io.Writer, resolver interface {
+	Capture(context.Context) error
+	Resolve(context.Context, *url.URL) ([]Route, error)
+	Close(context.Context) error
+}) error {
+	var sequence uint64
+	for {
+		var request autoRequest
+		if readAutoPacket(input, &request) != nil {
+			return errAutoChild
+		}
+		if request.Version != 1 || request.Sequence != sequence+1 || sequence == ^uint64(0) {
+			return errAutoChild
+		}
+		sequence = request.Sequence
+		var routes []Route
+		var err error
+		ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+		if sequence == 1 && request.Operation == "capture" && request.URL == "" {
+			err = resolver.Capture(ctx)
+		} else if sequence > 1 && request.Operation == "resolve" {
+			target, parseErr := url.Parse(request.URL)
+			if parseErr != nil || len(request.URL) > 8192 || validateTarget(target) != nil {
+				cancel()
+				return errAutoChild
+			}
+			routes, err = resolver.Resolve(ctx, target)
+		} else {
+			cancel()
+			return errAutoChild
+		}
+		if ctx.Err() != nil {
+			err = errAutoChild
+		}
+		cancel()
+		if len(routes) > 8 || sequence > 1 && len(routes) == 0 {
+			err = errAutoChild
+		}
+		if err != nil {
+			routes = nil
+		}
+		if writeAutoPacket(output, autoResponse{1, sequence, err == nil, routes}) != nil || err != nil {
+			return errAutoChild
+		}
+	}
+}
