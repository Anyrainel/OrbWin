+	gate, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal("synthetic parent pipe")
+	}
+	var output bytes.Buffer
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+	if cmd.Start() != nil {
+		t.Fatal("synthetic child start")
