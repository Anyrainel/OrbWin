+func TestPrivateTransportMaterialOwnershipAndLifetime(t *testing.T) {
+	p := privateFixture(t)
+	files := p.Files()
+	server, err := tls.X509KeyPair(files.ServerCertificate, files.ServerKey)
+	if err != nil {
+		t.Fatal("server material", err)
+	}
+	leaf, err := x509.ParseCertificate(server.Certificate[0])
+	if err != nil || leaf.IsCA || len(leaf.IPAddresses) != 1 || !leaf.IPAddresses[0].Equal(net.IPv4(127, 0, 0, 1)) || len(leaf.ExtKeyUsage) != 1 || leaf.ExtKeyUsage[0] != x509.ExtKeyUsageServerAuth {
+		t.Fatal("server scope differs")
+	}
+	files.ServerKey[0] ^= 1
+	if _, err := tls.X509KeyPair(p.Files().ServerCertificate, p.Files().ServerKey); err != nil {
+		t.Fatal("exported material mutated internal state")
+	}
+	for _, formatted := range []string{fmt.Sprintf("%v", files), fmt.Sprintf("%#v", files)} {
+		if strings.Contains(formatted, "PRIVATE KEY") || formatted != "[private datastore material]" {
+			t.Fatal("formatted secret material")
+		}
+	}
+	encoded, err := json.Marshal(files)
+	if err != nil || string(encoded) != "{}" {
+		t.Fatal("serialized private material")
+	}
+	now := time.Now()
+	for _, until := range []time.Time{{}, now, now.Add(30 * time.Second), now.Add(366 * 24 * time.Hour)} {
+		if _, err := NewPrivateTransport(now, until); err == nil {
+			t.Fatal("unbounded/invalid lifetime admitted")
+		}
+	}
+}
