+// The current test executable is the only child. No SSH, native registration,
+// API or systemd invocation. os.Exit avoids test-runner text in protocol stdout.
+func TestProxyGuestExchangeSyntheticChild(t *testing.T) {
+	mode := os.Getenv("ORBWIN_PROXY_GUEST_EXCHANGE_FIXTURE")
+	if mode == "" {
+		return
+	}
+	var message protocol.Message
+	if protocol.ReadFrame(bufio.NewReaderSize(os.Stdin, protocol.MaxFrame+1), &message) != nil || message.Operation != "observe" {
+		os.Exit(2)
+	}
+	result := protocol.MessageResult{Schema: 1, Reason: "Ready", Identity: &protocol.IdentityObservation{MachineID: strings.Repeat("a", 32), DaemonID: "owned", HelperSHA256: strings.Repeat("b", 64)}}
+	if mode == "invalid" {
+		result.Identity.MachineID = "malformed"
+	}
+	if mode == "oversize" {
+		_, _ = os.Stdout.Write([]byte(strings.Repeat("x", protocol.MaxFrame+1)))
+		os.Exit(0)
+	}
+	if protocol.WriteFrame(os.Stdout, result) != nil {
+		os.Exit(2)
+	}
+	if mode == "extra" {
+		_, _ = os.Stdout.Write([]byte("extra\n"))
+	}
+	if mode == "pending" {
+		if os.WriteFile(os.Getenv("ORBWIN_PROXY_GUEST_EXCHANGE_READY"), []byte{'R'}, 0600) != nil {
+			os.Exit(2)
+		}
+		time.Sleep(10 * time.Second)
+	}
+	os.Exit(0)
+}
+func TestProxyGuestExchangeNativeChildBoundsMalformedAndCancelledResults(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"valid", "invalid", "extra", "oversize", "pending"} {
+		t.Run(mode, func(t *testing.T) {
+			home := t.TempDir()
+			ready := filepath.Join(home, "ready")
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, exe, "-test.run=^TestProxyGuestExchangeSyntheticChild$", "-test.timeout=2s")
+			cmd.Env = []string{"ORBWIN_PROXY_GUEST_EXCHANGE_FIXTURE=" + mode, "ORBWIN_PROXY_GUEST_EXCHANGE_READY=" + ready, "USERPROFILE=" + home, "HOME=" + home, "SystemRoot=" + os.Getenv("SystemRoot")}
+			var pending atomic.Bool
+			monitorDone := make(chan struct{})
+			if mode == "pending" {
+				go func() {
+					defer close(monitorDone)
+					tick := time.NewTicker(5 * time.Millisecond)
+					defer tick.Stop()
+					for {
+						select {
+						case <-ctx.Done():
+							return
+						case <-tick.C:
+							if data, err := os.ReadFile(ready); err == nil && string(data) == "R" {
+								pending.Store(true)
+								cancel()
+								return
+							}
+						}
+					}
+				}()
+			} else {
+				close(monitorDone)
+			}
+			result, err := exchangeProxyGuest(ctx, cmd, protocol.Message{Schema: 1, Operation: "observe"})
+			cancel()
+			<-monitorDone
+			if mode == "valid" {
+				if err != nil || result.Identity == nil || !result.Identity.Valid() {
+					t.Fatal("controlled valid child failed")
+				}
+			} else {
+				if err == nil || result.Schema != 0 {
+					t.Fatal("malformed/cancelled result escaped")
+				}
+			}
+			if cmd.ProcessState == nil {
+				t.Fatal("owned native child not reaped")
+			}
+			if mode == "pending" && !pending.Load() {
+				t.Fatal("cancellation did not observe original entered child")
+			}
+		})
+	}
+}
