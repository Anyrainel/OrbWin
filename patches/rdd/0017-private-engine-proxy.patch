@@ -0,0 +1,43 @@
+package controllers
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+func (r *LimaVMReconciler) startHostagentWithProxy(ctx context.Context, cmd *exec.Cmd, vm *lima.LimaVM) (*lima.NetworkProxyLaunchObservation, error) {
+	if r.ProxyServing == nil || instance.Suffix() != "orbwin" {
+		return nil, cmd.Start()
+	}
+	// This client belongs to the embedded manager initialized from in-memory
+	// LoopbackClientConfig. No disk credential or second desired-state poller.
+	var owner app.App
+	probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	if r.Client == nil || r.Get(probe, types.NamespacedName{Name: "app"}, &owner) != nil {
+		log.FromContext(ctx).Info("Proxy binding refused; hostagent networking continues")
+		return nil, cmd.Start()
+	}
+	// A qualified hostagent receives its standby binding on initial launch too.
+	// The single consumer can then observe a later nil/None -> URL transition
+	// without requiring a VM restart. Standby does not enable Auto capture.
+	home, err := os.UserHomeDir()
+	if err != nil {
+		log.FromContext(ctx).Info("Proxy binding refused; hostagent networking continues")
+		return nil, cmd.Start()
+	}
+	receipt, err := networkproxy.StartHostagentObserved(probe, cmd, r.ProxyServing, &owner, vm, networkproxy.ManagementInstanceRoot{Home: home, Suffix: "orbwin"})
+	if receipt == nil && err == nil {
+		log.FromContext(ctx).Info("Proxy binding refused; hostagent networking continues")
+	}
+	return receipt, err
+}
diff --git a/rdd/pkg/controllers/lima/limavm/controllers/proxy_observation.go b/rdd/pkg/controllers/lima/limavm/controllers/proxy_observation.go
new file mode 100644
index 0000000..5ad682a
--- /dev/null
+++ b/rdd/pkg/controllers/lima/limavm/controllers/proxy_observation.go
@@ -0,0 +1,68 @@
+package controllers
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+// One attempt inside the existing reconcile. No second watcher, poller, launch,
+// status replay or networking cancellation. On rejoin the authenticated retained
+// observation is usable only after native creation/owner/session re-observation.
+func (r *LimaVMReconciler) syncProxyLaunch(ctx context.Context, vm *lima.LimaVM) error {
+	probe, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	var candidate *lima.NetworkProxyLaunchObservation
+	if vm.Status.NetworkProxyLaunch != nil {
+		copy := *vm.Status.NetworkProxyLaunch
+		candidate = &copy
+	}
+	r.instanceStatesMu.RLock()
+	state := r.instanceStates[vm.Name]
+	r.instanceStatesMu.RUnlock()
+	if state != nil {
+		state.mu.RLock()
+		candidate = nil
+		if state.proxyLaunch != nil {
+			copy := *state.proxyLaunch
+			candidate = &copy
+		}
+		if state.phase == phaseStopped {
+			candidate = nil
+		}
+		select {
+		case <-state.procExited:
+			candidate = nil
+		default:
+		}
+		state.mu.RUnlock()
+	}
+	if candidate != nil {
+		var owner app.App
+		if r.Get(probe, types.NamespacedName{Name: "app"}, &owner) != nil {
+			return networkproxy.ErrProxyOwner
+		}
+		if _, err := networkproxy.ObserveProxyLaunch(probe, &owner, vm, candidate); err != nil {
+			candidate = nil
+		}
+	}
+	if reflect.DeepEqual(candidate, vm.Status.NetworkProxyLaunch) {
+		return nil
+	}
+	patch, err := json.Marshal([]map[string]any{
+		{"op": "test", "path": "/metadata/uid", "value": string(vm.UID)},
+		{"op": "test", "path": "/metadata/resourceVersion", "value": vm.ResourceVersion},
+		{"op": "add", "path": "/status/networkProxyLaunch", "value": candidate},
+	})
+	if err != nil {
+		return networkproxy.ErrProxyOwner
+	}
+	return r.Status().Patch(probe, vm, client.RawPatch(types.JSONPatchType, patch), client.FieldValidation("Strict"))
+}
diff --git a/rdd/pkg/controllers/lima/limavm/controllers/proxy_observation_windows_test.go b/rdd/pkg/controllers/lima/limavm/controllers/proxy_observation_windows_test.go
