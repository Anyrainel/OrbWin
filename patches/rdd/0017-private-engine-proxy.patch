@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package datastore
+
+// PrivateTransport is source preparation for the existing embedded kine owner,
+// not a second datastore or listener. Each owner gets a fresh CA and distinct
+// server/client keys. CA signing material is discarded after issuance. Only the
+// exact issued peers are accepted, in addition to normal chain/EKU/name checks.
+//
+// The owner must publish Files exclusively through its protected db/kine file
+// capability before starting kine or apiserver, keep that capability for their
+// complete lifetime, and settle both users before replacing/removing the files.
+// Expiry is explicit: callers must arrange renewal or a visible unavailable
+// state before it; this helper does not provide hot rotation or lifecycle hooks.
+// No production call site currently enables this transport.
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"math/big"
+	"net"
+	"time"
+
+	"go.etcd.io/etcd/server/v3/embed"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/keepalive"
+)
+
+type PrivateTransport struct {
+	server, client *tls.Config
+	// Indirection also avoids raw-slice traversal when fmt encounters this owner
+	// through an unexported embedding where String/GoString are not invoked.
+	files   *PrivateTransportFiles
+	expires time.Time
+}
+
+func (PrivateTransport) String() string               { return "[private datastore transport]" }
+func (PrivateTransport) GoString() string             { return "[private datastore transport]" }
+func (PrivateTransport) MarshalJSON() ([]byte, error) { return []byte("{}"), nil }
+
+// PrivateTransportFiles contains secrets. It is never suitable for logging,
+// snapshots, AppSpec, kubeconfig, arbitrary caller paths or public receipts.
+// The fixed authority publisher owns these five roles; no CA private key exists.
+type PrivateTransportFiles struct {
+	CA, ServerCertificate, ServerKey, ClientCertificate, ClientKey []byte `json:"-"`
+}
+
+func (PrivateTransportFiles) String() string               { return "[private datastore material]" }
+func (PrivateTransportFiles) GoString() string             { return "[private datastore material]" }
+func (PrivateTransportFiles) MarshalJSON() ([]byte, error) { return []byte("{}"), nil }
+
+func transportSerial() (*big.Int, error) {
+	limit := new(big.Int).Lsh(big.NewInt(1), 128)
+	limit.Sub(limit, big.NewInt(1))
+	n, err := rand.Int(rand.Reader, limit)
+	if err != nil {
+		return nil, errors.New("private datastore serial generation failed")
+	}
+	return n.Add(n, big.NewInt(1)), nil
+}
+
+func NewPrivateTransport(now, expires time.Time) (*PrivateTransport, error) {
+	now, expires = now.UTC().Truncate(time.Second), expires.UTC().Truncate(time.Second)
+	if now.IsZero() || expires.Before(now.Add(time.Minute)) || expires.After(now.Add(365*24*time.Hour)) {
+		return nil, errors.New("private datastore certificate lifetime must be explicit and bounded")
+	}
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		return nil, errors.New("private datastore authority generation failed")
+	}
+	serial, err := transportSerial()
+	if err != nil {
+		return nil, err
+	}
+	caTemplate := &x509.Certificate{
+		SerialNumber: serial, Subject: pkix.Name{CommonName: "OrbWin private kine authority"},
+		NotBefore: now.Add(-time.Minute), NotAfter: expires,
+		IsCA: true, BasicConstraintsValid: true, MaxPathLenZero: true,
+		KeyUsage: x509.KeyUsageCertSign,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTemplate, caTemplate, &caKey.PublicKey, caKey)
+	if err != nil {
+		return nil, errors.New("private datastore authority issuance failed")
+	}
+	ca, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		return nil, errors.New("private datastore authority parsing failed")
+	}
+	issue := func(server bool) (tls.Certificate, []byte, []byte, error) {
+		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			return tls.Certificate{}, nil, nil, errors.New("private datastore peer key generation failed")
+		}
+		serial, err := transportSerial()
+		if err != nil {
+			return tls.Certificate{}, nil, nil, err
+		}
+		template := &x509.Certificate{
+			SerialNumber: serial, Subject: pkix.Name{CommonName: "OrbWin private kine client"},
+			NotBefore: now.Add(-time.Minute), NotAfter: expires,
+			BasicConstraintsValid: true, KeyUsage: x509.KeyUsageDigitalSignature,
+			ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},
+		}
+		if server {
+			template.Subject.CommonName = "OrbWin private kine server"
+			template.ExtKeyUsage = []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}
+			template.IPAddresses = []net.IP{net.IPv4(127, 0, 0, 1)}
+		}
+		der, err := x509.CreateCertificate(rand.Reader, template, ca, &key.PublicKey, caKey)
+		if err != nil {
+			return tls.Certificate{}, nil, nil, errors.New("private datastore peer issuance failed")
+		}
+		keyDER, err := x509.MarshalPKCS8PrivateKey(key)
+		if err != nil {
+			return tls.Certificate{}, nil, nil, errors.New("private datastore key encoding failed")
+		}
+		certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+		keyPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER})
+		cert, err := tls.X509KeyPair(certPEM, keyPEM)
+		if err != nil {
+			return tls.Certificate{}, nil, nil, errors.New("private datastore key pair validation failed")
+		}
+		return cert, certPEM, keyPEM, nil
+	}
+	server, serverPEM, serverKeyPEM, err := issue(true)
+	if err != nil {
+		return nil, err
+	}
+	client, clientPEM, clientKeyPEM, err := issue(false)
+	if err != nil {
+		return nil, err
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(ca)
+	pinned := func(der []byte) func(tls.ConnectionState) error {
+		want := sha256.Sum256(der)
+		return func(state tls.ConnectionState) error {
+			if len(state.VerifiedChains) == 0 || len(state.PeerCertificates) != 1 || sha256.Sum256(state.PeerCertificates[0].Raw) != want {
+				return errors.New("private datastore peer identity differs")
+			}
+			return nil
+		}
+	}
+	return &PrivateTransport{
+		server: &tls.Config{
+			MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{server},
+			ClientAuth: tls.RequireAndVerifyClientCert, ClientCAs: pool,
+			VerifyConnection: pinned(client.Certificate[0]), SessionTicketsDisabled: true,
+		},
+		client: &tls.Config{
+			MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{client},
+			RootCAs: pool, ServerName: "127.0.0.1", VerifyConnection: pinned(server.Certificate[0]),
+		},
+		files: &PrivateTransportFiles{CA: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: caDER}),
+			ServerCertificate: serverPEM, ServerKey: serverKeyPEM, ClientCertificate: clientPEM, ClientKey: clientKeyPEM},
+		expires: expires,
+	}, nil
+}
+
+func cloneTransportConfig(source *tls.Config, caPEM, certPEM, keyPEM []byte) (*tls.Config, error) {
+	// TLS Config.Clone is shallow. Reparse all exported certificate/key state
+	// and trust anchors, including parsed Leaf and CertPool.Subjects bytes.
+	cert, err := tls.X509KeyPair(certPEM, keyPEM)
+	if err != nil {
+		return nil, errors.New("private datastore key pair unavailable")
+	}
+	cert.Leaf, err = x509.ParseCertificate(cert.Certificate[0])
+	if err != nil {
+		return nil, errors.New("private datastore certificate unavailable")
+	}
+	config := source.Clone()
+	config.Certificates = []tls.Certificate{cert}
+	pool := func() (*x509.CertPool, error) {
+		p := x509.NewCertPool()
+		if !p.AppendCertsFromPEM(caPEM) {
+			return nil, errors.New("private datastore authority unavailable")
+		}
+		return p, nil
+	}
+	if source.RootCAs != nil {
+		config.RootCAs, err = pool()
+		if err != nil {
+			return nil, err
+		}
+	}
+	if source.ClientCAs != nil {
+		config.ClientCAs, err = pool()
+		if err != nil {
+			return nil, err
+		}
+	}
+	return config, nil
+}
+
+func (p *PrivateTransport) ServerTLSConfig() (*tls.Config, error) {
+	if p == nil || p.files == nil || p.server == nil {
+		return nil, errors.New("private datastore transport unavailable")
+	}
+	return cloneTransportConfig(p.server, p.files.CA, p.files.ServerCertificate, p.files.ServerKey)
+}
+func (p *PrivateTransport) ClientTLSConfig() (*tls.Config, error) {
+	if p == nil || p.files == nil || p.client == nil {
+		return nil, errors.New("private datastore transport unavailable")
+	}
+	return cloneTransportConfig(p.client, p.files.CA, p.files.ClientCertificate, p.files.ClientKey)
+}
+func (p *PrivateTransport) Expires() time.Time { return p.expires }
+func (p *PrivateTransport) Files() PrivateTransportFiles {
+	return PrivateTransportFiles{
+		CA: append([]byte(nil), p.files.CA...), ServerCertificate: append([]byte(nil), p.files.ServerCertificate...),
+		ServerKey: append([]byte(nil), p.files.ServerKey...), ClientCertificate: append([]byte(nil), p.files.ClientCertificate...),
+		ClientKey: append([]byte(nil), p.files.ClientKey...),
+	}
+}
+
+// NewGRPCServer preserves pinned kine v1.14.2 keepalive defaults. The existing
+// endpoint.Listen owner must register/start/stop this server through GRPCServer.
+// Merely configuring kine.ServerTLSConfig would not require a client certificate.
+func (p *PrivateTransport) NewGRPCServer() (*grpc.Server, error) {
+	config, err := p.ServerTLSConfig()
+	if err != nil {
+		return nil, err
+	}
+	return grpc.NewServer(
+		grpc.KeepaliveEnforcementPolicy(keepalive.EnforcementPolicy{
+			MinTime: embed.DefaultGRPCKeepAliveMinTime, PermitWithoutStream: false,
+		}),
+		grpc.KeepaliveParams(keepalive.ServerParameters{
+			Time: embed.DefaultGRPCKeepAliveInterval, Timeout: embed.DefaultGRPCKeepAliveTimeout,
+		}),
+		grpc.Creds(credentials.NewTLS(config)),
+	), nil
+}
