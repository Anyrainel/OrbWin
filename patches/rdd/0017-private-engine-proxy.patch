diff --git a/rdd/pkg/hostagent/proxy_binding.go b/rdd/pkg/hostagent/proxy_binding.go
new file mode 100644
index 0000000..a07a105
--- /dev/null
+++ b/rdd/pkg/hostagent/proxy_binding.go
@@ -0,0 +1,57 @@
+package hostagent
+
+import (
+	"context"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"github.com/sirupsen/logrus"
+	"github.com/spf13/cobra"
+)
+
+// Duplicate/oversized flags refuse only proxy initialization. String always
+// redacts launch metadata; no token is present in the argument to begin with.
+type proxyBindingFlag struct {
+	value         string
+	seen, refused bool
+}
+
+func (*proxyBindingFlag) String() string { return "" }
+func (*proxyBindingFlag) Type() string   { return "private-launch-binding" }
+func (v *proxyBindingFlag) Set(s string) error {
+	if v.seen {
+		v.refused = true
+		return nil
+	}
+	v.seen = true
+	if len(s) < 1 || len(s) > 2048 {
+		v.refused = true
+		return nil
+	}
+	v.value = s
+	return nil
+}
+
+func openProxyBinding(ctx context.Context, cmd *cobra.Command) *networkproxy.HostagentManagement {
+	flag := cmd.Flags().Lookup("orbwin-proxy-binding")
+	if flag == nil {
+		return nil
+	}
+	value, ok := flag.Value.(*proxyBindingFlag)
+	if !ok || !value.seen {
+		return nil
+	}
+	if value.refused {
+		networkproxy.RetireHostagentLaunch(value.value)
+		logrus.Warn("Proxy management binding refused; hostagent networking continues")
+		return nil
+	}
+	probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	management, err := networkproxy.OpenHostagentManagement(probe, value.value)
+	if err != nil {
+		logrus.Warn("Proxy management binding refused; hostagent networking continues")
+		return nil
+	}
+	return management
+}
