@@ -0,0 +1,17 @@
+package networkproxy
+
+import "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+
+// Credential generations change independently of immutable HA/App/Lima policy
+// ownership. A token refresh cannot authorize a different certificate, endpoint,
+// interactive session or executable. Native image/liveness are checked by the
+// Windows caller after this public-record comparison and before token loading.
+func validateManagementRefresh(before, next managementconfig.ServiceGeneration, session uint32) error {
+	if before == next {
+		return ErrManagement
+	}
+	if next.Serving.Endpoint != before.Serving.Endpoint || next.Serving.Certificate != before.Serving.Certificate || next.Serving.Session != session || next.Image != before.Image {
+		return ErrProxyOwner
+	}
+	return nil
+}
