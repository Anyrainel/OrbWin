diff --git a/rdd/src/rdd-guest/proxy_transaction_test.go b/rdd/src/rdd-guest/proxy_transaction_test.go
new file mode 100644
index 0000000..b62bf6b
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_transaction_test.go
@@ -0,0 +1,171 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+)
+
+type proxyTestLease struct {
+	current protocol.Observation
+	journal *protocol.Journal
+	calls   atomic.Int32
+	entered chan struct{}
+	hold    bool
+}
+
+func (l *proxyTestLease) Acquire(context.Context) (protocol.Lease, error) {
+	l.calls.Add(1)
+	return l, nil
+}
+func (l *proxyTestLease) Close() error                                    { return nil }
+func (l *proxyTestLease) Load(context.Context) (*protocol.Journal, error) { return l.journal, nil }
+func (l *proxyTestLease) Persist(_ context.Context, j protocol.Journal) error {
+	copy := j
+	l.journal = &copy
+	return nil
+}
+func (l *proxyTestLease) Observe(ctx context.Context) (protocol.Observation, error) {
+	if l.hold {
+		close(l.entered)
+		<-ctx.Done()
+		return protocol.Observation{}, protocol.ErrUnavailable
+	}
+	return l.current, nil
+}
+func (l *proxyTestLease) Install(context.Context, protocol.Observation) error {
+	return protocol.ErrUnavailable
+}
+func (l *proxyTestLease) Restart(context.Context) error { return protocol.ErrUnavailable }
+func proxyFixtureRequest() protocol.Request {
+	r := protocol.Request{Schema: 1, Mode: "none", Owner: protocol.Owner{AppUID: "app-one", LimaUID: "vm-one", HostPID: 1, HostCreation: "0000000000000001", Epoch: strings.Repeat("1", 32), Revision: 1, Digest: strings.Repeat("a", 64), Phase: "disable"}, Identity: protocol.Identity{RegistrationGUID: "{11111111-1111-1111-1111-111111111111}", MachineID: strings.Repeat("a", 32), DaemonID: "owned"}}
+	r.ID = r.TransactionID()
+	return r
+}
+func TestProxyOneShotNoneCurrentAbsentAndClosedCommands(t *testing.T) {
+	request := proxyFixtureRequest()
+	lease := &proxyTestLease{current: protocol.Observation{MachineID: request.Identity.MachineID, DaemonID: request.Identity.DaemonID, FileHash: protocol.Hash(nil), Runtime: "direct", Quiescent: true}}
+	reader, writer := io.Pipe()
+	defer writer.Close()
+	defer reader.Close()
+	var output bytes.Buffer
+	done := make(chan error, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	go func() { done <- runProxyTransaction(ctx, reader, &output, lease, nil, proxyTestImage) }()
+	if protocol.WriteFrame(writer, proxyMessage{Schema: 1, HelperSHA256: strings.Repeat("b", 64), Operation: "apply", Request: &request}) != nil {
+		t.Fatal("input")
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("bounded handler did not complete")
+	}
+	if !bytes.Contains(output.Bytes(), []byte(`"disposition":"absent-direct"`)) || lease.calls.Load() != 1 {
+		t.Fatal("current none proof missing")
+	}
+	// Closed operation vocabulary cannot become generic root execution.
+	var bad bytes.Buffer
+	_ = protocol.WriteFrame(&bad, proxyMessage{Schema: 1, HelperSHA256: strings.Repeat("b", 64), Operation: "shell", Request: &request})
+	if runProxyTransaction(ctx, &bad, io.Discard, lease, nil, proxyTestImage) == nil || lease.calls.Load() != 1 {
+		t.Fatal("arbitrary operation reached provider")
+	}
+}
+func TestProxyOneShotEOFDiscardsPendingResultAndPartialFrameIsBounded(t *testing.T) {
+	request := proxyFixtureRequest()
+	lease := &proxyTestLease{hold: true, entered: make(chan struct{})}
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var output bytes.Buffer
+	done := make(chan error, 1)
+	go func() { done <- runProxyTransaction(ctx, reader, &output, lease, nil, proxyTestImage) }()
+	if protocol.WriteFrame(writer, proxyMessage{Schema: 1, HelperSHA256: strings.Repeat("b", 64), Operation: "apply", Request: &request}) != nil {
+		t.Fatal("input")
+	}
+	select {
+	case <-lease.entered:
+	case <-ctx.Done():
+		t.Fatal("provider never entered")
+	}
+	_ = writer.Close()
+	select {
+	case err := <-done:
+		if err == nil || output.Len() != 0 {
+			t.Fatal("cancelled native result acknowledged")
+		}
+	case <-ctx.Done():
+		t.Fatal("EOF did not cancel owned pending work")
+	}
+	reader2, writer2 := io.Pipe()
+	defer reader2.Close()
+	defer writer2.Close()
+	partial, stop := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer stop()
+	go func() { _, _ = writer2.Write([]byte(`{"schema":`)) }()
+	if runProxyTransaction(partial, reader2, io.Discard, lease, nil, proxyTestImage) == nil {
+		t.Fatal("partial frame unexpectedly accepted")
+	}
+}
+func TestProxyRuntimeParsersRefuseAmbiguityAndForeignSettings(t *testing.T) {
+	valid := "MainPID=123\nInvocationID=" + strings.Repeat("a", 32) + "\nJob=0\nActiveState=active\nSubState=running\n"
+	if _, err := parseProxyUnit([]byte(valid)); err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range []string{valid + "Job=0\n", strings.Replace(valid, "Job=0", "Job=9", 1), strings.Replace(valid, "MainPID=123", "MainPID=4294967297", 1), strings.Replace(valid, "MainPID=123", "MainPID=0123", 1)} {
+		if _, err := parseProxyUnit([]byte(bad)); err == nil {
+			t.Fatal("malformed/stale unit accepted")
+		}
+	}
+	if mode, err := proxyEnv([]byte("HTTP_PROXY=\x00http_proxy=\x00")); err != nil || mode != "direct" {
+		t.Fatal("empty current proxy env refused")
+	}
+	for _, bad := range []string{"HTTP_PROXY=http://foreign.invalid:9999\x00", "HTTP_PROXY=\x00HTTP_PROXY=\x00"} {
+		if _, err := proxyEnv([]byte(bad)); err == nil {
+			t.Fatal("foreign/duplicate env accepted")
+		}
+	}
+	if _, mode, err := proxyInfo([]byte(`{"ID":"owned","HttpProxy":"","HttpsProxy":"","NoProxy":""}`)); err != nil || mode != "direct" {
+		t.Fatal("direct info refused")
+	}
+	if _, _, err := proxyInfo([]byte(`{"ID":"owned","HttpProxy":"http://private.invalid","HttpsProxy":"","NoProxy":""}`)); err == nil {
+		t.Fatal("foreign effective proxy accepted")
+	}
+}
+
+func proxyTestImage(context.Context) (string, error) { return strings.Repeat("b", 64), nil }
+
+func TestProxyOneShotImageMismatchNeverReachesBackend(t *testing.T) {
+	for _, digest := range []string{"", strings.Repeat("c", 64)} {
+		reader, writer := io.Pipe()
+		lease := &proxyTestLease{}
+		request := proxyFixtureRequest()
+		done := make(chan error, 1)
+		go func() {
+			done <- runProxyTransaction(context.Background(), reader, io.Discard, lease, nil, proxyTestImage)
+		}()
+		if protocol.WriteFrame(writer, proxyMessage{Schema: 1, Operation: "apply", Request: &request, HelperSHA256: digest}) != nil {
+			t.Fatal("input")
+		}
+		select {
+		case err := <-done:
+			if err == nil || lease.calls.Load() != 0 {
+				t.Fatal("unqualified image reached backend")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("image refusal blocked")
+		}
+		writer.Close()
+		reader.Close()
+	}
+}
