diff --git a/rdd/pkg/service/cmd/private_authority_windows.go b/rdd/pkg/service/cmd/private_authority_windows.go
new file mode 100644
index 0000000..0206bdf
--- /dev/null
+++ b/rdd/pkg/service/cmd/private_authority_windows.go
@@ -0,0 +1,292 @@
+//go:build windows
+
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"errors"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd/options"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/datastore"
+	"google.golang.org/grpc"
+	"k8s.io/apiserver/pkg/server/dynamiccertificates"
+	certutil "k8s.io/client-go/util/cert"
+	"k8s.io/client-go/util/keyutil"
+	"k8s.io/klog/v2"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+)
+
+var errPrivateAuthority = errors.New("private selected-instance authority unavailable; existing state retained")
+
+type windowsPrivateAuthority struct {
+	created         *managementconfig.Created
+	publisher       *managementconfig.ConfigPublisher
+	resourcesActive bool
+	retired         bool
+	datastore       *managementconfig.DatastoreGeneration
+	datastoreServer *grpc.Server
+	datastoreExpiry time.Time
+}
+
+func (w *windowsPrivateAuthority) ResourcesStarted() {
+	w.resourcesActive, w.retired = true, false
+	if w.datastore != nil {
+		w.datastore.Started()
+	}
+}
+func (w *windowsPrivateAuthority) ResourcesRetired(retired bool) {
+	w.retired = retired
+	if retired && w.datastore != nil {
+		w.datastore.Retired()
+	}
+}
+
+// Passive diagnostics only: expiry never starts/stops an engine or silently
+// replaces a live credential generation. Standard TLS refuses expired peers;
+// scoped management-service renewal remains an explicit operator transition.
+// The existing owner's manager WaitGroup joins this routine on cancellation.
+func (w *windowsPrivateAuthority) MonitorExpiry(ctx context.Context) {
+	if w.datastoreExpiry.IsZero() {
+		return
+	}
+	wait := func(at time.Time) bool {
+		delay := time.Until(at)
+		if delay < 0 {
+			delay = 0
+		}
+		timer := time.NewTimer(delay)
+		defer timer.Stop()
+		select {
+		case <-ctx.Done():
+			return false
+		case <-timer.C:
+			return ctx.Err() == nil
+		}
+	}
+	if !wait(w.datastoreExpiry.Add(-24 * time.Hour)) {
+		return
+	}
+	klog.Warning("Private datastore authentication expires within 24 hours; plan an explicit management-service restart before expiry")
+	if !wait(w.datastoreExpiry) {
+		return
+	}
+	klog.Warning("Private datastore authentication expired; new control-plane connections are unavailable until an explicit management-service restart")
+}
+
+func (*windowsPrivateAuthority) String() string   { return "private selected service authority" }
+func (*windowsPrivateAuthority) GoString() string { return "private selected service authority" }
+func createPrivateInstance(data []byte) (bool, error) {
+	// Custom orbwin-proof homes remain management-only, outside product authority.
+	if instance.Suffix() != "orbwin" {
+		return false, nil
+	}
+	home, e := os.UserHomeDir()
+	if e != nil {
+		return true, errPrivateAuthority
+	}
+	if managementconfig.InitializeInstance(context.Background(), home, "orbwin", data) != nil {
+		return true, errPrivateAuthority
+	}
+	return true, nil
+}
+func preparePrivateAuthority(ctx context.Context, o *options.Options) (privateAuthority, error) {
+	if instance.Suffix() != "orbwin" {
+		return nil, nil
+	}
+	if validatePrivateDatastoreOptions(o) != nil {
+		return nil, errPrivateAuthority
+	}
+	home, e := os.UserHomeDir()
+	if e != nil {
+		return nil, errPrivateAuthority
+	}
+	c, e := managementconfig.OpenInitialized(ctx, home, "orbwin")
+	if e != nil {
+		return nil, errPrivateAuthority
+	}
+	ok := false
+	defer func() {
+		if !ok {
+			c.Close()
+		}
+	}()
+	server := o.ControlPlane.SecureServing.ServerCert
+	if server.CertKey.CertFile != "" || server.CertKey.KeyFile != "" || server.GeneratedCert != nil || server.FixtureDirectory != "" || len(o.ControlPlane.Authentication.ServiceAccounts.KeyFiles) != 0 || o.ControlPlane.ServiceAccountSigningKeyFile != "" {
+		return nil, errPrivateAuthority
+	}
+	cert, key, sa, e := c.LoadDefaultAuthority(ctx)
+	if errors.Is(e, managementconfig.ErrDefaultsAbsent) {
+		// Existing upstream generators in memory, then protected CREATE writers.
+		cert, key, e = certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+		if e != nil {
+			return nil, errPrivateAuthority
+		}
+		account, genErr := rsa.GenerateKey(rand.Reader, 4096)
+		if genErr != nil {
+			clear(key)
+			return nil, errPrivateAuthority
+		}
+		sa, e = keyutil.MarshalPrivateKeyToPEM(account)
+		if e != nil {
+			clear(key)
+			return nil, errPrivateAuthority
+		}
+		if c.CreateDefaultAuthorityFiles(ctx, cert, key, sa) != nil {
+			clear(key)
+			clear(sa)
+			return nil, errPrivateAuthority
+		}
+	} else if e != nil {
+		return nil, errPrivateAuthority
+	}
+	defer clear(key)
+	defer clear(sa)
+	provider, e := dynamiccertificates.NewStaticCertKeyContent("orbwin-private-default", cert, key)
+	if e != nil {
+		return nil, errPrivateAuthority
+	}
+	o.ControlPlane.SecureServing.ServerCert.GeneratedCert = provider
+	o.ControlPlane.Authentication.ServiceAccounts.KeyFiles = []string{filepath.Join(instance.TLSDir(), "sa.key")}
+	o.ControlPlane.ServiceAccountSigningKeyFile = filepath.Join(instance.TLSDir(), "sa.key")
+	owner := &windowsPrivateAuthority{created: c}
+	if owner.prepareDatastore(ctx, o) != nil {
+		owner.Close()
+		return nil, errPrivateAuthority
+	}
+	ok = true
+	return owner, nil
+}
+
+func validatePrivateDatastoreOptions(o *options.Options) error {
+	servers := o.ControlPlane.Etcd.StorageConfig.Transport.ServerList
+	transport := o.ControlPlane.Etcd.StorageConfig.Transport
+	server := o.Datastore.EndpointConfig.ServerTLSConfig
+	backend := o.Datastore.EndpointConfig.BackendTLSConfig
+	if len(servers) != 1 || o.Datastore.EndpointConfig.GRPCServer != nil || transport.CertFile != "" || transport.KeyFile != "" || transport.TrustedCAFile != "" || transport.EgressLookup != nil ||
+		server.CAFile != "" || server.CertFile != "" || server.KeyFile != "" || server.SkipVerify ||
+		backend.CAFile != "" || backend.CertFile != "" || backend.KeyFile != "" || backend.SkipVerify {
+		return errPrivateAuthority
+	}
+	if _, err := privateDatastoreEndpoint(servers[0]); err != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+func (w *windowsPrivateAuthority) prepareDatastore(ctx context.Context, o *options.Options) error {
+	if validatePrivateDatastoreOptions(o) != nil {
+		return errPrivateAuthority
+	}
+	endpoint, err := privateDatastoreEndpoint(o.ControlPlane.Etcd.StorageConfig.Transport.ServerList[0])
+	if err != nil {
+		return errPrivateAuthority
+	}
+	now := time.Now().UTC().Truncate(time.Second)
+	transport, err := datastore.NewPrivateTransport(now, now.Add(365*24*time.Hour))
+	if err != nil {
+		return errPrivateAuthority
+	}
+	files := transport.Files()
+	defer clear(files.ServerKey)
+	defer clear(files.ClientKey)
+	server, err := transport.NewGRPCServer()
+	if err != nil {
+		return errPrivateAuthority
+	}
+	generation, err := w.created.CreateDatastoreGeneration(ctx, managementconfig.DatastoreMaterial{
+		CA: files.CA, ServerCertificate: files.ServerCertificate, ServerKey: files.ServerKey,
+		ClientCertificate: files.ClientCertificate, ClientKey: files.ClientKey,
+	})
+	if err != nil {
+		server.Stop()
+		return errPrivateAuthority
+	}
+	w.datastore, w.datastoreServer = generation, server
+	w.datastoreExpiry = transport.Expires()
+	if generation.RetainedGenerations() != 0 {
+		klog.Warning("Private datastore cleanup retained incomplete or unconfirmed generations; no unrelated state was removed")
+	}
+	klog.InfoS("Private datastore authentication prepared", "expires", transport.Expires())
+	paths := generation.Paths()
+	o.ControlPlane.Etcd.StorageConfig.Transport.ServerList = []string{endpoint}
+	o.ControlPlane.Etcd.StorageConfig.Transport.TrustedCAFile = paths.CA
+	o.ControlPlane.Etcd.StorageConfig.Transport.CertFile = paths.ClientCertificate
+	o.ControlPlane.Etcd.StorageConfig.Transport.KeyFile = paths.ClientKey
+	o.Datastore.EndpointConfig.GRPCServer = server
+	// Pinned kine uses these paths to publish its HTTPS endpoint metadata even
+	// with a supplied GRPCServer. The actual server credentials remain memory
+	// owned, mTLS-required and exact-client-pinned by PrivateTransport.
+	o.Datastore.EndpointConfig.ServerTLSConfig.CAFile = paths.CA
+	o.Datastore.EndpointConfig.ServerTLSConfig.CertFile = paths.ServerCertificate
+	o.Datastore.EndpointConfig.ServerTLSConfig.KeyFile = paths.ServerKey
+	o.Datastore.EndpointConfig.ServerTLSConfig.SkipVerify = false
+	return nil
+}
+func (w *windowsPrivateAuthority) Publish(ctx context.Context, data []byte, endpoint string, cert []byte) error {
+	if w == nil || w.created == nil || w.publisher != nil {
+		return errPrivateAuthority
+	}
+	native, e := networkproxy.CurrentManagementProcess()
+	if e != nil {
+		return errPrivateAuthority
+	}
+	creation, e := strconv.ParseUint(native.CreationTime, 16, 64)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	binding, e := managementconfig.BindServing(native.PID, creation, native.Session, endpoint, cert)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	publisher, e := w.created.NewConfigPublisher(ctx, binding)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	w.publisher = publisher
+	before, e := publisher.ObserveCurrent(ctx)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	receipt, e := publisher.Publish(ctx, before, data)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	if w.created.PublishServiceGeneration(ctx, binding, receipt.Candidate) != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
+func (w *windowsPrivateAuthority) BindServing(identity *networkproxy.ServingIdentity) error {
+	if w == nil || w.created == nil || w.publisher == nil {
+		return errPrivateAuthority
+	}
+	return identity.WithAnchorFactory(func() (managementconfig.LaunchAnchor, error) { return w.created.PrepareServingAnchorInheritance() })
+}
+func (w *windowsPrivateAuthority) Close() error {
+	if w == nil {
+		return nil
+	}
+	if w.resourcesActive && !w.retired {
+		return errPrivateAuthority
+	}
+	if w.datastoreServer != nil {
+		w.datastoreServer.Stop()
+	}
+	if w.datastore != nil && w.datastore.Close() != nil {
+		return errPrivateAuthority
+	}
+	if w.publisher != nil {
+		return w.publisher.Close()
+	}
+	if w.created != nil {
+		return w.created.Close()
+	}
+	return nil
+}
diff --git a/rdd/pkg/service/cmd/private_datastore_test.go b/rdd/pkg/service/cmd/private_datastore_test.go
