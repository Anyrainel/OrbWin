+	})
+	initial := owner.value
+	startFixtureGeneration(t, supervisor, initial, 1, "url")
+	lease, _ := supervisor.Acquire(context.Background(), func() {})
+	outcome := make(chan error, 1)
+	plan, config := generationInput(t, initial, 2, "none")
+	go func() { _, err := supervisor.Replace(context.Background(), plan, config); outcome <- err }()
+	<-entered
+	changed := initial
+	changed.Binding.HostCreationTime = "0000000000000002"
+	owner.change(changed)
+	close(finish)
+	if !errors.Is(<-outcome, ErrProxyOwner) || !supervisor.Snapshot().Closed || partial.calls.Load() != 1 {
+		t.Fatal("stale owner startup committed or partial resource leaked")
+	}
+	if _, err := supervisor.Acquire(context.Background(), func() {}); err == nil {
+		t.Fatal("old owner admitted after restart")
+	}
+	next, err := NewPolicyGenerationSupervisor(context.Background(), changed, owner.observe, func(_ context.Context, _ context.Context, config Config) (*Policy, GenerationResource, error) {
+		policy, _ := New(config, nil)
+		return policy, &fixtureResource{}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	startFixtureGeneration(t, next, changed, 1, "none")
+	before := next.Snapshot()
+	if err := lease.Release(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	closeSupervisor(t, supervisor)
+	if next.Snapshot() != before {
+		t.Fatal("old owner callback altered restarted owner")
+	}
+	closeSupervisor(t, next)
+}
