@@ -0,0 +1,56 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+const serviceGenerationName = "management.generation"
+
+// ServiceGeneration binds a public current-service observation to the exact
+// privately published config object. It contains no credential or desired
+// proxy state, and never authorizes an endpoint/certificate change on refresh.
+type ServiceGeneration struct {
+	Schema  int            `json:"schema"`
+	Serving ServingBinding `json:"serving"`
+	Image   [32]byte       `json:"image"`
+	Config  ConfigVersion  `json:"config"`
+}
+
+func (g ServiceGeneration) valid() bool {
+	return g.Schema == 1 && g.Serving.valid() && g.Image != [32]byte{} && g.Config.Present && g.Config.valid()
+}
+
+func serviceGenerationBytes(g ServiceGeneration) ([]byte, error) {
+	if !g.valid() {
+		return nil, ErrPublication
+	}
+	return json.Marshal(g)
+}
+
+func parseServiceGeneration(data []byte) (ServiceGeneration, error) {
+	var g ServiceGeneration
+	if len(data) == 0 || len(data) > 2048 || json.Unmarshal(data, &g) != nil || !g.valid() {
+		return ServiceGeneration{}, ErrPublication
+	}
+	canonical, err := serviceGenerationBytes(g)
+	if err != nil || !bytes.Equal(data, canonical) {
+		return ServiceGeneration{}, ErrPublication
+	}
+	return g, nil
+}
+
+// finishGenerationReceipt transfers a successfully opened reader only after
+// the temporary receipt handle positively closes. A failed receipt close
+// attempts reader retirement exactly once and reports unknown in every case.
+// Function dependencies keep this native failure branch fault-testable without
+// opening a file, changing ACLs or relying on an improbable CloseHandle failure.
+func finishGenerationReceipt(closeReceipt, closeReader func() error) error {
+	if closeReceipt == nil || closeReceipt() != nil {
+		if closeReader != nil {
+			_ = closeReader()
+		}
+		return &Failure{Stage: "generation-reader-close", CleanupUnknown: true}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/service_generation_test.go b/rdd/pkg/managementconfig/service_generation_test.go
new file mode 100644
index 0000000..3bc3252
--- /dev/null
+++ b/rdd/pkg/managementconfig/service_generation_test.go
@@ -0,0 +1,67 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"testing"
+)
+
+func TestServiceGenerationStrictCanonicalIdentity(t *testing.T) {
+	b := ServingBinding{PID: 12, Creation: 34, Session: 1, Endpoint: "https://127.0.0.1:6443", Certificate: [32]byte{1}}
+	g := ServiceGeneration{1, b, [32]byte{2}, ConfigVersion{true, 3, 4, 5, [32]byte{6}}}
+	data, err := serviceGenerationBytes(g)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := parseServiceGeneration(data); err != nil || got != g {
+		t.Fatal("canonical receipt refused")
+	}
+	for _, malformed := range [][]byte{append(append([]byte{}, data...), '\n'), bytes.Replace(data, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1), bytes.Replace(data, []byte(`"schema":1`), []byte(`"Schema":1`), 1), bytes.Replace(data, []byte(`"schema":1`), []byte(`"schema":1,"extra":0`), 1)} {
+		if _, err := parseServiceGeneration(malformed); err == nil {
+			t.Fatal("ambiguous receipt accepted")
+		}
+	}
+	for _, mutate := range []func(*ServiceGeneration){func(v *ServiceGeneration) { v.Serving.PID = 0 }, func(v *ServiceGeneration) { v.Serving.Endpoint = "https://foreign.invalid:6443" }, func(v *ServiceGeneration) { v.Config.Present = false }, func(v *ServiceGeneration) { v.Image = [32]byte{} }} {
+		bad := g
+		mutate(&bad)
+		encoded, _ := json.Marshal(bad)
+		if _, err := parseServiceGeneration(encoded); err == nil {
+			t.Fatal("invalid generation accepted")
+		}
+	}
+}
+
+func TestServiceGenerationReceiptCloseFailureNeverTransfersReader(t *testing.T) {
+	for _, receiptFails := range []bool{false, true} {
+		for _, readerFails := range []bool{false, true} {
+			receiptCalls, readerCalls := 0, 0
+			err := finishGenerationReceipt(func() error {
+				receiptCalls++
+				if receiptFails {
+					return errors.New("injected receipt close failure")
+				}
+				return nil
+			}, func() error {
+				readerCalls++
+				if readerFails {
+					return errors.New("injected reader close failure")
+				}
+				return nil
+			})
+			if receiptCalls != 1 {
+				t.Fatal("receipt close replayed")
+			}
+			if !receiptFails {
+				if err != nil || readerCalls != 0 {
+					t.Fatal("successful handoff closed caller-owned reader")
+				}
+			} else {
+				var failure *Failure
+				if !errors.As(err, &failure) || !failure.CleanupUnknown || !errors.Is(err, ErrCreate) || readerCalls != 1 {
+					t.Fatal("failed receipt close granted reader or replayed cleanup")
+				}
+			}
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/service_generation_windows.go b/rdd/pkg/managementconfig/service_generation_windows.go
new file mode 100644
index 0000000..49eeb81
--- /dev/null
+++ b/rdd/pkg/managementconfig/service_generation_windows.go
@@ -0,0 +1,229 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// PublishServiceGeneration is a single fixed-role publication after the exact
+// config publication. A failure preserves the running owner's state and never
+// retries a possibly completed rename or exports credential bytes.
+func (c *Created) PublishServiceGeneration(ctx context.Context, b ServingBinding, config ConfigVersion) (result error) {
+	backend := &nativeAuthority{created: c}
+	lease, err := backend.acquire(ctx)
+	if err != nil {
+		return ErrPublication
+	}
+	defer func() {
+		if lease.close() != nil {
+			result = ErrPublication
+		}
+	}()
+	if c.generationAttempted || !c.servingLease {
+		return ErrPublication
+	}
+	c.generationAttempted = true
+	if lease.check(ctx, b) != nil {
+		return ErrPublication
+	}
+	current, err := lease.current(ctx)
+	if err != nil || current != config {
+		return ErrPublication
+	}
+	image, err := ObserveServiceImage(ctx, b)
+	if err != nil {
+		return ErrPublication
+	}
+	data, err := serviceGenerationBytes(ServiceGeneration{1, b, image, config})
+	if err != nil {
+		return ErrPublication
+	}
+	sid, err := currentOwner()
+	if err != nil {
+		return ErrPublication
+	}
+	replace := false
+	prior, err := authorityOpen(c.anchor, serviceGenerationName, nil, windows.FILE_OPEN, windows.GENERIC_READ|windows.READ_CONTROL, windows.FILE_SHARE_READ)
+	if err == nil {
+		if verifyPrivate(prior, sid, false) != nil {
+			windows.CloseHandle(prior)
+			return ErrPublication
+		}
+		previous, e := authorityRead(prior, 2048)
+		closeErr := windows.CloseHandle(prior)
+		if _, e2 := parseServiceGeneration(previous); e != nil || e2 != nil || closeErr != nil {
+			return ErrPublication
+		}
+		replace = true
+	} else if err != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrPublication
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return ErrPublication
+	}
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return ErrPublication
+	}
+	h, err := authorityOpen(c.anchor, "generation.publish-"+hex.EncodeToString(nonce[:]), sd, windows.FILE_CREATE, windows.GENERIC_READ|windows.GENERIC_WRITE|windows.DELETE|windows.READ_CONTROL, 0)
+	if err != nil {
+		return ErrPublication
+	}
+	attempted := false
+	defer func() {
+		if h == 0 {
+			return
+		}
+		if !attempted {
+			remove := uint32(1)
+			_ = windows.SetFileInformationByHandle(h, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4)
+		}
+		if windows.CloseHandle(h) != nil {
+			result = ErrPublication
+		}
+	}()
+	if verifyPrivate(h, sid, false) != nil {
+		return ErrPublication
+	}
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return ErrPublication
+		}
+		n, e := nativeWrite(h, remaining)
+		if e != nil || n < 1 || n > len(remaining) {
+			return ErrPublication
+		}
+		remaining = remaining[n:]
+	}
+	if windows.FlushFileBuffers(h) != nil || lease.check(ctx, b) != nil {
+		return ErrPublication
+	}
+	current, err = lease.current(ctx)
+	if err != nil || current != config || ctx.Err() != nil {
+		return ErrPublication
+	}
+	type renameInfo struct {
+		Replace uint32
+		Root    windows.Handle
+		Length  uint32
+		Name    [1]uint16
+	}
+	name, _ := windows.UTF16FromString(serviceGenerationName)
+	var shape renameInfo
+	buffer := make([]byte, int(unsafe.Offsetof(shape.Name))+(len(name)-1)*2)
+	info := (*renameInfo)(unsafe.Pointer(&buffer[0]))
+	if replace {
+		info.Replace = 1
+	}
+	info.Root, info.Length = c.anchor, uint32((len(name)-1)*2)
+	copy(unsafe.Slice(&info.Name[0], len(name)-1), name[:len(name)-1])
+	var status windows.IO_STATUS_BLOCK
+	attempted = true
+	if windows.NtSetInformationFile(h, &status, &buffer[0], uint32(len(buffer)), windows.FileRenameInformation) != nil {
+		return ErrPublication
+	}
+	closing := h
+	h = 0
+	if windows.CloseHandle(closing) != nil {
+		return ErrPublication
+	}
+	visible, err := authorityOpen(c.anchor, serviceGenerationName, nil, windows.FILE_OPEN, windows.GENERIC_READ|windows.READ_CONTROL, windows.FILE_SHARE_READ)
+	if err != nil {
+		return ErrPublication
+	}
+	got, readErr := authorityRead(visible, 2048)
+	privateErr := verifyPrivate(visible, sid, false)
+	closeErr := windows.CloseHandle(visible)
+	if readErr != nil || privateErr != nil || closeErr != nil || !bytes.Equal(got, data) || lease.check(ctx, b) != nil {
+		return ErrPublication
+	}
+	return nil
+}
+
+// OpenGenerationReader holds the exact config while checking its private
+// generation receipt. It never resolves a product pathname or service argv.
+// The caller owns the returned reader and verifies service/native/image pins.
+func (a *ReceivedAnchor) OpenGenerationReader(ctx context.Context) (result *Reader, resultGeneration ServiceGeneration, resultErr error) {
+	var empty ServiceGeneration
+	if a == nil || ctx == nil || ctx.Err() != nil {
+		return nil, empty, ErrCreate
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.handle == 0 {
+		return nil, empty, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(a.handle, sid, true) != nil {
+		return nil, empty, ErrCreate
+	}
+	receipt, err := authorityOpen(a.handle, serviceGenerationName, nil, windows.FILE_OPEN, windows.GENERIC_READ|windows.READ_CONTROL, windows.FILE_SHARE_READ)
+	if err != nil {
+		return nil, empty, ErrCreate
+	}
+	defer func() {
+		var closeReader func() error
+		if result != nil {
+			closeReader = result.Close
+		}
+		if err := finishGenerationReceipt(func() error { return windows.CloseHandle(receipt) }, closeReader); err != nil {
+			result, resultGeneration, resultErr = nil, ServiceGeneration{}, err
+		}
+	}()
+	if verifyPrivate(receipt, sid, false) != nil {
+		return nil, empty, ErrCreate
+	}
+	data, err := authorityRead(receipt, 2048)
+	if err != nil {
+		return nil, empty, ErrCreate
+	}
+	generation, err := parseServiceGeneration(data)
+	if err != nil {
+		return nil, empty, ErrCreate
+	}
+	var held windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), a.handle, windows.CurrentProcess(), &held, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		return nil, empty, ErrCreate
+	}
+	reader, err := openReaderLeaf(ctx, &ParentLease{chain: []windows.Handle{held}, sid: sid})
+	if err != nil {
+		return nil, empty, ErrCreate
+	}
+	refuse := func() (*Reader, ServiceGeneration, error) {
+		if reader.Close() != nil {
+			return nil, empty, &Failure{Stage: "generation-reader-close", CleanupUnknown: true}
+		}
+		return nil, empty, ErrCreate
+	}
+	h := windows.Handle(reader.file.Fd())
+	if verifyPrivate(h, sid, false) != nil {
+		return refuse()
+	}
+	var native windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &native) != nil {
+		return refuse()
+	}
+	configData, err := authorityRead(h, MaxConfigBytes)
+	if err != nil {
+		return refuse()
+	}
+	hash := sha256.Sum256(configData)
+	clear(configData)
+	version := ConfigVersion{true, native.VolumeSerialNumber, native.FileIndexHigh, native.FileIndexLow, hash}
+	if version != generation.Config || ctx.Err() != nil {
+		return refuse()
+	}
+	return reader, generation, nil
+}
