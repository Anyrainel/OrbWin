--- /dev/null
+++ b/rdd/pkg/controllers/lima/limavm/controllers/startup_retirement_test.go
@@ -0,0 +1,76 @@
+package controllers
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestStartupRetirementSyntheticChild(t *testing.T) {
+	if os.Getenv("ORBWIN_STARTUP_RETIREMENT_FIXTURE") != "1" {
+		return
+	}
+	if _, err := os.Stdout.Write([]byte{'R'}); err != nil {
+		os.Exit(2)
+	}
+	time.Sleep(10 * time.Second)
+	os.Exit(3)
+}
+func TestStartupRetirementKillsActualStartedChildAndJoinsSoleWaitOwner(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, exe, "-test.run=^TestStartupRetirementSyntheticChild$", "-test.timeout=4s")
+	// Controller dependencies compute selected home paths during init. A fresh
+	// disposable profile avoids ambient user config and missing-home init exits.
+	fixtureHome := t.TempDir()
+	cmd.Env = []string{"ORBWIN_STARTUP_RETIREMENT_FIXTURE=1", "USERPROFILE=" + fixtureHome, "HOME=" + fixtureHome, "SystemRoot=" + os.Getenv("SystemRoot")}
+	ready, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	exited := make(chan struct{})
+	var waits atomic.Int32
+	go func() { waits.Add(1); _ = cmd.Wait(); close(exited) }()
+	defer func() {
+		_ = cmd.Process.Kill()
+		select {
+		case <-exited:
+		case <-time.After(time.Second):
+			t.Error("fresh child reap unknown")
+		}
+	}()
+	var b [1]byte
+	if n, err := ready.Read(b[:]); err != nil || b[0] != 'R' {
+		t.Fatalf("fresh child readiness failed: n=%d byte=%d readError=%t", n, b[0], err != nil)
+	}
+	if err := retireStartedHostagent(cmd.Process.Kill, exited, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if waits.Load() != 1 || cmd.ProcessState == nil {
+		t.Fatal("started child had no sole completed Wait owner")
+	}
+}
+func TestStartupRetirementUnknownDoesNotReplayOrStealWait(t *testing.T) {
+	exited := make(chan struct{})
+	calls := 0
+	if err := retireStartedHostagent(func() error { calls++; return nil }, exited, 20*time.Millisecond); err == nil {
+		t.Fatal("unjoined process claimed retired")
+	}
+	if calls != 1 {
+		t.Fatal("kill replayed")
+	}
+	close(exited)
+	if err := retireStartedHostagent(func() error { calls++; return nil }, exited, time.Second); err != nil || calls != 1 {
+		t.Fatal("reaped process was signalled again")
+	}
+}
