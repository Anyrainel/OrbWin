@@ -0,0 +1,258 @@
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+type refreshingConsumerSource struct {
+	*consumerSourceFixture
+	refresh   func(context.Context) error
+	openWatch func(context.Context, string) (watch.Interface, error)
+	refreshes atomic.Int32
+}
+
+func (s *refreshingConsumerSource) RefreshCredentials(ctx context.Context) error {
+	s.refreshes.Add(1)
+	return s.refresh(ctx)
+}
+func (s *refreshingConsumerSource) WatchApp(ctx context.Context, rv string) (watch.Interface, error) {
+	if s.openWatch != nil {
+		return s.openWatch(ctx, rv)
+	}
+	return s.consumerSourceFixture.WatchApp(ctx, rv)
+}
+
+func startRefreshingConsumer(t *testing.T, owner *app.App, source *refreshingConsumerSource) (*PolicyConsumer, context.CancelFunc, <-chan error) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	native := &fixtureOwner{value: GenerationOwner{AppUID: "app-one", Binding: bindingFixture()}}
+	c, err := NewPolicyConsumer(ctx, source, native.value, native.observe, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.endpointState(true)
+	done := make(chan error, 1)
+	go func() { done <- c.Run(ctx) }()
+	t.Cleanup(func() {
+		cancel()
+		cleanup, stop := context.WithTimeout(context.Background(), time.Second)
+		defer stop()
+		c.Close(cleanup)
+	})
+	return c, cancel, done
+}
+
+func TestConsumerRefreshRead401PreservesCommittedPolicyAndDoesNotReplayStatus(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+	source := &refreshingConsumerSource{consumerSourceFixture: base}
+	refreshed := make(chan struct{})
+	source.refresh = func(ctx context.Context) error {
+		if _, ok := ctx.Deadline(); !ok {
+			t.Error("refresh lacks deadline")
+		}
+		base.set(a, nil)
+		close(refreshed)
+		return nil
+	}
+	c, cancel, done := startRefreshingConsumer(t, a, source)
+	w := nextConsumerWatch(t, base)
+	waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 1 })
+	base.set(a, ErrManagementCredentials)
+	w.Stop()
+	select {
+	case <-refreshed:
+	case <-time.After(3 * time.Second):
+		t.Fatal("GET 401 did not refresh")
+	}
+	if c.Snapshot().ActiveRevision != 1 {
+		t.Fatal("rotation revoked immutable committed policy")
+	}
+	nextConsumerWatch(t, base)
+	base.mu.Lock()
+	writes := base.writes
+	base.mu.Unlock()
+	if source.refreshes.Load() != 1 || writes != 1 {
+		t.Fatal("refresh repeated credential/status transaction")
+	}
+	cancel()
+	awaitConsumerExit(t, done)
+}
+
+func TestConsumerRefreshWatchOpen401HasNoOldWatchToReplace(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+	source := &refreshingConsumerSource{consumerSourceFixture: base}
+	var opens atomic.Int32
+	source.openWatch = func(ctx context.Context, rv string) (watch.Interface, error) {
+		if opens.Add(1) == 1 {
+			return nil, ErrManagementCredentials
+		}
+		return base.WatchApp(ctx, rv)
+	}
+	source.refresh = func(context.Context) error { return nil }
+	c, cancel, done := startRefreshingConsumer(t, a, source)
+	nextConsumerWatch(t, base)
+	if source.refreshes.Load() != 1 || opens.Load() != 2 || c.Snapshot().ActiveRevision != 1 {
+		t.Fatal("watch-open refresh changed policy or retried more than one watch")
+	}
+	cancel()
+	awaitConsumerExit(t, done)
+}
+
+func TestConsumerRefreshOnlyAfterWatch401FullyRetires(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+	source := &refreshingConsumerSource{consumerSourceFixture: base}
+	w := &controlledConsumerWatch{events: make(chan watch.Event, 1), stopStarted: make(chan struct{}), releaseStop: make(chan struct{})}
+	w.events <- watch.Event{Type: watch.Error, Object: &metav1.Status{Code: 401, Reason: metav1.StatusReasonUnauthorized}}
+	var opens atomic.Int32
+	source.openWatch = func(ctx context.Context, rv string) (watch.Interface, error) {
+		if opens.Add(1) == 1 {
+			return w, nil
+		}
+		return base.WatchApp(ctx, rv)
+	}
+	refreshed := make(chan struct{})
+	source.refresh = func(context.Context) error {
+		if !w.stopReturned.Load() {
+			t.Error("refresh raced old Stop")
+		}
+		close(refreshed)
+		return nil
+	}
+	c, cancel, done := startRefreshingConsumer(t, a, source)
+	select {
+	case <-w.stopStarted:
+	case <-time.After(time.Second):
+		t.Fatal("watch Stop not requested")
+	}
+	close(w.events) // Closing decoder alone must not authorize replacement.
+	if source.refreshes.Load() != 0 {
+		t.Fatal("refresh preceded Stop return")
+	}
+	close(w.releaseStop)
+	select {
+	case <-refreshed:
+	case <-time.After(time.Second):
+		t.Fatal("joined 401 watch did not refresh")
+	}
+	nextConsumerWatch(t, base)
+	if c.Snapshot().ActiveRevision != 1 {
+		t.Fatal("401 rotation revoked prior policy")
+	}
+	cancel()
+	awaitConsumerExit(t, done)
+}
+
+func TestConsumerRefreshForbiddenAndTransportErrorsNeverRefresh(t *testing.T) {
+	for _, failure := range []struct {
+		reason  metav1.StatusReason
+		code    int32
+		revoked bool
+	}{
+		{metav1.StatusReasonForbidden, 403, true}, {metav1.StatusReasonNotFound, 404, true},
+		{metav1.StatusReasonInternalError, 500, false},
+	} {
+		t.Run(string(failure.reason), func(t *testing.T) {
+			a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+			base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+			source := &refreshingConsumerSource{consumerSourceFixture: base, refresh: func(context.Context) error { return nil }}
+			c, cancel, done := startRefreshingConsumer(t, a, source)
+			w := nextConsumerWatch(t, base)
+			base.set(a, ErrManagement) // Hold rejoin at transport failure, not re-admission.
+			w.Error(&metav1.Status{Code: failure.code, Reason: failure.reason})
+			waitConsumer(t, w.IsStopped)
+			if failure.revoked {
+				waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 0 })
+			} else if c.Snapshot().ActiveRevision != 1 {
+				t.Fatal("transport watch error revoked committed policy")
+			}
+			cancel()
+			awaitConsumerExit(t, done)
+			if source.refreshes.Load() != 0 {
+				t.Fatal("non-401 failure refreshed credentials")
+			}
+		})
+	}
+}
+
+func TestConsumerRefreshTransientFailureRetainsPolicyButOwnerInvalidationRevokes(t *testing.T) {
+	for _, failure := range []error{ErrManagement, ErrProxyOwner} {
+		t.Run(failure.Error(), func(t *testing.T) {
+			a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+			base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+			source := &refreshingConsumerSource{consumerSourceFixture: base}
+			refreshed := make(chan struct{})
+			source.refresh = func(context.Context) error { base.set(a, ErrManagement); close(refreshed); return failure }
+			c, cancel, done := startRefreshingConsumer(t, a, source)
+			w := nextConsumerWatch(t, base)
+			base.set(a, ErrManagementCredentials)
+			w.Stop()
+			select {
+			case <-refreshed:
+			case <-time.After(3 * time.Second):
+				t.Fatal("no refresh attempt")
+			}
+			if errors.Is(failure, ErrProxyOwner) {
+				waitConsumer(t, func() bool { return c.Snapshot().ActiveRevision == 0 })
+			} else if c.Snapshot().ActiveRevision != 1 {
+				t.Fatal("transient refresh failure revoked policy")
+			}
+			cancel()
+			awaitConsumerExit(t, done)
+		})
+	}
+}
+
+func TestConsumerRefreshStatus401WaitsForFreshReadWithoutMutationReplay(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8), writeErr: ErrManagementCredentials}
+	source := &refreshingConsumerSource{consumerSourceFixture: base}
+	source.refresh = func(context.Context) error { base.set(a, nil); return nil }
+	_, cancel, done := startRefreshingConsumer(t, a, source)
+	w := nextConsumerWatch(t, base)
+	if source.refreshes.Load() != 0 {
+		t.Fatal("status error refreshed credentials while watch active")
+	}
+	base.set(a, ErrManagementCredentials)
+	w.Stop()
+	nextConsumerWatch(t, base)
+	base.mu.Lock()
+	writes := base.writes
+	base.mu.Unlock()
+	if source.refreshes.Load() != 1 || writes != 1 {
+		t.Fatal("status mutation was replayed across credential refresh")
+	}
+	cancel()
+	awaitConsumerExit(t, done)
+}
+
+func TestConsumerRefreshUnknownCleanupIsTerminalWithoutSuspendOrRejoin(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+	source := &refreshingConsumerSource{consumerSourceFixture: base, refresh: func(context.Context) error { return ErrProxyRetirement }}
+	c, cancel, done := startRefreshingConsumer(t, a, source)
+	w := nextConsumerWatch(t, base)
+	w.Error(&metav1.Status{Code: 401, Reason: metav1.StatusReasonUnauthorized})
+	select {
+	case err := <-done:
+		if err != ErrProxyRetirement {
+			t.Fatal("unknown credential-reader cleanup hidden", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("unknown cleanup did not terminate consumer")
+	}
+	if c.Snapshot().ActiveRevision != 1 || source.refreshes.Load() != 1 || len(base.watches) != 0 {
+		t.Fatal("unknown cleanup suspended, refreshed again, or replaced watch")
+	}
+	cancel()
+}
