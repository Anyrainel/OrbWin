+)
+
+func receivedFixture(t *testing.T, created *Created) *ReceivedAnchor {
+	t.Helper()
+	transfer, err := created.PrepareAnchorInheritance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transfer.Close()
+	var received *ReceivedAnchor
+	err = transfer.Start(func(raw uintptr, id AnchorIdentity) error {
+		var duplicate windows.Handle
+		if windows.DuplicateHandle(windows.CurrentProcess(), windows.Handle(raw), windows.CurrentProcess(), &duplicate, 0, true, windows.DUPLICATE_SAME_ACCESS) != nil {
+			return ErrCreate
+		}
+		var err error
+		received, err = ConsumeInheritedAnchor(uintptr(duplicate), id)
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { received.Close() })
+	return received
+}
+
+func TestReceivedAnchorProtectedReaderOwnsIndependentLease(t *testing.T) {
+	parent, _, _ := fixture(t)
+	created, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer created.Close()
+	anchor := receivedFixture(t, created)
+	if created.Close() != nil || parent.Close() != nil {
+		t.Fatal("parent close")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if reader, err := anchor.OpenReader(ctx); err != ErrCreate || reader != nil {
+		t.Fatal("canceled read accepted")
+	}
+	reader, err := anchor.OpenReader(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	if anchor.Close() != nil {
+		t.Fatal("received close")
+	}
+	data, err := io.ReadAll(reader)
+	if err != nil || string(data) != "fixture" {
+		t.Fatal("independent bounded reader")
+	}
+	if r, e := anchor.OpenReader(context.Background()); r != nil || e != ErrCreate {
+		t.Fatal("closed anchor reused")
+	}
+	if reader.Close() != nil {
+		t.Fatal("reader close")
+	}
+}
+
+func TestAuthorityGateUsesOnlyProtectedFixedMetadata(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	created, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer created.Close()
+	if checkAuthorityFiles(context.Background(), created.anchor, sid) != ErrCreate {
+		t.Fatal("missing authority accepted")
+	}
+	directorySD, err := privateDescriptor(sid, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tls, err := openRelative(created.anchor, "tls", true, directorySD, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tlsClosed := false
+	defer func() {
+		if !tlsClosed {
+			windows.CloseHandle(tls)
+		}
+	}()
+	names := []string{"apiserver.crt", "apiserver.key", "sa.key"}
+	t.Cleanup(func() {
+		for _, name := range names {
+			if err := os.Remove(filepath.Join(dir, anchorName, "tls", name)); err != nil && !os.IsNotExist(err) {
+				t.Error("known TLS fixture cleanup")
+			}
+		}
+		if err := os.Remove(filepath.Join(dir, anchorName, "tls")); err != nil {
+			t.Error("known TLS directory cleanup")
+		}
+	})
+	fileSD, err := privateDescriptor(sid, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range names {
+		h, err := openRelative(tls, name, false, fileSD, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if n, err := nativeWrite(h, []byte("dummy")); err != nil || n != 5 {
+			windows.CloseHandle(h)
+			t.Fatal("dummy authority write")
+		}
+		windows.CloseHandle(h)
+	}
+	tlsClosed = true
+	if windows.CloseHandle(tls) != nil {
+		t.Fatal("fixture creator lease close")
+	}
+	if checkAuthorityFiles(context.Background(), created.anchor, sid) != nil {
+		t.Fatal("protected fixed metadata refused")
+	}
+	// An obsolete option's unused token-store pathname is not evidence of a
+	// required active token source. Fresh absence passes; unexpected presence
+	// refuses without reading its data or inventing migration semantics.
+	legacy, err := openRelative(created.anchor, "tls", true, nil, false)
+	if err != nil {
+		t.Fatal("legacy fixture directory")
+	}
+	obsolete, err := openRelative(legacy, ".admin-token-store", false, fileSD, true)
+	windows.CloseHandle(legacy)
+	if err != nil {
+		t.Fatal("legacy fixture create")
+	}
+	if checkAuthorityFiles(context.Background(), created.anchor, sid) != ErrCreate {
+		t.Fatal("legacy token store accepted")
+	}
+	remove := uint32(1)
+	if windows.SetFileInformationByHandle(obsolete, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4) != nil {
+		windows.CloseHandle(obsolete)
+		t.Fatal("fresh known legacy fixture removal")
+	}
+	windows.CloseHandle(obsolete)
+	tlsReader, err := openRelative(created.anchor, "tls", true, nil, false)
+	if err != nil {
+		t.Fatal("fixed TLS directory reopen")
+	}
+	defer windows.CloseHandle(tlsReader)
+	h, err := openMetadataRelative(tlsReader, "apiserver.key")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer windows.CloseHandle(h)
+	var data [8]byte
+	var n uint32
+	if windows.ReadFile(h, data[:], &n, nil) == nil {
+		t.Fatal("metadata handle unexpectedly granted file data read")
+	}
+	if _, err := openMetadataRelative(tlsReader, `..\config.yaml`); err != ErrCreate {
+		t.Fatal("relative component escape")
+	}
+}
diff --git a/rdd/pkg/managementconfig/anchor_transfer_windows.go b/rdd/pkg/managementconfig/anchor_transfer_windows.go
new file mode 100644
index 0000000..41dfc68
--- /dev/null
+++ b/rdd/pkg/managementconfig/anchor_transfer_windows.go
@@ -0,0 +1,178 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var anchorGetHandleInformation = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetHandleInformation")
+
+// AnchorIdentity is public object identity, not a secret or an authentication
+// claim. Only an actual inherited kernel handle carries the selected object.
+type AnchorTransfer struct {
+	mu       sync.Mutex
+	handle   windows.Handle
+	identity AnchorIdentity
+	started  bool
+}
+
+func (*AnchorTransfer) String() string   { return "private anchor transfer" }
+func (*AnchorTransfer) GoString() string { return "private anchor transfer" }
+
+// PrepareAnchorInheritance is available only from successful private-at-CREATE
+// authority. It never accepts a path or caller-supplied raw parent handle.
+// DuplicateHandle retains the original object/share reservation; it does not
+// tighten sharing, re-open by path, or authenticate arbitrary launcher arguments.
+func (c *Created) PrepareAnchorInheritance() (*AnchorTransfer, error) {
+	return c.prepareAnchorInheritance(false)
+}
+
+// PrepareServingAnchorInheritance is the production service handoff. Fresh
+// creation uses an exclusive file object; duplicating that object into a
+// long-lived hostagent would block the next service's authority reopen. Only
+// OpenInitialized/openExistingAuthority's retained read/shareable lease may
+// cross this boundary. It still denies DELETE sharing and retains the chain.
+func (c *Created) PrepareServingAnchorInheritance() (*AnchorTransfer, error) {
+	return c.prepareAnchorInheritance(true)
+}
+
+func (c *Created) prepareAnchorInheritance(requireServing bool) (*AnchorTransfer, error) {
+	if c == nil {
+		return nil, ErrCreate
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.anchor == 0 || requireServing && !c.servingLease {
+		return nil, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(c.anchor, sid, true) != nil {
+		return nil, ErrCreate
+	}
+	id, err := anchorIdentity(c.anchor)
+	if err != nil {
+		return nil, err
+	}
+	var duplicate windows.Handle
+	access := uint32(windows.FILE_LIST_DIRECTORY | windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES)
+	if windows.DuplicateHandle(windows.CurrentProcess(), c.anchor, windows.CurrentProcess(), &duplicate, access, true, 0) != nil {
+		return nil, ErrCreate
+	}
+	return &AnchorTransfer{handle: duplicate, identity: id}, nil
+}
+
+// Start serializes one existing exec.Cmd.Start callback against Close. The
+// callback must put ONLY this handle in AdditionalInheritedHandles, carry the
+// public identity as launch metadata, and return immediately after Start (not
+// Wait). It must not retain/reuse the raw integer after returning. The existing
+// launcher remains the lifecycle owner; this type never launches a process.
+func (a *AnchorTransfer) Start(start func(uintptr, AnchorIdentity) error) error {
+	if a == nil || start == nil {
+		return ErrCreate
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.handle == 0 || a.started {
+		return ErrCreate
+	}
+	a.started = true
+	return start(uintptr(a.handle), a.identity)
+}
+
+func (a *AnchorTransfer) Close() error {
+	if a == nil {
+		return nil
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.handle == 0 {
+		return nil
+	}
+	h := a.handle
+	a.handle = 0
+	if windows.CloseHandle(h) != nil {
+		return ErrCreate
+	}
+	return nil
+}
+
+// ReceivedAnchor owns the actual inherited object independently of the parent
+// lifetime. No config-data read or path-based fallback is provided in this slice.
+type ReceivedAnchor struct {
+	mu     sync.Mutex
+	handle windows.Handle
+}
+
+func (*ReceivedAnchor) String() string   { return "private received anchor" }
+func (*ReceivedAnchor) GoString() string { return "private received anchor" }
+
+// ConsumeInheritedAnchor is ONLY for the reviewed hostagent launch boundary,
+// never a renderer/API-selected number. It consumes (closes on any failure) one
+// inherited file handle exactly once. The identity/ACL checks are defense in
+// depth, not proof that public argv came from the trusted rdd launcher. That
+// launcher must acquire authoritative App/Lima and external-TLS pins separately.
+func ConsumeInheritedAnchor(raw uintptr, expected AnchorIdentity) (*ReceivedAnchor, error) {
+	if raw == 0 || raw == ^uintptr(0) {
+		return nil, ErrCreate
+	}
+	h := windows.Handle(raw)
+	ok := false
+	defer func() {
+		if !ok {
+			windows.CloseHandle(h)
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	var flags uint32
+	result, _, _ := anchorGetHandleInformation.Call(uintptr(h), uintptr(unsafe.Pointer(&flags)))
+	if result == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 {
+		return nil, ErrCreate
+	}
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(h, sid, true) != nil {
+		return nil, ErrCreate
+	}
+	id, err := anchorIdentity(h)
+	if err != nil || id != expected || windows.SetHandleInformation(h, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+		return nil, ErrCreate
+	}
+	ok = true
+	return &ReceivedAnchor{handle: h}, nil
+}
+
+func (a *ReceivedAnchor) Close() error {
+	if a == nil {
+		return nil
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.handle == 0 {
+		return nil
+	}
+	h := a.handle
+	a.handle = 0
+	if windows.CloseHandle(h) != nil {
+		return ErrCreate
+	}
+	return nil
+}
+
+func anchorIdentity(h windows.Handle) (AnchorIdentity, error) {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil {
+		return AnchorIdentity{}, ErrCreate
+	}
+	id := AnchorIdentity{Volume: info.VolumeSerialNumber, IndexHigh: info.FileIndexHigh, IndexLow: info.FileIndexLow}
+	if id.IndexHigh == 0 && id.IndexLow == 0 {
+		return AnchorIdentity{}, ErrCreate
+	}
+	return id, nil
+}
diff --git a/rdd/pkg/managementconfig/anchor_transfer_windows_test.go b/rdd/pkg/managementconfig/anchor_transfer_windows_test.go
new file mode 100644
index 0000000..71f2700
--- /dev/null
+++ b/rdd/pkg/managementconfig/anchor_transfer_windows_test.go
@@ -0,0 +1,194 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestAnchorTransferChild(t *testing.T) {
+	if os.Getenv("ORBWIN_FRESH_ANCHOR_CHILD") != "yes" {
+		return
+	}
+	parts := strings.Split(os.Getenv("ORBWIN_FRESH_ANCHOR_DESCRIPTOR"), ",")
+	if len(parts) != 4 {
+		t.Fatal("descriptor shape")
+	}
+	var values [4]uint64
+	for i, part := range parts {
+		value, err := strconv.ParseUint(part, 10, 64)
+		if err != nil {
+			t.Fatal("descriptor number")
+		}
+		values[i] = value
+	}
+	id := AnchorIdentity{uint32(values[1]), uint32(values[2]), uint32(values[3])}
+	anchor, err := ConsumeInheritedAnchor(uintptr(values[0]), id)
+	if err != nil {
+		t.Fatal("inherited anchor refused")
+	}
+	defer anchor.Close()
+	// Parent explicitly closes every original/transfer lease before this byte.
+	var signal [1]byte
+	if _, err := io.ReadFull(os.Stdin, signal[:]); err != nil || signal[0] != 'x' {
+		t.Fatal("parent retirement signal")
+	}
+	if got, err := anchorIdentity(anchor.handle); err != nil || got != id {
+		t.Fatal("retained object lost")
+	}
+	var flags uint32
+	ok, _, _ := anchorGetHandleInformation.Call(uintptr(anchor.handle), uintptr(unsafe.Pointer(&flags)))
+	if ok == 0 || flags&windows.HANDLE_FLAG_INHERIT != 0 {
+		t.Fatal("inherited handle not retired from inheritance")
+	}
+	// No DACL write test: qualification does not attempt a permission mutation.
+	// NtCreateFile relative access checks the protected new fixture child.
+	h, err := openRelative(anchor.handle, configName, false, nil, false)
+	if err != nil {
+		t.Fatal("relative fixture file open")
+	}
+	defer windows.CloseHandle(h)
+	var data [16]byte
+	var n uint32
+	if windows.ReadFile(h, data[:], &n, nil) != nil || string(data[:n]) != "fixture" {
+		t.Fatal("fixture read")
+	}
+}
+
+func TestAnchorTransferSurvivesParentLeaseRetirement(t *testing.T) {
+	parent, _, _ := fixture(t)
+	created, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer created.Close()
+	transfer, err := created.PrepareAnchorInheritance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transfer.Close()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal("executable")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, exe, "-test.run=^TestAnchorTransferChild$", "-test.timeout=4s")
+	var output bytes.Buffer
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+	input, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal("child pipe")
+	}
+	err = transfer.Start(func(handle uintptr, id AnchorIdentity) error {
+		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, AdditionalInheritedHandles: []syscall.Handle{syscall.Handle(handle)}}
+		cmd.Env = []string{"ORBWIN_FRESH_ANCHOR_CHILD=yes", "ORBWIN_FRESH_ANCHOR_DESCRIPTOR=" + strconv.FormatUint(uint64(handle), 10) + "," + strconv.FormatUint(uint64(id.Volume), 10) + "," + strconv.FormatUint(uint64(id.IndexHigh), 10) + "," + strconv.FormatUint(uint64(id.IndexLow), 10)}
+		return cmd.Start()
+	})
+	if err != nil {
+		t.Fatal("child start refused")
+	}
+	if transfer.Start(func(uintptr, AnchorIdentity) error { t.Fatal("transfer reused"); return nil }) != ErrCreate {
+		t.Fatal("reused transfer accepted")
+	}
+	if transfer.Close() != nil || created.Close() != nil || parent.Close() != nil {
+		input.Close()
+		cmd.Wait()
+		t.Fatal("parent retirement")
+	}
+	_, signalErr := input.Write([]byte("x"))
+	input.Close()
+	waitErr := cmd.Wait()
+	if signalErr != nil || waitErr != nil {
+		t.Fatal("controlled child refused: " + output.String())
+	}
+}
+
+func TestAnchorTransferClosedAndWrongObjectRefusal(t *testing.T) {
+	parent, _, _ := fixture(t)
+	created, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer created.Close()
+	transfer, err := created.PrepareAnchorInheritance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transfer.Close()
+	err = transfer.Start(func(handle uintptr, id AnchorIdentity) error {
+		// A separate test-only duplicate is consumed by the refusal path.
+		var h windows.Handle
+		if windows.DuplicateHandle(windows.CurrentProcess(), windows.Handle(handle), windows.CurrentProcess(), &h, 0, true, windows.DUPLICATE_SAME_ACCESS) != nil {
+			t.Fatal("duplicate")
+		}
+		id.IndexLow ^= 1
+		if got, e := ConsumeInheritedAnchor(uintptr(h), id); got != nil || e != ErrCreate {
+			t.Fatal("different object accepted")
+		}
+		var info windows.ByHandleFileInformation
+		if windows.GetFileInformationByHandle(h, &info) == nil {
+			windows.CloseHandle(h)
+			t.Fatal("refused handle leaked")
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if created.Close() != nil {
+		t.Fatal("close")
+	}
+	if got, e := created.PrepareAnchorInheritance(); e != ErrCreate || got != nil {
+		t.Fatal("closed creator reused")
+	}
+}
+
+func TestAnchorTransferCloseWaitsForExistingStart(t *testing.T) {
+	parent, _, _ := fixture(t)
+	created, err := createFreshDefault(context.Background(), parent, []byte("fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer created.Close()
+	transfer, err := created.PrepareAnchorInheritance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transfer.Close()
+	entered, release, started, closed := make(chan struct{}), make(chan struct{}), make(chan error, 1), make(chan error, 1)
+	go func() {
+		started <- transfer.Start(func(raw uintptr, id AnchorIdentity) error {
+			close(entered)
+			<-release
+			if got, e := anchorIdentity(windows.Handle(raw)); e != nil || got != id {
+				return ErrCreate
+			}
+			return nil
+		})
+	}()
+	<-entered
+	go func() { closed <- transfer.Close() }()
+	// Deterministic safety assertion lives inside the locked callback: Close
+	// cannot invalidate its handle even if scheduled first after this point.
+	close(release)
+	if <-started != nil || <-closed != nil {
+		t.Fatal("launch/close ownership race")
+	}
+	if transfer.Start(func(uintptr, AnchorIdentity) error { t.Fatal("closed start callback"); return nil }) != ErrCreate {
+		t.Fatal("closed transfer reused")
+	}
+}
diff --git a/rdd/pkg/managementconfig/authority.go b/rdd/pkg/managementconfig/authority.go
new file mode 100644
index 0000000..968b43b
--- /dev/null
+++ b/rdd/pkg/managementconfig/authority.go
@@ -0,0 +1,389 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"net"
+	"net/url"
+	"strconv"
+	"sync"
+
+	"sigs.k8s.io/yaml"
+)
+
+var ErrPublication = errors.New("private management publication refused")
+
+// ServingBinding is public identity supplied by the existing owning service
+// from its completed external SecureServing and native current process. It is
+// not authentication of arbitrary argv, nor a second configuration authority.
+type ServingBinding struct {
+	PID         uint32
+	Creation    uint64
+	Session     uint32
+	Endpoint    string
+	Certificate [32]byte
+}
+
+func BindServing(pid uint32, creation uint64, session uint32, endpoint string, certificate []byte) (ServingBinding, error) {
+	digest, err := authorityCertificate(certificate)
+	b := ServingBinding{pid, creation, session, endpoint, digest}
+	if err != nil || !b.valid() {
+		return ServingBinding{}, ErrPublication
+	}
+	return b, nil
+}
+func (b ServingBinding) valid() bool {
+	u, err := url.Parse(b.Endpoint)
+	if err != nil || u.Scheme != "https" || u.User != nil || u.Opaque != "" || u.Path != "" || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "::1") {
+		return false
+	}
+	p, err := strconv.Atoi(u.Port())
+	return err == nil && p > 0 && p <= 65535 && u.Port() == strconv.Itoa(p) && b.Endpoint == "https://"+net.JoinHostPort(u.Hostname(), strconv.Itoa(p)) && b.PID > 0 && b.Creation > 0 && b.Session > 0 && b.Certificate != [32]byte{}
+}
+func authorityCertificate(data []byte) ([32]byte, error) {
+	block, rest := pem.Decode(data)
+	if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 || len(rest) != 0 {
+		return [32]byte{}, ErrPublication
+	}
+	if _, err := x509.ParseCertificate(block.Bytes); err != nil {
+		return [32]byte{}, ErrPublication
+	}
+	return sha256.Sum256(block.Bytes), nil
+}
+
+// DefaultAuthorityMaterial is used only for the pinned default generated
+// authority. Existing upstream generators must supply bytes in memory before
+// their path writers execute; no key is taken from renderer/settings JSON.
+// The three private files are CREATE_NEW only, never a multi-file rotation.
+func validateAuthorityMaterial(certPEM, keyPEM, saPEM []byte) error {
+	if len(certPEM) > 64<<10 || len(keyPEM) > 64<<10 || len(saPEM) > 64<<10 || len(keyPEM) == 0 || len(saPEM) == 0 {
+		return ErrPublication
+	}
+	if _, e := authorityCertificate(certPEM); e != nil {
+		return ErrPublication
+	}
+	keyBlock, keyRest := pem.Decode(keyPEM)
+	if keyBlock == nil || len(keyRest) != 0 || len(keyBlock.Headers) != 0 {
+		return ErrPublication
+	}
+	pair, e := tls.X509KeyPair(certPEM, keyPEM)
+	if e != nil || len(pair.Certificate) != 1 {
+		return ErrPublication
+	}
+	cert, e := x509.ParseCertificate(pair.Certificate[0])
+	if e != nil || cert.VerifyHostname("127.0.0.1") != nil {
+		return ErrPublication
+	}
+	block, rest := pem.Decode(saPEM)
+	if block == nil || len(rest) != 0 || len(block.Headers) != 0 {
+		return ErrPublication
+	}
+	var sa any
+	switch block.Type {
+	case "RSA PRIVATE KEY":
+		sa, e = x509.ParsePKCS1PrivateKey(block.Bytes)
+	case "EC PRIVATE KEY":
+		sa, e = x509.ParseECPrivateKey(block.Bytes)
+	case "PRIVATE KEY":
+		sa, e = x509.ParsePKCS8PrivateKey(block.Bytes)
+	default:
+		return ErrPublication
+	}
+	if e != nil || sa == nil {
+		return ErrPublication
+	}
+	// Separate service-account signing and TLS identities, even if PEM encoding
+	// differs. Native key readers remain metadata-only after preparation.
+	tlsDER, e := x509.MarshalPKCS8PrivateKey(pair.PrivateKey)
+	if e != nil {
+		return ErrPublication
+	}
+	defer clear(tlsDER)
+	saDER, e := x509.MarshalPKCS8PrivateKey(sa)
+	if e != nil {
+		return ErrPublication
+	}
+	defer clear(saDER)
+	if sha256.Sum256(tlsDER) == sha256.Sum256(saDER) {
+		return ErrPublication
+	}
+	return nil
+}
+
+// Exact file object identity is required in addition to content. A new process
+// may legitimately publish a new token using the same protected TLS authority.
+type ConfigVersion struct {
+	Present           bool
+	Volume, High, Low uint32
+	Hash              [32]byte
+}
+
+func (v ConfigVersion) valid() bool {
+	if !v.Present {
+		return v == (ConfigVersion{})
+	}
+	return (v.High != 0 || v.Low != 0) && v.Hash != [32]byte{}
+}
+
+type PublicationReceipt struct {
+	Stage             string
+	Unknown           bool
+	Before, Candidate ConfigVersion
+}
+
+func (PublicationReceipt) String() string   { return "private management publication receipt" }
+func (PublicationReceipt) GoString() string { return "private management publication receipt" }
+
+// Native sharing/rename semantics require scoped qualification. The interface is
+// private and fixed to config.yaml; no renderer path/filename operation exists.
+type authorityBackend interface {
+	acquire(context.Context) (authorityLease, error)
+	close() error
+}
+type authorityLease interface {
+	check(context.Context, ServingBinding) error
+	current(context.Context) (ConfigVersion, error)
+	stage(context.Context, []byte) (ConfigVersion, error)
+	flush(context.Context) error
+	publish(context.Context, bool) error
+	verify(context.Context, ConfigVersion) error
+	close() error
+}
+type ConfigPublisher struct {
+	mu      sync.Mutex
+	closed  bool
+	pending *PublicationReceipt
+	backend authorityBackend
+	serving ServingBinding
+}
+
+func (*ConfigPublisher) String() string   { return "private management config publisher" }
+func (*ConfigPublisher) GoString() string { return "private management config publisher" }
+func (p *ConfigPublisher) Close() error {
+	if p == nil {
+		return nil
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return nil
+	}
+	p.closed = true
+	if p.backend == nil {
+		return nil
+	}
+	return p.backend.close()
+}
+
+// ObserveCurrent produces the exact predecessor from the retained instance,
+// without returning credential bytes. A pending uncertain operation requires
+// its own exact Observe receipt instead; this is not a retry/repair shortcut.
+func (p *ConfigPublisher) ObserveCurrent(ctx context.Context) (version ConfigVersion, err error) {
+	if p == nil || ctx == nil || ctx.Err() != nil || !p.mu.TryLock() {
+		return ConfigVersion{}, ErrPublication
+	}
+	defer p.mu.Unlock()
+	if p.closed || p.pending != nil || p.backend == nil || !p.serving.valid() {
+		return ConfigVersion{}, ErrPublication
+	}
+	lease, e := p.backend.acquire(ctx)
+	if e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	defer func() {
+		if lease.close() != nil {
+			version = ConfigVersion{}
+			err = ErrPublication
+		}
+	}()
+	if lease.check(ctx, p.serving) != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	version, e = lease.current(ctx)
+	if e != nil || !version.valid() || ctx.Err() != nil || lease.check(ctx, p.serving) != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	return version, nil
+}
+
+// Publish changes only config.yaml. One owner, no queue/replay/fallback truncate.
+// Rename is conditional under the cooperative writer lease, not external-root
+// filesystem CAS. A failure after entering publish is unknown, even on cancel.
+// Re-observation is explicitly read-only; this method never retries publication.
+func (p *ConfigPublisher) Publish(ctx context.Context, before ConfigVersion, data []byte) (receipt PublicationReceipt, err error) {
+	receipt = PublicationReceipt{Stage: "input", Before: before}
+	if p == nil || ctx == nil || ctx.Err() != nil || !before.valid() {
+		return receipt, ErrPublication
+	}
+	if !p.mu.TryLock() {
+		return receipt, ErrPublication
+	}
+	defer p.mu.Unlock()
+	if p.closed || p.pending != nil || p.backend == nil || !p.serving.valid() || validatePublication(data, p.serving) != nil {
+		return receipt, ErrPublication
+	}
+	receipt.Stage = "writer"
+	lease, e := p.backend.acquire(ctx)
+	if e != nil {
+		return receipt, ErrPublication
+	}
+	defer func() {
+		if lease.close() != nil {
+			receipt.Unknown = true
+			err = ErrPublication
+		}
+		if receipt.Unknown {
+			copy := receipt
+			p.pending = &copy
+		}
+	}()
+	check := func(stage string, fn func() error) bool {
+		receipt.Stage = stage
+		if ctx.Err() != nil {
+			return false
+		}
+		return fn() == nil
+	}
+	if !check("authority", func() error { return lease.check(ctx, p.serving) }) {
+		return receipt, ErrPublication
+	}
+	current, e := lease.current(ctx)
+	if e != nil || current != before {
+		receipt.Stage = "predecessor"
+		return receipt, ErrPublication
+	}
+	receipt.Stage = "stage"
+	receipt.Candidate, e = lease.stage(ctx, data)
+	if e != nil || !receipt.Candidate.Present || !receipt.Candidate.valid() || receipt.Candidate.Hash != sha256.Sum256(data) {
+		return receipt, ErrPublication
+	}
+	if !check("flush", func() error { return lease.flush(ctx) }) || !check("authority-recheck", func() error { return lease.check(ctx, p.serving) }) {
+		return receipt, ErrPublication
+	}
+	receipt.Stage = "predecessor-recheck"
+	current, e = lease.current(ctx)
+	if e != nil || current != before || ctx.Err() != nil {
+		return receipt, ErrPublication
+	}
+	receipt.Stage = "publish"
+	receipt.Unknown = true
+	if lease.publish(ctx, before.Present) != nil {
+		return receipt, ErrPublication
+	}
+	if !check("verify", func() error { return lease.verify(ctx, receipt.Candidate) }) {
+		return receipt, ErrPublication
+	}
+	if !check("authority-final", func() error { return lease.check(ctx, p.serving) }) {
+		return receipt, ErrPublication
+	}
+	receipt.Stage = "visible"
+	receipt.Unknown = false
+	return receipt, nil
+}
+
+// Observe never repeats a failed rename. "candidate-visible" is a current
+// observation only, not a power-loss durability or acknowledged commit claim.
+func (p *ConfigPublisher) Observe(ctx context.Context, receipt PublicationReceipt) (string, error) {
+	if p == nil || ctx == nil || ctx.Err() != nil || !receipt.Before.valid() || !receipt.Candidate.valid() || !receipt.Candidate.Present || !p.mu.TryLock() {
+		return "unknown", ErrPublication
+	}
+	defer p.mu.Unlock()
+	if p.closed || p.backend == nil || !p.serving.valid() || p.pending == nil || *p.pending != receipt {
+		return "unknown", ErrPublication
+	}
+	lease, e := p.backend.acquire(ctx)
+	if e != nil {
+		return "unknown", ErrPublication
+	}
+	result := "unknown"
+	if lease.check(ctx, p.serving) == nil {
+		current, e := lease.current(ctx)
+		if e == nil {
+			if current == receipt.Candidate {
+				result = "candidate-visible"
+			} else if current == receipt.Before {
+				result = "predecessor-visible"
+			}
+		}
+	}
+	if lease.close() != nil || ctx.Err() != nil || result == "unknown" {
+		return "unknown", ErrPublication
+	}
+	p.pending = nil
+	return result, nil
+}
+
+// This exact subset matches pinned CreateKubeConfig. Parsing never invokes
+// clientcmd loaders/plugins, files or a transport. Unknown/duplicate fields,
+// credential references and TLS overrides refuse before staging.
+type publicationDocument struct {
+	Kind        string   `json:"kind"`
+	APIVersion  string   `json:"apiVersion"`
+	Preferences struct{} `json:"preferences"`
+	Clusters    []struct {
+		Name    string `json:"name"`
+		Cluster struct {
+			Server string `json:"server"`
+			CA     []byte `json:"certificate-authority-data"`
+		} `json:"cluster"`
+	} `json:"clusters"`
+	Users []struct {
+		Name string `json:"name"`
+		User struct {
+			Token string `json:"token"`
+		} `json:"user"`
+	} `json:"users"`
+	Contexts []struct {
+		Name    string `json:"name"`
+		Context struct {
+			Cluster string `json:"cluster"`
+			User    string `json:"user"`
+		} `json:"context"`
+	} `json:"contexts"`
+	Current string `json:"current-context"`
+}
+
+func validatePublication(data []byte, b ServingBinding) error {
+	if len(data) < 1 || len(data) > 1<<20 {
+		return ErrPublication
+	}
+	var d publicationDocument
+	if yaml.UnmarshalStrict(data, &d) != nil || d.Kind != "Config" || d.APIVersion != "v1" || d.Current != "root" || len(d.Clusters) != 1 || d.Clusters[0].Name != "root" || d.Clusters[0].Cluster.Server != b.Endpoint || len(d.Users) < 1 || len(d.Users) > 2 || len(d.Contexts) != len(d.Users) {
+		return ErrPublication
+	}
+	h, e := authorityCertificate(d.Clusters[0].Cluster.CA)
+	if e != nil || h != b.Certificate {
+		return ErrPublication
+	}
+	users := map[string]bool{}
+	contexts := map[string]bool{}
+	for _, u := range d.Users {
+		if users[u.Name] || u.Name != "system-admin" && u.Name != "user" || len(u.User.Token) < 1 || len(u.User.Token) > 4096 {
+			return ErrPublication
+		}
+		for _, r := range u.User.Token {
+			if r < 33 || r > 126 {
+				return ErrPublication
+			}
+		}
+		users[u.Name] = true
+	}
+	for _, c := range d.Contexts {
+		expected := c.Name
+		if expected == "root" {
+			expected = "system-admin"
+		}
+		if contexts[c.Name] || c.Name != "root" && c.Name != "user" || !users[expected] || c.Context.User != expected || c.Context.Cluster != "root" {
+			return ErrPublication
+		}
+		contexts[c.Name] = true
+	}
+	if !contexts["root"] || !users["system-admin"] {
+		return ErrPublication
+	}
+	return nil
+}
