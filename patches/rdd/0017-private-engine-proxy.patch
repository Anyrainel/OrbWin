+package hostagent
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestProxyBindingFlagRefusalDoesNotAbortHostagentCommandParsing(t *testing.T) {
+	for _, args := range [][]string{{"--orbwin-proxy-binding", "malformed", "owned"}, {"--orbwin-proxy-binding", "first", "--orbwin-proxy-binding", "second", "owned"}, {"--orbwin-proxy-binding", strings.Repeat("x", 2049), "owned"}} {
+		cmd := NewCommand()
+		if err := cmd.ParseFlags(args); err != nil {
+			t.Fatal("proxy refusal aborted ordinary command parsing")
+		}
+		if value := cmd.Flags().Lookup("orbwin-proxy-binding").Value.String(); value != "" {
+			t.Fatal("private metadata escaped String")
+		}
+		if got := openProxyBinding(context.Background(), cmd); got != nil {
+			got.Close()
+			t.Fatal("invalid binding initialized")
+		}
+	}
+}
diff --git a/rdd/pkg/hostagent/proxy_retirement.go b/rdd/pkg/hostagent/proxy_retirement.go
new file mode 100644
index 0000000..d978bb4
--- /dev/null
+++ b/rdd/pkg/hostagent/proxy_retirement.go
@@ -0,0 +1,51 @@
+package hostagent
+
+import (
+	"context"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+)
+
+// retireProxyConsumer is invoked once as the existing hostagent is already
+// exiting. It cancels first, then bounds consumer join and one cleanup attempt.
+// Unknown retirement is NOT proof that a blocked native call was preempted.
+// The original process's final exit owns that worker's ultimate reclamation.
+// No second consumer, cleanup replay, detached retry, or engine action is added.
+func retireProxyConsumer(cancel context.CancelFunc, done <-chan struct{}, closeProxy func(context.Context) error, budget time.Duration) error {
+	if cancel != nil {
+		cancel()
+	}
+	if done == nil || closeProxy == nil || budget <= 0 {
+		return networkproxy.ErrProxyRetirement
+	}
+	ctx, stop := context.WithTimeout(context.Background(), budget)
+	defer stop()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		return networkproxy.ErrProxyRetirement
+	}
+	if ctx.Err() != nil {
+		return networkproxy.ErrProxyRetirement
+	}
+	// A future process-bounded native provider must uphold its own retirement
+	// contract. The caller still never waits past its exit budget if that fails.
+	retired := make(chan error, 1)
+	go func() {
+		if ctx.Err() != nil {
+			retired <- networkproxy.ErrProxyRetirement
+			return
+		}
+		retired <- closeProxy(ctx)
+	}()
+	select {
+	case err := <-retired:
+		if err != nil {
+			return networkproxy.ErrProxyRetirement
+		}
+		return nil
+	case <-ctx.Done():
+		return networkproxy.ErrProxyRetirement
+	}
+}
diff --git a/rdd/pkg/hostagent/proxy_retirement_test.go b/rdd/pkg/hostagent/proxy_retirement_test.go
new file mode 100644
index 0000000..f6a0afa
--- /dev/null
+++ b/rdd/pkg/hostagent/proxy_retirement_test.go
@@ -0,0 +1,61 @@
+package hostagent
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+)
+
+func TestProxyExitUnknownConsumerJoinDoesNotBlockOrStartCleanup(t *testing.T) {
+	done := make(chan struct{})
+	var cancels, closes atomic.Int32
+	start := time.Now()
+	err := retireProxyConsumer(func() { cancels.Add(1) }, done, func(context.Context) error { closes.Add(1); return nil }, 30*time.Millisecond)
+	if err != networkproxy.ErrProxyRetirement || cancels.Load() != 1 || closes.Load() != 0 || time.Since(start) > time.Second {
+		t.Fatal("unjoined consumer blocked exit or triggered competing cleanup")
+	}
+	close(done) // synthetic blocked observer may finally retire; no replay follows.
+	if closes.Load() != 0 {
+		t.Fatal("unknown join retried cleanup")
+	}
+}
+
+func TestProxyExitUnknownCleanupIsSingleOwnedAttempt(t *testing.T) {
+	done := make(chan struct{})
+	close(done)
+	entered, release, retired := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var calls atomic.Int32
+	err := retireProxyConsumer(func() {}, done, func(context.Context) error {
+		calls.Add(1)
+		close(entered)
+		<-release
+		close(retired)
+		return nil
+	}, 30*time.Millisecond)
+	if err != networkproxy.ErrProxyRetirement || calls.Load() != 1 {
+		close(release)
+		t.Fatal("blocked cleanup replayed or hid unknown retirement")
+	}
+	<-entered
+	close(release)
+	select {
+	case <-retired:
+	case <-time.After(time.Second):
+		t.Fatal("synthetic cleanup worker leaked")
+	}
+	if calls.Load() != 1 {
+		t.Fatal("late completion replayed cleanup")
+	}
+}
+
+func TestProxyExitJoinedConsumerClosesOnce(t *testing.T) {
+	done := make(chan struct{})
+	close(done)
+	var calls atomic.Int32
+	if retireProxyConsumer(func() {}, done, func(ctx context.Context) error { calls.Add(1); return ctx.Err() }, time.Second) != nil || calls.Load() != 1 {
+		t.Fatal("normal retirement failed")
+	}
+}
