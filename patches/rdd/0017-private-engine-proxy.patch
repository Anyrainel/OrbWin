@@ -0,0 +1,125 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// Compile-only until separately reviewed. New fixture state and the currently
+// executing test image only; no product state, socket or launched child.
+func TestPrivateServiceGenerationCoherentNativeReader(t *testing.T) {
+	if os.Getenv("ORBWIN_QUALIFY_SERVICE_GENERATION") != "1" {
+		t.Skip("fresh native service-generation qualification requires explicit review")
+	}
+	ctx := context.Background()
+	parent, dir, sid := fixture(t)
+	fresh, err := createFreshAuthority(ctx, parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		for _, relative := range []string{"tls/apiserver.crt", "tls/apiserver.key", "tls/sa.key", "tls", "db", serviceGenerationName, "management.writer.lock"} {
+			if err := os.Remove(filepath.Join(dir, anchorName, filepath.FromSlash(relative))); err != nil && !os.IsNotExist(err) {
+				t.Error("known fixture cleanup failed")
+			}
+		}
+	})
+	binding, config := publicationFixture(t)
+	var document publicationDocument
+	if json.Unmarshal(config, &document) != nil {
+		t.Fatal("fixture config")
+	}
+	key := ed25519.NewKeyFromSeed(make([]byte, ed25519.SeedSize))
+	sa := ed25519.NewKeyFromSeed([]byte(strings.Repeat("b", ed25519.SeedSize)))
+	keyDER, _ := x509.MarshalPKCS8PrivateKey(key)
+	saDER, _ := x509.MarshalPKCS8PrivateKey(sa)
+	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER})
+	saPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: saDER})
+	defer clear(keyPEM)
+	defer clear(saPEM)
+	clear(keyDER)
+	clear(saDER)
+	if fresh.CreateDefaultAuthorityFiles(ctx, document.Clusters[0].Cluster.CA, keyPEM, saPEM) != nil || fresh.Close() != nil {
+		t.Fatal("fresh synthetic authority")
+	}
+	h, err := openRelative(parent.leaf(), anchorName, true, nil, false)
+	if err != nil || verifyPrivate(h, sid, true) != nil {
+		t.Fatal("shareable authority")
+	}
+	parents, err := parent.retain()
+	if err != nil {
+		windows.CloseHandle(h)
+		t.Fatal(err)
+	}
+	owner := &Created{parents: parents, parent: parents.leaf(), anchor: h, servingLease: true}
+	defer owner.Close()
+	var creation, exit, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(windows.CurrentProcess(), &creation, &exit, &kernel, &user) != nil || windows.ProcessIdToSessionId(uint32(os.Getpid()), &session) != nil || session == 0 {
+		t.Fatal("current fixture process")
+	}
+	binding.PID, binding.Creation, binding.Session = uint32(os.Getpid()), uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime), session
+	publisher, err := owner.NewConfigPublisher(ctx, binding)
+	if err != nil {
+		t.Fatal("publisher")
+	}
+	defer publisher.Close()
+	before, err := publisher.ObserveCurrent(ctx)
+	if err != nil {
+		t.Fatal("predecessor")
+	}
+	receipt, err := publisher.Publish(ctx, before, config)
+	if err != nil || owner.PublishServiceGeneration(ctx, binding, receipt.Candidate) != nil {
+		t.Fatal("fixed service-generation publication")
+	}
+	var duplicate windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), owner.anchor, windows.CurrentProcess(), &duplicate, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		t.Fatal("retained fixture anchor")
+	}
+	received := &ReceivedAnchor{handle: duplicate}
+	defer received.Close()
+	reader, generation, err := received.OpenGenerationReader(ctx)
+	if err != nil || generation.Serving != binding || generation.Config != receipt.Candidate {
+		t.Fatal("coherent fixed snapshot")
+	}
+	read, err := io.ReadAll(reader)
+	closeErr := reader.Close()
+	if err != nil || closeErr != nil || string(read) != string(config) {
+		clear(read)
+		t.Fatal("exact credential snapshot")
+	}
+	clear(read)
+	// A cancelled observation never supplies a reader or replacement token.
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if reader, _, err := received.OpenGenerationReader(cancelled); reader != nil || err == nil {
+		if reader != nil {
+			reader.Close()
+		}
+		t.Fatal("cancelled snapshot admitted")
+	}
+	// Config publication preceding its generation receipt is deliberately
+	// incoherent. A reader must refuse instead of loading an unbound token.
+	next := []byte(strings.Replace(string(config), "fresh-test-secret", "changed-test-secret", 1))
+	if _, err := publisher.Publish(ctx, receipt.Candidate, next); err != nil {
+		t.Fatal("next fixed config")
+	}
+	if reader, _, err := received.OpenGenerationReader(ctx); reader != nil || err == nil {
+		if reader != nil {
+			reader.Close()
+		}
+		t.Fatal("incoherent generation admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/service_image_windows.go b/rdd/pkg/managementconfig/service_image_windows.go
new file mode 100644
index 0000000..6034083
--- /dev/null
+++ b/rdd/pkg/managementconfig/service_image_windows.go
@@ -0,0 +1,125 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+	"os"
+	"runtime"
+	"strings"
+
+	"golang.org/x/sys/windows"
+)
+
+// ObserveServiceImage observes a live process, its owner/session/creation, and
+// the held image file named by the process. Native mapping/sharing semantics
+// still require qualification; this is not code-signing or a same-user sandbox.
+// The caller obtains g only through the retained private authority, and must
+// compare the digest with the independently observed initial launcher image.
+func ObserveServiceImage(ctx context.Context, b ServingBinding) (digest [32]byte, result error) {
+	var zero [32]byte
+	if ctx == nil || ctx.Err() != nil || !b.valid() {
+		return zero, ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil {
+		return zero, ErrPublication
+	}
+	p, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, b.PID)
+	if err != nil {
+		return zero, ErrPublication
+	}
+	defer func() {
+		if windows.CloseHandle(p) != nil {
+			digest = [32]byte{}
+			result = ErrPublication
+		}
+	}()
+	check := func() bool {
+		var creation, exit, kernel, user windows.Filetime
+		var session uint32
+		state, e := windows.WaitForSingleObject(p, 0)
+		return e == nil && state == uint32(windows.WAIT_TIMEOUT) && windows.GetProcessTimes(p, &creation, &exit, &kernel, &user) == nil && uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime) == b.Creation && windows.ProcessIdToSessionId(b.PID, &session) == nil && session == b.Session
+	}
+	if !check() {
+		return zero, ErrPublication
+	}
+	var token windows.Token
+	if windows.OpenProcessToken(p, windows.TOKEN_QUERY, &token) != nil {
+		return zero, ErrPublication
+	}
+	defer func() {
+		if token.Close() != nil {
+			digest = [32]byte{}
+			result = ErrPublication
+		}
+	}()
+	user, err := token.GetTokenUser()
+	if err != nil || user.User.Sid.String() != sid {
+		return zero, ErrPublication
+	}
+	path := make([]uint16, 1024)
+	size := uint32(len(path))
+	if windows.QueryFullProcessImageName(p, 0, &path[0], &size) != nil || size == 0 || size >= uint32(len(path)) {
+		return zero, ErrPublication
+	}
+	name := windows.UTF16ToString(path[:size])
+	pointer, err := windows.UTF16PtrFromString(name)
+	if err != nil {
+		return zero, ErrPublication
+	}
+	h, err := windows.CreateFile(pointer, windows.GENERIC_READ|windows.READ_CONTROL, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return zero, ErrPublication
+	}
+	f := os.NewFile(uintptr(h), "held service image")
+	defer func() {
+		if f.Close() != nil {
+			digest = [32]byte{}
+			result = ErrPublication
+		}
+	}()
+	if objectKind(h, false) != nil {
+		return zero, ErrPublication
+	}
+	var final [1024]uint16
+	n, err := windows.GetFinalPathNameByHandle(h, &final[0], uint32(len(final)), 0)
+	if err != nil || n == 0 || n >= uint32(len(final)) || !strings.EqualFold(strings.TrimPrefix(windows.UTF16ToString(final[:n]), `\\?\`), name) {
+		return zero, ErrPublication
+	}
+	info, err := f.Stat()
+	if err != nil || info.Size() < 1 || info.Size() > 512<<20 {
+		return zero, ErrPublication
+	}
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total int64
+	for {
+		if ctx.Err() != nil {
+			return zero, ErrPublication
+		}
+		n, e := f.Read(buffer)
+		total += int64(n)
+		if total > 512<<20 {
+			return zero, ErrPublication
+		}
+		if n > 0 {
+			_, _ = hash.Write(buffer[:n])
+		}
+		if e == io.EOF {
+			break
+		}
+		if e != nil {
+			return zero, ErrPublication
+		}
+	}
+	if total != info.Size() || !check() || ctx.Err() != nil {
+		return zero, ErrPublication
+	}
+	copy(zero[:], hash.Sum(nil))
+	return zero, nil
+}
