+type readObservedConnection struct {
+	net.Conn
+	once     sync.Once
+	observed chan<- struct{}
+}
+
+func (connection *readObservedConnection) Read(buffer []byte) (int, error) {
+	connection.once.Do(func() { connection.observed <- struct{}{} })
+	return connection.Conn.Read(buffer)
+}
+
+type readObservedListener struct {
+	net.Listener
+	observed chan<- struct{}
+}
+
+func (listener readObservedListener) Accept() (net.Conn, error) {
+	connection, err := listener.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	return &readObservedConnection{Conn: connection, observed: listener.observed}, nil
+}
+
+func TestForwardServerAdmissionHeaderShutdownFailureAndForeignPeer(t *testing.T) {
+	policy, _ := New(Config{Version: 1, Mode: "none"}, nil)
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	observed := make(chan struct{}, 64)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		done <- ServeForwardProxy(ctx, readObservedListener{listener, observed}, netip.MustParseAddr("127.0.0.1"), policy, fixtureDuplex)
+	}()
+	for index := 0; index < 64; index++ {
+		connection, err := net.Dial("tcp", listener.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer connection.Close()
+	}
+	for index := 0; index < 64; index++ {
+		select {
+		case <-observed:
+		case <-time.After(time.Second):
+			t.Fatal("header connections not admitted")
+		}
+	}
+	connection, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	connection.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := connection.Read(make([]byte, 1)); err == nil {
+		t.Fatal("admission bound did not close excess socket")
+	} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("excess socket merely timed out instead of closing")
+	}
+	// Unexpected Accept failure must cancel all blocked header handlers and join.
+	listener.Close()
+	awaitProxyStop(t, done, true)
+	foreign, cancelForeign, foreignDone := proxyServerFixture(t, policy, "127.0.0.2")
+	connection, reader := sendProxyFixture(t, foreign, "GET http://destination.example/ HTTP/1.1\r\nHost: destination.example\r\n\r\n")
+	if _, err := reader.ReadByte(); err == nil {
+		t.Fatal("foreign peer admitted")
+	} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("foreign peer remained open")
+	}
+	connection.Close()
+	cancelForeign()
+	awaitProxyStop(t, foreignDone, false)
+}
+
+func TestForwardServerFailureCancelsCONNECTDecisionBeforeDial(t *testing.T) {
+	entered := make(chan struct{})
+	var active atomic.Int32
+	policy, _ := New(Config{Version: 1, Mode: "auto"}, autoFunc(func(ctx context.Context, _ *url.URL) ([]Route, error) {
+		active.Add(1)
+		defer active.Add(-1)
+		close(entered)
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}))
+	listener, cancel, done := proxyServerFixture(t, policy, "127.0.0.1")
+	defer cancel()
+	connection, _ := sendProxyFixture(t, listener, "CONNECT destination.example:443 HTTP/1.1\r\nHost: destination.example:443\r\n\r\n")
+	defer connection.Close()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("decision did not begin")
+	}
+	listener.Close()
+	awaitProxyStop(t, done, true)
+	if active.Load() != 0 {
+		t.Fatal("server returned while CONNECT decision remained owned")
+	}
+}
+
+func TestForwardServerRejectsOversizedAndNonCRLFHeaders(t *testing.T) {
+	policy, _ := New(Config{Version: 1, Mode: "none"}, nil)
+	listener, cancel, done := proxyServerFixture(t, policy, "127.0.0.1")
+	for _, raw := range []string{"GET http://destination.example/ HTTP/1.1\nHost: destination.example\n\n", "GET http://destination.example/ HTTP/1.1\r\nHost: destination.example\r\nX: " + strings.Repeat("a", 16<<10) + "\r\n\r\n"} {
+		connection, reader := sendProxyFixture(t, listener, raw)
+		response, err := http.ReadResponse(reader, nil)
+		if err != nil || response.StatusCode != 400 {
+			t.Fatal("malformed/oversized headers escaped", err)
+		}
+		response.Body.Close()
+		connection.Close()
+	}
+	cancel()
+	awaitProxyStop(t, done, false)
+}
diff --git a/rdd/pkg/networkproxy/transport.go b/rdd/pkg/networkproxy/transport.go
new file mode 100644
index 0000000..37e68a6
--- /dev/null
+++ b/rdd/pkg/networkproxy/transport.go
@@ -0,0 +1,192 @@
+package networkproxy
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+)
+
+// RoundTripHTTP handles one ordinary HTTP request with explicit routing. It
+// never retries a possibly accepted application request against another route.
+// HTTPS belongs to DialTunnel, preserving end-to-end guest TLS verification.
+// Per-request nonpersistent transports bound PAC-dependent connection ownership.
+func (policy *Policy) RoundTripHTTP(request *http.Request) (*http.Response, error) {
+	if request == nil || request.URL == nil || request.URL.Scheme != "http" || request.Method == "CONNECT" {
+		return nil, errors.New("ordinary HTTP request required; HTTPS uses an opaque tunnel")
+	}
+	routes, err := policy.Decide(request.Context(), request.URL)
+	if err != nil {
+		return nil, err
+	}
+	return policy.roundTripHTTP(request, routes)
+}
+
+// The server resolves once before granting 100 Continue. Reusing that immutable
+// decision prevents a second PAC evaluation from changing an admitted upload.
+func (policy *Policy) roundTripHTTP(request *http.Request, routes []Route) (*http.Response, error) {
+	if validateTrailerDeclaration(request.Header, request.Trailer) != nil {
+		return nil, errors.New("unsafe HTTP trailer declaration")
+	}
+	transport := &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: 5 * time.Second}).DialContext, TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12}, TLSHandshakeTimeout: 5 * time.Second, ResponseHeaderTimeout: 10 * time.Second, DisableKeepAlives: true, MaxResponseHeaderBytes: 32 << 10}
+	defer transport.CloseIdleConnections()
+	if !routes[0].Direct {
+		endpoint, _ := proxyURL(routes[0].Proxy)
+		transport.Proxy = http.ProxyURL(endpoint)
+	}
+	copyRequest := request.Clone(request.Context())
+	// Forward-proxy authority comes from the absolute request target, matching
+	// the per-destination decision; never preserve a conflicting Host override.
+	copyRequest.Host = request.URL.Host
+	copyRequest.Header = request.Header.Clone()
+	copyRequest.Header.Del("Proxy-Authorization")
+	copyRequest.Header.Del("Proxy-Connection")
+	copyRequest.RequestURI = ""
+	if copyRequest.Trailer == nil {
+		copyRequest.Trailer = make(http.Header)
+	}
+	copyRequest.Body = &streamedTrailerBody{ReadCloser: copyRequest.Body, source: func() http.Header { return request.Trailer }, declared: request.Trailer.Clone(), destination: copyRequest.Trailer}
+	response, err := transport.RoundTrip(copyRequest)
+	if err != nil {
+		return nil, errors.New("HTTP proxy route failed; application request was not replayed")
+	}
+	return response, nil
+}
+
+type retainedConn struct {
+	net.Conn
+	reader *bufio.Reader
+	stop   func() bool
+	once   sync.Once
+}
+
+func (connection *retainedConn) Read(buffer []byte) (int, error) {
+	return connection.reader.Read(buffer)
+}
+func (connection *retainedConn) CloseWrite() error {
+	if writer, ok := connection.Conn.(interface{ CloseWrite() error }); ok {
+		return writer.CloseWrite()
+	}
+	return errors.New("selected proxy connection does not support write half-close")
+}
+func (connection *retainedConn) Close() error {
+	connection.once.Do(func() {
+		if connection.stop != nil {
+			connection.stop()
+		}
+	})
+	return connection.Conn.Close()
+}
+
+func endpointAddress(endpoint *url.URL) string {
+	port := endpoint.Port()
+	if port == "" {
+		port = "80"
+		if endpoint.Scheme == "https" {
+			port = "443"
+		}
+	}
+	return net.JoinHostPort(endpoint.Hostname(), port)
+}
+
+// DialTunnel tries only the ordered routes explicitly authorized by Decide.
+// Retry is confined to establishment, before returning any application stream.
+// A successful CONNECT response's buffered bytes remain attached to the stream.
+func (policy *Policy) DialTunnel(ctx context.Context, authority string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(authority)
+	if err != nil || host == "" || !validPort(port) || !safeASCII(host, 253) {
+		return nil, errors.New("canonical explicit tunnel host and port required")
+	}
+	target := &url.URL{Scheme: "https", Host: net.JoinHostPort(host, port)}
+	routes, err := policy.Decide(ctx, target)
+	if err != nil {
+		return nil, err
+	}
+	for _, route := range routes {
+		if ctx.Err() != nil {
+			return nil, errors.New("proxy tunnel canceled")
+		}
+		connection, err := establish(ctx, target, route)
+		if err == nil {
+			return connection, nil
+		}
+	}
+	return nil, errors.New("all explicitly authorized tunnel routes failed; implicit direct fallback refused")
+}
+
+func establish(ctx context.Context, target *url.URL, route Route) (net.Conn, error) {
+	limited, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	destination := target.Host
+	var endpoint *url.URL
+	if !route.Direct {
+		endpoint, _ = proxyURL(route.Proxy)
+		destination = endpointAddress(endpoint)
+	}
+	connection, err := (&net.Dialer{Timeout: 5 * time.Second}).DialContext(limited, "tcp", destination)
+	if err != nil {
+		return nil, errors.New("tunnel connection unavailable")
+	}
+	success := false
+	defer func() {
+		if !success {
+			connection.Close()
+		}
+	}()
+	rawConnection := connection
+	stop := context.AfterFunc(limited, func() { rawConnection.Close() })
+	defer stop()
+	deadline, _ := limited.Deadline()
+	connection.SetDeadline(deadline)
+	if endpoint != nil && endpoint.Scheme == "https" {
+		secured := tls.Client(connection, &tls.Config{MinVersion: tls.VersionTLS12, ServerName: endpoint.Hostname()})
+		if secured.HandshakeContext(limited) != nil {
+			return nil, errors.New("HTTPS proxy certificate or handshake verification failed")
+		}
+		connection = secured
+	}
+	reader := bufio.NewReaderSize(connection, 4096)
+	if endpoint != nil {
+		request := &http.Request{Method: "CONNECT", URL: &url.URL{Opaque: target.Host}, Host: target.Host, Header: make(http.Header)}
+		if request.Write(connection) != nil {
+			return nil, errors.New("proxy tunnel request failed")
+		}
+		var header bytes.Buffer
+		for {
+			line, err := reader.ReadSlice('\n')
+			if err != nil || header.Len()+len(line) > 16<<10 {
+				return nil, errors.New("proxy tunnel response exceeded header bounds")
+			}
+			header.Write(line)
+			if bytes.Equal(line, []byte("\r\n")) {
+				break
+			}
+		}
+		response, err := http.ReadResponse(bufio.NewReader(bytes.NewReader(header.Bytes())), request)
+		if err != nil || response.StatusCode != 200 {
+			return nil, errors.New("proxy tunnel was refused")
+		}
+		// No response body is consumed: after a 200, all bytes are opaque.
+	}
+	if limited.Err() != nil {
+		return nil, errors.New("proxy tunnel establishment canceled")
+	}
+	connection.SetDeadline(time.Time{})
+	retained := &retainedConn{Conn: connection, reader: reader}
+	finalConnection := connection
+	retained.stop = context.AfterFunc(ctx, func() { finalConnection.Close() })
+	success = true
+	return retained, nil
+}
+
+// CopyOpaque is intentionally not a forward-proxy HTTP handler: rdd must own
+// stream admission and join lifetimes. Integration can reuse its qualified
+// half-close/backpressure primitive rather than creating a competing one here.
+var _ io.ReadWriteCloser = (*retainedConn)(nil)
