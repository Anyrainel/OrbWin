diff --git a/rdd/pkg/networkproxy/desired.go b/rdd/pkg/networkproxy/desired.go
new file mode 100644
index 0000000..f8a420f
--- /dev/null
+++ b/rdd/pkg/networkproxy/desired.go
@@ -0,0 +1,235 @@
+package networkproxy
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"math"
+	"reflect"
+	"sort"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+)
+
+const MaxProxyStreams = 64
+const MaxDrainingGenerations = 7
+
+func desiredConfig(spec *app.NetworkProxySpec) (Config, error) {
+	if spec == nil || spec.NoProxy == nil {
+		return Config{}, errors.New("explicit proxy configuration required")
+	}
+	config := Config{Version: spec.Version, Mode: spec.Mode, URL: spec.URL, NoProxy: append([]string{}, spec.NoProxy...)}
+	if config.Validate() != nil {
+		return Config{}, errors.New("invalid bounded proxy configuration; credentials are unsupported")
+	}
+	sort.Strings(config.NoProxy)
+	return config, nil
+}
+func DesiredDigest(spec *app.NetworkProxySpec) (string, error) {
+	config, err := desiredConfig(spec)
+	if err != nil {
+		return "", err
+	}
+	encoded, _ := json.Marshal(config)
+	sum := sha256.Sum256(encoded)
+	return hex.EncodeToString(sum[:]), nil
+}
+func hexIdentity(value string, length int) bool {
+	if len(value) != length {
+		return false
+	}
+	for _, character := range value {
+		if !(character >= '0' && character <= '9' || character >= 'a' && character <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+func validState(owner *app.App, state *app.NetworkProxyControllerStatus) bool {
+	return state != nil && state.AppUID == string(owner.UID) && state.ObservedGeneration > 0 && state.ObservedGeneration <= owner.Generation && state.ProxyRevision > 0 && hexIdentity(state.ConfigDigest, 64) && (state.Mode == "none" || state.Mode == "url" || state.Mode == "auto") && state.GuestAppliedRevision >= 0 && state.GuestAppliedRevision <= state.ProxyRevision
+}
+
+// ValidateDesiredTransition belongs to existing App admission. This validates
+// data/state only, not caller authentication or native identity observation.
+func ValidateDesiredTransition(old, next *app.App) error {
+	if next == nil {
+		return errors.New("App proxy intent required")
+	}
+	if next.Spec.NetworkProxy != nil {
+		if _, err := desiredConfig(next.Spec.NetworkProxy); err != nil {
+			return err
+		}
+	}
+	if old != nil && old.Spec.NetworkProxy != nil && next.Spec.NetworkProxy == nil && !safeRemoval(old) {
+		return errors.New("select explicit proxy mode none; managed compatibility endpoint requires retained None intent until full unmanage is supported")
+	}
+	return nil
+}
+func safeRemoval(owner *app.App) bool {
+	state := owner.Status.NetworkProxy
+	if owner.Spec.NetworkProxy == nil || owner.Spec.NetworkProxy.Mode != "none" || !validState(owner, state) || state.Mode != "none" {
+		return false
+	}
+	digest, err := DesiredDigest(owner.Spec.NetworkProxy)
+	if err != nil || digest != state.ConfigDigest {
+		return false
+	}
+	if !state.ManagedEver {
+		return owner.Status.NetworkProxyHost == nil && state.Plan == nil && state.GuestAppliedRevision == 0
+	}
+	return false
+}
+
+type DesiredProjection struct {
+	// Action is unmanaged, unchanged, prepare, or disable. It performs nothing.
+	Action string
+	State  *app.NetworkProxyControllerStatus
+}
+
+// ProjectDesired never reads native state or authorizes guest writes/restarts.
+// Controller revision is derived only from the private proxy projection.
+func ProjectDesired(owner *app.App) (DesiredProjection, error) {
+	if owner == nil || owner.UID == "" || owner.Generation < 1 {
+		return DesiredProjection{}, errors.New("persisted App identity required")
+	}
+	previous := owner.Status.NetworkProxy
+	if previous != nil && !validState(owner, previous) {
+		return DesiredProjection{}, errors.New("proxy controller state identity or revision is invalid")
+	}
+	if owner.Spec.NetworkProxy == nil {
+		if previous == nil || !previous.ManagedEver {
+			if owner.Status.NetworkProxyHost != nil {
+				return DesiredProjection{}, errors.New("proxy host state exists without a retained managed intent")
+			}
+			return DesiredProjection{Action: "unmanaged"}, nil
+		}
+		return DesiredProjection{}, errors.New("managed proxy intent cannot be unset; select and retain explicit none")
+	}
+	digest, err := DesiredDigest(owner.Spec.NetworkProxy)
+	if err != nil {
+		return DesiredProjection{}, err
+	}
+	state := &app.NetworkProxyControllerStatus{AppUID: string(owner.UID), ObservedGeneration: owner.Generation, ProxyRevision: 1, ConfigDigest: digest, Mode: owner.Spec.NetworkProxy.Mode}
+	if previous != nil {
+		state = previous.DeepCopy()
+		state.ObservedGeneration = owner.Generation
+		if state.ConfigDigest == digest {
+			if state.Mode != owner.Spec.NetworkProxy.Mode {
+				return DesiredProjection{}, errors.New("proxy digest/mode state mismatch")
+			}
+			return DesiredProjection{Action: "unchanged", State: state}, nil
+		}
+		if state.ProxyRevision == math.MaxInt64 {
+			return DesiredProjection{}, errors.New("proxy revision exhausted")
+		}
+		state.ProxyRevision++
+		state.ConfigDigest = digest
+		state.Mode = owner.Spec.NetworkProxy.Mode
+		state.Plan = nil
+	}
+	if host := owner.Status.NetworkProxyHost; host != nil {
+		if host.DrainingGenerations == nil || host.ActiveStreams == nil || *host.DrainingGenerations < 0 || *host.DrainingGenerations >= MaxDrainingGenerations || *host.ActiveStreams < 0 || *host.ActiveStreams > MaxProxyStreams {
+			return DesiredProjection{}, errors.New("proxy generation budget is exhausted or unknown")
+		}
+	}
+	action := "prepare"
+	if state.Mode == "none" {
+		action = "disable"
+		if !state.ManagedEver && owner.Status.NetworkProxyHost == nil {
+			action = "unchanged"
+		}
+	}
+	return DesiredProjection{Action: action, State: state}, nil
+}
+
+func validBinding(binding app.NetworkProxyBinding) bool {
+	return binding.LimaVMUID != "" && safeASCII(binding.LimaVMUID, 128) && binding.HostPID > 0 && binding.HostPID <= math.MaxUint32 && hexIdentity(binding.HostCreationTime, 16) && binding.HostCreationTime != "0000000000000000" && hexIdentity(binding.TransportEpoch, 32) && binding.TransportEpoch != "00000000000000000000000000000000"
+}
+
+// GuardProxyPlan must run against current API state AND independently observed
+// native binding just before activation. An earlier matching preflight is not CAS.
+func GuardProxyPlan(owner *app.App, plan *app.NetworkProxyPlan, observed app.NetworkProxyBinding) error {
+	if owner == nil || !validState(owner, owner.Status.NetworkProxy) || plan == nil || !validBinding(observed) || plan.Binding != observed || plan.AppUID != string(owner.UID) || plan.ObservedGeneration < 1 || plan.ObservedGeneration > owner.Generation {
+		return errors.New("proxy plan owner/process/epoch is stale or unavailable")
+	}
+	state := owner.Status.NetworkProxy
+	if state.Plan == nil || !reflect.DeepEqual(*state.Plan, *plan) {
+		return errors.New("proxy plan does not match current controller permission")
+	}
+	if plan.ProxyRevision != state.ProxyRevision || plan.ConfigDigest != state.ConfigDigest {
+		return errors.New("proxy plan revision or configuration changed")
+	}
+	if owner.Spec.NetworkProxy != nil {
+		digest, err := DesiredDigest(owner.Spec.NetworkProxy)
+		if err != nil || digest != plan.ConfigDigest || owner.Spec.NetworkProxy.Mode != state.Mode {
+			return errors.New("proxy desired configuration changed")
+		}
+	} else {
+		return errors.New("absent proxy intent cannot activate a plan")
+	}
+	if plan.Phase != "prepare" && plan.Phase != "commit" && plan.Phase != "disable" || state.Mode == "none" && plan.Phase != "disable" || state.Mode != "none" && plan.Phase == "disable" {
+		return errors.New("proxy plan phase does not match current intent")
+	}
+	return nil
+}
+
+func GuardHostObservation(owner *app.App, host *app.NetworkProxyHostStatus, observed app.NetworkProxyBinding) error {
+	if host == nil || owner == nil || owner.Status.NetworkProxy == nil || owner.Status.NetworkProxy.Plan == nil || !reflect.DeepEqual(host.Plan, *owner.Status.NetworkProxy.Plan) {
+		return errors.New("proxy host acknowledgement does not match controller plan")
+	}
+	if err := GuardProxyPlan(owner, &host.Plan, observed); err != nil {
+		return err
+	}
+	switch host.Phase {
+	case "prepared":
+		if host.Plan.Phase != "prepare" {
+			return errors.New("proxy preparation acknowledgement phase mismatch")
+		}
+	case "active":
+		if host.Plan.Phase != "commit" || owner.Status.NetworkProxy.Mode == "none" {
+			return errors.New("proxy active acknowledgement phase mismatch")
+		}
+	case "direct":
+		if host.Plan.Phase != "disable" || owner.Status.NetworkProxy.Mode != "none" {
+			return errors.New("proxy direct acknowledgement phase mismatch")
+		}
+	case "degraded":
+	default:
+		return errors.New("unsupported proxy host phase")
+	}
+	if host.Phase != "degraded" && host.Reason != "Ready" || host.Phase == "degraded" && host.Reason != "Unavailable" && host.Reason != "RetirementUnknown" && host.Reason != "BudgetExhausted" {
+		return errors.New("unsupported proxy host reason")
+	}
+	if host.ActiveStreams == nil || host.DrainingGenerations == nil {
+		if host.Phase != "degraded" {
+			return errors.New("proxy host counts are unknown")
+		}
+	} else if *host.ActiveStreams < 0 || *host.ActiveStreams > MaxProxyStreams || *host.DrainingGenerations < 0 || *host.DrainingGenerations > MaxDrainingGenerations {
+		return errors.New("proxy host counts exceed fixed budgets")
+	}
+	return nil
+}
+
+// These pure copies enforce field ownership, not API authorization. Actual API
+// writes still need optimistic RV checks and the authenticated caller's role.
+func WithHostObservation(owner *app.App, host *app.NetworkProxyHostStatus, observed app.NetworkProxyBinding) (*app.App, error) {
+	if err := GuardHostObservation(owner, host, observed); err != nil {
+		return nil, err
+	}
+	result := owner.DeepCopy()
+	result.Status.NetworkProxyHost = host.DeepCopy()
+	return result, nil
+}
+func WithControllerProjection(owner *app.App, projection DesiredProjection) (*app.App, error) {
+	if owner == nil {
+		return nil, errors.New("App required")
+	}
+	expected, err := ProjectDesired(owner)
+	if err != nil || !reflect.DeepEqual(expected, projection) {
+		return nil, errors.New("controller projection changed")
+	}
+	result := owner.DeepCopy()
+	result.Status.NetworkProxy = projection.State.DeepCopy()
+	return result, nil
+}
