+package proxyguestprotocol
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+type pendingBackend struct {
+	*memoryBackend
+	pending bool
+}
+
+func (b *pendingBackend) Acquire(ctx context.Context) (Lease, error) {
+	if _, err := b.memoryBackend.Acquire(ctx); err != nil {
+		return nil, err
+	}
+	return b, nil
+}
+func (b *pendingBackend) Observe(ctx context.Context) (Observation, error) {
+	if b.pending && b.restart > 0 {
+		return Observation{}, ErrPending
+	}
+	return b.memoryBackend.Observe(ctx)
+}
+
+func TestPendingDaemonReobservationSettlesWithoutMutationReplay(t *testing.T) {
+	r := fixtureRequest("url")
+	b := &pendingBackend{memoryBackend: fixtureBackend(r), pending: true}
+	for i := 0; i < 2; i++ {
+		if _, err := ApplyOrObserve(context.Background(), b, r); !errors.Is(err, ErrPending) {
+			t.Fatal("owned pending restart lost typed observation", err)
+		}
+		if b.install != 1 || b.restart != 1 || b.journal == nil || b.journal.Stage != "restart-retired" {
+			t.Fatal("pending observation repeated an admitted mutation")
+		}
+	}
+	b.pending = false
+	receipt, err := ApplyOrObserve(context.Background(), b, r)
+	if err != nil || GuardReceipt(r, receipt) != nil || b.install != 1 || b.restart != 1 || b.journal.Stage != "settled" {
+		t.Fatal("same pending transaction failed to converge without replay", err)
+	}
+}
