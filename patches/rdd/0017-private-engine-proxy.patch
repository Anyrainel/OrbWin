+package networkproxy
+
+import "errors"
+
+// Pending permits only a bounded re-observation of the same authenticated plan.
+// It is never an applied receipt or permission to repeat an admitted restart.
+var ErrGuestPending = errors.New("selected guest daemon observation pending")
diff --git a/rdd/pkg/networkproxy/guest_plan.go b/rdd/pkg/networkproxy/guest_plan.go
new file mode 100644
index 0000000..c8f2bfb
--- /dev/null
+++ b/rdd/pkg/networkproxy/guest_plan.go
@@ -0,0 +1,139 @@
+package networkproxy
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+	"regexp"
+)
+
+const GuestDropInPath = "/etc/systemd/system/docker.service.d/90-orbwin-network-proxy.conf"
+const GuestProxyEndpoint = protocol.Endpoint
+const dropInMarker = "# OrbWin engine proxy v1; credential-free guest endpoint\n"
+
+type GuestIdentity struct{ RegistrationGUID, MachineID, DaemonID string }
+type GuestObservation struct {
+	Identity            GuestIdentity
+	Exists, Regular     bool
+	UID                 uint32
+	Mode                uint32
+	DeviceID, Inode     uint64
+	Body                []byte
+	AllowedImagesPolicy bool
+	ForeignDaemonProxy  bool
+	ForeignServiceProxy bool
+}
+
+// GuestChange is an offline compare-and-swap plan. It never writes files or
+// authenticates caller-supplied observations. The eventual root guest helper
+// must establish identity/regular handles/exclusive ownership/durable ordering.
+type GuestChange struct {
+	Identity                    GuestIdentity
+	BeforeSHA256, AfterSHA256   string
+	BeforePresent               bool
+	BeforeDeviceID, BeforeInode uint64
+	After                       []byte
+	RestartRequired             bool
+}
+
+func hash(raw []byte) string { sum := sha256.Sum256(raw); return hex.EncodeToString(sum[:]) }
+func identityValid(value GuestIdentity) bool {
+	return regexp.MustCompile(`^\{[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\}$`).MatchString(value.RegistrationGUID) && value.RegistrationGUID != "{00000000-0000-0000-0000-000000000000}" && regexp.MustCompile(`^[0-9a-f]{32}$`).MatchString(value.MachineID) && len(value.DaemonID) > 0 && safeASCII(value.DaemonID, 128)
+}
+
+func guestBody(enabled bool) []byte {
+	if enabled {
+		return protocol.CompatibilityBody()
+	}
+	endpoint := ""
+	if enabled {
+		endpoint = GuestProxyEndpoint
+	}
+	// Values never come from upstream URLs, PAC, credentials or corporate
+	// NO_PROXY. Policy/bypass resolution stays in the Windows process.
+	return []byte(dropInMarker + "[Service]\nEnvironment=\"HTTP_PROXY=" + endpoint + "\" \"http_proxy=" + endpoint + "\"\nEnvironment=\"HTTPS_PROXY=" + endpoint + "\" \"https_proxy=" + endpoint + "\"\nEnvironment=\"NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,.orbwin.localhost,.orbwin.test\" \"no_proxy=localhost,127.0.0.1,::1,host.docker.internal,.orbwin.localhost,.orbwin.test\"\nEnvironment=\"ALL_PROXY=\" \"all_proxy=\"\n")
+}
+
+func checkGuest(expected GuestIdentity, current GuestObservation) error {
+	if !identityValid(expected) || current.Identity != expected {
+		return errors.New("owned engine guest identity changed; proxy transaction refused")
+	}
+	if current.AllowedImagesPolicy {
+		return errors.New("existing allowed-images policy proxy requires qualified chaining; bypass refused")
+	}
+	if current.ForeignDaemonProxy || current.ForeignServiceProxy {
+		return errors.New("existing foreign daemon/service proxy configuration requires explicit recovery")
+	}
+	if len(current.Body) > 8192 || (!current.Exists && (len(current.Body) != 0 || current.DeviceID != 0 || current.Inode != 0)) || current.Exists && (!current.Regular || current.UID != 0 || current.Mode != 0600 || current.DeviceID == 0 || current.Inode == 0) {
+		return errors.New("fixed guest proxy file is not the expected bounded root-owned regular file")
+	}
+	return nil
+}
+
+// PrepareGuestChange never adopts a file based on a marker alone. A retained
+// trusted receipt must supply the previous complete content hash, and only the
+// exact two generated fixed forms are accepted. Receipt authority is external.
+func PrepareGuestChange(config Config, expected GuestIdentity, current GuestObservation, retainedSHA256 string) (GuestChange, error) {
+	if err := config.Validate(); err != nil {
+		return GuestChange{}, err
+	}
+	if err := checkGuest(expected, current); err != nil {
+		return GuestChange{}, err
+	}
+	if current.Exists {
+		if retainedSHA256 == "" || hash(current.Body) != retainedSHA256 || (!bytes.Equal(current.Body, guestBody(false)) && !bytes.Equal(current.Body, guestBody(true))) {
+			return GuestChange{}, errors.New("guest proxy file differs from protected retained ownership; no overwrite")
+		}
+	} else if retainedSHA256 != "" {
+		return GuestChange{}, errors.New("owned guest proxy file disappeared; inspect recovery before replacing it")
+	}
+	// Fresh explicit None is a controller no-op, not permission to install an
+	// endpoint. Once managed, None keeps the credential-free compatibility
+	// endpoint while the host applies DIRECT to new requests. No env removal or
+	// old-stream reconfiguration is claimed.
+	if config.Mode == "none" && !current.Exists {
+		return GuestChange{}, errors.New("fresh none cannot install a guest proxy drop-in")
+	}
+	after := guestBody(true)
+	return GuestChange{Identity: expected, BeforeSHA256: hash(current.Body), AfterSHA256: hash(after), BeforePresent: current.Exists, BeforeDeviceID: current.DeviceID, BeforeInode: current.Inode, After: after, RestartRequired: !current.Exists || !bytes.Equal(current.Body, after)}, nil
+}
+
+// GuardGuestCAS is a recheck, not kernel atomicity. The native helper must keep
+// its exclusive cooperative ownership lock through secure temp/write/fsync/
+// rename/fsync and reject unexpected inode/owner/reparse drift before mutation.
+func GuardGuestCAS(change GuestChange, current GuestObservation) error {
+	if err := checkGuest(change.Identity, current); err != nil {
+		return err
+	}
+	if current.Exists != change.BeforePresent || current.DeviceID != change.BeforeDeviceID || current.Inode != change.BeforeInode || hash(current.Body) != change.BeforeSHA256 || hash(change.After) != change.AfterSHA256 || (!bytes.Equal(change.After, guestBody(false)) && !bytes.Equal(change.After, guestBody(true))) {
+		return errors.New("guest proxy compare-and-swap evidence changed; no write")
+	}
+	return nil
+}
+
+// RecoveryState is read-only. Cancellation after a durable write is not rollback
+// or proof restart never occurred. Only an identity-bound native restart receipt
+// for the exact new content permits an applied acknowledgement.
+func RecoveryState(change GuestChange, current GuestObservation, restartConfigSHA256 string) (string, error) {
+	if err := checkGuest(change.Identity, current); err != nil {
+		return "refused", err
+	}
+	if hash(change.After) != change.AfterSHA256 || (!bytes.Equal(change.After, guestBody(false)) && !bytes.Equal(change.After, guestBody(true))) {
+		return "refused", errors.New("guest proxy desired content changed")
+	}
+	if current.Exists && hash(current.Body) == change.AfterSHA256 {
+		if restartConfigSHA256 == change.AfterSHA256 {
+			return "applied", nil
+		}
+		return "write-present-restart-outcome-unknown", nil
+	}
+	if current.Exists == change.BeforePresent && hash(current.Body) == change.BeforeSHA256 {
+		if restartConfigSHA256 != "" {
+			return "refused", errors.New("restart acknowledgement conflicts with observed configuration")
+		}
+		return "not-written", nil
+	}
+	return "refused", errors.New("guest proxy configuration changed outside retained transaction")
+}
diff --git a/rdd/pkg/networkproxy/guest_plan_test.go b/rdd/pkg/networkproxy/guest_plan_test.go
new file mode 100644
index 0000000..c29972c
--- /dev/null
+++ b/rdd/pkg/networkproxy/guest_plan_test.go
@@ -0,0 +1,123 @@
+package networkproxy
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func guestIdentity() GuestIdentity {
+	return GuestIdentity{RegistrationGUID: "{11111111-1111-1111-1111-111111111111}", MachineID: strings.Repeat("a", 32), DaemonID: "exact-owned-daemon"}
+}
+func absentGuest() GuestObservation { return GuestObservation{Identity: guestIdentity()} }
+func presentGuest(body []byte) GuestObservation {
+	return GuestObservation{Identity: guestIdentity(), Exists: true, Regular: true, UID: 0, Mode: 0600, DeviceID: 17, Inode: 41, Body: append([]byte{}, body...)}
+}
+
+func TestFixedGuestPlanContainsNoUpstreamSecretsAndDoesNotRestartForRoutingOnlyChange(t *testing.T) {
+	config := configFixture()
+	config.URL = "https://private-proxy.example:4443"
+	change, err := PrepareGuestChange(config, guestIdentity(), absentGuest(), "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !change.RestartRequired || !bytes.Contains(change.After, []byte(GuestProxyEndpoint)) || bytes.Contains(change.After, []byte("private-proxy")) || bytes.Contains(change.After, []byte("internal.example")) {
+		t.Fatal("guest received upstream endpoint/bypass or missing restart plan")
+	}
+	if err := GuardGuestCAS(change, absentGuest()); err != nil {
+		t.Fatal(err)
+	}
+	current := presentGuest(change.After)
+	config.Mode = "auto"
+	config.URL = ""
+	next, err := PrepareGuestChange(config, guestIdentity(), current, change.AfterSHA256)
+	if err != nil || next.RestartRequired || !bytes.Equal(next.After, change.After) {
+		t.Fatal("auto/URL routing-only change needlessly rewrote/restarted guest", err)
+	}
+	config.Mode = "none"
+	direct, err := PrepareGuestChange(config, guestIdentity(), current, change.AfterSHA256)
+	if err != nil || direct.RestartRequired || !bytes.Equal(direct.After, current.Body) {
+		t.Fatal("managed none changed compatibility endpoint or restarted guest", err)
+	}
+	if _, err := PrepareGuestChange(config, guestIdentity(), absentGuest(), ""); err == nil {
+		t.Fatal("fresh none installed an unnecessary compatibility endpoint")
+	}
+}
+
+func TestGuestRefusesPolicyBypassForeignOwnershipAndStaleCAS(t *testing.T) {
+	config := configFixture()
+	for name, mutate := range map[string]func(*GuestObservation){
+		"allowed images":        func(o *GuestObservation) { o.AllowedImagesPolicy = true },
+		"foreign daemon proxy":  func(o *GuestObservation) { o.ForeignDaemonProxy = true },
+		"foreign service proxy": func(o *GuestObservation) { o.ForeignServiceProxy = true },
+		"guest replaced":        func(o *GuestObservation) { o.Identity.MachineID = strings.Repeat("b", 32) },
+		"daemon replaced":       func(o *GuestObservation) { o.Identity.DaemonID = "other-daemon" },
+		"symlink":               func(o *GuestObservation) { *o = presentGuest(guestBody(false)); o.Regular = false },
+		"foreign UID":           func(o *GuestObservation) { *o = presentGuest(guestBody(false)); o.UID = 1000 },
+		"foreign mode":          func(o *GuestObservation) { *o = presentGuest(guestBody(false)); o.Mode = 0644 },
+		"oversize":              func(o *GuestObservation) { o.Body = bytes.Repeat([]byte("x"), 8193) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			current := absentGuest()
+			mutate(&current)
+			if _, err := PrepareGuestChange(config, guestIdentity(), current, ""); err == nil {
+				t.Fatal("unsafe guest observation accepted")
+			}
+		})
+	}
+	current := presentGuest(guestBody(false))
+	if _, err := PrepareGuestChange(config, guestIdentity(), current, ""); err == nil {
+		t.Fatal("marker alone adopted foreign file")
+	}
+	current.Body = append(current.Body, []byte("# foreign edit\n")...)
+	if _, err := PrepareGuestChange(config, guestIdentity(), current, hash(current.Body)); err == nil {
+		t.Fatal("unknown content adopted even with hash claim")
+	}
+	change, _ := PrepareGuestChange(config, guestIdentity(), absentGuest(), "")
+	if GuardGuestCAS(change, presentGuest(guestBody(false))) == nil {
+		t.Fatal("stale absent preflight overwrote new file")
+	}
+	changed := change
+	changed.After = append([]byte{}, change.After...)
+	changed.After[0] = '!'
+	if GuardGuestCAS(changed, absentGuest()) == nil {
+		t.Fatal("tampered desired content accepted")
+	}
+	if _, err := PrepareGuestChange(config, guestIdentity(), absentGuest(), hash(guestBody(false))); err == nil {
+		t.Fatal("disappeared retained file silently recreated")
+	}
+	owned := presentGuest(guestBody(false))
+	ownedChange, err := PrepareGuestChange(config, guestIdentity(), owned, hash(owned.Body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	owned.Inode++
+	if GuardGuestCAS(ownedChange, owned) == nil {
+		t.Fatal("same-content inode replacement accepted by CAS recheck")
+	}
+}
+
+func TestGuestWriteRestartCancelUnknownOutcomeRecovery(t *testing.T) {
+	change, err := PrepareGuestChange(configFixture(), guestIdentity(), absentGuest(), "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if state, err := RecoveryState(change, absentGuest(), ""); err != nil || state != "not-written" {
+		t.Fatal(state, err)
+	}
+	after := presentGuest(change.After)
+	if state, err := RecoveryState(change, after, ""); err != nil || state != "write-present-restart-outcome-unknown" {
+		t.Fatal("canceled/unknown restart pretended applied", state, err)
+	}
+	if state, err := RecoveryState(change, after, change.AfterSHA256); err != nil || state != "applied" {
+		t.Fatal(state, err)
+	}
+	if state, err := RecoveryState(change, absentGuest(), change.AfterSHA256); err == nil || state != "refused" {
+		t.Fatal("stale restart acknowledgement accepted")
+	}
+	foreign := after
+	foreign.Body = []byte("foreign config")
+	if state, err := RecoveryState(change, foreign, change.AfterSHA256); err == nil || state != "refused" {
+		t.Fatal("foreign file overwritten during recovery")
+	}
+}
diff --git a/rdd/pkg/networkproxy/guest_transaction.go b/rdd/pkg/networkproxy/guest_transaction.go
new file mode 100644
index 0000000..469d427
--- /dev/null
+++ b/rdd/pkg/networkproxy/guest_transaction.go
@@ -0,0 +1,90 @@
+package networkproxy
+
+import (
+	"context"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+)
+
+// FixedGuestTransactions is injected into the existing App reconciler only.
+// No production executor is registered. Its eventual implementation must own a
+// fixed per-machine lock and durable intent/ack, re-observe unknown outcomes,
+// refuse foreign bytes, and never replay an uncertain restart. Conditional
+// writes under a cooperating writer lock are not atomic CAS against guest root.
+type FixedGuestTransactions interface {
+	ObserveIdentity(context.Context, *lima.LimaVM) (GuestIdentity, error)
+	ApplyOrObserve(context.Context, GuestTransaction) (GuestTransactionReceipt, error)
+}
+
+type GuestTransaction struct {
+	ID       string
+	Plan     app.NetworkProxyPlan
+	Identity GuestIdentity
+	// Only mode crosses this adapter; upstream URL/NoProxy/credentials never do.
+	Mode string
+}
+type GuestTransactionReceipt struct {
+	ID                  string
+	Plan                app.NetworkProxyPlan
+	Identity            GuestIdentity
+	ConfigSHA256        string
+	RuntimeConfigSHA256 string
+	Disposition         string
+	SettlementSHA256    string
+	// Applied means durable exact-file observation plus exact running-config
+	// acknowledgement, not merely a completed SSH call or successful rename.
+	Applied bool
+}
+
+func NewGuestTransaction(owner *app.App, observed app.NetworkProxyBinding, identity GuestIdentity) (GuestTransaction, error) {
+	var empty GuestTransaction
+	if owner == nil || owner.Status.NetworkProxy == nil || !identityValid(identity) {
+		return empty, ErrProxyOwner
+	}
+	plan := owner.Status.NetworkProxy.Plan
+	if GuardProxyPlan(owner, plan, observed) != nil || (plan.Phase != "prepare" && plan.Phase != "disable") {
+		return empty, ErrProxyOwner
+	}
+	value := GuestTransaction{Plan: *plan, Identity: identity, Mode: owner.Status.NetworkProxy.Mode}
+	// Unrelated App generation changes do not create another write/restart
+	// identity: only immutable proxy permission/owner/guest identity does.
+	value.ID = guestTransactionID(value)
+	return value, nil
+}
+
+func guestTransactionID(value GuestTransaction) string {
+	return GuestProtocolRequest(value).TransactionID()
+}
+
+func GuestProtocolRequest(value GuestTransaction) protocol.Request {
+	p := value.Plan
+	return protocol.Request{Schema: 1, ID: value.ID, Mode: value.Mode,
+		Owner:    protocol.Owner{AppUID: p.AppUID, LimaUID: p.Binding.LimaVMUID, HostPID: uint32(p.Binding.HostPID), HostCreation: p.Binding.HostCreationTime, Epoch: p.Binding.TransportEpoch, Revision: p.ProxyRevision, Digest: p.ConfigDigest, Phase: p.Phase},
+		Identity: protocol.Identity{RegistrationGUID: value.Identity.RegistrationGUID, MachineID: value.Identity.MachineID, DaemonID: value.Identity.DaemonID}}
+}
+
+func GuardGuestTransactionReceipt(transaction GuestTransaction, receipt GuestTransactionReceipt) error {
+	plan := transaction.Plan
+	validPhase := plan.Phase == "prepare" && (transaction.Mode == "url" || transaction.Mode == "auto") || plan.Phase == "disable" && transaction.Mode == "none"
+	if !hexIdentity(transaction.ID, 64) || transaction.ID != guestTransactionID(transaction) || !validPhase || !validBinding(plan.Binding) || plan.AppUID == "" || !safeASCII(plan.AppUID, 128) || plan.ObservedGeneration < 1 || plan.ProxyRevision < 1 || !hexIdentity(plan.ConfigDigest, 64) || !identityValid(transaction.Identity) || receipt.ID != transaction.ID || receipt.Plan != transaction.Plan || receipt.Identity != transaction.Identity || !receipt.Applied {
+		return ErrProxyOwner
+	}
+	request := GuestProtocolRequest(transaction)
+	if protocol.GuardReceipt(request, protocol.Receipt{Schema: 1, ID: receipt.ID, Owner: request.Owner, Identity: request.Identity, Mode: request.Mode, Disposition: receipt.Disposition, ConfigHash: receipt.ConfigSHA256, RuntimeHash: receipt.RuntimeConfigSHA256, SettlementHash: receipt.SettlementSHA256}) != nil {
+		return ErrProxyOwner
+	}
+	return nil
+}
+
+func GuestReceiptFromProtocol(transaction GuestTransaction, receipt protocol.Receipt) (GuestTransactionReceipt, error) {
+	if protocol.GuardReceipt(GuestProtocolRequest(transaction), receipt) != nil {
+		return GuestTransactionReceipt{}, ErrProxyOwner
+	}
+	value := GuestTransactionReceipt{ID: receipt.ID, Plan: transaction.Plan, Identity: transaction.Identity, ConfigSHA256: receipt.ConfigHash, RuntimeConfigSHA256: receipt.RuntimeHash, Disposition: receipt.Disposition, SettlementSHA256: receipt.SettlementHash, Applied: true}
+	if GuardGuestTransactionReceipt(transaction, value) != nil {
+		return GuestTransactionReceipt{}, ErrProxyOwner
+	}
+	return value, nil
+}
diff --git a/rdd/pkg/networkproxy/guest_transaction_test.go b/rdd/pkg/networkproxy/guest_transaction_test.go
new file mode 100644
index 0000000..f932d31
--- /dev/null
+++ b/rdd/pkg/networkproxy/guest_transaction_test.go
@@ -0,0 +1,49 @@
+package networkproxy
+
+import (
+	"testing"
+)
+
+func TestGuestTransactionImmutablePermissionAndReceipt(t *testing.T) {
+	owner := desiredFixture(t, "url")
+	attachPlan(owner, "prepare")
+	tx, err := NewGuestTransaction(owner, bindingFixture(), guestIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner.Generation++
+	owner.Status.NetworkProxy.ObservedGeneration++
+	owner.Status.NetworkProxy.Plan.ObservedGeneration = owner.Generation
+	again, err := NewGuestTransaction(owner, bindingFixture(), guestIdentity())
+	if err != nil || again.ID != tx.ID {
+		t.Fatal("unrelated App generation created another guest transaction")
+	}
+	receipt := GuestTransactionReceipt{ID: tx.ID, Plan: tx.Plan, Identity: tx.Identity, ConfigSHA256: hash(guestBody(true)), RuntimeConfigSHA256: hash(guestBody(true)), Applied: true, Disposition: "compatibility", SettlementSHA256: hash([]byte("controlled settlement"))}
+	if GuardGuestTransactionReceipt(tx, receipt) != nil {
+		t.Fatal("exact receipt rejected")
+	}
+	for name, mutate := range map[string]func(*GuestTransactionReceipt){
+		"unknown":           func(r *GuestTransactionReceipt) { r.Applied = false },
+		"other transaction": func(r *GuestTransactionReceipt) { r.ID = "other" },
+		"stale process":     func(r *GuestTransactionReceipt) { r.Plan.Binding.HostCreationTime = "0000000000000002" },
+		"stale revision":    func(r *GuestTransactionReceipt) { r.Plan.ProxyRevision++ },
+		"other guest":       func(r *GuestTransactionReceipt) { r.Identity.DaemonID = "other" },
+		"unknown runtime":   func(r *GuestTransactionReceipt) { r.RuntimeConfigSHA256 = "" },
+		"foreign file": func(r *GuestTransactionReceipt) {
+			r.ConfigSHA256 = hash([]byte("foreign"))
+			r.RuntimeConfigSHA256 = r.ConfigSHA256
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := receipt
+			mutate(&bad)
+			if GuardGuestTransactionReceipt(tx, bad) == nil {
+				t.Fatal("unbound receipt accepted")
+			}
+		})
+	}
+	owner.Status.NetworkProxy.Plan.Phase = "commit"
+	if _, err := NewGuestTransaction(owner, bindingFixture(), guestIdentity()); err == nil {
+		t.Fatal("commit permitted another guest transaction")
+	}
+}
diff --git a/rdd/pkg/networkproxy/hostagent_launch.go b/rdd/pkg/networkproxy/hostagent_launch.go
new file mode 100644
index 0000000..6339793
--- /dev/null
+++ b/rdd/pkg/networkproxy/hostagent_launch.go
@@ -0,0 +1,127 @@
+package networkproxy
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+)
+
+// ServingIdentity is injected only by the existing embedded serving process.
+// It contains no token or private key; a disk config cannot construct this trust.
+type ServingIdentity struct {
+	endpoint      string
+	certificate   [32]byte
+	anchorFactory func() (managementconfig.LaunchAnchor, error)
+}
+
+// WithAnchorFactory is called only during embedded owner initialization before
+// publication to the manager. It carries the retained object, never a path.
+func (s *ServingIdentity) WithAnchorFactory(factory func() (managementconfig.LaunchAnchor, error)) error {
+	if s == nil || factory == nil || s.anchorFactory != nil {
+		return ErrManagement
+	}
+	s.anchorFactory = factory
+	return nil
+}
+
+// HasRetainedAnchorFactory is a source capability check, not a runtime health
+// observation. Only the embedded private authority installs this factory.
+func (s *ServingIdentity) HasRetainedAnchorFactory() bool { return s != nil && s.anchorFactory != nil }
+
+func (*ServingIdentity) String() string   { return "private serving selection" }
+func (*ServingIdentity) GoString() string { return "private serving selection" }
+func NewServingIdentity(endpoint string, certificatePEM []byte) (*ServingIdentity, error) {
+	if !canonicalManagementEndpoint(endpoint) {
+		return nil, ErrManagement
+	}
+	digest, err := managementCertificateDigest(certificatePEM)
+	if err != nil {
+		return nil, err
+	}
+	return &ServingIdentity{endpoint: endpoint, certificate: digest}, nil
+}
+
+// A single canonical closed argument carries PUBLIC launch metadata. Its trust
+// comes from the actual same-user native launcher + transferred handle, not from
+// secrecy, a predictable event, a PID file, or a new authentication protocol.
+type hostagentLaunch struct {
+	Version        int    `json:"v"`
+	Handle         uint64 `json:"handle"`
+	Volume         uint32 `json:"volume"`
+	IndexHigh      uint32 `json:"indexHigh"`
+	IndexLow       uint32 `json:"indexLow"`
+	ParentPID      uint32 `json:"parentPID"`
+	ParentCreation string `json:"parentCreation"`
+	Session        uint32 `json:"session"`
+	AppUID         string `json:"appUID"`
+	LimaUID        string `json:"limaUID"`
+	Epoch          string `json:"epoch"`
+	Endpoint       string `json:"endpoint"`
+	Certificate    string `json:"certificate"`
+}
+
+func (s *ServingIdentity) launch(owner *app.App, vm *lima.LimaVM, parent NativeManagementIdentity, epoch string) (hostagentLaunch, error) {
+	var empty hostagentLaunch
+	if s == nil || parent.PID == 0 || parent.Session == 0 {
+		return empty, ErrManagement
+	}
+	native := app.NetworkProxyBinding{LimaVMUID: vmUID(vm), HostPID: int64(parent.PID), HostCreationTime: parent.CreationTime, TransportEpoch: epoch}
+	// Reuse the same exact App/controller/native checks. Certificate authority
+	// was already validated and copied in the serving process, not from config.
+	if !validSelectedOwners(owner, vm) || !validBinding(native) || !canonicalManagementEndpoint(s.endpoint) {
+		return empty, ErrManagement
+	}
+	return hostagentLaunch{Version: 1, ParentPID: parent.PID, ParentCreation: parent.CreationTime, Session: parent.Session, AppUID: string(owner.UID), LimaUID: string(vm.UID), Epoch: epoch, Endpoint: s.endpoint, Certificate: hex.EncodeToString(s.certificate[:])}, nil
+}
+
+func vmUID(vm *lima.LimaVM) string {
+	if vm == nil {
+		return ""
+	}
+	return string(vm.UID)
+}
+
+func (m hostagentLaunch) valid() bool {
+	b := app.NetworkProxyBinding{LimaVMUID: m.LimaUID, HostPID: int64(m.ParentPID), HostCreationTime: m.ParentCreation, TransportEpoch: m.Epoch}
+	return m.Version == 1 && m.Handle != 0 && m.Handle != ^uint64(0) && (m.IndexHigh != 0 || m.IndexLow != 0) && m.Session != 0 && m.AppUID != "" && safeASCII(m.AppUID, 128) && validBinding(b) && canonicalManagementEndpoint(m.Endpoint) && hexIdentity(m.Certificate, 64)
+}
+
+func encodeHostagentLaunch(m hostagentLaunch) (string, error) {
+	if !m.valid() {
+		return "", ErrManagement
+	}
+	data, err := json.Marshal(m)
+	if err != nil || len(data) > 1536 {
+		return "", ErrManagement
+	}
+	return base64.RawURLEncoding.EncodeToString(data), nil
+}
+
+func parseHostagentLaunch(argument string) (hostagentLaunch, error) {
+	var m hostagentLaunch
+	if len(argument) < 1 || len(argument) > 2048 {
+		return m, ErrManagement
+	}
+	data, err := base64.RawURLEncoding.Strict().DecodeString(argument)
+	if err != nil {
+		return m, ErrManagement
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&m) != nil || !m.valid() {
+		return hostagentLaunch{}, ErrManagement
+	}
+	canonical, err := encodeHostagentLaunch(m)
+	// Canonical byte equality refuses unknown/duplicate keys, trailing data,
+	// omitted/default fields, alternate numbers/whitespace, and duplicate args
+	// are separately refused by the command's flag-count check.
+	if err != nil || canonical != argument {
+		return hostagentLaunch{}, ErrManagement
+	}
+	return m, nil
+}
