+// Fixture adapter only; production passes existing upstream socketbridge.Pipe.
+func fixtureDuplex(left, right HalfConnection) error {
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() { defer workers.Done(); io.Copy(left, right); left.CloseWrite() }()
+	go func() { defer workers.Done(); io.Copy(right, left); right.CloseWrite() }()
+	workers.Wait()
+	return nil
+}
+func proxyServerFixture(t *testing.T, policy *Policy, peer string) (net.Listener, context.CancelFunc, <-chan error) {
+	t.Helper()
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- ServeForwardProxy(ctx, listener, netip.MustParseAddr(peer), policy, fixtureDuplex) }()
+	t.Cleanup(cancel)
+	return listener, cancel, done
+}
+func awaitProxyStop(t *testing.T, done <-chan error, wantError bool) {
+	t.Helper()
+	select {
+	case err := <-done:
+		if (err != nil) != wantError {
+			t.Fatal("unexpected server termination", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("server failed to close and join")
+	}
+}
+func sendProxyFixture(t *testing.T, listener net.Listener, request string) (net.Conn, *bufio.Reader) {
+	t.Helper()
+	connection, err := net.DialTimeout("tcp", listener.Addr().String(), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { connection.Close() })
+	connection.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err := io.WriteString(connection, request); err != nil {
+		t.Fatal(err)
+	}
+	return connection, bufio.NewReader(connection)
+}
