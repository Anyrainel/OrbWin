+package controllers
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+)
+
+func TestNetworkProxyAdmissionUsesExistingValidator(t *testing.T) {
+	validator := &AppValidator{}
+	legacy := &app.App{}
+	if _, err := validator.ValidateCreate(context.Background(), legacy); err != nil {
+		t.Fatal("legacy App refused", err)
+	}
+	valid := legacy.DeepCopy()
+	valid.Spec.NetworkProxy = &app.NetworkProxySpec{Version: 1, Mode: "url", URL: "http://proxy.example:3128", NoProxy: []string{}}
+	if _, err := validator.ValidateCreate(context.Background(), valid); err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*app.NetworkProxySpec){func(s *app.NetworkProxySpec) { s.Version = 0 }, func(s *app.NetworkProxySpec) { s.Mode = "Auto" }, func(s *app.NetworkProxySpec) { s.URL = "http://user:private-secret@proxy.example:3128" }, func(s *app.NetworkProxySpec) { s.NoProxy = []string{"example", "example"} }, func(s *app.NetworkProxySpec) { s.Mode = "none" }} {
+		bad := valid.DeepCopy()
+		mutate(bad.Spec.NetworkProxy)
+		_, err := validator.ValidateCreate(context.Background(), bad)
+		if err == nil || strings.Contains(err.Error(), "private-secret") {
+			t.Fatal("invalid/private proxy intent accepted or leaked")
+		}
+	}
+	removed := valid.DeepCopy()
+	removed.Spec.NetworkProxy = nil
+	if _, err := validator.ValidateUpdate(context.Background(), valid, removed); err == nil {
+		t.Fatal("existing admission silently removed managed URL")
+	}
+}
diff --git a/rdd/pkg/controllers/app/app/controllers/network_proxy_controller.go b/rdd/pkg/controllers/app/app/controllers/network_proxy_controller.go
new file mode 100644
index 0000000..65b7a77
--- /dev/null
+++ b/rdd/pkg/controllers/app/app/controllers/network_proxy_controller.go
@@ -0,0 +1,204 @@
+package controllers
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+const conditionNetworkProxyReady = "NetworkProxyReady"
+
+// Existing AppReconciler is the only desired/permission writer. Each pass makes
+// at most one fenced status write. No retry loop, daemon start/stop, or guest
+// shell is added. Missing guest adapter is an explicit unavailable state. Native
+// observation/file calls remain synchronously bounded only between calls.
+func (r *AppReconciler) reconcileNetworkProxy(parent context.Context, owner *app.App, vm *lima.LimaVM) error {
+	if owner.Spec.NetworkProxy == nil && owner.Status.NetworkProxy == nil && owner.Status.NetworkProxyHost == nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	defer cancel()
+	current, machine, err := r.readProxyOwners(ctx, owner, vm)
+	if err != nil {
+		return err
+	}
+	projection, err := networkproxy.ProjectDesired(current)
+	if err != nil {
+		return r.writeProxyState(ctx, owner, current, current.Status.NetworkProxy, "Unavailable")
+	}
+	state := projection.State
+	if state == nil {
+		return nil
+	}
+	// Fresh None never installs guest env or requires a proxy listener. Managed
+	// None retains the credential-free compatibility endpoint and bounded drains.
+	if state.Mode == "none" && !state.ManagedEver && current.Status.NetworkProxyHost == nil {
+		return r.writeProxyState(ctx, owner, current, state, "Ready")
+	}
+	if !reflect.DeepEqual(state, current.Status.NetworkProxy) {
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	if !current.Spec.Running || !machine.Spec.Running {
+		r.proxyObservation = nil
+		state = state.DeepCopy()
+		state.Plan = nil
+		state.GuestAppliedRevision = 0
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	observe := r.ProxyObserve
+	if observe == nil {
+		observe = networkproxy.ObserveProxyLaunch
+	}
+	binding, err := observe(ctx, current, machine, machine.Status.NetworkProxyLaunch)
+	if err != nil {
+		state = state.DeepCopy()
+		state.Plan = nil // Revokes permission; consumer suspends only proxy work.
+		state.GuestAppliedRevision = 0
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	if state.Plan == nil || state.Plan.Binding != binding {
+		state = state.DeepCopy()
+		phase := "prepare"
+		if state.Mode == "none" {
+			phase = "disable"
+		}
+		state.Plan = &app.NetworkProxyPlan{AppUID: string(current.UID), ObservedGeneration: current.Generation, ProxyRevision: state.ProxyRevision, ConfigDigest: state.ConfigDigest, Binding: binding, Phase: phase}
+		state.GuestAppliedRevision = 0
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	if networkproxy.GuardProxyPlan(current, state.Plan, binding) != nil {
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	host := current.Status.NetworkProxyHost
+	if networkproxy.GuardHostObservation(current, host, binding) != nil || host.Phase == "degraded" {
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	if state.Plan.Phase == "commit" {
+		if state.GuestAppliedRevision == state.ProxyRevision && host.Phase == "active" {
+			return r.writeProxyState(ctx, owner, current, state, "Ready")
+		}
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	if state.Mode == "none" && state.GuestAppliedRevision == state.ProxyRevision && host.Phase == "direct" {
+		return r.writeProxyState(ctx, owner, current, state, "Ready")
+	}
+	if state.Mode == "none" && !state.ManagedEver && host.Phase == "direct" {
+		// No guest transaction was ever admitted; host preparation alone did
+		// not install env. DIRECT acknowledgement requires no guest mutation.
+		return r.writeProxyState(ctx, owner, current, state, "Ready")
+	}
+	if r.ProxyGuest == nil {
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	identity, err := r.ProxyGuest.ObserveIdentity(ctx, machine.DeepCopy())
+	if errors.Is(err, networkproxy.ErrGuestPending) {
+		return r.pendingProxyObservation(ctx, owner, current, state)
+	}
+	if err != nil {
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	transaction, err := networkproxy.NewGuestTransaction(current, binding, identity)
+	if err != nil {
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	if !state.ManagedEver {
+		// Fence possible mutation history BEFORE invoking the adapter. A crash
+		// or unknown write can never be mistaken for never-managed absence.
+		state = state.DeepCopy()
+		state.ManagedEver = true
+		return r.writeProxyState(ctx, owner, current, state, "Pending")
+	}
+	// The adapter is responsible for durable ApplyOrObserve, not repeating an
+	// unknown mutation/restart. A successful call alone is never an applied ack.
+	receipt, err := r.ProxyGuest.ApplyOrObserve(ctx, transaction)
+	if errors.Is(err, networkproxy.ErrGuestPending) {
+		return r.pendingProxyObservation(ctx, owner, current, state)
+	}
+	if err != nil || ctx.Err() != nil || networkproxy.GuardGuestTransactionReceipt(transaction, receipt) != nil {
+		return r.writeProxyState(ctx, owner, current, state, "Unavailable")
+	}
+	latest, latestVM, err := r.readProxyOwners(ctx, current, machine)
+	if err != nil {
+		return err
+	}
+	observed, err := observe(ctx, latest, latestVM, latestVM.Status.NetworkProxyLaunch)
+	if err != nil || !latest.Spec.Running || !latestVM.Spec.Running || observed != binding || !reflect.DeepEqual(latest.Status.NetworkProxy, current.Status.NetworkProxy) || networkproxy.GuardProxyPlan(latest, state.Plan, observed) != nil || networkproxy.GuardHostObservation(latest, latest.Status.NetworkProxyHost, observed) != nil || latest.Status.NetworkProxyHost.Phase == "degraded" {
+		return networkproxy.ErrProxyOwner
+	}
+	state = latest.Status.NetworkProxy.DeepCopy()
+	r.proxyObservation = nil
+	state.GuestAppliedRevision = state.ProxyRevision
+	state.ManagedEver = true
+	if state.Mode != "none" {
+		state.Plan.Phase = "commit"
+	}
+	return r.writeProxyState(ctx, owner, latest, state, "Pending")
+}
+
+func (r *AppReconciler) readProxyOwners(ctx context.Context, owner *app.App, vm *lima.LimaVM) (*app.App, *lima.LimaVM, error) {
+	reader := r.ProxyAPIReader
+	if reader == nil {
+		reader = r.Client
+	}
+	current := &app.App{}
+	machine := &lima.LimaVM{}
+	if reader == nil || ctx.Err() != nil || reader.Get(ctx, client.ObjectKeyFromObject(owner), current) != nil || current.UID != owner.UID || reader.Get(ctx, client.ObjectKeyFromObject(vm), machine) != nil || machine.UID != vm.UID {
+		return nil, nil, networkproxy.ErrProxyOwner
+	}
+	// LaunchBinding also validates controller ref, namespace, deleting objects,
+	// exact UIDs and bounded metadata when a launch observation exists.
+	if current.Name != "app" || current.Namespace != "" || current.UID == "" || current.DeletionTimestamp != nil || machine.DeletionTimestamp != nil || machine.Namespace != current.GetResourceNamespace() {
+		return nil, nil, networkproxy.ErrProxyOwner
+	}
+	return current, machine, nil
+}
+
+func (r *AppReconciler) writeProxyState(ctx context.Context, visible, current *app.App, state *app.NetworkProxyControllerStatus, reason string) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	updated := current.DeepCopy()
+	updated.Status.NetworkProxy = state.DeepCopy()
+	status := metav1.ConditionFalse
+	message := "Engine proxy is awaiting its owned acknowledgement"
+	if reason == "Ready" {
+		status = metav1.ConditionTrue
+		message = "Engine proxy intent is acknowledged"
+	}
+	if reason == "Unavailable" {
+		message = "Engine proxy is unavailable; traffic requiring this proxy may fail"
+	}
+	apimeta.SetStatusCondition(&updated.Status.Conditions, metav1.Condition{Type: conditionNetworkProxyReady, Status: status, Reason: reason, Message: message, ObservedGeneration: current.Generation, LastTransitionTime: metav1.Now()})
+	if reflect.DeepEqual(current.Status.NetworkProxy, updated.Status.NetworkProxy) && reflect.DeepEqual(current.Status.Conditions, updated.Status.Conditions) {
+		*visible = *current.DeepCopy()
+		return nil
+	}
+	patch, err := json.Marshal([]map[string]any{
+		{"op": "test", "path": "/metadata/uid", "value": string(current.UID)},
+		{"op": "test", "path": "/metadata/resourceVersion", "value": current.ResourceVersion},
+		{"op": "add", "path": "/status/networkProxy", "value": updated.Status.NetworkProxy},
+		{"op": "add", "path": "/status/conditions", "value": updated.Status.Conditions},
+	})
+	if err != nil {
+		return networkproxy.ErrProxyOwner
+	}
+	if err := r.Status().Patch(ctx, updated, client.RawPatch(types.JSONPatchType, patch), client.FieldValidation("Strict")); err != nil {
+		if apierrors.IsConflict(err) {
+			return networkproxy.ErrProxyOwner
+		}
+		return err // No retry: a newer intent/host observation must reconcile.
+	}
+	*visible = *updated
+	return nil
+}
