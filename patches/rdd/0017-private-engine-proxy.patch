+)
+
+func TestHTTPUsesExplicitProxyStripsProxyCredentialsAndDoesNotReplay(t *testing.T) {
+	var calls atomic.Int32
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.URL.Host != "destination.example" || r.Host != "destination.example" || r.Header.Get("Proxy-Authorization") != "" {
+			t.Error("destination or proxy auth boundary changed")
+		}
+		io.WriteString(w, "owned-proxy")
+	}))
+	defer proxy.Close()
+	policy, err := New(Config{Version: 1, Mode: "url", URL: proxy.URL}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request, _ := http.NewRequest("GET", "http://destination.example/path", nil)
+	request.Header.Set("Proxy-Authorization", "secret")
+	request.Host = "conflicting-host.example"
+	response, err := policy.RoundTripHTTP(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(response.Body)
+	response.Body.Close()
+	if string(body) != "owned-proxy" || calls.Load() != 1 {
+		t.Fatal("explicit proxy not used")
+	}
+	failed := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		conn, _, _ := w.(http.Hijacker).Hijack()
+		conn.Close()
+	}))
+	defer failed.Close()
+	policy, _ = New(Config{Version: 1, Mode: "auto"}, autoFunc(func(context.Context, *url.URL) ([]Route, error) {
+		return []Route{{Proxy: failed.URL}, {Direct: true}}, nil
+	}))
+	request, _ = http.NewRequest("POST", "http://destination.example/path", strings.NewReader("application data"))
+	if _, err := policy.RoundTripHTTP(request); err == nil || calls.Load() != 2 {
+		t.Fatal("possibly accepted POST replayed or reported success")
+	}
+}
+
+func tunnelProxy(t *testing.T) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "CONNECT" || r.Host != "destination.example:443" {
+			t.Error("CONNECT destination changed")
+			w.WriteHeader(400)
+			return
+		}
+		conn, buffer, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(3 * time.Second))
+		buffer.WriteString("HTTP/1.1 200 Connection Established\r\n\r\nprefix")
+		buffer.Flush()
+		io.Copy(conn, buffer)
+	}))
+}
+
+func TestCONNECTOrderedFailoverBufferedBytesAndCancellation(t *testing.T) {
+	rejected := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(503) }))
+	defer rejected.Close()
+	accepted := tunnelProxy(t)
+	defer accepted.Close()
+	policy, _ := New(Config{Version: 1, Mode: "auto"}, autoFunc(func(context.Context, *url.URL) ([]Route, error) {
+		return []Route{{Proxy: rejected.URL}, {Proxy: accepted.URL}}, nil
+	}))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	connection, err := policy.DialTunnel(ctx, "destination.example:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	buffer := make([]byte, 6)
+	if _, err := io.ReadFull(connection, buffer); err != nil || string(buffer) != "prefix" {
+		t.Fatal("buffered tunnel bytes lost", err)
+	}
+	connection.Write([]byte("opaque"))
+	if _, err := io.ReadFull(connection, buffer); err != nil || string(buffer) != "opaque" {
+		t.Fatal("opaque stream changed", err)
+	}
+	cancel()
+	connection.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := connection.Read(buffer); err == nil {
+		t.Fatal("canceled tunnel survived")
+	}
+}
+
+func TestHTTPSProxyUntrustedCertificateFailsWithoutInsecureFallback(t *testing.T) {
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		t.Error("unverified TLS proxy accepted application request")
+	}))
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.StartTLS()
+	defer server.Close()
+	policy, err := New(Config{Version: 1, Mode: "url", URL: server.URL}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := policy.DialTunnel(context.Background(), "destination.example:443"); err == nil {
+		t.Fatal("untrusted HTTPS proxy accepted")
+	}
+	request, _ := http.NewRequest("GET", "http://destination.example/", nil)
+	if _, err := policy.RoundTripHTTP(request); err == nil {
+		t.Fatal("untrusted HTTPS transport accepted")
+	}
+}
+
+func TestOpaqueTunnelPreservesWriteHalfCloseAndRemainingResponse(t *testing.T) {
+	accepted := tunnelProxy(t)
+	defer accepted.Close()
+	policy, _ := New(Config{Version: 1, Mode: "url", URL: accepted.URL}, nil)
+	connection, err := policy.DialTunnel(context.Background(), "destination.example:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	connection.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err := io.ReadFull(connection, make([]byte, 6)); err != nil {
+		t.Fatal(err)
+	}
+	connection.Write([]byte("remaining response"))
+	if err := connection.(interface{ CloseWrite() error }).CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(connection)
+	if err != nil || string(body) != "remaining response" {
+		t.Fatal("half-close lost pending response", err)
+	}
+}
+
+func TestCONNECTHeaderBoundsAndNoImplicitDirectFallback(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		connection, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer connection.Close()
+		connection.SetDeadline(time.Now().Add(2 * time.Second))
+		http.ReadRequest(bufio.NewReader(connection))
+		io.WriteString(connection, "HTTP/1.1 200 OK\r\nX-Large: "+strings.Repeat("a", 5000)+"\r\n\r\n")
+	}()
+	policy, _ := New(Config{Version: 1, Mode: "url", URL: "http://" + listener.Addr().String()}, nil)
+	if _, err := policy.DialTunnel(context.Background(), "destination.example:443"); err == nil {
+		t.Fatal("oversize CONNECT response accepted")
+	}
+	<-done
+}
