+}
+
+func privateFixture(t *testing.T) *PrivateTransport {
+	t.Helper()
+	now := time.Now().UTC().Truncate(time.Second)
+	p, err := NewPrivateTransport(now, now.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// Two owned memory endpoints, bounded operations and positive goroutine join.
+// No operating-system socket, file, kine server or production lifecycle is used.
+func privateExchange(server, client *tls.Config) (error, error) {
+	// Bounded in-memory buffering permits simultaneous TLS 1.3 application and
+	// rejection-alert writes; an unbuffered net.Pipe can deadlock those writes.
+	listener := bufconn.Listen(64 << 10)
+	defer listener.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	results := make(chan error, 2)
+	go func() {
+		a, err := listener.Accept()
+		if err != nil {
+			results <- err
+			return
+		}
+		defer a.Close()
+		_ = a.SetDeadline(time.Now().Add(time.Second))
+		conn := tls.Server(a, server)
+		err = conn.HandshakeContext(ctx)
+		if err == nil {
+			var payload [1]byte
+			_, err = io.ReadFull(conn, payload[:])
+			if err == nil {
+				_, err = conn.Write(payload[:])
+			}
+		}
+		results <- err
+	}()
+	go func() {
+		b, err := listener.DialContext(ctx)
+		if err != nil {
+			_ = listener.Close()
+			results <- err
+			return
+		}
+		defer b.Close()
+		_ = b.SetDeadline(time.Now().Add(time.Second))
+		conn := tls.Client(b, client)
+		err = conn.HandshakeContext(ctx)
+		if err == nil {
+			_, err = conn.Write([]byte{17})
+			if err == nil {
+				var payload [1]byte
+				_, err = io.ReadFull(conn, payload[:])
+			}
+		}
+		results <- err
+	}()
+	return <-results, <-results
+}
+
+func TestPrivateTransportMutualAuthenticationAndRefusals(t *testing.T) {
+	p, foreign := privateFixture(t), privateFixture(t)
+	cases := []struct {
+		name   string
+		change func(*tls.Config, *tls.Config)
+	}{
+		{"no-client-certificate", func(_, c *tls.Config) { c.Certificates = nil }},
+		{"foreign-client", func(_, c *tls.Config) { c.Certificates = privateClient(t, foreign).Certificates }},
+		{"foreign-server", func(s, _ *tls.Config) { s.Certificates = privateServer(t, foreign).Certificates }},
+		{"wrong-loopback-name", func(_, c *tls.Config) { c.ServerName = "127.0.0.2" }},
+		{"client-as-server", func(s, _ *tls.Config) { s.Certificates = privateClient(t, p).Certificates }},
+		{"server-as-client", func(_, c *tls.Config) { c.Certificates = privateServer(t, p).Certificates }},
+		{"expired", func(s, c *tls.Config) {
+			s.Time = func() time.Time { return p.Expires().Add(time.Second) }
+			c.Time = s.Time
+		}},
+		{"tls12", func(_, c *tls.Config) { c.MinVersion = tls.VersionTLS12; c.MaxVersion = tls.VersionTLS12 }},
+		{"extra-client-trust-still-pinned", func(s, c *tls.Config) {
+			foreignFiles := foreign.Files()
+			if !s.ClientCAs.AppendCertsFromPEM(foreignFiles.CA) {
+				t.Fatal("fixture CA")
+			}
+			c.Certificates = privateClient(t, foreign).Certificates
+		}},
+		{"extra-server-trust-still-pinned", func(s, c *tls.Config) {
+			if !c.RootCAs.AppendCertsFromPEM(foreign.Files().CA) {
+				t.Fatal("fixture CA")
+			}
+			s.Certificates = privateServer(t, foreign).Certificates
+		}},
+	}
+	if a, b := privateExchange(privateServer(t, p), privateClient(t, p)); a != nil || b != nil {
+		t.Fatal("matching private peers refused", a, b)
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s, c := privateServer(t, p), privateClient(t, p)
+			tc.change(s, c)
+			a, b := privateExchange(s, c)
+			if a == nil && b == nil {
+				t.Fatal("untrusted exchange accepted")
+			}
+			if strings.HasPrefix(tc.name, "extra-") &&
+				!strings.Contains(fmt.Sprint(a, b), "private datastore peer identity differs") {
+				t.Fatal("exact peer pin was not exercised", a, b)
+			}
+			for _, err := range []error{a, b} {
+				if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+					t.Fatal("timeout is not authentication refusal evidence", a, b)
+				}
+			}
+		})
+	}
+}
