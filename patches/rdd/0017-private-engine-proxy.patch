+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Mutates ONLY the new fixture ancestor. Preflight prevents repeating the prior
+// fault-fixture cleanup denial: current owner FullControl must remain inheritable.
+func setFreshAncestorGrant(t *testing.T, path, sid, rights string) {
+	t.Helper()
+	sd, e := windows.SecurityDescriptorFromString("D:P(A;OICI;FA;;;" + sid + ")(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;" + rights + ";;;WD)")
+	if e != nil {
+		t.Fatal("fresh ancestor descriptor unavailable")
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || acl == nil {
+		t.Fatal("fresh ancestor descriptor missing")
+	}
+	cleanupSafe := false
+	for i := uint32(0); i < uint32(acl.AceCount); i++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if windows.GetAce(acl, i, &ace) != nil || ace == nil || ace.Header.AceType != 0 || ace.Header.AceSize < 16 {
+			t.Fatal("fixture ACL preflight failed")
+		}
+		principal := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		if !principal.IsValid() || principal.Len() > int(ace.Header.AceSize)-8 {
+			t.Fatal("fixture principal preflight failed")
+		}
+		if principal.String() == sid && uint32(ace.Mask) == 0x1f01ff && ace.Header.AceFlags == 3 {
+			cleanupSafe = true
+		}
+	}
+	if !cleanupSafe {
+		t.Fatal("fixture would remove inherited owner cleanup rights")
+	}
+	if windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil {
+		t.Fatal("fresh fixture ancestor grant failed")
+	}
+}
+
+func TestProtectedAnchorAndConfigResistAncestorInheritanceChanges(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	created, e := createFreshDefault(context.Background(), parent, []byte("anchor boundary fixture"))
+	if e != nil {
+		t.Fatal("fresh protected creation failed")
+	}
+	defer created.Close()
+	for _, rights := range []string{"GR", "WD", "FA"} {
+		t.Run(rights, func(t *testing.T) {
+			setFreshAncestorGrant(t, dir, sid, rights)
+			if verifyPrivate(created.anchor, sid, true) != nil || verifyPrivate(created.file, sid, false) != nil {
+				t.Fatal("ancestor propagation changed protected private child descriptors")
+			}
+			accepted := checkReadObject(parent.leaf(), sid, true) == nil
+			if rights == "GR" && !accepted {
+				t.Fatal("ordinary broader-read parent incorrectly refused")
+			}
+			if rights != "GR" && accepted {
+				t.Fatal("test changed conservative ancestor mutation refusal")
+			}
+		})
+	}
+}
+
+func TestFullStrongChainRetainsPrivateAnchorAfterCallerCloses(t *testing.T) {
+	parent, dir, _ := readerFixture(t)
+	if walkRelative(context.Background(), parent, []string{"one", "two"}) != nil {
+		t.Fatal("fresh retained chain failed")
+	}
+	created, e := createFreshDefault(context.Background(), parent, []byte("retained chain fixture"))
+	if e != nil {
+		t.Fatal("fresh private anchor creation failed")
+	}
+	defer created.Close()
+	anchor := filepath.Join(dir, "one", "two", anchorName)
+	t.Cleanup(func() {
+		created.Close()
+		for _, path := range []string{filepath.Join(anchor, configName), anchor} {
+			if e := os.Remove(path); e != nil && !os.IsNotExist(e) {
+				t.Error("known private anchor fixture cleanup failed")
+			}
+		}
+	})
+	parent.Close()
+	if os.Rename(filepath.Join(dir, "one"), filepath.Join(dir, "moved")) == nil {
+		os.Rename(filepath.Join(dir, "moved"), filepath.Join(dir, "one"))
+		t.Fatal("retained complete chain allowed ancestor replacement")
+	}
+	if os.Rename(anchor, anchor+"-moved") == nil {
+		os.Rename(anchor+"-moved", anchor)
+		t.Fatal("retained private anchor replaced")
+	}
+	created.Close()
+	if os.Rename(filepath.Join(dir, "one"), filepath.Join(dir, "moved")) != nil {
+		t.Fatal("complete chain did not release")
+	}
+	if os.Rename(filepath.Join(dir, "moved"), filepath.Join(dir, "one")) != nil {
+		t.Fatal("fresh namespace restore failed")
+	}
+}
+
+func TestPrecreatedUntrustedWritableComponentNeverAdopted(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	anchor := filepath.Join(dir, anchorName)
+	if os.Mkdir(anchor, 0700) != nil || os.WriteFile(filepath.Join(anchor, configName), []byte("precreated literal sentinel"), 0600) != nil {
+		t.Fatal("fresh precreated component setup failed")
+	}
+	setFreshAncestorGrant(t, anchor, sid, "FA")
+	if created, e := createFreshDefault(context.Background(), parent, []byte("new bytes")); e == nil {
+		created.Close()
+		t.Fatal("precreated writable component adopted")
+	}
+	data, e := os.ReadFile(filepath.Join(anchor, configName))
+	if e != nil || !bytes.Equal(data, []byte("precreated literal sentinel")) {
+		t.Fatal("precreated component bytes changed")
+	}
+	// This deliberately uses current-user-owned fixtures. No foreign owner was
+	// forged and no cross-user ownership/access qualification is claimed.
+}
+
+func TestPrivateTLSAuthorityStateSharesProtectedCreationBoundary(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	created, e := createFreshDefault(context.Background(), parent, []byte("config fixture"))
+	if e != nil {
+		t.Fatal("private config fixture failed")
+	}
+	defer created.Close()
+	tlsSD, e := privateDescriptor(sid, true)
+	if e != nil {
+		t.Fatal("private TLS descriptor failed")
+	}
+	tls, e := openRelative(created.anchor, "tls", true, tlsSD, true)
+	if e != nil {
+		t.Fatal("private TLS fixture directory failed")
+	}
+	defer windows.CloseHandle(tls)
+	t.Cleanup(func() {
+		for _, path := range []string{filepath.Join(dir, anchorName, "tls", "serving.key"), filepath.Join(dir, anchorName, "tls")} {
+			if e := os.Remove(path); e != nil && !os.IsNotExist(e) {
+				t.Error("known TLS fixture cleanup failed")
+			}
+		}
+	})
+	keySD, e := privateDescriptor(sid, false)
+	if e != nil {
+		t.Fatal("private key descriptor failed")
+	}
+	key, e := openRelative(tls, "serving.key", false, keySD, true)
+	if e != nil {
+		t.Fatal("private TLS key fixture failed")
+	}
+	defer windows.CloseHandle(key)
+	if verifyPrivate(tls, sid, true) != nil || verifyPrivate(key, sid, false) != nil {
+		t.Fatal("TLS authority state not private before first write")
+	}
+	if _, e := nativeWrite(key, []byte("literal fake TLS key")); e != nil {
+		t.Fatal("fresh TLS fixture write failed")
+	}
+	setFreshAncestorGrant(t, dir, sid, "FA")
+	if verifyPrivate(tls, sid, true) != nil || verifyPrivate(key, sid, false) != nil {
+		t.Fatal("ancestor changed protected TLS descriptors")
+	}
+	// No actual certificate, key, service path, guest or API is involved.
+}
+
+func TestPrivateDACLDoesNotSandboxSameUser(t *testing.T) {
+	parent, dir, _ := fixture(t)
+	created, e := createFreshDefault(context.Background(), parent, []byte("first own-user bytes"))
+	if e != nil {
+		t.Fatal("private same-user fixture failed")
+	}
+	created.Close()
+	path := filepath.Join(dir, anchorName, configName)
+	if os.WriteFile(path, []byte("same-user replacement"), 0600) != nil {
+		t.Fatal("private DACL unexpectedly prevented current owner write")
+	}
+	data, e := os.ReadFile(path)
+	if e != nil || !bytes.Equal(data, []byte("same-user replacement")) {
+		t.Fatal("same-user fixture replacement missing")
+	}
+}
