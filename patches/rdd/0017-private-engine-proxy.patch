+package networkproxy
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	extensions "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions"
+	extensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	schemaValidation "k8s.io/apiextensions-apiserver/pkg/apiserver/validation"
+	"k8s.io/apimachinery/pkg/util/validation/field"
+	"sigs.k8s.io/yaml"
+)
+
+func generatedValidator(t *testing.T, section, property string) schemaValidation.SchemaValidator {
+	t.Helper()
+	raw, err := os.ReadFile("../controllers/app/app/crd.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var crd extensionsv1.CustomResourceDefinition
+	if err := yaml.UnmarshalStrict(raw, &crd); err != nil {
+		t.Fatal(err)
+	}
+	schema := crd.Spec.Versions[0].Schema.OpenAPIV3Schema.Properties[section].Properties[property]
+	if schema.Type != "object" {
