+	}
+	// Wrong creation is rejected before attempting any fixed real-config path.
+	if client, err := LoadOwnedManagementClient(ManagementInstanceRoot{Suffix: "fixture"}, ManagementBinding{InstanceID: "rancher-desktop-fixture", AppUID: "fixture-app"}, expected); err != ErrManagement || client != nil {
