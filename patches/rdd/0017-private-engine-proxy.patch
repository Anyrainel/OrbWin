index 0000000..5bc39c2
--- /dev/null
+++ b/rdd/pkg/controllers/lima/limavm/controllers/startup_retirement.go
@@ -0,0 +1,32 @@
+package controllers
+
+import (
+	"errors"
+	"time"
+)
+
+var errStartupRetirementUnknown = errors.New("started hostagent retirement unknown")
+
+// Called once only after original cmd.Start succeeded and its existing watcher
+// acquired sole cmd.Wait ownership. kill targets that retained os.Process, never
+// an ambient/reused integer PID. Unknown join leaves the same watcher registered
+// and does not call Wait/Start again. No native Kill wallclock bound is claimed.
+func retireStartedHostagent(kill func() error, exited <-chan struct{}, budget time.Duration) error {
+	if kill == nil || exited == nil || budget <= 0 {
+		return errStartupRetirementUnknown
+	}
+	select {
+	case <-exited:
+		return nil
+	default:
+	}
+	_ = kill() // Already-exited and failed-kill cases still require actual Wait.
+	timer := time.NewTimer(budget)
+	defer timer.Stop()
+	select {
+	case <-exited:
+		return nil
+	case <-timer.C:
+		return errStartupRetirementUnknown
+	}
+}
