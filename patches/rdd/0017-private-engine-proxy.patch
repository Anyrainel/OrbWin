+	var starts atomic.Int32
+	factory := func(context.Context, context.Context, Config) (*Policy, GenerationResource, error) {
+		starts.Add(1)
+		return nil, nil, errAutoChild
+	}
+	c, err := NewPolicyConsumerWithPreparation(ctx, source, native.value, native.observe, factory, func(context.Context, Config) error { return ErrProxyRetirement })
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.endpointState(true)
+	if c.Run(ctx) != ErrProxyRetirement {
+		t.Fatal("preparation close failure lost unknown outcome")
+	}
+	source.mu.Lock()
+	host := source.lastHost.DeepCopy()
+	source.mu.Unlock()
+	if starts.Load() != 0 || len(source.watches) != 0 || host.Phase != "degraded" || host.Reason != "RetirementUnknown" {
+		t.Fatal("unknown preparation advanced provider, watch or guest admission")
+	}
+	cleanup, stop := context.WithTimeout(context.Background(), time.Second)
+	defer stop()
+	c.Close(cleanup)
+}
diff --git a/rdd/pkg/networkproxy/consumer_refresh_test.go b/rdd/pkg/networkproxy/consumer_refresh_test.go
new file mode 100644
index 0000000..0e195f1
