diff --git a/rdd/pkg/networkproxy/bounded_auto_test.go b/rdd/pkg/networkproxy/bounded_auto_test.go
new file mode 100644
index 0000000..6428b97
--- /dev/null
+++ b/rdd/pkg/networkproxy/bounded_auto_test.go
@@ -0,0 +1,292 @@
+package networkproxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net/url"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type fakeAutoResolver struct {
+	captures, resolves atomic.Int32
+	capture            func(context.Context) error
+	resolve            func(context.Context, *url.URL) ([]Route, error)
+}
+
+func (r *fakeAutoResolver) Capture(ctx context.Context) error {
+	r.captures.Add(1)
+	if r.capture != nil {
+		return r.capture(ctx)
+	}
+	return nil
+}
+func (r *fakeAutoResolver) Resolve(ctx context.Context, target *url.URL) ([]Route, error) {
+	r.resolves.Add(1)
+	if r.resolve != nil {
+		return r.resolve(ctx, target)
+	}
+	return []Route{{Proxy: "http://proxy.invalid:8080"}, {Direct: true}}, nil
+}
+func (r *fakeAutoResolver) Close(context.Context) error { return nil }
+
+// In-memory transport and injected process lifecycle. These tests do not start
+// a process or call WinHTTP/native identity APIs.
+type fakeAutoChild struct {
+	input          *io.PipeWriter
+	output         *io.PipeReader
+	workerInput    *io.PipeReader
+	workerOutput   *io.PipeWriter
+	exited, killed chan struct{}
+	killOnce       sync.Once
+	waits, kills   atomic.Int32
+	retirement     chan struct{}
+	closeErr       error
+	waitErr        error
+}
+
+func newFakeAutoChild(resolver *fakeAutoResolver) *fakeAutoChild {
+	readIn, writeIn := io.Pipe()
+	readOut, writeOut := io.Pipe()
+	p := &fakeAutoChild{input: writeIn, output: readOut, workerInput: readIn, workerOutput: writeOut, exited: make(chan struct{}), killed: make(chan struct{})}
+	go func() {
+		_ = runAutoWorkerProtocol(readIn, writeOut, resolver)
+		readIn.Close()
+		writeOut.Close()
+		close(p.exited)
+	}()
+	return p
+}
+func (p *fakeAutoChild) Input() io.Writer  { return p.input }
+func (p *fakeAutoChild) Output() io.Reader { return p.output }
+func (p *fakeAutoChild) ClosePipes() error { p.input.Close(); p.output.Close(); return p.closeErr }
+func (p *fakeAutoChild) Kill() error {
+	p.kills.Add(1)
+	p.killOnce.Do(func() { close(p.killed) })
+	p.workerInput.Close()
+	p.workerOutput.Close()
+	return nil
+}
+func (p *fakeAutoChild) Wait() error {
+	p.waits.Add(1)
+	<-p.exited
+	if p.retirement != nil {
+		<-p.retirement
+	}
+	return p.waitErr
+}
+func closeFakeAuto(t *testing.T, w *boundedAuto) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := w.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestBoundedAutoProtocolCapturesOnceAndPreservesOrderedDecisions(t *testing.T) {
+	r := &fakeAutoResolver{}
+	p := newFakeAutoChild(r)
+	w, err := startBoundedAuto(context.Background(), context.Background(), func() (autoChildProcess, error) { return p, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	target, _ := url.Parse("https://destination.invalid/path")
+	for i := 0; i < 2; i++ {
+		routes, err := w.Resolve(context.Background(), target)
+		if err != nil || len(routes) != 2 || routes[0].Proxy != "http://proxy.invalid:8080" || !routes[1].Direct {
+			t.Fatal("ordered proxy/DIRECT decision changed")
+		}
+	}
+	closeFakeAuto(t, w)
+	closeFakeAuto(t, w)
+	if r.captures.Load() != 1 || r.resolves.Load() != 2 || p.waits.Load() != 1 || p.kills.Load() != 1 {
+		t.Fatal("capture, operation, kill or Wait replayed")
+	}
+}
+
+func TestBoundedAutoBackpressureHasNoQueueOrReplacement(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	r := &fakeAutoResolver{resolve: func(context.Context, *url.URL) ([]Route, error) {
+		close(entered)
+		<-release
+		return []Route{{Direct: true}}, nil
+	}}
+	p := newFakeAutoChild(r)
+	var launches atomic.Int32
+	w, err := startBoundedAuto(context.Background(), context.Background(), func() (autoChildProcess, error) { launches.Add(1); return p, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	target, _ := url.Parse("https://destination.invalid/")
+	done := make(chan error, 1)
+	go func() { _, err := w.Resolve(context.Background(), target); done <- err }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("decision did not start")
+	}
+	if _, err = w.Resolve(context.Background(), target); err == nil {
+		t.Fatal("concurrent request queued/admitted")
+	}
+	close(release)
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+	closeFakeAuto(t, w)
+	if launches.Load() != 1 || r.resolves.Load() != 1 {
+		t.Fatal("backpressure replayed worker/request")
+	}
+}
+
+func TestBoundedAutoCaptureTimeoutRetiresPartialResource(t *testing.T) {
+	var p *fakeAutoChild
+	r := &fakeAutoResolver{capture: func(context.Context) error { <-p.killed; return errors.New("private URL must not escape") }}
+	p = newFakeAutoChild(r)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	w, err := startBoundedAuto(ctx, context.Background(), func() (autoChildProcess, error) { return p, nil })
+	if err == nil || w == nil || err.Error() != "bounded automatic proxy worker unavailable" {
+		t.Fatal("timeout lost partial ownership or private error escaped")
+	}
+	closeFakeAuto(t, w)
+	if p.waits.Load() != 1 || p.kills.Load() != 1 {
+		t.Fatal("partial worker was not killed/joined exactly once")
+	}
+}
+
+func TestBoundedAutoUnknownWaitAndPipeCloseNeverReportRetired(t *testing.T) {
+	for _, pipeFailure := range []bool{false, true} {
+		r := &fakeAutoResolver{}
+		p := newFakeAutoChild(r)
+		if pipeFailure {
+			p.closeErr = errors.New("unknown close")
+		} else {
+			p.retirement = make(chan struct{})
+		}
+		w, err := startBoundedAuto(context.Background(), context.Background(), func() (autoChildProcess, error) { return p, nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+		if w.Close(ctx) != ErrProxyRetirement {
+			t.Fatal("unknown join/close became success")
+		}
+		cancel()
+		if !pipeFailure {
+			close(p.retirement)
+			closeFakeAuto(t, w)
+		}
+		if p.waits.Load() != 1 || p.kills.Load() != 1 {
+			t.Fatal("cleanup retry repeated process ownership")
+		}
+	}
+}
+
+func TestBoundedAutoCancelledLaunchIsRetainedWithoutReplacement(t *testing.T) {
+	release := make(chan struct{})
+	var launches atomic.Int32
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	w, err := startBoundedAuto(ctx, context.Background(), func() (autoChildProcess, error) {
+		launches.Add(1)
+		<-release
+		return newFakeAutoChild(&fakeAutoResolver{}), nil
+	})
+	if err == nil || w == nil {
+		t.Fatal("in-flight startup lost ownership")
+	}
+	short, stop := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	if w.Close(short) != ErrProxyRetirement {
+		t.Fatal("unreturned launch treated as joined")
+	}
+	stop()
+	close(release)
+	closeFakeAuto(t, w)
+	if launches.Load() != 1 {
+		t.Fatal("late startup was replayed")
+	}
+}
+
+func TestBoundedAutoUnknownWaitErrorCannotAuthorizeRetirement(t *testing.T) {
+	p := newFakeAutoChild(&fakeAutoResolver{})
+	p.waitErr = errors.New("unknown wait")
+	w, err := startBoundedAuto(context.Background(), context.Background(), func() (autoChildProcess, error) { return p, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if w.Close(ctx) != ErrProxyRetirement {
+		t.Fatal("failed Wait became positive child retirement")
+	}
+	if p.waits.Load() != 1 || p.kills.Load() != 1 {
+		t.Fatal("unknown wait repeated child cleanup")
+	}
+}
+
+func TestBoundedAutoPacketParserRefusesOversizeDuplicateAndTrailingFields(t *testing.T) {
+	for _, raw := range []string{
+		`{"version":1,"sequence":1,"operation":"capture","url":"","version":1}`,
+		`{"version":1,"sequence":1,"operation":"capture","url":"","path":"foreign"}`,
+		`{"version":1,"sequence":1,"operation":"capture","url":""}{}`,
+	} {
+		var packet bytes.Buffer
+		var header [4]byte
+		binary.BigEndian.PutUint32(header[:], uint32(len(raw)))
+		packet.Write(header[:])
+		packet.WriteString(raw)
+		var request autoRequest
+		if readAutoPacket(&packet, &request) == nil {
+			t.Fatal("noncanonical packet accepted")
+		}
+	}
+	var header [4]byte
+	binary.BigEndian.PutUint32(header[:], autoPacketLimit+1)
+	var request autoRequest
+	if readAutoPacket(bytes.NewReader(header[:]), &request) == nil {
+		t.Fatal("oversize packet allocated/accepted")
+	}
+	var input, output bytes.Buffer
+	writeAutoPacket(&input, autoRequest{1, 1, "resolve", "https://destination.invalid"})
+	r := &fakeAutoResolver{}
+	if runAutoWorkerProtocol(&input, &output, r) == nil || r.captures.Load() != 0 || r.resolves.Load() != 0 {
+		t.Fatal("worker admitted resolve before explicit capture")
+	}
+}
+
+type autoAdmissionLease struct {
+	closes atomic.Int32
+	err    error
+}
+
+func (l *autoAdmissionLease) Close() error { l.closes.Add(1); return l.err }
+func TestBoundedAutoPreparationChecksAndLatchesImageCleanupUnknown(t *testing.T) {
+	for _, failure := range []error{nil, ErrProxyRetirement} {
+		lease := &autoAdmissionLease{err: failure}
+		var probes atomic.Int32
+		admission := &autoImageAdmission{probe: func(context.Context) (io.Closer, error) { probes.Add(1); return lease, nil }}
+		err := admission.check(context.Background())
+		if failure == nil {
+			if err != nil || admission.blocked() {
+				t.Fatal("known checked image admission failed")
+			}
+		} else {
+			if err != ErrProxyRetirement || !admission.blocked() || admission.retained != lease {
+				t.Fatal("unknown close lost retained image lease")
+			}
+			if admission.check(context.Background()) != ErrProxyRetirement || probes.Load() != 1 || lease.closes.Load() != 1 {
+				t.Fatal("unknown image cleanup was retried")
+			}
+		}
+	}
+	admission := &autoImageAdmission{probe: func(context.Context) (io.Closer, error) { return nil, errAutoChild }}
+	if admission.check(context.Background()) == nil || admission.blocked() {
+		t.Fatal("ordinary unavailable image became prepared/unknown")
+	}
+}
diff --git a/rdd/pkg/networkproxy/bounded_auto_windows.go b/rdd/pkg/networkproxy/bounded_auto_windows.go
new file mode 100644
index 0000000..6c92e91
--- /dev/null
+++ b/rdd/pkg/networkproxy/bounded_auto_windows.go
@@ -0,0 +1,409 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"golang.org/x/sys/windows"
+)
+
+type autoLaunchIdentity struct {
+	Version int                      `json:"version"`
+	Parent  NativeManagementIdentity `json:"parent"`
+	Image   string                   `json:"image"`
+}
+
+func encodeAutoLaunch(identity autoLaunchIdentity) (string, error) {
+	if identity.Version != 1 || identity.Parent.PID == 0 || identity.Parent.Session == 0 || !hexIdentity(identity.Parent.CreationTime, 16) || identity.Parent.CreationTime == "0000000000000000" || !hexIdentity(identity.Image, 64) || identity.Image == strings.Repeat("0", 64) {
+		return "", errAutoChild
+	}
+	data, err := json.Marshal(identity)
+	if err != nil || len(data) > 512 {
+		return "", errAutoChild
+	}
+	return base64.RawURLEncoding.EncodeToString(data), nil
+}
+func parseAutoLaunch(raw string) (autoLaunchIdentity, error) {
+	var identity autoLaunchIdentity
+	if len(raw) > 684 {
+		return identity, errAutoChild
+	}
+	data, err := base64.RawURLEncoding.Strict().DecodeString(raw)
+	if err != nil || json.Unmarshal(data, &identity) != nil {
+		return autoLaunchIdentity{}, errAutoChild
+	}
+	canonical, err := encodeAutoLaunch(identity)
+	if err != nil || canonical != raw {
+		return autoLaunchIdentity{}, errAutoChild
+	}
+	return identity, nil
+}
+
+// Both native process identity and immutable bytes are verified while image and
+// all path ancestors remain open without DELETE sharing. No path is supplied by
+// settings/renderer/stdio. Calls remain synchronous native metadata operations;
+// process containment specifically bounds WinHTTP capture/evaluation lifetime.
+type autoImageLease struct {
+	held      []*os.File
+	path      string
+	process   windows.Handle
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func (l *autoImageLease) Close() error {
+	l.closeOnce.Do(func() {
+		for i := len(l.held) - 1; i >= 0; i-- {
+			if l.held[i].Close() != nil {
+				l.closeErr = ErrProxyRetirement
+			}
+		}
+		if l.process != 0 && windows.CloseHandle(l.process) != nil {
+			l.closeErr = ErrProxyRetirement
+		}
+	})
+	return l.closeErr
+}
+
+func autoImageLeaseResult(lease *autoImageLease, err error) (io.Closer, error) {
+	if lease == nil {
+		return nil, err
+	}
+	return lease, err
+}
+
+func holdAutoImage(ctx context.Context, expected NativeManagementIdentity, digest string) (result *autoImageLease, resultErr error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, errAutoChild
+	}
+	actual, err := observeManagementPID(expected.PID)
+	if err != nil || actual != expected {
+		return nil, errAutoChild
+	}
+	p, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, expected.PID)
+	if err != nil {
+		return nil, errAutoChild
+	}
+	lease := &autoImageLease{process: p}
+	success := false
+	defer func() {
+		if !success {
+			if lease.Close() != nil {
+				result = lease
+				resultErr = ErrProxyRetirement
+			}
+		}
+	}()
+	var path [1024]uint16
+	size := uint32(len(path))
+	if windows.QueryFullProcessImageName(p, 0, &path[0], &size) != nil || size == 0 || size >= uint32(len(path)) {
+		return nil, errAutoChild
+	}
+	name := windows.UTF16ToString(path[:size])
+	volume := filepath.VolumeName(name)
+	if len(volume) != 2 || volume[1] != ':' || !filepath.IsAbs(name) || filepath.Clean(name) != name {
+		return nil, errAutoChild
+	}
+	lease.path = name
+	current := volume + `\`
+	parts := strings.Split(strings.TrimPrefix(name, current), `\`)
+	if len(parts) < 1 || len(parts) > 64 {
+		return nil, errAutoChild
+	}
+	// Hold volume and every directory, using the existing directory-integrity
+	// policy; a permissive ancestor is refused, never repaired or exempted.
+	for index := -1; index < len(parts); index++ {
+		if index >= 0 {
+			if parts[index] == "" || parts[index] == "." || parts[index] == ".." {
+				return nil, errAutoChild
+			}
+			current = filepath.Join(current, parts[index])
+		}
+		directory := index < len(parts)-1
+		access := uint32(windows.GENERIC_READ | windows.READ_CONTROL)
+		flags := uint32(windows.FILE_FLAG_OPEN_REPARSE_POINT)
+		sharing := uint32(windows.FILE_SHARE_READ)
+		if directory {
+			access = windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL
+			flags |= windows.FILE_FLAG_BACKUP_SEMANTICS
+			sharing |= windows.FILE_SHARE_WRITE
+		}
+		pointer, e := windows.UTF16PtrFromString(current)
+		if e != nil {
+			return nil, errAutoChild
+		}
+		h, e := windows.CreateFile(pointer, access, sharing, nil, windows.OPEN_EXISTING, flags, 0)
+		if e != nil {
+			return nil, errAutoChild
+		}
+		file := os.NewFile(uintptr(h), "held automatic proxy executable object")
+		lease.held = append(lease.held, file)
+		var info windows.ByHandleFileInformation
+		kind, kindErr := windows.GetFileType(h)
+		if kindErr != nil || kind != windows.FILE_TYPE_DISK || windows.GetFileInformationByHandle(h, &info) != nil || info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 ||
+			(directory != (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0)) {
+			return nil, errAutoChild
+		}
+		if directory && managementconfig.CheckReadObjectPolicy(h, true) != nil {
+			return nil, errAutoChild
+		}
+		if !directory {
+			stat, e := file.Stat()
+			if e != nil || stat.Size() < 1 || stat.Size() > 512<<20 {
+				return nil, errAutoChild
+			}
+			hash := sha256.New()
+			buffer := make([]byte, 64<<10)
+			var total int64
+			for {
+				if ctx.Err() != nil {
+					return nil, errAutoChild
+				}
+				n, e := file.Read(buffer)
+				total += int64(n)
+				if total > 512<<20 {
+					return nil, errAutoChild
+				}
+				if n > 0 {
+					hash.Write(buffer[:n])
+				}
+				if e == io.EOF {
+					break
+				}
+				if e != nil {
+					return nil, errAutoChild
+				}
+			}
+			if total != stat.Size() || hex.EncodeToString(hash.Sum(nil)) != digest {
+				return nil, errAutoChild
+			}
+		}
+	}
+	actual, err = observeManagementPID(expected.PID)
+	if err != nil || actual != expected || ctx.Err() != nil {
+		return nil, errAutoChild
+	}
+	success = true
+	return lease, nil
+}
+
+type nativeAutoChild struct {
+	cmd    *exec.Cmd
+	input  io.WriteCloser
+	output io.ReadCloser
+	leases []*autoImageLease
+}
+
+func (p *nativeAutoChild) Input() io.Writer  { return p.input }
+func (p *nativeAutoChild) Output() io.Reader { return p.output }
+func (p *nativeAutoChild) Wait() error {
+	if p.cmd == nil || p.cmd.Process == nil {
+		return nil
+	}
+	err := p.cmd.Wait()
+	if err == nil {
+		return nil
+	}
+	var exit *exec.ExitError
+	if errors.As(err, &exit) && p.cmd.ProcessState != nil && p.cmd.ProcessState.Exited() {
+		return nil
+	}
+	return ErrProxyRetirement
+}
+func (p *nativeAutoChild) Kill() error {
+	if p.cmd == nil || p.cmd.Process == nil {
+		return nil
+	}
+	return p.cmd.Process.Kill()
+}
+func (p *nativeAutoChild) ClosePipes() (result error) {
+	for _, pipe := range []io.Closer{p.input, p.output} {
+		if pipe != nil {
+			if e := pipe.Close(); e != nil && !errors.Is(e, os.ErrClosed) {
+				result = ErrProxyRetirement
+			}
+		}
+	}
+	for _, lease := range p.leases {
+		if lease.Close() != nil {
+			result = ErrProxyRetirement
+		}
+	}
+	return result
+}
+
+// Parent/image pins come from the authenticated hostagent launcher selection.
+// Preparation checks the exact read-only image lease and checked close; no
+// child start, owner configuration capture or PAC request occurs there.
+func NewBoundedAutoProvider(expected NativeManagementIdentity, image [32]byte) (GenerationFactory, PolicyPreparation, error) {
+	digest := hex.EncodeToString(image[:])
+	argument, err := encodeAutoLaunch(autoLaunchIdentity{1, expected, digest})
+	if err != nil || image == [32]byte{} {
+		return nil, nil, errAutoChild
+	}
+	admission := &autoImageAdmission{probe: func(ctx context.Context) (io.Closer, error) {
+		return autoImageLeaseResult(holdAutoImage(ctx, expected, digest))
+	}}
+	prepare := func(ctx context.Context, config Config) error {
+		if config.Validate() != nil {
+			return errAutoChild
+		}
+		return admission.check(ctx)
+	}
+
+	factory := func(startup, lifetime context.Context, config Config) (*Policy, GenerationResource, error) {
+		if admission.blocked() {
+			return nil, nil, ErrProxyRetirement
+		}
+		if config.Mode != "auto" {
+			return StaticPolicyFactory(startup, lifetime, config)
+		}
+		worker, err := startBoundedAuto(startup, lifetime, func() (autoChildProcess, error) {
+			lease, e := holdAutoImage(startup, expected, digest)
+			if e != nil {
+				if lease != nil {
+					return &nativeAutoChild{leases: []*autoImageLease{lease}}, ErrProxyRetirement
+				}
+				return nil, errAutoChild
+			}
+			child := &nativeAutoChild{leases: []*autoImageLease{lease}}
+			cmd := exec.Command(lease.path, "--instance", "orbwin", "private-auto-worker", argument)
+			child.cmd = cmd
+			cmd.SysProcAttr = &windows.SysProcAttr{CreationFlags: windows.CREATE_NO_WINDOW}
+			input, e := cmd.StdinPipe()
+			if e != nil {
+				return child, errAutoChild
+			}
+			child.input = input
+			output, e := cmd.StdoutPipe()
+			if e != nil {
+				return child, errAutoChild
+			}
+			child.output = output
+			cmd.Stderr = io.Discard
+			if e = cmd.Start(); e != nil {
+				return child, errAutoChild
+			}
+			actual, e := observeManagementPID(uint32(cmd.Process.Pid))
+			if e != nil || actual.Session != expected.Session {
+				return child, errAutoChild
+			}
+			imageLease, e := holdAutoImage(startup, actual, digest)
+			if imageLease != nil {
+				child.leases = append(child.leases, imageLease)
+			}
+			if e != nil {
+				return child, e
+			}
+			return child, nil
+		})
+		if err != nil {
+			if worker == nil {
+				return nil, nil, err
+			}
+			return nil, worker, err
+		}
+		policy, err := New(config, worker)
+		return policy, worker, err
+	}
+	return factory, prepare, nil
+}
+
+// Only the fixed early-dispatched worker command calls this entry point. It
+// authenticates actual parent/owner/session/image before invoking WinHTTP.
+func RunBoundedAutoWorker(argument string, input io.Reader, output io.Writer) error {
+	metadata, err := parseAutoLaunch(argument)
+	if err != nil {
+		return errAutoChild
+	}
+	runtime.LockOSThread()
+	selfProcess, token, sid, self, err := nativeManagementProcess()
+	if err != nil {
+		runtime.UnlockOSThread()
+		return errAutoChild
+	}
+	windows.CloseHandle(selfProcess)
+	token.Close()
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	err = windows.NtQueryInformationProcess(windows.CurrentProcess(), 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size)
+	runtime.UnlockOSThread()
+	if err != nil || size != uint32(unsafe.Sizeof(basic)) || basic.UniqueProcessId != uintptr(self.PID) || basic.InheritedFromUniqueProcessId != uintptr(metadata.Parent.PID) || self.Session != metadata.Parent.Session {
+		return errAutoChild
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	parent, e := holdAutoImage(ctx, metadata.Parent, metadata.Image)
+	if e != nil {
+		return errAutoChild
+	}
+	defer parent.Close()
+	// Parent process exit is observed independently of stdin: a native Capture
+	// may block before another packet is read. Exit retires this worker only.
+	parentProcess := parent.process
+	go func() {
+		state, e := windows.WaitForSingleObject(parentProcess, windows.INFINITE)
+		if e != nil || state == uint32(windows.WAIT_OBJECT_0) {
+			os.Exit(2)
+		}
+	}()
+	own, e := holdAutoImage(ctx, self, metadata.Image)
+	if e != nil {
+		os.Exit(2)
+		return errAutoChild
+	}
+	defer own.Close()
+	resolver, e := NewNativeAutoResolver(sid)
+	if e != nil {
+		os.Exit(2)
+		return errAutoChild
+	}
+	err = runAutoWorkerProtocol(input, output, workerAutoResolver{resolver})
+	// No deferred native cleanup can strand the protocol process on EOF/error.
+	// The parent joins the actual process; OS exit retires its callback threads.
+	os.Exit(2)
+	return err
+}
+
+type workerAutoResolver struct{ *NativeAutoResolver }
+
+func (r workerAutoResolver) Resolve(ctx context.Context, target *url.URL) ([]Route, error) {
+	routes, err := r.NativeAutoResolver.Resolve(ctx, target)
+	if err != nil {
+		return nil, errAutoChild
+	}
+	// A successful answer alone is not callback retirement. Do not admit a next
+	// request while this resolver retains native handles/callback registrations.
+	timer := time.NewTicker(time.Millisecond)
+	defer timer.Stop()
+	for {
+		r.mu.Lock()
+		active := r.active
+		r.mu.Unlock()
+		if active == 0 {
+			return routes, nil
+		}
+		select {
+		case <-ctx.Done():
+			return nil, errAutoChild
+		case <-timer.C:
+		}
+	}
+}
diff --git a/rdd/pkg/networkproxy/bounded_auto_windows_test.go b/rdd/pkg/networkproxy/bounded_auto_windows_test.go
new file mode 100644
index 0000000..050f756
--- /dev/null
+++ b/rdd/pkg/networkproxy/bounded_auto_windows_test.go
@@ -0,0 +1,62 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+)
+
+func TestBoundedAutoLaunchSchemaAndProviderPreparationArePure(t *testing.T) {
+	closer, refusal := autoImageLeaseResult(nil, errAutoChild)
+	if closer != nil || refusal != errAutoChild {
+		t.Fatal("absent image lease became a nonnil interface")
+	}
+	identity := autoLaunchIdentity{Version: 1, Parent: NativeManagementIdentity{PID: 4242, CreationTime: "0000000000000011", Session: 1}, Image: strings.Repeat("a", 64)}
+	encoded, err := encodeAutoLaunch(identity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := parseAutoLaunch(encoded)
+	if err != nil || parsed != identity {
+		t.Fatal("closed launch did not round trip")
+	}
+	for _, changed := range []autoLaunchIdentity{
+		{Version: 1, Parent: NativeManagementIdentity{PID: 4242, CreationTime: strings.Repeat("0", 16), Session: 1}, Image: identity.Image},
+		{Version: 1, Parent: identity.Parent, Image: strings.Repeat("0", 64)},
+	} {
+		if _, err = encodeAutoLaunch(changed); err == nil {
+			t.Fatal("all-zero identity accepted")
+		}
+	}
+	data, _ := base64.RawURLEncoding.DecodeString(encoded)
+	for _, raw := range []string{
+		strings.Replace(string(data), `"version":1`, `"version":1,"version":1`, 1),
+		strings.Replace(string(data), `"version":1`, `"version":1,"URL":"https://private.invalid"`, 1),
+		string(data) + `{}`, strings.Replace(string(data), `"version":1`, `"version":2`, 1),
+	} {
+		if _, err = parseAutoLaunch(base64.RawURLEncoding.EncodeToString([]byte(raw))); err == nil {
+			t.Fatal("noncanonical launch accepted")
+		}
+	}
+	var pin [32]byte
+	pin[0] = 1
+	factory, prepare, err := NewBoundedAutoProvider(identity.Parent, pin)
+	if err != nil || factory == nil || prepare == nil {
+		t.Fatal("pure provider admission probed nonexistent process")
+	}
+	// The callback now performs read-only native image admission; do not invoke it here.
+	// A cancelled factory must refuse before its native launch closure and must
+	// return a truly nil resource, not a typed nil that could panic on Close.
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	policy, resource, startErr := factory(cancelled, context.Background(), Config{Version: 1, Mode: "auto"})
+	if startErr == nil || policy != nil || resource != nil {
+		t.Fatal("cancelled startup produced policy or typed-nil resource")
+	}
+	if _, _, err = NewBoundedAutoProvider(identity.Parent, [32]byte{}); err == nil {
+		t.Fatal("missing image pin accepted")
+	}
+}
diff --git a/rdd/pkg/networkproxy/config.go b/rdd/pkg/networkproxy/config.go
new file mode 100644
index 0000000..8a1fbd2
--- /dev/null
+++ b/rdd/pkg/networkproxy/config.go
@@ -0,0 +1,219 @@
+// Package networkproxy provides policy/transport to the existing host-switch. It owns no
+// engine lifecycle, global settings, native authentication or guest mutation.
+package networkproxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const ConfigBudget = 16 << 10
+
+type Config struct {
+	Version int      `json:"version"`
+	Mode    string   `json:"mode"`
+	URL     string   `json:"url"`
+	NoProxy []string `json:"noProxy"`
+}
+
+// String deliberately omits upstream addresses and corporate bypass metadata.
+func (config Config) String() string { return "engine proxy configuration (private values omitted)" }
+
+func safeASCII(value string, budget int) bool {
+	return len(value) <= budget && !strings.ContainsFunc(value, func(r rune) bool { return r > 127 || unicode.IsSpace(r) || unicode.IsControl(r) })
+}
+func domain(host string) bool {
+	if !safeASCII(host, 253) || host != strings.ToLower(host) {
+		return false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, c := range label {
+			if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+func validPort(port string) bool {
+	value, err := strconv.ParseUint(port, 10, 16)
+	return err == nil && value != 0 && strconv.FormatUint(value, 10) == port
+}
+
+// Credential-bearing URLs are explicitly unsupported. A future vault-backed
+// provider must bind credentials to an exact reviewed proxy endpoint; dropping
+// userinfo or copying it to the guest is never an acceptable adaptation.
+func proxyURL(raw string) (*url.URL, error) {
+	value, err := url.Parse(raw)
+	if err != nil || !safeASCII(raw, 2048) || value == nil || (value.Scheme != "http" && value.Scheme != "https") || value.Opaque != "" || value.User != nil || value.RawQuery != "" || value.Fragment != "" || value.RawFragment != "" || value.RawPath != "" || (value.Path != "" && value.Path != "/") {
+		return nil, errors.New("proxy requires an explicit HTTP(S) endpoint without credentials, query, fragment or path")
+	}
+	host := value.Hostname()
+	if ip, err := netip.ParseAddr(host); err == nil {
+		if ip.Zone() != "" || ip.Is4In6() || ip.IsUnspecified() || ip.IsMulticast() || ip.String() != host {
+			return nil, errors.New("unsupported proxy IP spelling")
+		}
+	} else if !domain(host) {
+		return nil, errors.New("proxy host must be canonical ASCII DNS or IP")
+	}
+	if value.Port() != "" && !validPort(value.Port()) || strings.HasSuffix(value.Host, ":") {
+		return nil, errors.New("proxy port must be canonical and nonzero")
+	}
+	canonicalHost := host
+	if strings.Contains(host, ":") {
+		canonicalHost = "[" + host + "]"
+	}
+	if value.Port() != "" {
+		canonicalHost = net.JoinHostPort(host, value.Port())
+	}
+	if value.Host != canonicalHost {
+		return nil, errors.New("unsupported proxy host spelling")
+	}
+	return value, nil
+}
+func bypass(raw string) bool {
+	if raw == "*" {
+		return true
+	}
+	if !safeASCII(raw, 512) {
+		return false
+	}
+	if prefix, err := netip.ParsePrefix(raw); err == nil {
+		return !prefix.Addr().Is4In6() && prefix.Masked() == prefix && prefix.String() == raw
+	}
+	host := raw
+	if _, err := netip.ParseAddr(raw); err != nil && strings.Contains(raw, ":") {
+		var port string
+		host, port, err = net.SplitHostPort(raw)
+		if err != nil || !validPort(port) {
+			return false
+		}
+	}
+	if ip, err := netip.ParseAddr(host); err == nil {
+		return !ip.Is4In6() && ip.Zone() == "" && ip.String() == host
+	}
+	if strings.HasPrefix(host, "*.") {
+		host = host[2:]
+	} else {
+		host = strings.TrimPrefix(host, ".")
+	}
+	return domain(host)
+}
+func (config Config) Validate() error {
+	if config.Version != 1 || (config.Mode != "none" && config.Mode != "url" && config.Mode != "auto") || len(config.NoProxy) > 128 {
+		return errors.New("unsupported bounded engine proxy configuration")
+	}
+	if config.Mode == "url" {
+		if _, err := proxyURL(config.URL); err != nil {
+			return err
+		}
+	} else if config.URL != "" {
+		return errors.New("only URL mode accepts an explicit proxy endpoint")
+	}
+	seen := map[string]bool{}
+	for _, entry := range config.NoProxy {
+		if !bypass(entry) || seen[entry] {
+			return errors.New("proxy bypass entries must be distinct canonical IP/CIDR/domain or port-scoped entries")
+		}
+		seen[entry] = true
+	}
+	data, _ := json.Marshal(config)
+	if len(data) > ConfigBudget {
+		return errors.New("engine proxy configuration exceeds byte budget")
+	}
+	return nil
+}
+
+// ParseConfig rejects duplicate, unknown and missing fields before validation.
+// Values and parser diagnostics never appear in returned errors.
+func ParseConfig(raw []byte) (Config, error) {
+	bad := errors.New("malformed bounded engine proxy configuration")
+	if len(raw) == 0 || len(raw) > ConfigBudget || !utf8.Valid(raw) {
+		return Config{}, bad
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	first, err := dec.Token()
+	if err != nil || first != json.Delim('{') {
+		return Config{}, bad
+	}
+	seen := map[string]bool{}
+	for dec.More() {
+		token, err := dec.Token()
+		if err != nil {
+			return Config{}, bad
+		}
+		key, ok := token.(string)
+		if !ok || seen[key] || (key != "version" && key != "mode" && key != "url" && key != "noProxy") {
+			return Config{}, bad
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if dec.Decode(&value) != nil {
+			return Config{}, bad
+		}
+		if bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return Config{}, bad
+		}
+	}
+	if _, err := dec.Token(); err != nil || len(seen) != 4 {
+		return Config{}, bad
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return Config{}, bad
+	}
+	var result Config
+	if json.Unmarshal(raw, &result) != nil {
+		return Config{}, bad
+	}
+	if err := result.Validate(); err != nil {
+		return Config{}, err
+	}
+	result.NoProxy = append([]string{}, result.NoProxy...)
+	return result, nil
+}
+
+// AutoResolver is the future Windows owner-context WinHTTP bridge. Each call
+// receives the actual destination, not one startup snapshot. Native integration
+// must disable PAC default-credential auto-logon, bound callbacks/allocation,
+// preserve ordered proxy/DIRECT choices and expose no global setting mutation.
+// A missing provider refuses auto; this candidate never claims native support.
+type AutoResolver interface {
+	Resolve(context.Context, *url.URL) ([]Route, error)
+}
+type Route struct {
+	Direct bool
+	Proxy  string
+}
+
+func (route Route) String() string { return "private engine proxy route" }
+
+func validateTarget(target *url.URL) error {
+	if target == nil || (target.Scheme != "http" && target.Scheme != "https") || target.Hostname() == "" || target.User != nil || target.Opaque != "" || target.Fragment != "" || !safeASCII(target.Host, 1024) || target.Port() != "" && !validPort(target.Port()) {
+		return errors.New("HTTP(S) destination without embedded credentials required")
+	}
+	host := target.Hostname()
+	if ip, err := netip.ParseAddr(host); err == nil {
+		if ip.Zone() != "" || ip.IsUnspecified() || ip.IsMulticast() {
+			return errors.New("unsupported destination address")
+		}
+	} else if !domain(strings.TrimSuffix(strings.ToLower(host), ".")) {
+		return errors.New("invalid destination host")
+	}
+	if strings.HasSuffix(target.Host, ":") {
+		return errors.New("empty destination port refused")
+	}
+	return nil
+}
diff --git a/rdd/pkg/networkproxy/config_test.go b/rdd/pkg/networkproxy/config_test.go
new file mode 100644
index 0000000..f2e4f78
--- /dev/null
+++ b/rdd/pkg/networkproxy/config_test.go
@@ -0,0 +1,150 @@
+package networkproxy
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+type autoFunc func(context.Context, *url.URL) ([]Route, error)
+
+func (fn autoFunc) Resolve(ctx context.Context, target *url.URL) ([]Route, error) {
+	return fn(ctx, target)
+}
+func configFixture() Config {
+	return Config{Version: 1, Mode: "url", URL: "http://proxy.example:3128", NoProxy: []string{".internal.example", "10.0.0.0/8", "[::1]:8080", "specific.example:443"}}
+}
+func target(raw string) *url.URL { value, _ := url.Parse(raw); return value }
+
+func TestStrictConfigCredentialsAndBypassSemantics(t *testing.T) {
+	config := configFixture()
+	raw, _ := json.Marshal(config)
+	if _, err := ParseConfig(raw); err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range []string{`{"version":1,"mode":"none","url":"","noProxy":[],"mode":"url"}`, `{"Version":1,"mode":"none","url":"","noProxy":[]}`, `{"version":1,"mode":"none","url":""}`, string(raw) + `{}`, strings.Repeat(" ", ConfigBudget+1)} {
+		if _, err := ParseConfig([]byte(bad)); err == nil {
+			t.Fatal("invalid JSON accepted")
+		}
+	}
+	for _, endpoint := range []string{"http://user:secret@proxy.example:3128", "socks5://proxy.example:3128", "http://proxy.example/path", "http://proxy.example:0", "http://proxy.example:080", "http://proxy.example:", "http://Proxy.Example:3128", "http://proxy.example/?secret=yes", "http://[fe80::1%25private]:3128"} {
+		config.URL = endpoint
+		if err := config.Validate(); err == nil || strings.Contains(err.Error(), "secret") {
+			t.Fatal("invalid or credential-bearing endpoint accepted/leaked")
+		}
+	}
+	for _, entry := range []string{"10.1.2.3/8", ".Bad.Example", "internal.example:0", "*.example.*", " <local>", "a,,b"} {
+		config = configFixture()
+		config.NoProxy = []string{entry}
+		if config.Validate() == nil {
+			t.Fatalf("bad bypass accepted: %q", entry)
+		}
+	}
+	config = configFixture()
+	policy, err := New(config, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		url    string
+		direct bool
+	}{{"https://child.internal.example/", true}, {"https://internal.example/", false}, {"https://10.1.2.3/", true}, {"https://specific.example:443/", true}, {"http://specific.example:80/", false}, {"http://localhost/", true}, {"https://public.example/", false}} {
+		routes, err := policy.Decide(context.Background(), target(test.url))
+		if err != nil || routes[0].Direct != test.direct {
+			t.Fatalf("bypass %s: %+v %v", test.url, routes, err)
+		}
+	}
+}
+
+func TestAutoPerDestinationNoCredentialOrFailureDowngrade(t *testing.T) {
+	config := Config{Version: 1, Mode: "auto", NoProxy: []string{}}
+	if _, err := New(config, nil); err == nil {
+		t.Fatal("missing native resolver pretended auto works")
+	}
+	var observed []string
+	policy, err := New(config, autoFunc(func(_ context.Context, u *url.URL) ([]Route, error) {
+		observed = append(observed, u.Hostname())
+		if u.Hostname() == "direct.example" {
+			return []Route{{Direct: true}}, nil
+		}
+		return []Route{{Proxy: "http://proxy.example:3128"}}, nil
+	}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, host := range []string{"one.example", "direct.example"} {
+		routes, err := policy.Decide(context.Background(), target("https://"+host+"/"))
+		if err != nil || routes[0].Direct != (host == "direct.example") {
+			t.Fatal(routes, err)
+		}
+	}
+	if strings.Join(observed, ",") != "one.example,direct.example" {
+		t.Fatal("auto reused startup snapshot")
+	}
+	for _, provider := range []AutoResolver{
+		autoFunc(func(context.Context, *url.URL) ([]Route, error) {
+			return nil, errors.New("http://user:secret@private-proxy")
+		}),
+		autoFunc(func(context.Context, *url.URL) ([]Route, error) {
+			return []Route{{Proxy: "http://user:secret@proxy.example"}}, nil
+		}),
+		autoFunc(func(context.Context, *url.URL) ([]Route, error) {
+			return []Route{{Direct: true, Proxy: "http://proxy.example"}}, nil
+		}),
+		autoFunc(func(context.Context, *url.URL) ([]Route, error) { return []Route{{Direct: true}, {Direct: true}}, nil }),
+		autoFunc(func(context.Context, *url.URL) ([]Route, error) { return make([]Route, 9), nil }),
+	} {
+		policy, _ := New(config, provider)
+		routes, err := policy.Decide(context.Background(), target("https://public.example/"))
+		if err == nil || len(routes) != 0 || strings.Contains(err.Error(), "secret") {
+			t.Fatal("failed auto downgraded or leaked private error")
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := policy.Decide(ctx, target("https://public.example/")); err == nil {
+		t.Fatal("cancellation ignored")
+	}
+}
+
+func TestNoneDoesNotInheritGlobalProxyEnvironment(t *testing.T) {
+	t.Setenv("HTTP_PROXY", "http://foreign.example:1234")
+	t.Setenv("HTTPS_PROXY", "http://foreign.example:1234")
+	t.Setenv("NO_PROXY", "*")
+	policy, err := New(Config{Version: 1, Mode: "none"}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	routes, err := policy.Decide(context.Background(), target("https://public.example/"))
+	if err != nil || len(routes) != 1 || !routes[0].Direct {
+		t.Fatal(routes, err)
+	}
+	config := configFixture()
+	config.NoProxy = nil
+	policy, _ = New(config, nil)
+	routes, err = policy.Decide(context.Background(), target("https://public.example/"))
+	if err != nil || routes[0].Direct || routes[0].Proxy != config.URL {
+		t.Fatal("global NO_PROXY changed explicit policy")
+	}
+}
+
+func TestMalformedDestinationCannotReachProviderOrConnect(t *testing.T) {
+	calls := 0
+	policy, _ := New(Config{Version: 1, Mode: "auto"}, autoFunc(func(context.Context, *url.URL) ([]Route, error) { calls++; return []Route{{Direct: true}}, nil }))
+	for _, destination := range []*url.URL{{Scheme: "https", Host: "bad/host:443"}, {Scheme: "https", Host: "private.example:"}, {Scheme: "https", Host: "[fe80::1%private]:443"}, {Scheme: "ftp", Host: "public.example"}, {Scheme: "https", Host: "public.example", User: url.UserPassword("user", "secret")}} {
+		if _, err := policy.Decide(context.Background(), destination); err == nil {
+			t.Fatal("malformed destination reached automatic provider")
+		}
+	}
+	if calls != 0 {
+		t.Fatal("malformed target was observed by provider")
+	}
+	for _, raw := range []string{`{"version":1,"mode":"none","url":null,"noProxy":[]}`, `{"version":1,"mode":"none","url":"","noProxy":null}`} {
+		if _, err := ParseConfig([]byte(raw)); err == nil {
+			t.Fatal("null required field accepted")
+		}
+	}
+}
diff --git a/rdd/pkg/networkproxy/consumer.go b/rdd/pkg/networkproxy/consumer.go
new file mode 100644
index 0000000..46ed72e
--- /dev/null
+++ b/rdd/pkg/networkproxy/consumer.go
@@ -0,0 +1,481 @@
+package networkproxy
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+const EngineProxyPort = "3129" // matches original fixed GuestProxyEndpoint; private vn gateway only
+
+type ManagementPolicySource interface {
+	ReadApp(context.Context) (*app.App, error)
+	WatchApp(context.Context, string) (watch.Interface, error)
+	WriteHostObservation(context.Context, *app.App, *app.NetworkProxyHostStatus, app.NetworkProxyBinding) error
+}
+
+// Only the sole Run goroutine calls this seam after all previous requests and
+// the previous watch Stop/decoder have positively retired. No status write is
+// replayed across credential replacement.
+type managementCredentialRefresher interface{ RefreshCredentials(context.Context) error }
+
+func (c *PolicyConsumer) refreshCredentials(ctx context.Context) error {
+	if ctx.Err() != nil {
+		return nil
+	}
+	refresh, ok := c.source.(managementCredentialRefresher)
+	if !ok {
+		c.suspend()
+		return nil
+	}
+	probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	err := refresh.RefreshCredentials(probe)
+	if errors.Is(err, ErrProxyRetirement) {
+		return ErrProxyRetirement
+	}
+	if errors.Is(err, ErrProxyOwner) {
+		c.suspend()
+	}
+	return nil
+}
+
+// PolicyConsumer is a single authenticated observer of App-owned permission.
+// It has no desired writer, guest writer, engine callback, retry queue, setting
+// capture or listener binder. Only the existing vn.RunOnce passes its listener.
+type PolicyConsumer struct {
+	source          ManagementPolicySource
+	owner           GenerationOwner
+	observe         OwnerObserver
+	supervisor      *PolicyGenerationSupervisor
+	running         atomic.Bool
+	ready           atomic.Bool
+	endpointEpoch   atomic.Uint64
+	endpoint        sync.Mutex
+	endpointChanged chan struct{}
+	// Following fields belong exclusively to Run/apply's serial goroutine.
+	lastGeneration, lastRevision int64
+	seenRevision                 int64
+	seenDigest                   string
+	lastAttemptRV                string
+	failedPlan                   *app.NetworkProxyPlan
+	failedEpoch                  uint64
+	failedReason                 string
+	prepareAuto                  PolicyPreparation
+}
+
+// PolicyPreparation checks whether the injected generation provider can accept
+// this configuration, using bounded read-only admission without starting a child, capturing owner configuration,
+// evaluating PAC or binding a listener. Commit alone starts the real provider.
+type PolicyPreparation func(context.Context, Config) error
+
+// StaticPolicyFactory does no ambient configuration capture. Auto intentionally
+// refuses until an explicit externally process-bounded provider is integrated;
+// the in-process native WinHTTP implementation is never used here.
+func StaticPolicyFactory(_ context.Context, _ context.Context, config Config) (*Policy, GenerationResource, error) {
+	policy, err := New(config, nil)
+	return policy, nil, err
+}
+
+func NewPolicyConsumer(parent context.Context, source ManagementPolicySource, owner GenerationOwner, observe OwnerObserver, factory GenerationFactory) (*PolicyConsumer, error) {
+	return newPolicyConsumer(parent, source, owner, observe, factory, nil)
+}
+
+// Auto preparation requires an explicit provider-admission check as well as a
+// generation factory. A nonnil factory alone must not imply Auto availability.
+func NewPolicyConsumerWithPreparation(parent context.Context, source ManagementPolicySource, owner GenerationOwner, observe OwnerObserver, factory GenerationFactory, prepare PolicyPreparation) (*PolicyConsumer, error) {
+	if factory == nil || prepare == nil {
+		return nil, ErrManagement
+	}
+	return newPolicyConsumer(parent, source, owner, observe, factory, prepare)
+}
+
+func newPolicyConsumer(parent context.Context, source ManagementPolicySource, owner GenerationOwner, observe OwnerObserver, factory GenerationFactory, prepare PolicyPreparation) (*PolicyConsumer, error) {
+	if source == nil {
+		return nil, ErrManagement
+	}
+	if factory == nil {
+		factory = StaticPolicyFactory
+	}
+	supervisor, err := NewPolicyGenerationSupervisor(parent, owner, observe, factory)
+	if err != nil {
+		return nil, err
+	}
+	return &PolicyConsumer{source: source, owner: owner, observe: observe, supervisor: supervisor, prepareAuto: prepare, endpointChanged: make(chan struct{}, 1)}, nil
+}
+
+func (c *PolicyConsumer) Snapshot() GenerationSnapshot    { return c.supervisor.Snapshot() }
+func (c *PolicyConsumer) Close(ctx context.Context) error { return c.supervisor.Close(ctx) }
+func (*PolicyConsumer) String() string                    { return "private authenticated proxy consumer" }
+func (*PolicyConsumer) GoString() string                  { return "private authenticated proxy consumer" }
+
+func (c *PolicyConsumer) endpointState(ready bool) {
+	if !ready {
+		c.endpointEpoch.Add(1)
+	}
+	c.ready.Store(ready)
+	select {
+	case c.endpointChanged <- struct{}{}:
+	default:
+	}
+}
+
+// Serve owns only the supplied private listener/streams. A listener error never
+// becomes an upstream networking error. Only one RunOnce endpoint may exist.
+func (c *PolicyConsumer) Serve(ctx context.Context, listener net.Listener, peer netip.Addr, duplex Duplex) error {
+	if !c.endpoint.TryLock() {
+		if listener != nil {
+			listener.Close()
+		}
+		return ErrProxyBusy
+	}
+	defer c.endpoint.Unlock()
+	if ctx == nil || listener == nil || duplex == nil || !peer.IsValid() || peer.IsUnspecified() || peer.IsMulticast() || peer.Zone() != "" {
+		if listener != nil {
+			listener.Close()
+		}
+		return ErrManagement
+	}
+	c.endpointState(true)
+	defer c.endpointState(false)
+	return ServeGenerationForwardProxy(ctx, listener, peer, c.supervisor, duplex)
+}
+
+// Run owns exactly one GET->resourceVersion watch chain. Rejoin reads through
+// the same authenticated client, after a bounded one-second backoff, without a
+// second poller. Disconnect alone never revokes a committed immutable policy.
+func (c *PolicyConsumer) Run(ctx context.Context) error {
+	if ctx == nil || !c.running.CompareAndSwap(false, true) {
+		return ErrProxyBusy
+	}
+	for ctx.Err() == nil {
+		owner, err := c.source.ReadApp(ctx)
+		if err != nil {
+			if errors.Is(err, ErrManagementCredentials) {
+				if refreshErr := c.refreshCredentials(ctx); refreshErr != nil {
+					return refreshErr
+				}
+			}
+			if errors.Is(err, ErrProxyOwner) {
+				c.suspend()
+			}
+			if !consumerBackoff(ctx) {
+				break
+			}
+			continue
+		}
+		if err = c.apply(ctx, owner); errors.Is(err, ErrProxyClosed) || errors.Is(err, ErrProxyRetirement) {
+			return err
+		}
+		if owner == nil || owner.ResourceVersion == "" || !safeASCII(owner.ResourceVersion, 128) {
+			if !consumerBackoff(ctx) {
+				break
+			}
+			continue
+		}
+		stream, err := c.source.WatchApp(ctx, owner.ResourceVersion)
+		if err != nil {
+			if errors.Is(err, ErrManagementCredentials) {
+				if refreshErr := c.refreshCredentials(ctx); refreshErr != nil {
+					return refreshErr
+				}
+			}
+			if errors.Is(err, ErrProxyOwner) {
+				c.suspend()
+			}
+			if !consumerBackoff(ctx) {
+				break
+			}
+			continue
+		}
+		if stream == nil {
+			c.suspend()
+			return ErrProxyRetirement
+		}
+		watching := true
+		refreshNeeded := false
+		for watching && ctx.Err() == nil {
+			select {
+			case <-ctx.Done():
+				watching = false
+			case <-c.endpointChanged:
+				if err = c.apply(ctx, owner); errors.Is(err, ErrProxyClosed) || errors.Is(err, ErrProxyRetirement) {
+					if !stopConsumerWatch(stream) {
+						c.suspend()
+						return ErrProxyRetirement
+					}
+					return err
+				}
+			case event, ok := <-stream.ResultChan():
+				if !ok {
+					watching = false
+					break
+				}
+				switch event.Type {
+				case watch.Added, watch.Modified:
+					current, ok := event.Object.(*app.App)
+					if !ok {
+						c.suspend()
+						watching = false
+						break
+					}
+					owner = current.DeepCopy()
+					if err = c.apply(ctx, owner); errors.Is(err, ErrProxyClosed) || errors.Is(err, ErrProxyRetirement) {
+						if !stopConsumerWatch(stream) {
+							c.suspend()
+							return ErrProxyRetirement
+						}
+						return err
+					}
+				case watch.Deleted:
+					c.suspend()
+					if !stopConsumerWatch(stream) {
+						return ErrProxyRetirement
+					}
+					return ErrProxyOwner
+				case watch.Bookmark:
+				case watch.Error:
+					failure := apierrors.FromObject(event.Object)
+					refreshNeeded = apierrors.IsUnauthorized(failure)
+					if apierrors.IsForbidden(failure) || apierrors.IsNotFound(failure) {
+						c.suspend()
+					}
+					watching = false
+				default:
+					c.suspend()
+					watching = false
+				}
+			}
+		}
+		if !stopConsumerWatch(stream) {
+			c.suspend()
+			return ErrProxyRetirement
+		}
+		if refreshNeeded && ctx.Err() == nil {
+			if refreshErr := c.refreshCredentials(ctx); refreshErr != nil {
+				return refreshErr
+			}
+		}
+		if ctx.Err() == nil && !consumerBackoff(ctx) {
+			break
+		}
+	}
+	return nil
+}
+
+// Stop's decoder goroutine is joined through ResultChan closure before another
+// watch starts. Unknown retirement refuses a replacement watch rather than
+// accumulating detached decoders. No native WinHTTP worker is involved.
+func stopConsumerWatch(stream watch.Interface) bool {
+	if stream == nil {
+		return false
+	}
+	timer := time.NewTimer(2 * time.Second)
+	defer timer.Stop()
+	stopped := make(chan struct{})
+	go func() { stream.Stop(); close(stopped) }()
+	results := stream.ResultChan()
+	stopDone, resultDone := false, false
+	for events := 0; ; {
+		if stopDone && resultDone {
+			return true
+		}
+		select {
+		case <-stopped:
+			stopDone = true
+			stopped = nil
+		case _, ok := <-results:
+			if !ok {
+				resultDone = true
+				results = nil
+			} else {
+				events++
+				if events > 256 {
+					return false
+				}
+			}
+		case <-timer.C:
+			return false
+		}
+	}
+}
+
+func consumerBackoff(ctx context.Context) bool {
+	timer := time.NewTimer(time.Second)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
+func (c *PolicyConsumer) suspend() {
+	cleanup, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	_ = c.supervisor.Suspend(cleanup)
+}
+
+func (c *PolicyConsumer) checkOwner(owner *app.App) bool {
+	return owner != nil && string(owner.UID) == c.owner.AppUID && owner.Name == "app" && owner.Namespace == "" && owner.DeletionTimestamp == nil && owner.Generation >= 1 && owner.Generation >= c.lastGeneration && owner.ResourceVersion != "" && safeASCII(owner.ResourceVersion, 128)
+}
+
+func (c *PolicyConsumer) apply(ctx context.Context, owner *app.App) error {
+	if !c.checkOwner(owner) {
+		c.suspend()
+		return ErrProxyOwner
+	}
+	c.lastGeneration = owner.Generation
+	observed, err := c.observe(ctx)
+	if err != nil || observed != c.owner {
+		c.suspend()
+		return ErrProxyOwner
+	}
+	state := owner.Status.NetworkProxy
+	if state == nil || state.Plan == nil {
+		if owner.Spec.NetworkProxy == nil && state == nil && c.lastRevision == 0 {
+			return nil
+		}
+		c.suspend()
+		return ErrProxyOwner
+	}
+	plan := *state.Plan
+	if GuardProxyPlan(owner, &plan, observed.Binding) != nil || plan.ProxyRevision < c.seenRevision || plan.ProxyRevision == c.seenRevision && c.seenDigest != "" && plan.ConfigDigest != c.seenDigest {
+		c.suspend()
+		return ErrProxyOwner
+	}
+	c.seenRevision = plan.ProxyRevision
+	c.seenDigest = plan.ConfigDigest
+	var config Config
+	if owner.Spec.NetworkProxy != nil {
+		config, err = desiredConfig(owner.Spec.NetworkProxy)
+	} else {
+		err = ErrProxyOwner
+	}
+	if err != nil {
+		c.suspend()
+		return ErrProxyOwner
+	}
+	if !c.ready.Load() {
+		c.suspend()
+		c.ack(ctx, owner, plan, "degraded", "Unavailable")
+		return nil
+	}
+	if plan.Phase == "prepare" {
+		// Prepared means syntax + owned private endpoint ready; no network probe
+		// or guest transaction is fabricated. Auto requires its process adapter.
+		if err := config.Validate(); err != nil {
+			c.ack(ctx, owner, plan, "degraded", "Unavailable")
+			return nil
+		}
+		if config.Mode == "auto" {
+			if c.prepareAuto == nil {
+				c.ack(ctx, owner, plan, "degraded", "Unavailable")
+				return nil
+			}
+			probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+			err := c.prepareAuto(probe, config)
+			if errors.Is(err, ErrProxyRetirement) {
+				cancel()
+				c.ack(ctx, owner, plan, "degraded", "RetirementUnknown")
+				return ErrProxyRetirement
+			}
+			expired := probe.Err() != nil
+			cancel()
+			if err != nil || expired || ctx.Err() != nil {
+				c.ack(ctx, owner, plan, "degraded", "Unavailable")
+				return nil
+			}
+		}
+		if ctx.Err() != nil {
+			c.ack(ctx, owner, plan, "degraded", "Unavailable")
+			return nil
+		}
+		c.ack(ctx, owner, plan, "prepared", "Ready")
+		return nil
+	}
+	permissionOwner := owner
+	if c.failedPlan != nil && sameConsumerPermission(*c.failedPlan, plan) && c.failedEpoch == c.endpointEpoch.Load() {
+		c.ack(ctx, owner, plan, "degraded", c.failedReason)
+		return nil
+	}
+	result, err := c.supervisor.ReplaceGuarded(ctx, plan, config, func(probe context.Context) error {
+		current, e := c.source.ReadApp(probe)
+		if e != nil {
+			if errors.Is(e, ErrProxyOwner) {
+				return ErrProxyOwner
+			}
+			return ErrManagement
+		}
+		if !c.ready.Load() || !c.checkOwner(current) || GuardProxyPlan(current, &plan, observed.Binding) != nil {
+			return ErrProxyOwner
+		}
+		c.lastGeneration = current.Generation
+		permissionOwner = current
+		return nil
+	})
+	if result.Committed {
+		c.failedPlan = nil
+		c.lastRevision = plan.ProxyRevision
+		phase := "active"
+		if config.Mode == "none" {
+			phase = "direct"
+		}
+		if err != nil {
+			c.ack(ctx, permissionOwner, plan, "degraded", "RetirementUnknown")
+		} else {
+			c.ack(ctx, permissionOwner, plan, phase, "Ready")
+		}
+		return nil
+	}
+	if errors.Is(err, ErrProxyOwner) || errors.Is(err, ErrProxyClosed) || errors.Is(err, ErrProxyRetirement) {
+		c.suspend()
+	}
+	reason := "Unavailable"
+	if errors.Is(err, ErrProxyBudget) {
+		reason = "BudgetExhausted"
+	}
+	if errors.Is(err, ErrProxyRetirement) {
+		reason = "RetirementUnknown"
+	}
+	if errors.Is(err, ErrProxyStartup) || errors.Is(err, ErrProxyBudget) || errors.Is(err, ErrProxyRetirement) {
+		copyPlan := plan
+		c.failedPlan = &copyPlan
+		c.failedEpoch = c.endpointEpoch.Load()
+		c.failedReason = reason
+	}
+	c.ack(ctx, owner, plan, "degraded", reason)
+	return err
+}
+
+func sameConsumerPermission(a, b app.NetworkProxyPlan) bool {
+	return a.AppUID == b.AppUID && a.Binding == b.Binding && a.ProxyRevision == b.ProxyRevision && a.ConfigDigest == b.ConfigDigest && a.Phase == b.Phase
+}
+
+func (c *PolicyConsumer) ack(ctx context.Context, owner *app.App, plan app.NetworkProxyPlan, phase, reason string) {
+	snapshot := c.supervisor.Snapshot()
+	host := &app.NetworkProxyHostStatus{Plan: plan, Phase: phase, Reason: reason}
+	if snapshot.Unknown == 0 && snapshot.Draining <= MaxDrainingGenerations {
+		streams, draining := int32(snapshot.Streams), int32(snapshot.Draining)
+		host.ActiveStreams = &streams
+		host.DrainingGenerations = &draining
+	}
+	if GuardHostObservation(owner, host, c.owner.Binding) != nil || reflect.DeepEqual(owner.Status.NetworkProxyHost, host) || c.lastAttemptRV == owner.ResourceVersion {
+		return
+	}
+	c.lastAttemptRV = owner.ResourceVersion
+	// One attempt for this exact API resourceVersion. Conflict or ambiguous
+	// acknowledgement is not replayed; only a new authenticated event may act.
+	probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	_ = c.source.WriteHostObservation(probe, owner, host, c.owner.Binding)
+}
