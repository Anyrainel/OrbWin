+func privateServer(t *testing.T, p *PrivateTransport) *tls.Config {
+	t.Helper()
+	c, e := p.ServerTLSConfig()
+	if e != nil {
+		t.Fatal(e)
+	}
+	return c
+}
+func privateClient(t *testing.T, p *PrivateTransport) *tls.Config {
+	t.Helper()
+	c, e := p.ClientTLSConfig()
+	if e != nil {
+		t.Fatal(e)
