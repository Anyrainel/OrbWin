@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin isolated schema candidate. No runtime consumer is registered.
+
+package v1alpha1
+
+// NetworkProxySpec contains private values. Do not include it in diagnostic logs
+// or support exports. Credential-bearing URLs are unsupported, not stripped.
+type NetworkProxySpec struct {
+	// +kubebuilder:validation:Enum=1
+	Version int `json:"version"`
+	// +kubebuilder:validation:Enum=none;url;auto
+	Mode string `json:"mode"`
+	// +kubebuilder:validation:MaxLength=2048
+	URL string `json:"url"`
+	// +kubebuilder:validation:MaxItems=128
+	// +kubebuilder:validation:items:MaxLength=512
+	// +listType=set
+	NoProxy []string `json:"noProxy"`
+}
+
+func (NetworkProxySpec) String() string { return "private engine proxy intent" }
+
+// NetworkProxyBinding is checked against trusted native observations, not a
+// renderer-selected identity. PID alone is never sufficient.
+type NetworkProxyBinding struct {
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=128
+	LimaVMUID string `json:"limaVMUID"`
+	// +kubebuilder:validation:Minimum=1
+	// +kubebuilder:validation:Maximum=4294967295
+	HostPID int64 `json:"hostPID"`
+	// +kubebuilder:validation:Pattern=`^[0-9a-f]{16}$`
+	HostCreationTime string `json:"hostCreationTime"`
+	// +kubebuilder:validation:Pattern=`^[0-9a-f]{32}$`
+	TransportEpoch string `json:"transportEpoch"`
+}
+
+// NetworkProxyPlan is derived controller permission, bound to current intent.
+// It is not a second desired-state source or proof that any side effect happened.
+type NetworkProxyPlan struct {
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=128
+	AppUID string `json:"appUID"`
+	// +kubebuilder:validation:Minimum=1
+	ObservedGeneration int64 `json:"observedGeneration"`
+	// +kubebuilder:validation:Minimum=1
+	ProxyRevision int64 `json:"proxyRevision"`
+	// +kubebuilder:validation:Pattern=`^[0-9a-f]{64}$`
+	ConfigDigest string              `json:"configDigest"`
+	Binding      NetworkProxyBinding `json:"binding"`
+	// +kubebuilder:validation:Enum=prepare;commit;disable
+	Phase string `json:"phase"`
+}
+
+// NetworkProxyControllerStatus has one writer: AppReconciler. No runtime writer
+// is installed in this schema candidate. Digests also remain private metadata.
+type NetworkProxyControllerStatus struct {
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=128
+	AppUID string `json:"appUID"`
+	// +kubebuilder:validation:Minimum=1
+	ObservedGeneration int64 `json:"observedGeneration"`
+	// +kubebuilder:validation:Minimum=1
+	ProxyRevision int64 `json:"proxyRevision"`
+	// +kubebuilder:validation:Pattern=`^[0-9a-f]{64}$`
+	ConfigDigest string `json:"configDigest"`
+	// +kubebuilder:validation:Enum=none;url;auto
+	Mode        string `json:"mode"`
+	ManagedEver bool   `json:"managedEver"`
+	// guestAppliedRevision is only advanced by an authenticated identity-bound
+	// guest transaction receipt. Host readiness cannot advance it.
+	// +kubebuilder:validation:Minimum=0
+	GuestAppliedRevision int64 `json:"guestAppliedRevision"`
+	// +optional
+	Plan *NetworkProxyPlan `json:"plan,omitempty"`
+}
+
+// NetworkProxyHostStatus has one writer: the headless consumer. Its direct phase
+// means new requests use DIRECT, not that its compatibility listener was removed
+// or that existing streams/environment were reconfigured.
+type NetworkProxyHostStatus struct {
+	Plan NetworkProxyPlan `json:"plan"`
+	// +kubebuilder:validation:Enum=prepared;active;direct;degraded
+	Phase string `json:"phase"`
+	// +kubebuilder:validation:Enum=Ready;Unavailable;RetirementUnknown;BudgetExhausted
+	Reason string `json:"reason"`
+	// +kubebuilder:validation:Minimum=0
+	// +kubebuilder:validation:Maximum=64
+	// +optional
+	ActiveStreams *int32 `json:"activeStreams,omitempty"`
+	// Draining generations exclude the active generation: eight total maximum.
+	// +kubebuilder:validation:Minimum=0
+	// +kubebuilder:validation:Maximum=7
+	// +optional
+	DrainingGenerations *int32 `json:"drainingGenerations,omitempty"`
+}
