+	// actual newly created child. This does not add a production bootstrap writer.
+	process, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, uint32(cmd.Process.Pid))
+	if err != nil {
+		gate.Close()
+		cmd.Wait()
+		t.Fatal("synthetic child identity")
+	}
+	var creation, exit, kernel, user windows.Filetime
+	err = windows.GetProcessTimes(process, &creation, &exit, &kernel, &user)
+	windows.CloseHandle(process)
+	if err != nil {
+		gate.Close()
+		cmd.Wait()
+		t.Fatal("synthetic child creation")
+	}
+	mutex.Lock()
+	current = consumerApp(t, "url", upstream.URL, 1, 3, "commit")
