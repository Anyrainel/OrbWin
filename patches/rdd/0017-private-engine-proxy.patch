@@ -0,0 +1,194 @@
+// Package proxyguestprotocol is the bounded credential-free wire contract shared
+// by the existing host and guest Go modules. It has no networking or process API.
+package proxyguestprotocol
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+)
+
+const MaxFrame = 8192
+const ConfigPath = "/etc/systemd/system/docker.service.d/90-orbwin-network-proxy.conf"
+const AnchorPath = "/var/lib/orbwin/network-proxy"
+const Endpoint = "http://gateway.docker.internal:3129"
+const Compatibility = "compatibility"
+const AbsentDirect = "absent-direct"
+const Unknown = "unknown"
+const Refused = "refused"
+
+var ErrInvalid = errors.New("invalid fixed guest transaction")
+var ErrUnavailable = errors.New("fixed guest transaction unavailable")
+var ErrPending = errors.New("fixed guest transaction observation pending")
+
+type Owner struct {
+	AppUID       string `json:"appUID"`
+	LimaUID      string `json:"limaUID"`
+	HostPID      uint32 `json:"hostPID"`
+	HostCreation string `json:"hostCreation"`
+	Epoch        string `json:"epoch"`
+	Revision     int64  `json:"revision"`
+	Digest       string `json:"digest"`
+	Phase        string `json:"phase"`
+}
+type Identity struct {
+	// RegistrationGUID is a HOST selection fence. The Linux helper does not
+	// independently authenticate a Windows registry identity by echoing it.
+	RegistrationGUID string `json:"registrationGUID"`
+	MachineID        string `json:"machineID"`
+	DaemonID         string `json:"daemonID"`
+}
+type Request struct {
+	Schema   int      `json:"schema"`
+	ID       string   `json:"id"`
+	Owner    Owner    `json:"owner"`
+	Identity Identity `json:"identity"`
+	Mode     string   `json:"mode"`
+}
+type Receipt struct {
+	Schema         int      `json:"schema"`
+	ID             string   `json:"id"`
+	Owner          Owner    `json:"owner"`
+	Identity       Identity `json:"identity"`
+	Mode           string   `json:"mode"`
+	Disposition    string   `json:"disposition"`
+	ConfigHash     string   `json:"configHash"`
+	RuntimeHash    string   `json:"runtimeHash"`
+	SettlementHash string   `json:"settlementHash"`
+}
+type IdentityObservation struct {
+	MachineID    string `json:"machineID"`
+	DaemonID     string `json:"daemonID"`
+	HelperSHA256 string `json:"helperSHA256"`
+}
+
+func (value IdentityObservation) Valid() bool {
+	return hexID(value.MachineID, 32) && value.MachineID != strings.Repeat("0", 32) && ascii(value.DaemonID, 128) && hexID(value.HelperSHA256, 64)
+}
+
+type Message struct {
+	Schema       int      `json:"schema"`
+	Operation    string   `json:"operation"`
+	Request      *Request `json:"request"`
+	HelperSHA256 string   `json:"helperSHA256"`
+}
+type MessageResult struct {
+	Schema   int                  `json:"schema"`
+	Reason   string               `json:"reason"`
+	Identity *IdentityObservation `json:"identity"`
+	Receipt  *Receipt             `json:"receipt"`
+}
+
+func Hash(data []byte) string { sum := sha256.Sum256(data); return hex.EncodeToString(sum[:]) }
+func hexID(value string, n int) bool {
+	if len(value) != n {
+		return false
+	}
+	for _, r := range value {
+		if !(r >= '0' && r <= '9' || r >= 'a' && r <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+func ascii(value string, n int) bool {
+	if len(value) < 1 || len(value) > n {
+		return false
+	}
+	for _, r := range value {
+		if r < 33 || r > 126 {
+			return false
+		}
+	}
+	return true
+}
+func ValidIdentity(value Identity) bool {
+	guid := value.RegistrationGUID
+	if len(guid) != 38 || guid[0] != '{' || guid[37] != '}' {
+		return false
+	}
+	compact := strings.ReplaceAll(guid[1:37], "-", "")
+	return guid[9] == '-' && guid[14] == '-' && guid[19] == '-' && guid[24] == '-' && hexID(compact, 32) && compact != strings.Repeat("0", 32) && hexID(value.MachineID, 32) && value.MachineID != strings.Repeat("0", 32) && ascii(value.DaemonID, 128)
+}
+func (value Request) Validate() error {
+	o := value.Owner
+	phase := o.Phase == "prepare" && (value.Mode == "url" || value.Mode == "auto") || o.Phase == "disable" && value.Mode == "none"
+	if value.Schema != 1 || !ascii(o.AppUID, 128) || !ascii(o.LimaUID, 128) || o.HostPID == 0 || !hexID(o.HostCreation, 16) || o.HostCreation == strings.Repeat("0", 16) || !hexID(o.Epoch, 32) || o.Epoch == strings.Repeat("0", 32) || o.Revision < 1 || !hexID(o.Digest, 64) || !phase || !ValidIdentity(value.Identity) || value.ID != value.TransactionID() {
+		return ErrInvalid
+	}
+	return nil
+}
+func (value Request) TransactionID() string {
+	value.ID = ""
+	encoded, _ := json.Marshal(value)
+	return Hash(encoded)
+}
+func (value Request) Receipt(disposition string) Receipt {
+	return Receipt{Schema: 1, ID: value.ID, Owner: value.Owner, Identity: value.Identity, Mode: value.Mode, Disposition: disposition}
+}
+
+// One canonical LF frame permits the caller to keep stdin open for cancellation
+// monitoring. It rejects duplicate/unknown keys, alternate numbers, trailing
+// fields and oversized frames. There is no arbitrary action/path field.
+func ReadFrame(reader *bufio.Reader, value any) error {
+	frame, err := reader.ReadSlice('\n')
+	if err != nil || len(frame) < 2 || len(frame) > MaxFrame {
+		return ErrInvalid
+	}
+	frame = frame[:len(frame)-1]
+	decoder := json.NewDecoder(bytes.NewReader(frame))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(value) != nil {
+		return ErrInvalid
+	}
+	canonical, err := json.Marshal(value)
+	if err != nil || !bytes.Equal(canonical, frame) {
+		return ErrInvalid
+	}
+	return nil
+}
+func WriteFrame(writer io.Writer, value any) error {
+	data, err := json.Marshal(value)
+	if err != nil || len(data)+1 > MaxFrame {
+		return ErrInvalid
+	}
+	data = append(data, '\n')
+	n, err := writer.Write(data)
+	if err != nil {
+		return err
+	}
+	if n != len(data) {
+		return io.ErrShortWrite
+	}
+	return nil
+}
+
+func CompatibilityBody() []byte {
+	return []byte("# OrbWin engine proxy v1; credential-free guest endpoint\n[Service]\nEnvironment=\"HTTP_PROXY=" + Endpoint + "\" \"http_proxy=" + Endpoint + "\"\nEnvironment=\"HTTPS_PROXY=" + Endpoint + "\" \"https_proxy=" + Endpoint + "\"\nEnvironment=\"NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,.orbwin.localhost,.orbwin.test\" \"no_proxy=localhost,127.0.0.1,::1,host.docker.internal,.orbwin.localhost,.orbwin.test\"\nEnvironment=\"ALL_PROXY=\" \"all_proxy=\"\n")
+}
+func CompatibilityHash() string { return Hash(CompatibilityBody()) }
+func DirectRuntimeHash() string { return Hash([]byte("orbwin-current-no-proxy-runtime-v1")) }
+
+func GuardReceipt(request Request, receipt Receipt) error {
+	if request.Validate() != nil || receipt.Schema != 1 || receipt.ID != request.ID || receipt.Owner != request.Owner || receipt.Identity != request.Identity || receipt.Mode != request.Mode || !hexID(receipt.SettlementHash, 64) {
+		return ErrInvalid
+	}
+	switch receipt.Disposition {
+	case Compatibility:
+		if receipt.ConfigHash != CompatibilityHash() || receipt.RuntimeHash != CompatibilityHash() {
+			return ErrInvalid
+		}
+	case AbsentDirect:
+		if request.Mode != "none" || receipt.ConfigHash != Hash(nil) || receipt.RuntimeHash != DirectRuntimeHash() {
+			return ErrInvalid
+		}
+	default:
+		return ErrUnavailable
+	}
+	return nil
+}
