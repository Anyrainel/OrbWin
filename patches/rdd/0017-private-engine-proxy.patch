+// Explicit redacted read-only classification of fresh fixture ancestors. No
+// account lookup (which might contact a domain), paths or raw SIDs are emitted.
+func TestManagementOwnedWindowsAncestorClassification(t *testing.T) {
+	_, file, sid := managementTemp(t)
+	root, parts, _ := managementComponents(file)
+	prefix := root
+	class := func(s string) string {
+		switch {
+		case s == sid:
+			return "current-user"
+		case s == "S-1-5-18":
+			return "SYSTEM"
+		case s == "S-1-5-32-544":
+			return "administrators"
+		case s == "S-1-3-0":
+			return "creator-owner-placeholder"
+		case s == "S-1-3-4":
+			return "owner-rights"
+		case s == "S-1-1-0":
+			return "everyone"
+		case s == "S-1-5-11":
+			return "authenticated-users"
+		case s == "S-1-5-4":
+			return "interactive"
+		case s == "S-1-15-2-1":
+			return "all-application-packages"
+		case s == "S-1-15-2-2":
+			return "all-restricted-application-packages"
+		case strings.HasPrefix(s, "S-1-5-5-"):
+			return "logon-session-unproven"
+		case strings.HasPrefix(s, "S-1-15-3-"):
+			return "application-capability"
+		case strings.HasPrefix(s, "S-1-5-80-"):
+			if s == "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464" {
+				return "TrustedInstaller-exact-documented-SID"
+			}
+			return "OS-service-account"
+		case strings.HasPrefix(s, "S-1-5-32-"):
+			return "builtin-group"
+		case strings.HasPrefix(s, "S-1-5-21-"):
+			return "account-unresolved-no-domain-lookup"
+		default:
+			return "other-well-known-or-unresolved"
+		}
+	}
+	for index := 0; index < len(parts)-1; index++ {
+		if index > 0 {
+			prefix = filepath.Join(prefix, parts[index-1])
+		}
+		p, _ := windows.UTF16PtrFromString(prefix)
+		h, e := windows.CreateFile(p, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+		if e != nil {
+			t.Fatal("ancestor observation open refused")
+		}
+		sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+		windows.CloseHandle(h)
+		if e != nil {
+			t.Fatal("ancestor security observation refused")
+		}
+		owner, _, e := sd.Owner()
+		if e != nil || owner == nil {
+			t.Fatal("ancestor owner unavailable")
+		}
+		t.Logf("component=%d ownerClass=%s", index, class(owner.String()))
+		acl, _, e := sd.DACL()
+		if e != nil || acl == nil || acl.AceCount > 256 {
+			t.Fatal("ancestor DACL unsupported")
+		}
+		for j := uint32(0); j < uint32(acl.AceCount); j++ {
+			var ace *windows.ACCESS_ALLOWED_ACE
+			if windows.GetAce(acl, j, &ace) != nil || ace == nil || ace.Header.AceSize < 16 {
+				t.Fatal("ancestor ACE unavailable")
+			}
+			if ace.Header.AceType != 0 && ace.Header.AceType != 1 {
+				t.Logf("component=%d unsupportedACE=%d", index, ace.Header.AceType)
+				continue
+			}
+			aSID := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+			if !aSID.IsValid() || aSID.Len() > int(ace.Header.AceSize)-8 {
+				t.Fatal("ancestor SID unsupported")
+			}
+			if !trustedManagementSID(aSID.String(), sid) {
+				t.Logf("component=%d principalClass=%s type=%d flags=%x mask=%x", index, class(aSID.String()), ace.Header.AceType, ace.Header.AceFlags, ace.Mask)
+			}
+		}
+	}
+}
