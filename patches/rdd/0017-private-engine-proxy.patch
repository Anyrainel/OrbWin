index 0000000..fe392a1
--- /dev/null
+++ b/rdd/pkg/managementconfig/private_windows_test.go
@@ -0,0 +1,231 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func fixture(t *testing.T) (*ParentLease, string, string) {
+	t.Helper()
+	token, e := windows.OpenCurrentProcessToken()
+	if e != nil {
+		t.Fatal("fixture token unavailable")
+	}
+	defer token.Close()
+	if token.IsElevated() {
+		t.Fatal("qualification requires nonadmin process")
+	}
+	user, e := token.GetTokenUser()
+	if e != nil {
+		t.Fatal("fixture SID unavailable")
+	}
+	sid := user.User.Sid.String()
+	dir, e := os.MkdirTemp("", "orbwin-private-create-")
+	if e != nil {
+		t.Fatal("fixture directory unavailable")
+	}
+	t.Cleanup(func() {
+		for _, name := range []string{filepath.Join(dir, anchorName, configName), filepath.Join(dir, anchorName), dir} {
+			if e := os.Remove(name); e != nil && !os.IsNotExist(e) {
+				t.Error("known fixture cleanup failed")
+			}
+		}
+	})
+	// Deliberately unsafe inheritance on this NEW fixture parent only: children
+	// must be private at CREATE rather than becoming private after writing.
+	sd, e := windows.SecurityDescriptorFromString("D:P(A;OICI;FA;;;" + sid + ")(A;OICI;FA;;;WD)")
+	if e != nil {
+		t.Fatal("fixture SD unavailable")
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || windows.SetNamedSecurityInfo(dir, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil {
+		t.Fatal("fresh parent fixture ACL setup failed")
+	}
+	p, _ := windows.UTF16PtrFromString(dir)
+	parent, e := windows.CreateFile(p, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e != nil {
+		t.Fatal("fixture parent handle unavailable")
+	}
+	lease := &ParentLease{chain: []windows.Handle{parent}, sid: sid}
+	t.Cleanup(func() { lease.Close() })
+	return lease, dir, sid
+}
+func assertStage(t *testing.T, err error, stage string, unknown bool) {
+	t.Helper()
+	var failure *Failure
+	if !errors.As(err, &failure) || !errors.Is(err, ErrCreate) || failure.Stage != stage || failure.CleanupUnknown != unknown {
+		t.Fatal("wrong refusal stage or cleanup outcome")
+	}
+}
+
+func TestPrivateAtCreateBeforeFirstCredentialWrite(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	firstWrite := false
+	created, e := createFresh(context.Background(), parent, []byte("private fixture credential"), createOps{
+		write: func(h windows.Handle, p []byte) (int, error) {
+			// A native descriptor query occurs BEFORE the very first byte write.
+			if !firstWrite {
+				firstWrite = true
+				if verifyPrivate(h, sid, false) != nil {
+					t.Error("credential file was not private before write")
+					return 0, ErrCreate
+				}
+				sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION)
+				if err != nil {
+					t.Error("native first-write descriptor unavailable")
+					return 0, ErrCreate
+				}
+				control, _, err := sd.Control()
+				if err != nil || control&windows.SE_DACL_PROTECTED == 0 {
+					t.Error("descriptor not protected at first write")
+					return 0, ErrCreate
+				}
+			}
+			return nativeWrite(h, p)
+		}, flush: windows.FlushFileBuffers,
+	})
+	if e != nil || created == nil || !firstWrite {
+		t.Fatal("fresh private creation refused", e)
+	}
+	if verifyPrivate(created.anchor, sid, true) != nil || verifyPrivate(created.file, sid, false) != nil {
+		t.Fatal("native private descriptors changed")
+	}
+	if e := os.Rename(filepath.Join(dir, anchorName), filepath.Join(dir, "moved")); e == nil {
+		os.Rename(filepath.Join(dir, "moved"), filepath.Join(dir, anchorName))
+		t.Fatal("held private anchor replaced")
+	}
+	if e := created.Close(); e != nil {
+		t.Fatal("owned handles failed to close")
+	}
+	if created.Close() != nil {
+		t.Fatal("close not idempotent")
+	}
+	data, e := os.ReadFile(filepath.Join(dir, anchorName, configName))
+	if e != nil || !bytes.Equal(data, []byte("private fixture credential")) {
+		t.Fatal("fresh private bytes not preserved")
+	}
+}
+
+func TestExistingAnchorNeverOpenedOrModified(t *testing.T) {
+	parent, dir, _ := fixture(t)
+	anchor := filepath.Join(dir, anchorName)
+	if os.Mkdir(anchor, 0700) != nil || os.WriteFile(filepath.Join(anchor, configName), []byte("existing sentinel"), 0600) != nil {
+		t.Fatal("existing fixture setup failed")
+	}
+	created, e := createFreshDefault(context.Background(), parent, []byte("replacement"))
+	if created != nil {
+		created.Close()
+		t.Fatal("existing anchor adopted")
+	}
+	assertStage(t, e, "anchor-create", false)
+	data, e := os.ReadFile(filepath.Join(anchor, configName))
+	if e != nil || !bytes.Equal(data, []byte("existing sentinel")) {
+		t.Fatal("existing bytes changed")
+	}
+}
+
+func TestPartialWriteFlushAndCancellationRetireOnlyNewObjects(t *testing.T) {
+	for _, stage := range []string{"write", "flush", "cancel", "no-progress"} {
+		t.Run(stage, func(t *testing.T) {
+			parent, dir, _ := fixture(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ops := createOps{write: nativeWrite, flush: windows.FlushFileBuffers}
+			switch stage {
+			case "no-progress":
+				ops.write = func(windows.Handle, []byte) (int, error) { return 0, nil }
+			case "write":
+				ops.write = func(h windows.Handle, p []byte) (int, error) {
+					n, e := nativeWrite(h, p[:2])
+					if e != nil {
+						return n, e
+					}
+					return n, windows.ERROR_WRITE_FAULT
+				}
+			case "flush":
+				ops.flush = func(windows.Handle) error { return windows.ERROR_WRITE_FAULT }
+			case "cancel":
+				ops.write = func(h windows.Handle, p []byte) (int, error) { n, e := nativeWrite(h, p); cancel(); return n, e }
+			}
+			created, e := createFresh(ctx, parent, []byte("private partial fixture"), ops)
+			if created != nil {
+				created.Close()
+				t.Fatal("partial creation accepted")
+			}
+			want := stage
+			if stage == "cancel" {
+				want = "flush"
+			}
+			if stage == "no-progress" {
+				want = "write"
+			}
+			assertStage(t, e, want, false)
+			if _, e := os.Stat(filepath.Join(dir, anchorName)); !os.IsNotExist(e) {
+				t.Fatal("new failed anchor not retired")
+			}
+		})
+	}
+}
+
+func TestConcurrentConfigCollisionPreservesOtherWriterSentinel(t *testing.T) {
+	parent, dir, sid := fixture(t)
+	created, e := createFresh(context.Background(), parent, []byte("new credentials"), createOps{
+		beforeConfig: func(anchor windows.Handle) error {
+			sd, e := privateDescriptor(sid, false)
+			if e != nil {
+				return e
+			}
+			other, e := openRelative(anchor, configName, false, sd, true)
+			if e != nil {
+				return e
+			}
+			_, e = nativeWrite(other, []byte("racing sentinel"))
+			closeErr := windows.CloseHandle(other)
+			if e != nil {
+				return e
+			}
+			return closeErr
+		},
+		write: nativeWrite, flush: windows.FlushFileBuffers,
+	})
+	if created != nil {
+		created.Close()
+		t.Fatal("colliding config overwritten")
+	}
+	assertStage(t, e, "config-create", true)
+	data, e := os.ReadFile(filepath.Join(dir, anchorName, configName))
+	if e != nil || !bytes.Equal(data, []byte("racing sentinel")) {
+		t.Fatal("other writer sentinel deleted or changed")
+	}
+}
+
+func TestFreshInputAndReparseAnchorRefusals(t *testing.T) {
+	parent, dir, _ := fixture(t)
+	for _, data := range [][]byte{nil, make([]byte, MaxConfigBytes+1)} {
+		if created, e := createFreshDefault(context.Background(), parent, data); created != nil || e == nil {
+			t.Fatal("invalid size accepted")
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if created, e := createFreshDefault(ctx, parent, []byte("x")); created != nil || e == nil {
+		t.Fatal("pre-cancel admitted")
+	}
+	if e := os.Symlink(dir, filepath.Join(dir, anchorName)); e != nil {
+		t.Skip("symlink qualification unavailable; no elevation requested")
+	}
+	created, e := createFreshDefault(context.Background(), parent, []byte("x"))
+	if created != nil {
+		created.Close()
+		t.Fatal("reparse anchor followed")
+	}
+	assertStage(t, e, "anchor-create", false)
+}
diff --git a/rdd/pkg/managementconfig/reader_windows.go b/rdd/pkg/managementconfig/reader_windows.go
new file mode 100644
index 0000000..4c0c82c
--- /dev/null
+++ b/rdd/pkg/managementconfig/reader_windows.go
@@ -0,0 +1,364 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// InstanceRoot is constructed only from native known-folder authority and the
+// exact explicitly selected OrbWin runtime home. It is not a renderer path.
+type InstanceRoot struct{ home, sid string }
+
+func (InstanceRoot) String() string   { return "private owned instance root" }
+func (InstanceRoot) GoString() string { return "private owned instance root" }
+
+type ParentLease struct {
+	mu     sync.Mutex
+	chain  []windows.Handle
+	sid    string
+	closed bool
+	err    error
+}
+
+func (*ParentLease) String() string   { return "private owned parent lease" }
+func (*ParentLease) GoString() string { return "private owned parent lease" }
+
+func (p *ParentLease) leaf() windows.Handle {
+	if p == nil || len(p.chain) == 0 {
+		return 0
+	}
+	return p.chain[len(p.chain)-1]
+}
+func (p *ParentLease) Close() error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return p.err
+	}
+	p.closed = true
+	for i := len(p.chain) - 1; i >= 0; i-- {
+		if windows.CloseHandle(p.chain[i]) != nil {
+			p.err = ErrCreate
+		}
+	}
+	p.chain = nil
+	return p.err
+}
+func (p *ParentLease) retain() (*ParentLease, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.leaf() == 0 {
+		return nil, ErrCreate
+	}
+	clone := &ParentLease{sid: p.sid}
+	for _, original := range p.chain {
+		var handle windows.Handle
+		if windows.DuplicateHandle(windows.CurrentProcess(), original, windows.CurrentProcess(), &handle, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+			clone.Close()
+			return nil, ErrCreate
+		}
+		clone.chain = append(clone.chain, handle)
+	}
+	return clone, nil
+}
+
+// ResolveOrbWinRoot does not open configuration files. Construction alone is
+// not a directory ownership receipt; OpenInstanceParent applies that policy.
+func ResolveOrbWinRoot(home, suffix string) (*InstanceRoot, error) {
+	if suffix != "orbwin" {
+		return nil, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil {
+		return nil, ErrCreate
+	}
+	token, e := windows.OpenCurrentProcessToken()
+	if e != nil {
+		return nil, ErrCreate
+	}
+	defer token.Close()
+	local, e := token.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
+	if e != nil {
+		return nil, ErrCreate
+	}
+	if !validOrbWinHome(local, home) {
+		return nil, ErrCreate
+	}
+	return &InstanceRoot{home: home, sid: sid}, nil
+}
+func validOrbWinHome(local, home string) bool {
+	if _, _, e := readerComponents(local + `\placeholder`); e != nil {
+		return false
+	}
+	if _, _, e := readerComponents(home + `\placeholder`); e != nil {
+		return false
+	}
+	return strings.EqualFold(home, filepath.Join(local, "OrbWinData", "home"))
+}
+func readerComponents(path string) (string, []string, error) {
+	if len(path) < 4 || len(path) > 1024 || path[1] != ':' || path[2] != '\\' || !((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) || strings.ContainsAny(path[2:], ":/\x00") {
+		return "", nil, ErrCreate
+	}
+	parts := strings.Split(path[3:], "\\")
+	if len(parts) > 32 {
+		return "", nil, ErrCreate
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") || strings.ContainsAny(part, "<>\"|?*") {
+			return "", nil, ErrCreate
+		}
+	}
+	return path[:3], parts, nil
+}
+
+// OpenInstanceParent retains the selected native-root chain. Every ancestor uses the conservative
+// ownership policy; no private-anchor exception bypasses unsafe profile ACLs.
+func OpenInstanceParent(ctx context.Context, root *InstanceRoot) (*ParentLease, error) {
+	return openInstanceParent(ctx, root, false)
+}
+func openInstanceParent(ctx context.Context, root *InstanceRoot, createMissing bool) (*ParentLease, error) {
+	return openInstanceParentMode(ctx, root, createMissing, false)
+}
+
+var errProductParentAbsent = errors.New("fixed product parent absent")
+
+func openInstanceParentMode(ctx context.Context, root *InstanceRoot, createMissing, observeMissing bool) (*ParentLease, error) {
+	if ctx == nil || ctx.Err() != nil || root == nil {
+		return nil, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil || sid != root.sid {
+		return nil, ErrCreate
+	}
+	// Revalidate constructor authority under the current native owner; the typed
+	// value cannot be reused across a changed known-folder/owner selection.
+	verified, e := ResolveOrbWinRoot(root.home, "orbwin")
+	if e != nil || verified.sid != sid {
+		return nil, ErrCreate
+	}
+	volume, parts, e := readerComponents(filepath.Join(root.home, "AppData", "Local"))
+	if e != nil {
+		return nil, ErrCreate
+	}
+	p, _ := windows.UTF16PtrFromString(volume)
+	h, e := windows.CreateFile(p, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e != nil {
+		return nil, ErrCreate
+	}
+	lease := &ParentLease{chain: []windows.Handle{h}, sid: sid}
+	if checkReadObject(h, sid, true) != nil {
+		lease.Close()
+		return nil, ErrCreate
+	}
+	for index, part := range parts {
+		if ctx.Err() != nil {
+			lease.Close()
+			return nil, ErrCreate
+		}
+		next, err := openRelative(lease.leaf(), part, true, nil, false)
+		if err == windows.STATUS_OBJECT_NAME_NOT_FOUND && observeMissing && index >= len(parts)-4 {
+			lease.Close()
+			return nil, errProductParentAbsent
+		}
+		// Only the four fixed PRODUCT components may be created. Native user
+		// profile/LocalAppData ancestors are never fabricated or repaired.
+		if err == windows.STATUS_OBJECT_NAME_NOT_FOUND && createMissing && index >= len(parts)-4 {
+			sd, sdErr := privateDescriptor(sid, true)
+			if sdErr != nil {
+				lease.Close()
+				return nil, ErrCreate
+			}
+			next, err = openRelative(lease.leaf(), part, true, sd, true)
+		}
+		if err != nil {
+			lease.Close()
+			return nil, ErrCreate
+		}
+		lease.chain = append(lease.chain, next)
+		if checkReadObject(next, sid, true) != nil {
+			lease.Close()
+			return nil, ErrCreate
+		}
+	}
+	return lease, nil
+}
+func walkRelative(ctx context.Context, lease *ParentLease, parts []string) error {
+	if lease == nil || lease.leaf() == 0 {
+		return ErrCreate
+	}
+	for _, part := range parts {
+		if ctx.Err() != nil {
+			return ErrCreate
+		}
+		// Defense in depth for the fixture/internal caller too: exactly one
+		// canonical child, never an absolute or dot path relative to the lease.
+		_, validated, e := readerComponents(`C:\` + part)
+		if e != nil || len(validated) != 1 {
+			return ErrCreate
+		}
+		h, e := openRelative(lease.leaf(), part, true, nil, false)
+		if e != nil {
+			return ErrCreate
+		}
+		lease.chain = append(lease.chain, h)
+		if checkReadObject(h, lease.sid, true) != nil {
+			return ErrCreate
+		}
+	}
+	if ctx.Err() != nil {
+		return ErrCreate
+	}
+	return nil
+}
+
+type Reader struct {
+	mu        sync.Mutex
+	file      *os.File
+	lease     *ParentLease
+	remaining int
+	ctx       context.Context
+}
+
+func (*Reader) String() string   { return "private owned management reader" }
+func (*Reader) GoString() string { return "private owned management reader" }
+func (r *Reader) Read(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.file == nil || r.ctx.Err() != nil || r.remaining == 0 {
+		return 0, ErrCreate
+	}
+	if len(p) > r.remaining {
+		p = p[:r.remaining]
+	}
+	n, e := r.file.Read(p)
+	if r.ctx.Err() != nil {
+		return 0, ErrCreate
+	}
+	r.remaining -= n
+	if e != nil && e != io.EOF {
+		return n, ErrCreate
+	}
+	return n, e
+}
+func (r *Reader) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.file == nil {
+		return nil
+	}
+	e := r.file.Close()
+	r.file = nil
+	if r.lease.Close() != nil || e != nil {
+		return ErrCreate
+	}
+	return nil
+}
+
+func OpenInstanceReader(ctx context.Context, root *InstanceRoot) (*Reader, error) {
+	lease, e := OpenInstanceParent(ctx, root)
+	if e != nil {
+		return nil, ErrCreate
+	}
+	if walkRelative(ctx, lease, []string{anchorName}) != nil {
+		lease.Close()
+		return nil, ErrCreate
+	}
+	return openReaderLeaf(ctx, lease)
+}
+func openReaderLeaf(ctx context.Context, lease *ParentLease) (*Reader, error) {
+	if ctx == nil || ctx.Err() != nil || lease == nil || lease.leaf() == 0 {
+		if lease != nil {
+			lease.Close()
+		}
+		return nil, ErrCreate
+	}
+	h, e := openRelative(lease.leaf(), configName, false, nil, false)
+	if e != nil {
+		lease.Close()
+		return nil, ErrCreate
+	}
+	file := os.NewFile(uintptr(h), "private owned management configuration")
+	if checkReadObject(h, lease.sid, false) != nil {
+		file.Close()
+		lease.Close()
+		return nil, ErrCreate
+	}
+	info, e := file.Stat()
+	if e != nil || info.Size() < 1 || info.Size() > MaxConfigBytes {
+		file.Close()
+		lease.Close()
+		return nil, ErrCreate
+	}
+	return &Reader{file: file, lease: lease, remaining: MaxConfigBytes + 1, ctx: ctx}, nil
+}
+
+// CheckReadObjectPolicy is a metadata-only advisory policy check, not a parent
+// lease or source authority constructor. Only typed walkers produce leases.
+func CheckReadObjectPolicy(h windows.Handle, directory bool) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil {
+		return ErrCreate
+	}
+	return checkReadObject(h, sid, directory)
+}
+func checkReadObject(h windows.Handle, sid string, directory bool) error {
+	if objectKind(h, directory) != nil {
+		return ErrCreate
+	}
+	sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if e != nil {
+		return ErrCreate
+	}
+	owner, _, e := sd.Owner()
+	if e != nil || owner == nil || !readerTrustedSID(owner.String(), sid) {
+		return ErrCreate
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || acl == nil || acl.AceCount > 256 {
+		return ErrCreate
+	}
+	for i := uint32(0); i < uint32(acl.AceCount); i++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if windows.GetAce(acl, i, &ace) != nil || ace == nil || ace.Header.AceSize < 16 || (ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE && ace.Header.AceType != windows.ACCESS_DENIED_ACE_TYPE) || ace.Header.AceFlags&^uint8(0x1f) != 0 {
+			return ErrCreate
+		}
+		if ace.Header.AceFlags&windows.INHERIT_ONLY_ACE != 0 || ace.Header.AceType == windows.ACCESS_DENIED_ACE_TYPE {
+			continue
+		}
+		principal := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		if !principal.IsValid() || principal.Len() > int(ace.Header.AceSize)-8 {
+			return ErrCreate
+		}
+		if readerTrustedSID(principal.String(), sid) {
+			continue
+		}
+		bad := uint32(windows.DELETE | windows.WRITE_DAC | windows.WRITE_OWNER | 0x40 | windows.FILE_WRITE_DATA | windows.FILE_WRITE_ATTRIBUTES | windows.FILE_WRITE_EA | windows.GENERIC_ALL | windows.GENERIC_WRITE)
+		if !directory {
+			bad |= windows.FILE_READ_DATA | windows.FILE_APPEND_DATA | windows.FILE_EXECUTE | windows.GENERIC_READ | windows.GENERIC_EXECUTE
+		}
+		if uint32(ace.Mask)&bad != 0 {
+			return ErrCreate
+		}
+	}
+	return nil
+}
+func readerTrustedSID(value, current string) bool {
+	return value == current || value == "S-1-5-18" || value == "S-1-5-32-544" || value == "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"
+}
diff --git a/rdd/pkg/managementconfig/reader_windows_test.go b/rdd/pkg/managementconfig/reader_windows_test.go
new file mode 100644
index 0000000..ce47276
--- /dev/null
+++ b/rdd/pkg/managementconfig/reader_windows_test.go
@@ -0,0 +1,210 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func readerFixture(t *testing.T) (*ParentLease, string, string) {
+	t.Helper()
+	lease, dir, sid := fixture(t)
+	// Test-only authority anchor, not a claim that real profile ancestors pass.
+	sd, e := privateDescriptor(sid, true)
+	if e != nil {
+		t.Fatal("private fixture descriptor failed")
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || windows.SetNamedSecurityInfo(dir, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil {
+		t.Fatal("fresh fixture anchor setup failed")
+	}
+	one := filepath.Join(dir, "one")
+	two := filepath.Join(one, "two")
+	config := filepath.Join(two, configName)
+	if os.Mkdir(one, 0700) != nil || os.Mkdir(two, 0700) != nil || os.WriteFile(config, []byte("reader fixture"), 0600) != nil {
+		t.Fatal("fresh reader fixture setup failed")
+	}
+	t.Cleanup(func() {
+		lease.Close()
+		for _, path := range []string{filepath.Join(dir, "link"), config, two, one} {
+			if e := os.Remove(path); e != nil && !os.IsNotExist(e) {
+				t.Error("known reader fixture cleanup failed")
+			}
+		}
+	})
+	if checkReadObject(lease.leaf(), sid, true) != nil {
+		t.Fatal("test fixture authority anchor refused")
+	}
+	return lease, dir, sid
+}
+
+func TestReaderStrongRelativeChainBlocksAncestorRenameAndReleases(t *testing.T) {
+	lease, dir, _ := readerFixture(t)
+	if walkRelative(context.Background(), lease, []string{"one", "two"}) != nil {
+		t.Fatal("strong fixture walk failed")
+	}
+	reader, e := openReaderLeaf(context.Background(), lease)
+	if e != nil {
+		t.Fatal("private reader fixture refused")
+	}
+	defer reader.Close()
+	if os.Rename(filepath.Join(dir, "one"), filepath.Join(dir, "moved")) == nil {
+		os.Rename(filepath.Join(dir, "moved"), filepath.Join(dir, "one"))
+		t.Fatal("held ancestor renamed")
+	}
+	if w, e := os.OpenFile(filepath.Join(dir, "one", "two", configName), os.O_WRONLY, 0); e == nil {
+		w.Close()
+		t.Fatal("reader admitted credential writer")
+	}
+	data, e := io.ReadAll(reader)
+	if e != nil || !bytes.Equal(data, []byte("reader fixture")) {
+		t.Fatal("bounded private reader bytes incorrect")
+	}
+	reader.Close()
+	if _, e := reader.Read(make([]byte, 1)); e == nil {
+		t.Fatal("closed reader admitted IO")
+	}
+	if os.Rename(filepath.Join(dir, "one"), filepath.Join(dir, "moved")) != nil {
+		t.Fatal("strong ancestor lease did not release")
+	}
+	if os.Rename(filepath.Join(dir, "moved"), filepath.Join(dir, "one")) != nil {
+		t.Fatal("fixture rename restore failed")
+	}
+}
+
+func TestReaderPriorDeleteAndReparseRefusal(t *testing.T) {
+	lease, dir, _ := readerFixture(t)
+	p, _ := windows.UTF16PtrFromString(filepath.Join(dir, "one"))
+	prior, e := windows.CreateFile(p, windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if e != nil {
+		t.Fatal("fresh prior delete unavailable")
+	}
+	if walkRelative(context.Background(), lease, []string{"one"}) == nil {
+		windows.CloseHandle(prior)
+		t.Fatal("strong walker admitted prior DELETE")
+	}
+	windows.CloseHandle(prior)
+	if e := os.Symlink(filepath.Join(dir, "one"), filepath.Join(dir, "link")); e != nil {
+		t.Skip("symlink fixture unavailable; no elevation requested")
+	}
+	if walkRelative(context.Background(), lease, []string{"link"}) == nil {
+		t.Fatal("relative walker followed reparse ancestor")
+	}
+}
+
+func TestReaderConservativeACLAndSizeRefusals(t *testing.T) {
+	for _, kind := range []string{"ancestor-write", "credential-read", "empty", "oversize"} {
+		t.Run(kind, func(t *testing.T) {
+			lease, dir, sid := readerFixture(t)
+			if kind == "ancestor-write" || kind == "credential-read" {
+				path := filepath.Join(dir, "one")
+				rights := "FW"
+				if kind == "credential-read" {
+					path = filepath.Join(dir, "one", "two", configName)
+					rights = "FR"
+				}
+				flags := ""
+				if kind == "ancestor-write" {
+					flags = "OICI"
+				}
+				sd, e := windows.SecurityDescriptorFromString("D:P(A;" + flags + ";FA;;;" + sid + ")(A;;" + rights + ";;;WD)")
+				if e != nil {
+					t.Fatal("fresh bad-ACL descriptor failed")
+				}
+				acl, _, e := sd.DACL()
+				if e != nil || windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil {
+					t.Fatal("fresh bad-ACL fixture failed")
+				}
+			}
+			if kind == "empty" || kind == "oversize" {
+				var data []byte
+				if kind == "oversize" {
+					data = make([]byte, MaxConfigBytes+1)
+				}
+				if os.WriteFile(filepath.Join(dir, "one", "two", configName), data, 0600) != nil {
+					t.Fatal("fresh size fixture failed")
+				}
+			}
+			e := walkRelative(context.Background(), lease, []string{"one", "two"})
+			if kind == "ancestor-write" {
+				if e == nil {
+					t.Fatal("ancestor ACL relaxed")
+				}
+				return
+			}
+			if e != nil {
+				t.Fatal("safe ancestors refused")
+			}
+			if reader, e := openReaderLeaf(context.Background(), lease); e == nil {
+				reader.Close()
+				t.Fatal("unsafe or unbounded config admitted")
+			}
+		})
+	}
+}
+
+func TestReaderTypedRootDerivationAndCancellation(t *testing.T) {
+	if !validOrbWinHome(`C:\OwnedLocal`, `C:\OwnedLocal\OrbWinData\home`) {
+		t.Fatal("fixed product home rejected")
+	}
+	for _, path := range []string{`\\server\share\home`, `\\?\C:\OwnedLocal\OrbWinData\home`, `C:\OwnedLocal\OrbWinData\home:stream`, `C:\OwnedLocal\OrbWinData\home\..\home`, `C:\Other\home`} {
+		if validOrbWinHome(`C:\OwnedLocal`, path) {
+			t.Fatal("unowned root accepted")
+		}
+	}
+	for _, path := range []string{`\\server\share\config.yaml`, `C:config.yaml`, `C:\one\..\config.yaml`, `C:\one\config.yaml:stream`, `C:\one.\config.yaml`} {
+		if _, _, e := readerComponents(path); e == nil {
+			t.Fatal("ambiguous/device path accepted")
+		}
+	}
+	if parent, e := OpenInstanceParent(context.Background(), &InstanceRoot{}); e == nil {
+		parent.Close()
+		t.Fatal("zero typed authority accepted")
+	}
+	lease, _, _ := readerFixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if walkRelative(ctx, lease, []string{"one"}) == nil {
+		t.Fatal("canceled walker proceeded")
+	}
+	for _, part := range []string{"..", `one\two`, `C:\one`} {
+		if walkRelative(context.Background(), lease, []string{part}) == nil {
+			t.Fatal("relative component escaped authority")
+		}
+	}
+}
+
+func TestTypedParentRetainCloseRaceNoClosedHandleReuse(t *testing.T) {
+	lease, _, _ := readerFixture(t)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			retained, e := lease.retain()
+			if e == nil {
+				if objectKind(retained.leaf(), true) != nil {
+					t.Error("retained parent changed object")
+				}
+				retained.Close()
+			}
+		}()
+	}
+	close(start)
+	lease.Close()
+	wg.Wait()
+	if retained, e := lease.retain(); e == nil {
+		retained.Close()
+		t.Fatal("closed lease was reused")
+	}
+}
