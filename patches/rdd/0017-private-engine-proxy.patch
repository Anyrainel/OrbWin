@@ -0,0 +1,53 @@
+package controllers
+
+import (
+	"context"
+	"encoding/pem"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	ctrl "sigs.k8s.io/controller-runtime"
+)
+
+type servingReceiverProbe struct{ selected *networkproxy.ServingIdentity }
+
+func (*servingReceiverProbe) GetName() string                                         { return "proxy-serving-probe" }
+func (*servingReceiverProbe) GetAPIGroup() string                                     { return "fixture" }
+func (*servingReceiverProbe) GetCRDData() string                                      { return "" }
+func (*servingReceiverProbe) RegisterWithManager(context.Context, ctrl.Manager) error { return nil }
+func (p *servingReceiverProbe) SetProxyServingIdentity(s *networkproxy.ServingIdentity) {
+	p.selected = s
+}
+
+func TestProxyServingInjectionOnlyBeforeEmbeddedRegistration(t *testing.T) {
+	server := httptest.NewTLSServer(http.NotFoundHandler())
+	defer server.Close()
+	selected, err := networkproxy.NewServingIdentity(server.URL, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	scm := &SharedControllerManager{name: "embedded"}
+	if scm.SetProxyServingIdentity(selected) != nil {
+		t.Fatal("serving injection refused")
+	}
+	probe := &servingReceiverProbe{}
+	if scm.RegisterController(probe) != nil || probe.selected != selected {
+		t.Fatal("in-memory serving identity not injected")
+	}
+	if scm.SetProxyServingIdentity(selected) != networkproxy.ErrManagement {
+		t.Fatal("late source replacement accepted")
+	}
+	external := &SharedControllerManager{name: "external"}
+	if external.SetProxyServingIdentity(selected) != networkproxy.ErrManagement {
+		t.Fatal("external management config minted launch authority")
+	}
+	if external.RegisterController(probe) != nil || probe.selected != nil {
+		t.Fatal("external registration retained stale embedded authority")
+	}
+	started := &SharedControllerManager{name: "embedded", started: true}
+	if started.SetProxyServingIdentity(selected) != networkproxy.ErrManagement || started.RegisterController(probe) == nil {
+		t.Fatal("started manager accepted source drift")
+	}
+}
