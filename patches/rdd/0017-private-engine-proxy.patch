+package controllers
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	ctrl "sigs.k8s.io/controller-runtime"
+)
+
+func TestProxyPendingGuestJobConvergesWithoutUnrelatedAPIEvent(t *testing.T) {
+	r, a, vm, g := proxyControllerFixture(t, "url")
+	proxyPrepare(t, r, a, vm)
+	now := time.Unix(100, 0)
+	r.proxyNow = func() time.Time { return now }
+	g.failure = networkproxy.ErrGuestPending
+	for i := 0; i < 2; i++ {
+		after, err := r.reconcileProxyObservation(context.Background(), a, vm)
+		if err != nil || after != time.Second || mergeProxyObservationRequeue(ctrl.Result{}, nil, after).RequeueAfter != time.Second {
+			t.Fatal("pending job did not schedule scoped observation")
+		}
+		now = now.Add(time.Second)
+	}
+	if len(g.calls) != 2 || g.calls[0].ID != g.calls[1].ID || proxyRead(t, r).Status.NetworkProxy.GuestAppliedRevision != 0 {
+		t.Fatal("pending job changed transaction or claimed applied")
+	}
+	g.failure = nil
+	after, err := r.reconcileProxyObservation(context.Background(), a, vm)
+	current := proxyRead(t, r)
+	if err != nil || after != 0 || current.Status.NetworkProxy.Plan.Phase != "commit" || current.Status.NetworkProxy.GuestAppliedRevision != 1 || r.proxyObservation != nil {
+		t.Fatal("scheduled exact transaction did not converge")
+	}
+}
+
+func TestProxyPendingObservationBudgetTerminatesAndSourceFailuresDoNotRetry(t *testing.T) {
+	r, a, vm, g := proxyControllerFixture(t, "url")
+	proxyPrepare(t, r, a, vm)
+	now := time.Unix(100, 0)
+	r.proxyNow = func() time.Time { return now }
+	g.observeFailure = networkproxy.ErrGuestPending
+	if after, err := r.reconcileProxyObservation(context.Background(), a, vm); err != nil || after != time.Second || len(g.calls) != 0 {
+		t.Fatal("identity pending was not read-only")
+	}
+	now = now.Add(60 * time.Second)
+	for i := 0; i < 2; i++ {
+		if after, err := r.reconcileProxyObservation(context.Background(), a, vm); err != nil || after != 0 {
+			t.Fatal("expired same-plan budget restarted")
+		}
+		condition := apimeta.FindStatusCondition(proxyRead(t, r).Status.Conditions, conditionNetworkProxyReady)
+		if condition == nil || condition.Reason != "Unavailable" {
+			t.Fatal("expired observation claimed progress")
+		}
+	}
+	g.observeFailure = errors.New("source unavailable")
+	if after, err := r.reconcileProxyObservation(context.Background(), a, vm); err != nil || after != 0 {
+		t.Fatal("generic source failure became automatic retry")
+	}
+	if mergeProxyObservationRequeue(ctrl.Result{}, errors.New("ordinary reconciliation error"), time.Second).RequeueAfter != 0 {
+		t.Fatal("proxy retry overrode ordinary failure")
+	}
+	if mergeProxyObservationRequeue(ctrl.Result{RequeueAfter: time.Millisecond}, nil, time.Second).RequeueAfter != time.Millisecond {
+		t.Fatal("proxy delayed an earlier engine requeue")
+	}
+}
