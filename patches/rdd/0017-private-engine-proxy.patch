diff --git a/rdd/src/rdd-guest/proxy_files_linux.go b/rdd/src/rdd-guest/proxy_files_linux.go
new file mode 100644
index 0000000..11e8fe2
--- /dev/null
+++ b/rdd/src/rdd-guest/proxy_files_linux.go
@@ -0,0 +1,376 @@
+//go:build linux
+
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+	"golang.org/x/sys/unix"
+)
+
+type proxyNativeBackend struct{}
+type proxyNativeLease struct {
+	initialized, closed                bool
+	dirs                               []int
+	anchor, config, configParent, lock int
+	root                               int
+	ownerUID                           uint32
+	runtime                            func(context.Context) (string, string, string, error)
+	actions                            func(context.Context, string) ([]byte, error)
+}
+
+func proxyOpen(parent int, name string, flags int, mode uint64) (int, error) {
+	// Every name is a fixed single component or an internally generated private
+	// temp name. No client path, symlink or fallback to weaker resolution.
+	if name == "" || name == "." || name == ".." || bytes.ContainsAny([]byte(name), "/\\\x00") {
+		return -1, protocol.ErrInvalid
+	}
+	return unix.Openat2(parent, name, &unix.OpenHow{Flags: uint64(flags | unix.O_CLOEXEC | unix.O_NOFOLLOW), Mode: mode, Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS})
+}
+func proxyStat(fd int, dir bool, private bool, ownerUID uint32) error {
+	var s unix.Stat_t
+	if unix.Fstat(fd, &s) != nil || s.Uid != ownerUID || s.Mode&0022 != 0 {
+		return protocol.ErrUnavailable
+	}
+	if dir {
+		if s.Mode&unix.S_IFMT != unix.S_IFDIR {
+			return protocol.ErrUnavailable
+		}
+		if private && s.Mode&0777 != 0700 {
+			return protocol.ErrUnavailable
+		}
+	} else {
+		if s.Mode&unix.S_IFMT != unix.S_IFREG || s.Nlink != 1 || private && s.Mode&0777 != 0600 {
+			return protocol.ErrUnavailable
+		}
+	}
+	return nil
+}
+func (b proxyNativeBackend) Acquire(ctx context.Context) (protocol.Lease, error) {
+	if ctx == nil || ctx.Err() != nil || unix.Geteuid() != 0 {
+		return nil, protocol.ErrUnavailable
+	}
+	root, err := unix.Open("/", unix.O_DIRECTORY|unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	return proxyAcquireAt(ctx, root, 0, proxyRuntime, proxySystemctl)
+}
+
+// Private retained-FD dependency boundary, no CLI/path/UID override. Production
+// always passes / + UID 0 and fixed native runtime/actions. Native FS tests pass
+// a freshly owned temporary root FD/current UID and mandatory inert callbacks.
+// Ownership of root transfers even on failure; all paths remain relative to it.
+func proxyAcquireAt(ctx context.Context, root int, ownerUID uint32, runtime func(context.Context) (string, string, string, error), actions func(context.Context, string) ([]byte, error)) (*proxyNativeLease, error) {
+	lease := &proxyNativeLease{initialized: true, anchor: -1, config: -1, lock: -1, root: root, ownerUID: ownerUID, runtime: runtime, actions: actions, dirs: []int{root}}
+	ok := false
+	defer func() {
+		if !ok {
+			_ = lease.Close()
+		}
+	}()
+	if ctx == nil || ctx.Err() != nil || runtime == nil || actions == nil || proxyStat(root, true, false, ownerUID) != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	var err error
+	walk := func(parts []string, createAnchor bool) (int, error) {
+		parent := root
+		for i, part := range parts {
+			if ctx.Err() != nil {
+				return -1, protocol.ErrUnavailable
+			}
+			fd, err := proxyOpen(parent, part, unix.O_RDONLY|unix.O_DIRECTORY, 0)
+			if errors.Is(err, unix.ENOENT) && createAnchor && i >= 2 {
+				mode := uint32(0755)
+				if i == len(parts)-1 {
+					mode = 0700
+				}
+				if unix.Mkdirat(parent, part, mode) != nil {
+					return -1, protocol.ErrUnavailable
+				}
+				if unix.Fsync(parent) != nil {
+					return -1, protocol.ErrUnavailable
+				}
+				fd, err = proxyOpen(parent, part, unix.O_RDONLY|unix.O_DIRECTORY, 0)
+			}
+			if err != nil {
+				return -1, protocol.ErrUnavailable
+			}
+			lease.dirs = append(lease.dirs, fd)
+			if proxyStat(fd, true, createAnchor && i == len(parts)-1, ownerUID) != nil {
+				return -1, protocol.ErrUnavailable
+			}
+			parent = fd
+		}
+		return parent, nil
+	}
+	lease.anchor, err = walk([]string{"var", "lib", "orbwin", "network-proxy"}, true)
+	if err != nil {
+		return nil, err
+	}
+	lease.configParent, err = walk([]string{"etc", "systemd", "system"}, false)
+	if err != nil {
+		return nil, err
+	}
+	if err := lease.refreshConfig(false); err != nil {
+		return nil, err
+	}
+	lease.lock, err = proxyOpen(lease.anchor, "writer.lock", unix.O_RDWR|unix.O_CREAT|unix.O_EXCL, 0600)
+	if errors.Is(err, unix.EEXIST) {
+		lease.lock, err = proxyOpen(lease.anchor, "writer.lock", unix.O_RDWR, 0)
+	} else if err == nil && unix.Fsync(lease.anchor) != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	if err != nil || proxyStat(lease.lock, false, true, ownerUID) != nil || unix.Flock(lease.lock, unix.LOCK_EX|unix.LOCK_NB) != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	ok = true
+	return lease, nil
+}
+
+// Missing final local drop-in directory is a valid absent-file observation.
+// Only admitted Install creates it, retaining the already verified parent FD.
+func (l *proxyNativeLease) refreshConfig(create bool) error {
+	if !l.usable() {
+		return protocol.ErrUnavailable
+	}
+	fd, err := proxyOpen(l.configParent, "docker.service.d", unix.O_RDONLY|unix.O_DIRECTORY, 0)
+	if errors.Is(err, unix.ENOENT) && l.config < 0 {
+		if !create {
+			return nil
+		}
+		if unix.Mkdirat(l.configParent, "docker.service.d", 0755) != nil || unix.Fsync(l.configParent) != nil {
+			return protocol.ErrUnavailable
+		}
+		fd, err = proxyOpen(l.configParent, "docker.service.d", unix.O_RDONLY|unix.O_DIRECTORY, 0)
+	}
+	if err != nil {
+		return protocol.ErrUnavailable
+	}
+	if proxyStat(fd, true, false, l.ownerUID) != nil {
+		_ = unix.Close(fd)
+		return protocol.ErrUnavailable
+	}
+	if l.config >= 0 {
+		defer unix.Close(fd)
+		var held, current unix.Stat_t
+		if unix.Fstat(l.config, &held) != nil || unix.Fstat(fd, &current) != nil || held.Dev != current.Dev || held.Ino != current.Ino {
+			return protocol.ErrUnavailable
+		}
+		return nil
+	}
+	l.config = fd
+	l.dirs = append(l.dirs, fd)
+	return nil
+}
+func (l *proxyNativeLease) Close() error {
+	if l == nil || !l.initialized || l.closed {
+		return nil
+	}
+	// Linear lifetime: invalidate BEFORE releasing descriptors. No concurrent
+	// Close/use contract is claimed. Old integers can never name recycled FDs.
+	l.closed = true
+	lock, dirs := l.lock, l.dirs
+	l.lock = -1
+	l.root = -1
+	l.anchor = -1
+	l.configParent = -1
+	l.config = -1
+	l.dirs = nil
+	failed := false
+	if lock >= 0 {
+		if unix.Close(lock) != nil {
+			failed = true
+		}
+	}
+	for i := len(dirs) - 1; i >= 0; i-- {
+		if unix.Close(dirs[i]) != nil {
+			failed = true
+		}
+	}
+	if failed {
+		return protocol.ErrUnavailable
+	}
+	return nil
+}
+func (l *proxyNativeLease) usable() bool {
+	return l != nil && l.initialized && !l.closed && l.root >= 0 && l.anchor >= 0 && l.configParent >= 0
+}
+func proxyReadAt(parent int, name string, private bool, limit int, ownerUID uint32) ([]byte, *unix.Stat_t, error) {
+	fd, err := proxyOpen(parent, name, unix.O_RDONLY|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer unix.Close(fd)
+	if proxyStat(fd, false, private, ownerUID) != nil {
+		return nil, nil, protocol.ErrUnavailable
+	}
+	var before, after unix.Stat_t
+	if unix.Fstat(fd, &before) != nil || before.Size < 0 || before.Size > int64(limit) {
+		return nil, nil, protocol.ErrUnavailable
+	}
+	data := make([]byte, 0, before.Size)
+	scratch := make([]byte, 1024)
+	for len(data) <= limit {
+		n, err := unix.Read(fd, scratch)
+		if n > 0 {
+			data = append(data, scratch[:n]...)
+		}
+		if err != nil {
+			return nil, nil, protocol.ErrUnavailable
+		}
+		if n == 0 {
+			break
+		}
+	}
+	if len(data) > limit || unix.Fstat(fd, &after) != nil || before.Dev != after.Dev || before.Ino != after.Ino || before.Size != after.Size || before.Mtim != after.Mtim {
+		return nil, nil, protocol.ErrUnavailable
+	}
+	return data, &after, nil
+}
+func (l *proxyNativeLease) Load(ctx context.Context) (*protocol.Journal, error) {
+	if !l.usable() || ctx == nil || ctx.Err() != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	data, _, err := proxyReadAt(l.anchor, "state.json", true, protocol.MaxFrame, l.ownerUID)
+	if errors.Is(err, unix.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	var journal protocol.Journal
+	reader := bufio.NewReaderSize(bytes.NewReader(data), protocol.MaxFrame+1)
+	if protocol.ReadFrame(reader, &journal) != nil || reader.Buffered() != 0 || journal.Validate() != nil {
+		return nil, protocol.ErrUnavailable
+	}
+	return &journal, nil
+}
+func proxyWriteAll(ctx context.Context, fd int, data []byte) error {
+	for len(data) > 0 {
+		if ctx.Err() != nil {
+			return protocol.ErrUnavailable
+		}
+		n, err := unix.Write(fd, data)
+		if err != nil || n <= 0 {
+			return protocol.ErrUnavailable
+		}
+		data = data[n:]
+	}
+	return nil
+}
+func proxyStaged(ctx context.Context, parent int, name string, data []byte, noReplace bool, ownerUID uint32) error {
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return protocol.ErrUnavailable
+	}
+	temp := ".orbwin-" + hex.EncodeToString(nonce[:]) + ".tmp"
+	fd, err := proxyOpen(parent, temp, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL, 0600)
+	if err != nil {
+		return protocol.ErrUnavailable
+	}
+	closed := false
+	renamed := false
+	defer func() {
+		if !closed {
+			_ = unix.Close(fd)
+		}
+		if !renamed {
+			_ = unix.Unlinkat(parent, temp, 0)
+		}
+	}()
+	if proxyStat(fd, false, true, ownerUID) != nil || proxyWriteAll(ctx, fd, data) != nil || unix.Fsync(fd) != nil {
+		return protocol.ErrUnavailable
+	}
+	if unix.Close(fd) != nil {
+		return protocol.ErrUnavailable
+	}
+	closed = true
+	if ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	if noReplace {
+		err = unix.Renameat2(parent, temp, parent, name, unix.RENAME_NOREPLACE)
+	} else {
+		// Conditional under the cooperating writer lock, NOT atomic hash/inode
+		// CAS against arbitrary guest root. Refuse foreign current targets.
+		_, _, inspect := proxyReadAt(parent, name, true, protocol.MaxFrame, ownerUID)
+		if inspect != nil && !errors.Is(inspect, unix.ENOENT) {
+			return protocol.ErrUnavailable
+		}
+		err = unix.Renameat(parent, temp, parent, name)
+	}
+	if err != nil {
+		return protocol.ErrUnavailable
+	}
+	renamed = true
+	if unix.Fsync(parent) != nil {
+		return protocol.ErrUnavailable
+	}
+	return nil
+}
+func (l *proxyNativeLease) Persist(ctx context.Context, journal protocol.Journal) error {
+	if !l.usable() || ctx == nil || ctx.Err() != nil || journal.Validate() != nil {
+		return protocol.ErrInvalid
+	}
+	var data bytes.Buffer
+	if protocol.WriteFrame(&data, journal) != nil {
+		return protocol.ErrUnavailable
+	}
+	return proxyStaged(ctx, l.anchor, "state.json", data.Bytes(), false, l.ownerUID)
+}
+func (l *proxyNativeLease) Install(ctx context.Context, before protocol.Observation) error {
+	if !l.usable() || ctx == nil || ctx.Err() != nil {
+		return protocol.ErrUnavailable
+	}
+	journal, err := l.Load(ctx)
+	if err != nil || journal == nil || journal.Stage != "write-admitted" || journal.Before != before {
+		return protocol.ErrUnavailable
+	}
+	current, err := l.Observe(ctx)
+	if err != nil || current != before || before.FilePresent {
+		return protocol.ErrUnavailable
+	}
+	if err := l.refreshConfig(true); err != nil {
+		return err
+	}
+	// Only absent first create is implemented. No overwriting foreign content
+	// or historical disabled-file migration is silently introduced.
+	return proxyStaged(ctx, l.config, "90-orbwin-network-proxy.conf", protocol.CompatibilityBody(), true, l.ownerUID)
+}
+
+func proxyReadRelative(root int, parts []string, ownerUID uint32, limit int) ([]byte, error) {
+	if len(parts) < 1 || len(parts) > 8 {
+		return nil, protocol.ErrInvalid
+	}
+	parent := root
+	var opened []int
+	defer func() {
+		for i := len(opened) - 1; i >= 0; i-- {
+			_ = unix.Close(opened[i])
+		}
+	}()
+	for _, part := range parts[:len(parts)-1] {
+		fd, err := proxyOpen(parent, part, unix.O_RDONLY|unix.O_DIRECTORY, 0)
+		if err != nil {
+			return nil, err
+		}
+		opened = append(opened, fd)
+		if proxyStat(fd, true, false, ownerUID) != nil {
+			return nil, protocol.ErrUnavailable
+		}
+		parent = fd
+	}
+	data, _, err := proxyReadAt(parent, parts[len(parts)-1], false, limit, ownerUID)
+	return data, err
+}
+
+// Kept as a compile-time assertion. No constructor is installed in the host.
+var _ protocol.Backend = proxyNativeBackend{}
+var _ protocol.Lease = (*proxyNativeLease)(nil)
diff --git a/rdd/src/rdd-guest/proxy_files_linux_test.go b/rdd/src/rdd-guest/proxy_files_linux_test.go
new file mode 100644
