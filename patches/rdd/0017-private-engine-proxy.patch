+	}
+	if connections.Load() != 1 || watches.Load() < 1 || patches.Load() < 1 || patches.Load() > 4 {
+		t.Fatalf("synthetic flow counts: connections=%d watches=%d patches=%d", connections.Load(), watches.Load(), patches.Load())
+	}
