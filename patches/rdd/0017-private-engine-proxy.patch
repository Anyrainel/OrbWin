+package networkproxy
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+)
+
+func launchFixture() hostagentLaunch {
+	return hostagentLaunch{Version: 1, Handle: 123, Volume: 1, IndexLow: 2, ParentPID: 123, ParentCreation: "0000000000000001", Session: 1, AppUID: "app-one", LimaUID: "lima-one", Epoch: "00000000000000000000000000000001", Endpoint: "https://127.0.0.1:1234", Certificate: strings.Repeat("a", 64)}
+}
+
+func TestClosedHostagentLaunchArgument(t *testing.T) {
+	m := launchFixture()
+	encoded, err := encodeHostagentLaunch(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := parseHostagentLaunch(encoded); err != nil || got != m {
+		t.Fatal("canonical roundtrip")
+	}
+	data, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range []string{string(data) + " ", strings.Replace(string(data), `"v":1`, `"v":1,"v":1`, 1), strings.Replace(string(data), `"v":1`, `"v":1,"extra":1`, 1), strings.Replace(string(data), `"v":1`, `"v":2`, 1), strings.Replace(string(data), `"handle":123`, `"handle":0`, 1), strings.Replace(string(data), `"session":1`, `"session":0`, 1), strings.Replace(string(data), `https://127.0.0.1:1234`, `https://localhost:1234`, 1), string(data) + "{}"} {
+		if _, err := parseHostagentLaunch(base64.RawURLEncoding.EncodeToString([]byte(bad))); err != ErrManagement {
+			t.Fatal("noncanonical argument accepted")
+		}
+	}
+	if _, err := parseHostagentLaunch(strings.Repeat("x", 2049)); err != ErrManagement {
+		t.Fatal("unbounded argument")
+	}
+}
diff --git a/rdd/pkg/networkproxy/hostagent_launch_windows.go b/rdd/pkg/networkproxy/hostagent_launch_windows.go
new file mode 100644
index 0000000..19bf1f9
--- /dev/null
+++ b/rdd/pkg/networkproxy/hostagent_launch_windows.go
@@ -0,0 +1,346 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os/exec"
+	"runtime"
+	"strconv"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"golang.org/x/sys/windows"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+// StartHostagent starts the existing command EXACTLY ONCE. Preparation failure
+// omits the proxy binding; NAT/DNS/bridge/VM launch proceeds normally. A failure
+// of cmd.Start itself is never retried. No management API transaction occurs.
+func StartHostagent(ctx context.Context, cmd *exec.Cmd, serving *ServingIdentity, owner *app.App, vm *lima.LimaVM, root ManagementInstanceRoot) (bool, error) {
+	observation, err := StartHostagentObserved(ctx, cmd, serving, owner, vm, root)
+	return observation != nil, err
+}
+
+// StartHostagentObserved never retries Start, including when the child started
+// successfully but native observation failed. Missing receipt degrades only
+// proxy policy. The existing watcher remains the sole process reaper.
+func StartHostagentObserved(ctx context.Context, cmd *exec.Cmd, serving *ServingIdentity, owner *app.App, vm *lima.LimaVM, root ManagementInstanceRoot) (*lima.NetworkProxyLaunchObservation, error) {
+	if cmd == nil {
+		return nil, ErrManagement
+	}
+	if cmd.SysProcAttr != nil && (len(cmd.SysProcAttr.AdditionalInheritedHandles) != 0 || cmd.SysProcAttr.NoInheritHandles || cmd.SysProcAttr.ParentProcess != 0) {
+		return nil, cmd.Start()
+	}
+	transfer, metadata, err := prepareHostagentTransfer(ctx, serving, owner, vm, root)
+	if err != nil {
+		return nil, cmd.Start()
+	}
+	defer transfer.Close()
+	if ctx.Err() != nil {
+		return nil, cmd.Start()
+	}
+	bound := false
+	err = transfer.Start(func(raw uintptr, id managementconfig.AnchorIdentity) error {
+		metadata.Handle = uint64(raw)
+		metadata.Volume = id.Volume
+		metadata.IndexHigh = id.IndexHigh
+		metadata.IndexLow = id.IndexLow
+		argument, err := encodeHostagentLaunch(metadata)
+		if err != nil {
+			return cmd.Start()
+		}
+		if cmd.SysProcAttr == nil {
+			cmd.SysProcAttr = &windows.SysProcAttr{}
+		}
+		// Preserve process-group flags. An unexpected existing inheritance list
+		// refuses preparation rather than widening the child's capabilities.
+		cmd.SysProcAttr.AdditionalInheritedHandles = []syscall.Handle{syscall.Handle(raw)}
+		cmd.Args = append(cmd.Args, "--orbwin-proxy-binding", argument)
+		err = cmd.Start()
+		bound = err == nil
+		return err
+	})
+	if err != nil || !bound || cmd.Process == nil {
+		return nil, err
+	}
+	process, probeErr := observeManagementPID(uint32(cmd.Process.Pid))
+	if probeErr != nil || process.Session != metadata.Session || ctx.Err() != nil {
+		return nil, nil
+	}
+	return &lima.NetworkProxyLaunchObservation{AppUID: metadata.AppUID, LimaVMUID: metadata.LimaUID, HostPID: int64(process.PID), HostCreationTime: process.CreationTime, TransportEpoch: metadata.Epoch, Session: process.Session}, nil
+}
+
+func prepareHostagentTransfer(ctx context.Context, serving *ServingIdentity, owner *app.App, vm *lima.LimaVM, root ManagementInstanceRoot) (managementconfig.LaunchAnchor, hostagentLaunch, error) {
+	var empty hostagentLaunch
+	if ctx == nil || ctx.Err() != nil || serving == nil || root.Suffix != "orbwin" {
+		return nil, empty, ErrManagement
+	}
+	parent, err := CurrentManagementProcess()
+	if err != nil {
+		return nil, empty, ErrManagement
+	}
+	var epoch [16]byte
+	if _, err := rand.Read(epoch[:]); err != nil {
+		return nil, empty, ErrManagement
+	}
+	metadata, err := serving.launch(owner, vm, parent, hex.EncodeToString(epoch[:]))
+	if err != nil {
+		return nil, empty, err
+	}
+	if serving.anchorFactory == nil {
+		return nil, empty, ErrManagement
+	}
+	transfer, err := serving.anchorFactory()
+	if err != nil {
+		return nil, empty, ErrManagement
+	}
+	return transfer, metadata, nil
+}
+
+// HostagentManagement owns only proxy resources, never the engine/networking.
+// This initial source integration constructs the pinned client without API I/O.
+// The existing authenticated consumer/supervisor is the next integration slice.
+type HostagentManagement struct {
+	session                     uint32
+	Client                      *ManagementClient
+	Binding                     app.NetworkProxyBinding
+	anchor                      *managementconfig.ReceivedAnchor
+	service                     managementconfig.ServiceGeneration
+	consumerCreated             atomic.Bool
+	credentialRetirementUnknown bool // Sole Run source, latched on failed native cleanup.
+}
+
+func (h *HostagentManagement) Close() {
+	if h != nil {
+		if h.Client != nil {
+			h.Client.Close()
+		}
+		if h.anchor != nil {
+			h.anchor.Close()
+		}
+	}
+}
+func (*HostagentManagement) String() string   { return "private hostagent management" }
+func (*HostagentManagement) GoString() string { return "private hostagent management" }
+
+func OpenHostagentManagement(ctx context.Context, argument string) (*HostagentManagement, error) {
+	metadata, err := parseHostagentLaunch(argument)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	if uint64(uintptr(metadata.Handle)) != metadata.Handle {
+		return nil, ErrManagement
+	}
+	// From the closed reviewed launch schema only, never a renderer handle.
+	anchor, err := managementconfig.ConsumeInheritedAnchor(uintptr(metadata.Handle), managementconfig.AnchorIdentity{Volume: metadata.Volume, IndexHigh: metadata.IndexHigh, IndexLow: metadata.IndexLow})
+	if err != nil {
+		return nil, ErrManagement
+	}
+	ok := false
+	defer func() {
+		if !ok {
+			anchor.Close()
+		}
+	}()
+	if ctx == nil || ctx.Err() != nil {
+		return nil, ErrManagement
+	}
+	if verifyInitialLauncher(metadata) != nil {
+		return nil, ErrManagement
+	}
+	self, err := CurrentManagementProcess()
+	if err != nil {
+		return nil, ErrManagement
+	}
+	observed := app.NetworkProxyBinding{LimaVMUID: metadata.LimaUID, HostPID: int64(self.PID), HostCreationTime: self.CreationTime, TransportEpoch: metadata.Epoch}
+	var digest [32]byte
+	decoded, err := hex.DecodeString(metadata.Certificate)
+	if err != nil || len(decoded) != len(digest) {
+		return nil, ErrManagement
+	}
+	copy(digest[:], decoded)
+	selected := &SelectedManagementInstance{binding: ManagementBinding{InstanceID: "orbwin", AppUID: types.UID(metadata.AppUID)}, native: observed, endpoint: metadata.Endpoint, certificate: digest}
+	reader, generation, err := anchor.OpenGenerationReader(ctx)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	creation, parseErr := strconv.ParseUint(metadata.ParentCreation, 16, 64)
+	if parseErr != nil || generation.Serving.PID != metadata.ParentPID || generation.Serving.Creation != creation || generation.Serving.Session != metadata.Session || generation.Serving.Endpoint != metadata.Endpoint || generation.Serving.Certificate != digest {
+		reader.Close()
+		return nil, ErrManagement
+	}
+	image, imageErr := managementconfig.ObserveServiceImage(ctx, generation.Serving)
+	if imageErr != nil || image != generation.Image {
+		reader.Close()
+		return nil, ErrManagement
+	}
+	client, err := LoadSelectedManagementClient(reader, selected, observed)
+	closeErr := reader.Close()
+	if err != nil || closeErr != nil || ctx.Err() != nil {
+		if client != nil {
+			client.Close()
+		}
+		return nil, ErrManagement
+	}
+	ok = true
+	return &HostagentManagement{Client: client, Binding: observed, anchor: anchor, session: self.Session, service: generation}, nil
+}
+
+func (h *HostagentManagement) NewPolicyConsumer(ctx context.Context) (*PolicyConsumer, error) {
+	if h == nil || h.Client == nil || h.Client.selected == nil || !h.consumerCreated.CompareAndSwap(false, true) {
+		return nil, ErrManagement
+	}
+	expected := h.Client.selected.native
+	owner := GenerationOwner{AppUID: string(h.Client.binding.AppUID), Binding: expected}
+	observe := func(probe context.Context) (GenerationOwner, error) {
+		if probe == nil || probe.Err() != nil {
+			return GenerationOwner{}, ErrProxyOwner
+		}
+		current, err := CurrentManagementProcess()
+		if err != nil || current.Session != h.session || !matchesManagementProcess(expected, current) || h.Binding != expected {
+			return GenerationOwner{}, ErrProxyOwner
+		}
+		return owner, nil
+	}
+	factory, prepare, err := NewBoundedAutoProvider(NativeManagementIdentity{PID: uint32(expected.HostPID), CreationTime: expected.HostCreationTime, Session: h.session}, h.service.Image)
+	if err != nil {
+		return nil, ErrManagement
+	}
+	return NewPolicyConsumerWithPreparation(ctx, h, owner, observe, factory, prepare)
+}
+
+// Sole PolicyConsumer source: requests are serialized by Run. The existing
+// hostagent owner joins Run before Close, including retirement failure. A new
+// transport is admitted only after the old watch/request positively retires.
+func (h *HostagentManagement) ReadApp(ctx context.Context) (*app.App, error) {
+	return h.Client.ReadApp(ctx)
+}
+func (h *HostagentManagement) WatchApp(ctx context.Context, rv string) (watch.Interface, error) {
+	return h.Client.WatchApp(ctx, rv)
+}
+func (h *HostagentManagement) WriteHostObservation(ctx context.Context, owner *app.App, status *app.NetworkProxyHostStatus, binding app.NetworkProxyBinding) error {
+	return h.Client.WriteHostObservation(ctx, owner, status, binding)
+}
+
+func (h *HostagentManagement) RefreshCredentials(ctx context.Context) (result error) {
+	if h == nil || h.Client == nil || h.anchor == nil || h.Client.selected == nil || ctx == nil || ctx.Err() != nil {
+		return ErrManagement
+	}
+	if h.credentialRetirementUnknown {
+		return ErrProxyRetirement
+	}
+	self, err := CurrentManagementProcess()
+	if err != nil || self.Session != h.session || !matchesManagementProcess(h.Binding, self) {
+		return ErrProxyOwner
+	}
+	reader, generation, err := h.anchor.OpenGenerationReader(ctx)
+	if err != nil {
+		var failure *managementconfig.Failure
+		if errors.As(err, &failure) && failure.CleanupUnknown {
+			h.credentialRetirementUnknown = true
+			return ErrProxyRetirement
+		}
+		return ErrManagement
+	}
+	defer func() {
+		if reader.Close() != nil {
+			h.credentialRetirementUnknown = true
+			result = ErrProxyRetirement
+		}
+	}()
+	if err := validateManagementRefresh(h.service, generation, h.session); err != nil {
+		return err
+	}
+	image, err := managementconfig.ObserveServiceImage(ctx, generation.Serving)
+	if err != nil {
+		return ErrManagement
+	}
+	if image != h.service.Image {
+		return ErrProxyOwner
+	}
+	client, err := LoadSelectedManagementClient(reader, h.Client.selected, h.Binding)
+	if err != nil || ctx.Err() != nil {
+		if client != nil {
+			client.Close()
+		}
+		return ErrManagement
+	}
+	if reader.Close() != nil {
+		client.Close()
+		h.credentialRetirementUnknown = true
+		return ErrProxyRetirement
+	}
+	old := h.Client
+	h.Client, h.service = client, generation
+	old.Close()
+	return nil
+}
+
+func RetireHostagentLaunch(argument string) {
+	m, err := parseHostagentLaunch(argument)
+	if err != nil || uint64(uintptr(m.Handle)) != m.Handle {
+		return
+	}
+	anchor, err := managementconfig.ConsumeInheritedAnchor(uintptr(m.Handle), managementconfig.AnchorIdentity{Volume: m.Volume, IndexHigh: m.IndexHigh, IndexLow: m.IndexLow})
+	if err == nil {
+		anchor.Close()
+	}
+}
+
+// Initial-only relationship check: the current process really names this live
+// parent, and native creation/SID/session all match. Same-user processes remain
+// trusted; the parent attribute is not cryptographic authentication against the
+// account itself. No later API reconnect checks dead-parent liveness.
+func verifyInitialLauncher(metadata hostagentLaunch) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	selfProcess, selfToken, sid, self, err := nativeManagementProcess()
+	if err != nil {
+		return ErrManagement
+	}
+	defer windows.CloseHandle(selfProcess)
+	defer selfToken.Close()
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(windows.CurrentProcess(), 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || basic.UniqueProcessId != uintptr(self.PID) || basic.InheritedFromUniqueProcessId != uintptr(metadata.ParentPID) || self.Session != metadata.Session {
+		return ErrManagement
+	}
+	parent, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, metadata.ParentPID)
+	if err != nil {
+		return ErrManagement
+	}
+	defer windows.CloseHandle(parent)
+	var creation, exit, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(parent, &creation, &exit, &kernel, &user) != nil || fmt.Sprintf("%016x", uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime)) != metadata.ParentCreation || windows.ProcessIdToSessionId(metadata.ParentPID, &session) != nil || session != self.Session || session == 0 {
+		return ErrManagement
+	}
+	var token windows.Token
+	if windows.OpenProcessToken(parent, windows.TOKEN_QUERY, &token) != nil {
+		return ErrManagement
+	}
+	defer token.Close()
+	owner, err := token.GetTokenUser()
+	if err != nil || owner.User.Sid.String() != sid {
+		return ErrManagement
+	}
+	var tokenSession, tokenSize uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&tokenSession)), 4, &tokenSize) != nil || tokenSize != 4 || tokenSession != session {
+		return ErrManagement
+	}
+	state, err := windows.WaitForSingleObject(parent, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return ErrManagement
+	}
+	return nil
+}
