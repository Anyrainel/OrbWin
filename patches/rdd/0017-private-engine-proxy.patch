+)
+
+func selectionFixture() (*app.App, *lima.LimaVM, app.NetworkProxyBinding) {
+	yes := true
+	a := &app.App{ObjectMeta: metav1.ObjectMeta{Name: "app", UID: "app-one", ResourceVersion: "1"}}
+	v := &lima.LimaVM{ObjectMeta: metav1.ObjectMeta{Name: "app", Namespace: a.GetResourceNamespace(), UID: "lima-one", ResourceVersion: "2", OwnerReferences: []metav1.OwnerReference{{APIVersion: app.GroupVersion.String(), Kind: "App", Name: "app", UID: "app-one", Controller: &yes}}}}
+	b := app.NetworkProxyBinding{LimaVMUID: "lima-one", HostPID: 123, HostCreationTime: "0000000000000012", TransportEpoch: "00000000000000000000000000000001"}
+	return a, v, b
+}
+
+func TestSelectedOwnershipUsesDerivedNamespacedLimaNotClusterScope(t *testing.T) {
+	a, v, _ := selectionFixture()
+	if !validSelectedOwners(a, v) {
+		t.Fatal("default namespaced Lima ownership refused")
+	}
+	v.Namespace = ""
+	if validSelectedOwners(a, v) {
+		t.Fatal("cluster-scoped Lima accepted")
+	}
+	a.Spec.Namespace = "owned-custom"
+	v.Namespace = "default"
+	if validSelectedOwners(a, v) {
+		t.Fatal("cross-selected namespace accepted")
+	}
+	v.Namespace = a.GetResourceNamespace()
+	if !validSelectedOwners(a, v) {
+		t.Fatal("explicit owned namespace refused")
+	}
+}
+
+func TestSelectedManagementRefusesCircularConfigAuthorityBeforeNetwork(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewTLSServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { calls.Add(1) }))
+	defer server.Close()
+	a, v, b := selectionFixture()
+	certificate := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw})
+	selected, err := SelectManagementInstance("orbwin", a, v, b, server.URL, certificate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Selection owns values, not caller object/slice pointers.
+	a.UID = "later-app"
+	v.UID = "later-lima"
+	clear(certificate)
+	load := func(c map[string]any, observed app.NetworkProxyBinding) (*ManagementClient, error) {
+		data, err := json.Marshal(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return LoadSelectedManagementClient(bytes.NewReader(data), selected, observed)
+	}
+	client, err := load(managementFixture(t, server), b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.Close()
+	for _, mutate := range []func(map[string]any){
+		func(c map[string]any) {
+			c["clusters"].([]any)[0].(map[string]any)["cluster"].(map[string]any)["server"] = "https://127.0.0.1:1"
+		},
+		func(c map[string]any) {
+			cluster := c["clusters"].([]any)[0].(map[string]any)["cluster"].(map[string]any)
+			ca := cluster["certificate-authority-data"].([]byte)
+			cluster["certificate-authority-data"] = append(append([]byte{}, ca...), ca...)
+		},
+		func(c map[string]any) {
+			cluster := c["clusters"].([]any)[0].(map[string]any)["cluster"].(map[string]any)
+			cluster["certificate-authority-data"] = append([]byte("ignored prefix\n"), cluster["certificate-authority-data"].([]byte)...)
+		},
+	} {
+		c := managementFixture(t, server)
+		mutate(c)
+		if cl, e := load(c, b); e != ErrManagement || cl != nil {
+			t.Fatal("untrusted authority accepted")
+		}
+	}
+	stale := b
+	stale.HostCreationTime = "0000000000000013"
+	if cl, e := load(managementFixture(t, server), stale); e != ErrManagement || cl != nil {
+		t.Fatal("PID reuse accepted")
+	}
+	if calls.Load() != 0 {
+		t.Fatal("construction contacted a server")
+	}
+}
+
+func TestSelectedManagementAppLimaOwnershipAndScope(t *testing.T) {
+	s := httptest.NewTLSServer(http.NotFoundHandler())
+	defer s.Close()
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: s.Certificate().Raw})
+	for _, mutate := range []func(*app.App, *lima.LimaVM, *app.NetworkProxyBinding){
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) { a.UID = "other" },
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) { v.OwnerReferences = nil },
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) {
+			v.OwnerReferences = append(v.OwnerReferences, v.OwnerReferences[0])
+		},
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) {
+			v.OwnerReferences[0].APIVersion = "unrelated/v1"
+		},
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) { v.Namespace = "other" },
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) { a.ResourceVersion = "" },
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) {
+			now := metav1.Now()
+			v.DeletionTimestamp = &now
+		},
+		func(a *app.App, v *lima.LimaVM, b *app.NetworkProxyBinding) { b.LimaVMUID = "other" },
+	} {
+		a, v, b := selectionFixture()
+		mutate(a, v, &b)
+		if selected, e := SelectManagementInstance("orbwin", a, v, b, s.URL, cert); e != ErrManagement || selected != nil {
+			t.Fatal("stale owner accepted")
+		}
+	}
+	a, v, b := selectionFixture()
+	for _, endpoint := range []string{"https://localhost:443", "https://127.0.0.1:00443", "https://127.0.0.1:443/", "https://127.0.0.1:443#", "https://user@127.0.0.1:443", "http://127.0.0.1:443"} {
+		if _, e := SelectManagementInstance("orbwin", a, v, b, endpoint, cert); e != ErrManagement {
+			t.Fatal("noncanonical authority")
+		}
+	}
+}
diff --git a/rdd/pkg/networkproxy/server.go b/rdd/pkg/networkproxy/server.go
new file mode 100644
index 0000000..25029e0
--- /dev/null
+++ b/rdd/pkg/networkproxy/server.go
@@ -0,0 +1,398 @@
+package networkproxy
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+)
+
+// HalfConnection matches the existing socketbridge.Pipe contract. The upstream
+// caller supplies that implementation, rather than creating a second duplex pump.
+type HalfConnection interface {
+	net.Conn
+	CloseWrite() error
+}
+type Duplex func(HalfConnection, HalfConnection) error
+
+// ServeForwardProxy takes ownership of a retained private virtual-network
+// listener. It never binds, captures settings, retries a server, or mutates policy.
+// peer is admission scope, NOT cryptographic guest/container authentication.
+// All accepted sockets, including header reads and CONNECT establishment, count
+// toward the fixed 64-operation bound. Returning closes and joins every handler.
+// A native provider's synchronous calls still require its external process bound.
+func ServeForwardProxy(parent context.Context, listener net.Listener, peer netip.Addr, policy *Policy, duplex Duplex) error {
+	return serveForwardProxy(parent, listener, peer, policy, nil, duplex)
+}
+
+func ServeGenerationForwardProxy(parent context.Context, listener net.Listener, peer netip.Addr, supervisor *PolicyGenerationSupervisor, duplex Duplex) error {
+	return serveForwardProxy(parent, listener, peer, nil, supervisor, duplex)
+}
+
+func serveForwardProxy(parent context.Context, listener net.Listener, peer netip.Addr, policy *Policy, supervisor *PolicyGenerationSupervisor, duplex Duplex) error {
+	if parent == nil || listener == nil || policy == nil && supervisor == nil || duplex == nil || !peer.IsValid() || peer.IsUnspecified() || peer.IsMulticast() || peer.Zone() != "" {
+		if listener != nil {
+			listener.Close()
+		}
+		return errors.New("private proxy owner inputs required")
+	}
+	ctx, cancel := context.WithCancel(parent)
+	var mutex sync.Mutex
+	connections := map[net.Conn]bool{}
+	var handlers sync.WaitGroup
+	stopped := make(chan struct{})
+	go func() {
+		defer close(stopped)
+		<-ctx.Done()
+		listener.Close()
+		mutex.Lock()
+		owned := make([]net.Conn, 0, len(connections))
+		for connection := range connections {
+			owned = append(owned, connection)
+		}
+		mutex.Unlock()
+		for _, connection := range owned {
+			connection.Close()
+		}
+	}()
+	defer func() { cancel(); <-stopped; handlers.Wait() }()
+	for {
+		connection, err := listener.Accept()
+		if err != nil {
+			if ctx.Err() != nil {
+				return nil
+			}
+			return errors.New("private proxy listener failed")
+		}
+		host, _, err := net.SplitHostPort(connection.RemoteAddr().String())
+		address, parseErr := netip.ParseAddr(host)
+		mutex.Lock()
+		if err != nil || parseErr != nil || address != peer || ctx.Err() != nil || len(connections) >= 64 {
+			mutex.Unlock()
+			connection.Close()
+			continue
+		}
+		connections[connection] = true
+		handlers.Add(1)
+		mutex.Unlock()
+		go func() {
+			defer handlers.Done()
+			requestContext, stopRequest := context.WithCancel(ctx)
+			defer stopRequest()
+			defer func() { connection.Close(); mutex.Lock(); delete(connections, connection); mutex.Unlock() }()
+			admitted := policy
+			if supervisor != nil {
+				lease, err := supervisor.Acquire(requestContext, func() { connection.Close() })
+				if err != nil {
+					return
+				}
+				defer func() {
+					connection.Close()
+					cleanup, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+					defer cancel()
+					_ = lease.Release(cleanup)
+				}()
+				admitted = lease.Policy()
+				requestContext = lease.Context()
+			}
+			serveProxyConnection(requestContext, connection, admitted, duplex)
+		}()
+	}
+}
+
+// Reject framing ambiguity BEFORE net/http normalizes duplicate CL or TE+CL.
+// One request per connection simplifies upstream transport ownership and avoids
+// pipelined requests inheriting a policy/admission decision from another request.
+func readProxyRequest(connection net.Conn) (*http.Request, *bufio.Reader, string, error) {
+	if connection.SetReadDeadline(time.Now().Add(10*time.Second)) != nil {
+		return nil, nil, "", errors.New("proxy header deadline unavailable")
+	}
+	reader := bufio.NewReaderSize(connection, 16<<10)
+	var raw bytes.Buffer
+	host := ""
+	cl, te := false, false
+	expect, upgrade, trailer := false, false, false
+	for lines := 0; ; lines++ {
+		line, err := reader.ReadSlice('\n')
+		if err != nil || len(line) < 2 || !bytes.HasSuffix(line, []byte("\r\n")) || raw.Len()+len(line) > 16<<10 || lines > 128 {
+			return nil, nil, "", errors.New("invalid proxy headers")
+		}
+		raw.Write(line)
+		if lines == 0 {
+			continue
+		}
+		if len(line) == 2 {
+			break
+		}
+		if line[0] == ' ' || line[0] == '\t' {
+			return nil, nil, "", errors.New("folded proxy headers refused")
+		}
+		field, value, ok := strings.Cut(string(line[:len(line)-2]), ":")
+		if !ok || !validHeaderToken(field) {
+			return nil, nil, "", errors.New("invalid proxy header field")
+		}
+		value = strings.TrimSpace(value)
+		switch strings.ToLower(field) {
+		case "host":
+			if host != "" || value == "" {
+				return nil, nil, "", errors.New("ambiguous proxy host")
+			}
+			host = value
+		case "content-length":
+			if cl || te || value == "" {
+				return nil, nil, "", errors.New("ambiguous proxy framing")
+			}
+			cl = true
+			for _, character := range value {
+				if character < '0' || character > '9' {
+					return nil, nil, "", errors.New("invalid proxy length")
+				}
+			}
+		case "transfer-encoding":
+			if te || cl || value != "chunked" {
+				return nil, nil, "", errors.New("ambiguous proxy framing")
+			}
+			te = true
+		case "expect":
+			if expect || !strings.EqualFold(value, "100-continue") {
+				return nil, nil, "", errors.New("unsupported proxy expectation")
+			}
+			expect = true
+		case "upgrade":
+			if upgrade || !strings.EqualFold(value, "websocket") {
+				return nil, nil, "", errors.New("unsupported proxy upgrade")
+			}
+			upgrade = true
+		case "trailer":
+			if trailer {
+				return nil, nil, "", errors.New("duplicate proxy trailer declaration")
+			}
+			trailer = true
+			seen := map[string]bool{}
+			for _, name := range strings.Split(value, ",") {
+				name = strings.TrimSpace(name)
+				if !validTrailerName(name) || seen[strings.ToLower(name)] || len(seen) >= 16 {
+					return nil, nil, "", errors.New("unsafe proxy trailer declaration")
+				}
+				seen[strings.ToLower(name)] = true
+			}
+		case "connection":
+			for _, token := range strings.Split(value, ",") {
+				token = strings.TrimSpace(token)
+				if !validHeaderToken(token) {
+					return nil, nil, "", errors.New("invalid connection token")
+				}
+				switch strings.ToLower(token) {
+				case "host", "content-length", "transfer-encoding", "trailer", "expect":
+					return nil, nil, "", errors.New("connection framing nomination refused")
+				}
+			}
+		}
+	}
+	requestReader := bufio.NewReader(io.MultiReader(bytes.NewReader(raw.Bytes()), reader))
+	request, err := http.ReadRequest(requestReader)
+	if err != nil || host == "" || trailer && !te {
+		return nil, nil, "", errors.New("invalid proxy request")
+	}
+	if validateTrailerDeclaration(request.Header, request.Trailer) != nil {
+		return nil, nil, "", errors.New("invalid proxy trailer declaration")
+	}
+	if connection.SetReadDeadline(time.Time{}) != nil {
+		return nil, nil, "", errors.New("proxy stream deadline unavailable")
+	}
+	return request, requestReader, host, nil
+}
+
+func validHeaderToken(value string) bool {
+	if value == "" {
+		return false
+	}
+	for _, c := range value {
+		if c > 127 || !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("!#$%&'*+-.^_`|~", c)) {
+			return false
+		}
+	}
+	return true
+}
+func stripHopHeaders(header http.Header) {
+	for _, value := range header.Values("Connection") {
+		for _, field := range strings.Split(value, ",") {
+			header.Del(strings.TrimSpace(field))
+		}
+	}
+	for _, field := range []string{"Connection", "Proxy-Connection", "Keep-Alive", "TE", "Trailer", "Transfer-Encoding", "Upgrade", "Proxy-Authorization", "Proxy-Authenticate"} {
+		header.Del(field)
+	}
+}
+func canonicalServerTarget(target *url.URL) (*url.URL, error) {
+	if validateTarget(target) != nil {
+		return nil, errors.New("invalid proxy destination")
+	}
+	result := *target
+	host := strings.ToLower(target.Hostname())
+	if address, err := netip.ParseAddr(host); err == nil {
+		host = address.String()
+	}
+	if target.Port() != "" {
+		host = net.JoinHostPort(host, target.Port())
+	} else if strings.Contains(host, ":") {
+		host = "[" + host + "]"
+	}
+	result.Host = host
+	return &result, nil
+}
+
+type bufferedProxyConnection struct {
+	net.Conn
+	reader *bufio.Reader
+}
+
+func (connection bufferedProxyConnection) Read(buffer []byte) (int, error) {
+	return connection.reader.Read(buffer)
+}
+func (connection bufferedProxyConnection) CloseWrite() error {
+	return connection.Conn.(interface{ CloseWrite() error }).CloseWrite()
+}
+
+func serveProxyConnection(ctx context.Context, connection net.Conn, policy *Policy, duplex Duplex) {
+	refuse := func(status string) {
+		if connection.SetWriteDeadline(time.Now().Add(time.Second)) != nil {
+			return
+		}
+		io.WriteString(connection, "HTTP/1.1 "+status+"\r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
+	}
+	request, reader, rawHost, err := readProxyRequest(connection)
+	if err != nil {
+		refuse("400 Bad Request")
+		return
+	}
+	parsedRequest := request
+	originalBody := request.Body
+	defer func() { connection.Close(); originalBody.Close() }()
+	request = request.WithContext(ctx)
+	if request.Trailer == nil {
+		request.Trailer = make(http.Header)
+	}
+	request.Body = &streamedTrailerBody{ReadCloser: nondrainingBody{originalBody}, source: func() http.Header { return parsedRequest.Trailer }, declared: request.Trailer.Clone(), destination: request.Trailer}
+	if request.ProtoMajor != 1 || request.ProtoMinor > 1 {
+		refuse("400 Bad Request")
+		return
+	}
+	if request.Method == "CONNECT" {
+		target, err := canonicalServerTarget(&url.URL{Scheme: "https", Host: request.RequestURI})
+		if err != nil || target.Port() == "" || request.URL.Host != request.RequestURI || rawHost != request.RequestURI || request.ContentLength != 0 || len(request.TransferEncoding) != 0 {
+			refuse("400 Bad Request")
+			return
+		}
+		if _, ok := connection.(interface{ CloseWrite() error }); !ok {
+			refuse("501 Not Implemented")
+			return
+		}
+		upstream, err := policy.DialTunnel(ctx, target.Host)
+		if err != nil {
+			refuse("502 Bad Gateway")
+			return
+		}
+		defer upstream.Close()
+		half, ok := upstream.(HalfConnection)
+		if !ok {
+			refuse("502 Bad Gateway")
+			return
+		}
+		if _, err := io.WriteString(connection, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
+			return
+		}
+		duplex(bufferedProxyConnection{connection, reader}, half)
+		return
+	}
+	if request.URL.Scheme == "ws" {
+		if !strings.EqualFold(request.Header.Get("Upgrade"), "websocket") {
+			refuse("400 Bad Request")
+			return
+		}
+		mapped := *request.URL
+		mapped.Scheme = "http"
+		request.URL = &mapped
+	}
+	target, err := canonicalServerTarget(request.URL)
+	hostTarget, hostErr := url.Parse("http://" + rawHost)
+	if hostErr == nil {
+		hostTarget, hostErr = canonicalServerTarget(hostTarget)
+	}
+	if err != nil || target.Scheme != "http" || !request.URL.IsAbs() || hostErr != nil || hostTarget.Host != target.Host || hostTarget.Path != "" || hostTarget.RawQuery != "" {
+		refuse("400 Bad Request")
+		return
+	}
+	request.URL, request.Host = target, target.Host
+	if request.Header.Get("Upgrade") != "" {
+		if request.Header.Get("Expect") != "" || !validWebSocketRequest(request) {
+			refuse("400 Bad Request")
+			return
+		}
+		if _, ok := connection.(interface{ CloseWrite() error }); !ok {
+			refuse("501 Not Implemented")
+			return
+		}
+		upstream, response, err := policy.openWebSocket(ctx, request)
+		if err != nil {
+			refuse("502 Bad Gateway")
+			return
+		}
+		defer upstream.Close()
+		if response.Write(connection) != nil {
+			return
+		}
+		duplex(bufferedProxyConnection{connection, reader}, upstream.(HalfConnection))
+		return
+	}
+	routes, err := policy.Decide(ctx, target)
+	if err != nil {
+		refuse("502 Bad Gateway")
+		return
+	}
+	if request.Header.Get("Expect") != "" {
+		if request.ProtoMinor != 1 || request.ContentLength == 0 {
+			refuse("417 Expectation Failed")
+			return
+		}
+		if connection.SetWriteDeadline(time.Now().Add(time.Second)) != nil {
+			return
+		}
+		if _, err := io.WriteString(connection, "HTTP/1.1 100 Continue\r\n\r\n"); err != nil {
+			return
+		}
+		if connection.SetWriteDeadline(time.Time{}) != nil {
+			return
+		}
+		request.Header.Del("Expect")
+	}
+	stripHopHeaders(request.Header)
+	request.Close = true
+	response, err := policy.roundTripHTTP(request, routes)
+	if err != nil {
+		refuse("502 Bad Gateway")
+		return
+	}
+	defer response.Body.Close()
+	if response.StatusCode == 101 {
+		refuse("502 Bad Gateway")
+		return
+	}
+	if validateTrailerDeclaration(response.Header, response.Trailer) != nil || response.Header.Get("Trailer") != "" {
+		refuse("502 Bad Gateway")
+		return
+	}
+	stripHopHeaders(response.Header)
+	originalResponse := response
+	response.Body = &streamedTrailerBody{ReadCloser: response.Body, source: func() http.Header { return originalResponse.Trailer }, declared: response.Trailer.Clone(), destination: response.Trailer}
+	response.Close = true
+	response.Write(connection)
+}
diff --git a/rdd/pkg/networkproxy/server_compat.go b/rdd/pkg/networkproxy/server_compat.go
new file mode 100644
index 0000000..dcb5b8e
--- /dev/null
+++ b/rdd/pkg/networkproxy/server_compat.go
@@ -0,0 +1,235 @@
+package networkproxy
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha1"
+	"crypto/tls"
+	"encoding/base64"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+)
+
+func validTrailerName(name string) bool {
+	if !validHeaderToken(name) {
+		return false
+	}
+	switch strings.ToLower(name) {
+	case "host", "content-length", "transfer-encoding", "trailer", "connection", "proxy-connection", "keep-alive", "te", "upgrade", "expect", "authorization", "proxy-authorization", "proxy-authenticate", "cookie", "set-cookie":
+		return false
+	}
+	return true
+}
+func validateTrailerDeclaration(header, declared http.Header) error {
+	if len(declared) > 16 {
+		return errors.New("proxy trailer declaration exceeds bounds")
+	}
+	for name := range declared {
+		if !validTrailerName(name) {
+			return errors.New("unsafe proxy trailer declaration")
+		}
+		for _, value := range header.Values("Connection") {
+			for _, field := range strings.Split(value, ",") {
+				if strings.EqualFold(name, strings.TrimSpace(field)) {
+					return errors.New("hop trailer declaration refused")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// No full body buffer. Validate actual trailers at EOF before the outgoing
+// writer emits its final chunk, so invalid/undeclared trailers truncate rather
+// than create an apparently complete successful message. Only the body's reader
+// mutates destination; the transport's writer reads it after this EOF.
+type streamedTrailerBody struct {
+	io.ReadCloser
+	source                func() http.Header
+	declared, destination http.Header
+}
+
+func (body *streamedTrailerBody) Close() error {
+	if body.ReadCloser != nil {
+		return body.ReadCloser.Close()
+	}
+	return nil
+}
+func (body *streamedTrailerBody) Read(buffer []byte) (int, error) {
+	if body.ReadCloser == nil {
+		return 0, io.EOF
+	}
+	count, err := body.ReadCloser.Read(buffer)
+	if err == io.EOF {
+		actual := body.source()
+		size := 0
+		for name, values := range actual {
+			if _, ok := body.declared[name]; !ok || !validTrailerName(name) {
+				return count, errors.New("undeclared or unsafe proxy trailer")
+			}
+			size += len(name)
+			if len(values) > 16 {
+				return count, errors.New("proxy trailer values exceed bounds")
+			}
+			for _, value := range values {
+				size += len(value)
+				for _, c := range value {
+					if c < 32 && c != '\t' || c == 127 {
+						return count, errors.New("invalid proxy trailer value")
+					}
+				}
+			}
+			if size > 4096 {
+				return count, errors.New("proxy trailers exceed bounds")
+			}
+		}
+		copied := actual.Clone()
+		for name := range body.destination {
+			delete(body.destination, name)
+		}
+		for name, values := range copied {
+			body.destination[name] = values
+		}
+	}
+	return count, err
+}
+
+// Transport may close an incoming body before it has been read. net/http's
+// ReadRequest body.Close drains; avoid an unread upload blocking refusal/join.
+// The connection owner closes the socket before closing the original body.
+type nondrainingBody struct{ io.Reader }
+
+func (nondrainingBody) Close() error { return nil }
+func hasHeaderToken(header http.Header, name, token string) bool {
+	for _, value := range header.Values(name) {
+		for _, field := range strings.Split(value, ",") {
+			if strings.EqualFold(strings.TrimSpace(field), token) {
+				return true
+			}
+		}
+	}
+	return false
+}
+func validWebSocketRequest(request *http.Request) bool {
+	key := request.Header.Values("Sec-Websocket-Key")
+	version := request.Header.Values("Sec-Websocket-Version")
+	if request.ProtoMinor != 1 || request.Method != "GET" || request.ContentLength != 0 || len(request.TransferEncoding) != 0 || len(key) != 1 || len(version) != 1 || version[0] != "13" || !strings.EqualFold(request.Header.Get("Upgrade"), "websocket") || len(request.Header.Values("Upgrade")) != 1 || !hasHeaderToken(request.Header, "Connection", "upgrade") {
+		return false
+	}
+	decoded, err := base64.StdEncoding.DecodeString(key[0])
+	return err == nil && len(decoded) == 16
+}
+
+// Only RFC6455 WebSocket upgrades are accepted, never engine tcp/h2c upgrades.
+// One route/one application handshake: no retry after any request bytes escape.
+func (policy *Policy) openWebSocket(ctx context.Context, request *http.Request) (net.Conn, *http.Response, error) {
+	routes, err := policy.Decide(ctx, request.URL)
+	if err != nil {
+		return nil, nil, err
+	}
+	route := routes[0]
+	destination := endpointAddress(request.URL)
+	var proxyTLSHost string
+	if !route.Direct {
+		endpoint, _ := proxyURL(route.Proxy)
+		destination = endpointAddress(endpoint)
+		if endpoint.Scheme == "https" {
+			proxyTLSHost = endpoint.Hostname()
+		}
+	}
+	limited, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	connection, err := (&net.Dialer{Timeout: 5 * time.Second}).DialContext(limited, "tcp", destination)
+	if err != nil {
+		return nil, nil, errors.New("WebSocket proxy connection failed")
+	}
+	success := false
+	defer func() {
+		if !success {
+			connection.Close()
+		}
+	}()
+	raw := connection
+	stop := context.AfterFunc(limited, func() { raw.Close() })
+	defer stop()
+	deadline, _ := limited.Deadline()
+	if connection.SetDeadline(deadline) != nil {
+		return nil, nil, errors.New("WebSocket deadline unavailable")
+	}
+	if proxyTLSHost != "" {
+		secured := tls.Client(connection, &tls.Config{MinVersion: tls.VersionTLS12, ServerName: proxyTLSHost})
+		if secured.HandshakeContext(limited) != nil {
+			return nil, nil, errors.New("HTTPS WebSocket proxy verification failed")
+		}
+		connection = secured
+	}
+	outgoing := request.Clone(limited)
+	outgoing.Body = http.NoBody
+	outgoing.Trailer = nil
+	outgoing.Host = request.URL.Host
+	outgoing.RequestURI = ""
+	outgoing.Close = false
+	stripHopHeaders(outgoing.Header)
+	outgoing.Header.Set("Connection", "Upgrade")
+	outgoing.Header.Set("Upgrade", "websocket")
+	if route.Direct {
+		err = outgoing.Write(connection)
+	} else {
+		err = outgoing.WriteProxy(connection)
+	}
+	if err != nil {
+		return nil, nil, errors.New("WebSocket handshake failed; no replay")
+	}
+	reader := bufio.NewReaderSize(connection, 4096)
+	var rawHeader bytes.Buffer
+	for {
+		line, readErr := reader.ReadSlice('\n')
+		if readErr != nil || rawHeader.Len()+len(line) > 16<<10 || !bytes.HasSuffix(line, []byte("\r\n")) {
+			return nil, nil, errors.New("WebSocket response header refused")
+		}
+		if rawHeader.Len() > 0 && (line[0] == ' ' || line[0] == '\t') {
+			return nil, nil, errors.New("folded WebSocket response refused")
+		}
+		rawHeader.Write(line)
+		if len(line) == 2 {
+			break
+		}
+	}
+	response, err := http.ReadResponse(bufio.NewReader(bytes.NewReader(rawHeader.Bytes())), outgoing)
+	if err != nil {
+		return nil, nil, errors.New("WebSocket response refused")
+	}
+	sum := sha1.Sum([]byte(request.Header.Get("Sec-Websocket-Key") + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
+	for _, line := range strings.Split(rawHeader.String(), "\r\n")[1:] {
+		name, _, _ := strings.Cut(line, ":")
+		if strings.EqualFold(name, "Content-Length") || strings.EqualFold(name, "Transfer-Encoding") {
+			return nil, nil, errors.New("WebSocket response framing refused")
+		}
+	}
+	if response.StatusCode != 101 || !hasHeaderToken(response.Header, "Connection", "upgrade") || !strings.EqualFold(response.Header.Get("Upgrade"), "websocket") || len(response.Header.Values("Upgrade")) != 1 || len(response.Header.Values("Sec-Websocket-Accept")) != 1 || response.Header.Get("Sec-Websocket-Accept") != base64.StdEncoding.EncodeToString(sum[:]) {
+		return nil, nil, errors.New("WebSocket upgrade acknowledgement refused")
+	}
+	if limited.Err() != nil {
+		return nil, nil, errors.New("WebSocket upgrade canceled")
+	}
+	if connection.SetDeadline(time.Time{}) != nil {
+		return nil, nil, errors.New("WebSocket stream deadline unavailable")
+	}
+	stripHopHeaders(response.Header)
+	if response.Header.Get("Sec-Websocket-Accept") == "" {
+		return nil, nil, errors.New("WebSocket acknowledgement nominated as hop header")
+	}
+	response.Header.Set("Connection", "Upgrade")
+	response.Header.Set("Upgrade", "websocket")
+	response.Body = http.NoBody
+	retained := &retainedConn{Conn: connection, reader: reader}
+	final := connection
+	retained.stop = context.AfterFunc(ctx, func() { final.Close() })
+	success = true
+	return retained, response, nil
+}
