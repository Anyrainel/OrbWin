+++ b/rdd/pkg/networkproxy/consumer_retirement_test.go
@@ -0,0 +1,126 @@
+package networkproxy
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+type controlledConsumerWatch struct {
+	events       chan watch.Event
+	stopStarted  chan struct{}
+	releaseStop  chan struct{}
+	stopReturned atomic.Bool
+}
+
+func (w *controlledConsumerWatch) ResultChan() <-chan watch.Event { return w.events }
+func (w *controlledConsumerWatch) Stop() {
+	close(w.stopStarted)
+	<-w.releaseStop
+	w.stopReturned.Store(true)
+}
+
+func TestConsumerRetirementRequiresStopAndDecoderJoin(t *testing.T) {
+	for _, blockStop := range []bool{false, true} {
+		name := "decoder-never-closes"
+		if blockStop {
+			name = "Stop-blocks-after-decoder-closes"
+		}
+		t.Run(name, func(t *testing.T) {
+			w := &controlledConsumerWatch{events: make(chan watch.Event), stopStarted: make(chan struct{}), releaseStop: make(chan struct{})}
+			if blockStop {
+				close(w.events)
+			} else {
+				close(w.releaseStop)
+			}
+			start := time.Now()
+			if stopConsumerWatch(w) {
+				t.Fatal("unknown watch retirement reported success")
+			}
+			if time.Since(start) > 3*time.Second {
+				t.Fatal("Stop or decoder wait escaped retirement bound")
+			}
+			if blockStop {
+				close(w.releaseStop)
+			} else {
+				close(w.events)
+			}
+		})
+	}
+}
+
+func TestConsumerRetirementAcceptsBoundedDrainOnlyAfterBothJoins(t *testing.T) {
+	w := &controlledConsumerWatch{events: make(chan watch.Event, 256), stopStarted: make(chan struct{}), releaseStop: make(chan struct{})}
+	for i := 0; i < 256; i++ {
+		w.events <- watch.Event{Type: watch.Bookmark}
+	}
+	close(w.events)
+	close(w.releaseStop)
+	if !stopConsumerWatch(w) || !w.stopReturned.Load() {
+		t.Fatal("bounded completed drain not accepted")
+	}
+	if stopConsumerWatch(nil) {
+		t.Fatal("missing watch was treated as joined")
+	}
+}
+
+func TestConsumerRetirementUnknown401NeverRefreshesOrOpensReplacement(t *testing.T) {
+	for _, event := range []watch.Event{
+		{Type: watch.Error, Object: &metav1.Status{Code: 401, Reason: metav1.StatusReasonUnauthorized}},
+		{Type: watch.Deleted},
+	} {
+		t.Run(string(event.Type), func(t *testing.T) {
+			a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+			base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8)}
+			w := &controlledConsumerWatch{events: make(chan watch.Event, 1), stopStarted: make(chan struct{}), releaseStop: make(chan struct{})}
+			w.events <- event
+			source := &refreshingConsumerSource{consumerSourceFixture: base, refresh: func(context.Context) error { return nil }}
+			var opens atomic.Int32
+			source.openWatch = func(context.Context, string) (watch.Interface, error) { opens.Add(1); return w, nil }
+			c, cancel, done := startRefreshingConsumer(t, a, source)
+			select {
+			case err := <-done:
+				if err != ErrProxyRetirement {
+					t.Fatalf("unknown retirement hidden: %v", err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("blocked Stop stranded consumer")
+			}
+			close(w.releaseStop)
+			close(w.events)
+			if opens.Load() != 1 || source.refreshes.Load() != 0 || c.Snapshot().ActiveRevision != 0 {
+				t.Fatal("unknown retirement refreshed, replaced watch, or retained admission")
+			}
+			cancel()
+		})
+	}
+}
+
+func TestConsumerRefreshCancellationJoinsWithoutStartingAnotherWatch(t *testing.T) {
+	a := consumerApp(t, "url", "http://127.0.0.1:1", 1, 3, "commit")
+	base := &consumerSourceFixture{current: a.DeepCopy(), watches: make(chan *watch.RaceFreeFakeWatcher, 8), readErr: ErrManagementCredentials}
+	started := make(chan struct{})
+	joined := make(chan struct{})
+	source := &refreshingConsumerSource{consumerSourceFixture: base}
+	source.refresh = func(ctx context.Context) error { close(started); <-ctx.Done(); close(joined); return ErrManagement }
+	_, cancel, done := startRefreshingConsumer(t, a, source)
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("refresh did not start")
+	}
+	cancel()
+	awaitConsumerExit(t, done)
+	select {
+	case <-joined:
+	default:
+		t.Fatal("consumer exited before refresh joined")
+	}
+	if len(base.watches) != 0 || source.refreshes.Load() != 1 {
+		t.Fatal("cancelled refresh admitted replacement watch")
+	}
+}
diff --git a/rdd/pkg/networkproxy/consumer_test.go b/rdd/pkg/networkproxy/consumer_test.go
