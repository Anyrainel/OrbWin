@@ -0,0 +1,53 @@
+package networkproxy
+
+import (
+	"path/filepath"
+	"strings"
+	"unicode/utf16"
+)
+
+// Native registry strings must not be normalized from malformed UTF-16 into
+// replacement characters before selecting an instance identity.
+func guestRegistryText(units []uint16) (string, bool) {
+	for i := 0; i < len(units); i++ {
+		u := units[i]
+		if u == 0 || u >= 0xdc00 && u <= 0xdfff {
+			return "", false
+		}
+		if u >= 0xd800 && u <= 0xdbff {
+			i++
+			if i >= len(units) || units[i] < 0xdc00 || units[i] > 0xdfff {
+				return "", false
+			}
+		}
+	}
+	return string(utf16.Decode(units)), true
+}
+
+// Native WSL stores the import base directory, not hostswitch's Hyper-V VM GUID.
+// Compare only canonical drive paths; no UNC/device/ADS or renderer paths.
+func guestNativePath(value string) (string, bool) {
+	value = strings.TrimPrefix(value, `\\?\`)
+	if len(value) < 3 || value[1] != ':' || value[2] != '\\' || !(value[0] >= 'a' && value[0] <= 'z' || value[0] >= 'A' && value[0] <= 'Z') || strings.ContainsAny(value[2:], ":<>\"|?*/\x00") {
+		return "", false
+	}
+	for _, r := range value {
+		if r < 32 {
+			return "", false
+		}
+	}
+	for _, part := range strings.Split(value[3:], `\`) {
+		if part == "" || part == "." || part == ".." || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") {
+			return "", false
+		}
+	}
+	return filepath.Clean(value), true
+}
+func guestRegistrationValue(guid, name, base, expectedName, expectedBase string, version uint32) bool {
+	if len(guid) != 38 || guid[0] != '{' || guid[37] != '}' || guid[9] != '-' || guid[14] != '-' || guid[19] != '-' || guid[24] != '-' || !hexIdentity(strings.ReplaceAll(strings.ToLower(guid[1:37]), "-", ""), 32) || strings.ReplaceAll(guid[1:37], "-", "") == strings.Repeat("0", 32) || name != expectedName || version != 2 {
+		return false
+	}
+	a, okA := guestNativePath(base)
+	b, okB := guestNativePath(expectedBase)
+	return okA && okB && strings.EqualFold(a, b)
+}
