+	}
+	var internal extensions.JSONSchemaProps
+	if err := extensionsv1.Convert_v1_JSONSchemaProps_To_apiextensions_JSONSchemaProps(&schema, &internal, nil); err != nil {
+		t.Fatal(err)
+	}
+	validator, _, err := schemaValidation.NewSchemaValidator(&internal)
