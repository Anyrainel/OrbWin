@@ -0,0 +1,306 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"math/big"
+	"net"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Only pure functions/fakes below. No native handle, file, listener or user
+// credential API is invoked by TestAuthorityPublication*.
+func publicationFixture(t *testing.T) (ServingBinding, []byte) {
+	t.Helper()
+	key := ed25519.NewKeyFromSeed(make([]byte, ed25519.SeedSize))
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Unix(0, 0), NotAfter: time.Unix(3600, 0), BasicConstraintsValid: true, IsCA: true, KeyUsage: x509.KeyUsageCertSign, IPAddresses: []net.IP{net.IPv4(127, 0, 0, 1)}}
+	der, e := x509.CreateCertificate(strings.NewReader(strings.Repeat("a", 4096)), template, template, key.Public(), key)
+	if e != nil {
+		t.Fatal("fixture certificate")
+	}
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	b, e := BindServing(123, 456, 1, "https://127.0.0.1:6443", cert)
+	if e != nil {
+		t.Fatal("fixture binding")
+	}
+	data, e := json.Marshal(map[string]any{"kind": "Config", "apiVersion": "v1", "preferences": map[string]any{}, "clusters": []any{map[string]any{"name": "root", "cluster": map[string]any{"server": b.Endpoint, "certificate-authority-data": cert}}}, "users": []any{map[string]any{"name": "system-admin", "user": map[string]any{"token": "fresh-test-secret"}}}, "contexts": []any{map[string]any{"name": "root", "context": map[string]any{"cluster": "root", "user": "system-admin"}}}, "current-context": "root"})
+	if e != nil {
+		t.Fatal("fixture document")
+	}
+	return b, data
+}
+
+func TestAuthorityPublicationMaterialRequiresMatchingSeparateIdentities(t *testing.T) {
+	b, data := publicationFixture(t)
+	var document publicationDocument
+	if json.Unmarshal(data, &document) != nil {
+		t.Fatal("fixture decode")
+	}
+	cert := document.Clusters[0].Cluster.CA
+	key := ed25519.NewKeyFromSeed(make([]byte, ed25519.SeedSize))
+	sa := ed25519.NewKeyFromSeed([]byte(strings.Repeat("b", ed25519.SeedSize)))
+	der, e := x509.MarshalPKCS8PrivateKey(key)
+	if e != nil {
+		t.Fatal("fixture key")
+	}
+	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: der})
+	clear(der)
+	der, e = x509.MarshalPKCS8PrivateKey(sa)
+	if e != nil {
+		t.Fatal("fixture signer")
+	}
+	saPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: der})
+	clear(der)
+	if validateAuthorityMaterial(cert, keyPEM, saPEM) != nil {
+		t.Fatal("matching separated authority refused")
+	}
+	for _, fault := range []string{"mismatch", "same-key", "foreign-field", "oversize", "chain"} {
+		t.Run(fault, func(t *testing.T) {
+			c, k, s := cert, keyPEM, saPEM
+			switch fault {
+			case "mismatch":
+				k = saPEM
+			case "same-key":
+				s = keyPEM
+			case "foreign-field":
+				s = []byte("not a private key")
+			case "oversize":
+				k = make([]byte, 65537)
+			case "chain":
+				c = append(append([]byte{}, cert...), cert...)
+			}
+			if validateAuthorityMaterial(c, k, s) == nil {
+				t.Fatal("invalid authority material accepted")
+			}
+		})
+	}
+	if !b.valid() {
+		t.Fatal("fixture binding")
+	}
+}
+
+type publicationFake struct {
+	currentValue    ConfigVersion
+	staged          ConfigVersion
+	calls           []string
+	fault           string
+	counts          map[string]int
+	publishThenFail bool
+	closed          bool
+	enter           chan struct{}
+	release         chan struct{}
+}
+
+func (f *publicationFake) step(name string) error {
+	if f.counts == nil {
+		f.counts = map[string]int{}
+	}
+	f.counts[name]++
+	f.calls = append(f.calls, name)
+	if f.fault == name || f.fault == name+"-"+string(rune('0'+f.counts[name])) {
+		return errors.New("fixed injected failure")
+	}
+	return nil
+}
+func (f *publicationFake) acquire(context.Context) (authorityLease, error) {
+	if f.step("acquire") != nil {
+		return nil, ErrPublication
+	}
+	return f, nil
+}
+func (f *publicationFake) close() error                                { return f.step("close") }
+func (f *publicationFake) check(context.Context, ServingBinding) error { return f.step("check") }
+func (f *publicationFake) current(context.Context) (ConfigVersion, error) {
+	e := f.step("current")
+	return f.currentValue, e
+}
+func (f *publicationFake) stage(ctx context.Context, data []byte) (ConfigVersion, error) {
+	if f.enter != nil {
+		close(f.enter)
+		select {
+		case <-f.release:
+		case <-ctx.Done():
+			return ConfigVersion{}, ErrPublication
+		}
+	}
+	f.staged = ConfigVersion{Present: true, Volume: 1, Low: 20, Hash: sha256.Sum256(data)}
+	return f.staged, f.step("stage")
+}
+func (f *publicationFake) flush(context.Context) error { return f.step("flush") }
+func (f *publicationFake) publish(_ context.Context, replace bool) error {
+	e := f.step("publish")
+	if e == nil || f.publishThenFail {
+		f.currentValue = f.staged
+	}
+	return e
+}
+func (f *publicationFake) verify(_ context.Context, v ConfigVersion) error {
+	if e := f.step("verify"); e != nil {
+		return e
+	}
+	if f.currentValue != v {
+		return ErrPublication
+	}
+	return nil
+}
+
+func TestAuthorityPublicationFailureBoundariesNeverReplay(t *testing.T) {
+	for _, fault := range []string{"acquire", "check-1", "current-1", "stage", "flush", "check-2", "current-2", "publish", "verify", "check-3", "close"} {
+		t.Run(fault, func(t *testing.T) {
+			b, data := publicationFixture(t)
+			before := ConfigVersion{Present: true, Volume: 1, Low: 10, Hash: sha256.Sum256([]byte("old credential"))}
+			f := &publicationFake{currentValue: before, fault: fault}
+			p := &ConfigPublisher{backend: f, serving: b}
+			r, e := p.Publish(context.Background(), before, data)
+			if e == nil {
+				t.Fatal("injected failure acknowledged")
+			}
+			if f.counts["publish"] > 1 {
+				t.Fatal("publication replay")
+			}
+			if f.counts["publish"] == 0 && f.currentValue != before {
+				t.Fatal("pre-admission failure changed predecessor")
+			}
+			if r.Unknown && p.pending == nil {
+				t.Fatal("unknown result did not retain owner slot")
+			}
+			if !r.Unknown && f.counts["verify"] > 0 {
+				t.Fatal("post-rename failure incorrectly settled")
+			}
+		})
+	}
+}
+func TestAuthorityPublicationUnknownNeedsExactReadOnlyReobservation(t *testing.T) {
+	for _, didPublish := range []bool{false, true} {
+		b, data := publicationFixture(t)
+		f := &publicationFake{fault: "publish", publishThenFail: didPublish}
+		p := &ConfigPublisher{backend: f, serving: b}
+		r, e := p.Publish(context.Background(), ConfigVersion{}, data)
+		if e == nil || !r.Unknown {
+			t.Fatal("unknown rename was accepted")
+		}
+		calls := len(f.calls)
+		if _, e = p.Publish(context.Background(), ConfigVersion{}, data); e == nil || len(f.calls) != calls {
+			t.Fatal("unknown owner slot admitted replay")
+		}
+		forged := r
+		forged.Candidate.Low++
+		if _, e = p.Observe(context.Background(), forged); e == nil {
+			t.Fatal("foreign observation cleared pending")
+		}
+		f.fault = ""
+		result, e := p.Observe(context.Background(), r)
+		want := "predecessor-visible"
+		if didPublish {
+			want = "candidate-visible"
+		}
+		if e != nil || result != want || p.pending != nil || f.counts["publish"] != 1 {
+			t.Fatal("re-observation changed or replayed mutation")
+		}
+	}
+}
+func TestAuthorityPublicationPredecessorIdentityAndServingPin(t *testing.T) {
+	b, data := publicationFixture(t)
+	before := ConfigVersion{Present: true, Volume: 1, Low: 10, Hash: sha256.Sum256([]byte("old credential"))}
+	for _, changed := range []string{"inode", "bytes", "missing", "TLS", "endpoint", "tokenFile", "duplicate"} {
+		t.Run(changed, func(t *testing.T) {
+			f := &publicationFake{currentValue: before}
+			p := &ConfigPublisher{backend: f, serving: b}
+			input := append([]byte{}, data...)
+			switch changed {
+			case "inode":
+				f.currentValue.Low++
+			case "bytes":
+				f.currentValue.Hash[0]++
+			case "missing":
+				f.currentValue = ConfigVersion{}
+			case "TLS":
+				p.serving.Certificate[0]++
+			case "endpoint":
+				p.serving.Endpoint = "https://127.0.0.1:6444"
+			case "tokenFile":
+				input = []byte(strings.Replace(string(input), `"token":"fresh-test-secret"`, `"token":"fresh-test-secret","tokenFile":"forbidden"`, 1))
+			case "duplicate":
+				input = []byte(strings.Replace(string(input), `"kind":"Config"`, `"kind":"Config","kind":"Config"`, 1))
+			}
+			if _, e := p.Publish(context.Background(), before, input); e == nil || f.counts["stage"] != 0 {
+				t.Fatal("foreign identity/private document reached staging")
+			}
+		})
+	}
+}
+func TestAuthorityPublicationFirstAndRepeatedRotationKeepAuthority(t *testing.T) {
+	b, data := publicationFixture(t)
+	f := &publicationFake{}
+	p := &ConfigPublisher{backend: f, serving: b}
+	first, e := p.Publish(context.Background(), ConfigVersion{}, data)
+	if e != nil || first.Unknown || first.Stage != "visible" {
+		t.Fatal("first publication refused")
+	}
+	f.staged.Low = 0 // fake uses deterministic candidate ID; next fixture assigns below
+	rotated := []byte(strings.Replace(string(data), "fresh-test-secret", "replacement-test-secret", 1))
+	second, e := p.Publish(context.Background(), first.Candidate, rotated)
+	if e != nil || second.Candidate.Hash == first.Candidate.Hash || p.serving != b {
+		t.Fatal("repeat token rotation lost stable authority")
+	}
+	if !reflect.DeepEqual(f.calls[:10], []string{"acquire", "check", "current", "stage", "flush", "check", "current", "publish", "verify", "check"}) {
+		t.Fatal("publication ordering")
+	}
+}
+
+func TestAuthorityPublicationNewProcessUsesCurrentExactPredecessor(t *testing.T) {
+	b, data := publicationFixture(t)
+	f := &publicationFake{}
+	first := &ConfigPublisher{backend: f, serving: b}
+	r, e := first.Publish(context.Background(), ConfigVersion{}, data)
+	if e != nil {
+		t.Fatal("initial publish")
+	}
+	if first.Close() != nil {
+		t.Fatal("first owner close")
+	}
+	// No new TLS authority is introduced by a normal volatile-token change.
+	nextBinding := b
+	nextBinding.PID++
+	nextBinding.Creation++
+	next := &ConfigPublisher{backend: f, serving: nextBinding}
+	before, e := next.ObserveCurrent(context.Background())
+	if e != nil || before != r.Candidate {
+		t.Fatal("restart predecessor observation")
+	}
+	rotated := []byte(strings.Replace(string(data), "fresh-test-secret", "next-process-test-secret", 1))
+	if _, e = next.Publish(context.Background(), before, rotated); e != nil || next.serving.Certificate != b.Certificate {
+		t.Fatal("restart publication changed stable authority")
+	}
+}
+func TestAuthorityPublicationConcurrentCancellationAndClosedRefusal(t *testing.T) {
+	b, data := publicationFixture(t)
+	f := &publicationFake{enter: make(chan struct{}), release: make(chan struct{})}
+	p := &ConfigPublisher{backend: f, serving: b}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { _, e := p.Publish(ctx, ConfigVersion{}, data); done <- e }()
+	<-f.enter
+	if _, e := p.Publish(context.Background(), ConfigVersion{}, data); e == nil {
+		t.Fatal("parallel owner queued")
+	}
+	cancel()
+	if <-done == nil || f.counts["publish"] != 0 {
+		t.Fatal("cancelled staging published")
+	}
+	if p.Close() != nil {
+		t.Fatal("close")
+	}
+	calls := len(f.calls)
+	if _, e := p.Publish(context.Background(), ConfigVersion{}, data); e == nil || len(f.calls) != calls {
+		t.Fatal("closed publisher touched backend")
+	}
+}
diff --git a/rdd/pkg/managementconfig/authority_windows.go b/rdd/pkg/managementconfig/authority_windows.go
new file mode 100644
index 0000000..8273210
--- /dev/null
+++ b/rdd/pkg/managementconfig/authority_windows.go
@@ -0,0 +1,500 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"os"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// createFreshAuthority is the fixed private existing-Create primitive. The
+// reviewed parent lease is mandatory; no path/raw-handle/legacy-home fallback.
+// This runs BEFORE options.Complete generates keys and BEFORE kine opens db.
+// Existing anchor always refuses. No ACL repair, old-state migration or removal.
+func createFreshAuthority(ctx context.Context, parent *ParentLease) (*Created, error) {
+	if ctx == nil || ctx.Err() != nil || parent == nil {
+		return nil, ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil || sid != parent.sid {
+		return nil, ErrPublication
+	}
+	parents, e := parent.retain()
+	if e != nil {
+		return nil, ErrPublication
+	}
+	c := &Created{parent: parents.leaf(), parents: parents}
+	sd, e := privateDescriptor(sid, true)
+	if e != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	c.anchor, e = openRelative(c.parent, anchorName, true, sd, true)
+	if e != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	// On partial failure retain private created state; no speculative deletion
+	// and no subsequent reuse as a successful authority receipt.
+	if verifyPrivate(c.anchor, sid, true) != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	for _, name := range []string{"tls", "db"} {
+		if ctx.Err() != nil {
+			c.Close()
+			return nil, ErrPublication
+		}
+		h, e := openRelative(c.anchor, name, true, sd, true)
+		if e != nil {
+			c.Close()
+			return nil, ErrPublication
+		}
+		verified := verifyPrivate(h, sid, true)
+		closed := windows.CloseHandle(h)
+		if verified != nil || closed != nil {
+			c.Close()
+			return nil, ErrPublication
+		}
+	}
+	return c, nil
+}
+
+// openExistingAuthority supports an already protected private authority across
+// backend process starts. It reuses the conservative typed native-root walker;
+// it never adopts the observed unsafe legacy home or adjusts an ancestor ACL.
+// All same-instance service owners must use the fixed writer lock. This does
+// not authenticate same-user arbitrary input or qualify a production callsite.
+func openExistingAuthority(ctx context.Context, root *InstanceRoot) (*Created, error) {
+	lease, e := OpenInstanceParent(ctx, root)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	if walkRelative(ctx, lease, []string{anchorName}) != nil {
+		lease.Close()
+		return nil, ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(lease.leaf(), sid, true) != nil || checkAuthorityFiles(ctx, lease.leaf(), sid) != nil {
+		lease.Close()
+		return nil, ErrPublication
+	}
+	db, e := openRelative(lease.leaf(), "db", true, nil, false)
+	if e != nil {
+		lease.Close()
+		return nil, ErrPublication
+	}
+	verified := verifyPrivate(db, sid, true)
+	closeErr := windows.CloseHandle(db)
+	if verified != nil || closeErr != nil {
+		lease.Close()
+		return nil, ErrPublication
+	}
+	var anchor windows.Handle
+	if ctx.Err() != nil || windows.DuplicateHandle(windows.CurrentProcess(), lease.leaf(), windows.CurrentProcess(), &anchor, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		lease.Close()
+		return nil, ErrPublication
+	}
+	return &Created{parents: lease, parent: lease.leaf(), anchor: anchor, servingLease: true}, nil
+}
+
+// CreateDefaultAuthorityFiles writes only new fixed default files privately at
+// CREATE, before any bytes. This is a source-only seam for existing in-memory
+// upstream generators, not a replacement PKI or custom-cert import route.
+// A partial failure retains private known files and refuses startup; callers
+// must not rerun with overwrite, ACL repair or fallback path writers.
+func (c *Created) CreateDefaultAuthorityFiles(ctx context.Context, cert, key, sa []byte) (err error) {
+	if c == nil || ctx == nil || ctx.Err() != nil || validateAuthorityMaterial(cert, key, sa) != nil {
+		return ErrPublication
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if c.closed || c.anchor == 0 {
+		return ErrPublication
+	}
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(c.anchor, sid, true) != nil {
+		return ErrPublication
+	}
+	dir, e := openRelative(c.anchor, "tls", true, nil, false)
+	if e != nil {
+		return ErrPublication
+	}
+	defer func() {
+		if windows.CloseHandle(dir) != nil {
+			err = ErrPublication
+		}
+	}()
+	if verifyPrivate(dir, sid, true) != nil {
+		return ErrPublication
+	}
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		return ErrPublication
+	}
+	for _, item := range []struct {
+		name string
+		data []byte
+	}{{"apiserver.crt", cert}, {"apiserver.key", key}, {"sa.key", sa}} {
+		if ctx.Err() != nil {
+			return ErrPublication
+		}
+		h, e := authorityOpen(dir, item.name, sd, windows.FILE_CREATE, windows.GENERIC_WRITE|windows.READ_CONTROL, 0)
+		if e != nil {
+			return ErrPublication
+		}
+		writeErr := func() error {
+			if verifyPrivate(h, sid, false) != nil {
+				return ErrPublication
+			}
+			for remaining := item.data; len(remaining) > 0; {
+				if ctx.Err() != nil {
+					return ErrPublication
+				}
+				n, e := nativeWrite(h, remaining)
+				if e != nil || n < 1 || n > len(remaining) {
+					return ErrPublication
+				}
+				remaining = remaining[n:]
+			}
+			if ctx.Err() != nil || windows.FlushFileBuffers(h) != nil {
+				return ErrPublication
+			}
+			return nil
+		}()
+		closeErr := windows.CloseHandle(h)
+		if writeErr != nil || closeErr != nil {
+			return ErrPublication
+		}
+	}
+	return nil
+}
+
+// NewConfigPublisher consumes the Created lifetime on success; Close owns its
+// handles. It does not create TLS credentials or start any server. The service
+// must finish default private authority creation before calling this method.
+// Current process and existing completed serving authority are rechecked for
+// every publication. External same-user callers are already privileged.
+func (c *Created) NewConfigPublisher(ctx context.Context, b ServingBinding) (*ConfigPublisher, error) {
+	if c == nil || ctx == nil || ctx.Err() != nil || !b.valid() {
+		return nil, ErrPublication
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.anchor == 0 || c.parents == nil {
+		return nil, ErrPublication
+	}
+	backend := &nativeAuthority{created: c}
+	lease := &nativeAuthorityLease{owner: backend}
+	if lease.check(ctx, b) != nil {
+		return nil, ErrPublication
+	}
+	// Fresh-create retained an exclusive credential handle. Explicitly release
+	// it before publication; sharing restrictions must never be bypassed by
+	// POSIX rename flags. A separate reader continues to block replacement.
+	if c.file != 0 {
+		h := c.file
+		c.file = 0
+		if windows.CloseHandle(h) != nil {
+			return nil, ErrPublication
+		}
+	}
+	return &ConfigPublisher{backend: backend, serving: b}, nil
+}
+
+type nativeAuthority struct{ created *Created }
+
+func (n *nativeAuthority) close() error { return n.created.Close() }
+func (n *nativeAuthority) acquire(ctx context.Context) (authorityLease, error) {
+	if ctx == nil || ctx.Err() != nil || n == nil || n.created == nil || !n.created.mu.TryLock() {
+		return nil, ErrPublication
+	}
+	c := n.created
+	if c.closed || c.anchor == 0 {
+		c.mu.Unlock()
+		return nil, ErrPublication
+	}
+	l := &nativeAuthorityLease{owner: n, locked: true}
+	runtime.LockOSThread()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(c.anchor, sid, true) != nil {
+		l.close()
+		return nil, ErrPublication
+	}
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		l.close()
+		return nil, ErrPublication
+	}
+	// FILE_OPEN_IF only for the fixed empty private writer lock. It never
+	// authorizes opening/adopting an existing config, anchor or credential.
+	l.lock, e = authorityOpen(c.anchor, "management.writer.lock", sd, windows.FILE_OPEN_IF, windows.GENERIC_READ|windows.GENERIC_WRITE|windows.READ_CONTROL, 0)
+	if e != nil || verifyPrivate(l.lock, sid, false) != nil {
+		l.close()
+		return nil, ErrPublication
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(l.lock, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow != 0 {
+		l.close()
+		return nil, ErrPublication
+	}
+	return l, nil
+}
+
+type nativeAuthorityLease struct {
+	owner                *nativeAuthority
+	locked               bool
+	lock, staged         windows.Handle
+	published, attempted bool
+	closed               bool
+}
+
+func (l *nativeAuthorityLease) anchor() windows.Handle { return l.owner.created.anchor }
+func (l *nativeAuthorityLease) check(ctx context.Context, b ServingBinding) (err error) {
+	if l.closed || ctx.Err() != nil || !b.valid() || uint32(os.Getpid()) != b.PID {
+		return ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(l.anchor(), sid, true) != nil || checkAuthorityFiles(ctx, l.anchor(), sid) != nil {
+		return ErrPublication
+	}
+	var creation, exit, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(windows.CurrentProcess(), &creation, &exit, &kernel, &user) != nil || windows.ProcessIdToSessionId(b.PID, &session) != nil || session != b.Session || uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime) != b.Creation {
+		return ErrPublication
+	}
+	tls, e := openRelative(l.anchor(), "tls", true, nil, false)
+	if e != nil {
+		return ErrPublication
+	}
+	defer func() {
+		if windows.CloseHandle(tls) != nil {
+			err = ErrPublication
+		}
+	}()
+	h, e := openRelative(tls, "apiserver.crt", false, nil, false)
+	if e != nil {
+		return ErrPublication
+	}
+	data, e := authorityRead(h, 64<<10)
+	closeErr := windows.CloseHandle(h)
+	digest, parseErr := authorityCertificate(data)
+	clear(data)
+	if e != nil || closeErr != nil || parseErr != nil || digest != b.Certificate {
+		return ErrPublication
+	}
+	return nil
+}
+func (l *nativeAuthorityLease) current(ctx context.Context) (version ConfigVersion, err error) {
+	if l.closed || ctx.Err() != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	h, e := openRelative(l.anchor(), configName, false, nil, false)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ConfigVersion{}, nil
+	}
+	if e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	defer func() {
+		if windows.CloseHandle(h) != nil {
+			version = ConfigVersion{}
+			err = ErrPublication
+		}
+	}()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(h, sid, false) != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	data, e := authorityRead(h, MaxConfigBytes)
+	if e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	defer clear(data)
+	return authorityVersion(h, sha256.Sum256(data))
+}
+func authorityRead(h windows.Handle, limit int64) (result []byte, err error) {
+	var duplicate windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), h, windows.CurrentProcess(), &duplicate, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		return nil, ErrPublication
+	}
+	f := os.NewFile(uintptr(duplicate), "private authority bytes")
+	defer func() {
+		if f.Close() != nil {
+			clear(result)
+			result = nil
+			err = ErrPublication
+		}
+	}()
+	before, e := f.Stat()
+	if e != nil || before.Size() < 1 || before.Size() > limit {
+		return nil, ErrPublication
+	}
+	data, e := io.ReadAll(io.NewSectionReader(f, 0, limit+1))
+	after, statErr := f.Stat()
+	if e != nil || statErr != nil || len(data) > int(limit) || before.Size() != after.Size() || !before.ModTime().Equal(after.ModTime()) || int64(len(data)) != after.Size() {
+		clear(data)
+		return nil, ErrPublication
+	}
+	return data, nil
+}
+func authorityVersion(h windows.Handle, hash [32]byte) (ConfigVersion, error) {
+	var info windows.ByHandleFileInformation
+	if objectKind(h, false) != nil || windows.GetFileInformationByHandle(h, &info) != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	v := ConfigVersion{true, info.VolumeSerialNumber, info.FileIndexHigh, info.FileIndexLow, hash}
+	if !v.valid() {
+		return ConfigVersion{}, ErrPublication
+	}
+	return v, nil
+}
+func authorityOpen(parent windows.Handle, name string, sd *windows.SECURITY_DESCRIPTOR, disposition, access, share uint32) (windows.Handle, error) {
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return 0, ErrPublication
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&h, access|windows.SYNCHRONIZE|windows.FILE_READ_ATTRIBUTES, &oa, &status, nil, 0, share, disposition, windows.FILE_OPEN_REPARSE_POINT|windows.FILE_NON_DIRECTORY_FILE|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	runtime.KeepAlive(sd)
+	return h, e
+}
+func (l *nativeAuthorityLease) stage(ctx context.Context, data []byte) (ConfigVersion, error) {
+	if l.closed || l.staged != 0 || ctx.Err() != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	sid, e := currentOwner()
+	if e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	var nonce [16]byte
+	if _, e = rand.Read(nonce[:]); e != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	l.staged, e = authorityOpen(l.anchor(), "config.publish-"+hex.EncodeToString(nonce[:]), sd, windows.FILE_CREATE, windows.GENERIC_WRITE|windows.GENERIC_READ|windows.DELETE|windows.READ_CONTROL, 0)
+	if e != nil || verifyPrivate(l.staged, sid, false) != nil {
+		return ConfigVersion{}, ErrPublication
+	}
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return ConfigVersion{}, ErrPublication
+		}
+		n, e := nativeWrite(l.staged, remaining)
+		if e != nil || n < 1 || n > len(remaining) {
+			return ConfigVersion{}, ErrPublication
+		}
+		remaining = remaining[n:]
+	}
+	return authorityVersion(l.staged, sha256.Sum256(data))
+}
+func (l *nativeAuthorityLease) flush(ctx context.Context) error {
+	if l.closed || l.staged == 0 || ctx.Err() != nil || windows.FlushFileBuffers(l.staged) != nil {
+		return ErrPublication
+	}
+	return nil
+}
+func (l *nativeAuthorityLease) publish(ctx context.Context, replace bool) error {
+	if l.closed || l.staged == 0 || l.attempted || ctx.Err() != nil {
+		return ErrPublication
+	}
+	l.attempted = true
+	// No POSIX/ignore-sharing flags. A live config reader denying DELETE
+	// sharing must refuse; this behavior requires dedicated native proof.
+	type renameInfo struct {
+		Replace uint32
+		Root    windows.Handle
+		Length  uint32
+		Name    [1]uint16
+	}
+	name, _ := windows.UTF16FromString(configName)
+	var shape renameInfo
+	buf := make([]byte, int(unsafe.Offsetof(shape.Name))+(len(name)-1)*2)
+	info := (*renameInfo)(unsafe.Pointer(&buf[0]))
+	if replace {
+		info.Replace = 1
+	}
+	info.Root = l.anchor()
+	info.Length = uint32((len(name) - 1) * 2)
+	copy(unsafe.Slice(&info.Name[0], len(name)-1), name[:len(name)-1])
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtSetInformationFile(l.staged, &status, &buf[0], uint32(len(buf)), windows.FileRenameInformation) != nil {
+		return ErrPublication
+	}
+	l.published = true
+	return nil
+}
+func (l *nativeAuthorityLease) verify(ctx context.Context, want ConfigVersion) error {
+	// The staged handle remains exclusive. Verify its identity/data from that
+	// owned object; closing it permits a separate fixed-name post-observation.
+	if l.closed || !l.published || ctx.Err() != nil {
+		return ErrPublication
+	}
+	h := l.staged
+	l.staged = 0
+	if windows.CloseHandle(h) != nil {
+		return ErrPublication
+	}
+	got, e := l.current(ctx)
+	if e != nil || got != want {
+		return ErrPublication
+	}
+	return nil
+}
+func (l *nativeAuthorityLease) close() error {
+	if l.closed {
+		return nil
+	}
+	l.closed = true
+	failed := false
+	staged, lock := l.staged, l.lock
+	l.staged = 0
+	l.lock = 0
+	if staged != 0 {
+		// After an attempted rename outcome is conservatively unknown: never
+		// delete a handle that might now name published config.yaml.
+		if !l.attempted {
+			remove := uint32(1)
+			if windows.SetFileInformationByHandle(staged, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4) != nil {
+				failed = true
+			}
+		}
+		if windows.CloseHandle(staged) != nil {
+			failed = true
+		}
+	}
+	if lock != 0 && windows.CloseHandle(lock) != nil {
+		failed = true
+	}
+	if l.locked {
+		l.locked = false
+		runtime.UnlockOSThread()
+		l.owner.created.mu.Unlock()
+	}
+	if failed {
+		return ErrPublication
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/datastore_generation_windows_test.go b/rdd/pkg/managementconfig/datastore_generation_windows_test.go
new file mode 100644
index 0000000..aca22fd
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_generation_windows_test.go
@@ -0,0 +1,74 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// Review-gated native fixture only. Uses new temporary children and synthetic
+// TLS material; never opens product state, a database, service or socket.
+func TestPrivateDatastoreGenerationNativeRetirement(t *testing.T) {
+	if os.Getenv("ORBWIN_QUALIFY_DATASTORE_GENERATION") != "1" {
+		t.Skip("fresh native generation qualification requires explicit review")
+	}
+	ctx := context.Background()
+	parent, dir, sid := fixture(t)
+	fresh, err := createFreshAuthority(ctx, parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		for _, path := range []string{filepath.Join(dir, anchorName, "db", "kine"), filepath.Join(dir, anchorName, "db"), filepath.Join(dir, anchorName, "tls")} {
+			if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+				t.Error("known empty fixture directory cleanup failed")
+			}
+		}
+	})
+	if fresh.Close() != nil {
+		t.Fatal("fresh close")
+	}
+	h, err := openRelative(parent.leaf(), anchorName, true, nil, false)
+	if err != nil || verifyPrivate(h, sid, true) != nil {
+		t.Fatal("serving reopen")
+	}
+	parents, err := parent.retain()
+	if err != nil {
+		windows.CloseHandle(h)
+		t.Fatal(err)
+	}
+	owner := &Created{parents: parents, parent: parents.leaf(), anchor: h, servingLease: true}
+	defer owner.Close()
+	if _, _, _, err := owner.LoadDefaultAuthority(ctx); !errors.Is(err, ErrDefaultsAbsent) {
+		t.Fatal("three absent default key roles were not recognized")
+	}
+	generation, err := owner.CreateDatastoreGeneration(ctx, datastoreMaterialFixture(t))
+	if err != nil {
+		t.Fatal("generation create")
+	}
+	generation.Started()
+	if generation.Close() == nil || owner.Close() == nil {
+		t.Fatal("live generation released authority")
+	}
+	for i := range datastoreNames() {
+		data, err := authorityRead(generation.files[i+1], 65536)
+		hash := sha256.Sum256(data)
+		if err != nil || hex.EncodeToString(hash[:]) != generation.record.Files[i] {
+			clear(data)
+			t.Fatal("retained fixed material mismatch")
+		}
+		clear(data)
+	}
+	generation.Retired()
+	if generation.Close() != nil || owner.Close() != nil {
+		t.Fatal("positive retirement cleanup failed")
+	}
+}
diff --git a/rdd/pkg/managementconfig/datastore_material.go b/rdd/pkg/managementconfig/datastore_material.go
new file mode 100644
index 0000000..391a84e
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_material.go
@@ -0,0 +1,168 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"time"
+	"unicode/utf16"
+)
+
+// DatastoreMaterial is supplied only by the existing embedded datastore owner.
+// The signing CA private key is never accepted or persisted. No renderer,
+// request-selected filename, management TLS key, import or custom CA is allowed.
+type DatastoreMaterial struct {
+	CA, ServerCertificate, ServerKey, ClientCertificate, ClientKey []byte `json:"-"`
+}
+
+func (DatastoreMaterial) String() string               { return "[private datastore material]" }
+func (DatastoreMaterial) GoString() string             { return "[private datastore material]" }
+func (DatastoreMaterial) MarshalJSON() ([]byte, error) { return []byte("{}"), nil }
+
+type DatastorePaths struct {
+	CA, ServerCertificate, ServerKey, ClientCertificate, ClientKey string
+}
+
+func (DatastorePaths) String() string   { return "[private datastore paths]" }
+func (DatastorePaths) GoString() string { return "[private datastore paths]" }
+
+type datastoreOwner struct {
+	PID      uint32 `json:"pid"`
+	Creation uint64 `json:"creation"`
+	Session  uint32 `json:"session"`
+}
+
+type datastoreRecord struct {
+	Schema     int            `json:"schema"`
+	Generation string         `json:"generation"`
+	Owner      datastoreOwner `json:"owner"`
+	Expires    time.Time      `json:"expires"`
+	Files      [5]string      `json:"files"`
+}
+
+func datastoreNames() [5]string {
+	return [5]string{"ca.crt", "server.crt", "server.key", "client.crt", "client.key"}
+}
+
+func (m DatastoreMaterial) values() [5][]byte {
+	return [5][]byte{m.CA, m.ServerCertificate, m.ServerKey, m.ClientCertificate, m.ClientKey}
+}
+
+func validateDatastoreMaterial(m DatastoreMaterial, now time.Time) ([5]string, time.Time, error) {
+	var hashes [5]string
+	for i, value := range m.values() {
+		if len(value) == 0 || len(value) > 64<<10 {
+			return hashes, time.Time{}, ErrPublication
+		}
+		hash := sha256.Sum256(value)
+		hashes[i] = hex.EncodeToString(hash[:])
+	}
+	block, trailing := pem.Decode(m.CA)
+	if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 || len(trailing) != 0 {
+		return hashes, time.Time{}, ErrPublication
+	}
+	ca, err := x509.ParseCertificate(block.Bytes)
+	if err != nil || !ca.IsCA || !ca.BasicConstraintsValid || ca.KeyUsage&x509.KeyUsageCertSign == 0 {
+		return hashes, time.Time{}, ErrPublication
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(ca)
+	var peers [2]*x509.Certificate
+	for i, role := range []struct{ cert, key []byte }{{m.ServerCertificate, m.ServerKey}, {m.ClientCertificate, m.ClientKey}} {
+		pair, err := tls.X509KeyPair(role.cert, role.key)
+		if err != nil || len(pair.Certificate) != 1 {
+			return hashes, time.Time{}, ErrPublication
+		}
+		cert, err := x509.ParseCertificate(pair.Certificate[0])
+		if err != nil || cert.IsCA || len(cert.ExtKeyUsage) != 1 || !cert.NotAfter.Equal(ca.NotAfter) {
+			return hashes, time.Time{}, ErrPublication
+		}
+		options := x509.VerifyOptions{Roots: pool, CurrentTime: now, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}}
+		if i == 0 {
+			options.KeyUsages = []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}
+			options.DNSName = "127.0.0.1"
+		}
+		if _, err := cert.Verify(options); err != nil {
+			return hashes, time.Time{}, ErrPublication
+		}
+		peers[i] = cert
+	}
+	if bytes.Equal(peers[0].RawSubjectPublicKeyInfo, peers[1].RawSubjectPublicKeyInfo) ||
+		bytes.Equal(ca.RawSubjectPublicKeyInfo, peers[0].RawSubjectPublicKeyInfo) ||
+		bytes.Equal(ca.RawSubjectPublicKeyInfo, peers[1].RawSubjectPublicKeyInfo) {
+		return hashes, time.Time{}, ErrPublication
+	}
+	return hashes, ca.NotAfter.UTC(), nil
+}
+
+func datastoreRecordBytes(record datastoreRecord) ([]byte, error) {
+	if record.Schema != 1 || len(record.Generation) != 32 || record.Owner.PID == 0 || record.Owner.Creation == 0 || record.Owner.Session == 0 || record.Expires.IsZero() {
+		return nil, ErrPublication
+	}
+	decoded, err := hex.DecodeString(record.Generation)
+	if err != nil || len(decoded) != 16 || hex.EncodeToString(decoded) != record.Generation {
+		return nil, ErrPublication
+	}
+	for _, hash := range record.Files {
+		decoded, err := hex.DecodeString(hash)
+		if err != nil || len(decoded) != 32 || hex.EncodeToString(decoded) != hash {
+			return nil, ErrPublication
+		}
+	}
+	return json.Marshal(record)
+}
+
+func parseDatastoreRecord(data []byte, generation string) (datastoreRecord, error) {
+	var record datastoreRecord
+	if len(data) == 0 || len(data) > 2048 || json.Unmarshal(data, &record) != nil || record.Generation != generation {
+		return record, ErrPublication
+	}
+	canonical, err := datastoreRecordBytes(record)
+	if err != nil || !bytes.Equal(canonical, data) {
+		return datastoreRecord{}, ErrPublication
+	}
+	return record, nil
+}
+
+// FILE_ID_BOTH_DIR_INFO layout is from the pinned Windows SDK winbase.h.
+// Parse only bounded copied bytes; filename offset 104, length at 60. The
+// native qualifier must separately prove the compiled ABI before activation.
+func datastoreDirectoryBatch(data []byte) ([]string, error) {
+	var result []string
+	seen := map[string]bool{}
+	for offset, count := 0, 0; count < 32; count++ {
+		if offset < 0 || offset+104 > len(data) {
+			return nil, ErrPublication
+		}
+		next := int(binary.LittleEndian.Uint32(data[offset:]))
+		length := int(binary.LittleEndian.Uint32(data[offset+60:]))
+		if length == 0 || length > 512 || length%2 != 0 || offset+104+length > len(data) ||
+			next != 0 && (next < 104+length || next%8 != 0 || offset+next > len(data)) {
+			return nil, ErrPublication
+		}
+		units := make([]uint16, length/2)
+		for i := range units {
+			units[i] = binary.LittleEndian.Uint16(data[offset+104+i*2:])
+		}
+		name := string(utf16.Decode(units))
+		if name != "." && name != ".." {
+			if seen[name] || len(result) >= maxDatastoreEntries {
+				return nil, ErrPublication
+			}
+			seen[name] = true
+			result = append(result, name)
+		}
+		if next == 0 {
+			return result, nil
+		}
+		offset += next
+	}
+	return nil, ErrPublication
+}
+
+const maxDatastoreEntries = 16
diff --git a/rdd/pkg/managementconfig/datastore_material_test.go b/rdd/pkg/managementconfig/datastore_material_test.go
new file mode 100644
index 0000000..2817c4e
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_material_test.go
@@ -0,0 +1,111 @@
+package managementconfig
+
+import (
+	"encoding/binary"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/datastore"
+)
+
+func datastoreMaterialFixture(t *testing.T) DatastoreMaterial {
+	t.Helper()
+	now := time.Now().UTC().Truncate(time.Second)
+	transport, err := datastore.NewPrivateTransport(now, now.Add(time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+	files := transport.Files()
+	return DatastoreMaterial{files.CA, files.ServerCertificate, files.ServerKey, files.ClientCertificate, files.ClientKey}
+}
+
+func TestDatastoreMaterialRequiresDedicatedMatchingRoles(t *testing.T) {
+	material := datastoreMaterialFixture(t)
+	if _, _, err := validateDatastoreMaterial(material, time.Now()); err != nil {
+		t.Fatal("matching dedicated material refused")
+	}
+	for _, fault := range []string{"empty", "wrong-key", "server-as-client", "foreign-ca", "expired", "oversize"} {
+		t.Run(fault, func(t *testing.T) {
+			copy := material
+			now := time.Now()
+			switch fault {
+			case "empty":
+				copy.ClientKey = nil
+			case "wrong-key":
+				copy.ClientKey = copy.ServerKey
+			case "server-as-client":
+				copy.ClientKey, copy.ClientCertificate = copy.ServerKey, copy.ServerCertificate
+			case "foreign-ca":
+				copy.CA = datastoreMaterialFixture(t).CA
+			case "expired":
+				now = now.Add(2 * time.Hour)
+			case "oversize":
+				copy.CA = make([]byte, 65537)
+			}
+			if _, _, err := validateDatastoreMaterial(copy, now); err == nil {
+				t.Fatal("invalid material admitted")
+			}
+		})
+	}
+}
+
+func TestDatastoreRecordStrictCanonicalOwnerAndHashes(t *testing.T) {
+	material := datastoreMaterialFixture(t)
+	hashes, expires, err := validateDatastoreMaterial(material, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	record := datastoreRecord{1, strings.Repeat("a", 32), datastoreOwner{42, 123, 1}, expires, hashes}
+	data, err := datastoreRecordBytes(record)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed, err := parseDatastoreRecord(data, record.Generation); err != nil || parsed != record {
+		t.Fatal("exact public owner record refused")
+	}
+	for _, input := range []string{
+		string(data) + "\n", string(data) + "{}",
+		strings.Replace(string(data), `"schema":1`, `"Schema":1`, 1),
+		strings.Replace(string(data), `"schema":1`, `"schema":1,"schema":1`, 1),
+		strings.Replace(string(data), `"schema":1`, `"schema":1,"unknown":1`, 1),
+		strings.Replace(string(data), `"pid":42`, `"pid":0`, 1),
+	} {
+		if _, err := parseDatastoreRecord([]byte(input), record.Generation); err == nil {
+			t.Fatal("noncanonical record admitted")
+		}
+	}
+	if _, err := parseDatastoreRecord(data, strings.Repeat("b", 32)); err == nil {
+		t.Fatal("record accepted for different generation")
+	}
+}
+
+func TestDatastoreDirectoryBatchBoundsAndEntries(t *testing.T) {
+	entry := func(name string) []byte {
+		data := make([]byte, 104+len(name)*2)
+		binary.LittleEndian.PutUint32(data[60:], uint32(len(name)*2))
+		for i, c := range name {
+			binary.LittleEndian.PutUint16(data[104+i*2:], uint16(c))
+		}
+		return data
+	}
+	name := strings.Repeat("a", 32)
+	if names, err := datastoreDirectoryBatch(entry(name)); err != nil || len(names) != 1 || names[0] != name {
+		t.Fatal("bounded copied directory entry refused")
+	}
+	for _, input := range [][]byte{nil, make([]byte, 103), make([]byte, 104), entry(name)[:110]} {
+		if _, err := datastoreDirectoryBatch(input); err == nil {
+			t.Fatal("truncated directory entry admitted")
+		}
+	}
+	bad := entry(name)
+	binary.LittleEndian.PutUint32(bad, 8)
+	if _, err := datastoreDirectoryBatch(bad); err == nil {
+		t.Fatal("overlapping next entry admitted")
+	}
+	bad = entry(name)
+	binary.LittleEndian.PutUint32(bad[60:], 511)
+	if _, err := datastoreDirectoryBatch(bad); err == nil {
+		t.Fatal("odd UTF16 length admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/datastore_material_windows.go b/rdd/pkg/managementconfig/datastore_material_windows.go
new file mode 100644
index 0000000..a70defb
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_material_windows.go
@@ -0,0 +1,521 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+const maxDatastoreGenerations = 16
+
+// DatastoreGeneration belongs to the same service owner as Created. Its fixed
+// immutable files are held READ-only, without DELETE sharing, so upstream's
+// ordinary certificate loaders can open them but nobody can replace them while
+// they are in use. Only positive retirement of the existing API/kine users may
+// admit cleanup. Synchronous Windows calls are cancellation boundaries; no hard
+// preemption or power-loss durability is inferred from context or file flushes.
+type DatastoreGeneration struct {
+	mu                       sync.Mutex
+	parents                  *ParentLease
+	db, root, directory      windows.Handle
+	files                    []windows.Handle
+	record                   datastoreRecord
+	paths                    DatastorePaths
+	started, retired, closed bool
+	cleanupAttempted         bool
+	cleanupError             error
+	retained                 int
+	owner                    *Created
+}
+
+func (*DatastoreGeneration) String() string   { return "[private datastore generation]" }
+func (*DatastoreGeneration) GoString() string { return "[private datastore generation]" }
+
+func (g *DatastoreGeneration) Paths() DatastorePaths    { return g.paths }
+func (g *DatastoreGeneration) RetainedGenerations() int { return g.retained }
+func (g *DatastoreGeneration) Started() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.started = true
+}
+func (g *DatastoreGeneration) Retired() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.retired = true
+}
+
+func currentDatastoreOwner() (datastoreOwner, error) {
+	var c, x, k, u windows.Filetime
+	pid := windows.GetCurrentProcessId()
+	var session uint32
+	if windows.GetProcessTimes(windows.CurrentProcess(), &c, &x, &k, &u) != nil || windows.ProcessIdToSessionId(pid, &session) != nil || session == 0 {
+		return datastoreOwner{}, ErrPublication
+	}
+	return datastoreOwner{pid, uint64(c.HighDateTime)<<32 | uint64(c.LowDateTime), session}, nil
+}
+
+func openDatastoreDirectory(parent windows.Handle, name string, sd *windows.SECURITY_DESCRIPTOR, create bool, deleteAccess bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrPublication
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text,
+		Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.FILE_LIST_DIRECTORY | windows.SYNCHRONIZE)
+	share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE)
+	disposition := uint32(windows.FILE_OPEN)
+	if create {
+		disposition, share = windows.FILE_CREATE, 0
+	}
+	if deleteAccess {
+		access |= windows.DELETE
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, share, disposition,
+		windows.FILE_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	runtime.KeepAlive(sd)
+	return h, err
+}
+
+func openOrCreateDatastoreRoot(parent windows.Handle, sid string) (windows.Handle, error) {
+	h, err := openDatastoreDirectory(parent, "kine", nil, false, false)
+	if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		sd, e := privateDescriptor(sid, true)
+		if e != nil {
+			return 0, ErrPublication
+		}
+		h, err = openDatastoreDirectory(parent, "kine", sd, true, false)
+		if err != nil {
+			return 0, ErrPublication
+		}
+		if verifyPrivate(h, sid, true) != nil {
+			windows.CloseHandle(h)
+			return 0, ErrPublication
+		}
+		want, e := anchorIdentity(h)
+		if e != nil || windows.CloseHandle(h) != nil {
+			return 0, ErrPublication
+		}
+		h, err = openDatastoreDirectory(parent, "kine", nil, false, false)
+		if err != nil {
+			return 0, ErrPublication
+		}
+		if got, e := anchorIdentity(h); e != nil || got != want {
+			windows.CloseHandle(h)
+			return 0, ErrPublication
+		}
+	}
+	if err != nil {
+		return 0, ErrPublication
+	}
+	if verifyPrivate(h, sid, true) != nil {
+		windows.CloseHandle(h)
+		return 0, ErrPublication
+	}
+	return h, nil
+}
+
+func datastoreDirectoryNames(h windows.Handle) ([]string, error) {
+	var names []string
+	buffer := make([]byte, 64<<10)
+	class := uint32(windows.FileIdBothDirectoryRestartInfo)
+	for batch := 0; batch < 4; batch++ {
+		err := windows.GetFileInformationByHandleEx(h, class, &buffer[0], uint32(len(buffer)))
+		if err == windows.ERROR_NO_MORE_FILES {
+			return names, nil
+		}
+		if err != nil {
+			return nil, ErrPublication
+		}
+		class = windows.FileIdBothDirectoryInfo
+		parsed, err := datastoreDirectoryBatch(buffer)
+		if err != nil || len(names)+len(parsed) > maxDatastoreGenerations {
+			return nil, ErrPublication
+		}
+		names = append(names, parsed...)
+		clear(buffer)
+	}
+	return nil, ErrPublication
+}
+
+// CreateDatastoreGeneration only publishes the five fixed roles below an exact
+// private selected authority. An existing generation is never overwritten.
+// Old/partial generations are counted, preserved and separately recoverable;
+// reaching the retention limit refuses, rather than growing without a bound.
+func (c *Created) CreateDatastoreGeneration(ctx context.Context, m DatastoreMaterial) (result *DatastoreGeneration, err error) {
+	if c == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrPublication
+	}
+	hashes, expires, err := validateDatastoreMaterial(m, time.Now())
+	if err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.anchor == 0 || c.parents == nil || !c.servingLease || c.datastoreReserved {
+		return nil, ErrPublication
+	}
+	c.datastoreReserved = true // One creation attempt per retained service owner.
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || verifyPrivate(c.anchor, sid, true) != nil {
+		return nil, ErrPublication
+	}
+	parents, err := c.parents.retain()
+	if err != nil {
+		return nil, ErrPublication
+	}
+	g := &DatastoreGeneration{parents: parents, owner: c}
+	ok := false
+	defer func() {
+		if !ok {
+			g.closeHandles()
+		}
+	}()
+	g.db, err = openRelative(c.anchor, "db", true, nil, false)
+	if err != nil || verifyPrivate(g.db, sid, true) != nil {
+		return nil, ErrPublication
+	}
+	g.root, err = openOrCreateDatastoreRoot(g.db, sid)
+	if err != nil {
+		return nil, ErrPublication
+	}
+	names, err := datastoreDirectoryNames(g.root)
+	if err != nil {
+		return nil, ErrPublication
+	}
+	// Only canonical, intact, private generations with an independently dead
+	// exact owner are eligible for cleanup. Incomplete/foreign/unknown state is
+	// preserved and counted; it is never silently made reusable authority.
+	for _, name := range names {
+		if ctx.Err() != nil {
+			return nil, ErrPublication
+		}
+		if !reapDatastoreGeneration(ctx, g.root, sid, name) {
+			g.retained++
+		}
+	}
+	if g.retained >= maxDatastoreGenerations {
+		return nil, ErrPublication
+	}
+	var nonce [16]byte
+	if _, err = io.ReadFull(rand.Reader, nonce[:]); err != nil {
+		return nil, ErrPublication
+	}
+	owner, err := currentDatastoreOwner()
+	if err != nil {
+		return nil, err
+	}
+	g.record = datastoreRecord{1, hex.EncodeToString(nonce[:]), owner, expires, hashes}
+	record, err := datastoreRecordBytes(g.record)
+	if err != nil {
+		return nil, err
+	}
+	sd, err := privateDescriptor(sid, true)
+	if err != nil {
+		return nil, ErrPublication
+	}
+	g.directory, err = openDatastoreDirectory(g.root, g.record.Generation, sd, true, false)
+	if err != nil || verifyPrivate(g.directory, sid, true) != nil {
+		return nil, ErrPublication
+	}
+	// Canonical owner/intended hashes precede the first credential write. A
+	// failed or crashed generation stays private and is never silently adopted.
+	child := &Created{anchor: g.directory}
+	if child.writeNewFixed(ctx, "owner.json", record) != nil {
+		return nil, ErrPublication
+	}
+	for i, name := range datastoreNames() {
+		if child.writeNewFixed(ctx, name, m.values()[i]) != nil {
+			return nil, ErrPublication
+		}
+	}
+	// Retire the exclusive creation file object before ordinary file loaders.
+	want, e := anchorIdentity(g.directory)
+	if e != nil || windows.CloseHandle(g.directory) != nil {
+		g.directory = 0
+		return nil, ErrPublication
+	}
+	g.directory = 0
+	g.directory, err = openDatastoreDirectory(g.root, g.record.Generation, nil, false, false)
+	if err != nil {
+		return nil, ErrPublication
+	}
+	if got, e := anchorIdentity(g.directory); e != nil || got != want || verifyPrivate(g.directory, sid, true) != nil {
+		return nil, ErrPublication
+	}
+	roles := datastoreNames()
+	for _, name := range append([]string{"owner.json"}, roles[:]...) {
+		h, err := openRelative(g.directory, name, false, nil, false)
+		if err != nil || verifyPrivate(h, sid, false) != nil {
+			if h != 0 {
+				windows.CloseHandle(h)
+			}
+			return nil, ErrPublication
+		}
+		g.files = append(g.files, h)
+	}
+	var path [1024]uint16
+	n, e := windows.GetFinalPathNameByHandle(g.directory, &path[0], uint32(len(path)), 0)
+	if e != nil || n == 0 || n >= uint32(len(path)) {
+		return nil, ErrPublication
+	}
+	base := windows.UTF16ToString(path[:n])
+	g.paths = DatastorePaths{filepath.Join(base, roles[0]), filepath.Join(base, roles[1]), filepath.Join(base, roles[2]), filepath.Join(base, roles[3]), filepath.Join(base, roles[4])}
+	ok = true
+	c.datastoreActive.Store(true)
+	return g, nil
+}
+
+func datastoreOwnerExited(owner datastoreOwner) bool {
+	if owner.PID == 0 || owner.Creation == 0 || owner.Session == 0 {
+		return false
+	}
+	h, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, owner.PID)
+	if err == windows.ERROR_INVALID_PARAMETER {
+		return true // No such process; AccessDenied or other failures remain unknown.
+	}
+	if err != nil {
+		return false
+	}
+	defer windows.CloseHandle(h)
+	var c, x, k, u windows.Filetime
+	if windows.GetProcessTimes(h, &c, &x, &k, &u) != nil {
+		return false
+	}
+	if uint64(c.HighDateTime)<<32|uint64(c.LowDateTime) != owner.Creation {
+		return true // A recycled PID is not the recorded process generation.
+	}
+	state, err := windows.WaitForSingleObject(h, 0)
+	return err == nil && state == windows.WAIT_OBJECT_0
+}
+
+func reapDatastoreGeneration(ctx context.Context, root windows.Handle, sid, name string) bool {
+	decoded, err := hex.DecodeString(name)
+	if err != nil || len(decoded) != 16 || hex.EncodeToString(decoded) != name || ctx.Err() != nil {
+		return false
+	}
+	directory, err := openDatastoreDirectory(root, name, nil, false, false)
+	if err != nil {
+		return false
+	}
+	g := &DatastoreGeneration{directory: directory, started: true, files: make([]windows.Handle, 6)}
+	// Before cleanup admission these are only read handles, always releasable.
+	admitted := false
+	defer func() {
+		if !admitted {
+			g.closeHandles()
+		}
+	}()
+	if verifyPrivate(directory, sid, true) != nil {
+		return false
+	}
+	names, err := datastoreDirectoryNames(directory)
+	if err != nil {
+		return false
+	}
+	roles := datastoreNames()
+	allowed := map[string]bool{"owner.json": true}
+	for _, role := range roles {
+		allowed[role] = true
+	}
+	for _, present := range names {
+		if !allowed[present] {
+			return false
+		}
+	}
+	for i, role := range append([]string{"owner.json"}, roles[:]...) {
+		h, err := openRelative(directory, role, false, nil, false)
+		if err == windows.STATUS_OBJECT_NAME_NOT_FOUND && i != 0 {
+			continue // A prior cleanup/crash can leave an intact owner record.
+		}
+		if err != nil || verifyPrivate(h, sid, false) != nil {
+			if h != 0 {
+				windows.CloseHandle(h)
+			}
+			return false
+		}
+		g.files[i] = h
+	}
+	data, err := authorityRead(g.files[0], 2048)
+	if err != nil {
+		return false
+	}
+	record, err := parseDatastoreRecord(data, name)
+	clear(data)
+	if err != nil || !datastoreOwnerExited(record.Owner) || ctx.Err() != nil {
+		return false
+	}
+	var duplicate windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), root, windows.CurrentProcess(), &duplicate, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		return false
+	}
+	g.root, g.record, g.retired = duplicate, record, true
+	// Close rechecks every present fixed file's exact declared hash/object and
+	// refuses altered/partial bytes. It never executes, signals or kills owner.
+	admitted = true
+	return g.Close() == nil
+}
+
+func (g *DatastoreGeneration) closeHandles() error {
+	failed := false
+	for i := len(g.files) - 1; i >= 0; i-- {
+		if g.files[i] != 0 && windows.CloseHandle(g.files[i]) != nil {
+			failed = true
+		}
+	}
+	g.files = nil
+	for _, p := range []*windows.Handle{&g.directory, &g.root, &g.db} {
+		h := *p
+		*p = 0
+		if h != 0 && windows.CloseHandle(h) != nil {
+			failed = true
+		}
+	}
+	if g.parents != nil {
+		if g.parents.Close() != nil {
+			failed = true
+		}
+		g.parents = nil
+	}
+	if failed {
+		return ErrPublication
+	}
+	return nil
+}
+
+// Close never retries an uncertain deletion. A later explicit recovery must
+// re-observe the retained record and exact file identities under the same root.
+func (g *DatastoreGeneration) Close() error {
+	if g == nil {
+		return nil
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		return nil
+	}
+	if g.started && !g.retired {
+		return ErrPublication
+	}
+	if g.cleanupAttempted {
+		return g.cleanupError
+	}
+	g.cleanupAttempted = true
+	g.cleanupError = ErrPublication
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || len(g.files) != 6 || verifyPrivate(g.directory, sid, true) != nil {
+		return g.cleanupError
+	}
+	canonical, err := datastoreRecordBytes(g.record)
+	if err != nil {
+		return g.cleanupError
+	}
+	var versions [6]ConfigVersion
+	for i, h := range g.files {
+		if h == 0 {
+			continue
+		}
+		if verifyPrivate(h, sid, false) != nil {
+			return g.cleanupError
+		}
+		data, err := authorityRead(h, 64<<10)
+		if err != nil {
+			return g.cleanupError
+		}
+		hash := sha256.Sum256(data)
+		clear(data)
+		want := hex.EncodeToString(hash[:])
+		if i == 0 {
+			if hash != sha256.Sum256(canonical) {
+				return g.cleanupError
+			}
+		} else if want != g.record.Files[i-1] {
+			return g.cleanupError
+		}
+		versions[i], err = authorityVersion(h, hash)
+		if err != nil {
+			return g.cleanupError
+		}
+	}
+	wantDirectory, err := anchorIdentity(g.directory)
+	if err != nil {
+		return g.cleanupError
+	}
+	// Retire our read/noDELETE handles only after actual user retirement.
+	for i := range g.files {
+		h := g.files[i]
+		g.files[i] = 0
+		if h != 0 && windows.CloseHandle(h) != nil {
+			return g.cleanupError
+		}
+	}
+	roles := datastoreNames()
+	names := append([]string{"owner.json"}, roles[:]...)
+	// Record LAST: interrupted cleanup retains its canonical ownership metadata.
+	for _, i := range []int{1, 2, 3, 4, 5, 0} {
+		if !versions[i].Present {
+			continue
+		}
+		h, err := authorityOpen(g.directory, names[i], nil, windows.FILE_OPEN,
+			windows.DELETE|windows.FILE_READ_DATA|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE)
+		if err != nil {
+			return g.cleanupError
+		}
+		data, readErr := authorityRead(h, 64<<10)
+		hash := sha256.Sum256(data)
+		clear(data)
+		version, versionErr := authorityVersion(h, hash)
+		if readErr != nil || versionErr != nil || version != versions[i] || verifyPrivate(h, sid, false) != nil {
+			windows.CloseHandle(h)
+			return g.cleanupError
+		}
+		remove := uint32(1)
+		removed := windows.SetFileInformationByHandle(h, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4)
+		closed := windows.CloseHandle(h)
+		if removed != nil || closed != nil {
+			return g.cleanupError
+		}
+	}
+	h := g.directory
+	g.directory = 0
+	if windows.CloseHandle(h) != nil {
+		return g.cleanupError
+	}
+	h, err = openDatastoreDirectory(g.root, g.record.Generation, nil, false, true)
+	if err != nil {
+		return g.cleanupError
+	}
+	got, e := anchorIdentity(h)
+	if e != nil || got != wantDirectory || verifyPrivate(h, sid, true) != nil {
+		windows.CloseHandle(h)
+		return g.cleanupError
+	}
+	remove := uint32(1)
+	removed := windows.SetFileInformationByHandle(h, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4)
+	closed := windows.CloseHandle(h)
+	if removed != nil || closed != nil || g.closeHandles() != nil {
+		return g.cleanupError
+	}
+	g.closed, g.cleanupError = true, nil
+	if g.owner != nil {
+		g.owner.datastoreActive.Store(false)
+	}
+	return nil
+}
