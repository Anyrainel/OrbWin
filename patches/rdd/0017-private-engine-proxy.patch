+)
+
+func TestHostagentManagementSyntheticChild(t *testing.T) {
+	mode := os.Getenv("ORBWIN_SYNTHETIC_MANAGEMENT_CHILD")
+	if mode == "" {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if mode == "canceled" {
+		cancel()
+	}
+	management, err := OpenHostagentManagement(ctx, os.Getenv("ORBWIN_SYNTHETIC_MANAGEMENT_BINDING"))
+	if mode == "stale-parent" || mode == "canceled" {
+		if err != ErrManagement || management != nil {
+			t.Fatal("stale launcher accepted")
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal("synthetic management refused")
+	}
+	defer management.Close()
+	owner, err := management.Client.ReadApp(ctx)
+	if err != nil || owner.UID != "app-one" {
+		t.Fatal("pinned synthetic management transaction failed")
+	}
+	if management.Binding.HostPID != int64(os.Getpid()) || management.Binding.LimaVMUID != "lima-one" {
+		t.Fatal("child native binding")
+	}
+}
+
+// This creates fresh synthetic state only, at CREATE with an explicit private
+// descriptor. It never calls an OrbWin root resolver or reads actual config.
+func syntheticManagementAnchor(t *testing.T, data []byte) (windows.Handle, hostagentLaunch) {
+	t.Helper()
+	token, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		t.Fatal("token")
+	}
+	defer token.Close()
+	if token.IsElevated() {
+		t.Fatal("requires nonadmin")
+	}
+	user, err := token.GetTokenUser()
+	if err != nil {
+		t.Fatal("owner")
+	}
+	sid := user.User.Sid.String()
+	root, err := os.MkdirTemp("", "orbwin-synthetic-management-")
+	if err != nil {
+		t.Fatal("fresh root")
+	}
+	anchorPath := filepath.Join(root, "anchor")
+	configPath := filepath.Join(anchorPath, "config.yaml")
+	t.Cleanup(func() {
+		for _, p := range []string{configPath, anchorPath, root} {
+			if e := os.Remove(p); e != nil && !os.IsNotExist(e) {
+				t.Error("known synthetic fixture cleanup")
+			}
+		}
+	})
+	directorySD, err := windows.SecurityDescriptorFromString("O:" + sid + "D:P(A;OICI;FA;;;" + sid + ")(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)")
+	if err != nil {
+		t.Fatal("directory descriptor")
+	}
+	sa := windows.SecurityAttributes{Length: uint32(unsafe.Sizeof(windows.SecurityAttributes{})), SecurityDescriptor: directorySD}
+	path, _ := windows.UTF16PtrFromString(anchorPath)
+	if windows.CreateDirectory(path, &sa) != nil {
+		t.Fatal("private directory creation")
+	}
+	runtime.KeepAlive(directorySD)
+	fileSD, err := windows.SecurityDescriptorFromString("O:" + sid + "D:P(A;;FA;;;" + sid + ")(A;;FA;;;SY)(A;;FA;;;BA)")
+	if err != nil {
+		t.Fatal("file descriptor")
+	}
+	sa.SecurityDescriptor = fileSD
+	filePath, _ := windows.UTF16PtrFromString(configPath)
+	file, err := windows.CreateFile(filePath, windows.GENERIC_WRITE, 0, &sa, windows.CREATE_NEW, windows.FILE_ATTRIBUTE_NORMAL|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		t.Fatal("private file creation")
+	}
+	runtime.KeepAlive(fileSD)
+	var n uint32
+	writeErr := windows.WriteFile(file, data, &n, nil)
+	closeErr := windows.CloseHandle(file)
+	if writeErr != nil || closeErr != nil || int(n) != len(data) {
+		t.Fatal("synthetic write")
+	}
+	h, err := windows.CreateFile(path, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		t.Fatal("anchor open")
+	}
+	t.Cleanup(func() { windows.CloseHandle(h) })
+	var inherited windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), h, windows.CurrentProcess(), &inherited, 0, true, windows.DUPLICATE_SAME_ACCESS) != nil {
+		t.Fatal("anchor duplicate")
+	}
+	t.Cleanup(func() { windows.CloseHandle(inherited) })
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(inherited, &info) != nil {
+		t.Fatal("anchor identity")
+	}
+	m := launchFixture()
+	m.Handle = uint64(inherited)
+	m.Volume = info.VolumeSerialNumber
+	m.IndexHigh = info.FileIndexHigh
+	m.IndexLow = info.FileIndexLow
+	return inherited, m
+}
+
+func TestHostagentNativeParentReaderAndPinnedTLSIntegration(t *testing.T) {
+	var requests atomic.Int32
+	owner, vm, _ := selectionFixture()
+	owner.APIVersion = "app.rancherdesktop.io/v1alpha1"
+	owner.Kind = "App"
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if r.Method != "GET" || r.Header.Get("Authorization") != "Bearer private-fixture-token" || r.URL.Path != "/apis/app.rancherdesktop.io/v1alpha1/apps/app" {
+			t.Error("synthetic transaction escaped scope")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(owner)
+	}))
+	defer server.Close()
+	config, err := json.Marshal(managementFixture(t, server))
+	if err != nil {
+		t.Fatal("fixture config")
+	}
+	h, object := syntheticManagementAnchor(t, config)
+	serving, err := NewServingIdentity(server.URL, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	parent, err := CurrentManagementProcess()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"valid", "stale-parent", "canceled"} {
+		metadata, err := serving.launch(owner, vm, parent, "00000000000000000000000000000001")
+		if err != nil {
+			t.Fatal(err)
+		}
+		metadata.Handle = object.Handle
+		metadata.Volume = object.Volume
+		metadata.IndexHigh = object.IndexHigh
+		metadata.IndexLow = object.IndexLow
+		if mode == "stale-parent" {
+			metadata.ParentCreation = "0000000000000001"
+		}
+		argument, err := encodeHostagentLaunch(metadata)
+		if err != nil {
+			t.Fatal(err)
+		}
+		exe, err := os.Executable()
+		if err != nil {
+			t.Fatal("test executable")
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+		cmd := exec.CommandContext(ctx, exe, "-test.run=^TestHostagentManagementSyntheticChild$", "-test.timeout=5s")
+		cmd.Env = []string{"ORBWIN_SYNTHETIC_MANAGEMENT_CHILD=" + mode, "ORBWIN_SYNTHETIC_MANAGEMENT_BINDING=" + argument}
+		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, AdditionalInheritedHandles: []syscall.Handle{syscall.Handle(h)}}
+		var output bytes.Buffer
+		cmd.Stdout = &output
+		cmd.Stderr = &output
+		err = cmd.Run()
+		cancel()
+		if err != nil {
+			t.Fatal("controlled child failed: " + output.String())
+		}
+	}
+	if requests.Load() != 1 {
+		t.Fatal("stale launch contacted API or valid launch failed")
+	}
+}
+
+func TestHostagentPreparationRefusalStillStartsOnlyOriginalCommand(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal("test executable")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, exe, "-test.run=^TestHostagentManagementSyntheticChild$", "-test.timeout=4s")
+	cmd.Env = []string{}
+	bound, err := StartHostagent(ctx, cmd, nil, nil, nil, ManagementInstanceRoot{})
+	if err != nil || bound {
+		t.Fatal("proxy refusal disrupted original launch")
+	}
+	if err := cmd.Wait(); err != nil {
+		t.Fatal("original child failed")
+	}
+	if err := cmd.Start(); err == nil {
+		t.Fatal("original command launched more than once")
+	}
+}
