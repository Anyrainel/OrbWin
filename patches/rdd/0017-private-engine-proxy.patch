+type proxyConflictClient struct {
+	client.Client
+	patches int
+	before  func()
+}
+type proxyConflictWriter struct {
+	client.SubResourceWriter
+	owner *proxyConflictClient
+}
+
+func (c *proxyConflictClient) Status() client.SubResourceWriter {
+	return &proxyConflictWriter{SubResourceWriter: c.Client.Status(), owner: c}
+}
+func (w *proxyConflictWriter) Patch(ctx context.Context, obj client.Object, patch client.Patch, options ...client.SubResourcePatchOption) error {
+	w.owner.patches++
+	if w.owner.before != nil {
+		before := w.owner.before
+		w.owner.before = nil
+		before()
+	}
+	return w.SubResourceWriter.Patch(ctx, obj, patch, options...)
+}
