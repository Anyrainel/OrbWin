+func TestFixedProxyEndpointMatchesExistingGuestContract(t *testing.T) {
+	u, err := url.Parse(GuestProxyEndpoint)
+	if err != nil || u.Port() != EngineProxyPort || u.Scheme != "http" || u.Hostname() != "gateway.docker.internal" {
+		t.Fatal("private host listener and guest endpoint drifted")
+	}
+}
+
+func TestLaunchObservationRejectsStaleOwnerAndMalformedNativeBinding(t *testing.T) {
+	owner, vm, native := selectionFixture()
+	receipt := lima.NetworkProxyLaunchObservation{AppUID: string(owner.UID), LimaVMUID: string(vm.UID), HostPID: native.HostPID, HostCreationTime: native.HostCreationTime, TransportEpoch: native.TransportEpoch, Session: 1}
+	if binding, err := LaunchBinding(owner, vm, &receipt); err != nil || binding != native {
+		t.Fatal("valid launch receipt refused", err)
+	}
+	for name, mutate := range map[string]func(*lima.NetworkProxyLaunchObservation){
+		"App replacement": func(r *lima.NetworkProxyLaunchObservation) { r.AppUID = "replacement" },
+		"VM replacement":  func(r *lima.NetworkProxyLaunchObservation) { r.LimaVMUID = "replacement" },
+		"PID zero":        func(r *lima.NetworkProxyLaunchObservation) { r.HostPID = 0 },
+		"creation zero":   func(r *lima.NetworkProxyLaunchObservation) { r.HostCreationTime = strings.Repeat("0", 16) },
+		"epoch zero":      func(r *lima.NetworkProxyLaunchObservation) { r.TransportEpoch = strings.Repeat("0", 32) },
+		"session zero":    func(r *lima.NetworkProxyLaunchObservation) { r.Session = 0 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := receipt
+			mutate(&bad)
+			if _, err := LaunchBinding(owner, vm, &bad); err == nil {
+				t.Fatal("stale launch accepted")
+			}
+		})
+	}
+	other := vm.DeepCopy()
+	other.Namespace = "other"
+	if _, err := LaunchBinding(owner, other, &receipt); err == nil {
+		t.Fatal("namespace substitution accepted")
+	}
+}
