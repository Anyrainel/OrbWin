+// SPDX-License-Identifier: Apache-2.0
+
+package datastore
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/client/pkg/v3/transport"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/peer"
+	"google.golang.org/grpc/test/bufconn"
+	utilnet "k8s.io/apimachinery/pkg/util/net"
+	"k8s.io/apiserver/pkg/server/egressselector"
+	"k8s.io/apiserver/pkg/storage/storagebackend"
+	"k8s.io/apiserver/pkg/storage/storagebackend/factory"
+)
+
+// These synthetic test credentials authorize only the memory listener in this
+// test process. Ordinary temporary files exercise upstream TLSInfo's REAL file
+// loaders; they do not qualify production private-file creation or ACL policy.
+func privateClientFiles(t *testing.T, material PrivateTransportFiles) transport.TLSInfo {
+	t.Helper()
+	dir := t.TempDir()
+	for name, data := range map[string][]byte{
+		"ca.crt": material.CA, "client.crt": material.ClientCertificate, "client.key": material.ClientKey,
+	} {
+		if err := os.WriteFile(filepath.Join(dir, name), data, 0o600); err != nil {
+			t.Fatal("synthetic transport fixture creation failed")
+		}
+	}
+	return transport.TLSInfo{
+		TrustedCAFile: filepath.Join(dir, "ca.crt"),
+		CertFile:      filepath.Join(dir, "client.crt"), KeyFile: filepath.Join(dir, "client.key"),
+	}
+}
+
+type privateContractKV struct {
+	etcdserverpb.UnimplementedKVServer
+	client [32]byte
+	seen   chan struct{}
+}
+
+func (s *privateContractKV) Range(ctx context.Context, request *etcdserverpb.RangeRequest) (*etcdserverpb.RangeResponse, error) {
+	p, ok := peer.FromContext(ctx)
+	if !ok {
+		return nil, errors.New("private peer missing")
+	}
+	tlsPeer, ok := p.AuthInfo.(credentials.TLSInfo)
+	if !ok || len(tlsPeer.State.VerifiedChains) == 0 || len(tlsPeer.State.PeerCertificates) != 1 ||
+		sha256.Sum256(tlsPeer.State.PeerCertificates[0].Raw) != s.client || string(request.Key) != "/orbwin-private-kine-contract/health" {
+		return nil, errors.New("private peer or health scope differs")
+	}
+	select {
+	case s.seen <- struct{}{}:
+	default:
+	}
+	return &etcdserverpb.RangeResponse{Header: &etcdserverpb.ResponseHeader{Revision: 1}}, nil
+}
+
+func TestPrivateClientActualApiserverProber(t *testing.T) {
+	p := privateFixture(t)
+	info := privateClientFiles(t, p.Files())
+	clientTLS, err := p.ClientTLSConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := p.NewGRPCServer()
+	if err != nil {
+		t.Fatal(err)
+	}
+	service := &privateContractKV{client: sha256.Sum256(clientTLS.Certificates[0].Certificate[0]), seen: make(chan struct{}, 1)}
+	etcdserverpb.RegisterKVServer(server, service)
+	listener := bufconn.Listen(64 << 10)
+	done := make(chan error, 1)
+	go func() { done <- server.Serve(listener) }()
+	defer func() { server.Stop(); _ = listener.Close(); <-done }()
+	config := storagebackend.Config{
+		Prefix: "orbwin-private-kine-contract",
+		Transport: storagebackend.TransportConfig{
+			ServerList: []string{"https://127.0.0.1:2379"},
+			CertFile:   info.CertFile, KeyFile: info.KeyFile, TrustedCAFile: info.TrustedCAFile,
+			EgressLookup: func(n egressselector.NetworkContext) (utilnet.DialFunc, error) {
+				if n != egressselector.Etcd.AsNetworkContext() {
+					return nil, errors.New("unexpected egress selection")
+				}
+				return func(ctx context.Context, network, address string) (net.Conn, error) {
+					if network != "tcp" || address != "127.0.0.1:2379" {
+						return nil, errors.New("unexpected dial target")
+					}
+					// All actual client dials terminate in this memory-only listener.
+					return listener.DialContext(ctx)
+				}, nil
+			},
+		},
+	}
+	prober, err := factory.CreateProber(config)
+	if err != nil {
+		t.Fatal("actual apiserver etcd constructor failed", err)
+	}
+	defer func() {
+		if err := prober.Close(); err != nil {
+			t.Error("actual client close failed", err)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := prober.Probe(ctx); err != nil {
+		t.Fatal("actual apiserver client could not use dedicated TLS files", err)
+	}
+	select {
+	case <-service.seen:
+	default:
+		t.Fatal("no authenticated scoped Range request observed")
+	}
+}
+
+func TestPrivateClientUpstreamTLSInfoTrustBoundary(t *testing.T) {
+	p, foreign := privateFixture(t), privateFixture(t)
+	for _, name := range []string{"valid", "no-client", "foreign-client", "foreign-ca", "wrong-server-name"} {
+		t.Run(name, func(t *testing.T) {
+			material := p.Files()
+			if name == "foreign-client" {
+				f := foreign.Files()
+				material.ClientCertificate, material.ClientKey = f.ClientCertificate, f.ClientKey
+			}
+			if name == "foreign-ca" {
+				material.CA = foreign.Files().CA
+			}
+			info := privateClientFiles(t, material)
+			if name == "no-client" {
+				info.CertFile, info.KeyFile = "", ""
+			}
+			config, err := info.ClientConfig()
+			if err != nil {
+				t.Fatal("upstream file constructor failed", err)
+			}
+			if config.InsecureSkipVerify || config.RootCAs == nil || config.VerifyConnection != nil {
+				t.Fatal("actual CA-only constructor behavior changed")
+			}
+			// gRPC derives this name from the fixed endpoint in the real client;
+			// direct memory TLS exchanges must supply it explicitly.
+			config.ServerName = "127.0.0.1"
+			if name == "wrong-server-name" {
+				config.ServerName = "127.0.0.2"
+			}
+			server, err := p.ServerTLSConfig()
+			if err != nil {
+				t.Fatal(err)
+			}
+			a, b := privateExchange(server, config)
+			if name == "valid" {
+				if a != nil || b != nil {
+					t.Fatal("matching CA-only client refused", a, b)
+				}
+			} else if a == nil && b == nil {
+				t.Fatal("untrusted upstream client accepted")
+			}
+			for _, err := range []error{a, b} {
+				if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+					t.Fatal("timeout is not authentication refusal evidence", a, b)
+				}
+			}
+		})
+	}
+}
