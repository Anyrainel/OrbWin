+
+	protocol "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol"
+)
+
+func TestGuestRegistrationUTF16RefusesAmbiguousNativeIdentity(t *testing.T) {
+	for _, units := range [][]uint16{{0xd800}, {0xdc00}, {'a', 0, 'b'}, {0xd800, 'x'}, {0xd800, 0xd800}} {
+		if _, ok := guestRegistryText(units); ok {
+			t.Fatal("malformed registry identity accepted")
+		}
+	}
+	if value, ok := guestRegistryText([]uint16{'a', 0xd83d, 0xde00}); !ok || value != "a😀" {
+		t.Fatal("valid supplementary character refused")
+	}
+}
+
+func TestGuestRegistrationExactVersionBaseAndName(t *testing.T) {
+	guid := "{11111111-1111-1111-1111-111111111111}"
+	base := `C:\Users\fixture0\AppData\Local\OrbWinData\home\.rdorbwin\lima\orbwin`
+	if !guestRegistrationValue(guid, "lima-orbwin", `\\?\`+base, "lima-orbwin", base, 2) {
+		t.Fatal("native drive path selection refused")
+	}
+	for name, changed := range map[string]string{"UNC": `\\server\share\orbwin`, "device": `\\.\C:\orbwin`, "ADS": base + ":stream", "traversal": base + `\..\orbwin`, "trailing dot": base + ".", "slash traversal": base + `/../orbwin`, "drive relative": `C:orbwin`} {
+		t.Run(name, func(t *testing.T) {
+			if guestRegistrationValue(guid, "lima-orbwin", changed, "lima-orbwin", base, 2) {
+				t.Fatal("malformed native base accepted")
+			}
+		})
+	}
+	if guestRegistrationValue(guid, "lima-other", base, "lima-orbwin", base, 2) || guestRegistrationValue(guid, "lima-orbwin", base, "lima-orbwin", base, 1) || guestRegistrationValue("{00000000-0000-0000-0000-000000000000}", "lima-orbwin", base, "lima-orbwin", base, 2) {
+		t.Fatal("foreign/version/zero identity accepted")
+	}
+}
+func TestNoneCurrentAbsentReceiptIsTypedAndNeverURLSuccess(t *testing.T) {
+	owner := desiredFixture(t, "none")
+	owner.Status.NetworkProxy.ManagedEver = true
+	attachPlan(owner, "disable")
+	tx, err := NewGuestTransaction(owner, bindingFixture(), guestIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := GuestProtocolRequest(tx)
+	receipt := r.Receipt(protocol.AbsentDirect)
+	receipt.ConfigHash = protocol.Hash(nil)
+	receipt.RuntimeHash = protocol.DirectRuntimeHash()
+	receipt.SettlementHash = strings.Repeat("a", 64)
+	converted, err := GuestReceiptFromProtocol(tx, receipt)
+	if err != nil || !converted.Applied || converted.Disposition != protocol.AbsentDirect {
+		t.Fatal("current None absent/direct proof refused", err)
+	}
+	url := desiredFixture(t, "url")
+	attachPlan(url, "prepare")
+	urlTx, err := NewGuestTransaction(url, bindingFixture(), guestIdentity())
+	if err != nil {
+		t.Fatal(err)
+	}
+	r = GuestProtocolRequest(urlTx)
+	receipt = r.Receipt(protocol.AbsentDirect)
+	receipt.ConfigHash = protocol.Hash(nil)
+	receipt.RuntimeHash = protocol.DirectRuntimeHash()
+	receipt.SettlementHash = strings.Repeat("a", 64)
+	if _, err := GuestReceiptFromProtocol(urlTx, receipt); err == nil {
+		t.Fatal("URL claimed absent/direct acknowledgement")
+	}
+}
diff --git a/rdd/pkg/networkproxy/guest_identity_windows.go b/rdd/pkg/networkproxy/guest_identity_windows.go
new file mode 100644
index 0000000..f65fbe1
--- /dev/null
+++ b/rdd/pkg/networkproxy/guest_identity_windows.go
@@ -0,0 +1,107 @@
+//go:build windows
+
+package networkproxy
+
+import (
+	"context"
+	"encoding/binary"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/registry"
+)
+
+// ObserveGuestRegistration is a fixed read-only identity fence. Only the selected
+// backend may supply instance name/base. It never starts WSL. Pinned Lima's
+// GetDistroID establishes this same name relation but enumerates unbounded keys,
+// accepts a first match and lacks base/version checks; this narrow read refuses
+// duplicate/stale/malformed identity. No actual registry fixture runs here.
+func ObserveGuestRegistration(ctx context.Context, instanceName, expectedBase string) (string, error) {
+	if ctx == nil || ctx.Err() != nil || instanceName != "orbwin" {
+		return "", ErrProxyOwner
+	}
+	if _, ok := guestNativePath(expectedBase); !ok {
+		return "", ErrProxyOwner
+	}
+	root, err := registry.OpenKey(registry.CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`, registry.ENUMERATE_SUB_KEYS|registry.QUERY_VALUE)
+	if err != nil {
+		return "", ErrProxyOwner
+	}
+	defer root.Close()
+	selected := ""
+	for index := uint32(0); index <= 512; index++ {
+		if ctx.Err() != nil {
+			return "", ErrProxyOwner
+		}
+		var name [64]uint16
+		size := uint32(len(name))
+		err := windows.RegEnumKeyEx(windows.Handle(root), index, &name[0], &size, nil, nil, nil, nil)
+		if err == windows.ERROR_NO_MORE_ITEMS {
+			return selected, func() error {
+				if selected == "" {
+					return ErrProxyOwner
+				}
+				return nil
+			}()
+		}
+		if err != nil || index == 512 || size == 0 || size >= uint32(len(name)) {
+			return "", ErrProxyOwner
+		}
+		guid := windows.UTF16ToString(name[:size])
+		if len(guid) != 38 || guid[0] != '{' || guid[37] != '}' {
+			continue
+		}
+		key, err := registry.OpenKey(root, guid, registry.QUERY_VALUE)
+		if err != nil {
+			return "", ErrProxyOwner
+		}
+		read := func() (string, string, uint32, error) {
+			distro, err := guestRegistryString(key, "DistributionName")
+			if err != nil {
+				return "", "", 0, err
+			}
+			base, err := guestRegistryString(key, "BasePath")
+			if err != nil {
+				return "", "", 0, err
+			}
+			var data [4]byte
+			n := uint32(4)
+			kind := uint32(0)
+			value, _ := windows.UTF16PtrFromString("Version")
+			if windows.RegQueryValueEx(windows.Handle(key), value, nil, &kind, &data[0], &n) != nil || n != 4 || kind != windows.REG_DWORD {
+				return "", "", 0, ErrProxyOwner
+			}
+			return distro, base, binary.LittleEndian.Uint32(data[:]), nil
+		}
+		distro, base, version, err := read()
+		if err != nil {
+			key.Close()
+			return "", ErrProxyOwner
+		}
+		if distro == "lima-"+instanceName {
+			againName, againBase, againVersion, againErr := read()
+			if selected != "" || againErr != nil || againName != distro || againBase != base || againVersion != version || !guestRegistrationValue(guid, distro, base, "lima-"+instanceName, expectedBase, version) {
+				key.Close()
+				return "", ErrProxyOwner
+			}
+			selected = strings.ToLower(guid)
+		}
+		key.Close()
+	}
+	return "", ErrProxyOwner
+}
+func guestRegistryString(key registry.Key, label string) (string, error) {
+	var buffer [1024]uint16
+	name, _ := windows.UTF16PtrFromString(label)
+	n := uint32(len(buffer) * 2)
+	kind := uint32(0)
+	if windows.RegQueryValueEx(windows.Handle(key), name, nil, &kind, (*byte)(unsafe.Pointer(&buffer[0])), &n) != nil || kind != windows.REG_SZ || n < 2 || n > uint32(len(buffer)*2) || n%2 != 0 || buffer[n/2-1] != 0 {
+		return "", ErrProxyOwner
+	}
+	text, ok := guestRegistryText(buffer[:n/2-1])
+	if !ok {
+		return "", ErrProxyOwner
+	}
+	return text, nil
+}
