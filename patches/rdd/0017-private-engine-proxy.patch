diff --git a/rdd/pkg/managementconfig/initialization.go b/rdd/pkg/managementconfig/initialization.go
new file mode 100644
index 0000000..c124caa
--- /dev/null
+++ b/rdd/pkg/managementconfig/initialization.go
@@ -0,0 +1,40 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// Fixed initialization marker is private derived state, not proxy desired
+// configuration or an assertion of historical installation. It binds the exact
+// saved service arguments to this explicitly created private authority.
+type initializationRecord struct {
+	Schema   int    `json:"schema"`
+	ArgsHash string `json:"argsHash"`
+}
+
+func initializationBytes(args []byte) ([]byte, error) {
+	if len(args) < 1 || len(args) > 65536 {
+		return nil, ErrPublication
+	}
+	var flags []string
+	if json.Unmarshal(args, &flags) != nil || flags == nil || len(flags) > 128 {
+		return nil, ErrPublication
+	}
+	for _, flag := range flags {
+		if len(flag) > 4096 {
+			return nil, ErrPublication
+		}
+	}
+	digest := sha256.Sum256(args)
+	return json.Marshal(initializationRecord{1, hex.EncodeToString(digest[:])})
+}
+func validateInitialization(record, args []byte) error {
+	want, e := initializationBytes(args)
+	if e != nil || !bytes.Equal(record, want) {
+		return ErrPublication
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/initialization_test.go b/rdd/pkg/managementconfig/initialization_test.go
new file mode 100644
index 0000000..4ffa0e1
--- /dev/null
+++ b/rdd/pkg/managementconfig/initialization_test.go
@@ -0,0 +1,30 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestPrivateInitializationBindsExactArgsAndClosedRecord(t *testing.T) {
+	args := []byte(`["--secure-port","6443"]`)
+	record, e := initializationBytes(args)
+	if e != nil || validateInitialization(record, args) != nil {
+		t.Fatal("exact private initialization refused")
+	}
+	for _, changed := range [][]byte{[]byte(`["--secure-port","6444"]`), []byte("[\"--secure-port\", \"6443\"]"), []byte("null"), []byte(`{"args":[]}`), bytes.Repeat([]byte{'x'}, 65537)} {
+		if validateInitialization(record, changed) == nil {
+			t.Fatal("foreign or malformed argument state adopted")
+		}
+	}
+	for _, changed := range [][]byte{append(append([]byte{}, record...), byte('\n')), []byte(`{"schema":1,"argsHash":"forged"}`), []byte(`{"schema":1,"argsHash":"x","schema":1}`)} {
+		if validateInitialization(changed, args) == nil {
+			t.Fatal("partial/noncanonical initialization adopted")
+		}
+	}
+	oversized, _ := json.Marshal([]string{strings.Repeat("x", 4097)})
+	if _, e := initializationBytes(oversized); e == nil {
+		t.Fatal("argument exceeded bound")
+	}
+}
diff --git a/rdd/pkg/managementconfig/initialization_windows.go b/rdd/pkg/managementconfig/initialization_windows.go
new file mode 100644
index 0000000..8b37788
--- /dev/null
+++ b/rdd/pkg/managementconfig/initialization_windows.go
@@ -0,0 +1,219 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+var ErrDefaultsAbsent = errors.New("private default authority not yet prepared")
+
+// InitializeInstance is the fixed existing Create entrypoint, before args.json.
+// No arbitrary root/suffix, OPEN_ALWAYS adoption, existing-state ACL repair or
+// cleanup of failed legacy state. It never starts a service or opens credentials.
+func InitializeInstance(ctx context.Context, home, suffix string, args []byte) error {
+	record, e := initializationBytes(args)
+	if e != nil {
+		return ErrPublication
+	}
+	root, e := ResolveOrbWinRoot(home, suffix)
+	if e != nil {
+		return ErrPublication
+	}
+	parent, e := openInstanceParent(ctx, root, true)
+	if e != nil {
+		return ErrPublication
+	}
+	defer parent.Close()
+	c, e := createFreshAuthority(ctx, parent)
+	if e != nil {
+		return ErrPublication
+	}
+	defer c.Close()
+	if c.acquireServiceOwner(ctx) != nil || c.writeNewFixed(ctx, "args.json", args) != nil || c.writeNewFixed(ctx, "authority.init", record) != nil {
+		return ErrPublication
+	}
+	return nil
+}
+
+// OpenInitialized is also valid before key generation. All three absent keys
+// are a current preparation state only under the retained sole-service lease;
+// mixed or malformed files refuse. This does not adopt an existing unsafe home.
+func OpenInitialized(ctx context.Context, home, suffix string) (*Created, error) {
+	root, e := ResolveOrbWinRoot(home, suffix)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	parents, e := OpenInstanceParent(ctx, root)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	if walkRelative(ctx, parents, []string{anchorName}) != nil {
+		parents.Close()
+		return nil, ErrPublication
+	}
+	var anchor windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), parents.leaf(), windows.CurrentProcess(), &anchor, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		parents.Close()
+		return nil, ErrPublication
+	}
+	c := &Created{parents: parents, parent: parents.leaf(), anchor: anchor, servingLease: true}
+	if c.acquireServiceOwner(ctx) != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	args, e := c.readFixed(ctx, "args.json", 65536)
+	if e != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	defer clear(args)
+	record, e := c.readFixed(ctx, "authority.init", 1024)
+	if e != nil || validateInitialization(record, args) != nil {
+		c.Close()
+		return nil, ErrPublication
+	}
+	return c, nil
+}
+func (c *Created) acquireServiceOwner(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil || c == nil || c.anchor == 0 {
+		return ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(c.anchor, sid, true) != nil {
+		return ErrPublication
+	}
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		return ErrPublication
+	}
+	h, e := authorityOpen(c.anchor, "authority.owner.lock", sd, windows.FILE_OPEN_IF, windows.GENERIC_READ|windows.GENERIC_WRITE|windows.READ_CONTROL, 0)
+	if e != nil {
+		return ErrPublication
+	}
+	var info windows.ByHandleFileInformation
+	if verifyPrivate(h, sid, false) != nil || windows.GetFileInformationByHandle(h, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow != 0 {
+		windows.CloseHandle(h)
+		return ErrPublication
+	}
+	c.authorityHandles = append(c.authorityHandles, h)
+	return nil
+}
+func (c *Created) writeNewFixed(ctx context.Context, name string, data []byte) (err error) {
+	// All callers are package-private fixed-role methods, never renderer names.
+	if c == nil || c.closed || c.anchor == 0 || ctx == nil || ctx.Err() != nil || len(data) < 1 || len(data) > MaxConfigBytes {
+		return ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, e := currentOwner()
+	if e != nil {
+		return ErrPublication
+	}
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		return ErrPublication
+	}
+	h, e := authorityOpen(c.anchor, name, sd, windows.FILE_CREATE, windows.GENERIC_WRITE|windows.READ_CONTROL, 0)
+	if e != nil {
+		return ErrPublication
+	}
+	defer func() {
+		if windows.CloseHandle(h) != nil {
+			err = ErrPublication
+		}
+	}()
+	if verifyPrivate(h, sid, false) != nil {
+		return ErrPublication
+	}
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return ErrPublication
+		}
+		n, e := nativeWrite(h, remaining)
+		if e != nil || n < 1 || n > len(remaining) {
+			return ErrPublication
+		}
+		remaining = remaining[n:]
+	}
+	if ctx.Err() != nil || windows.FlushFileBuffers(h) != nil {
+		return ErrPublication
+	}
+	return nil
+}
+func (c *Created) readFixed(ctx context.Context, name string, limit int64) (data []byte, err error) {
+	if c == nil || c.closed || c.anchor == 0 || ctx == nil || ctx.Err() != nil {
+		return nil, ErrPublication
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	h, e := openRelative(c.anchor, name, false, nil, false)
+	if e != nil {
+		return nil, e
+	}
+	defer func() {
+		if windows.CloseHandle(h) != nil {
+			clear(data)
+			data = nil
+			err = ErrPublication
+		}
+	}()
+	sid, e := currentOwner()
+	if e != nil || verifyPrivate(h, sid, false) != nil {
+		return nil, ErrPublication
+	}
+	data, e = authorityRead(h, limit)
+	if e != nil || ctx.Err() != nil {
+		clear(data)
+		return nil, ErrPublication
+	}
+	return data, nil
+}
+
+// LoadDefaultAuthority returns bytes only to the owning service generator seam;
+// no diagnostics/JSON/export method exists. Caller must clear private slices.
+func (c *Created) LoadDefaultAuthority(ctx context.Context) (cert, key, sa []byte, err error) {
+	if c == nil || ctx == nil || ctx.Err() != nil {
+		return nil, nil, nil, ErrPublication
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, nil, nil, ErrPublication
+	}
+	dir, e := openRelative(c.anchor, "tls", true, nil, false)
+	if e != nil {
+		return nil, nil, nil, ErrPublication
+	}
+	child := &Created{anchor: dir}
+	defer windows.CloseHandle(dir)
+	values := make([][]byte, 3)
+	absent := 0
+	for i, name := range []string{"apiserver.crt", "apiserver.key", "sa.key"} {
+		values[i], e = child.readFixed(ctx, name, 64<<10)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			absent++
+		} else if e != nil {
+			for _, v := range values {
+				clear(v)
+			}
+			return nil, nil, nil, ErrPublication
+		}
+	}
+	if absent == 3 {
+		return nil, nil, nil, ErrDefaultsAbsent
+	}
+	if absent != 0 || validateAuthorityMaterial(values[0], values[1], values[2]) != nil {
+		for _, v := range values {
+			clear(v)
+		}
+		return nil, nil, nil, ErrPublication
+	}
+	return values[0], values[1], values[2], nil
+}
diff --git a/rdd/pkg/managementconfig/parent_lease_windows_test.go b/rdd/pkg/managementconfig/parent_lease_windows_test.go
new file mode 100644
index 0000000..4b3edcc
--- /dev/null
+++ b/rdd/pkg/managementconfig/parent_lease_windows_test.go
@@ -0,0 +1,60 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"os"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestParentLeaseActuallyConflictsWithPriorDeleteAndBlocksRename(t *testing.T) {
+	dir, e := os.MkdirTemp("", "orbwin-parent-lease-")
+	if e != nil {
+		t.Fatal("fresh lease fixture unavailable")
+	}
+	t.Cleanup(func() {
+		if e := os.Remove(dir); e != nil {
+			t.Error("lease fixture cleanup failed")
+		}
+	})
+	p, _ := windows.UTF16PtrFromString(dir)
+	prior, e := windows.CreateFile(p, windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e != nil {
+		t.Fatal("fresh prior-delete fixture unavailable")
+	}
+	metadata, e := windows.CreateFile(p, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e == nil {
+		windows.CloseHandle(metadata)
+		t.Log("metadata-only handle did not conflict with prior DELETE; not a parent lease")
+	}
+	lease, e := windows.CreateFile(p, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e == nil {
+		windows.CloseHandle(lease)
+		windows.CloseHandle(prior)
+		t.Fatal("directory read lease admitted prior DELETE")
+	}
+	windows.CloseHandle(prior)
+	lease, e = windows.CreateFile(p, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if e != nil {
+		t.Fatal("directory read lease refused after prior handle retired")
+	}
+	var retained windows.Handle
+	if windows.DuplicateHandle(windows.CurrentProcess(), lease, windows.CurrentProcess(), &retained, 0, false, windows.DUPLICATE_SAME_ACCESS) != nil {
+		windows.CloseHandle(lease)
+		t.Fatal("parent lease retention failed")
+	}
+	windows.CloseHandle(lease)
+	lease = retained
+	if os.Rename(dir, dir+"-moved") == nil {
+		windows.CloseHandle(lease)
+		os.Rename(dir+"-moved", dir)
+		t.Fatal("held parent lease allowed rename")
+	}
+	if os.Remove(dir) == nil {
+		windows.CloseHandle(lease)
+		t.Fatal("held parent lease allowed delete")
+	}
+	windows.CloseHandle(lease)
+}
diff --git a/rdd/pkg/managementconfig/preflight.go b/rdd/pkg/managementconfig/preflight.go
new file mode 100644
index 0000000..6bf4186
--- /dev/null
+++ b/rdd/pkg/managementconfig/preflight.go
@@ -0,0 +1,41 @@
+package managementconfig
+
+import (
+	"encoding/json"
+	"strconv"
+)
+
+// AuthorityPreflight is a bounded compatibility observation, never a readiness
+// or ownership grant. No credential, native identity or path is exported.
+type AuthorityPreflight struct {
+	Schema            int    `json:"schema"`
+	Instance          string `json:"instance"`
+	Authority         string `json:"authority"`
+	StartupCompatible bool   `json:"startupCompatible"`
+}
+
+func preflightResult(state string, compatible bool) AuthorityPreflight {
+	return AuthorityPreflight{1, "orbwin", state, compatible}
+}
+
+// Closed saved-argument policy intentionally does not construct service options:
+// NewOptions probes a native loopback port. Unknown customization must be
+// reviewed before replacing a running service, rather than silently ignored.
+func privateStartupArguments(data []byte) bool {
+	if len(data) == 0 || len(data) > 65536 {
+		return false
+	}
+	var args []string
+	if json.Unmarshal(data, &args) != nil || len(args) < 2 || len(args) > 4 || args[0] != "--secure-port" {
+		return false
+	}
+	port, err := strconv.ParseUint(args[1], 10, 16)
+	if err != nil || port == 0 || strconv.FormatUint(port, 10) != args[1] {
+		return false
+	}
+	if len(args) == 2 {
+		return true
+	}
+	const controllers = "*,-path-management"
+	return len(args) == 3 && args[2] == "--controllers="+controllers || len(args) == 4 && args[2] == "--controllers" && args[3] == controllers
+}
