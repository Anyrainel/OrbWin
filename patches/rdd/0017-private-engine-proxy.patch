+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: time.Second}
+	// The fake hostname is request authority only: the selected URL proxy is
+	// the parent's owned literal-loopback httptest endpoint. No target DNS/dial.
+	response, err := client.Get("http://synthetic.invalid/flow")
