+package networkproxy
+
+import (
+	"context"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestForwardServerContinueAndStreamedTrailersResolveOnce(t *testing.T) {
+	var decisions, calls atomic.Int32
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil || string(body) != "streamed-upload" || r.Trailer.Get("X-Checksum") != "owned-checksum" || r.Header.Get("Expect") != "" {
+			t.Error("continued request/trailer changed", err)
+		}
+		w.Header().Set("Trailer", "X-Result")
+		io.WriteString(w, "streamed-response")
+		w.Header().Set("X-Result", "owned-result")
+	}))
+	defer upstream.Close()
+	policy, _ := New(Config{Version: 1, Mode: "auto"}, autoFunc(func(_ context.Context, u *url.URL) ([]Route, error) {
+		decisions.Add(1)
+		if u.Host != "destination.example" {
+			t.Error("decision authority changed")
+		}
+		return []Route{{Proxy: upstream.URL}}, nil
+	}))
+	listener, cancel, done := proxyServerFixture(t, policy, "127.0.0.1")
+	connection, reader := sendProxyFixture(t, listener, "POST http://destination.example/upload HTTP/1.1\r\nHost: destination.example\r\nExpect: 100-continue\r\nTransfer-Encoding: chunked\r\nTrailer: X-Checksum\r\n\r\n")
+	interim, err := http.ReadResponse(reader, nil)
+	if err != nil || interim.StatusCode != 100 {
+		t.Fatal("continue handshake deadlocked/refused", err)
+	}
+	io.WriteString(connection, "f\r\nstreamed-upload\r\n0\r\nX-Checksum: owned-checksum\r\n\r\n")
