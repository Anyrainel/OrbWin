+++ b/rdd/pkg/controllers/app/app/controllers/proxy_pending.go
@@ -0,0 +1,61 @@
+package controllers
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	ctrl "sigs.k8s.io/controller-runtime"
+)
+
+type proxyObservationPending struct{ after time.Duration }
+
+func (*proxyObservationPending) Error() string {
+	return "selected proxy transaction awaits daemon observation"
+}
+
+type proxyObservationBudget struct {
+	plan     app.NetworkProxyPlan
+	deadline time.Time
+}
+
+// One serial App reconciler owns one current plan's observation budget. This
+// requeues only a closed Pending result, never a generic source/native failure.
+// Expiry stays latched for the same plan; unrelated API events cannot restart it.
+func (r *AppReconciler) pendingProxyObservation(ctx context.Context, visible, current *app.App, state *app.NetworkProxyControllerStatus) error {
+	if state == nil || state.Plan == nil {
+		return r.writeProxyState(ctx, visible, current, state, "Unavailable")
+	}
+	now := time.Now()
+	if r.proxyNow != nil {
+		now = r.proxyNow()
+	}
+	if r.proxyObservation == nil || r.proxyObservation.plan != *state.Plan {
+		r.proxyObservation = &proxyObservationBudget{*state.Plan, now.Add(60 * time.Second)}
+	}
+	if !now.Before(r.proxyObservation.deadline) {
+		return r.writeProxyState(ctx, visible, current, state, "Unavailable")
+	}
+	if err := r.writeProxyState(ctx, visible, current, state, "Pending"); err != nil {
+		return err
+	}
+	return &proxyObservationPending{after: time.Second}
+}
+
+func (r *AppReconciler) reconcileProxyObservation(ctx context.Context, owner *app.App, vm *lima.LimaVM) (time.Duration, error) {
+	err := r.reconcileNetworkProxy(ctx, owner, vm)
+	var pending *proxyObservationPending
+	if errors.As(err, &pending) {
+		return pending.after, nil
+	}
+	return 0, err
+}
+
+func mergeProxyObservationRequeue(result ctrl.Result, err error, after time.Duration) ctrl.Result {
+	if err == nil && after > 0 && (result.RequeueAfter == 0 || result.RequeueAfter > after) {
+		result.RequeueAfter = after
+	}
+	return result
+}
