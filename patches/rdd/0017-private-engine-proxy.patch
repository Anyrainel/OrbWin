+const fixedProxyGuestCommand = "/usr/bin/sudo -n -- /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C /usr/local/bin/rdd-guest network-proxy-transaction"
+
+type proxyGuestSelection struct {
+	owner    *app.App
+	vm       *lima.LimaVM
+	binding  app.NetworkProxyBinding
+	instance *limatype.Instance
+	guid     string
+}
+type fixedProxyGuestAdapter struct {
+	// No queue: existing AppReconciler is serial; unexpected parallel calls
+	// refuse instead of accumulating root helpers or competing writer owners.
+	mu            sync.Mutex
+	selectCurrent func(context.Context, *lima.LimaVM) (proxyGuestSelection, error)
+	run           func(context.Context, *limatype.Instance, protocol.Message) (protocol.MessageResult, error)
+	selection     *proxyGuestSelection
+	identity      networkproxy.GuestIdentity
+	helperSHA256  string
+}
+
+// Only an embedded manager with the retained private service authority and an
+// actual bundled helper may register this adapter. The helper's executing image
+// must still match on each observe/apply before guest mutation is admitted.
+func (r *AppReconciler) configurePrivateProxyGuest() {
+	if privateProxyGuestRegistration(runtime.GOOS, instance.Suffix(), r.ProxyAPIReader != nil, r.ProxyServing.HasRetainedAnchorFactory(), len(embedded.RDDGuest)) {
+		r.ProxyGuest = r.newFixedProxyGuestTransactions()
+	}
+}
+
+func privateProxyGuestRegistration(platform, suffix string, reader, authority bool, helperSize int) bool {
+	return platform == "windows" && suffix == "orbwin" && reader && authority && helperSize > 0
+}
+
+// Construction performs no API/native/config read or subprocess action.
+func (r *AppReconciler) newFixedProxyGuestTransactions() networkproxy.FixedGuestTransactions {
+	expectedHelper := ""
+	if len(embedded.RDDGuest) > 0 {
+		expectedHelper = protocol.Hash(embedded.RDDGuest)
+	}
+	return &fixedProxyGuestAdapter{run: runFixedProxyGuest, helperSHA256: expectedHelper, selectCurrent: func(ctx context.Context, expected *lima.LimaVM) (proxyGuestSelection, error) {
+		var empty proxyGuestSelection
+		reader := r.ProxyAPIReader
+		if reader == nil {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		if expected == nil || expected.Name != "orbwin" || instance.Suffix() != "orbwin" {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		owner := &app.App{}
+		vm := &lima.LimaVM{}
+		if reader.Get(ctx, client.ObjectKey{Name: "app"}, owner) != nil || reader.Get(ctx, client.ObjectKeyFromObject(expected), vm) != nil || vm.UID != expected.UID || !owner.Spec.Running || !vm.Spec.Running {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		binding, err := networkproxy.ObserveProxyLaunch(ctx, owner, vm, vm.Status.NetworkProxyLaunch)
+		if err != nil {
+			return empty, err
+		}
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		if _, err := managementconfig.ResolveOrbWinRoot(home, "orbwin"); err != nil {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		inst, err := guestexec.Inspect(ctx, vm.Name)
+		if err != nil {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		expectedDir := filepath.Join(home, ".rdorbwin", "lima", vm.Name)
+		if inst == nil || inst.Name != vm.Name || !strings.EqualFold(inst.Dir, expectedDir) || inst.Config == nil || inst.Config.VMType == nil || *inst.Config.VMType != limatype.WSL2 || (inst.SSHAddress != "127.0.0.1" && inst.SSHAddress != "::1") || inst.SSHLocalPort < 1 || inst.SSHLocalPort > 65535 {
+			return empty, networkproxy.ErrProxyOwner
+		}
+		guid, err := networkproxy.ObserveGuestRegistration(ctx, vm.Name, expectedDir)
+		if err != nil {
+			return empty, err
+		}
+		return proxyGuestSelection{owner: owner, vm: vm, binding: binding, instance: inst, guid: guid}, nil
+	}}
+}
+func sameProxyGuestSelection(before, after proxyGuestSelection) bool {
+	return before.owner != nil && after.owner != nil && before.vm != nil && after.vm != nil && before.owner.UID == after.owner.UID && before.vm.UID == after.vm.UID && before.binding == after.binding && before.guid == after.guid && before.instance != nil && after.instance != nil && before.instance.Dir == after.instance.Dir
+}
+func (a *fixedProxyGuestAdapter) ObserveIdentity(ctx context.Context, vm *lima.LimaVM) (networkproxy.GuestIdentity, error) {
+	var empty networkproxy.GuestIdentity
+	if a == nil || !a.mu.TryLock() {
+		return empty, networkproxy.ErrProxyBusy
+	}
+	defer a.mu.Unlock()
+	if len(a.helperSHA256) != 64 {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	selected, err := a.selectCurrent(ctx, vm)
+	if err != nil {
+		return empty, err
+	}
+	result, err := a.run(ctx, selected.instance, protocol.Message{Schema: 1, Operation: "observe", HelperSHA256: a.helperSHA256})
+	if err == nil && result.Schema == 1 && result.Reason == "Pending" && result.Identity == nil && result.Receipt == nil {
+		if current, e := a.selectCurrent(ctx, vm); e == nil && sameProxyGuestSelection(selected, current) {
+			return empty, networkproxy.ErrGuestPending
+		}
+		return empty, networkproxy.ErrProxyOwner
+	}
+	if err != nil || result.Schema != 1 || result.Reason != "Ready" || result.Identity == nil || !result.Identity.Valid() || result.Identity.HelperSHA256 != a.helperSHA256 || result.Receipt != nil {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	current, err := a.selectCurrent(ctx, vm)
+	if err != nil || !sameProxyGuestSelection(selected, current) {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	identity := networkproxy.GuestIdentity{RegistrationGUID: current.guid, MachineID: result.Identity.MachineID, DaemonID: result.Identity.DaemonID}
+	a.selection = &current
+	a.identity = identity
+	return identity, nil
+}
+func (a *fixedProxyGuestAdapter) ApplyOrObserve(ctx context.Context, transaction networkproxy.GuestTransaction) (networkproxy.GuestTransactionReceipt, error) {
+	var empty networkproxy.GuestTransactionReceipt
+	if a == nil || !a.mu.TryLock() {
+		return empty, networkproxy.ErrProxyBusy
+	}
+	defer a.mu.Unlock()
+	if a.selection == nil || a.identity != transaction.Identity {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	selected, err := a.selectCurrent(ctx, a.selection.vm)
+	if err != nil || !sameProxyGuestSelection(*a.selection, selected) || networkproxy.GuardProxyPlan(selected.owner, &transaction.Plan, selected.binding) != nil {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	request := networkproxy.GuestProtocolRequest(transaction)
+	if request.Validate() != nil {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	result, err := a.run(ctx, selected.instance, protocol.Message{Schema: 1, Operation: "apply", Request: &request, HelperSHA256: a.helperSHA256})
+	if err == nil && result.Schema == 1 && result.Reason == "Pending" && result.Identity == nil && result.Receipt == nil {
+		if current, e := a.selectCurrent(ctx, selected.vm); e == nil && sameProxyGuestSelection(selected, current) && networkproxy.GuardProxyPlan(current.owner, &transaction.Plan, current.binding) == nil {
+			return empty, networkproxy.ErrGuestPending
+		}
+		return empty, networkproxy.ErrProxyOwner
+	}
+	if err != nil || result.Schema != 1 || result.Reason != "Ready" || result.Identity != nil || result.Receipt == nil {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	current, err := a.selectCurrent(ctx, selected.vm)
+	if err != nil || !sameProxyGuestSelection(selected, current) || networkproxy.GuardProxyPlan(current.owner, &transaction.Plan, current.binding) != nil {
+		return empty, networkproxy.ErrProxyOwner
+	}
+	return networkproxy.GuestReceiptFromProtocol(transaction, *result.Receipt)
+}
+
+type proxyGuestOutput struct {
+	bytes.Buffer
+	limit int
+}
+
+func (b *proxyGuestOutput) Write(data []byte) (int, error) {
+	if b.Len()+len(data) > b.limit {
+		return 0, networkproxy.ErrManagement
+	}
+	return b.Buffer.Write(data)
+}
+func runFixedProxyGuest(parent context.Context, inst *limatype.Instance, message protocol.Message) (protocol.MessageResult, error) {
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	defer cancel()
+	cmd, err := guestexec.Command(ctx, inst, fixedProxyGuestCommand, guestexec.Options{})
+	if err != nil {
+		return protocol.MessageResult{}, networkproxy.ErrManagement
+	}
+	return exchangeProxyGuest(ctx, cmd, message)
+}
+
+// One Start/Wait; no retries. WaitDelay bounds inherited pipe retirement after
+// subprocess exit. This cannot prove the remote helper exited on SSH failure;
+// its retained native lock/journal is required for subsequent recovery.
+func exchangeProxyGuest(ctx context.Context, cmd *exec.Cmd, message protocol.Message) (protocol.MessageResult, error) {
+	var empty protocol.MessageResult
+	if cmd == nil || ctx == nil || ctx.Err() != nil {
+		return empty, networkproxy.ErrManagement
+	}
+	if message.Schema != 1 || message.Operation != "observe" && message.Operation != "apply" || message.Operation == "observe" && message.Request != nil || message.Operation == "apply" && (message.Request == nil || message.Request.Validate() != nil) {
+		return empty, networkproxy.ErrManagement
+	}
+	input, err := cmd.StdinPipe()
+	if err != nil {
+		return empty, networkproxy.ErrManagement
+	}
+	defer input.Close()
+	output := &proxyGuestOutput{limit: protocol.MaxFrame}
+	failure := &proxyGuestOutput{limit: 2048}
+	cmd.Stdout = output
+	cmd.Stderr = failure
+	cmd.WaitDelay = 500 * time.Millisecond
+	if cmd.Start() != nil {
+		return empty, networkproxy.ErrManagement
+	}
+	writeErr := protocol.WriteFrame(input, message)
+	if writeErr != nil {
+		_ = input.Close()
+		_ = cmd.Process.Kill()
+	}
+	waitErr := cmd.Wait()
+	if writeErr != nil || waitErr != nil || ctx.Err() != nil {
+		return empty, networkproxy.ErrManagement
+	}
+	reader := bufio.NewReaderSize(bytes.NewReader(output.Bytes()), protocol.MaxFrame+1)
+	var result protocol.MessageResult
+	if protocol.ReadFrame(reader, &result) != nil || reader.Buffered() != 0 || result.Schema != 1 || (result.Reason != "Ready" && result.Reason != "Unavailable") {
+		return empty, networkproxy.ErrManagement
+	}
+	if result.Reason == "Unavailable" {
+		if result.Identity != nil || result.Receipt != nil {
+			return empty, networkproxy.ErrManagement
+		}
+	} else if message.Operation == "observe" {
+		if result.Identity == nil || !result.Identity.Valid() || result.Receipt != nil {
+			return empty, networkproxy.ErrManagement
+		}
+	} else if result.Identity != nil || result.Receipt == nil || protocol.GuardReceipt(*message.Request, *result.Receipt) != nil {
+		return empty, networkproxy.ErrManagement
+	}
+	return result, nil
+}
