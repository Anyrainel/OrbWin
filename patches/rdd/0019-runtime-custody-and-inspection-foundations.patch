--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_guest_preflight_windows.go
@@ -0,0 +1,386 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/binary"
+	"runtime"
+	"strings"
+
+	"golang.org/x/sys/windows"
+)
+
+// Pre-controller ownership only. This issues neither Stop nor unregister nor
+// import/reimport authority. Every key/file belongs to the ORIGINAL owner or
+// SAME storage; no fake observer, second closer or WSL process query is used.
+type nativeFreshGuestPreflight struct {
+	recovery         *nativeFreshRecoveryOwner
+	root, key        *freshRegistryResource
+	guid, name, base string
+	directories      []*runtimeStorageObject
+	disk             *runtimeStorageObject
+	shape            runtimeFreshGuestShape
+}
+
+func (g *nativeFreshGuestPreflight) knownLocked(ctx context.Context) bool {
+	if g == nil || g.recovery == nil || g.recovery.owner == nil {
+		return false
+	}
+	r := g.recovery
+	n := r.owner.storage
+	return r.admitted(n) && r.guestPreflight == g && freshBoundedContext(ctx) && runtimeMappedSelfStorageKnownLocked(n) && !r.owner.unknown && n.check() == nil
+}
+
+// Caller owns original owner context and storage.mu/thread. Key outputs are
+// retained before RegOpen; a failed output can never be registration absence.
+func (g *nativeFreshGuestPreflight) openKeyLocked(ctx context.Context, parent windows.Handle, name string) (*freshRegistryResource, error) {
+	if !g.knownLocked(ctx) {
+		return nil, ErrUpgrade
+	}
+	o, n := g.recovery.owner, g.recovery.owner.storage
+	text, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	key := &freshRegistryResource{}
+	o.keys = append(o.keys, key)
+	e = windows.RegOpenKeyEx(parent, text, 0, windows.KEY_READ, &key.handle)
+	if reply := runtimeStorageOpenReply(e, key.handle != 0 && key.handle != windows.InvalidHandle, func() {}, n.fence); reply != nil {
+		if n.unknown {
+			o.unknown = true
+		} else {
+			o.keys = o.keys[:len(o.keys)-1]
+		}
+		return nil, reply
+	}
+	return key, nil
+}
+func (g *nativeFreshGuestPreflight) closeTemporaryKeyLocked(key *freshRegistryResource) error {
+	o, n := g.recovery.owner, g.recovery.owner.storage
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	if key.run(func() error {
+		if windows.RegCloseKey(key.handle) != nil {
+			return ErrUpgrade
+		}
+		key.handle = 0
+		return nil
+	}, n.fence) != nil {
+		o.unknown = true
+		return ErrUpgrade
+	}
+	if len(o.keys) > 0 && o.keys[len(o.keys)-1] == key {
+		o.keys = o.keys[:len(o.keys)-1]
+	}
+	return nil
+}
+
+func (g *nativeFreshGuestPreflight) registryLocked(ctx context.Context) (guid, name, base string, failure error) {
+	if !g.knownLocked(ctx) {
+		return "", "", "", ErrUpgrade
+	}
+	root, e := g.openKeyLocked(ctx, windows.HKEY_CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`)
+	if e == windows.ERROR_FILE_NOT_FOUND {
+		return "", "", "", nil
+	}
+	if e != nil {
+		return "", "", "", ErrUpgrade
+	}
+	if g.root == nil {
+		g.root = root
+	} else {
+		defer func() {
+			if g.closeTemporaryKeyLocked(root) != nil {
+				failure = ErrUpgrade
+			}
+		}()
+	}
+	for i := uint32(0); i <= 512; i++ {
+		if !g.knownLocked(ctx) {
+			return "", "", "", ErrUpgrade
+		}
+		var rawName [64]uint16
+		count := uint32(len(rawName))
+		e := windows.RegEnumKeyEx(root.handle, i, &rawName[0], &count, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			return guid, name, base, nil
+		}
+		if e != nil || i == 512 || count == 0 || count >= uint32(len(rawName)) {
+			return "", "", "", ErrUpgrade
+		}
+		units := append([]uint16(nil), rawName[:count]...)
+		units = append(units, 0)
+		keyName, e := freshRuntimeRegistryText(units)
+		if e != nil {
+			return "", "", "", ErrUpgrade
+		}
+		keyName = strings.ToLower(keyName)
+		if !freshRuntimeGUID(keyName) {
+			return "", "", "", ErrUpgrade
+		}
+		key, e := g.openKeyLocked(ctx, root.handle, keyName)
+		if e != nil {
+			return "", "", "", ErrUpgrade
+		}
+		distro, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+		if e != nil {
+			return "", "", "", ErrUpgrade
+		}
+		keep := false
+		if runtimeFreshOwnedRegistrationName(distro) {
+			if guid != "" {
+				return "", "", "", ErrUpgrade
+			}
+			actualBase, e := freshRuntimeRegistryValue(key.handle, "BasePath")
+			if e != nil || !freshRuntimeRegistrationBase(actualBase, g.recovery.owner.storage.home) {
+				return "", "", "", ErrUpgrade
+			}
+			var raw [4]byte
+			size := uint32(4)
+			var kind uint32
+			value, _ := windows.UTF16PtrFromString("Version")
+			if windows.RegQueryValueEx(key.handle, value, nil, &kind, &raw[0], &size) != nil || kind != windows.REG_DWORD || size != 4 || !runtimeFreshGuestRegistrationMatches(distro, actualBase, g.recovery.owner.storage.home, binary.LittleEndian.Uint32(raw[:])) {
+				return "", "", "", ErrUpgrade
+			}
+			again, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+			if e != nil || again != distro {
+				return "", "", "", ErrUpgrade
+			}
+			guid, name, base = keyName, distro, actualBase
+			if g.key == nil {
+				g.key = key
+				keep = true
+			}
+		}
+		if !keep && g.closeTemporaryKeyLocked(key) != nil {
+			return "", "", "", ErrUpgrade
+		}
+	}
+	return "", "", "", ErrUpgrade
+}
+
+func (g *nativeFreshGuestPreflight) capturePathLocked(ctx context.Context) ([]*runtimeStorageObject, *runtimeStorageObject, error) {
+	r, n := g.recovery, g.recovery.owner.storage
+	if !g.knownLocked(ctx) || r.denial == nil || r.denial.checkLocked(ctx) != nil {
+		return nil, nil, ErrUpgrade
+	}
+	home := r.denial.directories[0]
+	if home == nil {
+		return nil, nil, ErrUpgrade
+	}
+	dirs := []*runtimeStorageObject{home}
+	parent := home
+	for i, name := range []string{".rdorbwin", "lima", "orbwin"} {
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, false, i < 2)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return nil, nil, nil
+		}
+		if e != nil {
+			return nil, nil, ErrUpgrade
+		}
+		dirs = append(dirs, object)
+		parent = object
+	}
+	disk, e := n.openFreshExistingTracked(ctx, parent.resource.handle, "ext4.vhdx", false, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, false, false)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return dirs, nil, nil
+	}
+	if e != nil || disk.identity.size == 0 {
+		return nil, nil, ErrUpgrade
+	}
+	return dirs, disk, nil
+}
+
+func (r *nativeFreshRecoveryOwner) captureGuestPreflight(ctx context.Context) error {
+	n := r.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || r.guestPreflight != nil || !runtimeMappedSelfStorageKnownLocked(n) {
+		return ErrUpgrade
+	}
+	g := &nativeFreshGuestPreflight{recovery: r}
+	r.guestPreflight = g
+	var e error
+	g.guid, g.name, g.base, e = g.registryLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	g.directories, g.disk, e = g.capturePathLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	g.shape = classifyRuntimeFreshGuest(g.guid != "", len(g.directories) > 0, g.disk != nil)
+	if g.shape == runtimeFreshGuestUnknown {
+		return ErrUpgrade
+	}
+	return g.checkLocked(ctx)
+}
+
+func (g *nativeFreshGuestPreflight) checkLocked(ctx context.Context) error {
+	if !g.knownLocked(ctx) || g.shape == runtimeFreshGuestUnknown {
+		return ErrUpgrade
+	}
+	if g.key != nil {
+		distro, e := freshRuntimeRegistryValue(g.key.handle, "DistributionName")
+		if e != nil || distro != g.name {
+			return ErrUpgrade
+		}
+		base, e := freshRuntimeRegistryValue(g.key.handle, "BasePath")
+		if e != nil || base != g.base {
+			return ErrUpgrade
+		}
+	}
+	guid, name, base, e := g.registryLocked(ctx)
+	if e != nil || guid != g.guid || name != g.name || base != g.base {
+		return ErrUpgrade
+	}
+	directories, disk, e := g.capturePathLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if classifyRuntimeFreshGuest(guid != "", len(directories) > 0, disk != nil) != g.shape {
+		return ErrUpgrade
+	}
+	if g.shape == runtimeFreshGuestAbsent {
+		return finishRuntimeFreshGuestPreflight(ctx)
+	}
+	if len(directories) != len(g.directories) || disk == nil || g.disk == nil {
+		return ErrUpgrade
+	}
+	for i, object := range directories {
+		if object.identity != g.directories[i].identity {
+			return ErrUpgrade
+		}
+	}
+	// Guest writes may legitimately change VHD size/time. Object/SD/kind/links
+	// remain bound; metadata handles deny deletion without blocking WSL writes.
+	a, b := disk.identity, g.disk.identity
+	a.size, b.size = 0, 0
+	a.written, b.written = windows.Filetime{}, windows.Filetime{}
+	if a != b {
+		return ErrUpgrade
+	}
+	return finishRuntimeFreshGuestPreflight(ctx)
+}
+
+// The final synchronous provider can finish after cancellation. Every positive
+// pre-controller/native-absence boundary checks its ORIGINAL deadline again.
+func finishRuntimeFreshGuestPreflight(ctx context.Context) error {
+	if !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Call immediately before enabling actual controllers, after preparation/PID.
+// No PID/registry DTO or successful observation after startup substitutes.
+func (o *FreshSetupOwner) RecheckRecoveryGuestBeforeControllers(ctx context.Context, c *Created) (failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			if o.storage != nil {
+				o.storage.mu.Lock()
+				o.storage.fence()
+				o.storage.mu.Unlock()
+			}
+			failure = ErrUpgrade
+		}
+	}()
+	n := o.storage
+	if n == nil || o.closed || o.unknown || c == nil || o.created != c {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	active := !c.closed && c.closeErr == nil && c.servingLease && c.anchor != 0
+	c.mu.Unlock()
+	if !active {
+		return ErrUpgrade
+	}
+	if n.freshRecovery == nil {
+		if o.recheckInitialGuestBeforeControllersLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		return finishRuntimeFreshGuestPreflight(ctx)
+	}
+	r := n.freshRecovery
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || !r.complete || r.guestPreflight == nil || r.checkAdmittedStorageLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	if r.guestPreflight.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return finishRuntimeFreshGuestPreflight(ctx)
+}
+
+// Caller holds the ORIGINAL owner.mu (and may hold its witness/config locks).
+// This proves only current native guest absence, never API mutation history or
+// permission to recreate an App. A registered or partially present guest refuses.
+func (o *FreshSetupOwner) requireFreshNoGuestLocked(ctx context.Context) error {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) || o.storage == nil || o.closed || o.unknown {
+		return ErrUpgrade
+	}
+	n := o.storage
+	if n.freshRecovery == nil {
+		return o.recheckInitialGuestBeforeControllersLocked(ctx)
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	r := n.freshRecovery
+	if !r.admitted(n) || !r.complete || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.checkAdmittedStorageLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return r.guestPreflight.checkLocked(ctx)
+}
+
+// Original fresh source has not yet enabled controllers. Recheck both the
+// registration and exact fixed guest directory absence after preparation too.
+func (o *FreshSetupOwner) recheckInitialGuestBeforeControllersLocked(ctx context.Context) error {
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	return o.recheckInitialGuestNativeLocked(ctx)
+}
+
+// Same actual initial absence proof for callers already owning o->n/thread.
+func (o *FreshSetupOwner) recheckInitialGuestNativeLocked(ctx context.Context) error {
+	if o == nil || o.storage == nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || n.checkPrevious() != nil || o.checkLegacyStartDenialLocked(ctx) != nil || o.requireNoOwnedRegistration(ctx) != nil {
+		return ErrUpgrade
+	}
+	home, e := o.legacyGuestHomeLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	parent := home
+	for i, name := range []string{".rdorbwin", "lima", "orbwin"} {
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, false, i < 2)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return finishRuntimeFreshGuestPreflight(ctx)
+		}
+		if e != nil {
+			return ErrUpgrade
+		}
+		parent = object
+	}
+	return ErrUpgrade
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_guest_preflight_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_guest_preflight_windows_test.go
