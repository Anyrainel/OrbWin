+func (d *runtimeFreshLegacyDenial) persistObservationLocked(ctx context.Context, parent *runtimeStorageObject, name string, v runtimeFreshDenialRecipeObservation) error {
+	if !d.knownLocked() || d.prefix == nil || !d.denialFileRoleLocked(parent, name, false) || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n := d.owner.storage
+	for _, held := range d.durable {
+		if held.parent == parent && held.name == name {
+			if n.checkObject(held.object) != nil || runtimeStorageFileData(held.object, held.body) != v.File || !bytes.Equal(held.body, v.Body) {
+				return ErrUpgrade
+			}
+			actual, e := n.read(held.object, true)
+			if e != nil || !bytes.Equal(actual, v.Body) {
+				return ErrUpgrade
+			}
+			return nil
+		}
+	}
+	o, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || runtimeStorageFileData(o, v.Body) != v.File {
+		return ErrUpgrade
+	}
+	o, e = d.persistFileLocked(ctx, parent, name, o, v.Body, windows.FILE_SHARE_READ)
+	if e != nil {
+		return ErrUpgrade
+	}
+	d.durable = append(d.durable, nativeFreshDenialDurableFile{parent, name, o, append([]byte(nil), v.Body...)})
+	return nil
+}
+func (d *runtimeFreshLegacyDenial) retainDenialRecordLocked(parent *runtimeStorageObject, name string, o *runtimeStorageObject, body []byte) error {
