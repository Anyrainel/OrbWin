index 0000000000000000000000000000000000000000..e3def0f66704bf71c74c04030fd10bfe0b82d5f0
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_environment.go
@@ -0,0 +1,33 @@
+package managementconfig
+
+import (
+	"path/filepath"
+	"strings"
+)
+
+// Process-local selector metadata only. This cannot capture a native root or
+// issue authority. Actual caller supplies ONLY its independently captured home.
+func runtimeFreshEnvironmentSelector(name string) bool {
+	name = strings.ToUpper(name)
+	if name == "HOME" || name == "USERPROFILE" || name == "KUBECONFIG" || name == "WSLENV" || name == "WSL_DISTRO_NAME" || name == "WSL_INTEROP" {
+		return true
+	}
+	for _, prefix := range []string{"RDD_", "ORBWIN_", "LIMA_", "DOCKER_", "BUILDKIT_", "BUILDX_", "CONTAINERD_", "NERDCTL_", "KUBE_", "KUBERNETES_"} {
+		if strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+func runtimeFreshFixedEnvironment(home string) [][2]string {
+	short := filepath.Join(home, ".rdorbwin")
+	return [][2]string{
+		{"HOME", home}, {"USERPROFILE", home}, {"RDD_INSTANCE", "orbwin"},
+		{"LIMA_HOME", filepath.Join(short, "lima")},
+		{"DOCKER_CONFIG", filepath.Join(short, "docker")},
+		{"KUBECONFIG", filepath.Join(short, "kube-client.config")},
+		{"DOCKER_HOST", runtimeIdentityEndpoint},
+		{"RDD_DEVELOPER_MODE", "0"},
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_environment_test.go b/rdd/pkg/managementconfig/runtime_fresh_environment_test.go
new file mode 100644
