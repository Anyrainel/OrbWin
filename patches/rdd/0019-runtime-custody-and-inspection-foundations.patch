+// Synchronous owned HTTP/1 exchanges avoid a hidden transport dial worker that
+// could outlive publication/closure. No redirect, proxy, loader or HTTP2 path.
+func (w *FreshRuntimeObservation) apiRequestLocked(ctx context.Context, method, route string, body []byte, output any) (failure error) {
+	if !freshBoundedContext(ctx) || method != http.MethodGet && method != http.MethodPost || (route != "/apis/app.rancherdesktop.io/v1alpha1/apps" && route != "/apis/app.rancherdesktop.io/v1alpha1/apps/app" && route != "/apis/lima.rancherdesktop.io/v1alpha1/limavms" && route != "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/"+freshRuntimeNamespace+"/limavms/orbwin") {
+		return ErrUpgrade
+	}
