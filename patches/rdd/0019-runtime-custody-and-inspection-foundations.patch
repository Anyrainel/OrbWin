+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshAppOriginalDecisionRejectsBeforeEffects(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, o := range []*FreshSetupOwner{nil, {}, {self: &FreshSetupOwner{}}} {
+		if d, e := o.PrepareFreshRuntimeApp(context.Background(), &Created{}, &ConfigPublisher{}); e == nil || d != nil {
+			t.Fatal("unbounded capture")
+		}
+		if !o.FreshRuntimeAppMustPersist(nil, nil) {
+			t.Fatal("unissued wrapper permitted service cancellation")
+		}
+		if o.ContinueFreshRuntimeApp(ctx, nil, nil, nil, "11111111111111111111111111111111") == nil {
+			t.Fatal("nil decision")
+		}
+	}
+	o := &FreshSetupOwner{captureComplete: true}
+	o.self = o
+	c, p := &Created{}, &ConfigPublisher{}
+	w := &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+	w.self = w
+	o.created = c
+	o.observation = w
+	a := &nativeFreshAppAdmission{w: w, loaded: true, record: freshAppRecordFixture(t), object: &runtimeStorageObject{}}
+	w.appAdmission = a
+	d := &FreshAppDecision{admission: a, challenge: "22222222222222222222222222222222"}
+	d.self = d
+	a.decision = d
+	freshTestRegister(t, o)
+	copy := *d
+	if _, _, e := copy.Data(); e == nil {
+		t.Fatal("copied decision")
+	}
+	if o.ContinueFreshRuntimeApp(ctx, c, p, d, "33333333333333333333333333333333") == nil || d.consumed || a.attempted {
+		t.Fatal("wrong consent changed original operation")
+	}
+	a.attempted = true
+	if _, _, e := d.Data(); e == nil {
+		t.Fatal("post-attempt decision replay")
+	}
+	if !o.FreshRuntimeAppMustPersist(c, p) {
+		t.Fatal("post-attempt service was cancellable")
+	}
+	if o.PrepareFreshRuntimeAppPause(ctx, c, p, d) == nil {
+		t.Fatal("attempted App admitted pause")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_authority_tuple.go b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple.go
new file mode 100644
index 0000000000000000000000000000000000000000..c453ce0d345a573aa97214a505d92ef971086b7f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple.go
@@ -0,0 +1,198 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+)
+
+const runtimeFreshTupleSlots = 16
+const runtimeFreshTupleBudget = 64 << 10
+const runtimeFreshTupleMagic = "OrbWinKeysTuple1\x00"
+
+func runtimeFreshTupleFileName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshTupleSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.keys.%04d", ordinal), nil
+}
+
+// Refusal DATA only. Advancing a failed slot also needs native no-leaf/DB/guest
+// proof. A complete-but-invalid tuple is never an interrupted prefix.
+func runtimeFreshTupleIncomplete(body []byte, expected runtimeFreshTupleBinding) bool {
+	if !expected.valid() || len(body) > runtimeFreshTupleBudget {
+		return false
+	}
+	magic := []byte(runtimeFreshTupleMagic)
+	if len(body) < len(magic) {
+		return bytes.Equal(body, magic[:len(body)])
+	}
+	if !bytes.Equal(body[:len(magic)], magic) {
+		return false
+	}
+	meta, e := runtimeFreshRecordBytes(expected)
+	if e != nil || len(meta) > 4096 {
+		return false
+	}
+	var metaWord [4]byte
+	binary.LittleEndian.PutUint32(metaWord[:], uint32(len(meta)))
+	for i := 0; i < 4 && len(body) > len(magic)+i; i++ {
+		if body[len(magic)+i] != metaWord[i] {
+			return false
+		}
+	}
+	start := len(magic) + 16
+	if len(body) < start {
+		max := runtimeFreshTupleBudget - start - len(meta) - sha256.Size - 2
+		for word := 1; word < 4; word++ {
+			at := len(magic) + word*4
+			if len(body) <= at {
+				break
+			}
+			count := len(body) - at
+			if count > 4 {
+				count = 4
+			}
+			var raw [4]byte
+			copy(raw[:], body[at:at+count])
+			value := int(binary.LittleEndian.Uint32(raw[:]))
+			if value > max || value == 0 && count >= 2 {
+				return false
+			}
+		}
+		return true
+	}
+	total := start + sha256.Size
+	for word := 0; word < 4; word++ {
+		value := int(binary.LittleEndian.Uint32(body[len(magic)+word*4:]))
+		if value <= 0 || value > runtimeFreshTupleBudget || total > runtimeFreshTupleBudget-value {
+			return false
+		}
+		total += value
+	}
+	if len(body) >= total {
+		return false
+	}
+	available := len(body) - start
+	if available > len(meta) {
+		available = len(meta)
+	}
+	return bytes.Equal(body[start:start+available], meta[:available])
+}
+
+// Private expected DATA. Only original native state plus actual immutable file
+// capture can issue a tuple capability. Neither decoding nor equality does so.
+type runtimeFreshTupleBinding struct {
+	Schema                                                   int
+	Transaction                                              string
+	Ordinal                                                  uint32
+	Intent, Denial                                           runtimePublicationFileWitness
+	Controller, Authority, TLS                               UpgradeObject
+	ControllerDescriptor, AuthorityDescriptor, TLSDescriptor [32]byte
+}
+
+func (b runtimeFreshTupleBinding) valid() bool {
+	return b.Schema == 1 && upgradeHex(b.Transaction, 32) && b.Ordinal < runtimeFreshTupleSlots && b.Intent.valid() && b.Denial.valid() && b.Controller.valid() && b.Authority.valid() && b.TLS.valid() && b.Authority != b.TLS && b.Authority.Volume == b.TLS.Volume && b.ControllerDescriptor != [32]byte{} && b.AuthorityDescriptor != [32]byte{} && b.TLSDescriptor != [32]byte{}
+}
+
+type runtimeFreshTupleMaterial struct{ cert, key, account []byte }
+
+func (m *runtimeFreshTupleMaterial) clear() {
+	if m != nil {
+		clear(m.cert)
+		clear(m.key)
+		clear(m.account)
+		m.cert = nil
+		m.key = nil
+		m.account = nil
+	}
+}
+
+// No secret JSON/string conversion: metadata is public witness DATA, secret
+// payloads remain owned byte buffers. Caller clears returned encoded bytes.
+func encodeRuntimeFreshAuthorityTuple(binding runtimeFreshTupleBinding, cert, key, account []byte) ([]byte, error) {
+	var body []byte
+	complete := false
+	defer func() {
+		if !complete {
+			clear(body)
+		}
+	}()
+	if !binding.valid() || validateAuthorityMaterial(cert, key, account) != nil {
+		return nil, ErrUpgrade
+	}
+	meta, e := runtimeFreshRecordBytes(binding)
+	if e != nil || len(meta) > 4096 {
+		return nil, ErrUpgrade
+	}
+	total := len(runtimeFreshTupleMagic) + 16 + len(meta) + len(cert) + len(key) + len(account) + sha256.Size
+	if total > runtimeFreshTupleBudget {
+		return nil, ErrUpgrade
+	}
+	body = make([]byte, total)
+	copy(body, runtimeFreshTupleMagic)
+	at := len(runtimeFreshTupleMagic)
+	for _, count := range []int{len(meta), len(cert), len(key), len(account)} {
+		binary.LittleEndian.PutUint32(body[at:], uint32(count))
+		at += 4
+	}
+	for _, part := range [][]byte{meta, cert, key, account} {
+		copy(body[at:], part)
+		at += len(part)
+	}
+	digest := sha256.Sum256(body[:at])
+	copy(body[at:], digest[:])
+	complete = true
+	return body, nil
+}
+
+func parseRuntimeFreshAuthorityTuple(body []byte, expected runtimeFreshTupleBinding) (result runtimeFreshTupleMaterial, failure error) {
+	complete := false
+	defer func() {
+		if !complete {
+			result.clear()
+		}
+	}()
+	start := len(runtimeFreshTupleMagic) + 16
+	if !expected.valid() || len(body) < start+sha256.Size || len(body) > runtimeFreshTupleBudget || !bytes.Equal(body[:len(runtimeFreshTupleMagic)], []byte(runtimeFreshTupleMagic)) {
+		return result, ErrUpgrade
+	}
+	digest := sha256.Sum256(body[:len(body)-sha256.Size])
+	if !bytes.Equal(body[len(body)-sha256.Size:], digest[:]) {
+		return result, ErrUpgrade
+	}
+	var lengths [4]int
+	at := len(runtimeFreshTupleMagic)
+	total := start + sha256.Size
+	for i := range lengths {
+		lengths[i] = int(binary.LittleEndian.Uint32(body[at:]))
+		at += 4
+		if lengths[i] <= 0 || lengths[i] > runtimeFreshTupleBudget || total > runtimeFreshTupleBudget-lengths[i] {
+			return result, ErrUpgrade
+		}
+		total += lengths[i]
+	}
+	if total != len(body) || lengths[0] > 4096 {
+		return result, ErrUpgrade
+	}
+	var binding runtimeFreshTupleBinding
+	meta := body[start : start+lengths[0]]
+	if parseRuntimeFreshRecord(meta, &binding) != nil || binding != expected {
+		return result, ErrUpgrade
+	}
+	canonical, e := runtimeFreshRecordBytes(binding)
+	if e != nil || !bytes.Equal(canonical, meta) {
+		return result, ErrUpgrade
+	}
+	at = start + lengths[0]
+	for i, target := range []*[]byte{&result.cert, &result.key, &result.account} {
+		*target = append([]byte(nil), body[at:at+lengths[i+1]]...)
+		at += lengths[i+1]
+	}
+	if validateAuthorityMaterial(result.cert, result.key, result.account) != nil {
+		return result, ErrUpgrade
+	}
+	complete = true
+	return result, nil
+}
