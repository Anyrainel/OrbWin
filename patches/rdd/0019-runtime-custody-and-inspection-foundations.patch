+	leaf, rest := pem.Decode(bundle)
+	anchor, _ := pem.Decode(rest)
+	_, otherAnchor := pem.Decode(other)
+	leafPEM, anchorPEM := pem.EncodeToMemory(leaf), pem.EncodeToMemory(anchor)
+	join := func(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+	badLeaf := append([]byte(nil), leaf.Bytes...)
+	badLeaf[len(badLeaf)-1] ^= 1
+	badAnchor := append([]byte(nil), anchor.Bytes...)
+	badAnchor[len(badAnchor)-1] ^= 1
+	header := &pem.Block{Type: "CERTIFICATE", Bytes: leaf.Bytes, Headers: map[string]string{"Unexpected": "header"}}
+	for name, input := range map[string][]byte{
+		"empty":                        nil,
+		"reordered":                    join(anchorPEM, leafPEM),
+		"duplicate-leaf":               join(leafPEM, leafPEM),
+		"duplicate-ca":                 join(anchorPEM, anchorPEM),
+		"mismatched-ca":                join(leafPEM, otherAnchor),
+		"leaf-signature":               join(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: badLeaf}), anchorPEM),
+		"root-signature":               join(leafPEM, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: badAnchor})),
+		"extra-ca":                     join(bundle, anchorPEM),
+		"private-key-prefix":           join(key, bundle),
+		"private-key-suffix":           join(bundle, key),
+		"trailing-material":            join(bundle, []byte("not a certificate")),
+		"leading-material":             join([]byte("not a certificate\n"), bundle),
+		"pem-headers":                  join(pem.EncodeToMemory(header), anchorPEM),
+		"malformed-block-before-valid": join([]byte("-----BEGIN CERTIFICATE-----\ninvalid\n-----END CERTIFICATE-----\n"), bundle),
+		"invalid-der":                  pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: []byte("not DER")}),
