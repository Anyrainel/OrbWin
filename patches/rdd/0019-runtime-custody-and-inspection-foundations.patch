+package managementconfig
+
+import "testing"
+
+func TestDatastoreCleanupCloseLostReplyNeverReplays(t *testing.T) {
+	for _, positive := range []bool{false, true} {
+		var s datastoreCleanupOnce
+		if !s.begin() || s.begin() {
+			t.Fatal("close not armed exactly once")
+		}
+		if s.finish(positive) != positive || s.complete != positive || s.begin() || s.finish(true) {
+			t.Fatal("lost reply/positive replay")
+		}
+	}
+}
+func TestDatastoreCleanupRecordLastAndStopFirst(t *testing.T) {
+	order := datastoreCleanupDeleteOrder()
+	if order != [6]int{1, 2, 3, 4, 5, 0} {
+		t.Fatal("owner metadata not last")
+	}
+	for fail := range order {
+		var calls []int
+		var states [6]datastoreCleanupOnce
+		for index, role := range order {
+			if !states[role].begin() {
+				t.Fatal("replay")
+			}
+			calls = append(calls, role)
+			if index == fail {
+				break
+			}
+			states[role].finish(true)
+		}
+		if len(calls) != fail+1 || states[order[fail]].complete || states[order[fail]].begin() {
+			t.Fatal("uncertain close escaped prefix")
+		}
+		if fail < 5 && states[0].attempted {
+			t.Fatal("owner record consumed after prior failure")
+		}
+	}
+}
+func TestDatastoreCleanupPendingAndPartialOutputsStayOwned(t *testing.T) {
+	cases := []struct {
+		raw, io        uint32
+		info           uintptr
+		present, valid bool
+		known          bool
+	}{
+		{0x103, 0, 0, false, false, false}, {0xc0000034, 0x103, 0, false, false, false},
+		{0xc0000022, 0, 0, true, true, false}, {0, 0, 2, true, true, false},
+		{0, 0, 1, false, false, false}, {0, 0, 1, true, true, true},
+	}
+	for _, c := range cases {
+		s := runtimeStorageNativeOpenState{entered: true}
+		kind := runtimeStorageClassifyNativeOpen(c.raw, c.io, c.info, 1, c.present, c.valid)
+		s.reply(kind)
+		if s.admitted {
+			s.attach()
+		}
+		if s.usable() != c.known || sdkImageReleaseState(&s) != c.known {
+			t.Fatal("pending/partial release classification")
+		}
+		if s.reply(kind) || s.attach() {
+			t.Fatal("native completion replay")
+		}
+	}
+}
+
+func TestDatastoreUnrelatedHistoryNamesRemainNonCandidates(t *testing.T) {
+	for _, name := range []string{"", "foreign", "owner.json", ".", "..", "0000000000000000000000000000000", "000000000000000000000000000000000", "ABCDEF00000000000000000000000000", "gg000000000000000000000000000000"} {
+		if datastoreCanonicalGenerationName(name) {
+			t.Fatalf("unrelated entry admitted %q", name)
+		}
+	}
+	for _, name := range []string{"00000000000000000000000000000000", "abcdef0123456789abcdef0123456789"} {
+		if !datastoreCanonicalGenerationName(name) {
+			t.Fatalf("canonical entry rejected %q", name)
+		}
+	}
+}
