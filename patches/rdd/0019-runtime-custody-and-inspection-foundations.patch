+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// These paths refuse before any native open: data and copied/unregistered
+// state cannot issue a publisher or ordinary startup capability.
+func TestRuntimeFreshControlPublicationDataCannotIssueNativeWitness(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	zero := runtimePublicationFileWitness{}
+	for _, p := range []*nativeFreshRuntimePublisher{nil, {}, {owner: &FreshSetupOwner{storage: &nativeRuntimeStorage{}, created: &Created{}}}} {
+		r, b, e := p.controlWitnessesNativeLocked(ctx)
+		if e == nil || r != zero || b != zero {
+			t.Fatal("data minted publication control witness")
+		}
+	}
+	var n *nativeRuntimeStorage
+	if n.checkFreshControlStartupLocked(ctx, freshPublicationFixture()) == nil {
+		t.Fatal("nil startup storage admitted")
+	}
+	n = &nativeRuntimeStorage{}
+	if n.checkFreshControlStartupLocked(ctx, freshPublicationFixture()) == nil {
+		t.Fatal("unregistered startup storage admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_recovery.go b/rdd/pkg/managementconfig/runtime_fresh_control_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..373342c8c022be13fc04da4df6ade3114a1563cb
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_recovery.go
@@ -0,0 +1,128 @@
+package managementconfig
+
+import (
+	"bytes"
+	"fmt"
+)
+
+const runtimeFreshControlSlots = 16
+
+func runtimeFreshControlRecordName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshControlSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.control.%04d", ordinal), nil
+}
+func runtimeFreshControlRetainedName(transaction string) (string, error) {
+	if !upgradeHex(transaction, 32) {
+		return "", ErrUpgrade
+	}
+	return "authority.retained." + transaction, nil
+}
+
+func runtimeFreshControlBirthName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshControlSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.control-birth.%04d", ordinal), nil
+}
+
+type runtimeFreshControlBirth struct {
+	Schema      int
+	Transaction string
+	Ordinal     uint32
+	Retention   runtimePublicationFileWitness
+	Authority   UpgradeObject
+	Descriptor  [32]byte
+}
+
+func (b runtimeFreshControlBirth) matches(record runtimeFreshControlRetention, receipt runtimePublicationFileWitness, current UpgradeObject, descriptor [32]byte) bool {
+	return record.valid() && receipt.valid() && b.Schema == 1 && b.Transaction == record.Transaction && b.Ordinal < runtimeFreshControlSlots && b.Retention == receipt && b.Authority.valid() && b.Authority == current && b.Authority != record.OldAuthority && b.Authority.Volume == record.PrivateParent.Volume && b.Descriptor != [32]byte{} && b.Descriptor == descriptor
+}
+
+// Retention DATA never creates a native owner or asserts prior completion.
+// The native original controller must capture every ID/SD/body independently.
+type runtimeFreshControlObject struct {
+	Role       string
+	Object     UpgradeObject
+	Descriptor [32]byte
+	Directory  bool
+	Size       uint64
+	Body       [32]byte
+}
+
+type runtimeFreshControlRetention struct {
+	Schema                                                                                    int
+	Transaction                                                                               string
+	Ordinal                                                                                   uint32
+	Intent, Denial                                                                            runtimePublicationFileWitness
+	PrivateParent, PublicParent, Controller, OldAuthority, OldOwnerLock                       UpgradeObject
+	PrivateDescriptor, PublicDescriptor, ControllerDescriptor, OldDescriptor, OwnerDescriptor [32]byte
+	Inventory                                                                                 []runtimeFreshControlObject
+	Args                                                                                      []byte
+}
+
+func (r runtimeFreshControlRetention) valid() bool {
+	if r.Schema != 1 || !upgradeHex(r.Transaction, 32) || r.Ordinal >= runtimeFreshControlSlots || !r.Intent.valid() || !r.Denial.valid() || !r.PrivateParent.valid() || !r.PublicParent.valid() || !r.Controller.valid() || !r.OldAuthority.valid() || !r.OldOwnerLock.valid() || r.PrivateDescriptor == [32]byte{} || r.PublicDescriptor == [32]byte{} || r.ControllerDescriptor == [32]byte{} || r.OldDescriptor == [32]byte{} || r.OwnerDescriptor == [32]byte{} || len(r.Inventory) > 4 || len(r.Args) == 0 || len(r.Args) > 1024 || parseFreshRuntimeSavedArguments(r.Args) != nil {
+		return false
+	}
+	if r.PrivateParent.Volume != r.OldAuthority.Volume || r.OldOwnerLock.Volume != r.OldAuthority.Volume || r.Controller.Volume != r.PublicParent.Volume || r.PrivateParent == r.OldAuthority || r.PublicParent == r.Controller {
+		return false
+	}
+	seen := map[UpgradeObject]bool{r.PrivateParent: true, r.OldAuthority: true}
+	roles := []string{"tls", "db", "args", "init"}
+	for i, entry := range r.Inventory {
+		if entry.Role != roles[i] || !entry.Object.valid() || entry.Object.Volume != r.OldAuthority.Volume || seen[entry.Object] || entry.Descriptor == [32]byte{} || entry.Directory != (i < 2) || (entry.Directory && (entry.Size != 0 || entry.Body != [32]byte{})) || (!entry.Directory && (entry.Size > 65536 || entry.Body == [32]byte{})) {
+			return false
+		}
+		seen[entry.Object] = true
+		if entry.Object == r.OldOwnerLock {
+			return false
+		}
+	}
+	// A lock may be source-safely created during native prefix capture. It is
+	// bound independently even when it was not part of the original prefix.
+	return r.OldOwnerLock != r.OldAuthority && r.OldOwnerLock != r.PrivateParent
+}
+
+func runtimeFreshControlPrefixBytes(actual, wanted []byte) bool {
+	return len(actual) <= len(wanted) && bytes.Equal(actual, wanted[:len(actual)])
+}
+
+type runtimeFreshControlCut uint8
+
+const (
+	runtimeFreshControlInvalid runtimeFreshControlCut = iota
+	runtimeFreshControlBeforeRename
+	runtimeFreshControlBeforeRootCreate
+	runtimeFreshControlBeforeBirth
+	runtimeFreshControlBoundRoot
+)
+
+// Refusal DATA only. Native adapter must prove empty means exact enumerated
+// absence and every object is held relative to the SAME original private parent.
+func classifyRuntimeFreshControlCut(old, canonical, retained, birth UpgradeObject, canonicalEmpty bool) runtimeFreshControlCut {
+	zero := UpgradeObject{}
+	if !old.valid() {
+		return runtimeFreshControlInvalid
+	}
+	if canonical == old && retained == zero && birth == zero {
+		return runtimeFreshControlBeforeRename
+	}
+	if retained != old {
+		return runtimeFreshControlInvalid
+	}
+	if canonical == zero && birth == zero {
+		return runtimeFreshControlBeforeRootCreate
+	}
+	if !canonical.valid() || canonical == old {
+		return runtimeFreshControlInvalid
+	}
+	if birth == zero && canonicalEmpty {
+		return runtimeFreshControlBeforeBirth
+	}
+	if birth == canonical {
+		return runtimeFreshControlBoundRoot
+	}
+	return runtimeFreshControlInvalid
+}
