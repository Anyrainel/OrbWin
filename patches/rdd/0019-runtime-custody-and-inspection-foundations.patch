+	defer clear(beforeBody)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	before, e := parseRuntimeUpgradeManagementApp(beforeBody)
+	defer before.clear()
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	path, e := runtimeUpgradeManagementVMPath(before)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	vmBody, e := o.requestLocked(ctx, 1, path)
+	defer clear(vmBody)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	vm, e := parseRuntimeUpgradeManagementVM(vmBody, before)
