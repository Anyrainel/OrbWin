+
+// A private held legacy config.yaml observation. This is not old-listener
+// authentication, native authority, prepared intent, or an upgrade/Stop grant.
+// Order: credentials.mu -> args.mu -> storage.mu -> inventory.mu. The actual
+// args owner determines all other owners; no independent graph/path is accepted.
+type nativeRuntimeUpgradeCredentials struct {
+	mu              sync.Mutex
+	self            *nativeRuntimeUpgradeCredentials
+	args            *nativeRuntimeUpgradeArgs
+	storage         *nativeRuntimeStorage
+	resource        *runtimeStorageResource
+	identity        runtimeStorageIdentity
+	body            []byte
+	hash            [32]byte
+	data            runtimeUpgradeCredentialData
+	closed, unknown bool
+}
+
+func (*nativeRuntimeUpgradeCredentials) String() string {
+	return "private held legacy management credentials"
+}
+func (*nativeRuntimeUpgradeCredentials) GoString() string {
+	return "private held legacy management credentials"
+}
+
+var runtimeUpgradeCredentialsCustody = struct {
+	sync.Mutex
+	owners map[*nativeRuntimeUpgradeCredentials]bool
+}{owners: map[*nativeRuntimeUpgradeCredentials]bool{}}
+
+func runtimeUpgradeCredentialsKnown(o *nativeRuntimeUpgradeCredentials) bool {
+	if o == nil || o.self != o {
+		return false
+	}
+	runtimeUpgradeCredentialsCustody.Lock()
+	defer runtimeUpgradeCredentialsCustody.Unlock()
+	return runtimeUpgradeCredentialsCustody.owners[o]
+}
+
+// Pure refusal gate. No borrowed resource is inspected without its real mutex.
+func runtimeUpgradeCredentialsArgsBirth(a *nativeRuntimeUpgradeArgs) bool {
+	if a == nil || a.self != a {
+		return false
+	}
+	runtimeUpgradeArgsCustody.Lock()
+	defer runtimeUpgradeArgsCustody.Unlock()
+	return runtimeUpgradeArgsCustody.owners[a]
+}
+
+func runtimeUpgradeCredentialsArgsKnownLocked(a *nativeRuntimeUpgradeArgs, n *nativeRuntimeStorage, l *upgradeLegacyInventory) bool {
+	return runtimeUpgradeCredentialsArgsBirth(a) && a.storage == n && a.inventory == l && !a.closed && !a.unknown && runtimeUpgradeArgsOwnersKnownLocked(n, l) && a.resource != nil && !a.resource.attempted && a.resource.handle != 0 && a.resource.handle != windows.InvalidHandle
+}
+func (o *nativeRuntimeUpgradeCredentials) clearSecretsLocked() {
+	clear(o.body)
+	o.body = nil
+	o.data.clear()
+	o.hash = [32]byte{}
+}
+func (o *nativeRuntimeUpgradeCredentials) fenceLocked() {
+	o.unknown = true
+	o.storage.fence()
+	o.clearSecretsLocked()
+	runtimeUpgradeCredentialsCustody.Lock()
+	runtimeUpgradeCredentialsCustody.owners[o] = true
+	runtimeUpgradeCredentialsCustody.Unlock()
+}
+
+// All actual composed owner mutexes held. Unknown borrowed state fences before
+// any own-cap query/close. Positive closed borrowers permit suffix cleanup only.
+func (o *nativeRuntimeUpgradeCredentials) admitBorrowedLocked() runtimeArgsBorrowedState {
+	var own []*runtimeStorageResource
+	if o.resource != nil {
+		own = []*runtimeStorageResource{o.resource}
+	}
+	state := o.args.borrowedStateLocked(own)
+	if o.unknown || o.args.storage != o.storage || state == runtimeBorrowedUnknown {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	return state
+}
+
+// Never propagate or print a native/parser panic value that could contain data.
+func (o *nativeRuntimeUpgradeCredentials) panicRefusalLocked() { o.fenceLocked(); panic(ErrUpgrade) }
+
+// Actual constructor settlement. A final args recheck may fence storage: detect
+// that before attempting this credential slot's close or dropping its custody.
+func (o *nativeRuntimeUpgradeCredentials) settleCaptureLocked(out **nativeRuntimeUpgradeCredentials, result *error) {
+	defer func() {
+		if recover() != nil {
+			o.panicRefusalLocked()
+		}
+	}()
+	state := o.admitBorrowedLocked()
+	if state == runtimeBorrowedUnknown {
+		*result = ErrUpgrade
+		*out = o
+		return
+	}
+	if *result == nil && state != runtimeBorrowedLive {
+		*result = ErrUpgrade
+	}
+	if *result == nil {
+		return
+	}
+	if o.resource != nil && state != runtimeBorrowedStorageClosed && o.storage.closeOne(o.resource) != nil {
+		o.fenceLocked()
+		*out = o
+		return
+	}
+	o.clearSecretsLocked()
+	runtimeUpgradeCredentialsCustody.Lock()
+	delete(runtimeUpgradeCredentialsCustody.owners, o)
+	runtimeUpgradeCredentialsCustody.Unlock()
+}
+
+// Caller holds exact args.mu -> storage.mu -> inventory.mu. Reobserve the same
+// args cap and immutable bytes; a parsed DTO or saved digest is never admission.
+func (o *nativeRuntimeUpgradeCredentials) checkArgsLocked(ctx context.Context) error {
+	a, n := o.args, o.storage
+	if a == nil || n == nil || !runtimeUpgradeCredentialsArgsKnownLocked(a, n, a.inventory) {
+		return ErrUpgrade
+	}
+	want, e := a.checkParentsLocked()
+	if e != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeUpgradeArgsIdentity(a.resource.handle)
+	if e != nil || id != a.identity || runtimeStorageObjectData(&runtimeStorageObject{identity: id}) != want {
+		return ErrUpgrade
+	}
+	body, e := a.readLocked(ctx)
+	defer clear(body)
+	after, f := runtimeUpgradeArgsIdentity(a.resource.handle)
+	if e != nil || f != nil || after != id || !bytes.Equal(body, a.body) || runtimeUpgradeCredentialHash(body) != a.hash || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (o *nativeRuntimeUpgradeCredentials) credentialIDLocked(ctx context.Context) (UpgradeObject, error) {
+	if o.checkArgsLocked(ctx) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	l := o.args.inventory
+	var want UpgradeObject
+	for _, entry := range l.entries {
+		if entry.Role == "management-config" {
+			if want.valid() || entry.Fact.Parent != "root" || entry.Fact.Name != "config.yaml" || entry.Fact.Directory || entry.Fact.Reparse || entry.Fact.Links != 1 {
+				return UpgradeObject{}, ErrUpgrade
+			}
+			want = entry.Fact.Object
+		}
+	}
+	if !want.valid() || want.Volume != l.root.Volume || want == runtimeStorageObjectData(&runtimeStorageObject{identity: o.args.identity}) {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	return want, nil
+}
+func (o *nativeRuntimeUpgradeCredentials) readLocked(ctx context.Context) ([]byte, error) {
+	h := o.resource.handle
+	return readRuntimeUpgradeCredentials(ctx, o.identity.size, func() error { _, e := windows.Seek(h, 0, 0); return e }, func(b []byte) (uint32, error) {
+		var count uint32
+		e := windows.ReadFile(h, b, &count, nil)
+		if e == windows.ERROR_HANDLE_EOF {
+			e = io.EOF
+		}
+		return count, e
+	})
+}
+
+func captureRuntimeUpgradeCredentials(ctx context.Context, a *nativeRuntimeUpgradeArgs) (out *nativeRuntimeUpgradeCredentials, result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	if !runtimeUpgradeArgsBorrowedBirth(a) {
+		return nil, ErrUpgrade
+	}
+	o := &nativeRuntimeUpgradeCredentials{args: a, storage: a.storage}
+	o.self = o
+	runtimeUpgradeCredentialsCustody.Lock()
+	if len(runtimeUpgradeCredentialsCustody.owners) >= 16 {
+		runtimeUpgradeCredentialsCustody.Unlock()
+		return nil, ErrUpgrade
+	}
+	runtimeUpgradeCredentialsCustody.owners[o] = true
+	runtimeUpgradeCredentialsCustody.Unlock()
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n, l := o.storage, a.inventory
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	threadLocked := false
+	defer func() {
+		if threadLocked {
+			defer runtime.UnlockOSThread()
+		}
+		if recover() != nil {
+			o.panicRefusalLocked()
+		}
+		o.settleCaptureLocked(&out, &result)
+	}()
+	if o.admitBorrowedLocked() != runtimeBorrowedLive {
+		return nil, ErrUpgrade
+	}
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	threadLocked = true
+	want, e := o.credentialIDLocked(ctx)
+	if e != nil {
+		return nil, e
+	}
+	name, e := windows.NewNTUnicodeString("config.yaml")
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: l.parents.leaf(), ObjectName: name, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	o.resource = n.keep(0) // exact actual output slot is owned before native effects
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&o.resource.handle, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	h := o.resource.handle
+	if runtimeStorageOpenReply(e, h != 0 && h != windows.InvalidHandle, func() {}, o.fenceLocked) != nil {
+		if !o.unknown {
+			if len(n.resources) == 0 || n.resources[len(n.resources)-1] != o.resource {
+				o.fenceLocked()
+			} else {
+				n.resources = n.resources[:len(n.resources)-1]
+				o.resource = nil
+			}
+		}
+		return nil, ErrUpgrade
+	}
+	o.identity, e = runtimeUpgradeArgsIdentity(h) // same64KiB/single-link/local-disk measurement policy
+	if e != nil || o.identity.size > runtimeUpgradeCredentialsBudget || runtimeStorageObjectData(&runtimeStorageObject{identity: o.identity}) != want {
+		return nil, ErrUpgrade
+	}
+	o.body, e = o.readLocked(ctx)
+	if e != nil {
+		return nil, e
+	}
+	o.data, e = parseRuntimeUpgradeCredentials(o.body, a.body)
+	if e != nil {
+		return nil, e
+	}
+	o.hash = runtimeUpgradeCredentialHash(o.body)
+	after, e := runtimeUpgradeArgsIdentity(h)
+	if e != nil || after != o.identity || ctx.Err() != nil || o.checkArgsLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	return o, nil
+}
+
+// Diagnostics DATA only. No token, CA, endpoint or raw body is exported. Later
+// authenticated transport must use this private owner and independently prove
+// the exact old listener/process; this method grants no transport or Stop action.
+func (o *nativeRuntimeUpgradeCredentials) digest(ctx context.Context) (result [32]byte, failure error) {
+	if !runtimeUpgradeCredentialsKnown(o) || ctx == nil || ctx.Err() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return [32]byte{}, ErrUpgrade
+	}
+	if !runtimeUpgradeArgsBorrowedBirth(o.args) {
+		return [32]byte{}, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown || o.resource == nil || o.storage == nil || o.args.storage != o.storage {
+		return [32]byte{}, ErrUpgrade
+	}
+	a, n := o.args, o.storage
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	a.inventory.mu.Lock()
+	defer a.inventory.mu.Unlock()
+	threadLocked := false
+	defer func() {
+		if threadLocked {
+			defer runtime.UnlockOSThread()
+		}
+		if recover() != nil {
+			o.panicRefusalLocked()
+		}
+		// A native args recheck can itself fence storage even on refusal.
+		if o.admitBorrowedLocked() == runtimeBorrowedUnknown {
+			result = [32]byte{}
+			failure = ErrUpgrade
+		}
+	}()
+	if o.admitBorrowedLocked() != runtimeBorrowedLive {
+		return [32]byte{}, ErrUpgrade
+	}
+	if ctx.Err() != nil || o.resource.attempted || o.resource.handle == 0 || o.resource.handle == windows.InvalidHandle {
+		return [32]byte{}, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	threadLocked = true
+	return o.digestLocked(ctx)
+}
+
+// The actual composed transport holds credentials -> listener -> args ->
+// storage -> inventory and OS-thread affinity. Never call the locking digest
+// wrapper from that region or substitute previously parsed credential DATA.
+func (o *nativeRuntimeUpgradeCredentials) digestLocked(ctx context.Context) ([32]byte, error) {
+	if !runtimeUpgradeCredentialsKnown(o) || ctx == nil || ctx.Err() != nil || o.closed || o.unknown || o.resource == nil || o.admitBorrowedLocked() != runtimeBorrowedLive || o.resource.attempted || o.resource.handle == 0 || o.resource.handle == windows.InvalidHandle {
+		return [32]byte{}, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return [32]byte{}, ErrUpgrade
+	}
+	want, e := o.credentialIDLocked(ctx)
+	if e != nil {
+		return [32]byte{}, e
+	}
+	id, e := runtimeUpgradeArgsIdentity(o.resource.handle)
+	if e != nil || id != o.identity || runtimeStorageObjectData(&runtimeStorageObject{identity: id}) != want {
+		return [32]byte{}, ErrUpgrade
+	}
+	body, e := o.readLocked(ctx)
+	defer clear(body)
+	after, f := runtimeUpgradeArgsIdentity(o.resource.handle)
+	if e != nil || f != nil || after != id || !bytes.Equal(body, o.body) || runtimeUpgradeCredentialHash(body) != o.hash || ctx.Err() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	return o.hash, nil
+}
+
+// The same cached storage slot close is shared with controller-last storage
+// cleanup. Partial real owners can settle even when their borrowed args closed.
+func (o *nativeRuntimeUpgradeCredentials) Close() error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		o.clearSecretsLocked()
+		return ErrUpgrade
+	}
+	if o.closed {
+		return nil
+	}
+	n, a := o.storage, o.args
+	if !runtimeUpgradeArgsBorrowedBirth(a) || n != a.storage {
+		return ErrUpgrade
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	a.inventory.mu.Lock()
+	defer a.inventory.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			o.panicRefusalLocked()
+		}
+	}()
+	state := o.admitBorrowedLocked()
+	if state == runtimeBorrowedUnknown {
+		return ErrUpgrade
+	}
+	if o.resource != nil && state != runtimeBorrowedStorageClosed && n.closeOne(o.resource) != nil {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	o.clearSecretsLocked()
+	o.closed = true
+	runtimeUpgradeCredentialsCustody.Lock()
+	delete(runtimeUpgradeCredentialsCustody.owners, o)
+	runtimeUpgradeCredentialsCustody.Unlock()
+	return nil
+}
