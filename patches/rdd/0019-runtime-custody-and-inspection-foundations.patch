@@ -0,0 +1,88 @@
+package managementconfig
+
+import (
+	"encoding/json"
+	"testing"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func freshAppRecordFixture(t *testing.T) runtimeFreshAppRecord {
+	t.Helper()
+	p := freshPublicationFixture()
+	r := runtimeFreshAppRecord{Schema: 1, Transaction: p.Transaction, Nonce: "11111111111111111111111111111111", Intent: p.Intent, Parent: p.Parent, Controller: p.Controller, Authority: p.Authority, AuthorityLock: p.AuthorityLock, ParentDescriptor: p.ParentDescriptor, ControllerDescriptor: p.ControllerDescriptor, AuthorityDescriptor: [32]byte{3}, LockDescriptor: p.AuthorityLockDescriptor, Args: p.Args, Initialization: p.Initialization, Producer: p.Candidate}
+	var e error
+	r.Template, e = freshAppTemplate(r.Transaction, r.Nonce)
+	if e != nil || !r.valid() {
+		t.Fatal("actual desired template refused", e)
+	}
+	return r
+}
+func TestRuntimeFreshAppRecordPreservesOriginalTemplate(t *testing.T) {
+	r := freshAppRecordFixture(t)
+	b, e := runtimeFreshRecordBytes(r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var decoded runtimeFreshAppRecord
+	if parseRuntimeFreshRecord(b, &decoded) != nil || !decoded.valid() {
+		t.Fatal("canonical record rejected")
+	}
+	var a app.App
+	if json.Unmarshal(decoded.Template, &a) != nil {
+		t.Fatal("template")
+	}
+	a.UID = "actual-app-uid"
+	a.Spec.Kubernetes.Enabled = true
+	a.Spec.Kubernetes.Version = "retained-user-version"
+	if !freshAppMatches(decoded, &a) {
+		t.Fatal("matching original App spec was not preserved")
+	}
+	uid := a.UID
+	before, _ := json.Marshal(a)
+	if !freshAppMatches(decoded, &a) {
+		t.Fatal("repeat read")
+	}
+	after, _ := json.Marshal(a)
+	if string(before) != string(after) || a.UID != uid {
+		t.Fatal("validation changed actual App")
+	}
+	a.Annotations[freshAppCreateAnnotation] = "22222222222222222222222222222222"
+	if freshAppMatches(decoded, &a) {
+		t.Fatal("foreign App annotation adopted")
+	}
+	for _, bad := range [][]byte{append([]byte(" "), b...), append(append([]byte{}, b...), b...), []byte(`{"Schema":1,"Schema":1}`)} {
+		if parseRuntimeFreshRecord(bad, &decoded) == nil {
+			t.Fatal("noncanonical record")
+		}
+	}
+}
+func TestRuntimeFreshAppInventoriesRequireCompleteSuccessfulData(t *testing.T) {
+	a := &app.AppList{TypeMeta: metav1.TypeMeta{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "AppList"}, ListMeta: metav1.ListMeta{ResourceVersion: "1"}, Items: []app.App{}}
+	v := &lima.LimaVMList{TypeMeta: metav1.TypeMeta{APIVersion: "lima.rancherdesktop.io/v1alpha1", Kind: "LimaVMList"}, ListMeta: metav1.ListMeta{ResourceVersion: "2"}, Items: []lima.LimaVM{}}
+	if !freshAppInventoriesEmpty(a, v) {
+		t.Fatal("empty current inventories refused")
+	}
+	encoded, _ := json.Marshal(a)
+	for _, status := range []int{0, 401, 403, 404, 409, 429, 503} {
+		var out app.AppList
+		if decodeFreshAppInventory(status, encoded, &out) == nil {
+			t.Fatal("HTTP failure became empty inventory")
+		}
+	}
+	for _, body := range [][]byte{nil, []byte(`{"kind":"Status","items":[]}`), []byte(`{"kind":"AppList"`)} {
+		var out app.AppList
+		if decodeFreshAppInventory(200, body, &out) == nil && freshAppInventoriesEmpty(&out, v) {
+			t.Fatal("incomplete/error body became absence")
+		}
+	}
+	for _, change := range []func(*app.AppList, *lima.LimaVMList){func(a *app.AppList, _ *lima.LimaVMList) { a.Items = nil }, func(a *app.AppList, _ *lima.LimaVMList) { a.Items = []app.App{{}} }, func(_ *app.AppList, v *lima.LimaVMList) { v.Items = []lima.LimaVM{{}} }, func(a *app.AppList, _ *lima.LimaVMList) { a.Continue = "next" }, func(_ *app.AppList, v *lima.LimaVMList) { n := int64(1); v.RemainingItemCount = &n }, func(a *app.AppList, _ *lima.LimaVMList) { a.Kind = "Status" }} {
+		ac, vc := a.DeepCopy(), v.DeepCopy()
+		change(ac, vc)
+		if freshAppInventoriesEmpty(ac, vc) {
+			t.Fatal("partial/nonempty inventory treated as absence")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_app_windows.go b/rdd/pkg/managementconfig/runtime_fresh_app_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..1d57c638785578451285783a58161f779fdeb0b3
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_app_windows.go
@@ -0,0 +1,595 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"runtime"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"golang.org/x/sys/windows"
+)
+
+type nativeFreshAppAdmission struct {
+	w                                                       *FreshRuntimeObservation
+	record                                                  runtimeFreshAppRecord
+	object                                                  *runtimeStorageObject
+	initialization                                          *runtimeStorageObject
+	body                                                    []byte
+	decision                                                *FreshAppDecision
+	loaded, attempted, complete, readyToServe, servingBegun bool
+}
+
+// Closed internal response DATA from the SAME native-bound transport; never a
+// supplied response callback or an alternative endpoint/HTTP client.
+type freshAppHTTPResponse struct {
+	status int
+	body   []byte
+}
+
+func (w *FreshRuntimeObservation) apiExchangeLocked(ctx context.Context, method, route string, body []byte) (int, []byte, error) {
+	var response freshAppHTTPResponse
+	e := w.apiRequestLocked(ctx, method, route, body, &response)
+	if e != nil {
+		clear(response.body)
+		return 0, nil, e
+	}
+	return response.status, response.body, nil
+}
+
+// Original pending operation DATA, anchored by its actual retained witness.
+// A copy/decoded nonce cannot issue a native or API capability.
+type FreshAppDecision struct {
+	self      *FreshAppDecision
+	admission *nativeFreshAppAdmission
+	challenge string
+	consumed  bool
+}
+
+func (d *FreshAppDecision) Data() (string, string, error) {
+	if d == nil || d.self != d || d.admission == nil || d.admission.w == nil {
+		return "", "", ErrUpgrade
+	}
+	o := d.admission.w.owner
+	if o == nil || o.self != o {
+		return "", "", ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !d.originalLocked(o) {
+		return "", "", ErrUpgrade
+	}
+	return "prior-app-absent", d.challenge, nil
+}
+func (d *FreshAppDecision) originalLocked(o *FreshSetupOwner) bool {
+	if d == nil || d.self != d || d.admission == nil || d.admission.w == nil || d.consumed || !upgradeHex(d.challenge, 32) {
+		return false
+	}
+	a, w := d.admission, d.admission.w
+	return a.decision == d && w.appAdmission == a && o.observation == w && w.owner == o && w.exactLocked(o, w.created, w.publisher) && !o.unknown && !o.closed && !w.unknown && !w.closed && !a.attempted && !a.complete && a.loaded && a.object != nil && a.record.valid()
+}
+
+func (o *FreshSetupOwner) prepareFreshAppWitnessLocked(ctx context.Context, c *Created, p *ConfigPublisher) (*FreshRuntimeObservation, error) {
+	if o.created != c || o.unknown || o.closed || !o.captureComplete {
+		return nil, ErrUpgrade
+	}
+	w := o.observation
+	if w == nil {
+		w = &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+		w.self = w
+		o.observation = w // Strong partial capture before native outputs.
+	}
+	if !w.exactLocked(o, c, p) {
+		return nil, ErrUpgrade
+	}
+	return w, nil
+}
+
+// Caller holds owner/witness/publisher; short storage/thread scope only.
+func (a *nativeFreshAppAdmission) currentBindingLocked(ctx context.Context) (runtimeFreshAppRecord, error) {
+	w, o := a.w, a.w.owner
+	var f runtimeFreshAppRecord
+	if w.checkParentsLocked(ctx) != nil || !nativeFreshAppGateOriginal(w.gate) {
+		return f, ErrUpgrade
+	}
+	n, c := o.storage, w.created
+	err := func() error {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		if !o.nativeOutputsAdmittedLocked() || n.check() != nil || c.closeErr != nil || c.closed || len(c.authorityHandles) == 0 {
+			return ErrUpgrade
+		}
+		anchor, e := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		lock, e := runtimeStorageIdentityOf(c.authorityHandles[0], n.sid, false, true, false)
+		if e != nil || lock.size != 0 {
+			return ErrUpgrade
+		}
+		intent, e := n.read(o.fenceObject, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		f = runtimeFreshAppRecord{Schema: 1, Transaction: o.intent.Transaction, Intent: runtimeStorageFileData(o.fenceObject, intent), Parent: runtimeStorageObjectData(n.parent), Controller: runtimeStorageObjectData(n.controller), ParentDescriptor: n.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor, Authority: UpgradeObject{anchor.volume, anchor.high, anchor.low}, AuthorityLock: UpgradeObject{lock.volume, lock.high, lock.low}, AuthorityDescriptor: anchor.descriptor, LockDescriptor: lock.descriptor, Producer: o.origin.generation}
+		args, e := n.read(w.args, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if a.initialization == nil {
+			r, e := o.openFixed(c.anchor, "authority.init", false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+			if e != nil {
+				return ErrUpgrade
+			}
+			id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+			if e != nil {
+				return ErrUpgrade
+			}
+			a.initialization = &runtimeStorageObject{resource: r, identity: id, private: true}
+		}
+		ib, e := n.read(a.initialization, false)
+		if e != nil || validateInitialization(ib, args) != nil {
+			return ErrUpgrade
+		}
+		f.Args = runtimeStorageFileData(w.args, args)
+		f.Initialization = runtimeStorageFileData(a.initialization, ib)
+		return nil
+	}()
+	if err != nil {
+		return f, ErrUpgrade
+	}
+	return f, nil
+}
+
+func (a *nativeFreshAppAdmission) checkBindingLocked(ctx context.Context) error {
+	f, e := a.currentBindingLocked(ctx)
+	if e != nil || !freshAppBindingMatches(f, a.record) {
+		return ErrUpgrade
+	}
+	return a.w.owner.checkFreshRecordHeld(ctx, a.object, a.body)
+}
+
+// Preserve precise no-output missing status; generic record helpers deliberately
+// normalize errors and therefore cannot select first creation here.
+func (a *nativeFreshAppAdmission) loadLocked(ctx context.Context) error {
+	return a.loadAppRecordLocked(ctx)
+}
+
+func (a *nativeFreshAppAdmission) inventoryLocked(ctx context.Context) error {
+	w := a.w
+	if w.checkParentsLocked(ctx) != nil || w.owner.requireFreshNoGuestLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	var apps app.AppList
+	var vms lima.LimaVMList
+	for _, q := range []struct {
+		route string
+		out   any
+	}{{"/apis/app.rancherdesktop.io/v1alpha1/apps", &apps}, {"/apis/lima.rancherdesktop.io/v1alpha1/limavms", &vms}} {
+		status, data, e := w.apiExchangeLocked(ctx, http.MethodGet, q.route, nil)
+		if e != nil {
+			clear(data)
+			return ErrUpgrade
+		}
+		e = decodeFreshAppInventory(status, data, q.out)
+		clear(data)
+		if e != nil {
+			return ErrUpgrade
+		}
+	}
+	if !freshAppInventoriesEmpty(&apps, &vms) || w.checkParentsLocked(ctx) != nil || w.owner.requireFreshNoGuestLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (a *nativeFreshAppAdmission) existingLocked(ctx context.Context) (bool, error) {
+	status, b, e := a.w.apiExchangeLocked(ctx, http.MethodGet, "/apis/app.rancherdesktop.io/v1alpha1/apps/app", nil)
+	defer clear(b)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	if status == http.StatusNotFound {
+		// Named absence alone never authorizes a create. Successful complete
+		// inventories + actual native absence are checked independently below.
+		return false, nil
+	}
+	var object app.App
+	if status != http.StatusOK || json.Unmarshal(b, &object) != nil || !freshAppMatches(a.record, &object) {
+		return false, ErrUpgrade
+	}
+	if a.w.appCreatedUID != "" && a.w.appCreatedUID != string(object.UID) {
+		return false, ErrUpgrade
+	}
+	a.w.appCreatedUID = string(object.UID)
+	a.complete = true
+	return true, nil
+}
+
+func (a *nativeFreshAppAdmission) postLocked(ctx context.Context) error {
+	if !a.servingBegun || a.w.gate == nil || a.w.gate.phase.Load() != freshAppGateOpen || a.attempted || a.complete || !a.loaded || a.checkBindingLocked(ctx) != nil || a.inventoryLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	a.attempted = true
+	a.w.createAttempted = true // BEFORE write: no retry or rollback grant.
+	if a.decision != nil {
+		a.decision.consumed = true
+	}
+	var created app.App
+	if a.w.apiRequestLocked(ctx, http.MethodPost, "/apis/app.rancherdesktop.io/v1alpha1/apps", a.record.Template, &created) != nil || !freshAppMatches(a.record, &created) {
+		return ErrFreshAppReconcile
+	}
+	a.w.appCreatedUID = string(created.UID)
+	a.complete = true
+	return nil
+}
+
+func (o *FreshSetupOwner) PrepareFreshRuntimeApp(ctx context.Context, c *Created, p *ConfigPublisher) (decision *FreshAppDecision, result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w, e := o.prepareFreshAppWitnessLocked(ctx, c, p)
+	if e != nil {
+		return nil, e
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+		if result != nil && w.appAdmission != nil && w.appAdmission.servingBegun {
+			result = ErrFreshAppReconcile
+		}
+	}()
+	if w.checkParentsLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	if w.appAdmission == nil {
+		w.appAdmission = &nativeFreshAppAdmission{w: w}
+	}
+	if !w.credentialsCaptured {
+		if w.credentialsStarted {
+			return nil, ErrUpgrade
+		}
+		w.credentialsStarted = true
+		if w.captureCredentialsLocked(ctx) != nil {
+			return nil, ErrUpgrade
+		}
+		w.credentialsCaptured = true
+	}
+	a := w.appAdmission
+	if a.w != w {
+		return nil, ErrUpgrade
+	}
+	if a.complete {
+		return nil, nil
+	}
+	if !a.loaded {
+		e = a.loadLocked(ctx)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if a.inventoryLocked(ctx) != nil {
+				return nil, ErrUpgrade
+			}
+			a.record, e = a.currentBindingLocked(ctx)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			var nonce [16]byte
+			if _, e = rand.Read(nonce[:]); e != nil {
+				return nil, ErrUpgrade
+			}
+			a.record.Nonce = hex.EncodeToString(nonce[:])
+			a.record.Template, e = freshAppTemplate(a.record.Transaction, a.record.Nonce)
+			if e != nil || !a.record.valid() {
+				return nil, ErrUpgrade
+			}
+			a.body, e = runtimeFreshRecordBytes(a.record)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			if a.writeStagedRecordLocked(ctx) != nil {
+				return nil, ErrUpgrade
+			}
+			a.readyToServe = true
+			return nil, nil
+		}
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if a.checkBindingLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	if a.readyToServe {
+		return nil, nil
+	}
+	exists, e := a.existingLocked(ctx)
+	if e != nil || a.attempted {
+		if exists && e == nil {
+			return nil, nil
+		}
+		return nil, ErrFreshAppReconcile
+	}
+	if exists {
+		a.readyToServe = true
+		return nil, nil
+	}
+	if a.inventoryLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	if a.decision == nil {
+		var nonce [16]byte
+		if _, e = rand.Read(nonce[:]); e != nil {
+			return nil, ErrUpgrade
+		}
+		d := &FreshAppDecision{admission: a, challenge: hex.EncodeToString(nonce[:])}
+		d.self = d
+		a.decision = d
+	}
+	if !a.decision.originalLocked(o) {
+		return nil, ErrUpgrade
+	}
+	return a.decision, nil
+}
+
+func (o *FreshSetupOwner) ContinueFreshRuntimeApp(ctx context.Context, c *Created, p *ConfigPublisher, d *FreshAppDecision, nonce string) (result error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !d.originalLocked(o) || d.challenge != nonce || c != o.created || p == nil || d.admission.w.publisher != p {
+		return ErrUpgrade
+	}
+	w := d.admission.w
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+		if result != nil && w.appAdmission.servingBegun {
+			result = ErrFreshAppReconcile
+		}
+	}()
+	d.consumed = true // one consent attempt, including a failed recheck.
+	if d.admission.checkBindingLocked(ctx) != nil || d.admission.inventoryLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	d.admission.readyToServe = true
+	return nil
+}
+
+// Native irreversible boundary before the SAME manager.Start. No snapshot or
+// consent Boolean opens the gate: this retained original admission is rechecked.
+func (o *FreshSetupOwner) BeginFreshRuntimeApp(ctx context.Context, c *Created, p *ConfigPublisher) (result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || !w.exactLocked(o, c, p) || w.appAdmission == nil || !nativeFreshAppGateOriginal(w.gate) {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	a, g := w.appAdmission, w.gate
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+		if result != nil && g.phase.Load() == freshAppGateOpen {
+			result = ErrFreshAppReconcile
+		}
+	}()
+	if a.w != w || !a.readyToServe || a.servingBegun || a.checkBindingLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	if a.complete {
+		exists, e := a.existingLocked(ctx)
+		if e != nil || !exists {
+			return ErrUpgrade
+		}
+	} else if a.inventoryLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.phase.Load() != freshAppGatePending || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	a.servingBegun = true
+	g.phase.Store(freshAppGateOpen)
+	return nil
+}
+
+// Existing manager/webhooks are actually ready before this sole POST.
+func (o *FreshSetupOwner) CompleteFreshRuntimeApp(ctx context.Context, c *Created, p *ConfigPublisher) (result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return ErrFreshAppReconcile
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || !w.exactLocked(o, c, p) || w.appAdmission == nil || !nativeFreshAppGateOriginal(w.gate) {
+		return ErrFreshAppReconcile
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	a := w.appAdmission
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrFreshAppReconcile
+		}
+		if result != nil {
+			result = ErrFreshAppReconcile
+		}
+	}()
+	if !a.servingBegun || w.gate.phase.Load() != freshAppGateOpen || a.checkBindingLocked(ctx) != nil {
+		return ErrFreshAppReconcile
+	}
+	if a.complete || a.attempted {
+		exists, e := a.existingLocked(ctx)
+		if e != nil || !exists {
+			return ErrFreshAppReconcile
+		}
+		return nil
+	}
+	return a.postLocked(ctx)
+}
+
+func (w *FreshRuntimeObservation) pauseDecisionMatches(d *FreshAppDecision) bool {
+	if d == nil {
+		return true
+	}
+	return d.self == d && d.admission != nil && d.admission == w.appAdmission && d.admission.w == w && d.admission.decision == d
+}
+
+// Seal excludes all supported App/Lima writes from before API listen. Actual
+// service must also prove SAME manager.Start never ran before control cleanup.
+// d may be nil/consumed: neither decision DATA nor empty snapshots grant Stop.
+func (o *FreshSetupOwner) PrepareFreshRuntimeAppPause(ctx context.Context, c *Created, p *ConfigPublisher, d *FreshAppDecision) (result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || !w.exactLocked(o, c, p) || !w.pauseDecisionMatches(d) || !nativeFreshAppGateOriginal(w.gate) {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+	}()
+	if w.gate.sealPendingHeld(ctx, w) != nil {
+		return ErrUpgrade
+	}
+	if d != nil {
+		d.consumed = true
+	}
+	return nil
+}
+
+// Cached negative cancellation policy only. False requires an actually sealed
+// original gate; the service separately proves its manager was never started.
+func (o *FreshSetupOwner) FreshRuntimeAppMustPersist(c *Created, p *ConfigPublisher) bool {
+	if o == nil || o.self != o || c == nil || p == nil {
+		return true
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || !w.exactLocked(o, c, p) || o.unknown || o.closed || w.unknown || w.closed || !nativeFreshAppGateOriginal(w.gate) || w.gate.phase.Load() != freshAppGateSealed {
+		return true
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := o.storage
+	if n == nil {
+		return true
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	return p.closeErr != nil || p.pending != nil || c.closeErr != nil || n.unknown || n.closeErr != nil || !runtimeStorageDomainKnown()
+}
+
+// Native parents only after actual API/kine join. No listener or HTTP query
+// after shutdown. A preexisting registered guest is left untouched: no manager
+// was started under a sealed gate, and this method issues no Stop/unregister.
+func (o *FreshSetupOwner) RecheckFreshRuntimeAppPause(ctx context.Context, c *Created, p *ConfigPublisher, d *FreshAppDecision) (result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || !w.exactLocked(o, c, p) || !w.pauseDecisionMatches(d) || !nativeFreshAppGateOriginal(w.gate) || w.gate.phase.Load() != freshAppGateSealed {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+	}()
+	if w.checkFreshGateParentsLocked(ctx) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	w.gate.pauseRechecked.Store(true)
+	return nil
+}
+
+// Actual positive parent close caches only, never native rechecks of closed
+// resources. No caller's manager-retired Boolean or challenge is an issuer.
+func (o *FreshSetupOwner) ConfirmFreshRuntimeAppPause(d *FreshAppDecision) error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w := o.observation
+	if w == nil || w.self != w || w.owner != o || !w.pauseDecisionMatches(d) || !nativeFreshAppGateOriginal(w.gate) || w.gate.phase.Load() != freshAppGateSealed || !w.gate.pauseRechecked.Load() || !o.closed || o.closeErr != nil || o.unknown {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if !w.closed || w.unknown || !w.closeAttempt.attempted || w.closeAttempt.closeErr != nil || w.created == nil || o.created != w.created || w.publisher == nil || o.storage == nil {
+		return ErrUpgrade
+	}
+	p, c, n := w.publisher, w.created, o.storage
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	backend, ok := p.backend.(*nativeAuthority)
+	if !ok || backend == nil || backend.created != c || !p.closed || p.closeErr != nil || p.pending != nil || !c.closed || c.closeErr != nil || c.datastoreActive.Load() || n.captureSelf != n || !n.closeAttempted || n.closeErr != nil || n.unknown {
+		return ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := !runtimeStorageDomain.failed && !runtimeStorageDomain.owners[n]
+	runtimeStorageDomain.Unlock()
+	if !known {
+		return ErrUpgrade
+	}
+	return nil
+}
