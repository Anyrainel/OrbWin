+type runtimeManagementFakeConn struct {
+	mu            sync.Mutex
+	started       chan struct{}
+	wake          chan struct{}
+	startedOnce   sync.Once
+	wakeOnce      sync.Once
+	reads, writes int
+	closes        int
+	deadlines     int
+	closeErr      error
+	closePanic    bool
+}
+
+func newRuntimeManagementFakeConn() *runtimeManagementFakeConn {
+	return &runtimeManagementFakeConn{started: make(chan struct{}), wake: make(chan struct{})}
+}
+func (c *runtimeManagementFakeConn) Read([]byte) (int, error) {
+	c.mu.Lock()
+	c.reads++
+	c.mu.Unlock()
+	c.startedOnce.Do(func() { close(c.started) })
+	<-c.wake
+	return 0, io.EOF
+}
+func (c *runtimeManagementFakeConn) Write(b []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.writes++
+	return len(b), nil
+}
+func (c *runtimeManagementFakeConn) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.closes++
+	if c.closePanic {
+		panic("synthetic private close diagnostic")
+	}
+	return c.closeErr
+}
+func (c *runtimeManagementFakeConn) LocalAddr() net.Addr  { return &net.TCPAddr{} }
+func (c *runtimeManagementFakeConn) RemoteAddr() net.Addr { return &net.TCPAddr{} }
+func (c *runtimeManagementFakeConn) SetDeadline(deadline time.Time) error {
+	c.mu.Lock()
+	c.deadlines++
+	c.mu.Unlock()
+	if !deadline.After(time.Now()) {
