+	if !ok || backend == nil || backend.created != c || !p.serving.valid() || p.serving.PID != o.origin.generation.PID || p.serving.Creation != o.origin.generation.Creation || p.serving.Session != o.origin.generation.Session {
+		return ErrUpgrade
