+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"runtime"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual incomplete native capture only. Every output enters original n before
+// FILE_OPEN; neither a seed name nor a decoder supplies a native context.
+func (s *nativeFreshSetupChoice) openSeedChoiceLocked(ctx context.Context, name string, access, share uint32) (*runtimeStorageObject, error) {
+	if s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.storage == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o, n := s.owner, s.owner.storage
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !registered || !known || n.freshChoice != s || n.captureSelf != n || !n.captureStarted || n.captureComplete || n.captureKind != runtimeStorageFreshCapture || n.unknown || n.closeAttempted || len(n.ancestry) == 0 {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	if n.checkToken() != nil || n.checkObject(parent) != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent.resource.handle, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&slot.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, share, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if reply := runtimeStorageOpenReply(e, slot.handle != 0 && slot.handle != windows.InvalidHandle, func() {}, n.fence); reply != nil {
+		if n.unknown {
+			o.unknown = true
+		} else {
+			n.resources = n.resources[:len(n.resources)-1]
+		}
+		return nil, reply
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: slot, identity: id, private: true}, nil
+}
+func (s *nativeFreshSetupChoice) captureSeedChoiceLocked(ctx context.Context) (bool, error) {
+	if s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.storage == nil || !freshBoundedContext(ctx) {
+		return false, ErrUpgrade
+	}
+	n := s.owner.storage
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[s.owner]
+	freshSetupOwners.Unlock()
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !registered || !known || n.freshChoice != s || n.captureSelf != n || !n.captureStarted || n.captureComplete || n.captureKind != runtimeStorageFreshCapture || n.unknown || n.closeAttempted || len(n.ancestry) == 0 {
+		return false, ErrUpgrade
+	}
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil || len(names) > 512 {
+		return false, ErrUpgrade
+	}
+	var chosen string
+	repairPresent := false
+	for _, name := range names {
+		lower := strings.ToLower(name)
+		if strings.HasPrefix(lower, "authority.fresh.intent-") {
+			repairPresent = true
+		}
+		if !strings.HasPrefix(lower, "authority.fresh.seed") {
+			continue
+		}
+		if chosen != "" {
+			return false, ErrUpgrade
+		}
+		if _, e := parseRuntimeFreshSeedName(name); e != nil {
+			return false, ErrUpgrade
+		}
+		chosen = name
+	}
+	if chosen == "" {
+		if repairPresent {
+			return false, ErrUpgrade
+		}
+		return false, nil
+	}
+	parsed, e := parseRuntimeFreshSeedName(chosen)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	seed := &nativeFreshSeedCapture{owner: s.owner, name: parsed}
+	seed.self = seed
+	s.seed = seed
+	s.owner.seed = seed
+	seed.object, e = s.openSeedChoiceLocked(ctx, chosen, windows.FILE_READ_DATA, windows.FILE_SHARE_READ)
+	if e != nil || seed.object.identity.size != 0 || !runtimeFreshSeedObjectFact(seed.object, parsed.Binding).valid() {
+		return false, ErrUpgrade
+	}
+	return true, nil
+}
+func (s *nativeFreshSetupChoice) chooseSeededIntentLocked(ctx context.Context) error {
+	if s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := s.owner.storage
+	seed := s.seed
+	if seed == nil || seed.self != seed || seed.owner != s.owner || s.owner.seed != seed {
+		return ErrUpgrade
+	}
+	object, e := s.openSeedChoiceLocked(ctx, runtimeFreshFenceName, windows.FILE_READ_DATA|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil
+	}
+	if e != nil || object.identity.size > 1024 {
+		return ErrUpgrade
+	}
+	body, e := n.read(object, true)
+	if e != nil {
+		return ErrUpgrade
+	}
+	intent, parseErr := parseRuntimeFreshIntent(body)
+	if parseErr != nil {
+		seed.canonical, seed.canonicalBody = object, body
+		return nil
+	}
+	if intent.Schema != 2 || intent.Transaction != seed.name.Transaction || intent.Image != seed.name.Image || intent.Commit != seed.name.Commit || intent.Seed != runtimeFreshSeedObjectFact(seed.object, seed.name.Binding) {
+		return ErrUpgrade
+	}
+	// A DELETE lease cannot coexist with later immutable readers. Positively
+	// close this exact probe, reopen read-only, and match actual identity/body.
+	id := object.identity
+	if n.closeTemporary(object.resource) != nil {
+		return ErrUpgrade
+	}
+	immutable, e := s.openSeedChoiceLocked(ctx, runtimeFreshFenceName, windows.FILE_READ_DATA, windows.FILE_SHARE_READ)
+	if e != nil || immutable.identity != id {
+		return ErrUpgrade
+	}
+	again, e := n.read(immutable, false)
+	if e != nil || !bytes.Equal(again, body) {
+		return ErrUpgrade
+	}
+	r := &nativeFreshRecoveryOwner{owner: s.owner, selectedSeed: seed, selectedIntent: immutable}
+	r.self = r
+	nativeFreshRecoveries.Lock()
+	nativeFreshRecoveries.owners[r] = true
+	nativeFreshRecoveries.Unlock()
+	s.resume = r
+	n.freshRecovery = r
+	return nil
+}
+
+// Explicit original seed-recovery constructor: no root/guest has been created.
+// It never advertises completed legacy/initialized authority or fabricates r.
+func (o *FreshSetupOwner) finishSelectedSeedCapture(ctx context.Context) (failure error) {
+	if o == nil || o.self != o || o.storage == nil || o.seed == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n, s := o.storage, o.seed
+	if n.freshChoice == nil || n.freshChoice.seed != s || n.freshChoice.owner != o || n.freshChoice.initial || n.freshChoice.resume != nil || n.freshRecovery != nil || s.self != s || s.owner != o {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	known := s.knownLocked(ctx)
+	n.mu.Unlock()
+	if !known {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			failure = ErrUpgrade
+		}
+	}()
+	var e error
+	o.image, e = HoldServingImage(ctx, n.root.home, "orbwin")
+	if e != nil {
+		return ErrUpgrade
+	}
+	image := o.image.Image()
+	if hex.EncodeToString(image.Hash[:]) != s.name.Image {
+		return ErrUpgrade
+	}
+	o.origin, e = captureRuntimeMappedSelfOrigin(ctx, n, o.image, s.name.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	commit, e := o.origin.mappedSourceCommit(ctx, s.name.Transaction)
+	if e != nil || commit != s.name.Commit {
+		return ErrUpgrade
+	}
+	e = func() error {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		private := runtimeStorageObjectData(n.ancestry[len(n.ancestry)-1])
+		public := runtimeStorageObjectData(n.parent)
+		o.intent = runtimeFreshIntent{Schema: 2, Transaction: s.name.Transaction, Image: s.name.Image, Commit: s.name.Commit, PrivateParent: [3]uint32{private.Volume, private.High, private.Low}, PublicParent: [3]uint32{public.Volume, public.High, public.Low}, Seed: runtimeFreshSeedObjectFact(s.object, s.name.Binding)}
+		return s.resumeIntentLocked(ctx)
+	}()
+	if e != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.captureComplete = true
+	return nil
+}
