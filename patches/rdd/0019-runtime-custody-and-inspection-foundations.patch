--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_publication.go
@@ -0,0 +1,33 @@
+package managementconfig
+
+import "strings"
+
+// Negative namespace classification only; a true result issues no native
+// grant. Actual capture still binds every C object and immutable record.
+func runtimeFreshControlNamespaceNamesValid(names []string, transaction string, hasControl bool) bool {
+	allowed := map[string]bool{}
+	if hasControl {
+		retained, e := runtimeFreshControlRetainedName(transaction)
+		if e != nil {
+			return false
+		}
+		allowed[retained] = true
+		for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+			r, _ := runtimeFreshControlRecordName(ordinal)
+			b, _ := runtimeFreshControlBirthName(ordinal)
+			allowed[r], allowed[b] = true, true
+		}
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		lower := strings.ToLower(name)
+		if seen[lower] {
+			return false
+		}
+		seen[lower] = true
+		if (strings.HasPrefix(lower, "authority.retained.") || strings.HasPrefix(lower, "authority.fresh.control")) && !allowed[name] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_publication_test.go b/rdd/pkg/managementconfig/runtime_fresh_control_publication_test.go
