new file mode 100644
index 0000000000000000000000000000000000000000..f7a45fe2851f1db4d93474b463e8a7aa96e2624d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_storage_open_model.go
@@ -0,0 +1,58 @@
+package managementconfig
+
+// Interpretation DATA only. Native authority remains the original owner/frame.
+type runtimeStorageNativeOpenReply uint8
+
+const (
+	runtimeStorageNativeOpenUnknown runtimeStorageNativeOpenReply = iota
+	runtimeStorageNativeOpenFailure
+	runtimeStorageNativeOpenSuccess
+)
+
+func runtimeStorageClassifyNativeOpen(status, iosb uint32, information uintptr, disposition uint32, output, valid bool) runtimeStorageNativeOpenReply {
+	if disposition != 1 && disposition != 2 && disposition != 3 || valid && !output || status == 0x103 || iosb == 0x103 {
+		return runtimeStorageNativeOpenUnknown
+	}
+	if status == 0 {
+		expected := information == 1 && (disposition == 1 || disposition == 3) || information == 2 && (disposition == 2 || disposition == 3)
+		if !output || !valid || iosb != 0 || !expected {
+			return runtimeStorageNativeOpenUnknown
+		}
+		return runtimeStorageNativeOpenSuccess
+	}
+	// Informational NT_SUCCESS values do not establish a completed refusal.
+	// A terminal error without output preserves its exact native status.
+	if output || status&0x80000000 == 0 {
+		return runtimeStorageNativeOpenUnknown
+	}
+	return runtimeStorageNativeOpenFailure
+}
+
+type runtimeStorageNativeOpenState struct{ entered, returned, admitted, attached, unknown bool }
+
+func (s *runtimeStorageNativeOpenState) reply(kind runtimeStorageNativeOpenReply) bool {
+	if s == nil || !s.entered || s.returned || s.attached || s.unknown {
+		return false
+	}
+	s.returned = true
+	switch kind {
+	case runtimeStorageNativeOpenFailure:
+		return true
+	case runtimeStorageNativeOpenSuccess:
+		s.admitted = true
+		return true
+	default:
+		s.unknown = true
+		return false
+	}
+}
+func (s *runtimeStorageNativeOpenState) attach() bool {
+	if s == nil || !s.entered || !s.returned || !s.admitted || s.unknown || s.attached {
+		return false
+	}
+	s.attached = true
+	return true
+}
+func (s *runtimeStorageNativeOpenState) usable() bool {
+	return s != nil && s.entered && s.returned && s.admitted && s.attached && !s.unknown
+}
