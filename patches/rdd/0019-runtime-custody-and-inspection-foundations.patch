+func (w *FreshRuntimeObservation) captureGuestDirectoriesLocked(ctx context.Context) error {
+	n := w.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	home, e := w.owner.legacyGuestHomeLocked(ctx)
+	if e != nil || home == nil {
+		return ErrUpgrade
+	}
+	// Borrow SAME denial slot; storage alone closes this write/share-RW HOME.
+	w.directories = append(w.directories, home)
+	parent := home.resource.handle
+	for _, name := range []string{".rdorbwin", "lima", "orbwin"} {
+		if !freshBoundedContext(ctx) || !w.owner.nativeOutputsAdmittedLocked() {
+			return ErrUpgrade
+		}
+		text, e := windows.NewNTUnicodeString(name)
+		if e != nil {
+			return ErrUpgrade
+		}
