+		api, e := w.readAPILocked(ctx)
+		if e == nil {
+			w.api = api
+			break
+		}
+		if e != errFreshRuntimePending || w.unknown || o.unknown || ctx.Err() != nil {
+			return w, ErrUpgrade
+		}
+		timer := time.NewTimer(time.Second)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return w, ErrUpgrade
+		case <-timer.C:
+		}
+	}
