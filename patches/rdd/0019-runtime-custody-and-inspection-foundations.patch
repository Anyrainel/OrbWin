+// These entrypoint tests use no native caps. Invalid inputs, a positively closed
+// storage model, or an already unknown source lease prevent every native query.
+func TestRuntimeBuildOriginMappedEntryRefusesMissingAndUnboundedInputs(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	transaction := strings.Repeat("a", 32)
+	for _, input := range []struct {
+		ctx         context.Context
+		n           *nativeRuntimeStorage
+		l           *ServingImageLease
+		transaction string
+	}{
+		{nil, nil, nil, transaction}, {ctx, nil, &ServingImageLease{}, transaction}, {ctx, &nativeRuntimeStorage{}, nil, transaction}, {ctx, &nativeRuntimeStorage{}, &ServingImageLease{}, ""}, {ctx, &nativeRuntimeStorage{}, &ServingImageLease{}, strings.Repeat("A", 32)}, {context.Background(), &nativeRuntimeStorage{}, &ServingImageLease{}, transaction},
+	} {
+		if o, e := captureRuntimeMappedSelfOrigin(input.ctx, input.n, input.l, input.transaction); e == nil || o != nil {
+			t.Fatal("invalid mapped-self input reached capture")
+		}
+	}
+	for _, o := range []*nativeRuntimeBuildOrigin{nil, {}, {storage: &nativeRuntimeStorage{}}} {
+		if o.checkMappedSelf(ctx, transaction) == nil {
+			t.Fatal("missing graph passed mapped check")
+		}
+		if commit, e := o.mappedSourceCommit(ctx, transaction); e == nil || commit != "" {
+			t.Fatal("missing graph issued linked commit")
+		}
+	}
+}
