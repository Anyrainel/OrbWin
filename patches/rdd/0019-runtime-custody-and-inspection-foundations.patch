+package managementconfig
+
+import "testing"
+
+type publisherCloseFault struct {
+	publicationFake
+	attempts   int
+	panicClose bool
+}
+
+func (f *publisherCloseFault) close() error {
+	f.attempts++
+	if f.panicClose {
+		panic("test close panic")
+	}
+	return ErrPublication
+}
+
+func TestConfigPublisherCloseCachesFailureAndRecoveredPanic(t *testing.T) {
+	for _, panicClose := range []bool{false, true} {
+		f := &publisherCloseFault{panicClose: panicClose}
+		p := &ConfigPublisher{backend: f}
+		panicked := false
+		func() {
+			defer func() { panicked = recover() != nil }()
+			if p.Close() != ErrPublication {
+				t.Fatal("close failure disappeared")
+			}
+		}()
+		if panicked != panicClose {
+			t.Fatal("unexpected panic behavior")
+		}
+		if !p.closed || p.closeErr != ErrPublication || p.Close() != ErrPublication || p.Close() != ErrPublication || f.attempts != 1 {
+			t.Fatal("failed close was retried or replayed as positive")
+		}
+	}
+	p := &ConfigPublisher{}
+	if p.Close() != nil || p.Close() != nil {
+		t.Fatal("empty positive close not cached")
+	}
+}
