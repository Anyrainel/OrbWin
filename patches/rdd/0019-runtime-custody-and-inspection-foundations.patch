+// These actual effect entry points must refuse unregistered/copied wrappers
+// before any native operation. All pointers/slots here are inert and unowned.
+func TestRuntimeFreshDenialPrefixActualEntryRefusal(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
