+			}
+			body, admin := o.body, o.data.admin
+			if o.Close() != nil || o.Close() != nil || !o.closed || o.unknown || n.unknown || o.body != nil || o.data.admin != nil {
+				t.Fatal("known positive close/cache refused")
+			}
+			if !bytes.Equal(body, make([]byte, len(body))) || !bytes.Equal(admin, make([]byte, len(admin))) {
+				t.Fatal("positive completion did not clear buffers")
+			}
+		})
+	}
+}
+
+func TestRuntimeUpgradeCredentialsNativePanicIsSanitizedAndRetained(t *testing.T) {
+	o, n, _ := runtimeCredentialBorrowedFixture(t)
+	slot := &runtimeStorageResource{}
+	o.resource = slot
+	n.resources[1] = slot
+	unlock := runtimeCredentialLockFixture(o)
+	defer unlock()
+	var recovered any
+	func() {
+		defer func() { recovered = recover() }()
+		func() {
