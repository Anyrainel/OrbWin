+	if e != nil {
+		return ErrUpgrade
+	}
+	request.Header.Set("Authorization", "Bearer "+string(w.credentials.admin))
+	request.Header.Set("Content-Type", "application/json")
+	request.Close = true
+	if request.Write(t) != nil {
+		return ErrUpgrade
+	}
+	response, e := http.ReadResponse(bufio.NewReader(io.LimitReader(t, freshRuntimeResponseBudget+(64<<10))), request)
+	if e != nil {
+		return ErrUpgrade
+	}
+	data, e := io.ReadAll(io.LimitReader(response.Body, freshRuntimeResponseBudget+1))
+	defer clear(data)
+	// Do not call the generic body.Close drain on an oversized response: the
+	// exact owned connection closes below, without unbounded discarded input.
+	if e != nil || len(data) > freshRuntimeResponseBudget {
+		return ErrUpgrade
+	}
+	if raw, ok := output.(*freshAppHTTPResponse); ok {
+		if ctx.Err() != nil || w.unknown {
+			return ErrUpgrade
+		}
+		raw.status = response.StatusCode
+		raw.body = append([]byte(nil), data...)
+		return nil
+	}
