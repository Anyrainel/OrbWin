+package managementconfig
+
+import "testing"
+
+func TestRuntimeFreshRecoveryExactInterruptedLayouts(t *testing.T) {
+	a := freshPublicationFixture()
+	c := runtimeFreshCommitted{Schema: 1, Transaction: a.Transaction, Admission: a.Intent, Target: a.Stage}
+	zero := runtimePublicationFileWitness{}
+	for _, v := range []struct {
+		name          string
+		a             *runtimeFreshAdmission
+		c             *runtimeFreshCommitted
+		stage, target runtimePublicationFileWitness
+		want          runtimeFreshRecoveryLayout
+	}{
+		{"initialized before admission", nil, nil, zero, zero, runtimeFreshRecoveryInitialized},
+		{"admitted before rename", &a, nil, a.Stage, zero, runtimeFreshRecoveryPrepared},
+		{"renamed before commit", &a, nil, zero, a.Stage, runtimeFreshRecoveryRenamed},
+		{"checked commit", &a, &c, zero, a.Stage, runtimeFreshRecoveryCommitted},
+		{"both names", &a, nil, a.Stage, a.Stage, runtimeFreshRecoveryInvalid},
+		{"neither name", &a, nil, zero, zero, runtimeFreshRecoveryInvalid},
+		{"stage before admission", nil, nil, a.Stage, zero, runtimeFreshRecoveryUnadmittedStage},
+		{"target without admission", nil, nil, zero, a.Stage, runtimeFreshRecoveryInvalid},
+		{"early commit", &a, &c, a.Stage, zero, runtimeFreshRecoveryInvalid},
+	} {
+		t.Run(v.name, func(t *testing.T) {
+			if got := classifyRuntimeFreshRecovery(v.a, v.c, v.stage, v.target); got != v.want {
+				t.Fatal("wrong interrupted-state classification")
+			}
+		})
+	}
+	changed := a.Stage
+	changed.Object.Low++
+	if classifyRuntimeFreshRecovery(&a, nil, zero, changed) != runtimeFreshRecoveryInvalid {
+		t.Fatal("foreign target accepted")
+	}
+	changed = a.Stage
+	changed.Body[0]++
+	if classifyRuntimeFreshRecovery(&a, nil, changed, zero) != runtimeFreshRecoveryInvalid {
+		t.Fatal("different stage body accepted")
+	}
+}
+
+func TestRuntimeFreshRecoveryAdmissionOnlyRebindsActualGeneration(t *testing.T) {
+	a := freshPublicationFixture()
+	prior := a.Intent
+	r := runtimeFreshRecoveryAdmission{Schema: 1, Sequence: 1, Previous: prior, Current: a}
+	r.Current.Candidate.PID++
+	r.Current.Candidate.Creation++
+	if !r.matches(a, prior, 1) {
+		t.Fatal("new live generation rejected")
+	}
+	for _, change := range []func(*runtimeFreshRecoveryAdmission){
+		func(r *runtimeFreshRecoveryAdmission) { r.Current.Stage.Object.Low++ },
+		func(r *runtimeFreshRecoveryAdmission) { r.Current.Authority.Low++ },
+		func(r *runtimeFreshRecoveryAdmission) { r.Current.LegacyDenial.Body[0]++ },
+		func(r *runtimeFreshRecoveryAdmission) { r.Current.Runtime.Daemon = "different" },
+		func(r *runtimeFreshRecoveryAdmission) { r.Previous.Body[0]++ },
+		func(r *runtimeFreshRecoveryAdmission) { r.Sequence++ },
+	} {
+		bad := r
+		change(&bad)
+		if bad.matches(a, prior, 1) {
+			t.Fatal("recovery changed original admitted graph")
+		}
+	}
+	if _, e := runtimeFreshRecoveryRecordName(0); e == nil {
+		t.Fatal("zero record sequence")
+	}
+	if _, e := runtimeFreshRecoveryRecordName(runtimeFreshRecoveryLimit + 1); e == nil {
+		t.Fatal("unbounded record sequence")
+	}
+}
+
+func TestRuntimeFreshRecoveryOriginalStorageBindingIsExact(t *testing.T) {
+	a := freshPublicationFixture()
+	if !runtimeFreshAdmittedStorageMatches(a, a.Parent, a.Controller, a.ParentDescriptor, a.ControllerDescriptor) {
+		t.Fatal("original storage facts refused")
+	}
+	for _, change := range []func(*runtimeFreshAdmission){
+		func(a *runtimeFreshAdmission) { a.Parent.Low++ }, func(a *runtimeFreshAdmission) { a.Controller.Low++ },
+		func(a *runtimeFreshAdmission) { a.ParentDescriptor[0]++ }, func(a *runtimeFreshAdmission) { a.ControllerDescriptor[0]++ },
+	} {
+		bad := a
+		change(&bad)
+		if runtimeFreshAdmittedStorageMatches(bad, a.Parent, a.Controller, a.ParentDescriptor, a.ControllerDescriptor) {
+			t.Fatal("current exclusive ownership replaced original admitted binding")
+		}
+	}
+}
+
+func TestRuntimeFreshRecoveryBindsEncodedStageToObservedRecord(t *testing.T) {
+	a := freshPublicationFixture()
+	body, e := encodeRuntimeIdentity(a.Runtime, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !runtimeFreshRecoveryBodyMatches(a, body, a.Runtime.Home) {
+		t.Fatal("actual encoded record refused")
+	}
+	other := a.Runtime
+	other.Daemon = "different-daemon"
+	wrong, e := encodeRuntimeIdentity(other, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if runtimeFreshRecoveryBodyMatches(a, wrong, a.Runtime.Home) {
+		t.Fatal("valid stage with a different daemon passed admission")
+	}
+	other = a.Runtime
+	other.BinarySHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	wrong, e = encodeRuntimeIdentity(other, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if runtimeFreshRecoveryBodyMatches(a, wrong, a.Runtime.Home) {
+		t.Fatal("valid stage with a different mapped image passed admission")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_recovery_windows.go b/rdd/pkg/managementconfig/runtime_fresh_recovery_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..be06bf29965daeec615780d4cd0f6bda7d52ecbf
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_recovery_windows.go
@@ -0,0 +1,704 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+// Original native recovery birth, strongly retained before capture. Parsed
+// records describe expected objects; only actual fixed-role opens below mint
+// capabilities. All native resources belong to SAME storage/controller.
+type nativeFreshRecoveryOwner struct {
+	denialPrefix                             *nativeFreshDenialPrefix
+	seedValidation                           []*runtimeStorageResource
+	selectedSeed                             *nativeFreshSeedCapture
+	selectedIntent                           *runtimeStorageObject
+	tupleRecovery                            *nativeFreshTupleRecovery
+	controlRetention                         *nativeFreshControlRecovery
+	missingControl                           *nativeFreshMissingControl
+	guestPreflight                           *nativeFreshGuestPreflight
+	self                                     *nativeFreshRecoveryOwner
+	owner                                    *FreshSetupOwner
+	stage, target                            *runtimeStorageObject
+	stageBody, targetBody                    []byte
+	admissionObject, commitObject            *runtimeStorageObject
+	admissionBody, commitBody                []byte
+	admission                                *runtimeFreshAdmission
+	committed                                *runtimeFreshCommitted
+	sequence                                 uint32
+	denial                                   *nativeFreshExistingLegacyDenial
+	control, ownerLock, args, initialization *runtimeStorageObject
+	argsBody, initializationBody             []byte
+	complete                                 bool
+}
+
+var nativeFreshRecoveries = struct {
+	sync.Mutex
+	owners map[*nativeFreshRecoveryOwner]bool
+}{owners: make(map[*nativeFreshRecoveryOwner]bool)}
+
+func (r *nativeFreshRecoveryOwner) admitted(n *nativeRuntimeStorage) bool {
+	if r == nil || r.self != r || r.owner == nil || r.owner.self != r.owner || r.owner.storage != n || n == nil || n.captureSelf != n || n.freshRecovery != r || r.owner.unknown || r.owner.closed {
+		return false
+	}
+	nativeFreshRecoveries.Lock()
+	known := nativeFreshRecoveries.owners[r]
+	nativeFreshRecoveries.Unlock()
+	freshSetupOwners.Lock()
+	known = known && freshSetupOwners.owners[r.owner]
+	freshSetupOwners.Unlock()
+	return known
+}
+
+// Actual existing boundary/controller capture calls this before publishing
+// storage completion. It never creates a stage, target, controller or route.
+func (n *nativeRuntimeStorage) finishFreshRecoveryCapture(ctx context.Context) error {
+	if n == nil {
+		return ErrUpgrade
+	}
+	r := n.freshRecovery
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || !n.captureStarted || n.captureComplete || n.closeAttempted || n.unknown || !freshBoundedContext(ctx) || n.check() != nil {
+		return ErrUpgrade
+	}
+	for _, v := range []struct {
+		name   string
+		object **runtimeStorageObject
+		body   *[]byte
+	}{{"runtime.publication.stage", &r.stage, &r.stageBody}, {"runtime.json", &r.target, &r.targetBody}} {
+		object, e := r.openDuringCaptureLocked(ctx, v.name)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			continue
+		}
+		if e != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if _, e = parseRuntimeIdentity(body, n.home); e != nil {
+			return ErrUpgrade
+		}
+		*v.object = object
+		*v.body = body
+	}
+	n.predecessor = r.target
+	n.predecessorBody = append([]byte(nil), r.targetBody...)
+	if n.check() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	n.captureComplete = true
+	return nil
+}
+
+func (r *nativeFreshRecoveryOwner) openDuringCaptureLocked(ctx context.Context, name string) (*runtimeStorageObject, error) {
+	n := r.owner.storage
+	if !r.admitted(n) || !n.captureStarted || n.captureComplete || !freshBoundedContext(ctx) || n.unknown || n.check() != nil || (name != "runtime.publication.stage" && name != "runtime.json") {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: n.parent.resource.handle, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	access := uint32(windows.FILE_READ_DATA)
+	if name == "runtime.publication.stage" {
+		access |= windows.DELETE
+	}
+	e = windows.NtCreateFile(&slot.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if reply := runtimeStorageOpenReply(e, slot.handle != 0 && slot.handle != windows.InvalidHandle, func() {}, n.fence); reply != nil {
+		if !n.unknown {
+			n.resources = n.resources[:len(n.resources)-1]
+		}
+		return nil, reply
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: slot, identity: id, private: true}, nil
+}
+
+// ResumeFreshSetupOwner uses the actual persistent process, current selection,
+// existing strict boundary and FILE_OPEN-only SAME setup.lock. It cannot be
+// selected by a caller path, PID, digest, readiness Boolean or decoded receipt.
+func ResumeFreshSetupOwner(ctx context.Context) (o *FreshSetupOwner, failure error) {
+	if requireFreshPersistentProcess(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	o = &FreshSetupOwner{}
+	o.self = o
+	freshSetupOwners.Lock()
+	if len(freshSetupOwners.owners) >= 16 {
+		freshSetupOwners.Unlock()
+		return nil, ErrUpgrade
+	}
+	freshSetupOwners.owners[o] = true
+	freshSetupOwners.Unlock()
+	r := &nativeFreshRecoveryOwner{owner: o}
+	r.self = r
+	nativeFreshRecoveries.Lock()
+	nativeFreshRecoveries.owners[r] = true
+	nativeFreshRecoveries.Unlock()
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			failure = ErrUpgrade
+		}
+	}()
+	var e error
+	o.selection, e = authoritypath.CaptureCurrentProduct(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	selection, e := o.selection.Selection(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	root := &InstanceRoot{home: selection.GuestHome(), sid: selection.Owner(), selection: selection}
+	o.storage, e = allocateNativeFreshRuntimeStorageCapture(ctx, root)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	o.storage.freshRecovery = r
+	if o.storage.captureNativeFresh(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	if r.finishOwnerCapture(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	return o, nil
+}
+
+// Unpublished actual constructor completion, shared by explicit and native-selected resume.
+func (r *nativeFreshRecoveryOwner) finishOwnerCapture(ctx context.Context) (failure error) {
+	defer func() {
+		if r.denialPrefix != nil {
+			r.denialPrefix.producer.settleAttempt(&failure, recover() != nil)
+		}
+	}()
+	o := r.owner
+	var e error
+	if r.captureRecords(ctx) != nil {
+		return ErrUpgrade
+	}
+	o.image, e = HoldServingImage(ctx, o.storage.root.home, "orbwin")
+	if e != nil {
+		return ErrUpgrade
+	}
+	image := o.image.Image()
+	if hex.EncodeToString(image.Hash[:]) != o.intent.Image {
+		return ErrUpgrade
+	}
+	o.origin, e = captureRuntimeMappedSelfOrigin(ctx, o.storage, o.image, o.intent.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	commit, e := o.origin.mappedSourceCommit(ctx, o.intent.Transaction)
+	if e != nil || commit != o.intent.Commit {
+		return ErrUpgrade
+	}
+	expected := runtimePublicationFileWitness{}
+	if r.admission != nil {
+		expected = r.admission.LegacyDenial
+	}
+	pending, pe := r.selectOriginalDenialPrefix(ctx)
+	if pe != nil {
+		return ErrUpgrade
+	}
+	if pending {
+		p, e := r.captureOriginalDenialPrefix(ctx)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if p.resumeOriginal(ctx) != nil {
+			return ErrUpgrade
+		}
+	}
+	r.denial, e = o.storage.captureFreshLegacyDenialStorage(ctx, o.intent, expected)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if r.admission != nil {
+		n := o.storage
+		completion, ce := func() (runtimePublicationFileWitness, error) {
+			n.mu.Lock()
+			defer n.mu.Unlock()
+			runtime.LockOSThread()
+			defer runtime.UnlockOSThread()
+			return r.denial.completionDataLocked(ctx)
+		}()
+		if ce != nil || completion != r.admission.DenialCompletion {
+			return ErrUpgrade
+		}
+	}
+	if r.denialPrefix != nil {
+		if r.finishPrefixGuest(ctx) != nil {
+			return ErrUpgrade
+		}
+	} else if r.captureGuestPreflight(ctx) != nil {
+		return ErrUpgrade
+	}
+	if r.captureExistingOrMissingControl(ctx) != nil {
+		return ErrUpgrade
+	}
+	// This is an actual completed native graph, not a dummy old writer slot.
+	if r.denialPrefix != nil {
+		d := r.denialPrefix.producer
+		if o.legacyDenial != d || d.prefix != r.denialPrefix {
+			return ErrUpgrade
+		}
+		d.existing = r.denial
+		d.receipt = r.denial.receipt
+		d.directories = r.denial.directories
+		d.completion = r.denial.completion
+		d.completionBody = r.denial.completionBody
+	} else {
+		o.legacyDenial = &runtimeFreshLegacyDenial{owner: o, boundary: o.storage.parent, directories: r.denial.directories, receipt: r.denial.receipt, record: r.denial.record, body: r.denial.body, completion: r.denial.completion, completionBody: r.denial.completionBody, completed: true, existing: r.denial}
+	}
+	o.mu.Lock()
+	if !freshBoundedContext(ctx) {
+		o.mu.Unlock()
+		return ErrUpgrade
+	}
+	r.complete = true
+	o.captureComplete = true
+	o.mu.Unlock()
+	return nil
+}
+
+func (r *nativeFreshRecoveryOwner) readPrivateLocked(ctx context.Context, name string) (*runtimeStorageObject, []byte, error) {
+	n := r.owner.storage
+	if !r.admitted(n) || len(n.ancestry) == 0 {
+		return nil, nil, ErrUpgrade
+	}
+	object, e := n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return nil, nil, e
+	}
+	body, e := n.read(object, false)
+	if e != nil {
+		return nil, nil, ErrUpgrade
+	}
+	return object, body, nil
+}
+
+func (r *nativeFreshRecoveryOwner) captureRecords(ctx context.Context) error {
+	o, n := r.owner, r.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	object, body, e := r.readPrivateLocked(ctx, runtimeFreshFenceName)
+	if e != nil {
+		return ErrUpgrade
+	}
+	o.intent, e = parseRuntimeFreshIntent(body)
+	if e != nil {
+		return ErrUpgrade
+	}
+	o.fenceObject = object
+	seedStart := len(n.resources)
+	if n.checkFreshSeedIntentLocked(ctx, o.intent, runtimeStorageFileData(object, body)) != nil {
+		return ErrUpgrade
+	}
+	r.seedValidation = append([]*runtimeStorageResource(nil), n.resources[seedStart:]...)
+	private := runtimeStorageObjectData(n.ancestry[len(n.ancestry)-1])
+	public := runtimeStorageObjectData(n.parent)
+	if o.intent.PrivateParent != [3]uint32{private.Volume, private.High, private.Low} || o.intent.PublicParent != [3]uint32{public.Volume, public.High, public.Low} {
+		return ErrUpgrade
+	}
+	r.admissionObject, r.admissionBody, e = r.readPrivateLocked(ctx, runtimeFreshAdmissionName)
+	if e != nil && e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrUpgrade
+	}
+	if e == nil {
+		var a runtimeFreshAdmission
+		if parseRuntimeFreshRecord(r.admissionBody, &a) != nil || !a.valid() || a.Transaction != o.intent.Transaction || a.Intent != runtimeStorageFileData(object, body) || a.Runtime.BinarySHA != o.intent.Image || a.Runtime.SourceCommit != o.intent.Commit || a.Seed != o.intent.Seed {
+			return ErrUpgrade
+		}
+		r.admission = &a
+	}
+	if r.checkAdmittedStorageLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	gap := false
+	for sequence := uint32(1); sequence <= runtimeFreshRecoveryLimit; sequence++ {
+		name, _ := runtimeFreshRecoveryRecordName(sequence)
+		object, b, e := r.readPrivateLocked(ctx, name)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || r.admission == nil {
+			return ErrUpgrade
+		}
+		var recovered runtimeFreshRecoveryAdmission
+		if parseRuntimeFreshRecord(b, &recovered) != nil || !recovered.matches(*r.admission, runtimeStorageFileData(r.admissionObject, r.admissionBody), sequence) {
+			return ErrUpgrade
+		}
+		r.sequence = sequence
+		r.admissionObject, r.admissionBody = object, b
+		a := recovered.Current
+		r.admission = &a
+	}
+	if r.admission != nil {
+		if r.stage != nil && !runtimeFreshRecoveryBodyMatches(*r.admission, r.stageBody, n.home) {
+			return ErrUpgrade
+		}
+		if r.target != nil && !runtimeFreshRecoveryBodyMatches(*r.admission, r.targetBody, n.home) {
+			return ErrUpgrade
+		}
+	} else if r.stage != nil {
+		staged, e := parseRuntimeIdentity(r.stageBody, n.home)
+		if e != nil || !runtimeFreshOrphanStageMatches(o.intent, r.stageBody, staged, n.home) {
+			return ErrUpgrade
+		}
+	}
+	r.commitObject, r.commitBody, e = r.readPrivateLocked(ctx, runtimeFreshCommittedName)
+	if e != nil && e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrUpgrade
+	}
+	if e == nil {
+		var c runtimeFreshCommitted
+		if r.admission == nil || parseRuntimeFreshRecord(r.commitBody, &c) != nil || !c.matches(*r.admission) || c.Admission != runtimeStorageFileData(r.admissionObject, r.admissionBody) {
+			return ErrUpgrade
+		}
+		r.committed = &c
+	}
+	if r.layoutLocked() == runtimeFreshRecoveryInvalid {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (r *nativeFreshRecoveryOwner) layoutLocked() runtimeFreshRecoveryLayout {
+	stage, target := runtimePublicationFileWitness{}, runtimePublicationFileWitness{}
+	if r.stage != nil {
+		stage = runtimeStorageFileData(r.stage, r.stageBody)
+	}
+	if r.target != nil {
+		target = runtimeStorageFileData(r.target, r.targetBody)
+	}
+	return classifyRuntimeFreshRecovery(r.admission, r.committed, stage, target)
+}
+
+func (r *nativeFreshRecoveryOwner) captureInitializedAuthority(ctx context.Context) error {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := r.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	return r.captureInitializedAuthorityNativeLocked(ctx)
+}
+
+// Same fixed FILE_OPEN-only initialized reader, for recovery which already
+// owns the ORIGINAL owner/storage locks and thread. No failure becomes CREATE.
+func (r *nativeFreshRecoveryOwner) captureInitializedAuthorityNativeLocked(ctx context.Context) error {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := r.owner.storage
+	if !r.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) || len(n.ancestry) == 0 || r.checkAdmittedStorageLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	var e error
+	r.control, e = n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	// This actual exclusive existing role excludes a still-live selected
+	// producer/service. PID text and record flags never substitute for it.
+	r.ownerLock, e = n.openFreshExistingTracked(ctx, r.control.resource.handle, "authority.owner.lock", false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, 0, true, false)
+	if e != nil || r.ownerLock.identity.size != 0 {
+		return ErrUpgrade
+	}
+	r.args, e = n.openFreshExistingTracked(ctx, r.control.resource.handle, "args.json", false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r.argsBody, e = n.read(r.args, false)
+	if e != nil || parseFreshRuntimeSavedArguments(r.argsBody) != nil {
+		return ErrUpgrade
+	}
+	r.initialization, e = n.openFreshExistingTracked(ctx, r.control.resource.handle, "authority.init", false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r.initializationBody, e = n.read(r.initialization, false)
+	if e != nil || validateInitialization(r.initializationBody, r.argsBody) != nil {
+		return ErrUpgrade
+	}
+	if a := r.admission; a != nil {
+		if runtimeStorageObjectData(r.control) != a.Authority || runtimeStorageObjectData(r.ownerLock) != a.AuthorityLock || r.ownerLock.identity.descriptor != a.AuthorityLockDescriptor || runtimeStorageFileData(r.args, r.argsBody) != a.Args || runtimeStorageFileData(r.initialization, r.initializationBody) != a.Initialization {
+			return ErrUpgrade
+		}
+	}
+	tls, e := n.openFreshExistingTracked(ctx, r.control.resource.handle, "tls", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	var material [3][]byte
+	defer func() {
+		for _, b := range material {
+			clear(b)
+		}
+	}()
+	for i, name := range []string{"apiserver.crt", "apiserver.key", "sa.key"} {
+		object, e := n.openFreshExistingTracked(ctx, tls.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		material[i], e = n.readFreshRecoverySecretLocked(ctx, object)
+		if e != nil {
+			return ErrUpgrade
+		}
+	}
+	if validateAuthorityMaterial(material[0], material[1], material[2]) != nil {
+		return ErrUpgrade
+	}
+	return n.checkPrevious()
+}
+
+// Existing initialized control authority is captured into the SAME actual
+// Created graph. No key/default/DB bytes are regenerated or rewritten here.
+func (o *FreshSetupOwner) OpenRecoveryServiceAuthority(ctx context.Context) (c *Created, failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n := o.storage
+	if n == nil || n.freshRecovery == nil {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	if !r.admitted(n) || !r.complete || !o.captureComplete || o.created != nil || o.origin == nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || r.checkAdmittedStorageLocked(ctx) != nil || n.checkPrevious() != nil || o.checkLegacyStartDenialLocked(ctx) != nil || n.checkObject(r.control) != nil || n.checkObject(r.ownerLock) != nil {
+		return nil, ErrUpgrade
+	}
+	return o.duplicateCapturedAuthorityNativeLocked(ctx, r.control, r.ownerLock)
+}
+
+// Shared actual duplication below distinct initialized/captured-header guards.
+// Root must be an actual FILE_OPEN serving lease; no decoded record or caller
+// Boolean constructs one. All native outputs enter actual c before effects.
+func (o *FreshSetupOwner) duplicateCapturedAuthorityNativeLocked(ctx context.Context, root, lock *runtimeStorageObject) (c *Created, failure error) {
+	if o == nil || o.self != o || o.storage == nil {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || !freshBoundedContext(ctx) || o.created != nil || n.freshRecovery == nil || !n.freshRecovery.admitted(n) || !n.freshRecovery.complete || root == nil || lock == nil || !root.directory || !root.private || lock.directory || !lock.private || lock.identity.size != 0 {
+		return nil, ErrUpgrade
+	}
+	rootOwned, lockOwned := false, false
+	for _, slot := range n.resources {
+		if slot != nil && !slot.attempted && slot.handle != 0 {
+			rootOwned = rootOwned || slot == root.resource
+			lockOwned = lockOwned || slot == lock.resource
+		}
+	}
+	if !rootOwned || !lockOwned || n.checkPrevious() != nil || n.checkObject(root) != nil || n.checkObject(lock) != nil {
+		return nil, ErrUpgrade
+	}
+	c = &Created{parents: &ParentLease{sid: n.sid}}
+	o.created = c
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			n.fence()
+			c = nil
+			failure = ErrUpgrade
+		}
+	}()
+	duplicate := func(source windows.Handle, target *windows.Handle) error {
+		e := windows.DuplicateHandle(windows.CurrentProcess(), source, windows.CurrentProcess(), target, 0, false, windows.DUPLICATE_SAME_ACCESS)
+		if runtimeStorageOpenReply(e, *target != 0 && *target != windows.InvalidHandle, func() {}, n.fence) != nil {
+			o.unknown = true
+			return ErrUpgrade
+		}
+		return nil
+	}
+	for _, parent := range n.ancestry {
+		if ctx.Err() != nil || n.checkObject(parent) != nil {
+			return nil, ErrUpgrade
+		}
+		c.parents.chain = append(c.parents.chain, 0)
+		slot := len(c.parents.chain) - 1
+		if duplicate(parent.resource.handle, &c.parents.chain[slot]) != nil {
+			return nil, ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(c.parents.chain[slot], n.sid, parent.directory, parent.private, parent.traversal)
+		if e != nil || id != parent.identity {
+			return nil, ErrUpgrade
+		}
+	}
+	c.parent = c.parents.leaf()
+	if duplicate(root.resource.handle, &c.anchor) != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+	if e != nil || id != root.identity {
+		return nil, ErrUpgrade
+	}
+	c.authorityHandles = append(c.authorityHandles, 0)
+	if duplicate(lock.resource.handle, &c.authorityHandles[0]) != nil {
+		return nil, ErrUpgrade
+	}
+	id, e = runtimeStorageIdentityOf(c.authorityHandles[0], n.sid, false, true, false)
+	if e != nil || id != lock.identity || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	c.managedOwnerLock = c.authorityHandles[0]
+	c.servingLease = true
+	return c, nil
+}
+
+// Native proof constructor only: exact current object/namespace/bytes and the
+// original registered recovery graph precede the lower prepared capability.
+func (n *nativeRuntimeStorage) resumePreparedStorage(ctx context.Context) (*nativeRuntimePrepared, error) {
+	if n == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || !r.complete || r.layoutLocked() != runtimeFreshRecoveryPrepared || r.checkLayoutLocked(ctx) != nil || n.prepared || n.attempt.used {
+		return nil, ErrUpgrade
+	}
+	n.stage = r.stage
+	n.stageBody = append([]byte(nil), r.stageBody...)
+	n.prepared = true
+	return &nativeRuntimePrepared{owner: n}, nil
+}
+
+func (n *nativeRuntimeStorage) resumeRenamedStorageReceipt(ctx context.Context) (*nativeRuntimeStorageReceipt, error) {
+	if n == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || !r.complete || (r.layoutLocked() != runtimeFreshRecoveryRenamed && r.layoutLocked() != runtimeFreshRecoveryCommitted) || r.checkLayoutLocked(ctx) != nil || n.attempt.used {
+		return nil, ErrUpgrade
+	}
+	// The admitted object is actually at the exact target and stage is actually
+	// absent. Completion is derived here from native graph evidence, never JSON.
+	n.target = r.target
+	n.stageBody = append([]byte(nil), r.targetBody...)
+	n.attempt = runtimeStorageAttempt{used: true, armed: true, complete: true}
+	return &nativeRuntimeStorageReceipt{n, n.target, append([]byte(nil), r.targetBody...)}, nil
+}
+
+func (r *nativeFreshRecoveryOwner) checkLayoutLocked(ctx context.Context) error {
+	n := r.owner.storage
+	if !r.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) || !freshBoundedContext(ctx) || r.checkAdmittedStorageLocked(ctx) != nil || n.checkPrevious() != nil {
+		return ErrUpgrade
+	}
+	for _, v := range []struct {
+		name   string
+		object *runtimeStorageObject
+		body   []byte
+	}{{"runtime.publication.stage", r.stage, r.stageBody}, {"runtime.json", r.target, r.targetBody}} {
+		actual, e := n.openFreshExistingTracked(ctx, n.parent.resource.handle, v.name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+		if v.object == nil {
+			if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+				return ErrUpgrade
+			}
+			continue
+		}
+		if e != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(actual, false)
+		same := e == nil && actual.identity == v.object.identity && bytes.Equal(body, v.body)
+		if n.closeTemporary(actual.resource) != nil || !same {
+			return ErrUpgrade
+		}
+	}
+	if r.denial == nil || r.denial.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Use the existing credential reader's terminal-success clearing contract for
+// owned default key buffers, including a panic before return assignment.
+func (n *nativeRuntimeStorage) readFreshRecoverySecretLocked(ctx context.Context, object *runtimeStorageObject) (body []byte, failure error) {
+	var owned []byte
+	complete := false
+	defer func() {
+		if !complete {
+			clear(owned)
+		}
+	}()
+	if !freshBoundedContext(ctx) || object == nil || n.checkObject(object) != nil {
+		return nil, ErrUpgrade
+	}
+	var e error
+	body, e = readRuntimeUpgradeCredentials(ctx, object.identity.size, func() error {
+		_, e := windows.SetFilePointer(object.resource.handle, 0, nil, windows.FILE_BEGIN)
+		return e
+	}, func(out []byte) (uint32, error) {
+		var count uint32
+		e := windows.ReadFile(object.resource.handle, out, &count, nil)
+		return count, e
+	})
+	owned = body
+	if e != nil || n.checkObject(object) != nil {
+		return nil, ErrUpgrade
+	}
+	complete = true
+	return body, nil
+}
+
+// Caller holds storage.mu/thread. Compare ORIGINAL admitted storage facts
+// first, then validate SAME captured native objects, before any capability or
+// Created effects. An exclusive replacement empty lock is never the old lock.
+func (r *nativeFreshRecoveryOwner) checkAdmittedStorageLocked(ctx context.Context) error {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := r.owner.storage
+	if !r.admitted(n) || !freshBoundedContext(ctx) || n.parent == nil || n.controller == nil {
+		return ErrUpgrade
+	}
+	if a := r.admission; a != nil {
+		if !runtimeFreshAdmittedStorageMatches(*a, runtimeStorageObjectData(n.parent), runtimeStorageObjectData(n.controller), n.parent.identity.descriptor, n.controller.identity.descriptor) {
+			return ErrUpgrade
+		}
+	}
+	if !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_recovery_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_recovery_windows_test.go
