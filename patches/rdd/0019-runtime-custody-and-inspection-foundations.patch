+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: SUSE LLC
+// SPDX-FileCopyrightText: The Rancher Desktop Authors
+// Factored from the original service.go embedded-manager caller.
+package service
+
+import (
+	"context"
+	"path/filepath"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/controllers/base"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd/options"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/controllers"
+	"k8s.io/klog/v2"
+)
+
+// Same upstream wrapper, client and registrations. Construction/registering
+// does not call underlying manager.Start/RegisterWithManager. Fresh serving
+// can therefore install its existing CRDs before admitting App/VM writes.
+func prepareSharedControllerManager(ctx context.Context, opts options.CompletedOptions, completed options.CompletedConfig, authority privateAuthority, endpoint string, cert []byte, enabled []base.Controller) (*controllers.SharedControllerManager, error) {
+	offset := 4 * instance.Index()
+	mgr, e := controllers.NewSharedControllerManager("embedded", completed.ControlPlane.Generic.LoopbackClientConfig, 8082+offset, 8083+offset)
+	if e != nil {
+		return nil, e
+	}
+	certOptions := opts.ControlPlane.SecureServing.ServerCert
+	defaultAuthority := certOptions.CertDirectory == instance.TLSDir() && certOptions.PairName == "apiserver" &&
+		(certOptions.CertKey.CertFile == "" || certOptions.CertKey.CertFile == filepath.Join(instance.TLSDir(), "apiserver.crt")) &&
+		(certOptions.CertKey.KeyFile == "" || certOptions.CertKey.KeyFile == filepath.Join(instance.TLSDir(), "apiserver.key")) && certOptions.GeneratedCert == nil && certOptions.FixtureDirectory == "" &&
+		opts.AdminAuthentication.ShardAdminTokenHashFilePath == filepath.Join(instance.TLSDir(), ".admin-token-store")
+	if instance.Suffix() == "orbwin" && (defaultAuthority || authority != nil) {
+		identity, e := networkproxy.NewServingIdentity(endpoint, cert)
+		if e == nil && authority != nil {
+			e = authority.BindServing(identity)
+		} else if e == nil {
+			e = errPrivatePublication
+		}
+		if e == nil {
+			e = mgr.SetProxyServingIdentity(identity)
+		}
+		if e != nil {
+			klog.Warning("Proxy serving binding unavailable")
+			if isFreshService(authority) {
+				return nil, errPrivatePublication
+			}
+		}
+	}
+	if configureManagedRuntime(ctx, mgr, authority) != nil {
+		return nil, errPrivatePublication
+	}
+	for _, controller := range enabled {
+		if e := mgr.RegisterController(controller); e != nil {
+			return nil, e
+		}
+	}
+	return mgr, nil
+}
