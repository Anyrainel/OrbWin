+	if seed.knownLocked(ctx) || seed.checkLocked(ctx) == nil || seed.reestablishPersistenceLocked(ctx) == nil || seed.resumeIntentLocked(ctx) == nil || o.finishSelectedSeedCapture(ctx) == nil {
+		t.Fatal("forged seed reached native state")
