+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown || !o.completed {
+		return runtimeUpgradeManagementState{}, ErrUpgrade
+	}
+	unlock := o.lockBorrowed()
+	defer unlock()
+	defer func() {
+		if recover() != nil {
+			o.fenceLocked()
+			panic(ErrUpgrade)
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if o.recheckLocked(ctx, nil) != nil {
+		return runtimeUpgradeManagementState{}, ErrUpgrade
+	}
+	return o.state.clone(), nil
+}
+
+func (o *nativeRuntimeUpgradeManagementObservation) Close() error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		return ErrUpgrade
+	}
+	if o.closed {
+		return o.closeErr
+	}
+	if !runtimeUpgradeManagementPointers(o.listener, o.credentials) || o.args != o.listener.args || o.storage != o.args.storage {
+		return ErrUpgrade
+	}
