+				return h, ErrUpgrade
+			}
+		}
+	}
+	return h, nil
+}
+
+func (s *nativeFreshSeedCapture) checkNoIntentEffectsLocked(ctx context.Context) error {
+	if !s.knownLocked(ctx) || s.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o, n := s.owner, s.owner.storage
+	if n.freshRecovery != nil || n.predecessor != nil || n.stage != nil || n.target != nil || n.prepared || o.created != nil || o.captureComplete || o.publication != nil || o.legacyDenial != nil {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	seedName, _ := s.name.name()
+	allowed := map[string]bool{seedName: true, runtimeFreshFenceName: true}
+	for ordinal := uint32(0); ordinal < runtimeFreshIntentRepairSlots; ordinal++ {
+		r, _ := runtimeFreshIntentRepairName(ordinal)
+		a, _ := runtimeFreshIntentArchiveName(ordinal)
+		allowed[r], allowed[a] = true, true
+	}
+	for _, name := range names {
+		if strings.HasPrefix(strings.ToLower(name), "authority.") && !allowed[name] {
+			return ErrUpgrade
+		}
+	}
+	for _, v := range []struct {
+		parent    *runtimeStorageObject
+		name      string
+		directory bool
+	}{{n.parent, "home", true}, {parent, anchorName, true}, {parent, upgradeFenceName, false}} {
+		object, e := n.openFreshExistingTracked(ctx, v.parent.resource.handle, v.name, v.directory, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil {
+			return ErrUpgrade
+		}
+	}
+	return o.requireNoOwnedRegistration(ctx)
+}
+
+func (s *nativeFreshSeedCapture) resumeIntentLocked(ctx context.Context) (failure error) {
+	if !s.knownLocked(ctx) || s.checkNoIntentEffectsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o, n := s.owner, s.owner.storage
+	wanted, e := encodeRuntimeFreshIntent(o.intent)
+	if e != nil {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	// Recheck pre-controller canonical observation without introducing an
+	// immutable lease that would self-block the original DELETE handle.
+	probe, pe := n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshFenceName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
