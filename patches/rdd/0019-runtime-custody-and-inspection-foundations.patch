+func TestRuntimeUpgradeManagementHTTPRefusalsAndBudgets(t *testing.T) {
+	for name, response := range map[string]string{
+		"http10":             strings.Replace(runtimeManagementResponse("{}"), "HTTP/1.1", "HTTP/1.0", 1),
+		"redirect":           "HTTP/1.1 302 Found\r\nLocation: https://foreign.invalid/\r\nContent-Length: 0\r\n\r\n",
+		"unauthorized":       strings.Replace(runtimeManagementResponse("{}"), "200 OK", "401 Unauthorized", 1),
+		"forbidden":          strings.Replace(runtimeManagementResponse("{}"), "200 OK", "403 Forbidden", 1),
+		"closing":            strings.Replace(runtimeManagementResponse("{}"), "Content-Type:", "Connection: close\r\nContent-Type:", 1),
+		"unframed":           "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{}",
+		"type":               strings.Replace(runtimeManagementResponse("{}"), "application/json", "text/html", 1),
+		"gzip":               strings.Replace(runtimeManagementResponse("{}"), "Content-Type:", "Content-Encoding: gzip\r\nContent-Type:", 1),
+		"duplicate-encoding": strings.Replace(runtimeManagementResponse("{}"), "Content-Type:", "Content-Encoding: identity\r\nContent-Encoding: gzip\r\nContent-Type:", 1),
+		"duplicate-type":     strings.Replace(runtimeManagementResponse("{}"), "Content-Type: application/json\r\n", "Content-Type: application/json\r\nContent-Type: text/html\r\n", 1),
+		"truncated":          "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 20\r\n\r\n{}",
+		"chunk-error":        "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n3\r\n{}\r\n",
+		"extra":              runtimeManagementResponse("{}") + "unrequested bytes",
+		"body-budget":        runtimeManagementResponse(strings.Repeat("x", runtimeUpgradeManagementBodyBudget+1)),
+		"wire-budget":        "HTTP/1.1 200 OK\r\nX-Large: " + strings.Repeat("x", runtimeUpgradeManagementWireBudget) + "\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}",
+	} {
+		t.Run(name, func(t *testing.T) {
+			connection := &runtimeManagementMemoryConnection{input: strings.NewReader(response)}
+			if body, err := runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath); err == nil || body != nil || connection.writes != 1 || connection.closed || connection.readBytes > runtimeUpgradeManagementWireBudget {
+				t.Fatal("invalid/unbounded response accepted or exchange retried/closed raw")
+			}
+		})
+	}
+	for _, fault := range []string{"short-write", "write-error"} {
+		connection := &runtimeManagementMemoryConnection{input: strings.NewReader(runtimeManagementResponse("{}")), short: fault == "short-write"}
+		if fault == "write-error" {
+			connection.writeError = errors.New("synthetic write failure")
+		}
+		if _, err := runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath); err == nil || connection.writes != 1 || connection.readBytes != 0 {
+			t.Fatal("uncertain request was retried or received", fault)
+		}
+	}
+	for _, endpoint := range []string{"http://127.0.0.1:6443", "https://localhost:6443", "https://127.0.0.1:06443", "https://127.0.0.1:0", "https://user@127.0.0.1:6443", "https://127.0.0.1:6443/", "https://127.0.0.1:6443?"} {
+		connection := &runtimeManagementMemoryConnection{input: strings.NewReader("")}
+		if _, err := runtimeUpgradeManagementExchange(connection, endpoint, []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath); err == nil || connection.writes != 0 {
+			t.Fatal("unsupported endpoint sent credentials")
+		}
+	}
+	for _, path := range []string{"/readyz", "/apis/app.rancherdesktop.io/v1alpha1/apps/app?watch=true", runtimeUpgradeManagementVMPrefix + "../foreign" + runtimeUpgradeManagementVMSuffix} {
+		connection := &runtimeManagementMemoryConnection{input: strings.NewReader("")}
+		if _, err := runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), path); err == nil || connection.writes != 0 {
+			t.Fatal("nonfixed route sent credentials")
+		}
+	}
+}
