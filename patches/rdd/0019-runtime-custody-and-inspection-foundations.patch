+type freshAppStageShape uint8
+
+const (
+	freshAppStageInvalid freshAppStageShape = iota
+	freshAppStageComplete
+	freshAppStageNeedsNewline
+	freshAppStagePartial
+)
+
+func classifyFreshAppStage(body []byte) (runtimeFreshAppRecord, []byte, freshAppStageShape) {
+	var record runtimeFreshAppRecord
+	if len(body) > runtimeFreshRecordBudget {
+		return record, nil, freshAppStageInvalid
+	}
+	if parseRuntimeFreshRecord(body, &record) == nil && record.valid() {
+		return record, body, freshAppStageComplete
+	}
+	withNewline := append(append([]byte(nil), body...), '\n')
+	if parseRuntimeFreshRecord(withNewline, &record) == nil && record.valid() {
+		return record, withNewline, freshAppStageNeedsNewline
+	}
+	var value any
+	e := json.Unmarshal(body, &value)
+	if len(body) == 0 || e != nil && e.Error() == "unexpected end of JSON input" {
+		return runtimeFreshAppRecord{}, nil, freshAppStagePartial
+	}
+	return runtimeFreshAppRecord{}, nil, freshAppStageInvalid
+}
+
+// Refusal DATA only. Current actual native generation is separately held;
+// historical producer generation may differ, but its mapped source may not.
+func freshAppBindingMatches(current, record runtimeFreshAppRecord) bool {
+	if !record.valid() || current.Producer.Image != record.Producer.Image {
+		return false
+	}
+	current.Nonce = record.Nonce
+	current.Template = record.Template
+	current.Producer = record.Producer
+	a, e := runtimeFreshRecordBytes(current)
+	b, f := runtimeFreshRecordBytes(record)
+	return e == nil && f == nil && bytes.Equal(a, b)
+}
