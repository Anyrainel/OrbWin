@@ -0,0 +1,7 @@
+//go:build !windows
+
+package managementconfig
+
+// Product native lifetime wiring is Windows-only. Other platforms retain
+// their original controller lifecycle and never receive this capability.
+func (a *ManagedRuntimeAuthority) NoteControllerStart() error { return ErrUpgrade }
diff --git a/rdd/pkg/managementconfig/runtime_managed_authority_windows.go b/rdd/pkg/managementconfig/runtime_managed_authority_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..75764338bfc6f4f33d87d122d7360fb4887459c7
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_authority_windows.go
@@ -0,0 +1,522 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+
+	"golang.org/x/sys/windows"
+)
+
+type nativeManagedRuntimeAuthority struct {
+	modernIncomingImage *ModernIncomingImage    // same-build borrowed code; no launch/transfer authority
+	modernSelfLease     *ModernSelfProcessLease // dormant original self-process derivative; not a retirement/upgrade permit
+	self                *ManagedRuntimeAuthority
+	mu                  sync.Mutex
+	image               *ServingImageLease
+	created             *Created
+	publisher           *ConfigPublisher
+	main                upgradeObservedImageBinding
+	originals           []*os.Process
+	births              []*ManagedHostagentBirth
+	launches            []*ManagedHostagentLaunch
+	capturing           int
+	controllersStarted  bool
+	unknown             bool
+	closeAttempt        runtimeStorageCloseAttempt
+}
+
+func (a *nativeManagedRuntimeAuthority) fence() {
+	a.unknown = true
+	if a.image != nil {
+		a.image.managedUnknown.Store(true)
+	}
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.Unlock()
+}
+
+// Called by the original service after actual config publication and before
+// SAME manager registration/Start. Locks: publisher -> Created -> image.
+func (l *ServingImageLease) ManagedHostagentAuthority(ctx context.Context, c *Created, p *ConfigPublisher) (out *ManagedRuntimeAuthority, result error) {
+	if l == nil || l.captureSelf != l || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	backend, ok := p.backend.(*nativeAuthority)
+	if !ok || backend.created != c || p.closed || p.closeErr != nil || p.pending != nil || !p.serving.valid() || c.closed || c.closeErr != nil || !c.servingLease || c.anchor == 0 || len(c.authorityHandles) == 0 {
+		return nil, ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if !l.captureComplete || l.forwarder || l.closed || l.err != nil || l.unknown || l.managedUnknown.Load() || !runtimeStorageDomainKnown() || len(l.chain) < 3 {
+		return nil, ErrUpgrade
+	}
+	if c.managedAuthority != nil {
+		a, ok := c.managedAuthority.native.(*nativeManagedRuntimeAuthority)
+		if !ok || a.self != c.managedAuthority || a.image != l || a.created != c || a.publisher != p {
+			return nil, ErrUpgrade
+		}
+		a.mu.Lock()
+		bad := a.unknown || a.closeAttempt.attempted || !a.main.captured
+		a.mu.Unlock()
+		if bad {
+			return c.managedAuthority, ErrUpgrade
+		}
+		return c.managedAuthority, nil
+	}
+	cap := &ManagedRuntimeAuthority{}
+	a := &nativeManagedRuntimeAuthority{self: cap, image: l, created: c, publisher: p}
+	cap.native = a
+	c.managedAuthority = cap
+	l.managedAuthorities = append(l.managedAuthorities, cap)
+	out = cap // original parents strongly own partial capture before native query
+	defer func() {
+		if recover() != nil {
+			a.fence()
+			result = ErrUpgrade
+		}
+	}()
+	var session uint32
+	if a.main.capture(windows.CurrentProcess(), l.chain[len(l.chain)-1]) != nil || p.serving.PID != windows.GetCurrentProcessId() || p.serving.Creation != a.main.creation || windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &session) != nil || session == 0 || session != p.serving.Session {
+		a.fence()
+		return cap, ErrUpgrade
+	}
+	if ctx.Err() != nil {
+		// Only successful readonly borrowed-handle queries occurred; this new
+		// owner has no native slots or started actors to retain as unknown.
+		a.closeAttempt.attempted = true
+		return cap, ErrUpgrade
+	}
+	return cap, nil
+}
+
+// Refusal-only comparison of upstream's cached environment against actual
+// selected image home and SAME native authority anchor, before controllers.
+func (a *ManagedRuntimeAuthority) VerifyControllerDirectories(ctx context.Context, home, lima, authority string) error {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !strings.EqualFold(home, n.image.home) || !strings.EqualFold(lima, filepath.Join(n.image.home, ".rdorbwin", "lima")) {
+		return ErrUpgrade
+	}
+	var text [1024]uint16
+	size, e := windows.GetFinalPathNameByHandle(n.created.anchor, &text[0], uint32(len(text)), 0)
+	if e != nil || size == 0 || size >= uint32(len(text)) {
+		n.fence()
+		return ErrUpgrade
+	}
+	if !strings.EqualFold(strings.TrimPrefix(windows.UTF16ToString(text[:size]), `\\?\`), authority) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (a *ManagedRuntimeAuthority) exact() (*nativeManagedRuntimeAuthority, error) {
+	if a == nil {
+		return nil, ErrUpgrade
+	}
+	n, ok := a.native.(*nativeManagedRuntimeAuthority)
+	if !ok || n == nil || n.self != a || n.created == nil || n.publisher == nil || n.image == nil {
+		return nil, ErrUpgrade
+	}
+	return n, nil
+}
+
+// Caller holds original publisher/Created/authority locks. This is a fixed
+// native ownership guard, never an inherited environment/ready Boolean grant.
+func (a *nativeManagedRuntimeAuthority) admitted() bool {
+	c, p := a.created, a.publisher
+	backend, ok := p.backend.(*nativeAuthority)
+	return ok && backend.created == c && c.managedAuthority == a.self && !c.closed && c.closeErr == nil && c.servingLease && c.anchor != 0 && len(c.authorityHandles) != 0 && !p.closed && p.closeErr == nil && p.pending == nil && !a.unknown && !a.closeAttempt.attempted && !a.image.managedUnknown.Load() && runtimeStorageDomainKnown()
+}
+
+func (a *ManagedRuntimeAuthority) RequireHostagentLaunch(ctx context.Context) error {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() {
+		return ErrUpgrade
+	}
+	if !n.launchAvailableLocked() {
+		return ErrUpgrade
+	}
+	if n.main.same() != nil {
+		n.fence()
+		return ErrUpgrade
+	}
+	if n.created.managedNamespace != nil {
+		ns, e := n.created.managedNamespace.exact()
+		if e != nil || ns.authority != n {
+			return ErrUpgrade
+		}
+		ns.mu.Lock()
+		defer ns.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		if ns.peer != nil && !ns.retired {
+			return ErrUpgrade
+		}
+		if ns.recheckRegistered(ctx) != nil {
+			ns.fence()
+			return ErrUpgrade
+		}
+		if ns.retired {
+			if ns.peer == nil || !ns.peer.closedForParent(n.image) || ns.exclusive == nil || ns.closeFile(ns.exclusive.resource) != nil {
+				ns.fence()
+				return ErrUpgrade
+			}
+			ns.exclusive, ns.peer, ns.retired = nil, nil, false
+		}
+	} else if n.created.freshAuthority == nil {
+		return ErrUpgrade
+	}
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Original records only. Neither a PID file, watcher phase nor a caller's
+// readiness value may admit a second launch across an unresolved birth.
+func (a *nativeManagedRuntimeAuthority) launchAvailableLocked() bool {
+	if a.capturing != 0 || len(a.originals) != len(a.births) {
+		return false
+	}
+	for _, b := range a.births {
+		if !b.closedForParent(a.image) {
+			return false
+		}
+	}
+	for _, l := range a.launches {
+		if l.blocksNextLaunch(a) {
+			return false
+		}
+	}
+	return true
+}
+
+// The fixed controller calls this immediately after its actual Start and
+// BEFORE launching the sole Wait goroutine. No PID/native-fact setter exists.
+func (a *ManagedRuntimeAuthority) CaptureHostagent(ctx context.Context, original *os.Process) (out *ManagedHostagentBirth, result error) {
+	n, e := a.exact()
+	if e != nil || original == nil {
+		return nil, ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	if len(n.originals) == len(n.births) {
+		originals, births := n.originals[:0], n.births[:0]
+		for i, b := range n.births {
+			if !b.closedForParent(n.image) {
+				originals = append(originals, n.originals[i])
+				births = append(births, b)
+			}
+		}
+		n.originals, n.births = originals, births
+	}
+	n.originals = append(n.originals, original)
+	if !n.admitted() || !freshBoundedContext(ctx) {
+		n.fence()
+		n.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	n.capturing++
+	n.mu.Unlock()
+	defer func() {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		n.capturing--
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if out != nil {
+			n.births = append(n.births, out)
+			for _, launch := range n.launches {
+				launch.mu.Lock()
+				if launch.cmd != nil && launch.cmd.Process == original {
+					launch.birth = out
+					launch.boundOriginal = original
+				}
+				launch.mu.Unlock()
+			}
+		}
+		if result != nil {
+			n.fence()
+		}
+	}()
+	return n.image.CaptureManagedHostagent(ctx, original)
+}
+
+func (a *ManagedRuntimeAuthority) closedForImage(image *ServingImageLease) bool {
+	n, e := a.exact()
+	if e != nil || n.image != image {
+		return false
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.unknown || n.capturing != 0 || !n.closeAttempt.attempted || n.closeAttempt.closeErr != nil || n.modernIncomingImage != nil && !n.modernIncomingImage.closedForAuthority(n) {
+		return false
+	}
+	for _, b := range n.births {
+		if !b.closedForParent(image) {
+			return false
+		}
+	}
+	return true
+}
+func (a *ManagedRuntimeAuthority) closedForCreated(c *Created) bool {
+	n, e := a.exact()
+	if e != nil || n.created != c {
+		return false
+	}
+	return a.closedForImage(n.image)
+}
+
+// This records only an irreversible loss of the never-started cleanup path.
+// It certifies no readiness, guest ownership, or successful retirement.
+func (a *ManagedRuntimeAuthority) NoteControllerStart() error {
+	n, e := a.exact()
+	if e != nil {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.unknown || n.closeAttempt.attempted || n.controllersStarted {
+		return ErrUpgrade
+	}
+	n.controllersStarted = true
+	if n.created.managedNamespace != nil {
+		ns, e := n.created.managedNamespace.exact()
+		if e != nil {
+			n.fence()
+			return ErrUpgrade
+		}
+		ns.mu.Lock()
+		ns.authority, ns.activated = n, true
+		ns.mu.Unlock()
+	}
+	return nil
+}
+
+func (a *nativeManagedRuntimeAuthority) ownsBirth(b *ManagedHostagentBirth) bool {
+	if b == nil || b.self != b || b.parent != a.image {
+		return false
+	}
+	for _, owned := range a.births {
+		if owned == b {
+			return true
+		}
+	}
+	return false
+}
+
+// Called before the original instance-scoped graceful signal. It authenticates
+// the fixed native pipe peer against the retained actual launch generation.
+func (a *ManagedRuntimeAuthority) PrepareHostagentStop(ctx context.Context, b *ManagedHostagentBirth) (result error) {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !n.controllersStarted || !n.ownsBirth(b) || n.created.managedNamespace == nil {
+		return ErrUpgrade
+	}
+	ns, e := n.created.managedNamespace.exact()
+	if e != nil || ns.authority != n {
+		return ErrUpgrade
+	}
+	ns.mu.Lock()
+	defer ns.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			ns.fence()
+			result = ErrUpgrade
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if ns.bindLivePeer(ctx, b) != nil {
+		ns.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Wait result is from the sole original watcher; it is insufficient alone.
+// Native original-generation exit0 and the same owned disk offline proof are
+// both required before releasing any lifetime capability.
+func (a *ManagedRuntimeAuthority) RetireHostagent(ctx context.Context, b *ManagedHostagentBirth) (result error) {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) || b == nil || b.awaitOriginalWait(ctx) != nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !n.controllersStarted || !n.ownsBirth(b) || n.created.managedNamespace == nil {
+		return ErrUpgrade
+	}
+	ns, e := n.created.managedNamespace.exact()
+	if e != nil || ns.authority != n {
+		return ErrUpgrade
+	}
+	ns.mu.Lock()
+	defer ns.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			ns.fence()
+			result = ErrUpgrade
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if ns.proveOffline(ctx, b) != nil {
+		ns.fence()
+		return ErrUpgrade
+	}
+	return b.Close()
+}
+
+// The signal capability is the original unnamed parent-created event retained
+// by the actual capsule. A PID/event name/SD match cannot select this object.
+func (a *ManagedRuntimeAuthority) SignalHostagentStop(ctx context.Context, b *ManagedHostagentBirth) error {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !n.ownsBirth(b) || n.created.managedNamespace == nil {
+		return ErrUpgrade
+	}
+	ns, e := n.created.managedNamespace.exact()
+	if e != nil {
+		return ErrUpgrade
+	}
+	ns.mu.Lock()
+	ready := ns.authority == n && ns.peer == b && !ns.unknown && !ns.retired
+	ns.mu.Unlock()
+	if !ready {
+		return ErrUpgrade
+	}
+	for _, l := range n.launches {
+		l.mu.Lock()
+		if l.birth != b {
+			l.mu.Unlock()
+			continue
+		}
+		if l.self != l || l.unknown || !l.complete || !l.started || l.closeAttempt.attempted || l.interrupt == nil || l.interrupt.attempted || l.interrupt.handle == 0 {
+			l.mu.Unlock()
+			return ErrUpgrade
+		}
+		e = windows.SetEvent(l.interrupt.handle)
+		if e != nil {
+			l.fence()
+		}
+		l.mu.Unlock()
+		if e != nil || ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		return nil
+	}
+	return ErrUpgrade
+}
+
+func (a *ManagedRuntimeAuthority) Close() error {
+	n, e := a.exact()
+	if e != nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.unknown || n.publisher.closeErr != nil || n.publisher.pending != nil || n.created.closeErr != nil {
+		return ErrUpgrade
+	}
+	if n.modernIncomingImage != nil && !n.modernIncomingImage.closedForAuthority(n) {
+		return ErrUpgrade
+	}
+	if n.modernSelfLease != nil && !n.modernSelfLease.closedForAuthority(n) {
+		return ErrUpgrade
+	}
+	if n.closeAttempt.attempted {
+		return n.closeAttempt.closeErr
+	}
+	if n.image.managedUnknown.Load() || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	for _, launch := range n.launches {
+		if !launch.readyForAuthorityClose(n) {
+			return ErrUpgrade
+		}
+	}
+	if n.capturing != 0 || len(n.originals) != len(n.births) {
+		return ErrUpgrade
+	}
+	for _, b := range n.births {
+		if !b.closedForParent(n.image) {
+			return ErrUpgrade
+		}
+	}
+	return n.closeAttempt.run(func() error {
+		for i := len(n.launches) - 1; i >= 0; i-- {
+			if n.launches[i].closeForAuthorityHeld(n) != nil {
+				return ErrUpgrade
+			}
+		}
+		if n.created.managedNamespace == nil {
+			if n.controllersStarted {
+				return ErrUpgrade
+			}
+			return nil
+		}
+		ns, e := n.created.managedNamespace.exact()
+		if e != nil {
+			return ErrUpgrade
+		}
+		ns.mu.Lock()
+		defer ns.mu.Unlock()
+		return ns.close()
+	}, n.fence)
+}
diff --git a/rdd/pkg/managementconfig/runtime_managed_inherited_windows.go b/rdd/pkg/managementconfig/runtime_managed_inherited_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..d37f6cd7a2ccdc6d269e69eba1950ea2e801bd9b
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_inherited_windows.go
@@ -0,0 +1,246 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// These are deliberately raw process-lifetime HANDLE slots, with no finalizer
+// and no exported Close. Process exit closes them AFTER all hostagent deferred
+// cleanup. In particular returning from ha.Run must not release owner.lock.
+var managedInheritedLifetime struct {
+	sync.Mutex
+	claimed, complete, unknown             bool
+	resources                              []*runtimeStorageResource
+	anchor, lock, parent, image, interrupt *runtimeStorageResource
+	waitClaimed                            bool
+	data                                   managedLifetimeData
+}
+
+func inheritedManagedSlot() *runtimeStorageResource {
+	r := &runtimeStorageResource{}
+	managedInheritedLifetime.resources = append(managedInheritedLifetime.resources, r)
+	return r
+}
+func inheritedManagedReply(r *runtimeStorageResource, e error) error {
+	return runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, func() { managedInheritedLifetime.unknown = true })
+}
+
+// This fixed main-entry consumer runs BEFORE ordinary CLI/environment work.
+// Parent PID is only the child's own class0 locator; the held kernel generation,
+// image/token and original source caps must all match before guest effects.
+func ConsumeManagedHostagentLifetime(ctx context.Context, value string) (result error) {
+	if !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	d, e := decodeManagedLifetimeData(value)
+	if e != nil {
+		return ErrUpgrade
+	}
+	s := &managedInheritedLifetime
+	s.Lock()
+	defer s.Unlock()
+	if s.claimed {
+		return ErrUpgrade
+	}
+	s.claimed = true
+	s.data = d
+	s.anchor = inheritedManagedSlot()
+	s.anchor.handle = windows.Handle(d.Anchor)
+	s.lock = inheritedManagedSlot()
+	s.lock.handle = windows.Handle(d.Lock)
+	s.interrupt = inheritedManagedSlot()
+	s.interrupt.handle = windows.Handle(d.Interrupt)
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			s.unknown = true
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	// Clear BOTH child inherit flags before any possible CLI/HA descendants.
+	for _, r := range []*runtimeStorageResource{s.anchor, s.lock, s.interrupt} {
+		var flags uint32
+		ok, _, _ := anchorGetHandleInformation.Call(uintptr(r.handle), uintptr(unsafe.Pointer(&flags)))
+		if ok == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 || windows.SetHandleInformation(r.handle, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+			return ErrUpgrade
+		}
+		ok, _, _ = anchorGetHandleInformation.Call(uintptr(r.handle), uintptr(unsafe.Pointer(&flags)))
+		if ok == 0 || flags&windows.HANDLE_FLAG_INHERIT != 0 {
+			return ErrUpgrade
+		}
+	}
+	if upgradeSDKCohortHandleRights(s.anchor.handle, managedAnchorRights, managedAnchorRights) != nil || upgradeSDKCohortHandleRights(s.lock.handle, managedLockRights, managedLockRights) != nil || upgradeSDKCohortHandleRights(s.interrupt.handle, managedInterruptRights, managedInterruptRights) != nil {
+		return ErrUpgrade
+	}
+	thread := inheritedManagedSlot()
+	e = windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, (*windows.Token)(unsafe.Pointer(&thread.handle)))
+	if inheritedManagedReply(thread, e) != windows.ERROR_NO_TOKEN {
+		return ErrUpgrade
+	}
+	s.resources = s.resources[:len(s.resources)-1]
+	selfToken := inheritedManagedSlot()
+	e = windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&selfToken.handle)))
+	if inheritedManagedReply(selfToken, e) != nil {
+		return ErrUpgrade
+	}
+	userToken, e := windows.Token(selfToken.handle).GetTokenUser()
+	if e != nil || userToken.User.Sid == nil || !userToken.User.Sid.IsValid() {
+		return ErrUpgrade
+	}
+	sid := userToken.User.Sid.String()
+	if legacySDKOrdinaryToken(windows.Token(selfToken.handle), sid, d.Session) != nil {
+		return ErrUpgrade
+	}
+	anchorID, e := runtimeStorageIdentityOf(s.anchor.handle, sid, true, true, false)
+	if e != nil || (AnchorIdentity{anchorID.volume, anchorID.high, anchorID.low}) != d.AnchorID {
+		return ErrUpgrade
+	}
+	lockID, e := runtimeStorageIdentityOf(s.lock.handle, sid, false, true, false)
+	if e != nil || lockID.size != 0 || (AnchorIdentity{lockID.volume, lockID.high, lockID.low}) != d.LockID {
+		return ErrUpgrade
+	}
+	anchorPath, e := managedInheritedPath(s.anchor.handle)
+	if e != nil {
+		return ErrUpgrade
+	}
+	lockPath, e := managedInheritedPath(s.lock.handle)
+	if e != nil || !strings.EqualFold(lockPath, anchorPath+`\authority.owner.lock`) {
+		return ErrUpgrade
+	}
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(windows.CurrentProcess(), 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || basic.InheritedFromUniqueProcessId != uintptr(d.Parent) || d.Parent == windows.GetCurrentProcessId() {
+		return ErrUpgrade
+	}
+	s.parent = inheritedManagedSlot()
+	s.parent.handle, e = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.PROCESS_DUP_HANDLE|windows.SYNCHRONIZE, false, d.Parent)
+	if inheritedManagedReply(s.parent, e) != nil {
+		return ErrUpgrade
+	}
+	var created, exit, kernel, user windows.Filetime
+	var session uint32
+	pid, e := windows.GetProcessId(s.parent.handle)
+	if e != nil || pid != d.Parent || windows.GetProcessTimes(s.parent.handle, &created, &exit, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != d.Creation || windows.ProcessIdToSessionId(pid, &session) != nil || session != d.Session {
+		return ErrUpgrade
+	}
+	for _, process := range []windows.Handle{s.parent.handle} {
+		token := inheritedManagedSlot()
+		e = windows.OpenProcessToken(process, windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&token.handle)))
+		if inheritedManagedReply(token, e) != nil || legacySDKOrdinaryToken(windows.Token(token.handle), sid, d.Session) != nil {
+			return ErrUpgrade
+		}
+	}
+	path, e := os.Executable()
+	if e != nil {
+		return ErrUpgrade
+	}
+	text, e := windows.UTF16PtrFromString(path)
+	if e != nil {
+		return ErrUpgrade
+	}
+	s.image = inheritedManagedSlot()
+	s.image.handle, e = windows.CreateFile(text, windows.GENERIC_READ|windows.READ_CONTROL, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if inheritedManagedReply(s.image, e) != nil {
+		return ErrUpgrade
+	}
+	var self, parent upgradeObservedImageBinding
+	var selfSession uint32
+	if windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &selfSession) != nil || selfSession != d.Session || self.capture(windows.CurrentProcess(), s.image.handle) != nil || parent.capture(s.parent.handle, s.image.handle) != nil || parent.creation != d.Creation || self.creation < parent.creation {
+		return ErrUpgrade
+	}
+	for _, pair := range []struct {
+		source    windows.Handle
+		identity  runtimeStorageIdentity
+		directory bool
+	}{{windows.Handle(d.Anchor), anchorID, true}, {windows.Handle(d.Lock), lockID, false}} {
+		r := inheritedManagedSlot()
+		e = windows.DuplicateHandle(s.parent.handle, pair.source, windows.CurrentProcess(), &r.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+		if inheritedManagedReply(r, e) != nil {
+			return ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(r.handle, sid, pair.directory, true, false)
+		if e != nil || id != pair.identity || sameUpgradeSDKKernelObject(r.handle, pair.source) != nil {
+			return ErrUpgrade
+		}
+	}
+	duplicateEvent := inheritedManagedSlot()
+	e = windows.DuplicateHandle(s.parent.handle, windows.Handle(d.Interrupt), windows.CurrentProcess(), &duplicateEvent.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	if inheritedManagedReply(duplicateEvent, e) != nil {
+		return ErrUpgrade
+	}
+	eventState, eventErr := windows.WaitForSingleObject(s.interrupt.handle, 0)
+	if sameUpgradeSDKKernelObject(s.interrupt.handle, duplicateEvent.handle) != nil || eventErr != nil || eventState != uint32(windows.WAIT_TIMEOUT) {
+		return ErrUpgrade
+	}
+	state, e := windows.WaitForSingleObject(s.parent.handle, 0)
+	if e != nil || state != uint32(windows.WAIT_TIMEOUT) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	s.complete = true
+	return nil
+}
+
+// The sole original hostagent waiter consumes only its actual prevalidated
+// unnamed inherited event. Cancellation stops this waiter, never the engine.
+func WaitManagedHostagentInterrupt(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	s := &managedInheritedLifetime
+	s.Lock()
+	if !s.complete || s.unknown || s.waitClaimed || s.interrupt == nil || s.interrupt.handle == 0 {
+		s.Unlock()
+		return ErrUpgrade
+	}
+	s.waitClaimed = true
+	event := s.interrupt.handle
+	s.Unlock()
+	for {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		state, e := windows.WaitForSingleObject(event, 100)
+		if e == nil && state == uint32(windows.WAIT_OBJECT_0) {
+			return nil
+		}
+		if e != nil || state != uint32(windows.WAIT_TIMEOUT) {
+			s.Lock()
+			s.unknown = true
+			s.Unlock()
+			return ErrUpgrade
+		}
+	}
+}
+
+func managedInheritedPath(h windows.Handle) (string, error) {
+	var text [1024]uint16
+	n, e := windows.GetFinalPathNameByHandle(h, &text[0], uint32(len(text)), 0)
+	if e != nil || n == 0 || n >= uint32(len(text)) {
+		return "", ErrUpgrade
+	}
+	return windows.UTF16ToString(text[:n]), nil
+}
+
+// Cached negative guard at the actual hostagent action. It cannot be set from
+// argv/JSON, an event, a PID file, or an API result.
+func RequireManagedHostagentLifetime() error {
+	s := &managedInheritedLifetime
+	s.Lock()
+	defer s.Unlock()
+	if !s.claimed || !s.complete || s.unknown || s.anchor == nil || s.lock == nil || s.interrupt == nil || s.anchor.handle == 0 || s.lock.handle == 0 || s.interrupt.handle == 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
