+func TestManagedNamespaceConfirmedNoOutputIsNotAClosingSlot(t *testing.T) {
+	n := &nativeManagedNamespace{}
+	priorSlot := n.slot()
+	priorSlot.handle = 41
+	r := n.slot()
+	if e := n.reply(r, windows.STATUS_OBJECT_NAME_NOT_FOUND); e != windows.STATUS_OBJECT_NAME_NOT_FOUND || n.unknown || len(n.resources) != 1 || n.resources[0] != priorSlot || priorSlot.attempted || r.attempted {
+		t.Fatal("confirmed absence fabricated a native closing obligation")
+	}
+	runtimeStorageDomain.Lock()
+	prior := runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	defer func() {
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = prior
+		runtimeStorageDomain.Unlock()
+	}()
+	r = n.slot()
+	r.handle = 42
+	if n.reply(r, windows.STATUS_OBJECT_NAME_NOT_FOUND) == nil || !n.unknown || len(n.resources) != 2 || n.resources[0] != priorSlot || n.resources[1] != r || priorSlot.attempted || r.attempted {
+		t.Fatal("error-with-valid-output escaped strong unknown retention")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_managed_retirement_windows.go b/rdd/pkg/managementconfig/runtime_managed_retirement_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..bef9aa6e7ec7e4c60408c8041cca0fc545db51b5
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_retirement_windows.go
@@ -0,0 +1,280 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// ManagedHostagentBirth owns an actual original Go child process handle and
+// independent native image/token captures. It grants no Stop/unregister and
+// does not certify guest retirement. Only the fixed original launch supplies
+// os.Process; no PID, callback, hash or decoded native facts are accepted.
+type ManagedHostagentBirth struct {
+	self                             *ManagedHostagentBirth
+	mu                               sync.Mutex
+	parent                           *ServingImageLease
+	original                         *os.Process
+	resources                        []*runtimeStorageResource
+	process, image, token, selfToken *runtimeStorageResource
+	binding                          upgradeObservedImageBinding
+	pid, session                     uint32
+	creation                         uint64
+	sid                              string
+	complete, unknown                bool
+	closeAttempt                     runtimeStorageCloseAttempt
+	waitRecorded, waitFailed         bool
+	waitDone                         chan struct{}
+}
+
+func (b *ManagedHostagentBirth) fence() {
+	b.unknown = true
+	if b.parent != nil {
+		b.parent.managedUnknown.Store(true)
+	}
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.Unlock()
+}
+
+func (*ManagedHostagentBirth) String() string   { return "original managed hostagent process" }
+func (*ManagedHostagentBirth) GoString() string { return "original managed hostagent process" }
+
+func (b *ManagedHostagentBirth) slot() *runtimeStorageResource {
+	r := &runtimeStorageResource{}
+	b.resources = append(b.resources, r)
+	return r
+}
+
+func (b *ManagedHostagentBirth) reply(r *runtimeStorageResource, e error) error {
+	return runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, b.fence)
+}
+
+// The fixed callback only duplicates the ORIGINAL native handle. WithHandle's
+// error is separate from the callback/native outcome. It protects its borrowed
+// handle for the callback duration; we never store or close that borrowed value.
+func (l *ServingImageLease) CaptureManagedHostagent(ctx context.Context, original *os.Process) (out *ManagedHostagentBirth, result error) {
+	if l == nil || l.captureSelf != l || original == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if !l.captureComplete || l.forwarder || l.closed || l.unknown || l.err != nil || l.managedUnknown.Load() || !runtimeStorageDomainKnown() || !l.image.Present || len(l.chain) < 3 {
+		return nil, ErrUpgrade
+	}
+	retained := l.managedBirths[:0]
+	for _, birth := range l.managedBirths {
+		if !birth.closedForParent(l) {
+			retained = append(retained, birth)
+		}
+	}
+	l.managedBirths = retained
+	if len(retained) >= 32 {
+		return nil, ErrUpgrade
+	}
+	b := &ManagedHostagentBirth{parent: l, original: original, waitDone: make(chan struct{})}
+	b.self = b
+	l.managedBirths = append(l.managedBirths, b) // strong custody BEFORE native output
+	out = b
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			b.fence()
+		}
+		runtime.KeepAlive(original)
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	thread := b.slot()
+	e := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, (*windows.Token)(unsafe.Pointer(&thread.handle)))
+	if b.reply(thread, e) != windows.ERROR_NO_TOKEN {
+		return b, ErrUpgrade
+	}
+	b.resources = b.resources[:len(b.resources)-1] // confirmed no output only
+	b.process = b.slot()
+	var duplicateErr error
+	withErr := original.WithHandle(func(h uintptr) {
+		duplicateErr = windows.DuplicateHandle(windows.CurrentProcess(), windows.Handle(h), windows.CurrentProcess(), &b.process.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	})
+	if withErr != nil || b.reply(b.process, duplicateErr) != nil {
+		return b, ErrUpgrade
+	}
+	b.image = b.slot()
+	e = windows.DuplicateHandle(windows.CurrentProcess(), l.chain[len(l.chain)-1], windows.CurrentProcess(), &b.image.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	if b.reply(b.image, e) != nil {
+		return b, ErrUpgrade
+	}
+	b.token = b.slot()
+	e = windows.OpenProcessToken(b.process.handle, windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&b.token.handle)))
+	if b.reply(b.token, e) != nil {
+		return b, ErrUpgrade
+	}
+	b.selfToken = b.slot()
+	e = windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&b.selfToken.handle)))
+	if b.reply(b.selfToken, e) != nil {
+		return b, ErrUpgrade
+	}
+	user, e := windows.Token(b.selfToken.handle).GetTokenUser()
+	if e != nil || user.User.Sid == nil || !user.User.Sid.IsValid() {
+		return b, ErrUpgrade
+	}
+	b.sid = user.User.Sid.String()
+	pid, e := windows.GetProcessId(b.process.handle)
+	var created, exit, kernel, userTime windows.Filetime
+	if e != nil || pid == 0 || pid == windows.GetCurrentProcessId() || windows.ProcessIdToSessionId(pid, &b.session) != nil || b.session == 0 || windows.GetProcessTimes(b.process.handle, &created, &exit, &kernel, &userTime) != nil {
+		return b, ErrUpgrade
+	}
+	b.pid = pid
+	b.creation = uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+	var parentCreated windows.Filetime
+	if windows.GetProcessTimes(windows.CurrentProcess(), &parentCreated, &exit, &kernel, &userTime) != nil || b.creation < uint64(parentCreated.HighDateTime)<<32|uint64(parentCreated.LowDateTime) {
+		return b, ErrUpgrade
+	}
+	var selfSession uint32
+	if b.creation == 0 || windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &selfSession) != nil || selfSession != b.session || legacySDKOrdinaryToken(windows.Token(b.token.handle), b.sid, b.session) != nil || legacySDKOrdinaryToken(windows.Token(b.selfToken.handle), b.sid, b.session) != nil {
+		return b, ErrUpgrade
+	}
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(b.process.handle, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || basic.UniqueProcessId != uintptr(pid) || basic.InheritedFromUniqueProcessId != uintptr(windows.GetCurrentProcessId()) || b.binding.capture(b.process.handle, b.image.handle) != nil || ctx.Err() != nil {
+		return b, ErrUpgrade
+	}
+	state, e := windows.WaitForSingleObject(b.process.handle, 0)
+	if e != nil || state != uint32(windows.WAIT_TIMEOUT) || ctx.Err() != nil {
+		return b, ErrUpgrade
+	}
+	b.complete = true
+	return b, nil
+}
+
+func (b *ManagedHostagentBirth) closedForParent(parent *ServingImageLease) bool {
+	if b == nil || b.self != b || b.parent != parent {
+		return false
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.unknown || !b.closeAttempt.attempted || b.closeAttempt.closeErr != nil {
+		return false
+	}
+	for _, r := range b.resources {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// Fixed native reply classification, not a native fact issuer. Known live is
+// a settleable refusal; failed or unexpected kernel replies retain the graph.
+func (b *ManagedHostagentBirth) waitReply(state uint32, e error) error {
+	if e != nil || state != uint32(windows.WAIT_OBJECT_0) && state != uint32(windows.WAIT_TIMEOUT) {
+		b.fence()
+		return ErrUpgrade
+	}
+	if state == uint32(windows.WAIT_TIMEOUT) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (b *ManagedHostagentBirth) queryReply(e error) error {
+	if e != nil {
+		b.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// This checks only the original child's actual native exit, never guest/driver
+// retirement. Caller additionally needs the actual sole Wait result and the
+// independently retained concrete owned namespace retirement evidence.
+func (b *ManagedHostagentBirth) CheckExited(ctx context.Context) (result error) {
+	if b == nil || b.self != b || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			b.fence()
+			result = ErrUpgrade
+		}
+	}()
+	if !b.complete || b.unknown || b.parent == nil || b.parent.managedUnknown.Load() || !runtimeStorageDomainKnown() || b.closeAttempt.attempted || b.process == nil || b.process.handle == 0 {
+		return ErrUpgrade
+	}
+	state, e := windows.WaitForSingleObject(b.process.handle, 0)
+	if b.waitReply(state, e) != nil {
+		return ErrUpgrade
+	}
+	var code uint32
+	if b.queryReply(windows.GetExitCodeProcess(b.process.handle, &code)) != nil {
+		return ErrUpgrade
+	}
+	if code != 0 {
+		return ErrUpgrade
+	}
+	if b.queryReply(b.binding.same()) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Checked close owns query/image/token duplicates only. It never kills the
+// child. A live original child refuses cleanup; uncertainty retains the suffix.
+func (b *ManagedHostagentBirth) Close() (result error) {
+	if b == nil {
+		return nil
+	}
+	if b.self != b {
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			b.fence()
+			result = ErrUpgrade
+		}
+	}()
+	if b.unknown {
+		return ErrUpgrade
+	}
+	if b.closeAttempt.attempted {
+		return b.closeAttempt.closeErr
+	}
+	if b.parent == nil || b.parent.managedUnknown.Load() || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	if b.process == nil || b.process.handle == 0 {
+		return ErrUpgrade
+	}
+	state, e := windows.WaitForSingleObject(b.process.handle, 0)
+	if b.waitReply(state, e) != nil {
+		return ErrUpgrade
+	}
+	return b.closeAttempt.run(func() error {
+		for i := len(b.resources) - 1; i >= 0; i-- {
+			r := b.resources[i]
+			if r.run(func() error {
+				if windows.CloseHandle(r.handle) != nil {
+					return ErrUpgrade
+				}
+				r.handle = 0
+				return nil
+			}, b.fence) != nil {
+				return ErrUpgrade
+			}
+		}
+		b.original = nil
+		return nil
+	}, b.fence)
+}
