+	f := n.win32Open
+	if f == nil || f.owner != n || f.resource == nil || f.resource.win32Open != f || f.resource.handle != h || !runtimeStorageRealWin32Output(uintptr(h)) || n.unknown || !runtimeStorageDomainKnown() || !f.state.attach() {
+		n.fence()
+		panic(ErrUpgrade)
+	}
+	n.resources = append(n.resources, f.resource)
+	n.win32Open = nil
+	return f.resource
+}
+func (n *nativeRuntimeStorage) win32ResourceKnown(r *runtimeStorageResource) bool {
+	f := r.win32Open
+	if f == nil {
+		return true
+	}
+	if f.owner != n || f.resource != r || !f.state.usable() || n.win32Open == f {
+		return false
+	}
+	count := 0
+	for _, actual := range n.resources {
+		if actual == r {
+			count++
+		}
+	}
+	return count == 1
+}
+func (n *nativeRuntimeStorage) win32OpenReply(f *runtimeStorageWin32Frame) (windows.Handle, error) {
+	if n == nil || f == nil || n.win32Open != f || f.owner != n || f.resource == nil || f.resource.win32Open != f || n.unknown || !runtimeStorageDomainKnown() {
+		if n != nil {
+			n.fence()
+		}
+		return 0, ErrUpgrade
+	}
+	code := uint32(0)
+	known := f.lastError == nil
+	if e, ok := f.lastError.(windows.Errno); ok {
+		code = uint32(e)
+		known = true
+	}
