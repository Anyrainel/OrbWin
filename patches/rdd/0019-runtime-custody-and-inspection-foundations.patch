+package managementconfig
+
+import (
+	"strings"
+	"testing"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+func freshObservationAPIFixture() (*app.App, *lima.LimaVM) {
+	a := freshRuntimeDesiredApp()
+	a.UID = types.UID("actual-app-uid")
+	a.ResourceVersion = "20"
+	a.Generation = 2
+	f := false
+	a.Status.SupportsNamespaces = &f
+	for _, kind := range []string{app.AppConditionRunning, app.AppConditionContainerEngineReady, app.AppConditionSettled} {
+		a.Status.Conditions = append(a.Status.Conditions, metav1.Condition{Type: kind, Status: metav1.ConditionTrue, ObservedGeneration: 2})
+	}
+	t := true
+	v := &lima.LimaVM{TypeMeta: metav1.TypeMeta{APIVersion: "lima.rancherdesktop.io/v1alpha1", Kind: "LimaVM"}, ObjectMeta: metav1.ObjectMeta{Name: "orbwin", Namespace: freshRuntimeNamespace, UID: types.UID("actual-vm-uid"), ResourceVersion: "30", Generation: 3, OwnerReferences: []metav1.OwnerReference{{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "App", Name: "app", UID: a.UID, Controller: &t}}}, Spec: lima.LimaVMSpec{Running: true}, Status: lima.LimaVMStatus{Conditions: []metav1.Condition{{Type: "Running", Status: metav1.ConditionTrue, Reason: "Started"}}, NetworkProxyLaunch: &lima.NetworkProxyLaunchObservation{AppUID: string(a.UID), LimaVMUID: "actual-vm-uid", HostPID: 123, HostCreationTime: "0000000000000123", Session: 1, TransportEpoch: strings.Repeat("a", 32)}}}
+	return a, v
+}
+
+func TestRuntimeFreshObservationRequiresActualCurrentAppVMRelation(t *testing.T) {
+	a, v := freshObservationAPIFixture()
+	valid, e := freshRuntimeAPI(a, v)
+	if e != nil || valid.HostPID != 123 {
+		t.Fatal("actual ready shape refused", e)
+	}
+	for name, mutate := range map[string]func(*app.App, *lima.LimaVM){
+		"stale engine":           func(a *app.App, _ *lima.LimaVM) { a.Status.Conditions[1].ObservedGeneration-- },
+		"management only":        func(a *app.App, _ *lima.LimaVM) { a.Status.Conditions = nil },
+		"foreign namespace":      func(a *app.App, _ *lima.LimaVM) { a.Spec.Namespace = "default" },
+		"foreign engine":         func(a *app.App, _ *lima.LimaVM) { a.Spec.ContainerEngine.Name = "containerd" },
+		"wrong VM owner":         func(_ *app.App, v *lima.LimaVM) { v.OwnerReferences[0].UID = "other" },
+		"missing native launch":  func(_ *app.App, v *lima.LimaVM) { v.Status.NetworkProxyLaunch = nil },
+		"stale VM":               func(_ *app.App, v *lima.LimaVM) { v.Status.Conditions[0].ObservedGeneration-- },
+		"proxy PATH mutation":    func(a *app.App, _ *lima.LimaVM) { a.Spec.Application.AddPath = "front" },
+		"optional K8s not ready": func(a *app.App, _ *lima.LimaVM) { a.Spec.Kubernetes.Enabled = true },
+	} {
+		t.Run(name, func(t *testing.T) {
+			a, v := freshObservationAPIFixture()
+			mutate(a, v)
+			if _, e := freshRuntimeAPI(a, v); e == nil {
+				t.Fatal("unobserved/foreign/stale shape accepted")
+			}
+		})
+	}
+	a, v = freshObservationAPIFixture()
+	a.Spec.Kubernetes.Enabled = true
+	a.Status.Conditions = append(a.Status.Conditions, metav1.Condition{Type: app.AppConditionKubernetesReady, Status: metav1.ConditionTrue, ObservedGeneration: a.Generation})
+	if _, e := freshRuntimeAPI(a, v); e != nil {
+		t.Fatal("actual ready optional Kubernetes refused")
+	}
+	newVersion := valid
+	newVersion.AppVersion = "21"
+	if !valid.sameIdentity(newVersion) {
+		t.Fatal("status-only version churn treated as new identity")
+	}
+	newVersion.AppGeneration++
+	if valid.sameIdentity(newVersion) {
+		t.Fatal("desired generation change ignored")
+	}
+}
+
+func TestRuntimeFreshObservationFixedReadRoutesAndNativeData(t *testing.T) {
+	for _, route := range []string{"/_ping", "/info", "/v1.56/info"} {
+		if !freshRuntimeDockerRead("GET", route) {
+			t.Fatal("fixed read refused")
+		}
+	}
+	for _, route := range []string{"/containers/create", "/v01.56/info", "/v1.56/info?other", "/v1.56/../info"} {
+		if freshRuntimeDockerRead("GET", route) || freshRuntimeDockerRead("POST", route) {
+			t.Fatal("nonread route accepted")
+		}
+	}
+	if !freshRuntimeRegistrationBase(`\\?\C:\User\OrbWinData\home\.rdorbwin\lima\orbwin`, `C:\User\OrbWinData\home`) || freshRuntimeRegistrationBase(`C:\foreign\orbwin`, `C:\User\OrbWinData\home`) {
+		t.Fatal("native fixed base relation")
+	}
+	for _, units := range [][]uint16{{'o', 0, 'x', 0}, {0xd800, 0}, {'o'}, {0xdc00, 0}} {
+		if _, e := freshRuntimeRegistryText(units); e == nil {
+			t.Fatal("malformed registry string accepted")
+		}
+	}
+	if _, e := freshRuntimeRegistryText([]uint16{'o', 'k', 0}); e != nil {
+		t.Fatal(e)
+	}
+	if freshRuntimeDaemon("owned", "windows") || freshRuntimeDaemon("", "linux") || !freshRuntimeDaemon("owned", "linux") {
+		t.Fatal("daemon identity predicate")
+	}
+}
