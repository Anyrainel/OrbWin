@@ -0,0 +1,40 @@
+package controllers
+
+import (
+	"context"
+	"fmt"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+// Name/labels/finalizers do not adopt another producer's resource. Check the
+// sole concrete controller reference before use, mutation or deletion. The
+// later API mutation also carries UID/resourceVersion to reject replacement.
+func requireControllerOwner(object, owner client.Object, apiVersion, kind string) error {
+	if object == nil || owner == nil || owner.GetUID() == "" || object.GetUID() == "" {
+		return fmt.Errorf("resource has no original controller identity")
+	}
+	var controller *metav1.OwnerReference
+	for _, reference := range object.GetOwnerReferences() {
+		if reference.Controller != nil && *reference.Controller {
+			if controller != nil {
+				return fmt.Errorf("resource has multiple controllers")
+			}
+			copy := reference
+			controller = &copy
+		}
+	}
+	if controller == nil || controller.UID != owner.GetUID() || controller.Name != owner.GetName() || controller.APIVersion != apiVersion || controller.Kind != kind {
+		return fmt.Errorf("resource belongs to another controller")
+	}
+	return nil
+}
+
+func deleteOriginalObject(ctx context.Context, c client.Client, object client.Object) error {
+	uid, rv := object.GetUID(), object.GetResourceVersion()
+	if uid == "" || rv == "" {
+		return fmt.Errorf("resource deletion lacks original identity/version")
+	}
+	return c.Delete(ctx, object, client.Preconditions{UID: &uid, ResourceVersion: &rv})
+}
