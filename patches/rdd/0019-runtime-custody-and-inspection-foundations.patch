+//go:build windows
+
+package service
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestFreshSetupFailureHasOnlyFixedStageAndMaskedCause(t *testing.T) {
+	for s := freshStageCapture; s <= freshStageSettlement; s++ {
+		e := freshSetupFailure{stage: s}
+		if !errors.Is(e, errPrivateAuthority) || !strings.HasSuffix(e.Error(), s.String()) || strings.ContainsAny(e.Error(), "\\\n\r") {
+			t.Fatal("failure lost masked cause or bounded stage")
+		}
+	}
+	if freshSetupStage(255).String() != "unknown" {
+		t.Fatal("invalid stage escaped fixed labels")
+	}
+}
