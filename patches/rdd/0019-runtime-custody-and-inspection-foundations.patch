+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/hex"
+	"golang.org/x/sys/windows"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"unsafe"
+)
+
+// SAME-BUILD foundation only. No launch, transfer, HANDLE getter, receiver,
+// different-build selector or mutation permission exists on this derivative.
+type ModernIncomingImage struct{ native *nativeModernIncomingImage }
+type nativeModernIncomingImage struct {
+	self         *ModernIncomingImage
+	authority    *nativeManagedRuntimeAuthority
+	oldSelf      *ModernSelfProcessLease
+	image        *ServingImageLease // Borrowed actual original graph; parent Close barrier.
+	state        modernIncomingImageState
+	path         string
+	profileParts int
+	code         ConfigVersion
+	checks       [2]modernIncomingImageQuery
+}
+type modernIncomingImageQuery struct {
+	pid, session, wait          uint32
+	created, exit, kernel, user windows.Filetime
+	rows                        []windows.ByHandleFileInformation
+	path                        [1040]uint16
+	pathLength                  uint32
+	mappingFile                 windows.Handle // Original class44 in/out word, not an owned closer.
+	mappingLength               uint32
+	mappingStatus               uintptr
+	err                         error
+}
+
+var modernIncomingQueryProcess = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryInformationProcess")
+
+func (*ModernIncomingImage) String() string   { return "same-build held incoming image foundation" }
+func (*ModernIncomingImage) GoString() string { return "same-build held incoming image foundation" }
+func (i *nativeModernIncomingImage) fence()   { i.state.fail(); i.authority.fence() }
+
+// Caller holds authority.mu. Pure original identity/state checks; no native call.
+func modernIncomingSelfHeld(n *nativeManagedRuntimeAuthority, old *ModernSelfProcessLease) bool {
+	if n == nil || old == nil || old.native == nil {
+		return false
+	}
+	s := old.native
+	return n.modernSelfLease == old && s.self == old && s.authority == n && s.complete && s.state.entered && !s.state.pending && s.state.captured && !s.state.closeAttempted && !s.state.closed && !s.state.unknown && s.process != 0 && s.process != windows.InvalidHandle
+}
+
+// Caller holds publisher/Created/image/authority locks. No native operation.
+func (i *nativeModernIncomingImage) originalHeld() bool {
+	if i == nil || i.self == nil || i.self.native != i || i.authority == nil || i.oldSelf == nil || i.oldSelf.native == nil {
+		return false
+	}
+	n, l := i.authority, i.image
+	return n.modernIncomingImage == i.self && modernIncomingSelfHeld(n, i.oldSelf) && n.image == l && servingImageCaptureKnown(l) && n.admitted() && n.controllersStarted && n.main.captured && n.main.process == windows.CurrentProcess() && i.code == l.image && len(l.chain) >= 5 && len(l.chain) == len(l.captureParts)+1 && len(l.resources) == len(l.chain) && len(l.openFrames) == len(l.chain)
+}
+func (i *nativeModernIncomingImage) checkNative(phase int) bool {
+	if !i.originalHeld() || i.state.unknown || phase < 0 || phase > 1 {
+		return false
+	}
+	n, s, l, q := i.authority, i.oldSelf.native, i.image, &i.checks[phase]
+	if len(q.rows) != len(l.chain) {
+		return false
+	}
+	q.pid, q.err = windows.GetProcessId(s.process)
+	if q.err != nil || q.pid == 0 || q.pid != windows.GetCurrentProcessId() || q.pid != n.publisher.serving.PID || q.pid != s.query.pid {
+		return false
+	}
+	q.err = windows.GetProcessTimes(s.process, &q.created, &q.exit, &q.kernel, &q.user)
+	if q.err != nil || q.created != s.query.created || uint64(q.created.HighDateTime)<<32|uint64(q.created.LowDateTime) != n.main.creation || n.main.creation != n.publisher.serving.Creation {
+		return false
+	}
+	q.err = windows.ProcessIdToSessionId(q.pid, &q.session)
+	if q.err != nil || q.session == 0 || q.session != s.query.session || q.session != n.publisher.serving.Session {
+		return false
+	}
+	q.wait, q.err = windows.WaitForSingleObject(s.process, 0)
+	if q.err != nil || q.wait != uint32(windows.WAIT_TIMEOUT) {
+		return false
+	}
+	for index, h := range l.chain {
+		r, f := l.resources[index], l.openFrames[index]
+		if r == nil || r.handle != h || h == 0 || h == windows.InvalidHandle || r.attempted || f == nil || f.owner != l || f.resource != r || f.output != &r.handle || !f.state.usable() {
+			return false
+		}
+		directory := index < len(l.chain)-1
+		// Reuse unchanged synchronous policy predicates and their normal-return
+		// GetSecurityInfo allocation/copy/free contract, not a new raw SD allocator.
+		if checkReadObject(h, n.created.parents.sid, directory) != nil {
+			return false
+		}
+		if index > i.profileParts && verifyPrivate(h, n.created.parents.sid, directory) != nil {
+			return false
+		}
+		q.err = windows.GetFileInformationByHandle(h, &q.rows[index])
+		if q.err != nil {
+			return false
+		}
+
+	}
+	leaf := len(l.chain) - 1
+	info := &q.rows[leaf]
+	if info.VolumeSerialNumber != i.code.Volume || info.FileIndexHigh != i.code.High || info.FileIndexLow != i.code.Low || info.NumberOfLinks != 1 || info.FileAttributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > 512<<20 {
+		return false
+	}
+	if n.main.file != l.chain[leaf] || n.main.id.Volume != i.code.Volume || n.main.id.High != i.code.High || n.main.id.Low != i.code.Low {
+		return false
+	}
+	q.pathLength, q.err = windows.GetFinalPathNameByHandle(l.chain[leaf], &q.path[0], uint32(len(q.path)), 0)
+	if q.err != nil || q.pathLength == 0 || q.pathLength >= uint32(len(q.path)) || !modernIncomingFinalPathMatches(windows.UTF16ToString(q.path[:q.pathLength]), i.path) {
+		return false
+	}
+	// The old wait/query lease intentionally has no QUERY_INFORMATION grant.
+	// Query the original captured current-process pseudo input; never close it.
+	q.mappingFile = l.chain[leaf]
+	q.mappingStatus, _, _ = modernIncomingQueryProcess.Call(uintptr(n.main.process), 44, uintptr(unsafe.Pointer(&q.mappingFile)), unsafe.Sizeof(q.mappingFile), uintptr(unsafe.Pointer(&q.mappingLength)))
+	runtime.KeepAlive(i)
+	if uint32(q.mappingStatus) != 0 {
+		return false
+	} // Pending/unknown: do not read in/out word.
+	if q.mappingFile != l.chain[leaf] || !i.originalHeld() {
+		return false
+	}
+	if phase == 1 {
+		for index := range q.rows {
+			before, after := &i.checks[0].rows[index], &q.rows[index]
+			// Like runtimeStorageIdentity: access/creation times are not object identity;
+			// unrelated directory entries may change directory size/write time.
+			if before.VolumeSerialNumber != after.VolumeSerialNumber || before.FileIndexHigh != after.FileIndexHigh || before.FileIndexLow != after.FileIndexLow || before.FileAttributes != after.FileAttributes || before.NumberOfLinks != after.NumberOfLinks {
+				return false
+			}
+			if index == leaf && (before.FileSizeHigh != after.FileSizeHigh || before.FileSizeLow != after.FileSizeLow || before.LastWriteTime != after.LastWriteTime) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Locks follow the existing constructor: publisher -> Created -> image -> n.
+// Serving.Close uses image -> n; there is no n -> image acquisition here.
+func (a *ManagedRuntimeAuthority) CaptureModernIncomingSelfImage(ctx context.Context, oldSelf *ModernSelfProcessLease) (out *ModernIncomingImage, result error) {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) || oldSelf == nil || oldSelf.native == nil {
+		return nil, ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.image.mu.Lock()
+	defer n.image.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !n.controllersStarted || n.modernIncomingImage != nil || !modernIncomingSelfHeld(n, oldSelf) || n.created.parents == nil || n.created.parents.sid == "" || !servingImageCaptureKnown(n.image) || len(n.image.chain) > 40 || len(n.image.captureParts) < 5 {
+		return nil, ErrUpgrade
+	}
+	l := n.image
+	path := filepath.Join(append([]string{l.captureVolume}, l.captureParts...)...)
+	profile := filepath.Join(append([]string{l.captureVolume}, l.captureParts[:len(l.captureParts)-4]...)...)
+	digest, e := servingImageDigest(profile, path)
+	if e != nil || digest != l.image.Hash || !strings.EqualFold(l.captureParts[len(l.captureParts)-4], ".orbwin-private") || !strings.EqualFold(l.captureParts[len(l.captureParts)-3], "runtime") || !strings.EqualFold(l.captureParts[len(l.captureParts)-2], "rdd-"+hex.EncodeToString(l.image.Hash[:])) || !strings.EqualFold(l.captureParts[len(l.captureParts)-1], "rdd.exe") || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	cap := &ModernIncomingImage{}
+	i := &nativeModernIncomingImage{self: cap, authority: n, oldSelf: oldSelf, image: l, path: path, profileParts: len(l.captureParts) - 4, code: l.image}
+	cap.native = i
+	for phase := range i.checks {
+		i.checks[phase].rows = make([]windows.ByHandleFileInformation, len(l.chain))
+	}
+	n.modernIncomingImage = cap // Original derivative/entire query buffers BEFORE native entry.
+	out = cap
+	defer func() {
+		if recover() != nil {
+			i.fence()
+			result = ErrUpgrade
+		}
+		runtime.KeepAlive(out)
+	}()
+	if !i.originalHeld() || !i.state.begin() || !i.checkNative(0) || !i.checkNative(1) || !i.state.finish(true) {
+		i.fence()
+		return cap, ErrUpgrade
+	}
+	if ctx.Err() != nil {
+		return cap, ErrUpgrade
+	} // Known complete borrow: explicit Close remains possible.
+	return cap, nil
+}
+
+// Cached exact child state only. Call while authority.mu is held; no image lock.
+func (cap *ModernIncomingImage) closedForAuthority(n *nativeManagedRuntimeAuthority) bool {
+	if cap == nil || cap.native == nil || n == nil {
+		return false
+	}
+	i := cap.native
+	return i.self == cap && i.authority == n && n.modernIncomingImage == cap && i.oldSelf == n.modernSelfLease && i.image == n.image && i.state.closedKnown()
+}
+
+// Releases only this logical borrow, never a native handle or source graph.
+func (cap *ModernIncomingImage) Close() (result error) {
+	if cap == nil || cap.native == nil {
+		return ErrUpgrade
+	}
+	i := cap.native
+	n := i.authority
+	if i.self != cap || n == nil || n.publisher == nil || n.created == nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.modernIncomingImage != cap || i.oldSelf != n.modernSelfLease || i.image != n.image {
+		return ErrUpgrade
+	}
+	if cap.closedForAuthority(n) {
+		return nil
+	}
+	if !n.admitted() || !i.state.complete || i.state.unknown {
+		return ErrUpgrade
+	}
+	result = ErrUpgrade
+	defer func() {
+		if recover() != nil {
+			i.fence()
+			result = ErrUpgrade
+		}
+	}()
+	run, e := i.state.beginClose()
+	if e != nil || !run {
+		return ErrUpgrade
+	}
+	if i.state.finishClose() != nil {
+		i.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_image_windows_test.go b/rdd/pkg/managementconfig/runtime_modern_image_windows_test.go
