@@ -0,0 +1,157 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"unsafe"
+)
+
+// The caller holds the current OS thread. Match currentOwner's policy without
+// acquiring an owned token output. The root exposes no retained session lease;
+// this proves only the original policy's nonzero actual process session.
+func sdkImageProducerCaller(ctx context.Context, root *InstanceRoot) error {
+	if ctx == nil || ctx.Err() != nil || root == nil || root.selection == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	if _, e := windows.GetCurrentThreadToken().GetTokenUser(); e != windows.ERROR_NO_TOKEN {
+		return ErrUpgrade
+	}
+	token := windows.GetCurrentProcessToken() // borrowed QUERY pseudo; never close
+	user, e := token.GetTokenUser()
+	if e != nil || user == nil || user.User.Sid == nil || !user.User.Sid.IsValid() || user.User.Sid.String() != root.sid || root.sid != root.selection.Owner() {
+		return ErrUpgrade
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// i.mu -> short typed-domain lock only; no domain lock -> i.mu edge, and no
+// domain lock spans a native call. The map roots the actual owner for lifetime;
+// membership alone never grants an output/parent/name or lifecycle permit.
+func (i *nativeUpgradeSDKImage) producerKnown() bool {
+	if i == nil || i.captureSelf != i || i.root == nil || i.captureRoot != i.root || i.capturePins != i.pins || i.captureUnknown || i.closed || i.closeErr != nil {
+		return false
+	}
+	sdkImageOwnerCustody.Lock()
+	_, held := sdkImageOwnerCustody.images[i]
+	sdkImageOwnerCustody.Unlock()
+	return held
+}
+
+func (i *nativeUpgradeSDKImage) producerCloseReady() bool {
+	// Preserve inert empty-owner Close compatibility: no acquisition occurred.
+	if i.captureSelf == nil {
+		return len(i.held) == 0 && i.captureFrame == nil && !i.captureUnknown
+	}
+	if !i.producerKnown() {
+		return false
+	}
+	for _, slot := range i.held {
+		if slot == nil || slot.frame == nil || slot.frame.output != &slot.handle || !slot.frame.state.usable() {
+			return false
+		}
+	}
+	return true
+}
+
+func (i *nativeUpgradeSDKImage) ownsRuntimeImageOpenFrame(f *runtimeImageOpenFrame) bool {
+	if !i.producerKnown() || i.captureComplete || f == nil || f.owner != i || f.resource != nil || i.captureFrame != f || len(i.held) == 0 || len(i.held) > len(i.captureRoles) {
+		return false
+	}
+	index := len(i.held) - 1
+	slot := i.held[index]
+	role := i.captureRoles[index]
+	if slot == nil || slot.frame != f || f.output != &slot.handle || f.name != role.name || slot.directory != role.directory || slot.private != role.private {
+		return false
+	}
+	for n, older := range i.held[:index] {
+		if older == nil || older.frame == nil || older.frame.owner != i || older.frame.output != &older.handle || older.frame.name != i.captureRoles[n].name || !older.frame.state.usable() {
+			return false
+		}
+	}
+	if role.volume {
+		return index == 0 && role.parent == -1 && f.parent == 0
+	}
+	if role.parent < 0 || role.parent >= index {
+		return false
+	}
+	parent := i.held[role.parent]
+	return parent.directory && parent.frame.state.usable() && parent.handle != 0 && parent.handle != windows.InvalidHandle && f.parent == parent.handle
+}
+func (i *nativeUpgradeSDKImage) fenceRuntimeImageOpenFrame() { i.captureUnknown = true }
+
+// Caller owns i.mu. Each heap slot is stable even when held's pointer slice
+// grows; its handle is the sole native output AND Close cell. No returned raw
+// handle copy supplies custody. Aliases are installed only after full capture.
+func (i *nativeUpgradeSDKImage) captureNext(ctx context.Context, index int) error {
+	if !i.producerKnown() || i.captureComplete || ctx == nil || ctx.Err() != nil || index != len(i.held) || index >= len(i.captureRoles) {
+		return ErrUpgrade
+	}
+	if !i.producerCloseReady() {
+		return ErrUpgrade
+	}
+	role := i.captureRoles[index]
+	slot := &upgradeSDKCodeObject{directory: role.directory, private: role.private}
+	frame := &runtimeImageOpenFrame{owner: i, name: role.name, output: &slot.handle}
+	slot.frame = frame
+	if !role.volume {
+		if role.parent < 0 || role.parent >= index {
+			return ErrUpgrade
+		}
+		parent := i.held[role.parent]
+		if !parent.directory || !parent.frame.state.usable() {
+			return ErrUpgrade
+		}
+		frame.parent = parent.handle
+	}
+	i.held = append(i.held, slot)
+	i.captureFrame = frame // prepublished before native entry or output writes
+	var e error
+	if ctx.Err() != nil {
+		e = ErrUpgrade
+	} else if role.volume {
+		_, e = frame.volume(role.name)
+	} else {
+		access := uint32(windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+		options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+		share := uint32(windows.FILE_SHARE_READ)
+		if role.directory {
+			access |= windows.FILE_LIST_DIRECTORY
+			options |= windows.FILE_DIRECTORY_FILE
+			share |= windows.FILE_SHARE_WRITE
+		} else {
+			access |= windows.FILE_READ_DATA
+			options |= windows.FILE_NON_DIRECTORY_FILE
+		}
+		_, e = frame.ntCall(frame.parent, role.name, access, share, options)
+	}
+	if e != nil {
+		if sdkImageProducerDiscardable(&frame.state) && i.captureFrame == frame && i.held[len(i.held)-1] == slot {
+			i.held = i.held[:index]
+			i.captureFrame = nil
+			if index != 0 {
+				i.captureFrame = i.held[index-1].frame
+			}
+		} else {
+			frame.fence()
+		}
+		return ErrUpgrade
+	}
+	if !frame.original() || !frame.state.attach() {
+		frame.fence()
+		return ErrUpgrade
+	}
+	// Completed output is owned even if cancellation arrived during the call.
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return i.measure(slot)
+}
