diff --git a/rdd/pkg/managementconfig/runtime_inspection_native_windows.go b/rdd/pkg/managementconfig/runtime_inspection_native_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..c04237c6cc60ffd2cc89d1ed999c6da6a7900785
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_native_windows.go
@@ -0,0 +1,78 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+)
+
+func inspectRuntimeNative(ctx context.Context) (result runtimeInspectionResult, failure error) {
+	if !freshBoundedContext(ctx) || runtime.GOARCH != "amd64" {
+		return result, errRuntimeInspection
+	}
+	o := &inspectionNativeOwner{}
+	o.self = o
+	inspectionNativeDomain.Lock()
+	if inspectionNativeDomain.failed || len(inspectionNativeDomain.owners) >= 16 {
+		inspectionNativeDomain.Unlock()
+		return result, errRuntimeInspection
+	}
+	inspectionNativeDomain.owners[o] = true
+	inspectionNativeDomain.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			result = runtimeInspectionResult{}
+			failure = errRuntimeInspection
+		}
+	}()
+	settle := func(value runtimeInspectionResult) (runtimeInspectionResult, error) {
+		if o.close() != nil || ctx.Err() != nil {
+			return runtimeInspectionResult{}, errRuntimeInspection
+		}
+		if o.registryChanged {
+			return inspectionUnknown("observation-changed"), nil
+		}
+		return value, nil
+	}
+	var e error
+	o.selection, e = authoritypath.CaptureCurrentProduct(ctx)
+	if e != nil {
+		return settle(inspectionUnknown("observation-unknown"))
+	}
+	o.selected, e = o.selection.Selection(ctx)
+	if e != nil {
+		return settle(inspectionUnknown("observation-unknown"))
+	}
+	o.user, e = inspectionParseSID(o.selected.Owner())
+	if e != nil {
+		return settle(inspectionUnknown("observation-unknown"))
+	}
+	result = o.classify(ctx)
+	if o.unknown {
+		return runtimeInspectionResult{}, errRuntimeInspection
+	}
+	// A metadata refusal is terminal for this observation. Do not retry its
+	// partial query frame or incomplete object while manufacturing stronger DATA.
+	if result.Phase == "unknown" {
+		return settle(result)
+	}
+	if o.recheckFiles(ctx) != nil || o.recheckImage(ctx) != nil {
+		return settle(inspectionUnknown("observation-changed"))
+	}
+	// Registry is evidence only for the fresh branch. Conflict is a current
+	// denial observation, never native guest ownership or a lifecycle grant.
+	if result.Phase == "fresh" && o.recheckRegistry(ctx) != nil {
+		return settle(inspectionUnknown("observation-changed"))
+	}
+	selected, e := o.selection.Selection(ctx)
+	if e != nil || !selected.Same(o.selected) || !result.valid() {
+		return settle(inspectionUnknown("observation-changed"))
+	}
+	return settle(result)
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_owner_windows.go b/rdd/pkg/managementconfig/runtime_inspection_owner_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..8e1febf0ed08abc2b910cd63cd86dcfcebc8f732
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_owner_windows.go
@@ -0,0 +1,577 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+const inspectionSlotLimit = 160 // Three <=40-component walks,16 recovery records,fixed roles,temporary tail.
+type inspectionNativeSlot struct {
+	owner          *inspectionNativeOwner
+	handle         windows.Handle
+	io             windows.IO_STATUS_BLOCK
+	key            bool
+	registryStatus uintptr
+	state          inspectionResourceState
+}
+type inspectionNativeObject struct {
+	owner                         *inspectionNativeOwner
+	slot                          *inspectionNativeSlot
+	parent                        *inspectionNativeObject
+	name                          string
+	directory, private, traversal bool
+	access                        uint32
+	full                          [24]byte // FILE_ID_INFO: volume64 +fileID128, never legacy witness equality.
+	legacy                        runtimeStorageIdentity
+	body                          []byte
+}
+type inspectionNativeFrame struct {
+	words  []uint64
+	needed uint32
+	info   windows.ByHandleFileInformation
+	full   [24]byte
+	path   [1024]uint16
+	flags  uint32
+	extra  [1]byte
+}
+type inspectionNativeOwner struct {
+	self                     *inspectionNativeOwner
+	selection                *authoritypath.ProductSelectionOwner
+	selected                 *authoritypath.Selection
+	user                     []byte
+	slots                    []*inspectionNativeSlot
+	objects                  []*inspectionNativeObject
+	frame                    *inspectionNativeFrame
+	directories              []inspectionDirectorySnapshot
+	missing                  []inspectionMissingFile
+	keys                     []*inspectionNativeKey
+	keyMissing               *inspectionMissingKey
+	registryFrame            *inspectionRegistryFrame
+	registrySecurityFrame    *inspectionRegistrySecurityFrame
+	registryChanged          bool
+	registryNames            []string
+	lxss                     *inspectionNativeKey
+	selfImage                *inspectionNativeObject
+	selfHash                 [32]byte
+	selfCommit               string
+	imageFrame               *inspectionImageFrame
+	unknown, closing, closed bool
+	closeErr                 error
+}
+type inspectionDirectorySnapshot struct {
+	object *inspectionNativeObject
+	names  []string
+}
+type inspectionMissingFile struct {
+	parent                        *inspectionNativeObject
+	name                          string
+	directory, private, traversal bool
+	access                        uint32
+}
+
+var inspectionNativeDomain = struct {
+	sync.Mutex
+	failed bool
+	owners map[*inspectionNativeOwner]bool
+}{owners: make(map[*inspectionNativeOwner]bool)}
+
+func (o *inspectionNativeOwner) fence() {
+	o.unknown = true
+	inspectionNativeDomain.Lock()
+	inspectionNativeDomain.failed = true
+	inspectionNativeDomain.owners[o] = true
+	inspectionNativeDomain.Unlock()
+}
+func (o *inspectionNativeOwner) known(ctx context.Context) bool {
+	if o == nil || o.self != o || o.unknown || o.registryChanged || o.closing || o.closed || !freshBoundedContext(ctx) || o.selection == nil {
+		return false
+	}
+	inspectionNativeDomain.Lock()
+	known := !inspectionNativeDomain.failed && inspectionNativeDomain.owners[o]
+	inspectionNativeDomain.Unlock()
+	return known && o.selection.KnownForReadOnlyInspection() == nil
+}
+func (o *inspectionNativeOwner) ownsObject(object *inspectionNativeObject) bool {
+	if o == nil || object == nil || object.owner != o || object.slot == nil || object.slot.owner != o || object.slot.state.pending || object.slot.state.attempted {
+		return false
+	}
+	held := false
+	for _, s := range o.slots {
+		if s == object.slot {
+			held = true
+			break
+		}
+	}
+	if !held {
+		return false
+	}
+	for _, actual := range o.objects {
+		if actual == object {
+			return true
+		}
+	}
+	return false
+}
+func (o *inspectionNativeOwner) newSlot(ctx context.Context, key bool) (*inspectionNativeSlot, error) {
+	if !o.known(ctx) || len(o.slots) >= inspectionSlotLimit {
+		return nil, errRuntimeInspection
+	}
+	for _, r := range o.slots {
+		if r.owner != o || r.state.pending || r.state.attempted {
+			return nil, errRuntimeInspection
+		}
+	}
+	r := &inspectionNativeSlot{owner: o, key: key, state: inspectionResourceState{pending: true}}
+	o.slots = append(o.slots, r)
+	return r, nil
+}
+func (o *inspectionNativeOwner) reply(r *inspectionNativeSlot, e error) error {
+	if o == nil || o.self != o {
+		return errRuntimeInspection
+	}
+	if o.unknown || o.closed || o.closing || o.selection == nil || o.selection.KnownForReadOnlyInspection() != nil || r == nil || r.owner != o || len(o.slots) == 0 || o.slots[len(o.slots)-1] != r {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if e == windows.STATUS_PENDING {
+		o.fence()
+		return errRuntimeInspection
+	}
+	discard, unknown, result := r.state.reply(e, r.handle != 0, r.handle != 0 && r.handle != windows.InvalidHandle)
+	if unknown {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if discard {
+		o.slots = o.slots[:len(o.slots)-1]
+	}
+	return result
+}
+func (o *inspectionNativeOwner) closeSlot(r *inspectionNativeSlot) error {
+	if o == nil || o.self != o {
+		return errRuntimeInspection
+	}
+	if o.unknown || r == nil || r.owner != o || o.selection == nil || o.selection.KnownForReadOnlyInspection() != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	held := false
+	for _, actual := range o.slots {
+		if actual == r {
+			held = true
+			break
+		}
+	}
+	if !held {
+		o.fence()
+		return errRuntimeInspection
+	}
+	inspectionNativeDomain.Lock()
+	known := !inspectionNativeDomain.failed && inspectionNativeDomain.owners[o]
+	inspectionNativeDomain.Unlock()
+	if !known {
+		o.fence()
+		return errRuntimeInspection
+	}
+	run, e := r.state.beginClose()
+	if !run {
+		if e != nil {
+			o.fence()
+		}
+		return e
+	}
+	if r.handle == 0 || r.handle == windows.InvalidHandle {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if r.key {
+		e = windows.RegCloseKey(r.handle)
+	} else {
+		e = windows.CloseHandle(r.handle)
+	}
+	if e != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	r.handle = 0
+	r.state.err = nil
+	if r.key && o.closeRegistryWatch(r) != nil {
+		return errRuntimeInspection
+	}
+	return nil
+}
+func (o *inspectionNativeOwner) close() (result error) {
+	if o == nil || o.self != o {
+		return errRuntimeInspection
+	}
+	if o.closed {
+		return o.closeErr
+	}
+	if o.unknown || o.closing {
+		return errRuntimeInspection
+	}
+	// Poll before intentional key closes can signal watch events. This is bounded
+	// observation, never an atomic snapshot or a readiness/admission grant.
+	o.closing = true
+	o.closeErr = errRuntimeInspection
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			result = errRuntimeInspection
+		}
+	}()
+	inspectionNativeDomain.Lock()
+	known := !inspectionNativeDomain.failed && inspectionNativeDomain.owners[o]
+	inspectionNativeDomain.Unlock()
+	if !known {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if o.selection != nil && o.selection.KnownForReadOnlyInspection() != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	for _, r := range o.slots {
+		if r == nil || r.owner != o || r.state.pending {
+			o.fence()
+			return errRuntimeInspection
+		}
+	}
+	if o.pollRegistryWatches() != nil && o.unknown {
+		return errRuntimeInspection
+	}
+	for i := len(o.slots) - 1; i >= 0; i-- {
+		if o.closeSlot(o.slots[i]) != nil {
+			return errRuntimeInspection
+		}
+	}
+	if o.selection != nil && o.selection.Close() != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	o.closed = true
+	o.closeErr = nil
+	inspectionNativeDomain.Lock()
+	delete(inspectionNativeDomain.owners, o)
+	inspectionNativeDomain.Unlock()
+	return nil
+}
+
+func (o *inspectionNativeOwner) open(ctx context.Context, parent *inspectionNativeObject, name string, directory, private, traversal bool, extra uint32) (*inspectionNativeObject, error) {
+	if !o.known(ctx) || parent != nil && (!o.ownsObject(parent) || !parent.directory) {
+		return nil, errRuntimeInspection
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, errRuntimeInspection
+	}
+	oa := windows.OBJECT_ATTRIBUTES{ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	if parent != nil {
+		oa.RootDirectory = parent.slot.handle
+	}
+	r, e := o.newSlot(ctx, false)
+	if e != nil {
+		return nil, e
+	}
+	access := uint32(windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE) | extra
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE)
+	share := uint32(windows.FILE_SHARE_READ)
+	if directory {
+		access |= windows.FILE_LIST_DIRECTORY | windows.FILE_TRAVERSE
+		options &^= windows.FILE_NON_DIRECTORY_FILE
+		options |= windows.FILE_DIRECTORY_FILE
+		share |= windows.FILE_SHARE_WRITE
+	}
+	e = windows.NtCreateFile(&r.handle, access, &oa, &r.io, nil, 0, share, windows.FILE_OPEN, options, 0, 0)
+	if e = o.reply(r, e); e != nil {
+		return nil, e
+	}
+	if r.io.Status != 0 || r.io.Information != 1 {
+		o.fence()
+		return nil, errRuntimeInspection
+	}
+	object := &inspectionNativeObject{owner: o, slot: r, parent: parent, name: name, directory: directory, private: private, traversal: traversal, access: extra}
+	o.objects = append(o.objects, object)
+	if e = o.measure(ctx, object); e != nil {
+		return nil, e
+	}
+	return object, nil
+}
+func (o *inspectionNativeOwner) walk(ctx context.Context, path string, privateLeaf bool) (*inspectionNativeObject, error) {
+	volume, parts, e := readerComponents(path)
+	if e != nil || len(parts) > 40 {
+		return nil, errRuntimeInspection
+	}
+	object, e := o.open(ctx, nil, `\??\`+volume, true, false, true, 0)
+	if e != nil {
+		return nil, e
+	}
+	cachePrefix := false
+	profileParts := 0
+	if o.selected != nil {
+		pv, pp, pe := readerComponents(o.selected.Profile())
+		profileParts = len(pp)
+		if pe == nil && strings.EqualFold(volume, pv) && len(parts) > len(pp) && strings.EqualFold(parts[len(pp)], ".orbwin-private") {
+			cachePrefix = true
+			for i, p := range pp {
+				if !strings.EqualFold(parts[i], p) {
+					cachePrefix = false
+				}
+			}
+		}
+	}
+	for i, name := range parts {
+		leaf := i == len(parts)-1
+		private := privateLeaf && leaf || cachePrefix && i >= profileParts
+		object, e = o.open(ctx, object, name, true, private, !leaf && !private, 0)
+		if e != nil {
+			return nil, e
+		}
+	}
+	return object, nil
+}
+
+var inspectionGetSecurity = windows.NewLazySystemDLL("advapi32.dll").NewProc("GetKernelObjectSecurity")
+
+func (o *inspectionNativeOwner) security(ctx context.Context, object *inspectionNativeObject) (inspectionSecurityFacts, error) {
+	var zero inspectionSecurityFacts
+	if !o.known(ctx) || !o.ownsObject(object) {
+		return zero, errRuntimeInspection
+	}
+	frame := &inspectionNativeFrame{}
+	o.frame = frame
+	result, _, call := inspectionGetSecurity.Call(uintptr(object.slot.handle), uintptr(windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION), 0, 0, uintptr(unsafe.Pointer(&frame.needed)))
+	if inspectionProbeSize(inspectionWinBOOL(result), uint32(call.(windows.Errno)), frame.needed) != nil {
+		return zero, errRuntimeInspection
+	}
+	capacity := frame.needed
+	frame.words = make([]uint64, (capacity+7)/8)
+	frame.needed = 0
+	if !o.known(ctx) {
+		return zero, errRuntimeInspection
+	}
+	result, _, _ = inspectionGetSecurity.Call(uintptr(object.slot.handle), uintptr(windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION), uintptr(unsafe.Pointer(&frame.words[0])), uintptr(capacity), uintptr(unsafe.Pointer(&frame.needed)))
+	if inspectionFetchSize(inspectionWinBOOL(result), frame.needed, capacity) != nil {
+		return zero, errRuntimeInspection
+	}
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&frame.words[0])), int(frame.needed))
+	facts, e := inspectionSecurity(raw, o.user, object.directory, object.private, object.traversal)
+	runtime.KeepAlive(frame)
+	o.frame = nil
+	return facts, e
+}
+func (o *inspectionNativeOwner) measure(ctx context.Context, object *inspectionNativeObject) error {
+	if !o.known(ctx) || !o.ownsObject(object) {
+		return errRuntimeInspection
+	}
+	f := &inspectionNativeFrame{}
+	o.frame = f
+	if windows.GetFileInformationByHandle(object.slot.handle, &f.info) != nil {
+		return errRuntimeInspection
+	}
+	if f.info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (f.info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != object.directory || !object.directory && f.info.NumberOfLinks != 1 {
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) {
+		return errRuntimeInspection
+	}
+	kind, e := windows.GetFileType(object.slot.handle)
+	if e != nil || kind != windows.FILE_TYPE_DISK {
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) || windows.GetFileInformationByHandleEx(object.slot.handle, windows.FileIdInfo, &f.full[0], uint32(len(f.full))) != nil || !inspectionFullIDKnown(f.full) {
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) {
+		return errRuntimeInspection
+	}
+	n, e := windows.GetFinalPathNameByHandle(object.slot.handle, &f.path[0], uint32(len(f.path)), 2)
+	prefix := `\Device\HarddiskVolume`
+	if e != nil || n < uint32(len(prefix)) || n >= uint32(len(f.path)) || !strings.HasPrefix(windows.UTF16ToString(f.path[:n]), prefix) {
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) || windows.GetVolumeInformationByHandle(object.slot.handle, nil, 0, nil, nil, &f.flags, nil, 0) != nil || f.flags&windows.FILE_PERSISTENT_ACLS == 0 {
+		return errRuntimeInspection
+	}
+	info, full := f.info, f.full
+	facts, e := o.security(ctx, object)
+	if e != nil {
+		return e
+	}
+	object.full = full
+	object.legacy = runtimeStorageIdentity{volume: info.VolumeSerialNumber, high: info.FileIndexHigh, low: info.FileIndexLow, attributes: info.FileAttributes, links: info.NumberOfLinks, size: uint64(info.FileSizeHigh)<<32 | uint64(info.FileSizeLow), written: info.LastWriteTime, descriptor: facts.descriptor}
+	if object.directory {
+		object.legacy.size = 0
+		object.legacy.written = windows.Filetime{}
+	}
+	return nil
+}
+func (o *inspectionNativeOwner) checkObject(ctx context.Context, object *inspectionNativeObject) error {
+	if object == nil {
+		return errRuntimeInspection
+	}
+	full, legacy := object.full, object.legacy
+	if o.measure(ctx, object) != nil || object.full != full || object.legacy != legacy {
+		return errRuntimeInspection
+	}
+	return nil
+}
+func (o *inspectionNativeOwner) read(ctx context.Context, object *inspectionNativeObject, budget uint64) ([]byte, error) {
+	if object == nil || object.directory || budget > MaxConfigBytes || object.legacy.size == 0 || object.legacy.size > budget || o.checkObject(ctx, object) != nil {
+		return nil, errRuntimeInspection
+	}
+	body := make([]byte, int(object.legacy.size))
+	object.body = body
+	if !o.known(ctx) {
+		return nil, errRuntimeInspection
+	}
+	if _, e := windows.SetFilePointer(object.slot.handle, 0, nil, windows.FILE_BEGIN); e != nil {
+		return nil, errRuntimeInspection
+	}
+	for at := 0; at < len(body); {
+		if !o.known(ctx) {
+			return nil, errRuntimeInspection
+		}
+		f := &inspectionNativeFrame{}
+		o.frame = f
+		if windows.ReadFile(object.slot.handle, body[at:], &f.needed, nil) != nil || f.needed == 0 || int(f.needed) > len(body)-at {
+			return nil, errRuntimeInspection
+		}
+		at += int(f.needed)
+	}
+	f := &inspectionNativeFrame{}
+	o.frame = f
+	if !o.known(ctx) {
+		return nil, errRuntimeInspection
+	}
+	e := windows.ReadFile(object.slot.handle, f.extra[:], &f.needed, nil)
+	if e != nil && e != windows.ERROR_HANDLE_EOF || f.needed != 0 || o.checkObject(ctx, object) != nil {
+		return nil, errRuntimeInspection
+	}
+	o.frame = nil
+	return body, nil
+}
+func inspectionObjectWitness(object *inspectionNativeObject) UpgradeObject {
+	return UpgradeObject{object.legacy.volume, object.legacy.high, object.legacy.low}
+}
+func inspectionFileWitness(object *inspectionNativeObject, body []byte) runtimePublicationFileWitness {
+	return runtimePublicationFileWitness{Object: inspectionObjectWitness(object), Descriptor: object.legacy.descriptor, Size: uint64(len(body)), Written: uint64(object.legacy.written.HighDateTime)<<32 | uint64(object.legacy.written.LowDateTime), Body: sha256.Sum256(body)}
+}
+
+func (o *inspectionNativeOwner) list(ctx context.Context, object *inspectionNativeObject) ([]string, error) {
+	if !o.known(ctx) || !o.ownsObject(object) || !object.directory {
+		return nil, errRuntimeInspection
+	}
+	var names []string
+	for page := 0; page < 16; page++ {
+		f := &inspectionNativeFrame{words: make([]uint64, 8192)}
+		o.frame = f
+		class := uint32(windows.FileFullDirectoryInfo)
+		if page == 0 {
+			class = windows.FileFullDirectoryRestartInfo
+		}
+		if !o.known(ctx) {
+			return nil, errRuntimeInspection
+		}
+		e := windows.GetFileInformationByHandleEx(object.slot.handle, class, (*byte)(unsafe.Pointer(&f.words[0])), 65536)
+		if e == windows.ERROR_NO_MORE_FILES {
+			o.frame = nil
+			return inspectionClosedNames(names)
+		}
+		if e != nil {
+			return nil, errRuntimeInspection
+		}
+		values, e := inspectionDirectoryPage(unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), 65536))
+		runtime.KeepAlive(f)
+		if e != nil || len(names)+len(values) > inspectionDirectoryEntryLimit {
+			return nil, errRuntimeInspection
+		}
+		names = append(names, values...)
+	}
+	return nil, errRuntimeInspection
+}
+func (o *inspectionNativeOwner) snapshotDirectory(ctx context.Context, object *inspectionNativeObject) ([]string, error) {
+	names, e := o.list(ctx, object)
+	if e != nil {
+		return nil, e
+	}
+	o.directories = append(o.directories, inspectionDirectorySnapshot{object, names})
+	return names, nil
+}
+func (o *inspectionNativeOwner) optional(ctx context.Context, parent *inspectionNativeObject, name string, directory, private, traversal bool, access uint32) (*inspectionNativeObject, error) {
+	object, e := o.open(ctx, parent, name, directory, private, traversal, access)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		o.missing = append(o.missing, inspectionMissingFile{parent, name, directory, private, traversal, access})
+		return nil, nil
+	}
+	return object, e
+}
+func (o *inspectionNativeOwner) dropTemporary(object *inspectionNativeObject) error {
+	if o == nil || o.self != o {
+		return errRuntimeInspection
+	}
+	if object == nil || object.owner != o || len(o.objects) == 0 || o.objects[len(o.objects)-1] != object || len(o.slots) == 0 || o.slots[len(o.slots)-1] != object.slot {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if o.closeSlot(object.slot) != nil {
+		return errRuntimeInspection
+	}
+	o.objects = o.objects[:len(o.objects)-1]
+	o.slots = o.slots[:len(o.slots)-1]
+	return nil
+}
+func (o *inspectionNativeOwner) recheckFiles(ctx context.Context) error {
+	originals := append([]*inspectionNativeObject(nil), o.objects...)
+	for _, object := range originals {
+		if o.checkObject(ctx, object) != nil {
+			return errRuntimeInspection
+		}
+		// Reopen this exact edge through the retained original parent. Comparison
+		// uses complete FILE_ID_INFO and SD/basic facts, not historical narrow IDs.
+		edge, e := o.open(ctx, object.parent, object.name, object.directory, object.private, object.traversal, object.access)
+		if e != nil {
+			return errRuntimeInspection
+		}
+		same := edge.full == object.full && edge.legacy == object.legacy
+		if o.dropTemporary(edge) != nil || !same {
+			return errRuntimeInspection
+		}
+		if object.body != nil {
+			expected := append([]byte(nil), object.body...)
+			actual, e := o.read(ctx, object, uint64(len(expected)))
+			if e != nil || !bytes.Equal(actual, expected) {
+				return errRuntimeInspection
+			}
+		}
+	}
+	for _, snapshot := range o.directories {
+		actual, e := o.list(ctx, snapshot.object)
+		if e != nil || len(actual) != len(snapshot.names) {
+			return errRuntimeInspection
+		}
+		for i, name := range actual {
+			if name != snapshot.names[i] {
+				return errRuntimeInspection
+			}
+		}
+	}
+	for _, missing := range o.missing {
+		_, e := o.open(ctx, missing.parent, missing.name, missing.directory, missing.private, missing.traversal, missing.access)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return errRuntimeInspection
+		}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_protocol.go b/rdd/pkg/managementconfig/runtime_inspection_protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..7540e8ca8226b5df4af48afd9b99e1b93e66892d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_protocol.go
@@ -0,0 +1,192 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+// Inspection is observation DATA. This protocol cannot carry a native owner,
+// path, PID, nonce, reusable permit, caller-selected root or mutation request.
+const runtimeInspectionRequest = `{"schema":2,"operation":"inspect"}`
+const runtimeInspectionRequestLimit = 128
+const runtimeInspectionResultLimit = 16384
+
+var errRuntimeInspection = errors.New("runtime inspection unavailable")
+
+type runtimeInspectionAction struct {
+	Action string `json:"action"`
+	State  string `json:"state"`
+	Reason string `json:"reason"`
+}
+
+type runtimeInspectionResult struct {
+	Schema     int                       `json:"schema"`
+	Evidence   string                    `json:"evidence"`
+	Scope      string                    `json:"scope"`
+	Phase      string                    `json:"phase"`
+	Reason     string                    `json:"reason"`
+	Runtime    string                    `json:"runtime"`
+	Image      string                    `json:"image"`
+	Connection string                    `json:"connection"`
+	Clients    string                    `json:"clients"`
+	Actions    []runtimeInspectionAction `json:"actions"`
+}
+
+func inspectionOneOf(value string, choices ...string) bool {
+	for _, choice := range choices {
+		if value == choice {
+			return true
+		}
+	}
+	return false
+}
+
+func inspectionReason(reason string) bool {
+	return inspectionOneOf(reason,
+		"none", "route-not-enabled", "missing-component", "initial-absence-observed",
+		"interrupted-same-image", "initialized-uncommitted", "prepared-not-renamed",
+		"renamed-not-committed", "committed-receipt", "orphan-stage",
+		"missing-control-after-denial", "control-cut-unsupported", "tuple-cut-unsupported",
+		"different-image", "different-source", "malformed-record", "partial-record-unsupported",
+		"namespace-conflict", "owner-busy", "observation-changed", "observation-unknown",
+		"client-initialization-required", "client-recovery-required", "client-inspection-unavailable",
+		"proof-scope")
+}
+
+// The actual native producer must select these facts after its own FILE_OPEN
+// observations and checked release. Missing/error/unknown never means absence.
+// No product lifecycle role is enabled by this first contract implementation.
+func inspectionUnsupportedActions() []runtimeInspectionAction {
+	actions := make([]runtimeInspectionAction, 0, 5)
+	for _, name := range []string{"prepare-engine", "resume-setup", "start-engine", "upgrade-engine", "review-private-clients"} {
+		actions = append(actions, runtimeInspectionAction{name, "unsupported", "route-not-enabled"})
+	}
+	return actions
+}
+
+func inspectionUnknown(reason string) runtimeInspectionResult {
+	if !inspectionUnknownReason(reason) {
+		reason = "observation-unknown"
+	}
+	scope := "product"
+	if reason == "proof-scope" {
+		scope = "historical-debug-proof"
+	}
+	return runtimeInspectionResult{2, "bounded-observation", scope, "unknown", reason, "unknown", "unknown", "not-checked", "not-checked", inspectionUnsupportedActions()}
+}
+
+func inspectionUnknownReason(reason string) bool {
+	return inspectionOneOf(reason, "route-not-enabled", "missing-component", "control-cut-unsupported", "tuple-cut-unsupported",
+		"malformed-record", "partial-record-unsupported", "observation-changed", "observation-unknown", "client-inspection-unavailable", "proof-scope")
+}
+
+func (r runtimeInspectionResult) valid() bool {
+	if r.Schema != 2 || r.Evidence != "bounded-observation" || !inspectionOneOf(r.Scope, "product", "historical-debug-proof") ||
+		!inspectionOneOf(r.Phase, "fresh", "interrupted", "committed", "unsupported-version", "conflict", "busy", "unknown") ||
+		!inspectionReason(r.Reason) || !inspectionOneOf(r.Runtime, "absent", "uncommitted", "committed", "unknown") ||
+		!inspectionOneOf(r.Image, "same", "different", "unknown") ||
+		!inspectionOneOf(r.Connection, "not-checked", "online", "offline", "conflict", "unknown") ||
+		!inspectionOneOf(r.Clients, "not-checked", "ready", "initialization-needed", "recovery-needed", "unknown") || len(r.Actions) != 5 {
+		return false
+	}
+	if r.Scope == "historical-debug-proof" && (r.Phase != "unknown" || r.Reason != "proof-scope") {
+		return false
+	}
+	if r.Reason == "proof-scope" && r.Scope != "historical-debug-proof" {
+		return false
+	}
+	switch r.Phase {
+	case "fresh":
+		if r.Runtime != "absent" || r.Image != "unknown" || r.Reason != "initial-absence-observed" {
+			return false
+		}
+	case "interrupted":
+		if r.Runtime != "uncommitted" || r.Image != "same" || !inspectionOneOf(r.Reason, "interrupted-same-image", "initialized-uncommitted", "prepared-not-renamed", "renamed-not-committed", "orphan-stage", "missing-control-after-denial") {
+			return false
+		}
+	case "committed":
+		if r.Runtime != "committed" || r.Image != "same" || r.Reason != "committed-receipt" {
+			return false
+		}
+	case "unsupported-version":
+		if !inspectionOneOf(r.Runtime, "uncommitted", "committed") || r.Image != "different" || !inspectionOneOf(r.Reason, "different-image", "different-source") {
+			return false
+		}
+	case "conflict":
+		if r.Reason != "namespace-conflict" {
+			return false
+		}
+	case "busy":
+		if r.Reason != "owner-busy" {
+			return false
+		}
+	case "unknown":
+		if r.Runtime != "unknown" || r.Image != "unknown" || !inspectionUnknownReason(r.Reason) {
+			return false
+		}
+	}
+	// A passive file classifier has no service/client producer yet. Keep these
+	// explicitly unobserved instead of borrowing an effectful client reader.
+	if r.Connection != "not-checked" || r.Clients != "not-checked" {
+		return false
+	}
+	for i, want := range inspectionUnsupportedActions() {
+		if r.Actions[i] != want {
+			return false
+		}
+	}
+	return true
+}
+
+// Called from a DATA-only reader goroutine under the entry's own deadline.
+// Requiring EOF makes extra frames/trailing bytes refusal, not ignored input.
+func readRuntimeInspectionRequest(input io.Reader) error {
+	if input == nil {
+		return errRuntimeInspection
+	}
+	var header [4]byte
+	if _, err := io.ReadFull(input, header[:]); err != nil {
+		return errRuntimeInspection
+	}
+	n := binary.LittleEndian.Uint32(header[:])
+	if n == 0 || n > runtimeInspectionRequestLimit || int(n) != len(runtimeInspectionRequest) {
+		return errRuntimeInspection
+	}
+	body := make([]byte, n)
+	if _, err := io.ReadFull(input, body); err != nil || !bytes.Equal(body, []byte(runtimeInspectionRequest)) {
+		return errRuntimeInspection
+	}
+	var trailing [1]byte
+	if _, err := io.ReadFull(input, trailing[:]); err != io.EOF {
+		return errRuntimeInspection
+	}
+	return nil
+}
+
+func runtimeInspectionBytes(result runtimeInspectionResult) ([]byte, error) {
+	if !result.valid() {
+		return nil, errRuntimeInspection
+	}
+	body, err := json.Marshal(result)
+	if err != nil || len(body)+1 > runtimeInspectionResultLimit {
+		return nil, errRuntimeInspection
+	}
+	return append(body, '\n'), nil
+}
+
+// Canonical closed encoding also rejects duplicate, unknown/case-folded fields,
+// alternate enum spellings, extra records, missing fields and reordered actions.
+func parseRuntimeInspectionResult(body []byte) (runtimeInspectionResult, error) {
+	var result runtimeInspectionResult
+	if len(body) == 0 || len(body) > runtimeInspectionResultLimit || json.Unmarshal(body, &result) != nil {
+		return runtimeInspectionResult{}, errRuntimeInspection
+	}
+	canonical, err := runtimeInspectionBytes(result)
+	if err != nil || !bytes.Equal(body, canonical) {
+		return runtimeInspectionResult{}, errRuntimeInspection
+	}
+	return result, nil
+}
