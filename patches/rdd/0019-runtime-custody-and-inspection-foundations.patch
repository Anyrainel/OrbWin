--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_restore_windows.go
@@ -0,0 +1,246 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"golang.org/x/sys/windows"
+)
+
+// FILE_OPEN-only reconstruction of a complete original retention transaction.
+// The decoded recipe supplies expected DATA only. Native original objects,
+// current controller/parent IDs+SD and exact fixed namespace establish custody.
+// Caller holds original o->n/thread before any Created/controller execution.
+func (r *nativeFreshRecoveryOwner) captureRecordedControlLocked(ctx context.Context) (bool, error) {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return false, ErrUpgrade
+	}
+	o := r.owner
+	n := o.storage
+	if !r.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) || r.controlRetention != nil || len(n.ancestry) == 0 || r.checkAdmittedStorageLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	if n.controlNamespaceLocked(ctx, o.intent.Transaction, true) != nil {
+		return false, ErrUpgrade
+	}
+	type partial struct {
+		ordinal uint32
+		body    []byte
+	}
+	var partials []partial
+	var chosen *runtimeStorageObject
+	var chosenBody []byte
+	var record runtimeFreshControlRetention
+	gap := false
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlRecordName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || chosen != nil {
+			return false, ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return false, ErrUpgrade
+		}
+		var value runtimeFreshControlRetention
+		if parseRuntimeFreshRecord(body, &value) == nil && value.valid() {
+			canonical, e := runtimeFreshRecordBytes(value)
+			if e != nil || value.Ordinal != ordinal || !bytes.Equal(canonical, body) {
+				return false, ErrUpgrade
+			}
+			chosen, chosenBody, record = object, append([]byte(nil), body...), value
+		} else {
+			partials = append(partials, partial{ordinal, append([]byte(nil), body...)})
+		}
+	}
+	if chosen == nil {
+		if r.admission != nil && (r.admission.ControlRetention != (runtimePublicationFileWitness{}) || len(partials) > 0) {
+			return false, ErrUpgrade
+		}
+		// Incomplete recipes have no dependent effect. Their bytes may only be
+		// compared to intended fixed args after actual structural capture. A
+		// missing/initialized root cannot silently adopt them as normal mode.
+		if len(partials) > 0 {
+			retainedName, e := runtimeFreshControlRetainedName(o.intent.Transaction)
+			if e != nil {
+				return false, ErrUpgrade
+			}
+			retained, re := n.openFreshExistingTracked(ctx, parent.resource.handle, retainedName, true, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+			if re != windows.STATUS_OBJECT_NAME_NOT_FOUND || retained != nil || !freshBoundedContext(ctx) {
+				return false, ErrUpgrade
+			}
+			root, e := n.openFreshExistingTracked(ctx, parent.resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+			if e != nil {
+				return false, ErrUpgrade
+			}
+			prefix, e := r.captureStructuralControlLocked(ctx, root)
+			if e != nil || prefix == nil {
+				return false, ErrUpgrade
+			}
+			return true, nil
+		}
+		if n.controlNamespaceLocked(ctx, o.intent.Transaction, false) != nil {
+			return false, ErrUpgrade
+		}
+		return false, nil
+	}
+	for _, p := range partials {
+		expected := record
+		expected.Ordinal = p.ordinal
+		body, e := runtimeFreshRecordBytes(expected)
+		if e != nil || !runtimeFreshControlPrefixBytes(p.body, body) {
+			return false, ErrUpgrade
+		}
+	}
+	intent, e := n.read(o.fenceObject, false)
+	if e != nil || r.denial == nil || r.denial.checkLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	if record.Transaction != o.intent.Transaction || record.Intent != runtimeStorageFileData(o.fenceObject, intent) || record.Denial != runtimeStorageFileData(r.denial.receipt, r.denial.body) || record.PrivateParent != runtimeStorageObjectData(parent) || record.PrivateDescriptor != parent.identity.descriptor || record.PublicParent != runtimeStorageObjectData(n.parent) || record.PublicDescriptor != n.parent.identity.descriptor || record.Controller != runtimeStorageObjectData(n.controller) || record.ControllerDescriptor != n.controller.identity.descriptor {
+		return false, ErrUpgrade
+	}
+	s := &nativeFreshControlRecovery{recovery: r, parent: parent, record: record, recordObject: chosen, recordBody: chosenBody}
+	s.self = s
+	r.controlRetention = s
+	if r.admission != nil && r.admission.ControlRetention != runtimeStorageFileData(chosen, chosenBody) {
+		return false, ErrUpgrade
+	}
+	// Directory FILE_ADD_FILE / FILE_ADD_SUBDIRECTORY use the Windows aliases
+	// FILE_WRITE_DATA / FILE_APPEND_DATA exposed by the selected x/sys pin.
+	access := uint32(windows.FILE_LIST_DIRECTORY | windows.FILE_TRAVERSE | windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA | windows.DELETE)
+	share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE | windows.FILE_SHARE_DELETE)
+	canonical, ce := n.openFreshExistingTracked(ctx, parent.resource.handle, anchorName, true, access, share, true, false)
+	if ce != nil && ce != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return false, ErrUpgrade
+	}
+	name, _ := runtimeFreshControlRetainedName(record.Transaction)
+	retained, re := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE|windows.DELETE, share, true, false)
+	if re != nil && re != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return false, ErrUpgrade
+	}
+	if retained != nil {
+		if runtimeStorageObjectData(retained) != record.OldAuthority || retained.identity.descriptor != record.OldDescriptor {
+			return false, ErrUpgrade
+		}
+		s.oldRoot, s.retainedObject = retained, retained
+		if canonical != nil && runtimeStorageObjectData(canonical) == record.OldAuthority {
+			return false, ErrUpgrade
+		}
+		s.newRoot = canonical
+	} else {
+		if canonical == nil || runtimeStorageObjectData(canonical) != record.OldAuthority || canonical.identity.descriptor != record.OldDescriptor {
+			return false, ErrUpgrade
+		}
+		s.oldRoot = canonical
+	}
+	s.oldLock, e = n.openFreshExistingTracked(ctx, s.oldRoot.resource.handle, "authority.owner.lock", false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, windows.FILE_SHARE_DELETE, true, false)
+	if e != nil || runtimeStorageObjectData(s.oldLock) != record.OldOwnerLock || s.oldLock.identity.descriptor != record.OwnerDescriptor || s.oldLock.identity.size != 0 {
+		return false, ErrUpgrade
+	}
+	names := map[string]string{"tls": "tls", "db": "db", "args": "args.json", "init": "authority.init"}
+	for _, fact := range record.Inventory {
+		fixed := names[fact.Role]
+		if fixed == "" {
+			return false, ErrUpgrade
+		}
+		a := uint32(windows.FILE_READ_DATA | windows.DELETE)
+		if fact.Directory {
+			a = windows.FILE_LIST_DIRECTORY | windows.FILE_TRAVERSE | windows.DELETE
+		}
+		object, e := n.openFreshExistingTracked(ctx, s.oldRoot.resource.handle, fixed, fact.Directory, a, share, true, false)
+		if e != nil || runtimeStorageObjectData(object) != fact.Object || object.identity.descriptor != fact.Descriptor || object.identity.size != fact.Size {
+			return false, ErrUpgrade
+		}
+		entry := nativeFreshControlEntry{name: fixed, role: fact.Role, object: object}
+		if fact.Directory {
+			children, e := datastoreDirectoryNames(object.resource.handle)
+			if e != nil || len(children) != 0 {
+				return false, ErrUpgrade
+			}
+		} else {
+			entry.body, e = n.read(object, true)
+			if e != nil || sha256.Sum256(entry.body) != fact.Body {
+				return false, ErrUpgrade
+			}
+		}
+		s.entries = append(s.entries, entry)
+	}
+	s.complete = true
+	if s.checkRetentionRecordLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	if s.retainedObject == nil {
+		if s.checkPrefixLocked(ctx) != nil {
+			return false, ErrUpgrade
+		}
+		return true, nil
+	}
+	if s.newRoot == nil {
+		if s.checkPrefixLocked(ctx) != nil {
+			return false, ErrUpgrade
+		}
+		return true, nil
+	}
+	if s.captureExistingBirthLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	if r.admission != nil && (s.birthObject == nil || r.admission.ControlBirth != runtimeStorageFileData(s.birthObject, s.birthBody) || runtimeStorageObjectData(s.newRoot) != r.admission.Authority) {
+		return false, ErrUpgrade
+	}
+	return true, nil
+}
+
+func (s *nativeFreshControlRecovery) captureExistingBirthLocked(ctx context.Context) error {
+	if s == nil || s.newRoot == nil || s.retainedObject == nil || s.checkRetentionRecordLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	n := s.recovery.owner.storage
+	children, e := datastoreDirectoryNames(s.newRoot.resource.handle)
+	if e != nil {
+		return ErrUpgrade
+	}
+	empty := len(children) == 0
+	witness := runtimeStorageFileData(s.recordObject, s.recordBody)
+	gap := false
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlBirthName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || s.birthObject != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		expected := runtimeFreshControlBirth{Schema: 1, Transaction: s.record.Transaction, Ordinal: ordinal, Retention: witness, Authority: runtimeStorageObjectData(s.newRoot), Descriptor: s.newRoot.identity.descriptor}
+		canonical, e := runtimeFreshRecordBytes(expected)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if bytes.Equal(body, canonical) {
+			s.birthObject, s.birthBody, s.birth = object, append([]byte(nil), body...), expected
+			continue
+		}
+		if !empty || !runtimeFreshControlPrefixBytes(body, canonical) {
+			return ErrUpgrade
+		}
+	}
+	if s.birthObject == nil {
+		if !empty || s.checkPrefixLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		return finishRuntimeFreshGuestPreflight(ctx)
+	}
+	return s.checkBirthForRootLocked(ctx, s.newRoot)
+}
