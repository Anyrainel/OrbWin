+func (s *inspectionFreshRecords) earlyIntent(ctx context.Context) runtimeInspectionResult {
+	// Exact before-effects namespace: no home, authority, app, publication or
+	// denial metadata. Existing registry ownership is a conflict, not freshness.
+	allowed := map[string]bool{"runtime": true, "setup-logs": true, runtimeFreshFenceName: true}
+	for i := uint32(0); i < runtimeFreshIntentRepairSlots; i++ {
+		r, _ := runtimeFreshIntentRepairName(i)
+		a, _ := runtimeFreshIntentArchiveName(i)
+		allowed[r], allowed[a] = true, true
+	}
+	for _, n := range s.privateNames {
+		if allowed[n] {
+			continue
+		}
+		if _, e := parseRuntimeFreshSeedName(n); e != nil {
+			return inspectionUnknown("partial-record-unsupported")
+		}
+	}
+	names, e := s.o.snapshotDirectory(ctx, s.public)
+	if e != nil {
+		return inspectionUnknown("observation-unknown")
+	}
+	if len(names) != 1 || names[0] != "setup.lock" {
+		return inspectionUnknown("partial-record-unsupported")
+	}
+	owned, e := s.o.captureRegistry(ctx)
+	if e != nil {
+		return inspectionUnknown("observation-unknown")
+	}
+	if owned {
+		return inspectionObserved("conflict", "namespace-conflict", "unknown", "unknown")
+	}
+	return s.imageResult(ctx, "interrupted-same-image", "uncommitted")
+}
