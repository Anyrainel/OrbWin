+++ b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_test.go
@@ -0,0 +1,156 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/json"
+	"encoding/pem"
+	"testing"
+)
+
+func runtimeFreshTupleFixture(t *testing.T) (runtimeFreshTupleBinding, runtimeFreshTupleMaterial) {
+	t.Helper()
+	a := freshPublicationFixture()
+	b := runtimeFreshTupleBinding{Schema: 1, Transaction: a.Transaction, Intent: a.Intent, Denial: a.LegacyDenial, Controller: a.Controller, Authority: a.Authority, TLS: UpgradeObject{a.Authority.Volume, 10, 11}, ControllerDescriptor: a.ControllerDescriptor, AuthorityDescriptor: [32]byte{2}, TLSDescriptor: [32]byte{3}}
+	_, doc := publicationFixture(t)
+	var parsed publicationDocument
+	if json.Unmarshal(doc, &parsed) != nil {
+		t.Fatal("fixture")
+	}
+	key := ed25519.NewKeyFromSeed(make([]byte, ed25519.SeedSize))
+	defer clear(key)
+	sa := ed25519.NewKeyFromSeed(bytes.Repeat([]byte{9}, ed25519.SeedSize))
+	defer clear(sa)
+	keyDER, e := x509.MarshalPKCS8PrivateKey(key)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(keyDER)
+	saDER, e := x509.MarshalPKCS8PrivateKey(sa)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(saDER)
+	return b, runtimeFreshTupleMaterial{parsed.Clusters[0].Cluster.CA, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER}), pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: saDER})}
+}
+
+func TestRuntimeFreshTuplePrivateEncodingBindsOriginalGraph(t *testing.T) {
+	b, m := runtimeFreshTupleFixture(t)
+	defer m.clear()
+	body, e := encodeRuntimeFreshAuthorityTuple(b, m.cert, m.key, m.account)
+	if e != nil {
+		t.Fatal("encode")
+	}
+	defer clear(body)
+	got, e := parseRuntimeFreshAuthorityTuple(body, b)
+	if e != nil || !bytes.Equal(got.cert, m.cert) || !bytes.Equal(got.key, m.key) || !bytes.Equal(got.account, m.account) {
+		t.Fatal("original tuple changed")
+	}
+	defer got.clear()
+	for _, change := range []func(*runtimeFreshTupleBinding){
+		func(b *runtimeFreshTupleBinding) { b.Controller.Low++ }, func(b *runtimeFreshTupleBinding) { b.ControllerDescriptor[0]++ }, func(b *runtimeFreshTupleBinding) { b.Authority.Low++ }, func(b *runtimeFreshTupleBinding) { b.AuthorityDescriptor[0]++ }, func(b *runtimeFreshTupleBinding) { b.TLS.Low++ }, func(b *runtimeFreshTupleBinding) { b.TLSDescriptor[0]++ }, func(b *runtimeFreshTupleBinding) { b.Ordinal++ }, func(b *runtimeFreshTupleBinding) { b.Intent.Body[0]++ }, func(b *runtimeFreshTupleBinding) { b.Denial.Body[0]++ },
+	} {
+		wrong := b
+		change(&wrong)
+		refused, e := parseRuntimeFreshAuthorityTuple(body, wrong)
+		if e == nil || len(refused.key) != 0 || len(refused.account) != 0 {
+			t.Fatal("different native transaction graph returned secrets")
+		}
+	}
+	certRef, keyRef, saRef := got.cert, got.key, got.account
+	got.clear()
+	for _, owned := range [][]byte{certRef, keyRef, saRef} {
+		if !bytes.Equal(owned, make([]byte, len(owned))) {
+			t.Fatal("owned secret bytes survived clear")
+		}
+	}
+	if !bytes.Equal(m.key, []byte(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: mustTuplePKCS8(t, ed25519.NewKeyFromSeed(make([]byte, ed25519.SeedSize)))}))) {
+		t.Fatal("clearing decoded ownership changed source input")
+	}
+}
+
+func mustTuplePKCS8(t *testing.T, key ed25519.PrivateKey) []byte {
+	t.Helper()
+	defer clear(key)
+	b, e := x509.MarshalPKCS8PrivateKey(key)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b
+}
+
+func TestRuntimeFreshTupleEveryInterruptedBodyRefuses(t *testing.T) {
+	b, m := runtimeFreshTupleFixture(t)
+	defer m.clear()
+	body, e := encodeRuntimeFreshAuthorityTuple(b, m.cert, m.key, m.account)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(body)
+	for cut := 0; cut < len(body); cut++ {
+		got, e := parseRuntimeFreshAuthorityTuple(body[:cut], b)
+		if e == nil || len(got.key) != 0 || len(got.account) != 0 {
+			t.Fatal("partial tuple issued material")
+		}
+	}
+	for _, bad := range [][]byte{append(append([]byte(nil), body...), 0), make([]byte, runtimeFreshTupleBudget+1)} {
+		got, e := parseRuntimeFreshAuthorityTuple(bad, b)
+		clear(bad)
+		if e == nil || len(got.key) != 0 {
+			t.Fatal("unbounded/trailing tuple admitted")
+		}
+	}
+	wrong := append([]byte(nil), body...)
+	defer clear(wrong)
+	binary.LittleEndian.PutUint32(wrong[len(runtimeFreshTupleMagic)+4:], ^uint32(0))
+	digest := sha256.Sum256(wrong[:len(wrong)-sha256.Size])
+	copy(wrong[len(wrong)-sha256.Size:], digest[:])
+	if _, e := parseRuntimeFreshAuthorityTuple(wrong, b); e == nil {
+		t.Fatal("overflowing length admitted")
+	}
+	wrong = append(wrong[:0], body...)
+	wrong[len(wrong)-sha256.Size-8] ^= 1
+	if _, e := parseRuntimeFreshAuthorityTuple(wrong, b); e == nil {
+		t.Fatal("changed secret body admitted")
+	}
+}
+
+func TestRuntimeFreshTupleIncompleteSlotsRequireActualProducerPrefix(t *testing.T) {
+	b, m := runtimeFreshTupleFixture(t)
+	defer m.clear()
+	body, e := encodeRuntimeFreshAuthorityTuple(b, m.cert, m.key, m.account)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(body)
+	for cut := 0; cut < len(body); cut++ {
+		if !runtimeFreshTupleIncomplete(body[:cut], b) {
+			t.Fatal("actual interrupted producer prefix not recognized")
+		}
+	}
+	if runtimeFreshTupleIncomplete(body, b) {
+		t.Fatal("complete tuple treated as failed slot")
+	}
+	wrong := append([]byte(nil), body...)
+	defer clear(wrong)
+	wrong[len(wrong)-1] ^= 1
+	if runtimeFreshTupleIncomplete(wrong, b) {
+		t.Fatal("complete corrupt tuple authorized next material")
+	}
+	wrong = append(wrong[:0], body...)
+	wrong[0] ^= 1
+	if runtimeFreshTupleIncomplete(wrong[:8], b) {
+		t.Fatal("foreign tuple prefix accepted")
+	}
+	wrong = append(wrong[:0], body...)
+	binary.LittleEndian.PutUint32(wrong[len(runtimeFreshTupleMagic)+4:], 0)
+	if runtimeFreshTupleIncomplete(wrong[:len(runtimeFreshTupleMagic)+16], b) {
+		t.Fatal("impossible producer length accepted")
+	}
+	if _, e := runtimeFreshTupleFileName(runtimeFreshTupleSlots); e == nil {
+		t.Fatal("unbounded tuple names")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_windows.go b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b53b427fc2d102e886de9828f8f8aeb3156c4de0
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_windows.go
@@ -0,0 +1,321 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Only actual lower CREATE installs this state before returning its Created.
+// It has no independent closer: all duplicates/files belong to SAME n.resources.
+// Existing initialized authorities have no such state and stay read-only.
+type nativeFreshAuthorityTupleState struct {
+	self                 *nativeFreshAuthorityTupleState
+	owner                *FreshSetupOwner
+	created              *Created
+	root, tls, db, tuple *runtimeStorageObject
+	ownerLock            runtimeStorageIdentity
+	binding              runtimeFreshTupleBinding
+}
+
+func (s *nativeFreshAuthorityTupleState) closeCreated() error {
+	if s == nil || s.self != s || s.owner == nil || s.created == nil {
+		return ErrCreate
+	}
+	o, c := s.owner, s.created
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if o.self != o || o.created != c || c.freshAuthority != s {
+		return ErrCreate
+	}
+	// A completed own close replays its exact cache without requiring a live
+	// parent graph after later retirement. No own syscall is repeated.
+	if c.closed {
+		return c.closeErr
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || o.storage == nil || !o.captureComplete {
+		return ErrCreate
+	}
+	if o.closed || o.unknown {
+		return ErrCreate
+	}
+	if !o.knownStorageCloseLocked() {
+		o.unknown = true
+		o.storage.mu.Lock()
+		o.storage.fence()
+		o.storage.mu.Unlock()
+		return ErrCreate
+	}
+	if o.image == nil {
+		return ErrCreate
+	}
+	o.image.mu.Lock()
+	sourceUnknown := o.image.captureSelf != o.image || !o.image.captureComplete || o.image.err != nil || o.image.unknown || o.image.managedUnknown.Load()
+	childrenRetired := true
+	for _, birth := range o.image.managedBirths {
+		if !birth.closedForParent(o.image) {
+			childrenRetired = false
+			break
+		}
+	}
+	o.image.mu.Unlock()
+	if sourceUnknown {
+		o.unknown = true
+		if o.storage != nil {
+			o.storage.mu.Lock()
+			o.storage.fence()
+			o.storage.mu.Unlock()
+		}
+		return ErrCreate
+	}
+	if !childrenRetired {
+		return ErrCreate
+	}
+	return c.closeNativeLocked()
+}
+
+// Caller holds original o.mu/n.mu/thread; c has not escaped its constructor.
+func (o *FreshSetupOwner) bindFreshAuthorityTupleStateLocked(ctx context.Context, c *Created) error {
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || !freshBoundedContext(ctx) || o.created != c || c == nil || c.freshAuthority != nil || !c.servingLease || len(c.authorityHandles) == 0 || n.checkPrevious() != nil {
+		return ErrUpgrade
+	}
+	s := &nativeFreshAuthorityTupleState{owner: o, created: c}
+	s.self = s
+	c.freshAuthority = s
+	slot := n.keep(0)
+	e := windows.DuplicateHandle(windows.CurrentProcess(), c.anchor, windows.CurrentProcess(), &slot.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	if runtimeStorageOpenReply(e, slot.handle != 0 && slot.handle != windows.InvalidHandle, func() {}, n.fence) != nil {
+		o.unknown = true
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, true, true, false)
+	actual, ae := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+	if e != nil || ae != nil || id != actual {
+		return ErrUpgrade
+	}
+	s.root = &runtimeStorageObject{resource: slot, identity: id, directory: true, private: true}
+	s.ownerLock, e = runtimeStorageIdentityOf(c.authorityHandles[0], n.sid, false, true, false)
+	if e != nil || s.ownerLock.size != 0 {
+		return ErrUpgrade
+	}
+	s.tls, e = n.openFreshExistingTracked(ctx, slot.handle, "tls", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	s.db, e = n.openFreshExistingTracked(ctx, slot.handle, "db", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	denial, e := o.legacyStartDenialDataLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	s.binding = runtimeFreshTupleBinding{Schema: 1, Transaction: o.intent.Transaction, Intent: runtimeStorageFileData(o.fenceObject, body), Denial: denial, Controller: runtimeStorageObjectData(n.controller), Authority: runtimeStorageObjectData(s.root), TLS: runtimeStorageObjectData(s.tls), ControllerDescriptor: n.controller.identity.descriptor, AuthorityDescriptor: s.root.identity.descriptor, TLSDescriptor: s.tls.identity.descriptor}
+	if !s.binding.valid() || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *nativeFreshAuthorityTupleState) knownLocked(ctx context.Context) bool {
+	if s == nil || s.self != s || s.owner == nil || s.created == nil {
+		return false
+	}
+	o, c := s.owner, s.created
+	n := o.storage
+	if o.self != o || o.created != c || c.freshAuthority != s || !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() || c.closed || c.closeErr != nil || !c.servingLease || c.datastoreActive.Load() || len(c.authorityHandles) == 0 || n.checkPrevious() != nil || n.checkObject(s.root) != nil || n.checkObject(s.tls) != nil || n.checkObject(s.db) != nil {
+		return false
+	}
+	id, e := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+	lock, le := runtimeStorageIdentityOf(c.authorityHandles[0], n.sid, false, true, false)
+	return e == nil && le == nil && id == s.root.identity && lock == s.ownerLock && s.binding.Controller == runtimeStorageObjectData(n.controller) && s.binding.ControllerDescriptor == n.controller.identity.descriptor
+}
+
+// Public source seam: the ordinary/old initialized reader is unchanged. Only
+// original fresh native state enters the tuple producer/recovery lock order.
+func (c *Created) LoadOrResumeDefaultAuthority(ctx context.Context) ([]byte, []byte, []byte, error) {
+	if c == nil {
+		return nil, nil, nil, ErrPublication
+	}
+	if c.freshAuthority == nil {
+		return c.LoadDefaultAuthority(ctx)
+	}
+	if c.freshAuthority.created != c {
+		return nil, nil, nil, ErrPublication
+	}
+	m, e := c.freshAuthority.material(ctx, nil)
+	if e != nil {
+		return nil, nil, nil, e
+	}
+	return m.cert, m.key, m.account, nil
+}
+
+func (s *nativeFreshAuthorityTupleState) create(ctx context.Context, cert, key, account []byte) error {
+	m, e := s.material(ctx, &runtimeFreshTupleMaterial{cert: cert, key: key, account: account})
+	m.clear()
+	return e
+}
+
+// No callback/provider or caller mode can issue authority. The input, when
+// present, is only generated material DATA; actual state owns every effect.
+func (s *nativeFreshAuthorityTupleState) material(ctx context.Context, generated *runtimeFreshTupleMaterial) (result runtimeFreshTupleMaterial, failure error) {
+	if s == nil || s.self != s || s.owner == nil || s.created == nil || !freshBoundedContext(ctx) {
+		return result, ErrPublication
+	}
+	o, c := s.owner, s.created
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	complete := false
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			if o.storage != nil {
+				o.storage.mu.Lock()
+				o.storage.fence()
+				o.storage.mu.Unlock()
+			}
+			failure = ErrPublication
+		}
+		if !complete {
+			result.clear()
+		}
+	}()
+	if o.self != o || o.created != c || c.freshAuthority != s || o.closed || o.unknown || !o.captureComplete || o.storage == nil {
+		return result, ErrPublication
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered {
+		return result, ErrPublication
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.closeErr != nil || !c.servingLease || c.datastoreActive.Load() {
+		return result, ErrPublication
+	}
+	if o.origin == nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil || o.requireFreshNoGuestLocked(ctx) != nil {
+		return result, ErrPublication
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !s.knownLocked(ctx) {
+		return result, ErrPublication
+	}
+	object, e := s.selectTupleLocked(ctx, generated)
+	if e != nil {
+		return result, e
+	}
+	s.tuple = object
+	body, e := n.readFreshRecoverySecretLocked(ctx, object)
+	if e != nil {
+		return result, ErrPublication
+	}
+	defer clear(body)
+	result, e = parseRuntimeFreshAuthorityTuple(body, s.binding)
+	if e != nil {
+		return result, ErrPublication
+	}
+	if generated != nil && (!bytes.Equal(result.cert, generated.cert) || !bytes.Equal(result.key, generated.key) || !bytes.Equal(result.account, generated.account)) {
+		return result, ErrPublication
+	}
+	for i := range 3 {
+		if !s.knownLocked(ctx) {
+			return result, ErrPublication
+		}
+		wanted := [][]byte{result.cert, result.key, result.account}[i]
+		existing, e := reconcileFreshFixedRoleLocked(ctx, runtimeFreshFixedRole(int(runtimeFreshRoleCert)+i), nil, s)
+		if e != nil {
+			return result, ErrPublication
+		}
+		actual, e := n.readFreshRecoverySecretLocked(ctx, existing)
+		same := e == nil && bytes.Equal(actual, wanted)
+		clear(actual)
+		if !same {
+			return result, ErrPublication
+		}
+	}
+	if !s.knownLocked(ctx) || ctx.Err() != nil {
+		return result, ErrPublication
+	}
+	complete = true
+	return result, nil
+}
+
+// Caller holds o->c->n/thread. CREATE-only writer enters SAME n.resources
+// before output, then flush/readback/checked-close/exact-ID immutable reopen.
+func (s *nativeFreshAuthorityTupleState) writeImmutableLocked(ctx context.Context, parent *runtimeStorageObject, name string, data []byte) (*runtimeStorageObject, error) {
+	if !s.knownLocked(ctx) || len(data) == 0 || len(data) > runtimeFreshTupleBudget || (parent != s.root && parent != s.tls) {
+		return nil, ErrPublication
+	}
+	n := s.owner.storage
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent.resource.handle, ObjectName: text, SecurityDescriptor: sd, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&slot.handle, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_CREATE, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if s.owner.fileOutputLocked(slot, e) != nil {
+		return nil, ErrPublication
+	}
+	for at := 0; at < len(data); {
+		if !freshBoundedContext(ctx) {
+			return nil, ErrPublication
+		}
+		count, e := nativeWrite(slot.handle, data[at:])
+		if e != nil || count < 1 || count > len(data)-at {
+			return nil, ErrPublication
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(slot.handle) != nil {
+		return nil, ErrPublication
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	writer := &runtimeStorageObject{resource: slot, identity: id, private: true}
+	actual, e := n.readFreshRecoverySecretLocked(ctx, writer)
+	same := e == nil && bytes.Equal(actual, data)
+	clear(actual)
+	if !same || n.closeTemporary(slot) != nil {
+		return nil, ErrPublication
+	}
+	reader, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || !runtimeStorageCreatedSame(id, reader.identity) {
+		return nil, ErrPublication
+	}
+	actual, e = n.readFreshRecoverySecretLocked(ctx, reader)
+	same = e == nil && bytes.Equal(actual, data)
+	clear(actual)
+	if !same || !freshBoundedContext(ctx) {
+		return nil, ErrPublication
+	}
+	return reader, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_authority_tuple_windows_test.go
