+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+)
+
+func freshPublicationFixture() runtimeFreshAdmission {
+	file := func(low uint32) runtimePublicationFileWitness {
+		return runtimePublicationFileWitness{Object: UpgradeObject{1, 0, low}, Size: 30, Written: 1, Descriptor: [32]byte{1}, Body: [32]byte{2}}
+	}
+	image := [32]byte{9}
+	return runtimeFreshAdmission{Schema: 1, Transaction: strings.Repeat("a", 32), Intent: file(1), LegacyDenial: runtimePublicationFileWitness{Object: UpgradeObject{2, 0, 4}, Size: 100, Written: 2, Descriptor: [32]byte{1}, Body: [32]byte{7}}, Parent: UpgradeObject{2, 0, 1}, Controller: UpgradeObject{2, 0, 2}, Authority: UpgradeObject{1, 0, 2}, AuthorityLock: UpgradeObject{1, 0, 3}, AuthorityLockDescriptor: [32]byte{1}, ParentDescriptor: [32]byte{1}, ControllerDescriptor: [32]byte{1}, Args: file(4), Initialization: file(5), Candidate: UpgradeProcess{PID: 42, Creation: 100, Session: 1, Image: image}, Stage: runtimePublicationFileWitness{Object: UpgradeObject{2, 0, 3}, Size: 30, Written: 2, Descriptor: [32]byte{1}, Body: [32]byte{3}}, Runtime: runtimeIdentityRecord{Endpoint: runtimeIdentityEndpoint, Home: `C:\data\home`, Daemon: "daemon-1", SourceCommit: strings.Repeat("b", 40), BinarySHA: hex.EncodeToString(image[:]), Verified: true}}
+}
+
+func TestRuntimeFreshPublicationClosedRecordsAndNativeBindings(t *testing.T) {
+	a := freshPublicationFixture()
+	if !a.valid() {
+		t.Fatal("complete admission refused")
+	}
+	body, e := runtimeFreshRecordBytes(a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var decoded runtimeFreshAdmission
+	if parseRuntimeFreshRecord(body, &decoded) != nil || decoded != a {
+		t.Fatal("admission roundtrip")
+	}
+	for name, change := range map[string]func(*runtimeFreshAdmission){
+		"missing denial":                       func(a *runtimeFreshAdmission) { a.LegacyDenial = runtimePublicationFileWitness{} },
+		"denial aliases stage":                 func(a *runtimeFreshAdmission) { a.LegacyDenial.Object = a.Stage.Object },
+		"stage aliases controller":             func(a *runtimeFreshAdmission) { a.Stage.Object = a.Controller },
+		"foreign stage volume":                 func(a *runtimeFreshAdmission) { a.Stage.Object.Volume++ },
+		"missing owner lock":                   func(a *runtimeFreshAdmission) { a.AuthorityLock = UpgradeObject{} },
+		"args alias intent":                    func(a *runtimeFreshAdmission) { a.Args.Object = a.Intent.Object },
+		"foreign private file":                 func(a *runtimeFreshAdmission) { a.Initialization.Object.Volume++ },
+		"image differs from actual generation": func(a *runtimeFreshAdmission) { a.Candidate.Image[0]++ },
+		"unverified record":                    func(a *runtimeFreshAdmission) { a.Runtime.Verified = false },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := a
+			change(&bad)
+			if bad.valid() {
+				t.Fatal("unbound admission accepted")
+			}
+		})
+	}
+	for name, bad := range map[string][]byte{
+		"empty": nil, "oversize": bytes.Repeat([]byte("x"), runtimeFreshRecordBudget+1),
+		"duplicate":        bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1),
+		"unknown":          bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"ready":true`), 1),
+		"casefold":         bytes.Replace(body, []byte(`"schema":1`), []byte(`"Schema":1`), 1),
+		"trailing record":  append(append([]byte{}, body...), body...),
+		"extra whitespace": append(append([]byte{}, body...), '\n'),
+		"invalid unicode":  bytes.Replace(body, []byte("daemon-1"), []byte(`\ud800`), 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			var v runtimeFreshAdmission
+			if parseRuntimeFreshRecord(bad, &v) == nil {
+				t.Fatal("noncanonical record accepted")
+			}
+		})
+	}
+	c := runtimeFreshCommitted{Schema: 1, Transaction: a.Transaction, Admission: a.Intent, Target: a.Stage}
+	if !c.matches(a) {
+		t.Fatal("exact stage receipt refused")
+	}
+	for name, change := range map[string]func(*runtimeFreshCommitted){"transaction": func(c *runtimeFreshCommitted) { c.Transaction = strings.Repeat("c", 32) }, "object": func(c *runtimeFreshCommitted) { c.Target.Object.Low++ }, "body": func(c *runtimeFreshCommitted) { c.Target.Body[0]++ }, "descriptor": func(c *runtimeFreshCommitted) { c.Target.Descriptor[0]++ }, "written": func(c *runtimeFreshCommitted) { c.Target.Written++ }} {
+		t.Run(name, func(t *testing.T) {
+			bad := c
+			change(&bad)
+			if bad.matches(a) {
+				t.Fatal("different commit receipt accepted")
+			}
+		})
+	}
+}
+
+func TestRuntimeFreshPublicationControlWitnessesCannotSplitOrChangeOnRecovery(t *testing.T) {
+	a := freshPublicationFixture()
+	ordinary, e := runtimeFreshRecordBytes(a)
+	if e != nil || bytes.Contains(ordinary, []byte(`"ControlRetention"`)) || bytes.Contains(ordinary, []byte(`"ControlBirth"`)) {
+		t.Fatal("ordinary canonical shape changed")
+	}
+	file := func(low uint32) runtimePublicationFileWitness {
+		v := a.Intent
+		v.Object.Low = low
+		return v
+	}
+	a.ControlRetention, a.ControlBirth = file(20), file(21)
+	if !a.valid() {
+		t.Fatal("complete distinct control witnesses refused")
+	}
+	body, e := runtimeFreshRecordBytes(a)
+	var decoded runtimeFreshAdmission
+	if e != nil || parseRuntimeFreshRecord(body, &decoded) != nil || decoded != a {
+		t.Fatal("control witness roundtrip")
+	}
+	for name, change := range map[string]func(*runtimeFreshAdmission){
+		"no retention":       func(a *runtimeFreshAdmission) { a.ControlRetention = runtimePublicationFileWitness{} },
+		"no birth":           func(a *runtimeFreshAdmission) { a.ControlBirth = runtimePublicationFileWitness{} },
+		"aliased records":    func(a *runtimeFreshAdmission) { a.ControlBirth = a.ControlRetention },
+		"foreign record":     func(a *runtimeFreshAdmission) { a.ControlBirth.Object.Volume++ },
+		"aliases authority":  func(a *runtimeFreshAdmission) { a.ControlRetention.Object = a.Authority },
+		"missing descriptor": func(a *runtimeFreshAdmission) { a.ControlBirth.Descriptor = [32]byte{} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := a
+			change(&bad)
+			if bad.valid() {
+				t.Fatal("split/foreign witness accepted")
+			}
+		})
+	}
+	previous := a.Intent
+	recovered := runtimeFreshRecoveryAdmission{Schema: 1, Sequence: 1, Previous: previous, Current: a}
+	recovered.Current.Candidate.PID++
+	if !recovered.matches(a, previous, 1) {
+		t.Fatal("new current generation refused")
+	}
+	for name, change := range map[string]func(*runtimeFreshAdmission){
+		"removed control": func(a *runtimeFreshAdmission) {
+			a.ControlRetention = runtimePublicationFileWitness{}
+			a.ControlBirth = runtimePublicationFileWitness{}
+		},
+		"replaced retention": func(a *runtimeFreshAdmission) { a.ControlRetention.Body[0]++ },
+		"replaced birth":     func(a *runtimeFreshAdmission) { a.ControlBirth.Object.Low++ },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := recovered
+			change(&bad.Current)
+			if bad.matches(a, previous, 1) {
+				t.Fatal("recovery changed original control witnesses")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_publication_windows.go b/rdd/pkg/managementconfig/runtime_fresh_publication_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a14adf0e97b56d2d3d2e1afb0b4637bd836cec52
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_publication_windows.go
@@ -0,0 +1,441 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"runtime"
+	"sync"
+
+	"golang.org/x/sys/windows"
+)
+
+// One concrete fresh caller of the existing native storage publisher. The
+// original FreshOwner publishes this pointer before any stage/record effect.
+type nativeFreshRuntimePublisher struct {
+	mu                 sync.Mutex
+	owner              *FreshSetupOwner
+	observation        *FreshRuntimeObservation
+	prepared           *nativeRuntimePrepared
+	admission          runtimeFreshAdmission
+	admissionObject    *runtimeStorageObject
+	admissionBody      []byte
+	receipt            *nativeFreshCommittedReceipt
+	attempted, unknown bool
+}
+
+type nativeFreshCommittedReceipt struct {
+	owner           *FreshSetupOwner
+	publisher       *nativeFreshRuntimePublisher
+	target          *nativeRuntimeStorageReceipt
+	object          *runtimeStorageObject
+	body            []byte
+	sealAttempted   bool
+	sealErr         error
+	selectionClosed bool // Set only by the actual successful Close below.
+}
+
+func (*nativeFreshRuntimePublisher) String() string { return "retained native fresh publication" }
+func (*nativeFreshCommittedReceipt) String() string { return "retained native fresh commit" }
+
+// PublishFreshRuntime takes no DATA issuer. The actual observer must already
+// be retained by this original owner, from the SAME Created/config publisher.
+// Existing service lifetime is unaffected by caller cancellation after commit.
+func (o *FreshSetupOwner) PublishFreshRuntime(ctx context.Context) (result error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	if o.publication == nil {
+		if o.closed || o.unknown || !o.captureComplete || o.created == nil || o.observation == nil {
+			o.mu.Unlock()
+			return ErrUpgrade
+		}
+		o.publication = &nativeFreshRuntimePublisher{owner: o, observation: o.observation}
+	}
+	p := o.publication
+	o.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if p.owner != o || o.publication != p || o.self != o || o.unknown || o.closed || p.unknown {
+		return ErrUpgrade
+	}
+	if o.sealed != nil && o.sealed == p.receipt && o.sealed.sealedStateLocked(o) {
+		return nil
+	}
+	if p.attempted || p.observation == nil || p.observation != o.observation || o.created == nil {
+		return ErrUpgrade
+	}
+	p.attempted = true
+	defer func() {
+		if recover() != nil {
+			p.unknown = true
+			o.fence()
+			result = ErrUpgrade
+		}
+		if result != nil {
+			p.unknown = true
+			o.fence()
+		}
+	}()
+	return p.publishHeld(ctx)
+}
+
+func (p *nativeFreshRuntimePublisher) checkHeld(ctx context.Context) error {
+	o := p.owner
+	if o == nil || o.self != o || o.publication != p || p.unknown || o.unknown || o.closed || !o.captureComplete || o.created == nil || o.observation != p.observation {
+		return ErrUpgrade
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || !o.knownStorageCloseLocked() || p.observation.checkHeld(ctx, o, o.created, p.observation.publisher) != nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	c := o.created
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.anchor == 0 || !c.servingLease {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || n.check() != nil || n.checkObject(o.fenceObject) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(body)
+	if e != nil || intent != o.intent {
+		return ErrUpgrade
+	}
+	if n.checkFreshSeedIntentLocked(ctx, intent, runtimeStorageFileData(o.fenceObject, body)) != nil || (p.admission.Schema != 0 && p.admission.Seed != intent.Seed) {
+		return ErrUpgrade
+	}
+	if o.checkLegacyStartDenialLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	completion, e := o.legacyStartDenialCompletionDataLocked(ctx)
+	if e != nil || !runtimeFreshDenialCompletionMatchesIntent(intent, completion) || (p.admission.Schema != 0 && p.admission.DenialCompletion != completion) {
+		return ErrUpgrade
+	}
+	retention, birth, e := p.controlWitnessesNativeLocked(ctx)
+	if e != nil || (p.admission.Schema != 0 && (p.admission.ControlRetention != retention || p.admission.ControlBirth != birth)) {
+		return ErrUpgrade
+	}
+	if p.admission.Schema != 0 {
+		denial, e := o.legacyStartDenialDataLocked(ctx)
+		if e != nil || denial != p.admission.LegacyDenial {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+type freshAuthorityFacts struct {
+	authority, lock      UpgradeObject
+	lockDescriptor       [32]byte
+	args, initialization runtimePublicationFileWitness
+}
+
+func (p *nativeFreshRuntimePublisher) captureAuthorityHeld(ctx context.Context) (freshAuthorityFacts, error) {
+	var f freshAuthorityFacts
+	o := p.owner
+	c := o.created
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || c.anchor == 0 || !c.servingLease || len(c.authorityHandles) == 0 {
+		return f, ErrUpgrade
+	}
+	n := o.storage
+	e := func() error {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		id, e := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+		if e != nil {
+			return e
+		}
+		f.authority = UpgradeObject{id.volume, id.high, id.low}
+		lock, e := runtimeStorageIdentityOf(c.authorityHandles[0], n.sid, false, true, false)
+		if e != nil || lock.size != 0 {
+			return ErrUpgrade
+		}
+		f.lock = UpgradeObject{lock.volume, lock.high, lock.low}
+		f.lockDescriptor = lock.descriptor
+		return nil
+	}()
+	if e != nil {
+		return f, ErrUpgrade
+	}
+	args, b, e := o.readFreshFileHeld(ctx, c.anchor, "args.json")
+	if e != nil {
+		return f, ErrUpgrade
+	}
+	init, record, e := o.readFreshFileHeld(ctx, c.anchor, "authority.init")
+	if e != nil || validateInitialization(record, b) != nil {
+		return f, ErrUpgrade
+	}
+	f.args = runtimeStorageFileData(args, b)
+	f.initialization = runtimeStorageFileData(init, record)
+	return f, nil
+}
+
+func (p *nativeFreshRuntimePublisher) publishHeld(ctx context.Context) error {
+	o := p.owner
+	if r := o.storage.freshRecovery; r != nil && r.admission != nil {
+		return p.publishRecoveryHeld(ctx)
+	}
+	if p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	record, e := p.observation.runtimeIdentityHeld(ctx, o, o.created, p.observation.publisher)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if record.BinarySHA != o.intent.Image || record.SourceCommit != o.intent.Commit {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	if r := o.storage.freshRecovery; r != nil && r.layoutLocked() == runtimeFreshRecoveryUnadmittedStage {
+		p.prepared, e = o.storage.resumeUnadmittedPreparedStorage(ctx, record)
+	} else {
+		p.prepared, e = o.storage.prepareStorage(ctx, record)
+	}
+	if e != nil || p.prepared == nil {
+		return ErrUpgrade
+	}
+	// A synchronous preparation can finish after cancellation or alter retained
+	// state. Recheck the original context/graph before any admission effects.
+	if p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	facts, body, e := p.prepared.captureStorageFacts(ctx)
+	if e != nil || facts.Previous != (runtimePublicationFileWitness{}) {
+		return ErrUpgrade
+	}
+	actual, e := parseRuntimeIdentity(body, o.storage.home)
+	if e != nil || actual != record {
+		return ErrUpgrade
+	}
+	authority, e := p.captureAuthorityHeld(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	intentWitness, e := func() (runtimePublicationFileWitness, error) {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		intentBody, e := n.read(o.fenceObject, false)
+		return runtimeStorageFileData(o.fenceObject, intentBody), e
+	}()
+	if e != nil {
+		return ErrUpgrade
+	}
+	denial, e := func() (runtimePublicationFileWitness, error) {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		return o.legacyStartDenialDataLocked(ctx)
+	}()
+	if e != nil {
+		return ErrUpgrade
+	}
+	p.admission = runtimeFreshAdmission{Schema: 1, Transaction: o.intent.Transaction, Intent: intentWitness, LegacyDenial: denial, Parent: facts.Parent, Controller: facts.Controller, Authority: authority.authority, AuthorityLock: authority.lock, AuthorityLockDescriptor: authority.lockDescriptor, ParentDescriptor: facts.ParentDescriptor, ControllerDescriptor: facts.ControllerDescriptor, Args: authority.args, Initialization: authority.initialization, Candidate: o.origin.generation, Stage: facts.Stage, Runtime: record}
+	completion, e := func() (runtimePublicationFileWitness, error) {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		return o.legacyStartDenialCompletionDataLocked(ctx)
+	}()
+	if e != nil || !runtimeFreshDenialCompletionMatchesIntent(o.intent, completion) {
+		return ErrUpgrade
+	}
+	p.admission.DenialCompletion = completion
+	p.admission.Seed = o.intent.Seed
+	controlErr := func() error {
+		o.created.mu.Lock()
+		defer o.created.mu.Unlock()
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		var e error
+		p.admission.ControlRetention, p.admission.ControlBirth, e = p.controlWitnessesNativeLocked(ctx)
+		return e
+	}()
+	if controlErr != nil {
+		return ErrUpgrade
+	}
+	if !p.admission.valid() {
+		return ErrUpgrade
+	}
+	p.admissionBody, e = runtimeFreshRecordBytes(p.admission)
+	if e != nil {
+		return ErrUpgrade
+	}
+	p.admissionObject, e = o.writeFreshRecordHeld(ctx, runtimeFreshAdmissionName, p.admissionBody)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil || o.checkFreshRecordHeld(ctx, p.admissionObject, p.admissionBody) != nil {
+		return ErrUpgrade
+	}
+	facts2, _, e := p.prepared.captureStorageFacts(ctx)
+	if e != nil || facts2 != facts {
+		return ErrUpgrade
+	}
+	authority2, e := p.captureAuthorityHeld(ctx)
+	if e != nil || authority2 != authority {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	p.receipt = &nativeFreshCommittedReceipt{owner: o, publisher: p, sealErr: ErrUpgrade}
+	r := p.receipt
+	r.target, e = p.prepared.commitStorage()
+	if e != nil || r.target == nil || r.target.checkStorage() != nil || p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	if sha256.Sum256(r.target.body) != p.admission.Stage.Body {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	target := runtimeStorageFileData(r.target.target, r.target.body)
+	n.mu.Unlock()
+	committed := runtimeFreshCommitted{Schema: 1, Transaction: o.intent.Transaction, Admission: runtimeStorageFileData(p.admissionObject, p.admissionBody), Target: target}
+	if !committed.matches(p.admission) {
+		return ErrUpgrade
+	}
+	r.body, e = runtimeFreshRecordBytes(committed)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r.object, e = o.writeFreshRecordHeld(ctx, runtimeFreshCommittedName, r.body)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil || r.target.checkStorage() != nil || o.checkFreshRecordHeld(ctx, r.object, r.body) != nil || o.checkFreshRecordHeld(ctx, p.admissionObject, p.admissionBody) != nil {
+		return ErrUpgrade
+	}
+	return r.sealHeld(ctx, o)
+}
+
+// Only owner.mu held. Native caches and this exact concrete receipt, never a
+// caller Boolean or decoded record, establish completed controller release.
+func (r *nativeFreshCommittedReceipt) sealedStateLocked(o *FreshSetupOwner) bool {
+	if r == nil || r.owner != o || o.sealed != r || r.publisher == nil || o.publication != r.publisher || r.publisher.receipt != r || r.publisher.owner != o || !r.sealAttempted || r.sealErr != nil || !r.selectionClosed || o.storage == nil || o.origin == nil || r.target == nil || r.target.owner != o.storage || r.object == nil || len(r.body) == 0 {
+		return false
+	}
+	w := o.observation
+	if w == nil || r.publisher.observation != w || w.owner != o || w.self != w {
+		return false
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if !w.closed || w.unknown || !w.closeAttempt.attempted || w.closeAttempt.closeErr != nil {
+		return false
+	}
+	for _, slot := range w.resources {
+		if slot == nil || !slot.attempted || slot.closeErr != nil || slot.handle != 0 {
+			return false
+		}
+	}
+	for _, key := range w.keys {
+		if key == nil || !key.attempted || key.closeErr != nil || key.handle != 0 {
+			return false
+		}
+	}
+	o.origin.mu.Lock()
+	defer o.origin.mu.Unlock()
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtimeStorageDomain.Lock()
+	defer runtimeStorageDomain.Unlock()
+	if runtimeStorageDomain.failed || runtimeStorageDomain.owners[n] || n.unknown || !n.closeAttempted || n.closeErr != nil || o.origin.unknown || !o.origin.closed || !o.origin.closeAttempt.attempted || o.origin.closeAttempt.closeErr != nil {
+		return false
+	}
+	for _, slot := range append(append([]*runtimeStorageResource{}, n.resources...), o.origin.resources...) {
+		if slot == nil || !slot.attempted || slot.closeErr != nil || slot.handle != 0 {
+			return false
+		}
+	}
+	for _, key := range o.keys {
+		if key == nil || !key.attempted || key.closeErr != nil || key.handle != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *nativeFreshCommittedReceipt) sealHeld(ctx context.Context, o *FreshSetupOwner) error {
+	if r == nil || r.owner != o || r.publisher == nil || o.publication != r.publisher || r.publisher.receipt != r || r.sealAttempted {
+		return ErrUpgrade
+	}
+	r.sealAttempted = true
+	r.sealErr = ErrUpgrade
+	if r.publisher.checkHeld(ctx) != nil || r.target == nil || r.target.checkStorage() != nil || o.checkFreshRecordHeld(ctx, r.object, r.body) != nil {
+		return ErrUpgrade
+	}
+	if o.captureManagedNamespaceBeforeSealLocked(ctx) != nil || closeFreshRuntimeObservationLocked(o) != nil || o.origin.Close() != nil {
+		return ErrUpgrade
+	}
+	for i := len(o.keys) - 1; i >= 0; i-- {
+		key := o.keys[i]
+		if key.run(func() error {
+			if windows.RegCloseKey(key.handle) != nil {
+				return ErrUpgrade
+			}
+			key.handle = 0
+			return nil
+		}, o.fence) != nil {
+			return ErrUpgrade
+		}
+	}
+	if o.selection == nil || o.selection.Close() != nil {
+		return ErrUpgrade
+	}
+	r.selectionClosed = true
+	if o.storage.Close() != nil {
+		return ErrUpgrade
+	}
+	r.sealErr = nil
+	o.sealed = r
+	if !r.sealedStateLocked(o) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Owner cleanup calls this under owner.mu after actual service retirement.
+// Unknown/active publication never invents a second cleanup or retries effects.
+func closeFreshRuntimePublicationLocked(o *FreshSetupOwner) error {
+	if o.publication == nil {
+		return nil
+	}
+	p := o.publication
+	if p.owner != o || p.unknown {
+		return ErrUpgrade
+	}
+	if o.sealed != nil && o.sealed == p.receipt && o.sealed.sealedStateLocked(o) {
+		return nil
+	}
+	return ErrUpgrade
+}
