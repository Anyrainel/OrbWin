--- /dev/null
+++ b/rdd/pkg/service/cmd/private_close_result.go
@@ -0,0 +1,19 @@
+package service
+
+import (
+	"errors"
+	"io"
+)
+
+// Settlement only. The actual caller owns the native authority and original
+// join order. This helper cannot issue retirement, exit or incoming permission.
+func settlePrivateAuthorityClose(owner io.Closer, primary error) error {
+	if owner == nil {
+		return primary
+	}
+	closeErr := owner.Close()
+	if closeErr == nil {
+		return primary
+	}
+	return errors.Join(primary, closeErr)
+}
