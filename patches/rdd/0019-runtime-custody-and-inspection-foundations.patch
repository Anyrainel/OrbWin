+func (w *FreshRuntimeObservation) exactLocked(o *FreshSetupOwner, c *Created, p *ConfigPublisher) bool {
+	if w == nil || w.self != w || o == nil || o.self != o || o.observation != w || w.owner != o || w.created != c || c == nil || o.created != c || w.publisher != p || p == nil {
+		return false
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	return registered
+}
