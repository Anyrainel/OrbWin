+func TestRuntimeFreshGuestPreflightDistinctAbsenceAndOwnedPresence(t *testing.T) {
+	for bits := 0; bits < 8; bits++ {
+		want := runtimeFreshGuestUnknown
+		if bits == 0 {
+			want = runtimeFreshGuestAbsent
+		}
+		if bits == 7 {
+			want = runtimeFreshGuestRegistered
+		}
+		if classifyRuntimeFreshGuest(bits&1 != 0, bits&2 != 0, bits&4 != 0) != want {
+			t.Fatal("partial guest/registration became owned ready or absence")
+		}
+	}
+	home := `C:\Users\owner\AppData\Local\OrbWinData\home`
+	base := home + `\.rdorbwin\lima\orbwin`
+	if !runtimeFreshGuestRegistrationMatches("LIMA-OrbWin", base, home, 2) {
+		t.Fatal("exact selected native registration refused")
+	}
+	for _, bad := range []struct {
+		name, base string
+		version    uint32
+	}{{"lima-orbwin", `C:\foreign`, 2}, {"lima-orbwin", base, 1}, {"lima-orbwin", base, 0}, {"rancher-desktop", base, 2}, {"lima-orbwin", home + `\.rdorbwin\lima\other`, 2}} {
+		if runtimeFreshGuestRegistrationMatches(bad.name, bad.base, home, bad.version) {
+			t.Fatal("foreign/version-changed registration accepted")
