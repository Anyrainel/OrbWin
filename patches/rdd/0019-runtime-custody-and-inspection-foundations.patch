+	for _, h := range []uintptr{0, ^uintptr(0), ^uintptr(1), ^uintptr(3), ^uintptr(4), ^uintptr(5)} {
+		if runtimeStorageClassifyTokenOpen(1, h, 0, true) != runtimeStorageNativeOpenUnknown {
