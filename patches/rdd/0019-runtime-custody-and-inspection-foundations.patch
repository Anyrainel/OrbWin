@@ -0,0 +1,167 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+
+	"golang.org/x/sys/windows"
+)
+
+// Caller holds actual o->n/thread. No private record body is an issuer: every
+// expected field below is derived again from original held current objects.
+func (s *nativeFreshControlRecovery) prepareRetentionLocked(ctx context.Context, args []byte) error {
+	if s == nil || !s.complete || s.retainedObject != nil || s.checkPrefixLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	r := s.recovery
+	o := r.owner
+	n := o.storage
+	if !r.complete || !o.captureComplete || o.created != nil || s.requireRetainedAbsentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	firstMissing := uint32(runtimeFreshControlSlots)
+	var chosen *runtimeStorageObject
+	var chosenBody []byte
+	var chosenRecord runtimeFreshControlRetention
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlRecordName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if firstMissing == runtimeFreshControlSlots {
+				firstMissing = ordinal
+			}
+			continue
+		}
+		if e != nil || firstMissing != runtimeFreshControlSlots || chosen != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		record, e := s.retentionLocked(ctx, args, ordinal)
+		if e != nil {
+			return ErrUpgrade
+		}
+		wanted, e := runtimeFreshRecordBytes(record)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if bytes.Equal(body, wanted) {
+			chosen, chosenBody, chosenRecord = object, append([]byte(nil), body...), record
+			continue
+		}
+		// A partial recipe has had no dependent effect: actual retained name is
+		// absent and exact old source prefix remains at canonical. Preserve this
+		// fixed immutable slot; only an exact prefix of CURRENT bound recipe can
+		// advance to the next bounded slot. Corrupt/stale/mixed bodies refuse.
+		if !runtimeFreshControlPrefixBytes(body, wanted) {
+			return ErrUpgrade
+		}
+	}
+	if chosen != nil {
+		s.recordObject, s.recordBody, s.record = chosen, chosenBody, chosenRecord
+		return s.checkRetentionRecordLocked(ctx)
+	}
+	if firstMissing >= runtimeFreshControlSlots {
+		return ErrUpgrade
+	}
+	record, e := s.retentionLocked(ctx, args, firstMissing)
+	if e != nil {
+		return ErrUpgrade
+	}
+	body, e := runtimeFreshRecordBytes(record)
+	if e != nil {
+		return ErrUpgrade
+	}
+	name, _ := runtimeFreshControlRecordName(firstMissing)
+	object, e := o.writeFreshRecordNativeLocked(ctx, name, body)
+	if e != nil {
+		return ErrUpgrade
+	}
+	s.recordObject, s.recordBody, s.record = object, append([]byte(nil), body...), record
+	return s.checkRetentionRecordLocked(ctx)
+}
+
+func (s *nativeFreshControlRecovery) checkRetentionRecordLocked(ctx context.Context) error {
+	if s == nil || s.recordObject == nil || !s.record.valid() || !s.complete || s.checkOldGraphLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	n := s.recovery.owner.storage
+	actual, e := s.retentionMetadataLocked(ctx, s.record.Args, s.record.Ordinal)
+	if e != nil {
+		return ErrUpgrade
+	}
+	wanted, e := runtimeFreshRecordBytes(actual)
+	if e != nil || !bytes.Equal(wanted, s.recordBody) || n.checkObject(s.recordObject) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(s.recordObject, false)
+	if e != nil || !bytes.Equal(body, s.recordBody) || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *nativeFreshControlRecovery) requireRetainedAbsentLocked(ctx context.Context) error {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.recovery.owner.storage == nil || s.parent == nil {
+		return ErrUpgrade
+	}
+	name, e := runtimeFreshControlRetainedName(s.recovery.owner.intent.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	n := s.recovery.owner.storage
+	if !s.recovery.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) {
+		return ErrUpgrade
+	}
+	object, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, name, true, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// The durable bound recipe must exist before this one no-replacement rename.
+// Keep SAME setup.lock and actual old ownerlock live. A rename error is unknown
+// effect: fence before any requery/close, preserve all original objects/bytes.
+func (s *nativeFreshControlRecovery) retainOldControlLocked(ctx context.Context) error {
+	if s == nil || s.retainedObject != nil || s.checkPrefixLocked(ctx) != nil || s.checkRetentionRecordLocked(ctx) != nil || s.requireRetainedAbsentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o := s.recovery.owner
+	n := o.storage
+	name, e := runtimeFreshControlRetainedName(o.intent.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if s.oldRoot.identity.volume != s.parent.identity.volume || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	if renameUpgradeChild(s.oldRoot.resource.handle, s.parent.resource.handle, name) != nil {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	retained, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, name, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != nil || retained.identity != s.oldRoot.identity {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	s.retainedObject = retained
+	if s.checkRetentionRecordLocked(ctx) != nil {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	canonical, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, anchorName, true, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || canonical != nil || !freshBoundedContext(ctx) {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
