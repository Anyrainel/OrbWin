--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_environment_test.go
@@ -0,0 +1,30 @@
+package managementconfig
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestRuntimeFreshEnvironmentClosesInheritedSelectors(t *testing.T) {
+	for _, name := range []string{"home", "UserProfile", "kubeconfig", "LIMA_HOME", "lima_ssh_port_forwarder", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_TLS_VERIFY", "Docker_Cert_Path", "DOCKER_CONFIG", "DOCKER_API_VERSION", "BUILDKIT_HOST", "BUILDX_BUILDER", "BUILDX_CONFIG", "RDD_LOG_DIR", "RDD_DEVELOPER_MODE", "RDD_TRACE_PACKETS", "RDD_KEEP_LOGS", "ORBWIN_UPGRADE_PERMIT", "CONTAINERD_ADDRESS", "NERDCTL_NAMESPACE", "KUBERNETES_MASTER", "WSLENV", "WSL_DISTRO_NAME"} {
+		if !runtimeFreshEnvironmentSelector(name) {
+			t.Fatalf("inherited selector survived: %s", name)
+		}
+	}
+	for _, name := range []string{"PATH", "SystemRoot", "TEMP", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "GOMAXPROCS"} {
+		if runtimeFreshEnvironmentSelector(name) {
+			t.Fatalf("unrelated OS/network metadata selected: %s", name)
+		}
+	}
+	home := filepath.Join("native", "selected", "home")
+	m := map[string]string{}
+	for _, entry := range runtimeFreshFixedEnvironment(home) {
+		if _, found := m[entry[0]]; found {
+			t.Fatal("duplicate fixed projection")
+		}
+		m[entry[0]] = entry[1]
+	}
+	if m["HOME"] != home || m["USERPROFILE"] != home || m["RDD_INSTANCE"] != "orbwin" || m["LIMA_HOME"] != filepath.Join(home, ".rdorbwin", "lima") || m["DOCKER_HOST"] != runtimeIdentityEndpoint || m["RDD_DEVELOPER_MODE"] != "0" {
+		t.Fatal("projection not fixed to selected native home")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_fixed_role.go b/rdd/pkg/managementconfig/runtime_fresh_fixed_role.go
new file mode 100644
index 0000000000000000000000000000000000000000..86d786955e15a8b73cfbfe30540bfe2829fed72c
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_fixed_role.go
@@ -0,0 +1,109 @@
+package managementconfig
+
+import "fmt"
+
+type runtimeFreshFixedRole uint8
+
+const (
+	runtimeFreshRoleArgs runtimeFreshFixedRole = iota + 1
+	runtimeFreshRoleInit
+	runtimeFreshRoleCert
+	runtimeFreshRoleKey
+	runtimeFreshRoleAccount
+)
+const runtimeFreshRoleSlots = 16
+
+func (r runtimeFreshFixedRole) name() string {
+	switch r {
+	case runtimeFreshRoleArgs:
+		return "args.json"
+	case runtimeFreshRoleInit:
+		return "authority.init"
+	case runtimeFreshRoleCert:
+		return "apiserver.crt"
+	case runtimeFreshRoleKey:
+		return "apiserver.key"
+	case runtimeFreshRoleAccount:
+		return "sa.key"
+	}
+	return ""
+}
+func (r runtimeFreshFixedRole) isTuple() bool {
+	return r >= runtimeFreshRoleCert && r <= runtimeFreshRoleAccount
+}
+func runtimeFreshRoleRecipeName(parent UpgradeObject, role runtimeFreshFixedRole, ordinal uint32) (string, error) {
+	if !parent.valid() || role.name() == "" || ordinal >= runtimeFreshRoleSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.role.%08x-%08x-%08x.%d.%04d", parent.Volume, parent.High, parent.Low, role, ordinal), nil
+}
+func runtimeFreshRoleArchiveName(role runtimeFreshFixedRole, ordinal uint32) (string, error) {
+	if role.name() == "" || ordinal >= runtimeFreshRoleSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("%s.partial.%04d", role.name(), ordinal), nil
+}
+
+// DATA only. Actual source state and native FILE_OPEN objects are mandatory;
+// neither an old ID nor a body prefix alone authorizes archive or CREATE.
+type runtimeFreshRoleRetention struct {
+	Schema                                 int
+	Transaction                            string
+	Role                                   runtimeFreshFixedRole
+	Ordinal                                uint32
+	Parent, Controller                     UpgradeObject
+	ParentDescriptor, ControllerDescriptor [32]byte
+	Plan, SourcePlan                       runtimePublicationFileWitness
+	Old                                    runtimePublicationFileWitness
+	DesiredSize                            uint64
+	Desired                                [32]byte
+}
+
+func freshRoleWitnessValid(w runtimePublicationFileWitness, empty bool) bool {
+	return w.Object.valid() && (empty || w.Size > 0) && w.Size <= runtimeFreshTupleBudget && w.Descriptor != [32]byte{} && w.Body != [32]byte{}
+}
+func (r runtimeFreshRoleRetention) valid() bool {
+	if r.Schema != 1 || !upgradeHex(r.Transaction, 32) || r.Role.name() == "" || r.Ordinal >= runtimeFreshRoleSlots || !r.Parent.valid() || !r.Controller.valid() || r.ParentDescriptor == [32]byte{} || r.ControllerDescriptor == [32]byte{} || !freshRoleWitnessValid(r.Plan, false) || !freshRoleWitnessValid(r.Old, true) || r.DesiredSize == 0 || r.DesiredSize > runtimeFreshTupleBudget || r.Desired == [32]byte{} || r.Old.Size >= r.DesiredSize || r.Old.Object == r.Parent || r.Old.Object.Volume != r.Parent.Volume {
+		return false
+	}
+	if r.Role.isTuple() {
+		return r.SourcePlan == (runtimePublicationFileWitness{})
+	}
+	return freshRoleWitnessValid(r.SourcePlan, false)
+}
+
+type runtimeFreshRoleCut uint8
+
+const (
+	runtimeFreshRoleInvalid runtimeFreshRoleCut = iota
+	runtimeFreshRoleBeforeArchive
+	runtimeFreshRoleBeforeCreate
+	runtimeFreshRoleNewPrefix
+	runtimeFreshRoleComplete
+)
+
+func classifyRuntimeFreshRoleCut(old, canonical, archive UpgradeObject, canonicalComplete, canonicalPrefix bool) runtimeFreshRoleCut {
+	zero := UpgradeObject{}
+	if !old.valid() {
+		return runtimeFreshRoleInvalid
+	}
+	if canonical == old && archive == zero && !canonicalComplete && canonicalPrefix {
+		return runtimeFreshRoleBeforeArchive
+	}
+	if archive != old {
+		return runtimeFreshRoleInvalid
+	}
+	if canonical == zero {
+		return runtimeFreshRoleBeforeCreate
+	}
+	if !canonical.valid() || canonical == old {
+		return runtimeFreshRoleInvalid
+	}
+	if canonicalComplete {
+		return runtimeFreshRoleComplete
+	}
+	if canonicalPrefix {
+		return runtimeFreshRoleNewPrefix
+	}
+	return runtimeFreshRoleInvalid
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_fixed_role_retention_windows.go b/rdd/pkg/managementconfig/runtime_fresh_fixed_role_retention_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b71cec017104c4e5f09b8d7cfb9ce11572a6a6fb
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_fixed_role_retention_windows.go
@@ -0,0 +1,438 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// One fixed filesystem protocol, owned by exactly one real control/tuple state.
+// Caller holds its original owner -> (actual exposed Created) -> n and thread.
+// No callbacks, external handles, expected bodies or metadata booleans enter it.
+type freshRoleRecipeSlot struct {
+	ordinal uint32
+	object  *runtimeStorageObject
+	body    []byte
+	record  *runtimeFreshRoleRetention
+}
+
+func reconcileFreshFixedRoleLocked(ctx context.Context, role runtimeFreshFixedRole, control *nativeFreshControlRecovery, tuple *nativeFreshAuthorityTupleState) (result *runtimeStorageObject, failure error) {
+	if (control == nil) == (tuple == nil) || !freshBoundedContext(ctx) || role.name() == "" {
+		return nil, ErrUpgrade
+	}
+	var o *FreshSetupOwner
+	if control != nil {
+		if control.self != control || control.recovery == nil {
+			return nil, ErrUpgrade
+		}
+		o = control.recovery.owner
+	} else {
+		if tuple.self != tuple {
+			return nil, ErrUpgrade
+		}
+		o = tuple.owner
+	}
+	if o == nil || o.self != o || o.storage == nil {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	var slots []freshRoleRecipeSlot
+	defer func() {
+		for _, s := range slots {
+			clear(s.body)
+		}
+		if recover() != nil {
+			o.unknown = true
+			n.fence()
+			result = nil
+			failure = ErrUpgrade
+		}
+	}()
+	in, e := deriveFreshFixedRoleLocked(ctx, role, control, tuple)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	defer clear(in.desired)
+	plan, e := freshFixedRolePlanWitnessLocked(ctx, n, in.plan)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	source := runtimePublicationFileWitness{}
+	if in.sourcePlan != nil {
+		source, e = freshFixedRolePlanWitnessLocked(ctx, n, in.sourcePlan)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	base := runtimeFreshRoleRetention{Schema: 1, Transaction: in.transaction, Role: role, Parent: runtimeStorageObjectData(in.parent), Controller: runtimeStorageObjectData(n.controller), ParentDescriptor: in.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor, Plan: plan, SourcePlan: source, DesiredSize: uint64(len(in.desired)), Desired: sha256.Sum256(in.desired)}
+	gap := false
+	for ordinal := uint32(0); ordinal < runtimeFreshRoleSlots; ordinal++ {
+		name, _ := runtimeFreshRoleRecipeName(base.Parent, role, ordinal)
+		object, e := n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap {
+			return nil, ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		slot := freshRoleRecipeSlot{ordinal: ordinal, object: object, body: body}
+		var record runtimeFreshRoleRetention
+		if parseRuntimeFreshRecord(body, &record) == nil && record.valid() {
+			canonical, e := runtimeFreshRecordBytes(record)
+			if e != nil || !bytes.Equal(body, canonical) || record.Ordinal != ordinal {
+				return nil, ErrUpgrade
+			}
+			expected := base
+			expected.Ordinal = ordinal
+			expected.Old = record.Old
+			wanted, e := runtimeFreshRecordBytes(expected)
+			if e != nil || !bytes.Equal(wanted, body) {
+				return nil, ErrUpgrade
+			}
+			slot.record = &record
+		}
+		slots = append(slots, slot)
+	}
+	var trailing []freshRoleRecipeSlot
+	for i, slot := range slots {
+		if slot.record == nil {
+			var following *runtimeFreshRoleRetention
+			for _, later := range slots[i+1:] {
+				if later.record != nil {
+					following = later.record
+					break
+				}
+			}
+			if following == nil {
+				trailing = append(trailing, slot)
+				continue
+			}
+			expected := base
+			expected.Ordinal = slot.ordinal
+			expected.Old = following.Old
+			body, e := runtimeFreshRecordBytes(expected)
+			if e != nil || !runtimeFreshControlPrefixBytes(slot.body, body) || freshRoleArchiveAbsentLocked(ctx, in, slot.ordinal) != nil {
+				return nil, ErrUpgrade
+			}
+			continue
+		}
+		record := *slot.record
+		archiveName, _ := runtimeFreshRoleArchiveName(role, slot.ordinal)
+		archive, ae := n.openFreshExistingTracked(ctx, in.parent.resource.handle, archiveName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+		if ae != nil && ae != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return nil, ErrUpgrade
+		}
+		current, ce := n.openFreshExistingTracked(ctx, in.parent.resource.handle, role.name(), false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+		if ce != nil && ce != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return nil, ErrUpgrade
+		}
+		renamedHere := false
+		if archive == nil {
+			if i != len(slots)-1 {
+				return nil, ErrUpgrade
+			}
+			if current == nil {
+				return nil, ErrUpgrade
+			}
+			body, e := freshFixedRoleBodyLocked(ctx, n, current)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			same := runtimeStorageFileData(current, body) == record.Old && classifyRuntimeFreshRoleCut(record.Old.Object, runtimeStorageObjectData(current), UpgradeObject{}, bytes.Equal(body, in.desired), runtimeFreshControlPrefixBytes(body, in.desired)) == runtimeFreshRoleBeforeArchive
+			clear(body)
+			if !same {
+				return nil, ErrUpgrade
+			}
+			old, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, role.name(), false, windows.FILE_READ_DATA|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			body, e = freshFixedRoleBodyLocked(ctx, n, old)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			same = runtimeStorageFileData(old, body) == record.Old
+			clear(body)
+			if !same || recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+				return nil, ErrUpgrade
+			}
+			if renameUpgradeChild(old.resource.handle, in.parent.resource.handle, archiveName) != nil {
+				o.unknown = true
+				n.fence()
+				return nil, ErrUpgrade
+			}
+			archive = old
+			renamedHere = true
+		} else {
+			body, e := freshFixedRoleBodyLocked(ctx, n, archive)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			same := runtimeStorageFileData(archive, body) == record.Old && runtimeFreshControlPrefixBytes(body, in.desired)
+			clear(body)
+			if !same {
+				return nil, ErrUpgrade
+			}
+			currentID := UpgradeObject{}
+			complete, prefix := false, false
+			if current != nil {
+				currentID = runtimeStorageObjectData(current)
+				body, e := freshFixedRoleBodyLocked(ctx, n, current)
+				if e != nil {
+					return nil, ErrUpgrade
+				}
+				complete, prefix = bytes.Equal(body, in.desired), runtimeFreshControlPrefixBytes(body, in.desired)
+				clear(body)
+			}
+			if classifyRuntimeFreshRoleCut(record.Old.Object, currentID, runtimeStorageObjectData(archive), complete, prefix) == runtimeFreshRoleInvalid {
+				return nil, ErrUpgrade
+			}
+		}
+		if _, e := freshRoleAtNameLocked(ctx, in, archiveName, record.Old); e != nil {
+			if renamedHere {
+				o.unknown = true
+				n.fence()
+			}
+			return nil, ErrUpgrade
+		}
+	}
+	return finishFreshFixedRoleLocked(ctx, in, base, uint32(len(slots)), trailing, control, tuple)
+}
+
+func freshRoleArchiveAbsentLocked(ctx context.Context, in freshFixedRoleInputs, ordinal uint32) error {
+	name, e := runtimeFreshRoleArchiveName(in.role, ordinal)
+	if e != nil {
+		return ErrUpgrade
+	}
+	object, e := in.storage.openFreshExistingTracked(ctx, in.parent.resource.handle, name, false, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func finishFreshFixedRoleLocked(ctx context.Context, in freshFixedRoleInputs, base runtimeFreshRoleRetention, next uint32, trailing []freshRoleRecipeSlot, control *nativeFreshControlRecovery, tuple *nativeFreshAuthorityTupleState) (*runtimeStorageObject, error) {
+	o, n := in.owner, in.storage
+	current, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, in.role.name(), false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		if len(trailing) != 0 || recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+			return nil, ErrUpgrade
+		}
+		return writeFreshFixedRoleLocked(ctx, in, control, tuple)
+	}
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	body, e := freshFixedRoleBodyLocked(ctx, n, current)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	defer clear(body)
+	if bytes.Equal(body, in.desired) {
+		if len(trailing) != 0 {
+			return nil, ErrUpgrade
+		}
+		// Pin the completed role against replacement for the owning controller scope.
+		reader, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, in.role.name(), false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e != nil || reader.identity != current.identity || !freshBoundedContext(ctx) {
+			return nil, ErrUpgrade
+		}
+		return reader, nil
+	}
+	if len(body) >= len(in.desired) || !runtimeFreshControlPrefixBytes(body, in.desired) || next >= runtimeFreshRoleSlots {
+		return nil, ErrUpgrade
+	}
+	old := runtimeStorageFileData(current, body)
+	for _, partial := range trailing {
+		expected := base
+		expected.Ordinal = partial.ordinal
+		expected.Old = old
+		wanted, e := runtimeFreshRecordBytes(expected)
+		if e != nil || !runtimeFreshControlPrefixBytes(partial.body, wanted) || freshRoleArchiveAbsentLocked(ctx, in, partial.ordinal) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	record := base
+	record.Ordinal = next
+	record.Old = old
+	if !record.valid() || freshRoleArchiveAbsentLocked(ctx, in, next) != nil || recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+		return nil, ErrUpgrade
+	}
+	encoded, e := runtimeFreshRecordBytes(record)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	name, _ := runtimeFreshRoleRecipeName(base.Parent, in.role, next)
+	recipe, e := o.writeFreshRecordNativeLocked(ctx, name, encoded)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	actual, e := n.read(recipe, false)
+	if e != nil || !bytes.Equal(actual, encoded) {
+		return nil, ErrUpgrade
+	}
+	target, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, in.role.name(), false, windows.FILE_READ_DATA|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	check, e := freshFixedRoleBodyLocked(ctx, n, target)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	same := runtimeStorageFileData(target, check) == old
+	clear(check)
+	if !same || recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+		return nil, ErrUpgrade
+	}
+	archiveName, _ := runtimeFreshRoleArchiveName(in.role, next)
+	if renameUpgradeChild(target.resource.handle, in.parent.resource.handle, archiveName) != nil {
+		o.unknown = true
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	if _, e := freshRoleAtNameLocked(ctx, in, archiveName, old); e != nil {
+		o.unknown = true
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	absent, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, in.role.name(), false, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || absent != nil || recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+		o.unknown = true
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	return writeFreshFixedRoleLocked(ctx, in, control, tuple)
+}
+
+func freshKnownForRoleClose(in freshFixedRoleInputs) bool {
+	return in.owner != nil && !in.owner.unknown && in.storage != nil && !in.storage.unknown && runtimeStorageDomainKnown()
+}
+func freshFixedRoleBodyLocked(ctx context.Context, n *nativeRuntimeStorage, object *runtimeStorageObject) ([]byte, error) {
+	if object == nil || !freshBoundedContext(ctx) || n.checkObject(object) != nil {
+		return nil, ErrUpgrade
+	}
+	if object.identity.size == 0 {
+		return []byte{}, nil
+	}
+	return n.readFreshRecoverySecretLocked(ctx, object)
+}
+func freshFixedRolePlanWitnessLocked(ctx context.Context, n *nativeRuntimeStorage, object *runtimeStorageObject) (runtimePublicationFileWitness, error) {
+	body, e := freshFixedRoleBodyLocked(ctx, n, object)
+	if e != nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	defer clear(body)
+	w := runtimeStorageFileData(object, body)
+	if !freshRoleWitnessValid(w, false) {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	return w, nil
+}
+
+func recheckFreshRoleCallerLocked(ctx context.Context, expected freshFixedRoleInputs, control *nativeFreshControlRecovery, tuple *nativeFreshAuthorityTupleState) error {
+	actual, e := deriveFreshFixedRoleLocked(ctx, expected.role, control, tuple)
+	if e != nil {
+		return ErrUpgrade
+	}
+	defer clear(actual.desired)
+	if actual.owner != expected.owner || actual.storage != expected.storage || actual.parent != expected.parent || actual.plan != expected.plan || actual.sourcePlan != expected.sourcePlan || actual.transaction != expected.transaction || !bytes.Equal(actual.desired, expected.desired) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func freshRoleAtNameLocked(ctx context.Context, in freshFixedRoleInputs, name string, expected runtimePublicationFileWitness) (*runtimeStorageObject, error) {
+	actual, e := in.storage.openFreshExistingTracked(ctx, in.parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	body, e := freshFixedRoleBodyLocked(ctx, in.storage, actual)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	defer clear(body)
+	if runtimeStorageFileData(actual, body) != expected || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return actual, nil
+}
+
+// Positive CREATE uses the SAME controller store and preregistered output, then
+// flush/readback/checked-close/exact-ID immutable reopen. Parent and bytes were
+// derived from the actual original protected plan, never caller assertions.
+func writeFreshFixedRoleLocked(ctx context.Context, in freshFixedRoleInputs, control *nativeFreshControlRecovery, tuple *nativeFreshAuthorityTupleState) (*runtimeStorageObject, error) {
+	if recheckFreshRoleCallerLocked(ctx, in, control, tuple) != nil {
+		return nil, ErrUpgrade
+	}
+	o, n := in.owner, in.storage
+	if !o.nativeOutputsAdmittedLocked() || !freshBoundedContext(ctx) || n.checkObject(in.parent) != nil {
+		return nil, ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	name, e := windows.NewNTUnicodeString(in.role.name())
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: in.parent.resource.handle, ObjectName: name, SecurityDescriptor: sd, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&slot.handle, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_CREATE, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if o.fileOutputLocked(slot, e) != nil {
+		return nil, ErrUpgrade
+	}
+	for at := 0; at < len(in.desired); {
+		if !freshBoundedContext(ctx) {
+			return nil, ErrUpgrade
+		}
+		count, e := nativeWrite(slot.handle, in.desired[at:])
+		if e != nil || count < 1 || count > len(in.desired)-at {
+			return nil, ErrUpgrade
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(slot.handle) != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	writer := &runtimeStorageObject{resource: slot, identity: id, private: true}
+	body, e := freshFixedRoleBodyLocked(ctx, n, writer)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	same := bytes.Equal(body, in.desired)
+	clear(body)
+	if !same || !freshKnownForRoleClose(in) || n.closeTemporary(slot) != nil {
+		return nil, ErrUpgrade
+	}
+	reader, e := n.openFreshExistingTracked(ctx, in.parent.resource.handle, in.role.name(), false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || !runtimeStorageCreatedSame(reader.identity, id) {
+		return nil, ErrUpgrade
+	}
+	body, e = freshFixedRoleBodyLocked(ctx, n, reader)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	same = bytes.Equal(body, in.desired)
+	clear(body)
+	if !same || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return reader, nil
+}
