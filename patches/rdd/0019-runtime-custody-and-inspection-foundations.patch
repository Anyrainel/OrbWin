diff --git a/rdd/pkg/managementconfig/runtime_fresh_process_windows.go b/rdd/pkg/managementconfig/runtime_fresh_process_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..00e904dc9e06edb4a7960adacb5310cd5c101810
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_process_windows.go
@@ -0,0 +1,49 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var freshIsProcessInJob = windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob")
+
+// requireFreshPersistentProcess observes only this running process. Console
+// grouping cannot establish independence from an inherited kill-on-close job.
+// Run this before selection/storage/fresh namespace effects; outside-job DATA
+// does not construct a native owner or authorize any subsequent effect.
+func requireFreshPersistentProcess(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	deadline, bounded := ctx.Deadline()
+	if !bounded || !time.Now().Before(deadline) {
+		return ErrUpgrade
+	}
+	// A successful API call must overwrite this noncanonical sentinel. No
+	// caller supplies a process/job handle, membership claim or query callback.
+	member := uint32(2)
+	result, _, _ := freshIsProcessInJob.Call(
+		uintptr(windows.CurrentProcess()), 0, uintptr(unsafe.Pointer(&member)),
+	)
+	runtime.KeepAlive(&member)
+	if ctx.Err() != nil || !time.Now().Before(deadline) {
+		return ErrUpgrade
+	}
+	return freshPersistentJobObservation(result, member)
+}
+
+// Translation only. Win32 documents any nonzero API result as success, not
+// only TRUE (1). Membership must still be exact FALSE; the sentinel and every
+// nonzero membership refuse. No nested-job flag/limit inference is accepted.
+func freshPersistentJobObservation(result uintptr, member uint32) error {
+	if result == 0 || member != 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
