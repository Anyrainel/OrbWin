@@ -0,0 +1,305 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual startup owns controller exclusion until SAME existing service lock
+// is held and rechecked. A parsed committed file is never an activation grant.
+type freshCommittedStartupPermit struct {
+	self            *freshCommittedStartupPermit
+	mu              sync.Mutex
+	root            *InstanceRoot
+	storage         *nativeRuntimeStorage
+	observation     *freshOrdinaryObservation
+	records         *freshOrdinaryRecords
+	denial          *nativeFreshExistingLegacyDenial
+	parents         *ParentLease
+	created         *Created
+	unknown, closed bool
+	closeErr        error
+}
+
+var freshCommittedStartups = struct {
+	sync.Mutex
+	owners map[*freshCommittedStartupPermit]bool
+}{owners: make(map[*freshCommittedStartupPermit]bool)}
+
+func (f *freshCommittedStartupPermit) fence() {
+	f.unknown = true
+	if f.storage != nil {
+		f.storage.mu.Lock()
+		f.storage.fence()
+		f.storage.mu.Unlock()
+	}
+}
+func (f *freshCommittedStartupPermit) admittedCapture(n *nativeRuntimeStorage) bool {
+	if f == nil || f.self != f || f.storage != n || n.freshStartup != f || f.root != n.root || f.unknown || f.closed || f.records == nil || f.observation == nil || f.observation.unknown || f.observation.closed {
+		return false
+	}
+	freshCommittedStartups.Lock()
+	known := freshCommittedStartups.owners[f]
+	freshCommittedStartups.Unlock()
+	return known
+}
+
+func captureFreshCommittedStartup(ctx context.Context, root *InstanceRoot) (f *freshCommittedStartupPermit, result error) {
+	if !freshBoundedContext(ctx) || root == nil {
+		return nil, ErrUpgrade
+	}
+	parents, e := openInstanceParentMode(ctx, root, false, true)
+	if e == errProductParentAbsent {
+		return nil, nil
+	}
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	f = &freshCommittedStartupPermit{root: root, parents: parents}
+	f.self = f
+	freshCommittedStartups.Lock()
+	freshCommittedStartups.owners[f] = true
+	freshCommittedStartups.Unlock()
+	defer func() {
+		if recover() != nil {
+			f.fence()
+			result = ErrUpgrade
+		}
+		if result != nil && f.Close() != nil {
+			result = ErrUpgrade
+		}
+	}()
+	f.observation, f.records, e = observeFreshOrdinary(ctx, parents)
+	if e != nil {
+		return f, ErrUpgrade
+	}
+	if f.records == nil {
+		if f.Close() != nil {
+			return f, ErrUpgrade
+		}
+		return nil, nil
+	}
+	f.storage, e = allocateNativeRuntimeStorageCapture(ctx, root)
+	if e != nil {
+		return f, ErrUpgrade
+	}
+	f.storage.freshStartup = f
+	if f.storage.captureNative(ctx) != nil {
+		return f, ErrUpgrade
+	}
+	f.denial, e = f.storage.captureFreshLegacyDenialStorage(ctx, f.records.intent, f.records.admission.LegacyDenial)
+	if e != nil || f.checkNative(ctx) != nil {
+		return f, ErrUpgrade
+	}
+	return f, nil
+}
+
+func (f *freshCommittedStartupPermit) checkNative(ctx context.Context) error {
+	if f == nil || !freshBoundedContext(ctx) || f.storage == nil || !f.admittedCapture(f.storage) {
+		return ErrUpgrade
+	}
+	n := f.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	a := f.records.admission
+	if a.Seed != f.records.intent.Seed || n.checkFreshSeedIntentLocked(ctx, f.records.intent, a.Intent) != nil {
+		return ErrUpgrade
+	}
+	if f.denial == nil || f.denial.storage != n {
+		return ErrUpgrade
+	}
+	completion, e := f.denial.completionDataLocked(ctx)
+	if e != nil || !runtimeFreshDenialCompletionMatchesIntent(f.records.intent, completion) || completion != a.DenialCompletion {
+		return ErrUpgrade
+	}
+	if !runtimeMappedSelfStorageKnownLocked(n) || n.checkPrevious() != nil || n.parent == nil || n.controller == nil || n.predecessor == nil || runtimeStorageObjectData(n.parent) != a.Parent || runtimeStorageObjectData(n.controller) != a.Controller || n.parent.identity.descriptor != a.ParentDescriptor || n.controller.identity.descriptor != a.ControllerDescriptor {
+		return ErrUpgrade
+	}
+	actual := runtimeStorageFileData(n.predecessor, n.predecessorBody)
+	if actual == f.records.committed.Target {
+		return n.checkFreshControlStartupLocked(ctx, a)
+	}
+	return ErrUpgrade
+}
+
+// Controller is already held. Acquire OPEN_EXISTING only, and bind the actual
+// owner lock to the initial native authority-lock object before transferring.
+func (f *freshCommittedStartupPermit) acquireServiceOwner(ctx context.Context, c *Created) (result error) {
+	defer func() {
+		if recover() != nil {
+			if f != nil {
+				f.fence()
+			}
+			result = ErrUpgrade
+		}
+	}()
+	if f == nil || f.self != f || c == nil || f.unknown || f.closed || f.created != c || f.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := f.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if c.closed || c.anchor == 0 || !c.servingLease {
+		return ErrUpgrade
+	}
+	anchor, e := runtimeStorageIdentityOf(c.anchor, n.sid, true, true, false)
+	if e != nil || (UpgradeObject{anchor.volume, anchor.high, anchor.low}) != f.records.admission.Authority {
+		return ErrUpgrade
+	}
+	r, e := f.openServiceLock(n, c.anchor)
+	if e != nil {
+		return ErrUpgrade
+	}
+	h := r.handle
+	id, e := runtimeStorageIdentityOf(h, n.sid, false, true, false)
+	if e != nil || id.size != 0 || (UpgradeObject{id.volume, id.high, id.low}) != f.records.admission.AuthorityLock || id.descriptor != f.records.admission.AuthorityLockDescriptor {
+		return ErrUpgrade
+	}
+	c.authorityHandles = append(c.authorityHandles, h)
+	c.managedOwnerLock = h
+	n.resources = n.resources[:len(n.resources)-1]
+	r.handle = 0
+	return nil
+}
+
+func (f *freshCommittedStartupPermit) openServiceLock(n *nativeRuntimeStorage, parent windows.Handle) (*runtimeStorageResource, error) {
+	text, e := windows.NewNTUnicodeString("authority.owner.lock")
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	r := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, n.fence) != nil {
+		if !n.unknown && (r.handle == 0 || r.handle == windows.InvalidHandle) {
+			n.resources = n.resources[:len(n.resources)-1]
+		}
+		return nil, ErrUpgrade
+	}
+	return r, nil
+}
+
+func (f *freshCommittedStartupPermit) handoff(ctx context.Context, c *Created) (result error) {
+	if f == nil || f.self != f || c == nil || f.created != c {
+		return ErrUpgrade
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			f.fence()
+			result = ErrUpgrade
+		}
+	}()
+	if f.unknown || f.closed || f.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || !c.servingLease || c.anchor == 0 || len(c.authorityHandles) == 0 {
+		return ErrUpgrade
+	}
+	// Reobserve the exact private commit/authority/args/init while controller
+	// and actual service lock overlap. New native output is separately retained.
+	o, records, e := observeFreshOrdinary(ctx, f.parents)
+	if e != nil || records == nil || *records != *f.records {
+		if o != nil {
+			if o.unknown || o.close() != nil {
+				f.fence()
+			}
+		}
+		return ErrUpgrade
+	}
+	if o.close() != nil {
+		f.fence()
+		return ErrUpgrade
+	}
+	if f.captureManagedNamespaceLocked(ctx, c) != nil {
+		f.fence()
+		return ErrUpgrade
+	}
+	return f.closeOwned()
+}
+
+func (f *freshCommittedStartupPermit) closeOwned() error {
+	if n := f.storage; n != nil {
+		n.mu.Lock()
+		runtimeStorageDomain.Lock()
+		bad := n.unknown || n.closeAttempted || n.closeErr != nil || runtimeStorageDomain.failed || !runtimeStorageDomain.owners[n]
+		runtimeStorageDomain.Unlock()
+		n.mu.Unlock()
+		if bad {
+			f.fence()
+			return ErrUpgrade
+		}
+	}
+	if f.observation != nil && f.observation.close() != nil {
+		f.fence()
+		return ErrUpgrade
+	}
+	if f.parents != nil && f.parents.Close() != nil {
+		f.fence()
+		return ErrUpgrade
+	}
+	if f.storage != nil && f.storage.Close() != nil {
+		f.fence()
+		return ErrUpgrade
+	}
+	f.closed = true
+	f.closeErr = nil
+	freshCommittedStartups.Lock()
+	delete(freshCommittedStartups.owners, f)
+	freshCommittedStartups.Unlock()
+	return nil
+}
+func (f *freshCommittedStartupPermit) Close() (result error) {
+	if f == nil {
+		return nil
+	}
+	if f.self != f {
+		return ErrUpgrade
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.unknown {
+		return ErrUpgrade
+	}
+	if f.closed {
+		return f.closeErr
+	}
+	freshCommittedStartups.Lock()
+	registered := freshCommittedStartups.owners[f]
+	freshCommittedStartups.Unlock()
+	if !registered {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			f.fence()
+			result = ErrUpgrade
+		}
+	}()
+	if c := f.created; c != nil {
+		c.mu.Lock()
+		retired := c.closed && c.closeErr == nil && !c.datastoreActive.Load()
+		c.mu.Unlock()
+		if !retired {
+			return ErrUpgrade
+		}
+	}
+	return f.closeOwned()
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_transport_windows.go b/rdd/pkg/managementconfig/runtime_fresh_transport_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..85d2293b6dae4f1e7b0a6c17cd0ae831409dce54
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_transport_windows.go
@@ -0,0 +1,313 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/tls"
+	"net"
+	"sync"
+	"time"
+)
+
+// Only cached borrowed state is inspected here, before any own socket close.
+// This is also used after a native token-check temporary close failed.
+func (w *FreshRuntimeObservation) syncTransportUnknownLocked() bool {
+	if w == nil {
+		return true
+	}
+	if w.unknown || w.owner == nil || w.owner.unknown || w.owner.storage == nil {
+		w.fenceLocked()
+		return true
+	}
+	n := w.owner.storage
+	n.mu.Lock()
+	runtimeStorageDomain.Lock()
+	bad := n.captureSelf != n || n.unknown || n.closeAttempted || n.closeErr != nil || runtimeStorageDomain.failed || !runtimeStorageDomain.owners[n]
+	runtimeStorageDomain.Unlock()
+	n.mu.Unlock()
+	if c := w.created; c != nil {
+		c.mu.Lock()
+		bad = bad || c.closeErr != nil
+		c.mu.Unlock()
+	}
+	if image := w.owner.image; image != nil {
+		image.mu.Lock()
+		bad = bad || image.err != nil
+		image.mu.Unlock()
+	}
+	if bad {
+		w.fenceLocked()
+		return true
+	}
+	return false
+}
+
+// A failed high-level Dial hides internal native close results, including a
+// nil returned value. Retain the exact output and fence every failed Dial.
+func (w *FreshRuntimeObservation) retainTransportDialLocked(c *freshObservationConnection, returned net.Conn, err error) error {
+	c.conn = returned
+	if err != nil || returned == nil {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (c *freshObservationConnection) prepareIO(ctx context.Context) error {
+	if !freshBoundedContext(ctx) || c.conn == nil {
+		return ErrUpgrade
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	if d, _ := ctx.Deadline(); d.Before(deadline) {
+		deadline = d
+	}
+	c.guard = newFreshObservationAbortConn(c.conn, deadline)
+	if c.guard.SetDeadline(deadline) != nil {
+		return ErrUpgrade
+	}
+	c.watch(ctx)
+	return nil
+}
+
+// The production closer is always the exact original raw Dial result's Close
+// method, never TLS.Close or a request-selected callback. Inert fakes exercise
+// cancellation/settlement in pure tests; no callback is retained as authority.
+func (w *FreshRuntimeObservation) settleTransportUsing(c *freshObservationConnection, panicked bool, closeRaw func() error) (failure error) {
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			failure = ErrUpgrade
+		}
+	}()
+	settled := c.join()
+	if panicked || c.unknown {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	if w.syncTransportUnknownLocked() {
+		return ErrUpgrade
+	}
+	if c.attempted {
+		return c.closeErr
+	}
+	if closeRaw != nil && c.closeRawUsing(closeRaw) != nil {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	if !settled {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (w *FreshRuntimeObservation) settleTransportLocked(c *freshObservationConnection, panicked bool) error {
+	var closeRaw func() error
+	if c.conn != nil {
+		closeRaw = c.conn.Close
+	}
+	return w.settleTransportUsing(c, panicked, closeRaw)
+}
+
+// Adapted directly from the frozen legacy management transport abort/join contract.
+// Production supplies only the exact raw fixed TCP/pipe Dial result.
+// The private net.Conn wrapper admits inert socket fakes in pure tests, never
+// an IPC-selected dialer, route, raw closer or positive native constructor.
+type freshObservationAbortConn struct {
+	mu       sync.Mutex
+	conn     net.Conn
+	deadline time.Time
+	aborted  bool
+	sealed   bool
+	active   int
+	idle     chan struct{}
+}
+
+func newFreshObservationAbortConn(conn net.Conn, deadline time.Time) *freshObservationAbortConn {
+	return &freshObservationAbortConn{conn: conn, deadline: deadline, idle: make(chan struct{})}
+}
+func (c *freshObservationAbortConn) begin() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted || c.sealed || c.conn == nil {
+		return false
+	}
+	c.active++
+	return true
+}
+func (c *freshObservationAbortConn) end() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.active--
+	if c.sealed && c.active == 0 {
+		close(c.idle)
+	}
+}
+func (c *freshObservationAbortConn) Read(b []byte) (int, error) {
+	if !c.begin() {
+		return 0, ErrUpgrade
+	}
+	defer c.end()
+	return c.conn.Read(b)
+}
+func (c *freshObservationAbortConn) Write(b []byte) (int, error) {
+	if !c.begin() {
+		return 0, ErrUpgrade
+	}
+	defer c.end()
+	return c.conn.Write(b)
+}
+func (c *freshObservationAbortConn) LocalAddr() net.Addr {
+	if !c.begin() {
+		return nil
+	}
+	defer c.end()
+	return c.conn.LocalAddr()
+}
+func (c *freshObservationAbortConn) RemoteAddr() net.Addr {
+	if !c.begin() {
+		return nil
+	}
+	defer c.end()
+	return c.conn.RemoteAddr()
+}
+
+// TLS must never become the raw socket closer. An unexpected Close only latches
+// refusal and wakes I/O. The actor joins it and performs the sole cached raw
+// Close. Flag/deadline serialization is short and never held over Read/Write.
+func (c *freshObservationAbortConn) Close() (failure error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.aborted = true
+	failure = ErrUpgrade
+	defer func() {
+		if recover() != nil {
+			failure = ErrUpgrade
+		}
+	}()
+	if !c.sealed && c.conn != nil {
+		_ = c.conn.SetDeadline(time.Now())
+	}
+	return failure
+}
+func (c *freshObservationAbortConn) setDeadline(t time.Time, which uint8) (failure error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted || c.sealed || c.conn == nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			c.aborted = true
+			failure = ErrUpgrade
+		}
+	}()
+	if t.IsZero() || t.After(c.deadline) {
+		t = c.deadline
+	}
+	// A cancellation deadline cannot be extended by subsequent TLS activity.
+	if t.Before(c.deadline) {
+		c.deadline = t
+	}
+	switch which {
+	case 0:
+		failure = c.conn.SetDeadline(t)
+	case 1:
+		failure = c.conn.SetReadDeadline(t)
+	default:
+		failure = c.conn.SetWriteDeadline(t)
+	}
+	if failure != nil {
+		c.aborted = true
+		return ErrUpgrade
+	}
+	return nil
+}
+func (c *freshObservationAbortConn) SetDeadline(t time.Time) error {
+	return c.setDeadline(t, 0)
+}
+func (c *freshObservationAbortConn) SetReadDeadline(t time.Time) error {
+	return c.setDeadline(t, 1)
+}
+func (c *freshObservationAbortConn) SetWriteDeadline(t time.Time) error {
+	return c.setDeadline(t, 2)
+}
+func (c *freshObservationAbortConn) sealAndJoin() bool {
+	c.mu.Lock()
+	if !c.sealed {
+		c.sealed = true
+		if c.active == 0 {
+			close(c.idle)
+		}
+	}
+	idle := c.idle
+	c.mu.Unlock()
+	<-idle
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.aborted
+}
+
+type freshObservationConnection struct {
+	conn    net.Conn // exact raw Dial result; TLS never replaces this closer
+	tls     *tls.Conn
+	guard   *freshObservationAbortConn
+	stop    func() bool
+	watched chan struct{}
+	runtimeStorageCloseAttempt
+	unknown bool
+}
+
+func (c *freshObservationConnection) watch(ctx context.Context) {
+	c.watched = make(chan struct{})
+	c.stop = context.AfterFunc(ctx, func() {
+		defer close(c.watched)
+		_ = c.guard.SetDeadline(time.Now()) // never Close, including cancellation
+	})
+}
+func (c *freshObservationConnection) join() bool {
+	if c.stop != nil {
+		if !c.stop() {
+			<-c.watched
+		}
+		c.stop = nil
+	}
+	return c.guard == nil || c.guard.sealAndJoin()
+}
+
+// A concrete private method-value boundary: production supplies only raw.Close
+// after all I/O/Control/deadline callbacks joined. Tests supply only inert fake
+// methods. No replaceable closer is stored or selected by a request.
+func (c *freshObservationConnection) closeRawUsing(closeRaw func() error) (failure error) {
+	if c.attempted {
+		return c.closeErr
+	}
+	if closeRaw == nil {
+		return ErrUpgrade
+	}
+	if c.stop != nil {
+		return ErrUpgrade
+	}
+	if c.guard != nil {
+		c.guard.mu.Lock()
+		joined := c.guard.sealed && c.guard.active == 0
+		c.guard.mu.Unlock()
+		if !joined {
+			return ErrUpgrade
+		}
+	}
+	c.attempted = true
+	c.closeErr = ErrUpgrade // preset before effect, including panic
+	defer func() {
+		if recover() != nil {
+			c.unknown = true
+			panic(ErrUpgrade)
+		}
+	}()
+	if closeRaw() != nil {
+		c.unknown = true
+		return c.closeErr
+	}
+	c.closeErr = nil
+	return nil
+}
