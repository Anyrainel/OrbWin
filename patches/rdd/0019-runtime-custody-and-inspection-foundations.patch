+		if e != nil || !bytes.Equal(archivedBody, s.canonicalBody) {
+			o.unknown = true
+			n.fence()
+			return ErrUpgrade
+		}
+		s.canonical = nil
+		s.canonicalBody = nil
+		missing, me := n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshFenceName, false, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+		if me != windows.STATUS_OBJECT_NAME_NOT_FOUND || missing != nil || o.flushFreshSeedParentLocked(ctx) != nil {
+			o.unknown = true
+			n.fence()
+			return ErrUpgrade
+		}
+	}
+	if s.checkNoIntentEffectsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o.fenceObject, e = o.writeFreshRecordNativeLocked(ctx, runtimeFreshFenceName, wanted)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if o.flushFreshSeedParentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	if _, e = n.readFreshIntentHistoryLocked(ctx, o.intent, o.fenceObject, wanted); e != nil {
+		return ErrUpgrade
+	}
+	return s.checkLocked(ctx)
+}
