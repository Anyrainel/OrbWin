+type runtimeUpgradeManagementConnection struct {
+	returned net.Conn // retain the exact Dial output even before type/error checks
+	raw      *net.TCPConn
+	tls      *tls.Conn
+	guard    *runtimeUpgradeManagementAbortConn
+	stop     func() bool
+	watched  chan struct{}
+	close    runtimeStorageCloseAttempt
+	unknown  bool
+}
+
+func (c *runtimeUpgradeManagementConnection) watch(ctx context.Context) {
+	c.watched = make(chan struct{})
+	c.stop = context.AfterFunc(ctx, func() {
+		defer close(c.watched)
+		_ = c.guard.SetDeadline(time.Now()) // never Close, including cancellation
+	})
+}
+func (c *runtimeUpgradeManagementConnection) join() bool {
+	if c.stop != nil {
+		if !c.stop() {
+			<-c.watched
+		}
+		c.stop = nil
+	}
+	return c.guard == nil || c.guard.sealAndJoin()
+}
+
+// A concrete private method-value boundary: production supplies only raw.Close
+// after all I/O/Control/deadline callbacks joined. Tests supply only inert fake
+// methods. No replaceable closer is stored or selected by a request.
+func (c *runtimeUpgradeManagementConnection) closeRawUsing(closeRaw func() error) (failure error) {
+	if c.close.attempted {
+		return c.close.closeErr
+	}
+	if closeRaw == nil {
+		return ErrUpgrade
+	}
+	if c.stop != nil {
+		return ErrUpgrade
+	}
+	if c.guard != nil {
+		c.guard.mu.Lock()
+		joined := c.guard.sealed && c.guard.active == 0
+		c.guard.mu.Unlock()
+		if !joined {
+			return ErrUpgrade
+		}
+	}
+	c.close.attempted = true
+	c.close.closeErr = ErrUpgrade // preset before effect, including panic
+	defer func() {
+		if recover() != nil {
+			c.unknown = true
+			panic(ErrUpgrade)
+		}
+	}()
+	if closeRaw() != nil {
+		c.unknown = true
+		return c.close.closeErr
+	}
+	c.close.closeErr = nil
+	return nil
+}
