@@ -0,0 +1,86 @@
+package managementconfig
+
+import (
+	"encoding/json"
+	"strconv"
+	"strings"
+)
+
+// Requested-port policy DATA only. Complete can bind a different actual port;
+// native listener selection derives that port from the same held credentials.
+func runtimeUpgradeOldRequestedPort(body []byte) (uint16, error) {
+	if _, e := parseRuntimeUpgradeArgs(body); e != nil {
+		return 0, e
+	}
+	var args []string
+	if json.Unmarshal(body, &args) != nil {
+		return 0, ErrUpgrade
+	}
+	p, e := strconv.ParseUint(args[1], 10, 16)
+	if e != nil || p == 0 {
+		return 0, ErrUpgrade
+	}
+	return uint16(p), nil
+}
+
+// Current supported listener selection is EXACT IPv4 loopback, one row. Port
+// conflicts, IPv6/wildcard listeners, missing/inaccessible snapshots refuse.
+// A row/PID alone never issues process ownership, home binding or Stop authority.
+func runtimeUpgradeOldListenerPID(v4, v6 []upgradeTCPRow, port uint16) (uint32, error) {
+	if port == 0 || len(v4) > maxUpgradeTCPRows || len(v6) > maxUpgradeTCPRows {
+		return 0, ErrUpgrade
+	}
+	var pid uint32
+	found := 0
+	for _, rows := range [][]upgradeTCPRow{v4, v6} {
+		for _, row := range rows {
+			if row.port != port || row.state != 2 {
+				continue
+			}
+			if row.family != 4 || row.address != ([16]byte{127, 0, 0, 1}) || row.scope != 0 || row.pid == 0 {
+				return 0, ErrUpgrade
+			}
+			pid = row.pid
+			found++
+		}
+	}
+	if found != 1 {
+		return 0, ErrUpgrade
+	}
+	return pid, nil
+}
+
+func runtimeUpgradeOldCommandMatches(command []string, image string, saved []byte) bool {
+	if _, e := parseRuntimeUpgradeArgs(saved); e != nil || len(command) < 5 || !strings.EqualFold(command[0], image) || command[1] != "service" || command[2] != "serve" {
+		return false
+	}
+	var args []string
+	if json.Unmarshal(saved, &args) != nil {
+		return false
+	}
+	rest := command[3:]
+	if len(rest) < len(args) {
+		return false
+	}
+	for i, v := range args {
+		if rest[i] != v {
+			return false
+		}
+	}
+	tail := rest[len(args):]
+	return len(tail) == 0 || len(tail) == 1 && tail[0] == "--controllers=*,-path-management" || len(tail) == 2 && tail[0] == "--controllers" && tail[1] == "*,-path-management"
+}
+
+// Actual native owner delegates only its own registered resource slots here.
+// They use storage's SAME cached close attempts, never a second native closer.
+func closeRuntimeUpgradeOldListener(count int, close func(int) error) error {
+	if count < 0 || count > 264 || close == nil {
+		return ErrUpgrade
+	}
+	for i := count - 1; i >= 0; i-- {
+		if e := close(i); e != nil {
+			return e
+		}
+	}
+	return nil
+}
