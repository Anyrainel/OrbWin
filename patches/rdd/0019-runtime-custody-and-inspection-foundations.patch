+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestInspectionSeededActualReaderRefusesUnownedGraphBeforeNative(t *testing.T) {
+	for _, ctx := range []context.Context{nil, context.Background()} {
+		o := &inspectionNativeOwner{}
+		// No selection/domain admission exists. Merely copying native-looking IDs
+		// into objects cannot enable even the first read/open in these helpers.
+		private := &inspectionNativeObject{owner: o}
+		public := &inspectionNativeObject{owner: o}
+		s := &inspectionFreshRecords{o: o, private: private, public: public}
+		if s.readIntent(ctx) == nil {
+			t.Fatal("unowned graph read admitted")
+		}
+		if v, b, e := o.inspectionFragment(ctx, private, runtimeFreshFenceName, 1024); e == nil || v != nil || len(b) != 0 {
+			t.Fatal("unowned fragment admitted")
+		}
+		if len(o.slots) != 0 || len(o.objects) != 0 || s.controller != nil {
+			t.Fatal("refusal published native output slots")
+		}
+	}
+}
+
+func TestInspectionSeededNamespaceIsClosed(t *testing.T) {
+	seed, _ := (runtimeFreshSeedName{strings.Repeat("a", 32), strings.Repeat("b", 64), strings.Repeat("c", 40), strings.Repeat("d", 64)}).name()
+	retained, _ := runtimeFreshControlRetainedName(strings.Repeat("a", 32))
+	names := []string{"runtime", "setup-logs", anchorName, runtimeFreshFenceName, runtimeFreshAdmissionName, runtimeFreshCommittedName, runtimeFreshAppAdmissionName, seed, retained}
+	for _, f := range []func(uint32) (string, error){runtimeFreshIntentRepairName, runtimeFreshIntentArchiveName, runtimeFreshDenialDirectoryName, runtimeFreshControlRecordName, runtimeFreshControlBirthName} {
+		n, _ := f(15)
+		names = append(names, n)
+	}
+	if !inspectionFreshNamespace(names) {
+		t.Fatal("closed producer roles refused")
+	}
+	for _, bad := range []string{"authority.fresh.intent-repair.0016", "authority.fresh.control.0016", "authority.fresh.seed.v2.invalid", "authority.retained.arbitrary", strings.ToUpper(seed), "unknown", "authority.fresh.app-create.stage"} {
+		if inspectionFreshNamespace(append(append([]string{}, names...), bad)) {
+			t.Fatalf("unowned role accepted: %s", bad)
+		}
+	}
+	if inspectionFreshNamespace(append(append([]string{}, names...), seed)) {
+		t.Fatal("duplicate seed accepted")
+	}
+	another, _ := (runtimeFreshSeedName{strings.Repeat("e", 32), strings.Repeat("b", 64), strings.Repeat("c", 40), strings.Repeat("d", 64)}).name()
+	if inspectionFreshNamespace([]string{seed, another}) {
+		t.Fatal("ambiguous producer selection accepted")
+	}
+	otherRoot, _ := runtimeFreshControlRetainedName(strings.Repeat("b", 32))
+	if inspectionFreshNamespace([]string{retained, otherRoot}) {
+		t.Fatal("ambiguous retained roots accepted")
+	}
+	if inspectionFreshNamespace(make([]string, 513)) {
+		t.Fatal("namespace budget exceeded")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_width_test.go b/rdd/pkg/managementconfig/runtime_inspection_width_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6dd1182f563b5a2d34d67115e0c807f6908bc4bb
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_width_test.go
@@ -0,0 +1,54 @@
+package managementconfig
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestInspectionActualReturnWidthGuards(t *testing.T) {
+	if unsafe.Sizeof(uintptr(0)) != 8 {
+		t.Fatal("this qualification context is AMD64")
+	}
+	high := uintptr(0xfedcba9800000000)
+	for _, value := range []struct {
+		raw   uintptr
+		truth bool
+	}{{0, false}, {high, false}, {1, true}, {2, true}, {high | 2, true}, {0xffffffff, true}} {
+		if inspectionWinBOOL(value.raw) != value.truth {
+			t.Fatal("BOOL interpretation", value)
+		}
+	}
+	// Exercise the actual downstream buffer-admission helpers. A false BOOL
+	// with undefined high bits cannot admit a fetched security buffer.
+	if inspectionProbeSize(inspectionWinBOOL(high), 122, 20) != nil {
+		t.Fatal("false sizing result refused because of high bits")
+	}
+	if inspectionProbeSize(inspectionWinBOOL(high|2), 122, 20) == nil {
+		t.Fatal("successful zero-buffer probe accepted")
+	}
+	if inspectionFetchSize(inspectionWinBOOL(high), 20, 20) == nil {
+		t.Fatal("false fetch admitted a partial buffer")
+	}
+	if inspectionFetchSize(inspectionWinBOOL(high|2), 20, 20) != nil {
+		t.Fatal("noncanonical TRUE refused")
+	}
+	// NTSTATUS accepts exact STATUS_SUCCESS only; this is not the broader
+	// NT_SUCCESS macro. Pending, informational, warning and failure refuse.
+	for _, value := range []struct {
+		raw     uintptr
+		success bool
+	}{{0, true}, {high, true}, {1, false}, {0x103, false}, {high | 0x103, false}, {0x80000005, false}, {0xc0000001, false}, {high | 0xc0000001, false}} {
+		if inspectionNTSuccess(value.raw) != value.success {
+			t.Fatal("NTSTATUS interpretation", value)
+		}
+	}
+	// Full pointer/size carriers remain full width. The helpers interpret a
+	// return value by value and cannot modify the original raw field.
+	raw := high | 2
+	before := raw
+	_ = inspectionWinBOOL(raw)
+	_ = inspectionNTSuccess(raw)
+	if raw != before || uint64(raw) <= 0xffffffff {
+		t.Fatal("raw HANDLE/SIZE_T-sized DATA narrowed")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_managed_authority.go b/rdd/pkg/managementconfig/runtime_managed_authority.go
