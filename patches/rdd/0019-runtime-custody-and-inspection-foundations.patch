index 0000000000000000000000000000000000000000..28ebc1035c7fe819fc6afa0884a14293f6c64f97
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_denial_completion_binding_test.go
@@ -0,0 +1,135 @@
+package managementconfig
+
+import (
+	"bytes"
+	"testing"
+)
+
+// Comparison DATA only; no native object or permission is supplied by fixtures.
+func freshDenialCompletionFixture(a runtimeFreshAdmission) runtimePublicationFileWitness {
+	w := a.LegacyDenial
+	w.Object.Low = 30
+	w.Body[0]++
+	return w
+}
+
+func TestRuntimeFreshDenialCompletionDependsOnActualIntentVersion(t *testing.T) {
+	old := freshPublicationFixture()
+	body, err := runtimeFreshRecordBytes(old)
+	if err != nil || !old.valid() || bytes.Contains(body, []byte(`"denialCompletion"`)) {
+		t.Fatal("schema1 admission canonical shape changed")
+	}
+	var decoded runtimeFreshAdmission
+	if parseRuntimeFreshRecord(body, &decoded) != nil || decoded != old {
+		t.Fatal("schema1 admission no longer roundtrips")
+	}
+	a := old
+	a.Seed = freshSeedIntentFixture().Seed
+	if a.valid() {
+		t.Fatal("seeded producer omitted mandatory completion")
+	}
+	a.DenialCompletion = freshDenialCompletionFixture(a)
+	if a.Schema != 1 || !a.valid() {
+		t.Fatal("completion eligibility incorrectly selected from admission version")
+	}
+	body, err = runtimeFreshRecordBytes(a)
+	if err != nil || !bytes.Contains(body, []byte(`"denialCompletion"`)) || parseRuntimeFreshRecord(body, &decoded) != nil || decoded != a {
+		t.Fatal("seeded completion admission roundtrip")
+	}
+	if !runtimeFreshDenialCompletionMatchesIntent(freshSeedIntentFixture(), a.DenialCompletion) || runtimeFreshDenialCompletionMatchesIntent(freshSeedIntentFixture(), runtimePublicationFileWitness{}) {
+		t.Fatal("actual schema2 intent did not require completion")
+	}
+	legacy := freshSeedIntentFixture()
+	legacy.Schema, legacy.Seed = 1, runtimeFreshSeedFact{}
+	if !runtimeFreshDenialCompletionMatchesIntent(legacy, runtimePublicationFileWitness{}) || runtimeFreshDenialCompletionMatchesIntent(legacy, a.DenialCompletion) {
+		t.Fatal("legacy intent silently adopted seeded completion")
+	}
+	for _, change := range []func(*runtimeFreshIntent){
+		func(i *runtimeFreshIntent) { i.Schema = 3 },
+		func(i *runtimeFreshIntent) { i.Schema = 1 },
+		func(i *runtimeFreshIntent) { i.Seed = runtimeFreshSeedFact{} },
+	} {
+		i := freshSeedIntentFixture()
+		change(&i)
+		if runtimeFreshDenialCompletionMatchesIntent(i, a.DenialCompletion) {
+			t.Fatal("unsupported or mixed intent selected completion")
+		}
+	}
+}
+
+func TestRuntimeFreshDenialCompletionRejectsMissingForeignAndAliasedFacts(t *testing.T) {
+	a := freshPublicationFixture()
+	a.Seed = freshSeedIntentFixture().Seed
+	a.DenialCompletion = freshDenialCompletionFixture(a)
+	for name, change := range map[string]func(*runtimeFreshAdmission){
+		"missing":      func(v *runtimeFreshAdmission) { v.DenialCompletion = runtimePublicationFileWitness{} },
+		"seedless":     func(v *runtimeFreshAdmission) { v.Seed = runtimeFreshSeedFact{} },
+		"volume":       func(v *runtimeFreshAdmission) { v.DenialCompletion.Object.Volume++ },
+		"body":         func(v *runtimeFreshAdmission) { v.DenialCompletion.Body = [32]byte{} },
+		"descriptor":   func(v *runtimeFreshAdmission) { v.DenialCompletion.Descriptor = [32]byte{} },
+		"empty record": func(v *runtimeFreshAdmission) { v.DenialCompletion.Size = 0 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := a
+			change(&bad)
+			if bad.valid() {
+				t.Fatal("unbound completion accepted")
+			}
+		})
+	}
+	for _, object := range []UpgradeObject{a.Intent.Object, a.LegacyDenial.Object, a.Parent, a.Controller, a.Authority, a.AuthorityLock, a.Args.Object, a.Initialization.Object, a.Stage.Object, a.Seed.Object} {
+		bad := a
+		bad.DenialCompletion.Object = object
+		if bad.valid() {
+			t.Fatal("completion aliases an existing witness", object)
+		}
+	}
+}
+
+func TestRuntimeFreshDenialCompletionCannotChangeOnGenerationReplacement(t *testing.T) {
+	a := freshPublicationFixture()
+	a.Seed = freshSeedIntentFixture().Seed
+	a.DenialCompletion = freshDenialCompletionFixture(a)
+	r := runtimeFreshRecoveryAdmission{Schema: 1, Sequence: 1, Previous: a.Intent, Current: a}
+	r.Current.Candidate.PID++
+	if !r.matches(a, a.Intent, 1) {
+		t.Fatal("new process generation refused")
+	}
+	for _, change := range []func(*runtimePublicationFileWitness){
+		func(w *runtimePublicationFileWitness) { *w = runtimePublicationFileWitness{} },
+		func(w *runtimePublicationFileWitness) { w.Object.Low++ },
+		func(w *runtimePublicationFileWitness) { w.Descriptor[0]++ },
+		func(w *runtimePublicationFileWitness) { w.Body[0]++ },
+		func(w *runtimePublicationFileWitness) { w.Size++ },
+		func(w *runtimePublicationFileWitness) { w.Written++ },
+	} {
+		bad := r
+		change(&bad.Current.DenialCompletion)
+		if bad.matches(a, a.Intent, 1) {
+			t.Fatal("generation replacement changed original completion")
+		}
+	}
+}
+
+func TestRuntimeFreshDenialCompletionWireRefusesAliasesDuplicatesAndZeroInjection(t *testing.T) {
+	a := freshPublicationFixture()
+	a.Seed = freshSeedIntentFixture().Seed
+	a.DenialCompletion = freshDenialCompletionFixture(a)
+	body, _ := runtimeFreshRecordBytes(a)
+	for _, bad := range [][]byte{
+		bytes.Replace(body, []byte(`"denialCompletion":`), []byte(`"DenialCompletion":`), 1),
+		bytes.Replace(body, []byte(`"denialCompletion":`), []byte(`"denialCompletion":null,"denialCompletion":`), 1),
+		bytes.Replace(body, []byte(`"denialCompletion":`), []byte(`"nativeGrant":true,"denialCompletion":`), 1),
+	} {
+		var decoded runtimeFreshAdmission
+		if parseRuntimeFreshRecord(bad, &decoded) == nil {
+			t.Fatal("noncanonical completion wire accepted")
+		}
+	}
+	old, _ := runtimeFreshRecordBytes(freshPublicationFixture())
+	var decoded runtimeFreshAdmission
+	zero := bytes.Replace(old, []byte(`"schema":1`), []byte(`"schema":1,"denialCompletion":null`), 1)
+	if parseRuntimeFreshRecord(zero, &decoded) == nil {
+		t.Fatal("explicit zero completion changed legacy shape")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_completion_windows.go b/rdd/pkg/managementconfig/runtime_fresh_denial_completion_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a029ebe71f8bc14e30021303c0bb998766da2725
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_denial_completion_windows.go
@@ -0,0 +1,265 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Complete legacy schema1 remains wire-compatible, but cannot consume a live
+// seeded denial namespace by silently treating its history as optional DATA.
+func (n *nativeRuntimeStorage) checkNoSeededDenialHistoryLocked(ctx context.Context, dirs [runtimeFreshLegacyDirectoryCount]*runtimeStorageObject) error {
+	pid := dirs[runtimeFreshLegacyDirectoryCount-1]
+	if n == nil || pid == nil || !freshBoundedContext(ctx) || len(n.ancestry) == 0 {
+		return ErrUpgrade
+	}
+	private := n.ancestry[len(n.ancestry)-1]
+	for _, v := range []struct {
+		parent  *runtimeStorageObject
+		private bool
+	}{{private, true}, {pid, false}} {
+		var names []string
+		var e error
+		if v.private {
+			names, e = n.freshPrivateDirectoryNamesLocked(ctx)
+		} else {
+			names, e = n.freshDenialDirectoryNamesLocked(ctx, dirs)
+		}
+		if e != nil || !runtimeFreshDenialNamespaceValid(names, false, v.private) {
+			return ErrUpgrade
+		}
+	}
+
+	for _, v := range []struct {
+		parent *runtimeStorageObject
+		name   func(uint32) (string, error)
+	}{{private, runtimeFreshDenialDirectoryName}, {pid, runtimeFreshDenialRepairName}, {pid, runtimeFreshDenialArchiveName}, {pid, runtimeFreshDenialCompletionName}} {
+		for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+			key, _ := v.name(i)
+			o, e := n.denialObservationLocked(ctx, v.parent, key)
+			if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || o != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	return nil
+}
+
+func (d *nativeFreshExistingLegacyDenial) captureCompletionLocked(ctx context.Context, intent runtimeFreshIntent) error {
+	n := d.storage
+	if intent.Schema == 1 && intent.Seed == (runtimeFreshSeedFact{}) {
+		return n.checkNoSeededDenialHistoryLocked(ctx, d.directories)
+	}
+	if intent.Schema != 2 || !intent.Seed.valid() {
+		return ErrUpgrade
+	}
+	plan, e := n.denialPlanLocked(intent, runtimeStorageFileData(d.intent, d.intentBody))
+	if e != nil {
+		return ErrUpgrade
+	}
+	h, e := n.readDenialHistoryLocked(ctx, plan, d.directories, 5, d.receipt, d.body)
+	if e != nil || h.completion == nil {
+		return ErrUpgrade
+	}
+	if d.retainHistoryLocked(ctx, h) != nil {
+		return ErrUpgrade
+	}
+	key, _ := runtimeFreshDenialCompletionName(h.completion.Ordinal)
+	d.completion, e = n.openFreshExistingTracked(ctx, d.directories[4].resource.handle, key, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	d.completionBody, e = n.read(d.completion, false)
+	if e != nil || runtimeStorageFileData(d.completion, d.completionBody) != h.completions[h.completion.Ordinal].File {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (d *nativeFreshExistingLegacyDenial) checkCompletionLocked(ctx context.Context, intent runtimeFreshIntent) error {
+	n := d.storage
+	if intent.Schema == 1 && intent.Seed == (runtimeFreshSeedFact{}) {
+		if d.completion != nil {
+			return ErrUpgrade
+		}
+		return n.checkNoSeededDenialHistoryLocked(ctx, d.directories)
+	}
+	if intent.Schema != 2 || !intent.Seed.valid() || d.completion == nil || n.checkObject(d.completion) != nil || n.checkFreshSeedIntentLocked(ctx, intent, runtimeStorageFileData(d.intent, d.intentBody)) != nil {
+		return ErrUpgrade
+	}
+	for _, held := range d.history {
+		if n.checkObject(held.object) != nil {
+			return ErrUpgrade
+		}
+		actual, e := n.read(held.object, true)
+		if e != nil || !bytes.Equal(actual, held.body) {
+			return ErrUpgrade
+		}
+	}
+	plan, e := n.denialPlanLocked(intent, runtimeStorageFileData(d.intent, d.intentBody))
+	if e != nil {
+		return ErrUpgrade
+	}
+	h, e := n.readDenialHistoryLocked(ctx, plan, d.directories, 5, d.receipt, d.body)
+	if e != nil || h.completion == nil || runtimeStorageFileData(d.completion, d.completionBody) != h.completions[h.completion.Ordinal].File {
+		return ErrUpgrade
+	}
+	b, e := n.read(d.completion, false)
+	if e != nil || !bytes.Equal(b, d.completionBody) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (d *runtimeFreshLegacyDenial) checkCompletionLocked(ctx context.Context) error {
+	if !d.knownLocked() || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o, n := d.owner, d.owner.storage
+	if o.intent.Schema == 1 && o.intent.Seed == (runtimeFreshSeedFact{}) {
+		if d.completion != nil {
+			return ErrUpgrade
+		}
+		return n.checkNoSeededDenialHistoryLocked(ctx, d.directories)
+	}
+	if o.intent.Schema != 2 || !o.intent.Seed.valid() || d.completion == nil || n.checkObject(d.completion) != nil {
+		return ErrUpgrade
+	}
+	b, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if d.prefix != nil {
+		if d.prefix.verifySeedLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+	} else if n.checkFreshSeedIntentLocked(ctx, o.intent, runtimeStorageFileData(o.fenceObject, b)) != nil {
+		return ErrUpgrade
+	}
+	plan, e := n.denialPlanLocked(o.intent, runtimeStorageFileData(o.fenceObject, b))
+	if e != nil {
+		return ErrUpgrade
+	}
+	h, e := n.readDenialHistoryLocked(ctx, plan, d.directories, 5, d.receipt, d.body)
+	if e != nil || h.completion == nil || runtimeStorageFileData(d.completion, d.completionBody) != h.completions[h.completion.Ordinal].File {
+		return ErrUpgrade
+	}
+	b, e = n.read(d.completion, false)
+	if e != nil || !bytes.Equal(b, d.completionBody) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Both initial producer and original pending recovery use this SAME actual d.
+// Completion is mandatory DATA written after receipt/directory persistence,
+// never an early completed flag or stand-in writer.
+func (d *runtimeFreshLegacyDenial) completeDenialLocked(ctx context.Context) error {
+	if !d.knownLocked() || !freshBoundedContext(ctx) || d.receipt == nil {
+		return ErrUpgrade
+	}
+	o, n := d.owner, d.owner.storage
+	if o.intent.Schema == 1 && o.intent.Seed == (runtimeFreshSeedFact{}) {
+		return n.checkNoSeededDenialHistoryLocked(ctx, d.directories)
+	}
+	if o.intent.Schema != 2 || !o.intent.Seed.valid() {
+		return ErrUpgrade
+	}
+	ib, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	plan, e := n.denialPlanLocked(o.intent, runtimeStorageFileData(o.fenceObject, ib))
+	if e != nil {
+		return ErrUpgrade
+	}
+	h, e := n.readDenialHistoryLocked(ctx, plan, d.directories, 5, d.receipt, d.body)
+	if e != nil || h.unarchived {
+		return ErrUpgrade
+	}
+	pid := d.directories[4]
+	if d.prefix != nil && (d.persistDenialHistoryLocked(ctx, h) != nil || d.prefix.checkLocked(ctx) != nil) {
+		return ErrUpgrade
+	}
+
+	if h.completion != nil {
+		key, _ := runtimeFreshDenialCompletionName(h.completion.Ordinal)
+		d.completion, e = n.openFreshExistingTracked(ctx, pid.resource.handle, key, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		d.completionBody, e = n.read(d.completion, false)
+		if e != nil || runtimeStorageFileData(d.completion, d.completionBody) != h.completions[h.completion.Ordinal].File {
+			return ErrUpgrade
+		}
+	} else {
+		if len(h.completions) >= runtimeFreshDenialSlots {
+			return ErrUpgrade
+		}
+		record := runtimeFreshDenialCompletion{Schema: 1, Ordinal: uint32(len(h.completions)), Plan: plan, Denial: runtimeStorageFileData(d.receipt, d.body), DirectoryHead: h.directoryHead, RepairHead: h.repairHead}
+		d.completionBody, e = runtimeFreshRecordBytes(record)
+		if e != nil || !record.valid() {
+			return ErrUpgrade
+		}
+		key, _ := runtimeFreshDenialCompletionName(record.Ordinal)
+		d.completion, e = d.writeDenialRecordLocked(ctx, pid, key, d.completionBody)
+		if e != nil {
+			return ErrUpgrade
+		}
+	}
+	if d.flushDirectoriesLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return d.checkCompletionLocked(ctx)
+}
+
+// Completed startup/recovery retains every original immutable history object
+// through the existing n lifetime. Subsequent checks additionally enumerate the
+// full fixed namespace; no historical file becomes optional after completion.
+func (d *nativeFreshExistingLegacyDenial) retainHistoryLocked(ctx context.Context, h nativeFreshDenialHistory) error {
+	if d == nil || d.storage == nil || !freshBoundedContext(ctx) || len(d.storage.ancestry) == 0 || d.directories[4] == nil || len(d.history) != 0 {
+		return ErrUpgrade
+	}
+	n := d.storage
+	private, pid := n.ancestry[len(n.ancestry)-1], d.directories[4]
+	retain := func(parent *runtimeStorageObject, name string, v runtimeFreshDenialRecipeObservation) error {
+		o, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e != nil || runtimeStorageFileData(o, v.Body) != v.File {
+			return ErrUpgrade
+		}
+		b, e := n.read(o, true)
+		if e != nil || !bytes.Equal(b, v.Body) {
+			return ErrUpgrade
+		}
+		d.history = append(d.history, nativeFreshDenialDurableFile{parent, name, o, append([]byte(nil), v.Body...)})
+		return nil
+	}
+	for i, v := range h.directories {
+		key, _ := runtimeFreshDenialDirectoryName(uint32(i))
+		if retain(private, key, v) != nil {
+			return ErrUpgrade
+		}
+	}
+	for i, v := range h.repairs {
+		key, _ := runtimeFreshDenialRepairName(uint32(i))
+		if retain(pid, key, v) != nil {
+			return ErrUpgrade
+		}
+	}
+	for i, v := range h.archives {
+		if v != nil {
+			key, _ := runtimeFreshDenialArchiveName(uint32(i))
+			if retain(pid, key, *v) != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	for i, v := range h.completions {
+		key, _ := runtimeFreshDenialCompletionName(uint32(i))
+		if retain(pid, key, v) != nil {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_history_test.go b/rdd/pkg/managementconfig/runtime_fresh_denial_history_test.go
