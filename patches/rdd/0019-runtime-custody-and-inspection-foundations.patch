+func TestManagedNamespaceDiskIdentityKeepsOwnershipAcrossGrowth(t *testing.T) {
+	original := runtimeStorageIdentity{volume: 2, high: 3, low: 4, attributes: 5, links: 1, size: 4096, descriptor: [32]byte{7}}
+	grown := original
+	grown.size = 8192
+	grown.written = windows.Filetime{LowDateTime: 9}
+	if !managedSameDisk(original, grown) {
+		t.Fatal("legitimate disk growth changed the fixed ownership comparison")
+	}
+	for _, mutate := range []func(*runtimeStorageIdentity){
+		func(i *runtimeStorageIdentity) { i.volume++ },
+		func(i *runtimeStorageIdentity) { i.low++ },
+		func(i *runtimeStorageIdentity) { i.high++ },
+		func(i *runtimeStorageIdentity) { i.links++ },
+		func(i *runtimeStorageIdentity) { i.attributes++ },
+		func(i *runtimeStorageIdentity) { i.descriptor[0]++ },
+	} {
+		changed := grown
+		mutate(&changed)
+		if managedSameDisk(original, changed) {
+			t.Fatal("disk ownership mutation accepted")
+		}
+	}
+}
