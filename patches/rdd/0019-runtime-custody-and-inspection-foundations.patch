+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshNativeBirthAndOneUseGuardsNoIO(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, n := range []*nativeRuntimeStorage{nil, {}, {captureKind: runtimeStorageFreshCapture}, {captureKind: runtimeStorageCaptureKind(9)}} {
+		if n.beginFreshPublicRoute(ctx) {
+			t.Fatal("unregistered/copied birth admitted")
+		}
+		if n.captureNativeFresh(ctx) == nil {
+			t.Fatal("missing actual fresh birth reached capture")
+		}
+		if n.captureNativeCore(ctx) == nil {
+			t.Fatal("missing actual core birth admitted")
+		}
+	}
+	invalid := &nativeRuntimeStorage{captureKind: runtimeStorageCaptureKind(9)}
+	invalid.captureSelf = invalid
+	if invalid.captureNativeCore(ctx) == nil {
+		t.Fatal("unknown fixed operation kind reached native core")
+	}
+	n := &nativeRuntimeStorage{captureKind: runtimeStorageFreshCapture, captureStarted: true, root: &InstanceRoot{selection: &authoritypath.Selection{}}}
+	n.captureSelf = n
+	runtimeStorageDomain.Lock()
+	before := runtimeStorageDomain.failed
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	defer func() {
+		runtimeStorageDomain.Lock()
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.failed = before
+		runtimeStorageDomain.Unlock()
+	}()
+	// This is a pure phase test only; it never calls native prefix inspection.
+	if !n.beginFreshPublicRoute(ctx) || n.beginFreshPublicRoute(ctx) {
+		t.Fatal("fresh route one-use guard")
+	}
+	if _, e := n.captureFreshPublicRoute(ctx); e == nil {
+		t.Fatal("consumed route entered native effects")
+	}
+	copy := &nativeRuntimeStorage{captureSelf: n, captureKind: runtimeStorageFreshCapture, captureStarted: true}
+	if copy.Close() == nil || copy.beginFreshPublicRoute(ctx) {
+		t.Fatal("copied storage acquired cleanup/capture ownership")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_commit_windows.go b/rdd/pkg/managementconfig/runtime_fresh_commit_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..69cb593aea5a684bb3af0caf047c4e3aa8dfe3fb
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_commit_windows.go
@@ -0,0 +1,132 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+// Caller holds ONLY owner.mu; native outputs enter its SAME storage first.
+func (o *FreshSetupOwner) readFreshFileHeld(ctx context.Context, parent windows.Handle, name string) (*runtimeStorageObject, []byte, error) {
+	if !freshBoundedContext(ctx) {
+		return nil, nil, ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || n.check() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	r, e := o.openFixed(parent, name, false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+	if e != nil {
+		return nil, nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, nil, ErrUpgrade
+	}
+	object := &runtimeStorageObject{resource: r, identity: id, private: true}
+	body, e := n.read(object, false)
+	if e != nil || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	return object, body, nil
+}
+
+func (o *FreshSetupOwner) writeFreshRecordHeld(ctx context.Context, name string, body []byte) (*runtimeStorageObject, error) {
+	if len(body) == 0 || len(body) > runtimeFreshRecordBudget || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	return o.writeFreshRecordNativeLocked(ctx, name, body)
+}
+
+// Same actual CREATE/flush/readback/close/reopen recipe. Recovery's root birth
+// must publish before its first child while retaining o->n/thread throughout;
+// it cannot re-enter the wrapper or reconstruct a writer from metadata.
+func (o *FreshSetupOwner) writeFreshRecordNativeLocked(ctx context.Context, name string, body []byte) (*runtimeStorageObject, error) {
+	if len(body) == 0 || len(body) > runtimeFreshRecordBudget || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || n.check() != nil || len(n.ancestry) == 0 {
+		return nil, ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1].resource.handle
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	writer, e := o.openFixed(parent, name, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, sd)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	for at := 0; at < len(body); {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		count, e := nativeWrite(writer.handle, body[at:])
+		if e != nil || count < 1 || count > len(body)-at {
+			return nil, ErrUpgrade
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(writer.handle) != nil {
+		return nil, ErrUpgrade
+	}
+	expected, e := runtimeStorageIdentityOf(writer.handle, n.sid, false, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	actual, e := n.read(&runtimeStorageObject{resource: writer, identity: expected, private: true}, false)
+	if e != nil || !bytes.Equal(actual, body) {
+		return nil, ErrUpgrade
+	}
+	if n.closeTemporary(writer) != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	reader, e := o.openFixed(parent, name, false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(reader.handle, n.sid, false, true, false)
+	if e != nil || !runtimeStorageCreatedSame(id, expected) {
+		return nil, ErrUpgrade
+	}
+	object := &runtimeStorageObject{resource: reader, identity: id, private: true}
+	actual, e = n.read(object, false)
+	if e != nil || !bytes.Equal(actual, body) || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return object, nil
+}
+
+// Both the record owner and its exact actual identity/body must remain held.
+func (o *FreshSetupOwner) checkFreshRecordHeld(ctx context.Context, object *runtimeStorageObject, body []byte) error {
+	if !freshBoundedContext(ctx) || object == nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || n.check() != nil || n.checkObject(object) != nil {
+		return ErrUpgrade
+	}
+	actual, e := n.read(object, false)
+	if e != nil || !bytes.Equal(actual, body) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_birth_windows.go b/rdd/pkg/managementconfig/runtime_fresh_control_birth_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..8109360f9648d3babf6ca349f75b921616827b08
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_birth_windows.go
@@ -0,0 +1,162 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Explicit FILE_OPEN recovery provenance for root CREATE -> birth cuts. An
+// actual empty observed root is not reclassified as normal CREATE lineage.
+// SAME old ownerlock/controller and complete retention recipe remain held.
+func (s *nativeFreshControlRecovery) resumeEmptyCreatorLocked(ctx context.Context, c *Created) (*runtimeStorageResource, runtimeStorageIdentity, error) {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.newRoot == nil || s.retainedObject == nil || s.newCreated != nil || s.checkPrefixLocked(ctx) != nil || s.checkRetentionRecordLocked(ctx) != nil {
+		return nil, runtimeStorageIdentity{}, ErrUpgrade
+	}
+	o := s.recovery.owner
+	n := o.storage
+	if o.created != c || c == nil || c.parent == 0 || s.newRoot.resource == nil || s.newRoot.resource.attempted || n.checkObject(s.newRoot) != nil {
+		return nil, runtimeStorageIdentity{}, ErrUpgrade
+	}
+	parent, e := runtimeStorageIdentityOf(c.parent, n.sid, true, true, false)
+	if e != nil || parent != s.parent.identity {
+		return nil, runtimeStorageIdentity{}, ErrUpgrade
+	}
+	names, e := datastoreDirectoryNames(s.newRoot.resource.handle)
+	if e != nil || len(names) != 0 || s.recheckEdgeLocked(ctx, s.parent, anchorName, s.newRoot) != nil || !freshBoundedContext(ctx) {
+		return nil, runtimeStorageIdentity{}, ErrUpgrade
+	}
+	if s.birthObject != nil && s.checkBirthForRootLocked(ctx, s.newRoot) != nil {
+		return nil, runtimeStorageIdentity{}, ErrUpgrade
+	}
+	return s.newRoot.resource, s.newRoot.identity, nil
+}
+
+// Exact native root creator is still live here. Birth must be durable before
+// the original lower producer creates its FIRST fixed child. No duplicate of
+// its exclusive creator is retained: that would self-block the serving reopen.
+func (s *nativeFreshControlRecovery) admitNewRootLocked(ctx context.Context, c *Created, creator *runtimeStorageResource, id runtimeStorageIdentity) error {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.retainedObject == nil || s.checkPrefixLocked(ctx) != nil || s.checkRetentionRecordLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o := s.recovery.owner
+	n := o.storage
+	if o.created != c || c == nil || creator == nil || creator.handle == 0 || creator.attempted || s.newCreated != nil || id.volume != s.parent.identity.volume {
+		return ErrUpgrade
+	}
+	owned := false
+	for _, slot := range n.resources {
+		if slot == creator {
+			owned = true
+			break
+		}
+	}
+	if !owned {
+		return ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(creator.handle, n.sid, true, true, false)
+	if e != nil || actual != id {
+		return ErrUpgrade
+	}
+	children, e := datastoreDirectoryNames(creator.handle)
+	if e != nil || len(children) != 0 {
+		return ErrUpgrade
+	}
+	root := &runtimeStorageObject{resource: creator, identity: actual, directory: true, private: true}
+	s.newRoot = root
+	s.newCreated = c
+	witness := runtimeStorageFileData(s.recordObject, s.recordBody)
+	firstMissing := uint32(runtimeFreshControlSlots)
+	var chosen *runtimeStorageObject
+	var chosenBody []byte
+	var chosenBirth runtimeFreshControlBirth
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlBirthName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if firstMissing == runtimeFreshControlSlots {
+				firstMissing = ordinal
+			}
+			continue
+		}
+		if e != nil || firstMissing != runtimeFreshControlSlots || chosen != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		birth := runtimeFreshControlBirth{Schema: 1, Transaction: o.intent.Transaction, Ordinal: ordinal, Retention: witness, Authority: runtimeStorageObjectData(root), Descriptor: root.identity.descriptor}
+		wanted, e := runtimeFreshRecordBytes(birth)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if bytes.Equal(body, wanted) {
+			chosen, chosenBody, chosenBirth = object, append([]byte(nil), body...), birth
+			continue
+		}
+		// Before a complete birth the root is strictly empty by original source
+		// ordering. Preserve exact partial prefixes in bounded immutable slots;
+		// a nonempty root or stale/mixed identity can never use this transition.
+		if !runtimeFreshControlPrefixBytes(body, wanted) {
+			return ErrUpgrade
+		}
+	}
+	if chosen == nil {
+		if firstMissing >= runtimeFreshControlSlots {
+			return ErrUpgrade
+		}
+		birth := runtimeFreshControlBirth{Schema: 1, Transaction: o.intent.Transaction, Ordinal: firstMissing, Retention: witness, Authority: runtimeStorageObjectData(root), Descriptor: root.identity.descriptor}
+		body, e := runtimeFreshRecordBytes(birth)
+		if e != nil {
+			return ErrUpgrade
+		}
+		name, _ := runtimeFreshControlBirthName(firstMissing)
+		chosen, e = o.writeFreshRecordNativeLocked(ctx, name, body)
+		if e != nil {
+			return ErrUpgrade
+		}
+		chosenBody, chosenBirth = append([]byte(nil), body...), birth
+	}
+	s.birthObject, s.birthBody, s.birth = chosen, chosenBody, chosenBirth
+	return s.checkBirthForRootLocked(ctx, root)
+}
+
+func (s *nativeFreshControlRecovery) checkBirthForRootLocked(ctx context.Context, root *runtimeStorageObject) error {
+	if s == nil || root == nil || s.birthObject == nil || s.checkRetentionRecordLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	n := s.recovery.owner.storage
+	if n.checkObject(root) != nil || !s.birth.matches(s.record, runtimeStorageFileData(s.recordObject, s.recordBody), runtimeStorageObjectData(root), root.identity.descriptor) || n.checkObject(s.birthObject) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(s.birthObject, false)
+	if e != nil || !bytes.Equal(body, s.birthBody) {
+		return ErrUpgrade
+	}
+	expected, e := runtimeFreshRecordBytes(s.birth)
+	if e != nil || !bytes.Equal(expected, body) {
+		return ErrUpgrade
+	}
+	if s.recheckEdgeLocked(ctx, s.parent, anchorName, root) != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Called only after positive original creator close + exact serving reopen and
+// actual tuple-root duplicate. Replace no provenance: bind to the SAME actual
+// Created output whose native ID/SD matches durable birth before it escapes.
+func (s *nativeFreshControlRecovery) completeCreatedRootLocked(ctx context.Context, c *Created) error {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.newCreated != c || c == nil || s.recovery.owner.created != c || c.freshAuthority == nil || c.freshAuthority.created != c {
+		return ErrUpgrade
+	}
+	root := c.freshAuthority.root
+	if root == nil || s.checkBirthForRootLocked(ctx, root) != nil {
+		return ErrUpgrade
+	}
+	s.newRoot = root
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_header_windows.go b/rdd/pkg/managementconfig/runtime_fresh_control_header_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..55821502db1167ad30de89e59466bfab41206998
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_header_windows.go
@@ -0,0 +1,157 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Explicit recovery of the bound NEW structural root. This is not normal
+// CREATE lineage or a claim initialized defaults already exist. Native current
+// root/birth/controller and source-prefix checks precede each missing role.
+func (s *nativeFreshControlRecovery) resumeStructuralHeaderLocked(ctx context.Context) (*Created, error) {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.newRoot == nil || s.birthObject == nil || s.newCreated != nil || s.checkPrefixLocked(ctx) != nil || s.checkBirthForRootLocked(ctx, s.newRoot) != nil {
+		return nil, ErrUpgrade
+	}
+	o := s.recovery.owner
+	n := o.storage
+	if o.created != nil {
+		return nil, ErrUpgrade
+	}
+	names, e := upgradeStoreNames(s.newRoot.resource.handle)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	allowed := map[string]bool{"tls": true, "db": true, "args.json": true, "authority.init": true, "authority.owner.lock": true}
+	for ordinal := uint32(0); ordinal < runtimeFreshTupleSlots; ordinal++ {
+		name, _ := runtimeFreshTupleFileName(ordinal)
+		allowed[name] = true
+	}
+	for _, role := range []runtimeFreshFixedRole{runtimeFreshRoleArgs, runtimeFreshRoleInit} {
+		for ordinal := uint32(0); ordinal < runtimeFreshRoleSlots; ordinal++ {
+			name, _ := runtimeFreshRoleArchiveName(role, ordinal)
+			allowed[name] = true
+		}
+	}
+	present := map[string]bool{}
+	for _, name := range names {
+		if !allowed[name] || present[name] {
+			return nil, ErrUpgrade
+		}
+		present[name] = true
+	}
+	if present["db"] && !present["tls"] || present["args.json"] && !present["db"] || present["authority.init"] && !present["args.json"] {
+		return nil, ErrUpgrade
+	}
+	for _, name := range []string{"tls", "db"} {
+		directory, e := s.openOrCreateHeaderDirectoryLocked(ctx, name)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		children, e := upgradeStoreNames(directory.resource.handle)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		if name == "db" && len(children) != 0 {
+			return nil, ErrUpgrade
+		}
+		if name == "tls" {
+			tlsAllowed := map[string]bool{"apiserver.crt": true, "apiserver.key": true, "sa.key": true}
+			for _, role := range []runtimeFreshFixedRole{runtimeFreshRoleCert, runtimeFreshRoleKey, runtimeFreshRoleAccount} {
+				for ordinal := uint32(0); ordinal < runtimeFreshRoleSlots; ordinal++ {
+					archive, _ := runtimeFreshRoleArchiveName(role, ordinal)
+					tlsAllowed[archive] = true
+				}
+			}
+			for _, child := range children {
+				if !tlsAllowed[child] {
+					return nil, ErrUpgrade
+				}
+			}
+		}
+	}
+	lock, e := n.openFreshExistingTracked(ctx, s.newRoot.resource.handle, "authority.owner.lock", false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, 0, true, false)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		if s.checkPrefixLocked(ctx) != nil {
+			return nil, ErrUpgrade
+		}
+		sd, e := privateDescriptor(n.sid, false)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		creator, e := o.openFixed(s.newRoot.resource.handle, "authority.owner.lock", false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, sd)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(creator.handle, n.sid, false, true, false)
+		if e != nil || id.size != 0 {
+			return nil, ErrUpgrade
+		}
+		lock = &runtimeStorageObject{resource: creator, identity: id, private: true}
+	} else if e != nil || lock.identity.size != 0 {
+		return nil, ErrUpgrade
+	}
+	// Drop the recovery DELETE lease before obtaining the actual serving
+	// READ/shareable root. Keep original setup.lock and actual ownerlock live.
+	expected := s.newRoot.identity
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(s.newRoot.resource) != nil {
+		return nil, ErrUpgrade
+	}
+	reader, e := n.openFreshExistingTracked(ctx, s.parent.resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil || reader.identity != expected {
+		return nil, ErrUpgrade
+	}
+	s.newRoot = reader
+	c, e := o.duplicateCapturedAuthorityNativeLocked(ctx, reader, lock)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	s.newCreated = c
+	for _, role := range []runtimeFreshFixedRole{runtimeFreshRoleArgs, runtimeFreshRoleInit} {
+		if _, e := reconcileFreshFixedRoleLocked(ctx, role, s, nil); e != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if o.bindFreshAuthorityTupleStateLocked(ctx, c) != nil || s.completeCreatedRootLocked(ctx, c) != nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return c, nil
+}
+
+func (s *nativeFreshControlRecovery) openOrCreateHeaderDirectoryLocked(ctx context.Context, name string) (*runtimeStorageObject, error) {
+	if name != "tls" && name != "db" {
+		return nil, ErrUpgrade
+	}
+	if s == nil || s.newRoot == nil || s.checkPrefixLocked(ctx) != nil || s.checkBirthForRootLocked(ctx, s.newRoot) != nil {
+		return nil, ErrUpgrade
+	}
+	o, n := s.recovery.owner, s.recovery.owner.storage
+	object, e := n.openFreshExistingTracked(ctx, s.newRoot.resource.handle, name, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e == nil {
+		return object, nil
+	}
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil, ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, true)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	creator, e := o.openFixed(s.newRoot.resource.handle, name, true, windows.FILE_CREATE, windows.FILE_LIST_DIRECTORY, sd)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(creator.handle, n.sid, true, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(creator) != nil {
+		return nil, ErrUpgrade
+	}
+	reader, e := n.openFreshExistingTracked(ctx, s.newRoot.resource.handle, name, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil || reader.identity != id || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return reader, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_open_windows.go b/rdd/pkg/managementconfig/runtime_fresh_control_open_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..21ac05b9e4a618b0ebbcb9c4d83836406b891fe8
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_open_windows.go
@@ -0,0 +1,103 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+)
+
+func (o *FreshSetupOwner) openControlRecoveryAuthority(ctx context.Context, args []byte) (result *Created, failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	initialization, e := initializationBytes(args)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n := o.storage
+	if n == nil || n.freshRecovery == nil || o.closed || o.unknown || !o.captureComplete || o.created != nil {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	s := r.controlRetention
+	if r.owner != o || !r.admitted(n) || !r.complete || s == nil || s.self != s || s.recovery != r || !s.complete {
+		return nil, ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			n.mu.Lock()
+			n.fence()
+			n.mu.Unlock()
+			result = nil
+			failure = ErrUpgrade
+		}
+	}()
+	if o.origin == nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || r.checkAdmittedStorageLocked(ctx) != nil || o.checkLegacyStartDenialLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	if s.recordObject != nil && !bytes.Equal(args, s.record.Args) {
+		return nil, ErrUpgrade
+	}
+	if s.retainedObject == nil {
+		if s.prepareRetentionLocked(ctx, args) != nil || s.retainOldControlLocked(ctx) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if s.newRoot == nil {
+		return o.createFreshServiceAuthorityNativeLocked(ctx, args, initialization)
+	}
+	if s.checkRetentionRecordLocked(ctx) != nil || n.checkObject(s.newRoot) != nil {
+		return nil, ErrUpgrade
+	}
+	names, e := upgradeStoreNames(s.newRoot.resource.handle)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	if len(names) == 0 {
+		return o.createFreshServiceAuthorityNativeLocked(ctx, args, initialization)
+	}
+	// Initialized data is preserved and read through the unchanged native
+	// reader. A failed read never selects structural repair or key generation.
+	db, de := n.openFreshExistingTracked(ctx, s.newRoot.resource.handle, "db", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if de != nil && de != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil, ErrUpgrade
+	}
+	if de == nil {
+		entries, e := upgradeStoreNames(db.resource.handle)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		if len(entries) > 0 {
+			if s.birthObject == nil || s.checkBirthForRootLocked(ctx, s.newRoot) != nil {
+				return nil, ErrUpgrade
+			}
+			expected := s.newRoot.identity
+			if !freshKnownForRoleClose(freshFixedRoleInputs{owner: o, storage: n}) || n.closeTemporary(s.newRoot.resource) != nil {
+				return nil, ErrUpgrade
+			}
+			if r.captureInitializedAuthorityNativeLocked(ctx) != nil || r.control.identity != expected || !bytes.Equal(r.argsBody, s.record.Args) {
+				return nil, ErrUpgrade
+			}
+			s.newRoot = r.control
+			c, e := o.duplicateCapturedAuthorityNativeLocked(ctx, r.control, r.ownerLock)
+			if e == nil {
+				s.newCreated = c
+			}
+			return c, e
+		}
+	}
+	return s.resumeStructuralHeaderLocked(ctx)
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_publication.go b/rdd/pkg/managementconfig/runtime_fresh_control_publication.go
