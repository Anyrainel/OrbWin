@@ -0,0 +1,106 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+
+	"golang.org/x/sys/windows"
+)
+
+// Ephemeral inputs derived ONLY from exactly one original concrete state.
+// This is no owner/closer/permit and accepts no arbitrary n,parent,plan triple.
+type freshFixedRoleInputs struct {
+	owner                    *FreshSetupOwner
+	storage                  *nativeRuntimeStorage
+	parent, plan, sourcePlan *runtimeStorageObject
+	desired                  []byte
+	transaction              string
+	role                     runtimeFreshFixedRole
+}
+
+func deriveFreshFixedRoleLocked(ctx context.Context, role runtimeFreshFixedRole, control *nativeFreshControlRecovery, tuple *nativeFreshAuthorityTupleState) (result freshFixedRoleInputs, failure error) {
+	complete := false
+	defer func() {
+		if !complete {
+			clear(result.desired)
+			result.desired = nil
+		}
+	}()
+	if !freshBoundedContext(ctx) || role.name() == "" || (control == nil) == (tuple == nil) {
+		return result, ErrUpgrade
+	}
+	if control != nil {
+		if role.isTuple() || control.self != control || control.recovery == nil || control.recovery.owner == nil || control.newRoot == nil || control.newCreated == nil || control.recovery.owner.created != control.newCreated || control.newCreated.closed || control.newCreated.closeErr != nil || control.checkPrefixLocked(ctx) != nil || control.checkBirthForRootLocked(ctx, control.newRoot) != nil {
+			return result, ErrUpgrade
+		}
+		o := control.recovery.owner
+		result.owner, result.storage, result.parent, result.plan, result.sourcePlan, result.transaction = o, o.storage, control.newRoot, control.birthObject, control.recordObject, o.intent.Transaction
+		if role == runtimeFreshRoleArgs {
+			result.desired = append([]byte(nil), control.record.Args...)
+		} else {
+			var e error
+			result.desired, e = initializationBytes(control.record.Args)
+			if e != nil {
+				return result, ErrUpgrade
+			}
+		}
+	} else {
+		if !role.isTuple() || tuple.self != tuple || tuple.owner == nil || tuple.created == nil || tuple.created.freshAuthority != tuple || tuple.owner.created != tuple.created || !tuple.knownLocked(ctx) || tuple.tuple == nil {
+			return result, ErrUpgrade
+		}
+		o, n := tuple.owner, tuple.owner.storage
+		if r := n.freshRecovery; r != nil && (r.admission != nil || r.stage != nil || r.target != nil) {
+			return result, ErrUpgrade
+		}
+		body, e := n.readFreshRecoverySecretLocked(ctx, tuple.tuple)
+		if e != nil {
+			return result, ErrUpgrade
+		}
+		defer clear(body)
+		material, e := parseRuntimeFreshAuthorityTuple(body, tuple.binding)
+		if e != nil {
+			return result, ErrUpgrade
+		}
+		defer material.clear()
+		var wanted []byte
+		switch role {
+		case runtimeFreshRoleCert:
+			wanted = material.cert
+		case runtimeFreshRoleKey:
+			wanted = material.key
+		case runtimeFreshRoleAccount:
+			wanted = material.account
+		default:
+			return result, ErrUpgrade
+		}
+		result.owner, result.storage, result.parent, result.plan, result.transaction = o, n, tuple.tls, tuple.tuple, o.intent.Transaction
+		result.desired = append([]byte(nil), wanted...)
+	}
+	result.role = role
+	o, n := result.owner, result.storage
+	if !o.nativeOutputsAdmittedLocked() || !runtimeMappedSelfStorageKnownLocked(n) || n.prepared || n.attempt.used || n.checkPrevious() != nil || n.checkObject(result.parent) != nil || n.checkObject(result.plan) != nil || len(result.desired) == 0 || len(result.desired) > runtimeFreshTupleBudget {
+		return result, ErrUpgrade
+	}
+	if r := n.freshRecovery; r != nil {
+		if !r.admitted(n) || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.guestPreflight.checkLocked(ctx) != nil {
+			return result, ErrUpgrade
+		}
+	} else if o.recheckInitialGuestNativeLocked(ctx) != nil {
+		return result, ErrUpgrade
+	}
+	root := result.parent
+	if tuple != nil {
+		root = tuple.root
+	}
+	db, e := n.openFreshExistingTracked(ctx, root.resource.handle, "db", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return result, ErrUpgrade
+	}
+	names, e := datastoreDirectoryNames(db.resource.handle)
+	if e != nil || len(names) != 0 || !freshBoundedContext(ctx) {
+		return result, ErrUpgrade
+	}
+	complete = true
+	return result, nil
+}
