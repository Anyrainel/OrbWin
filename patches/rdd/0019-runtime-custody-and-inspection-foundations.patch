+package main
+
+import (
+	"context"
+	"errors"
+	"io"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+)
+
+// Dormant exact-role seam; deliberately no edit to main's active dispatcher.
+// Future main integration must preserve early native selection and strict stdio.
+func privateRuntimeInspection(ctx context.Context, args []string, input io.Reader, output io.Writer) (matched bool, err error) {
+	switch privateInspectionRoute(args) {
+	case 0:
+		return false, nil
+	case -1:
+		return true, errors.New("runtime inspection unavailable")
+	default:
+		return true, managementconfig.RunNativeRuntimeInspection(ctx, input, output)
+	}
+}
