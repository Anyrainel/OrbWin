+		return 0, ErrUpgrade
+	}
+	if kind == runtimeStorageNativeOpenFailure {
+		n.win32Open = nil
+		return 0, windows.Errno(code)
+	}
+	return f.resource.handle, nil // Exact original output held until caller keep.
+}
+func (n *nativeRuntimeStorage) originalTokenKnown() bool {
+	r := n.tokenResource
+	return r != nil && r.win32Open != nil && r.win32Open.role == runtimeStorageInitialToken && r.handle != 0 && windows.Handle(n.token) == r.handle && !r.attempted && n.win32ResourceKnown(r)
+}
+func (n *nativeRuntimeStorage) openWin32(role runtimeStorageWin32Role) (windows.Handle, error) {
+	if n == nil || n.captureSelf != n || !n.captureStarted || n.closeAttempted || n.unknown {
+		return 0, ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
