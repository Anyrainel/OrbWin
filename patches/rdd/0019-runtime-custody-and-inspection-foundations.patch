+package managementconfig
+
+// Only DATA classification; native owner/frame binding is checked separately.
+func runtimeImageWin32Output(success bool, lastError uint32, returned, valid bool) runtimeStorageNativeOpenReply {
+	if success {
+		if !returned || !valid {
+			return runtimeStorageNativeOpenUnknown
+		}
+		return runtimeStorageNativeOpenSuccess // last-error is unspecified on success.
+	}
+	if returned || lastError == 0 || lastError == 997 {
+		return runtimeStorageNativeOpenUnknown
+	}
+	return runtimeStorageNativeOpenFailure
+}
+
+func runtimeImageEntryReady(s *runtimeStorageNativeOpenState) bool {
+	return s != nil && !s.entered && !s.returned && !s.admitted && !s.attached && !s.unknown
+}
diff --git a/rdd/pkg/managementconfig/runtime_image_output_model_test.go b/rdd/pkg/managementconfig/runtime_image_output_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ab66f51fd817bd1378f34f36ec23e5d0f8c7603c
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_image_output_model_test.go
@@ -0,0 +1,93 @@
+package managementconfig
+
+import "testing"
+
+func TestRuntimeImageOutputWin32StatusDoesNotBorrowLastError(t *testing.T) {
+	for _, last := range []uint32{0, 2, 5, 997, 0xffffffff} {
+		if runtimeImageWin32Output(true, last, true, true) != runtimeStorageNativeOpenSuccess {
+			t.Fatal("successful BOOL borrowed stale lastError", last)
+		}
+	}
+	for _, last := range []uint32{2, 5, 6} {
+		if runtimeImageWin32Output(false, last, false, false) != runtimeStorageNativeOpenFailure {
+			t.Fatal("terminal no-output", last)
+		}
+	}
+	for _, last := range []uint32{0, 997} {
+		if runtimeImageWin32Output(false, last, false, false) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("unknown/pending discarded", last)
+		}
+	}
+	for _, valid := range []bool{false, true} {
+		if runtimeImageWin32Output(false, 5, true, valid) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("partial output discarded")
+		}
+	}
+	for _, p := range [][2]bool{{false, false}, {true, false}, {false, true}} {
+		if runtimeImageWin32Output(true, 0, p[0], p[1]) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("invalid success")
+		}
+	}
+}
+func TestRuntimeImageOutputExactAttachmentAndPendingFaultCuts(t *testing.T) {
+	for _, pair := range [][2]uint32{{0x103, 0}, {0, 0x103}, {0xc0000034, 0x103}} {
+		for _, out := range []bool{false, true} {
+			s := runtimeStorageNativeOpenState{entered: true}
+			k := runtimeStorageClassifyNativeOpen(pair[0], pair[1], 1, 1, out, out)
+			if k != runtimeStorageNativeOpenUnknown || s.reply(k) || !s.unknown || s.attach() || s.reply(runtimeStorageNativeOpenSuccess) {
+				t.Fatal("NT pending escaped", pair, out)
+			}
+		}
+	}
+	for _, kind := range []runtimeStorageNativeOpenReply{runtimeStorageNativeOpenFailure, runtimeStorageNativeOpenUnknown, runtimeStorageNativeOpenSuccess} {
+		s := runtimeStorageNativeOpenState{entered: true}
+		s.reply(kind)
+		if s.usable() {
+			t.Fatal("unattached output usable")
+		}
+		attached := s.attach()
+		if attached != (kind == runtimeStorageNativeOpenSuccess) {
+			t.Fatal("wrong attachment")
+		}
+		if s.attach() {
+			t.Fatal("double resource attachment")
+		}
+	}
+}
+func TestRuntimeImageOutputRetainedOriginalAcrossFaultCuts(t *testing.T) {
+	for _, cut := range []string{"before-return", "pending-zero", "returned-unattached", "attached"} {
+		frame := &runtimeStorageNativeOpenState{entered: true}
+		original := frame
+		switch cut {
+		case "pending-zero":
+			frame.reply(runtimeStorageNativeOpenUnknown)
+		case "returned-unattached":
+			frame.reply(runtimeStorageNativeOpenSuccess)
+		case "attached":
+			frame.reply(runtimeStorageNativeOpenSuccess)
+			frame.attach()
+		}
+		func() {
+			defer func() {
+				if recover() != nil {
+					original.unknown = true
+				}
+			}()
+			panic("source fault cut")
+		}()
+		if frame != original || !original.unknown || original.usable() || original.attach() {
+			t.Fatal("fault lost or reused original", cut)
+		}
+	}
+}
+
+func TestRuntimeImageOutputEnteredFrameCannotReenter(t *testing.T) {
+	if !runtimeImageEntryReady(&runtimeStorageNativeOpenState{}) || runtimeImageEntryReady(nil) {
+		t.Fatal("initial state")
+	}
+	for _, s := range []runtimeStorageNativeOpenState{{entered: true}, {returned: true}, {admitted: true}, {attached: true}, {unknown: true}} {
+		if runtimeImageEntryReady(&s) {
+			t.Fatal("reentered output frame", s)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_image_output_windows.go b/rdd/pkg/managementconfig/runtime_image_output_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b543f8f22fc367a377d20e2c9ac568be713c9586
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_image_output_windows.go
@@ -0,0 +1,288 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strings"
+	"unsafe"
+)
+
+// Strong custody belongs to the actual lease or registered origin, never this
+// helper or a global frame cache. Every out-pointer is the resource's own cell.
+type runtimeImageOpenFrame struct {
+	owner      any
+	parent     windows.Handle
+	name       string
+	resource   *runtimeStorageResource
+	output     *windows.Handle
+	text       *windows.NTUnicodeString
+	attributes windows.OBJECT_ATTRIBUTES
+	io         windows.IO_STATUS_BLOCK
+	path       []uint16
+	raw        uintptr
+	lastError  error
+	state      runtimeStorageNativeOpenState
+}
+
+var imageOutputKernel = windows.NewLazySystemDLL("kernel32.dll")
+var imageOutputDuplicate = imageOutputKernel.NewProc("DuplicateHandle")
+var imageOutputCreate = imageOutputKernel.NewProc("CreateFileW")
+
+type runtimeImageFrameOwner interface {
+	ownsRuntimeImageOpenFrame(*runtimeImageOpenFrame) bool
+	fenceRuntimeImageOpenFrame()
+}
+
+func (f *runtimeImageOpenFrame) nativeOwner() runtimeImageFrameOwner {
+	if f == nil || f.output == nil {
+		return nil
+	}
+	switch o := f.owner.(type) {
+	case *ServingImageLease:
+		if o == nil {
+			return nil
+		}
+	case *nativeRuntimeBuildOrigin:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeSDKCandidateAcceptance:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeCandidate:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeLegacySDKHelpers:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeSDKChild:
+		if o == nil {
+			return nil
+		}
+	case *upgradeLegacySDKObservedImage:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeSDKImage:
+		if o == nil {
+			return nil
+		}
+	case *nativeUpgradeSDKServingOwner:
+		if o == nil {
+			return nil
+		}
+	default:
+		return nil
+	}
+	o, _ := f.owner.(runtimeImageFrameOwner)
+	return o
+}
+
+func (f *runtimeImageOpenFrame) original() bool {
+	o := f.nativeOwner()
+	return o != nil && o.ownsRuntimeImageOpenFrame(f)
+}
+func (f *runtimeImageOpenFrame) fence() {
+	if f == nil {
+		return
+	}
+	f.state.unknown = true
+	if o := f.nativeOwner(); o != nil {
+		o.fenceRuntimeImageOpenFrame()
+	}
+}
+func (l *ServingImageLease) ownsRuntimeImageOpenFrame(f *runtimeImageOpenFrame) bool {
+	if l == nil || f == nil || f.owner != l || f.resource == nil || f.output != &f.resource.handle || l.captureSelf != l || l.openFrame != f || l.closed || l.unknown || l.captureComplete || len(l.resources) != len(l.chain)+1 || l.resources[len(l.resources)-1] != f.resource || len(l.openFrames) == 0 || l.openFrames[len(l.openFrames)-1] != f {
+		return false
+	}
+	servingImageCaptures.Lock()
+	registered := servingImageCaptures.owners[l] && !servingImageCaptures.failed
+	servingImageCaptures.Unlock()
+	if !registered {
+		return false
+	}
+	if len(l.chain) == 0 {
+		return f.parent == 0 && f.name == l.captureVolume && l.captureVolume != ""
+	}
+	i := len(l.chain) - 1
+	return i < len(l.captureParts) && f.name == l.captureParts[i] && f.parent == l.chain[len(l.chain)-1] && f.parent != 0 && f.parent != windows.InvalidHandle
+}
+
+func (l *ServingImageLease) fenceRuntimeImageOpenFrame() { l.fail() }
+func (o *nativeRuntimeBuildOrigin) ownsRuntimeImageOpenFrame(f *runtimeImageOpenFrame) bool {
+	if o == nil || f == nil || f.owner != o || f.resource == nil || f.output != &f.resource.handle || o.openFrame != f || o.unknown || o.closed || o.closeAttempt.attempted || len(o.openFrames) == 0 || o.openFrames[len(o.openFrames)-1] != f {
+		return false
+	}
+	runtimeBuildOrigins.Lock()
+	held := runtimeBuildOrigins.owners[o]
+	runtimeBuildOrigins.Unlock()
+	if !held || !runtimeStorageDomainKnown() || !servingImageCaptureKnown(o.lease) {
+		return false
+	}
+	if f.name == "" {
+		if f.parent == windows.CurrentProcess() {
+			return true
+		}
+		for _, h := range o.lease.chain {
+			if f.parent == h && h != 0 && h != windows.InvalidHandle {
+				return true
+			}
+		}
+		return false
+	}
+	if f.name != "rdd.exe" || len(o.objects) < 2 {
+		return false
+	}
+	p := o.objects[len(o.objects)-2]
+	return p != nil && p.directory && p.resource != nil && f.parent == p.resource.handle && f.parent != 0 && !p.resource.attempted
+}
+
+func (o *nativeRuntimeBuildOrigin) fenceRuntimeImageOpenFrame() { o.fence() }
+
+func (f *runtimeImageOpenFrame) entryReady() bool {
+	return f.original() && runtimeImageEntryReady(&f.state) && *f.output == 0
+}
+func (f *runtimeImageOpenFrame) ntReply() (windows.Handle, error) {
+	if !f.original() {
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	if uint32(f.raw) == 0x103 || uint32(f.io.Status) == 0x103 {
+		f.state.reply(runtimeStorageNativeOpenUnknown)
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	h := *f.output
+	kind := runtimeStorageClassifyNativeOpen(uint32(f.raw), uint32(f.io.Status), f.io.Information, windows.FILE_OPEN, h != 0, h != 0 && h != windows.InvalidHandle)
+	if !f.state.reply(kind) {
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	if kind == runtimeStorageNativeOpenFailure {
+		return 0, windows.NTStatus(uint32(f.raw))
+	}
+	return h, nil
+}
+func (f *runtimeImageOpenFrame) ntCall(parent windows.Handle, name string, access, share, options uint32) (h windows.Handle, failure error) {
+	if !f.entryReady() || f.parent != parent || f.name != name {
+		return 0, ErrUpgrade
+	}
+	var e error
+	f.text, e = windows.NewNTUnicodeString(name)
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	f.attributes = windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: f.text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	f.attributes.Length = uint32(unsafe.Sizeof(f.attributes))
+	defer func() {
+		if p := recover(); p != nil {
+			f.fence()
+			panic(p)
+		}
+		runtime.KeepAlive(f)
+	}()
+	f.state.entered = true
+	f.raw, _, _ = runtimeStorageCreateFile.Call(uintptr(unsafe.Pointer(f.output)), uintptr(access), uintptr(unsafe.Pointer(&f.attributes)), uintptr(unsafe.Pointer(&f.io)), 0, 0, uintptr(share), uintptr(windows.FILE_OPEN), uintptr(options), 0, 0)
+	return f.ntReply()
+}
+func (f *runtimeImageOpenFrame) winReply(success, invalidSentinel bool) (windows.Handle, error) {
+	if !f.original() {
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	code := windows.Errno(0)
+	if !success {
+		var ok bool
+		code, ok = f.lastError.(windows.Errno)
+		if !ok || uint32(code) == 997 {
+			f.state.reply(runtimeStorageNativeOpenUnknown)
+			f.fence()
+			return 0, ErrUpgrade
+		}
+	}
+	h := *f.output
+	valid := h != 0 && h != windows.InvalidHandle
+	returned := h != 0
+	if invalidSentinel && h == windows.InvalidHandle {
+		returned = false
+	}
+	kind := runtimeImageWin32Output(success, uint32(code), returned, valid)
+	if !f.state.reply(kind) {
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	if kind == runtimeStorageNativeOpenFailure {
+		return 0, code
+	}
+	return h, nil
+}
+
+func (f *runtimeImageOpenFrame) duplicate(source windows.Handle, access, options uint32) (h windows.Handle, failure error) {
+	if !f.entryReady() {
+		return 0, ErrUpgrade
+	}
+	if _, ok := f.owner.(*nativeRuntimeBuildOrigin); !ok || f.parent != source || f.name != "" {
+		return 0, ErrUpgrade
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			f.fence()
+			panic(p)
+		}
+		runtime.KeepAlive(f)
+	}()
+	f.state.entered = true
+	f.raw, _, f.lastError = imageOutputDuplicate.Call(uintptr(windows.CurrentProcess()), uintptr(source), uintptr(windows.CurrentProcess()), uintptr(unsafe.Pointer(f.output)), uintptr(access), 0, uintptr(options))
+	return f.winReply(uint32(f.raw) != 0, false)
+}
+func (f *runtimeImageOpenFrame) volume(path string) (h windows.Handle, failure error) {
+	if !f.entryReady() {
+		return 0, ErrUpgrade
+	}
+	if _, serving := f.owner.(*ServingImageLease); !serving {
+		if _, legacy := f.owner.(*upgradeLegacySDKObservedImage); !legacy {
+			if _, image := f.owner.(*nativeUpgradeSDKImage); !image {
+				return 0, ErrUpgrade
+			}
+		}
+	}
+	if f.name != path || f.parent != 0 {
+		return 0, ErrUpgrade
+	}
+	var e error
+	f.path, e = windows.UTF16FromString(path)
+	if e != nil {
+		return 0, ErrCreate
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			f.fence()
+			panic(p)
+		}
+		runtime.KeepAlive(f)
+	}()
+	f.state.entered = true
+	f.raw, _, f.lastError = imageOutputCreate.Call(uintptr(unsafe.Pointer(&f.path[0])), uintptr(windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES), uintptr(windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE), 0, uintptr(windows.OPEN_EXISTING), uintptr(windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT), 0)
+	*f.output = windows.Handle(f.raw)
+	valid := *f.output != 0 && *f.output != windows.InvalidHandle
+	if !valid && *f.output != windows.InvalidHandle {
+		f.fence()
+		return 0, ErrCreate
+	}
+	// CreateFile's INVALID_HANDLE_VALUE is its specified no-output failure.
+	return f.winReply(valid, true)
+}
+
+// Only closed concrete original owners whose private slot/lifecycle proof
+// succeeds may use this retained native entry. It supplies no owner or closer.
+func openUpgradeObservedImageFileInto(f *runtimeImageOpenFrame, parent windows.Handle, name string) (windows.Handle, error) {
+	if f == nil || !f.original() || f.parent != parent || f.name != name || name == "" || strings.ContainsAny(name, `\/`) {
+		return 0, ErrUpgrade
+	}
+	return f.ntCall(parent, name, windows.FILE_READ_DATA|windows.FILE_EXECUTE|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL|windows.SYNCHRONIZE, windows.FILE_SHARE_READ, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT)
+}
