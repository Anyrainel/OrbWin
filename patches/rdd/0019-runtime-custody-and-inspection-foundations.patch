+// A per-attempt strongly retained immutable observation of an actually flushed
+// file. This is not another owner or a durable flag: every reuse checks its
+// exact native object/body and every dependent effect still flushes its parent.
+// Retention prevents replacement after validation and avoids a second WRITE
+// reopen self-blocked by our own immutable handoff in the same actual attempt.
+type nativeFreshDenialDurableFile struct {
+	parent *runtimeStorageObject
+	name   string
+	object *runtimeStorageObject
+	body   []byte
+}
