+	if e != nil || len(g.files) != 6 || verifyPrivate(g.directory, sid, true) != nil {
+		return result
+	}
+	canonical, e := datastoreRecordBytes(g.record)
+	if e != nil {
+		return result
+	}
+	var versions [6]ConfigVersion
+	for n := range g.files {
+		if g.files[n] == 0 {
+			continue
+		}
+		if verifyPrivate(g.files[n], sid, false) != nil {
+			return result
+		}
+		data, v, e := g.readCleanupCell(&g.files[n], 64<<10)
+		if e != nil {
+			return result
+		}
+		if n == 0 {
+			if v.Hash != sha256.Sum256(canonical) {
+				return result
+			}
+		} else if hex.EncodeToString(v.Hash[:]) != g.record.Files[n-1] {
+			return result
+		}
+		versions[n] = v
+		clear(data)
+	}
+	want, e := g.cleanupIdentity(&g.directory)
+	if e != nil {
+		return result
+	}
+	// Final reaper cancellation admission after all hash/SD/ID preflight and
+	// immediately before consuming original read leases. After this cut cleanup
+	// is one-use and settles/retains without native cancellation.
+	if g.cleanupContext != nil && !datastoreGenerationAdmit(g.cleanupContext) {
+		g.cleanupNoEffectCancel = true
+		return result
+	}
+	for n := range g.files {
+		if g.closeCleanupCell(&g.files[n], &g.fileClose[n]) != nil {
+			return result
+		}
+	}
+	for _, n := range datastoreCleanupDeleteOrder() {
+		if !versions[n].Present {
+			continue
+		}
+		f := g.newCleanupFrame("file-delete", n)
+		if f == nil || f.open() != nil {
+			return result
+		}
+		data, v, e := g.readCleanupCell(f.output, 64<<10)
+		clear(data)
+		if e != nil {
+			return result
+		}
+		if verifyPrivate(*f.output, sid, false) != nil {
+			return g.failCleanup()
+		}
+		if v != versions[n] {
+			if g.closeCleanupCell(f.output, &f.close) != nil {
+				return result
+			}
+			return result
+		}
+		if f.remove() != nil {
+			return result
+		}
+	}
+	if g.closeCleanupCell(&g.directory, &g.directoryClose) != nil {
+		return result
+	}
+	f := g.newCleanupFrame("directory-delete", 0)
+	if f == nil || f.open() != nil {
+		return result
+	}
+	got, e := g.cleanupIdentity(f.output)
+	if e != nil {
+		return g.failCleanup()
+	}
+	if verifyPrivate(*f.output, sid, true) != nil {
+		return g.failCleanup()
+	}
+	if got != want {
+		if g.closeCleanupCell(f.output, &f.close) != nil {
+			return result
+		}
+		return result
+	}
+	if f.remove() != nil || g.closeHandles() != nil {
+		return result
+	}
+	g.closed = true
+	g.cleanupError = nil
+	if g.owner != nil {
+		g.owner.datastoreActive.Store(false)
+	}
+	g.releaseCleanup()
+	return nil
+}
+
+func (parent *DatastoreGeneration) reapDatastoreGeneration(ctx context.Context, sid, name string) (reaped bool, result error) {
+	if !parent.exactCleanup() || ctx == nil || ctx.Err() != nil {
+		return false, ErrPublication
+	}
+	if !datastoreCanonicalGenerationName(name) {
+		return false, nil
+	}
+	var e error
+	if len(parent.children) >= maxDatastoreGenerations {
+		return false, ErrPublication
+	}
+	g := &DatastoreGeneration{issuance: datastoreCleanupReaped, issuer: parent, reapName: name, started: true, files: make([]windows.Handle, 6)}
+	g.self = g
+	g.capture = &datastoreGenerationCapture{owner: g}
+	parent.children = append(parent.children, g)
+	if !holdDatastoreCleanup(g) {
+		parent.children = parent.children[:len(parent.children)-1]
+		return false, ErrPublication
+	}
+	admitted := false
+	defer func() {
+		if recover() != nil {
+			g.failCleanup()
+			result = ErrPublication
+			return
+		}
+		if !admitted || g.cleanupNoEffectCancel {
+			if g.unknown || g.closeHandles() != nil {
+				g.failCleanup()
+				result = ErrPublication
+				return
+			}
+			g.releaseCleanup()
+		}
+	}()
+	f := g.newCleanupFrame("history-read", 0)
+	if f == nil {
+		return false, g.failCleanup()
+	}
+	f.ctx = ctx
+	if f.open() != nil {
+		if !f.state.entered {
+			return false, ErrPublication
+		}
+		return false, g.failCleanup()
+	}
+	if verifyPrivate(g.directory, sid, true) != nil {
+		return false, g.failCleanup()
+	}
+	names, e := g.enumerateGenerationLocked(ctx, &g.directory)
+	if e != nil {
+		return false, g.failCleanup()
+	}
+	roles := datastoreNames()
+	allowed := map[string]bool{"owner.json": true}
+	for _, role := range roles {
+		allowed[role] = true
+	}
+	for _, present := range names {
+		if !allowed[present] {
+			return false, nil
+		}
+	}
+	for n := 0; n < 6; n++ {
+		f = g.newCleanupFrame("file-read", n)
+		if f == nil {
+			return false, g.failCleanup()
+		}
+		f.ctx = ctx
+		e = f.open()
+		if e != nil && !f.state.entered {
+			return false, ErrPublication
+		}
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if n == 0 {
+				return false, nil
+			}
+			continue
+		}
+		if e != nil {
+			return false, g.failCleanup()
+		}
+		if verifyPrivate(g.files[n], sid, false) != nil {
+			return false, g.failCleanup()
+		}
+	}
+	data, _, e := g.readCleanupCell(&g.files[0], 2048)
+	if e != nil {
+		return false, e
+	}
+	record, e := parseDatastoreRecord(data, name)
+	clear(data)
+	if e != nil || ctx.Err() != nil {
+		return false, nil
+	}
+	g.record = record
+	disposition, e := g.observeHistoricalOwnerLocked(ctx)
+	if e != nil {
+		return false, e
+	}
+	if disposition != datastoreOwnerAbsent && disposition != datastoreOwnerDead && disposition != datastoreOwnerRecycled {
+		return false, nil
+	}
+	if ctx.Err() != nil {
+		return false, nil
+	}
+	// Destructive cleanup begins only after the final cancellation gate. The
+	// original parent root is borrowed; no duplicate or second closer exists.
+	g.record, g.retired, g.constructionComplete = record, true, true
+	g.cleanupContext = ctx
+	admitted = true
+	e = g.Close()
+	if e != nil {
+		return false, e
+	}
+	return true, nil
+}
diff --git a/rdd/pkg/managementconfig/datastore_cleanup_windows_test.go b/rdd/pkg/managementconfig/datastore_cleanup_windows_test.go
