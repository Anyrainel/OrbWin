@@ -0,0 +1,89 @@
+//go:build windows
+
+package hostagent
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/util/process"
+)
+
+// ConsumeManagedLifetimeArguments is called from the first main-entry path,
+// before ordinary environment/Cobra work. Package initializers on this path
+// are separately audited; they must not spawn WSL/SSH descendants.
+func ConsumeManagedLifetimeArguments(args []string) ([]string, error) {
+	index := -1
+	for i, arg := range args {
+		if strings.HasPrefix(arg, "--orbwin-native-lifetime") {
+			if arg != "--orbwin-native-lifetime" || index != -1 || i+1 >= len(args) {
+				return nil, errors.New("owned hostagent lifetime refused")
+			}
+			index = i
+		}
+	}
+	if index == -1 {
+		return args, nil
+	}
+	if len(args) < 3 || args[1] != "hostagent" || os.Getenv("RDD_INSTANCE") != "orbwin" {
+		return nil, errors.New("owned hostagent lifetime refused")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if managementconfig.ConsumeManagedHostagentLifetime(ctx, args[index+1]) != nil {
+		return nil, errors.New("owned hostagent lifetime refused")
+	}
+	return append(args[:index:index], args[index+2:]...), nil
+}
+
+func requireManagedLifetime(instance string) error {
+	if os.Getenv("RDD_INSTANCE") != "orbwin" {
+		return nil
+	}
+	if instance != "orbwin" || managementconfig.RequireManagedHostagentLifetime() != nil {
+		return errors.New("owned hostagent lifetime refused")
+	}
+	return nil
+}
+
+func registerHostagentLifetimeInterrupt(ctx context.Context, name string, signalCh chan<- os.Signal) (func() error, error) {
+	if os.Getenv("RDD_INSTANCE") != "orbwin" {
+		release, e := process.RegisterInterruptHandler(process.HostagentInterruptKey(name), func() {
+			select {
+			case signalCh <- os.Interrupt:
+			default:
+			}
+		})
+		if e != nil {
+			return nil, e
+		}
+		return func() error { release(); return nil }, nil
+	}
+	if name != "orbwin" || managementconfig.RequireManagedHostagentLifetime() != nil {
+		return nil, errors.New("owned hostagent lifetime refused")
+	}
+	watch, cancel := context.WithCancel(ctx)
+	done := make(chan error, 1)
+	go func() {
+		e := managementconfig.WaitManagedHostagentInterrupt(watch)
+		if e == nil || !errors.Is(e, context.Canceled) {
+			select {
+			case signalCh <- os.Interrupt:
+			default:
+			}
+		}
+		done <- e
+	}()
+	return func() error {
+		cancel()
+		e := <-done
+		if e != nil && !errors.Is(e, context.Canceled) {
+			return errors.New("owned hostagent interrupt unknown")
+		}
+		return nil
+	}, nil
+}
