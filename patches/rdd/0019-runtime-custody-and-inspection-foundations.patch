@@ -0,0 +1,129 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"runtime"
+	"unsafe"
+)
+
+// The actual NtCreateFile output cells and every referenced native input are
+// retained by the registered storage owner BEFORE native entry. One unbound
+// frame is allowed; successful callers attach its exact resource through keep.
+type runtimeStorageNativeOpenFrame struct {
+	owner       *nativeRuntimeStorage
+	resource    *runtimeStorageResource
+	text        *windows.NTUnicodeString
+	attributes  windows.OBJECT_ATTRIBUTES
+	descriptor  *windows.SECURITY_DESCRIPTOR
+	status      windows.IO_STATUS_BLOCK
+	rawStatus   uintptr
+	disposition uint32
+	state       runtimeStorageNativeOpenState
+}
+
+var runtimeStorageCreateFile = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtCreateFile")
+
+func (n *nativeRuntimeStorage) attachNativeOpen(h windows.Handle) *runtimeStorageResource {
+	f := n.nativeOpen
+	if f == nil || f.owner != n || f.resource == nil || f.resource.nativeOpen != f || f.resource.handle != h || h == 0 || h == windows.InvalidHandle || n.unknown || !runtimeStorageDomainKnown() || !f.state.attach() {
+		n.fence()
+		panic(ErrUpgrade) // Never inspect an unbound/unknown/mismatched output.
+	}
+	n.resources = append(n.resources, f.resource)
+	n.nativeOpen = nil // Exact completed resource now held by original resources.
+	return f.resource
+}
+func (n *nativeRuntimeStorage) nativeOpenResourceKnown(r *runtimeStorageResource) bool {
+	if !n.win32ResourceKnown(r) {
+		return false
+	}
+	f := r.nativeOpen
+	if f == nil {
+		return true
+	} // Existing synchronous resource lanes unchanged.
+	if f.owner != n || f.resource != r || !f.state.usable() || n.nativeOpen == f {
+		return false
+	}
+	count := 0
+	for _, actual := range n.resources {
+		if actual == r {
+			count++
+		}
+	}
+	return count == 1
+}
+func (n *nativeRuntimeStorage) nativeOpenReply(f *runtimeStorageNativeOpenFrame) (windows.Handle, error) {
+	if n == nil || f == nil || n.nativeOpen != f || f.owner != n || f.resource == nil || f.resource.nativeOpen != f || n.unknown || !runtimeStorageDomainKnown() {
+		if n != nil {
+			n.fence()
+		}
+		return 0, ErrUpgrade
+	}
+	r := f.resource
+	status := uint32(f.rawStatus) // NTSTATUS is low32; HANDLE/Information stay wide.
+	kind := runtimeStorageClassifyNativeOpen(status, uint32(f.status.Status), f.status.Information, f.disposition, r.handle != 0, r.handle != 0 && r.handle != windows.InvalidHandle)
+	if !f.state.reply(kind) {
+		n.fence()
+		return 0, ErrUpgrade
+	}
+	if kind == runtimeStorageNativeOpenFailure {
+		n.nativeOpen = nil // Exact synchronous terminal no-output frame only.
+		return 0, windows.NTStatus(status)
+	}
+	return r.handle, nil // Still held by n.nativeOpen until exact keep attachment.
+}
+func (n *nativeRuntimeStorage) open(parent windows.Handle, name string, directory bool, disposition, access, share uint32, sd *windows.SECURITY_DESCRIPTOR) (h windows.Handle, failure error) {
+	if n == nil || n.captureSelf != n || !n.captureStarted || n.closeAttempted || n.unknown {
+		return 0, ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known {
+		return 0, ErrUpgrade
+	}
+	if n.nativeOpen != nil || n.win32Open != nil {
+		n.fence()
+		return 0, ErrUpgrade
+	}
+	if disposition != windows.FILE_OPEN && disposition != windows.FILE_CREATE && disposition != windows.FILE_OPEN_IF {
+		return 0, ErrUpgrade
+	}
+	parentOwned := false
+	for _, r := range n.resources {
+		if r != nil && r.handle == parent && parent != 0 && parent != windows.InvalidHandle && !r.attempted {
+			parentOwned = true
+			break
+		}
+	}
+	if !parentOwned {
+		return 0, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	f := &runtimeStorageNativeOpenFrame{owner: n, text: text, descriptor: sd, disposition: disposition}
+	f.resource = &runtimeStorageResource{nativeOpen: f}
+	f.attributes = windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: f.text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: f.descriptor}
+	f.attributes.Length = uint32(unsafe.Sizeof(f.attributes))
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options |= windows.FILE_DIRECTORY_FILE
+	} else {
+		options |= windows.FILE_NON_DIRECTORY_FILE
+	}
+	n.nativeOpen = f // Original HANDLE, IOSB, text, OA and SD custody before call.
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			panic(p)
+		}
+	}()
+	f.state.entered = true
+	f.rawStatus, _, _ = runtimeStorageCreateFile.Call(uintptr(unsafe.Pointer(&f.resource.handle)), uintptr(access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE), uintptr(unsafe.Pointer(&f.attributes)), uintptr(unsafe.Pointer(&f.status)), 0, 0, uintptr(share), uintptr(disposition), uintptr(options), 0, 0)
+	runtime.KeepAlive(f)
+	return n.nativeOpenReply(f)
+}
