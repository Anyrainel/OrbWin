diff --git a/rdd/pkg/managementconfig/runtime_fresh_app_gate_test.go b/rdd/pkg/managementconfig/runtime_fresh_app_gate_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c4bdb22ba3eb6d737ee67804452e3a0bc5975963
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_app_gate_test.go
@@ -0,0 +1,77 @@
+package managementconfig
+
+import (
+	"k8s.io/apimachinery/pkg/util/sets"
+	request "k8s.io/apiserver/pkg/endpoints/request"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestRuntimeFreshAppGateUsesActualRequestInfo(t *testing.T) {
+	factory := request.RequestInfoFactory{APIPrefixes: sets.NewString("api", "apis"), GrouplessAPIPrefixes: sets.NewString("api")}
+	for _, test := range []struct {
+		method, path string
+		allowed      bool
+	}{
+		{"POST", "/apis/app.rancherdesktop.io/v1alpha1/apps", false},
+		{"POST", "/apis/app.rancherdesktop.io/v999/singular-alias", false},
+		{"POST", "/apis/app.rancherdesktop.io/v1alpha1/namespaces/any/apps", false},
+		{"PATCH", "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/any/limavms/orbwin/status", false},
+		{"DELETE", "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/any/limavms", false},
+		{"PUT", "/apis/app.rancherdesktop.io/v1alpha1/apps/app", false},
+		{"CONNECT", "/apis/lima.rancherdesktop.io/v1alpha1/limavms", false},
+		{"GET", "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/any/limavms/orbwin/exec", false},
+		{"GET", "/apis/app.rancherdesktop.io/v1alpha1/proxy/apps/app", false},
+		{"POST", "/apis/app.rancherdesktop.io/v1alpha1/watch/apps", false},
+		{"POST", "/apis/app.rancherdesktop.io/v1alpha1/%61pps%2fapp", false},
+		{"POST", "/apis/app.rancherdesktop.io/v1alpha1/apps/../unknown", false},
+		{"POST", "/apis/app.rancherdesktop.io", false},
+		{"GET", "/apis/app.rancherdesktop.io/v1alpha1/apps", true},
+		{"GET", "/apis/app.rancherdesktop.io/v1alpha1/watch/apps", true},
+		{"GET", "/apis/lima.rancherdesktop.io/v1alpha1/limavms?watch=true", true},
+		{"GET", "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/any/limavms/orbwin/status", true},
+		{"POST", "/apis/apiextensions.k8s.io/v1/customresourcedefinitions", true},
+		{"POST", "/api/v1/namespaces", true},
+	} {
+		t.Run(test.method+" "+test.path, func(t *testing.T) {
+			r := httptest.NewRequest(test.method, test.path, nil)
+			r.Header.Set("Impersonate-User", "system:apiserver")
+			info, e := factory.NewRequestInfo(r)
+			if e != nil {
+				if test.allowed {
+					t.Fatal(e)
+				}
+				return
+			}
+			r = r.WithContext(request.WithRequestInfo(r.Context(), info))
+			if got := freshAppPendingRequestAllowed(r); got != test.allowed {
+				t.Fatalf("policy=%v expected=%v resolved=%+v", got, test.allowed, info)
+			}
+		})
+	}
+	for _, info := range []*request.RequestInfo{nil, {}, {APIGroup: "app.rancherdesktop.io", Verb: "create"}} {
+		r := httptest.NewRequest(http.MethodPost, "/apis/app.rancherdesktop.io/v1alpha1/apps", nil)
+		if info != nil {
+			r = r.WithContext(request.WithRequestInfo(r.Context(), info))
+		}
+		if freshAppPendingRequestAllowed(r) {
+			t.Fatal("missing/malformed RequestInfo delegated mutation")
+		}
+	}
+}
+
+func TestRuntimeFreshAppGateZeroAndCopiesCannotDelegate(t *testing.T) {
+	called := false
+	inner := http.HandlerFunc(func(http.ResponseWriter, *http.Request) { called = true })
+	g := &FreshAppGate{}
+	g.self = g
+	copy := &FreshAppGate{self: g, binding: g.binding}
+	for _, gate := range []*FreshAppGate{nil, {}, g, copy} {
+		response := httptest.NewRecorder()
+		gate.WrapResourceHandler(inner).ServeHTTP(response, httptest.NewRequest("POST", "/apis/app.rancherdesktop.io/v1alpha1/apps", nil))
+		if called || response.Code != http.StatusServiceUnavailable {
+			t.Fatal("unissued gate delegated request")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_app_gate_windows.go b/rdd/pkg/managementconfig/runtime_fresh_app_gate_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..0d074f5f10f482b3e197b3970ce7fe7c2848d961
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_app_gate_windows.go
@@ -0,0 +1,122 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+type nativeFreshAppGateBinding struct {
+	self *nativeFreshAppGateBinding
+	gate *FreshAppGate
+	w    *FreshRuntimeObservation
+}
+
+// Only immutable birth references are read on the HTTP path. Live/native
+// validation belongs to Capture/Begin/Seal, outside request-handler locks.
+func nativeFreshAppGateOriginal(g *FreshAppGate) bool {
+	if g == nil || g.self != g {
+		return false
+	}
+	b, ok := g.binding.(*nativeFreshAppGateBinding)
+	if !ok || b == nil || b.self != b || b.gate != g || b.w == nil {
+		return false
+	}
+	w := b.w
+	o := w.owner
+	return w.self == w && w.gate == g && o != nil && o.self == o && o.observation == w && o.created == w.created && w.created != nil && w.publisher != nil
+}
+
+// Pre-listen validation deliberately does not require a completed listener or
+// ServingIdentity. Those are unavailable until the real server is prepared.
+func (w *FreshRuntimeObservation) checkFreshGateParentsLocked(ctx context.Context) error {
+	o, c, p := w.owner, w.created, w.publisher
+	if !freshBoundedContext(ctx) || !w.exactLocked(o, c, p) || o.unknown || o.closed || !o.captureComplete || o.origin == nil || o.image == nil || o.storage == nil || w.unknown || w.closed || p.closed || p.closeErr != nil || p.pending != nil {
+		return ErrUpgrade
+	}
+	backend, ok := p.backend.(*nativeAuthority)
+	if !ok || backend == nil || backend.created != c {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	createdBad := c.closed || c.closeErr != nil || !c.servingLease || c.anchor == 0
+	c.mu.Unlock()
+	if createdBad || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if c.closed || c.closeErr != nil || !c.servingLease || c.anchor == 0 || !o.nativeOutputsAdmittedLocked() || n.check() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (o *FreshSetupOwner) CaptureFreshAppGate(ctx context.Context, c *Created, p *ConfigPublisher) (gate *FreshAppGate, result error) {
+	if o == nil || o.self != o || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w, e := o.prepareFreshAppWitnessLocked(ctx, c, p)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			result = ErrUpgrade
+		}
+	}()
+	if w.gate != nil || w.checkFreshGateParentsLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	g := &FreshAppGate{}
+	g.self = g
+	b := &nativeFreshAppGateBinding{gate: g, w: w}
+	b.self = b
+	g.binding = b
+	w.gate = g // Actual original retained observation, before API can serve.
+	return g, nil
+}
+
+// Seal before CRD/classification/decision exists too. This only denies future
+// App/Lima writes; service must separately prove its manager Start never ran
+// and join its actual API/kine resources before releasing native parents.
+func (g *FreshAppGate) SealPending(ctx context.Context, c *Created, p *ConfigPublisher) error {
+	if !nativeFreshAppGateOriginal(g) || c == nil || p == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	b := g.binding.(*nativeFreshAppGateBinding)
+	w := b.w
+	o := w.owner
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if c != w.created || p != w.publisher || w.checkFreshGateParentsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return g.sealPendingHeld(ctx, w)
+}
+
+// Original owner/witness/publisher are held; no recursive owner lock.
+func (g *FreshAppGate) sealPendingHeld(ctx context.Context, w *FreshRuntimeObservation) error {
+	if !nativeFreshAppGateOriginal(g) || w.gate != g || w.checkFreshGateParentsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.phase.Load() == freshAppGateOpen {
+		return ErrUpgrade
+	}
+	g.phase.Store(freshAppGateSealed)
+	return nil
+}
