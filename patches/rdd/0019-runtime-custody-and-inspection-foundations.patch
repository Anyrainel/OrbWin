+func oldListenerBorrowedModel(t *testing.T) (*nativeUpgradeOldListenerObservation, *runtimeStorageResource) {
+	t.Helper()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	l := &upgradeLegacyInventory{captureComplete: true}
+	l.captureSelf = l
+	a := &nativeRuntimeUpgradeArgs{storage: n, inventory: l, resource: &runtimeStorageResource{handle: 1}}
+	a.self = a
+	c := &nativeRuntimeUpgradeCredentials{args: a, storage: n, resource: &runtimeStorageResource{}, body: []byte("synthetic owned credential body"), data: runtimeUpgradeCredentialData{endpoint: "https://127.0.0.1:6550"}}
+	c.self = c
+	r := &runtimeStorageResource{}
+	o := &nativeUpgradeOldListenerObservation{credentials: c, args: a, storage: n, resources: []*runtimeStorageResource{r}, port: 6550}
+	o.self = o
+	n.resources = []*runtimeStorageResource{a.resource, c.resource, r}
+	runtimeStorageDomain.Lock()
+	beforeFailed := runtimeStorageDomain.failed
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
