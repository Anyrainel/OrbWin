+type runtimeManagementMemoryConnection struct {
+	input             io.Reader
+	out               bytes.Buffer
+	writes, readBytes int
+	short             bool
+	writeError        error
+	closed            bool
+}
+
+func (c *runtimeManagementMemoryConnection) Read(p []byte) (int, error) {
+	n, err := c.input.Read(p)
+	c.readBytes += n
+	return n, err
+}
+func (c *runtimeManagementMemoryConnection) Write(p []byte) (int, error) {
+	c.writes++
+	c.out.Write(p)
+	if c.short {
+		return len(p) - 1, nil
+	}
+	if c.writeError != nil {
+		return 0, c.writeError
+	}
+	return len(p), nil
+}
+func (c *runtimeManagementMemoryConnection) Close() error { c.closed = true; return nil }
+func runtimeManagementResponse(body string) string {
+	return fmt.Sprintf("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n\r\n%s", len(body), body)
+}
