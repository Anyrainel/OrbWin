+func TestRuntimeUpgradeCredentialsBoundedReader(t *testing.T) {
+	body := []byte("private synthetic bytes")
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, chunk := range []int{1, 7, len(body)} {
+		r := bytes.NewReader(body)
+		got, e := readRuntimeUpgradeCredentials(ctx, uint64(len(body)), func() error { _, e := r.Seek(0, 0); return e }, func(b []byte) (uint32, error) {
+			if len(b) > chunk {
+				b = b[:chunk]
+			}
+			n, e := r.Read(b)
+			return uint32(n), e
+		})
+		if e != nil || !bytes.Equal(got, body) {
+			t.Fatal("bounded short-chunk read refused")
+		}
+	}
+	for _, fault := range []string{"short", "extra", "zero", "oversized", "read-error", "seek-error", "cancel", "no-deadline", "size"} {
+		local, stop := context.WithTimeout(context.Background(), time.Second)
+		defer stop()
+		data := append([]byte{}, body...)
+		size := uint64(len(body))
+		var use context.Context = local
+		if fault == "short" {
+			data = data[:len(data)-1]
+		}
+		if fault == "extra" {
+			data = append(data, 'x')
+		}
+		if fault == "no-deadline" {
+			use = context.Background()
+		}
+		if fault == "size" {
+			size = runtimeUpgradeCredentialsBudget + 1
+		}
+		r := bytes.NewReader(data)
+		calls := 0
+		got, e := readRuntimeUpgradeCredentials(use, size, func() error {
+			if fault == "seek-error" {
+				return ErrUpgrade
+			}
+			return nil
+		}, func(b []byte) (uint32, error) {
+			calls++
+			if fault == "zero" {
+				return 0, nil
+			}
+			if fault == "oversized" {
+				return uint32(len(b) + 1), nil
+			}
+			if fault == "read-error" {
+				return 1, ErrUpgrade
+			}
+			if fault == "cancel" {
+				stop()
+			}
+			n, e := r.Read(b)
+			return uint32(n), e
+		})
+		if e == nil || got != nil {
+			t.Fatal("uncertain read accepted", fault)
+		}
+		if (fault == "seek-error" || fault == "no-deadline" || fault == "size") && calls != 0 {
+			t.Fatal("invalid admission reached read", fault)
+		}
+	}
+	calls := 0
+	if _, e := readRuntimeUpgradeCredentials(ctx, 0, func() error { calls++; return nil }, func([]byte) (uint32, error) { calls++; return 0, io.EOF }); e == nil || calls != 0 {
+		t.Fatal("zero size reached IO")
+	}
+}
