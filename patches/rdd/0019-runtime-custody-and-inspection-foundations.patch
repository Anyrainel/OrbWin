+		clear(body)
+		return nil, ErrUpgrade
+	}
+	return body, nil
+}
+
+func captureRuntimeUpgradeManagement(ctx context.Context, listener *nativeUpgradeOldListenerObservation, credentials *nativeRuntimeUpgradeCredentials) (out *nativeRuntimeUpgradeManagementObservation, failure error) {
+	if ctx == nil || ctx.Err() != nil || !runtimeUpgradeManagementBirth(listener, credentials) {
+		return nil, ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
