+package managementconfig
+
+import "testing"
+
+func TestRuntimeFreshRecoveryUnadmittedStageRequiresWholeNewObservation(t *testing.T) {
+	a := freshPublicationFixture()
+	intent := runtimeFreshIntent{Image: a.Runtime.BinarySHA, Commit: a.Runtime.SourceCommit}
+	body, e := encodeRuntimeIdentity(a.Runtime, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !runtimeFreshOrphanStageMatches(intent, body, a.Runtime, a.Runtime.Home) {
+		t.Fatal("exact observed record refused")
+	}
+	for _, change := range []func(*runtimeIdentityRecord){
+		func(r *runtimeIdentityRecord) { r.Daemon = "other-daemon" },
+		func(r *runtimeIdentityRecord) { r.Endpoint = "other-endpoint" },
+		func(r *runtimeIdentityRecord) { r.SourceCommit = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
+		func(r *runtimeIdentityRecord) {
+			r.BinarySHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+		},
+	} {
+		observed := a.Runtime
+		change(&observed)
+		if runtimeFreshOrphanStageMatches(intent, body, observed, a.Runtime.Home) {
+			t.Fatal("changed current observation admitted old stage")
+		}
+	}
+	if runtimeFreshOrphanStageMatches(intent, append(body, '{', '}'), a.Runtime, a.Runtime.Home) || runtimeFreshOrphanStageMatches(intent, body, a.Runtime, `C:\foreign`) {
+		t.Fatal("trailing JSON or different native home admitted")
+	}
+	wrong := intent
+	wrong.Image = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	if runtimeFreshOrphanStageMatches(wrong, body, a.Runtime, a.Runtime.Home) {
+		t.Fatal("stage from another source image admitted")
+	}
+	badStage := a.Stage
+	badStage.Object = UpgradeObject{}
+	if classifyRuntimeFreshRecovery(nil, nil, badStage, runtimePublicationFileWitness{}) != runtimeFreshRecoveryInvalid || classifyRuntimeFreshRecovery(nil, nil, a.Stage, a.Stage) != runtimeFreshRecoveryInvalid {
+		t.Fatal("malformed or both-name stage became recoverable")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_orphan_stage_windows.go b/rdd/pkg/managementconfig/runtime_fresh_orphan_stage_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..0b04ccc0c25d19358f04289b3a370c6f823af70f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_orphan_stage_windows.go
@@ -0,0 +1,38 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+)
+
+// The original stage producer flushes/closes/reopens its fixed stage before
+// writing admission. Its crash in that interval leaves no durable old-controller
+// claim to replay. This explicit recovery entry binds the actual captured stage
+// to the new live observation and CURRENT original controller; the ordinary
+// publisher then writes its first admission before any rename. No stage bytes
+// are rewritten and a metadata record cannot manufacture this capability.
+func (n *nativeRuntimeStorage) resumeUnadmittedPreparedStorage(ctx context.Context, observed runtimeIdentityRecord) (*nativeRuntimePrepared, error) {
+	if n == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	r := n.freshRecovery
+	if !r.admitted(n) || !r.complete || !runtimeMappedSelfStorageKnownLocked(n) || r.layoutLocked() != runtimeFreshRecoveryUnadmittedStage || r.admission != nil || r.committed != nil || r.stage == nil || r.target != nil || n.prepared || n.attempt.used {
+		return nil, ErrUpgrade
+	}
+	if !runtimeFreshOrphanStageMatches(r.owner.intent, r.stageBody, observed, n.home) || r.checkLayoutLocked(ctx) != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	// checkLayoutLocked reopens the actual fixed stage relative to SAME parent,
+	// compares exact ID/SD/body, positively closes that temporary, and proves the
+	// target absent. Only now can the existing sole publisher consume it.
+	n.stage = r.stage
+	n.stageBody = append([]byte(nil), r.stageBody...)
+	n.prepared = true
+	return &nativeRuntimePrepared{owner: n}, nil
+}
