+		if pe != windows.STATUS_OBJECT_NAME_NOT_FOUND || probe != nil {
+			return ErrUpgrade
+		}
+	} else {
+		if pe != nil || probe.identity != s.canonical.identity {
+			return ErrUpgrade
+		}
