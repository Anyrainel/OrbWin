+	Args, Initialization                                                        runtimePublicationFileWitness
+	Producer                                                                    UpgradeProcess
+	Template                                                                    []byte
+}
+
+var ErrFreshAppReconcile = errors.New("fresh App requires retained service reconciliation")
+
+func freshAppTemplate(transaction, nonce string) ([]byte, error) {
+	if !upgradeHex(transaction, 32) || !upgradeHex(nonce, 32) {
+		return nil, ErrUpgrade
+	}
+	a := freshRuntimeDesiredApp()
+	a.Annotations = map[string]string{freshAppTransactionAnnotation: transaction, freshAppCreateAnnotation: nonce}
+	return json.Marshal(a)
+}
+
+func (a runtimeFreshAppRecord) valid() bool {
+	if a.Schema != 1 || !upgradeHex(a.Transaction, 32) || !upgradeHex(a.Nonce, 32) || !a.Intent.valid() || !a.Parent.valid() || !a.Controller.valid() || !a.Authority.valid() || !a.AuthorityLock.valid() || !a.Args.valid() || !a.Initialization.valid() || !a.Producer.valid() || len(a.Template) == 0 || len(a.Template) > 4096 {
+		return false
+	}
+	for _, d := range [][32]byte{a.ParentDescriptor, a.ControllerDescriptor, a.AuthorityDescriptor, a.LockDescriptor} {
+		if d == [32]byte{} {
+			return false
+		}
+	}
+	if a.Parent == a.Controller || a.Parent.Volume != a.Controller.Volume || a.Authority == a.AuthorityLock || a.Authority.Volume != a.AuthorityLock.Volume || a.Intent.Object == a.Authority || a.Intent.Object == a.AuthorityLock || a.Args.Object == a.Initialization.Object {
+		return false
+	}
+	var desired app.App
+	if json.Unmarshal(a.Template, &desired) != nil {
+		return false
+	}
+	// Preserve the ORIGINAL bytes/defaults on recovery; validate only the
+	// closed supported creation contract, not today's regenerated defaults.
+	if desired.Name != "app" || desired.Namespace != "" || desired.UID != "" || desired.ResourceVersion != "" || desired.DeletionTimestamp != nil || desired.APIVersion != "app.rancherdesktop.io/v1alpha1" || desired.Kind != "App" || desired.Annotations[freshAppTransactionAnnotation] != a.Transaction || desired.Annotations[freshAppCreateAnnotation] != a.Nonce || len(desired.Annotations) != 2 || !desired.Spec.Running || desired.Spec.Namespace != freshRuntimeNamespace || desired.Spec.ContainerEngine.Name != "moby" || desired.Spec.Kubernetes.Enabled || string(desired.Spec.Application.AddPath) != "manual" {
+		return false
+	}
+	canonical, e := json.Marshal(&desired)
+	return e == nil && bytes.Equal(canonical, a.Template)
+}
+
+func freshAppMatches(a runtimeFreshAppRecord, object *app.App) bool {
+	return a.valid() && object != nil && object.Name == "app" && object.Namespace == "" && object.APIVersion == "app.rancherdesktop.io/v1alpha1" && object.Kind == "App" && upgradeASCII(string(object.UID), 128) && object.DeletionTimestamp == nil && object.Annotations[freshAppTransactionAnnotation] == a.Transaction && object.Annotations[freshAppCreateAnnotation] == a.Nonce && object.Spec.Running && object.Spec.Namespace == freshRuntimeNamespace && object.Spec.ContainerEngine.Name == "moby"
+}
+
+// Successful complete inventories are current DATA only. No resourceVersion
+// comparison is used to infer absence history or to mint ownership.
+func freshAppInventoriesEmpty(a *app.AppList, v *lima.LimaVMList) bool {
+	return a != nil && v != nil && a.APIVersion == "app.rancherdesktop.io/v1alpha1" && a.Kind == "AppList" && v.APIVersion == "lima.rancherdesktop.io/v1alpha1" && v.Kind == "LimaVMList" && a.Items != nil && v.Items != nil && len(a.Items) == 0 && len(v.Items) == 0 && a.Continue == "" && v.Continue == "" && (a.RemainingItemCount == nil || *a.RemainingItemCount == 0) && (v.RemainingItemCount == nil || *v.RemainingItemCount == 0) && upgradeASCII(a.ResourceVersion, 128) && upgradeASCII(v.ResourceVersion, 128)
+}
+
+func decodeFreshAppInventory(status int, body []byte, output any) error {
+	if status != 200 || len(body) == 0 || len(body) > freshRuntimeResponseBudget || json.Unmarshal(body, output) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_app_gate.go b/rdd/pkg/managementconfig/runtime_fresh_app_gate.go
new file mode 100644
index 0000000000000000000000000000000000000000..bc23c8be211df48268386c0e2303d6cec0db7a28
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_app_gate.go
@@ -0,0 +1,62 @@
+package managementconfig
+
+import (
+	request "k8s.io/apiserver/pkg/endpoints/request"
+	"net/http"
+	"sync"
+	"sync/atomic"
+)
+
+const (
+	freshAppGatePending uint32 = iota
+	freshAppGateSealed
+	freshAppGateOpen
+)
+
+// Policy only. Native binding is privately constructed from original c/p;
+// neither request identity nor a decoded consent can open this gate.
+type FreshAppGate struct {
+	self           *FreshAppGate
+	mu             sync.Mutex
+	phase          atomic.Uint32
+	pauseRechecked atomic.Bool
+	binding        any
+}
+
+func freshAppPendingRequestAllowed(r *http.Request) bool {
+	info, ok := request.RequestInfoFrom(r.Context())
+	if !ok || info == nil || info.Path == "" || info.Verb == "" {
+		return false
+	}
+	if !info.IsResourceRequest {
+		return (r.Method == http.MethodGet || r.Method == http.MethodHead) && (info.Verb == "get" || info.Verb == "head")
+	}
+	if info.APIVersion == "" || info.Resource == "" {
+		return false
+	}
+	if info.APIGroup != "app.rancherdesktop.io" && info.APIGroup != "lima.rancherdesktop.io" {
+		return true
+	}
+	if info.Subresource != "" && info.Subresource != "status" {
+		return false
+	}
+	return (r.Method == http.MethodGet || r.Method == http.MethodHead) && (info.Verb == "get" || info.Verb == "head" || info.Verb == "list" || info.Verb == "watch")
+}
+
+// Called beneath the EXISTING generic handler chain, after its RequestInfo
+// resolver/auth filters. All delegates share this same original gate. Open is
+// irreversible: no handler can be admitted then raced by pending teardown.
+func (g *FreshAppGate) WrapResourceHandler(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if g == nil || g.self != g || next == nil || !nativeFreshAppGateOriginal(g) {
+			http.Error(w, "setup is not admitted", http.StatusServiceUnavailable)
+			return
+		}
+		phase := g.phase.Load()
+		if phase == freshAppGateOpen || (phase == freshAppGatePending || phase == freshAppGateSealed) && freshAppPendingRequestAllowed(r) {
+			next.ServeHTTP(w, r)
+			return
+		}
+		http.Error(w, "setup is waiting for its original operation", http.StatusServiceUnavailable)
+	})
+}
