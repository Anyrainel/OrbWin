@@ -0,0 +1,231 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+// createdAdmissionLocked is entirely pre-native. Public methods require the
+// original registered owner, not a value copy with shared native pointers.
+func (o *FreshSetupOwner) createdAdmissionLocked(ctx context.Context) bool {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) || !o.captureComplete || o.unknown || o.closed || o.created != nil || o.fenceObject == nil || o.storage == nil || o.origin == nil || o.image == nil {
+		return false
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	return registered
+}
+
+// CreateServiceAuthority builds the real existing Created capability only from
+// this owner's actual flushed/reopened intent and held native storage. Saved
+// arguments are bounded DATA using the existing initialization schema. No
+// authority, TLS/db directory or args write precedes that durable fence.
+// This is one-use, including failure. No deletion or ordinary-path adoption.
+func (o *FreshSetupOwner) CreateServiceAuthority(ctx context.Context, args []byte) (*Created, error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	record, e := initializationBytes(args)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.createdAdmissionLocked(ctx) || !o.legacyDenialReadyLocked() || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if n.captureSelf != n || !n.captureComplete || n.captureKind != runtimeStorageFreshCapture || n.checkPrevious() != nil || n.checkObject(o.fenceObject) != nil {
+		return nil, ErrUpgrade
+	}
+	body, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(body)
+	if e != nil || intent != o.intent {
+		return nil, ErrUpgrade
+	}
+	if o.checkLegacyStartDenialLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	return o.createFreshServiceAuthorityNativeLocked(ctx, args, record)
+}
+
+// Lower actual producer only. Callers hold original o.mu/n.mu/thread, after
+// their DISTINCT original CREATE or concrete retained-control recovery proof.
+// No caller mode, decoded flag or alternate Created can supply native lineage.
+func (o *FreshSetupOwner) createFreshServiceAuthorityNativeLocked(ctx context.Context, args, record []byte) (*Created, error) {
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || !freshBoundedContext(ctx) || o.created != nil || n.checkPrevious() != nil || validateInitialization(record, args) != nil {
+		return nil, ErrUpgrade
+	}
+	// Publish the actual partial Created graph BEFORE duplication/creation. Its
+	// ancestor duplicate slots are registered before each native output.
+	c := &Created{parents: &ParentLease{sid: n.sid}}
+	o.created = c
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			o.unknown = true
+			panic(p)
+		}
+	}()
+	for _, parent := range n.ancestry {
+		if ctx.Err() != nil || n.checkObject(parent) != nil {
+			return nil, ErrUpgrade
+		}
+		c.parents.chain = append(c.parents.chain, 0)
+		i := len(c.parents.chain) - 1
+		e := windows.DuplicateHandle(windows.CurrentProcess(), parent.resource.handle, windows.CurrentProcess(), &c.parents.chain[i], 0, false, windows.DUPLICATE_SAME_ACCESS)
+		if e != nil || c.parents.chain[i] == 0 || c.parents.chain[i] == windows.InvalidHandle {
+			n.fence()
+			o.unknown = true
+			return nil, ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(c.parents.chain[i], n.sid, parent.directory, parent.private, parent.traversal)
+		if e != nil || id != parent.identity {
+			return nil, ErrUpgrade
+		}
+	}
+	c.parent = c.parents.leaf()
+	sd, e := privateDescriptor(n.sid, true)
+	if e != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	var creator *runtimeStorageResource
+	var id runtimeStorageIdentity
+	if r := n.freshRecovery; r != nil && r.controlRetention != nil && r.controlRetention.newRoot != nil {
+		creator, id, e = r.controlRetention.resumeEmptyCreatorLocked(ctx, c)
+	} else {
+		creator, e = o.openFixed(c.parent, anchorName, true, windows.FILE_CREATE, windows.FILE_LIST_DIRECTORY, sd)
+		if e == nil {
+			id, e = runtimeStorageIdentityOf(creator.handle, n.sid, true, true, false)
+		}
+	}
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	if r := n.freshRecovery; r != nil && r.controlRetention != nil {
+		if r.controlRetention.admitNewRootLocked(ctx, c, creator, id) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	for _, name := range []string{"tls", "db"} {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		r, e := o.openFixed(creator.handle, name, true, windows.FILE_CREATE, windows.FILE_LIST_DIRECTORY, sd)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		if _, e = runtimeStorageIdentityOf(r.handle, n.sid, true, true, false); e != nil || n.closeTemporary(r) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	for _, file := range []struct {
+		name string
+		data []byte
+	}{{"args.json", args}, {"authority.init", record}} {
+		if o.writeCreatedFile(ctx, creator.handle, file.name, file.data) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	// A shareable authority lease comes ONLY from this actual checked reopen,
+	// never from a pending-fence flag. The closed creator's identity must match.
+	if n.closeTemporary(creator) != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	reader, e := o.openFixed(c.parent, anchorName, true, windows.FILE_OPEN, windows.FILE_LIST_DIRECTORY, nil)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(reader.handle, n.sid, true, true, false)
+	if e != nil || actual != id {
+		return nil, ErrUpgrade
+	}
+	// Exact tail transfer; c is already strongly retained by this actual owner.
+	c.anchor = reader.handle
+	n.resources = n.resources[:len(n.resources)-1]
+	reader.handle = 0
+	c.servingLease = true
+	// The lock is created once here and transferred into the existing Created
+	// owner. Any uncertainty leaves the actual Created and setup.lock retained.
+	lockSD, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	lock, e := o.openFixed(c.anchor, "authority.owner.lock", false, windows.FILE_CREATE, windows.GENERIC_READ|windows.GENERIC_WRITE, lockSD)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	lockID, e := runtimeStorageIdentityOf(lock.handle, n.sid, false, true, false)
+	if e != nil || lockID.size != 0 {
+		return nil, ErrUpgrade
+	}
+	c.authorityHandles = append(c.authorityHandles, lock.handle)
+	c.managedOwnerLock = lock.handle
+	n.resources = n.resources[:len(n.resources)-1]
+	lock.handle = 0
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if o.bindFreshAuthorityTupleStateLocked(ctx, c) != nil {
+		return nil, ErrUpgrade
+	}
+	if r := n.freshRecovery; r != nil && r.controlRetention != nil {
+		if r.controlRetention.completeCreatedRootLocked(ctx, c) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	return c, nil
+}
+
+// Caller holds owner.mu then native storage.mu. Fixed CREATE-only writes are
+// retained before native outputs, flushed, read back, then checked closed.
+func (o *FreshSetupOwner) writeCreatedFile(ctx context.Context, parent windows.Handle, name string, data []byte) error {
+	n := o.storage
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r, e := o.openFixed(parent, name, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, sd)
+	if e != nil {
+		return ErrUpgrade
+	}
+	for at := 0; at < len(data); {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		count, e := nativeWrite(r.handle, data[at:])
+		if e != nil || count < 1 || count > len(data)-at {
+			return ErrUpgrade
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(r.handle) != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(&runtimeStorageObject{resource: r, identity: id, private: true}, false)
+	if e != nil || !bytes.Equal(body, data) {
+		return ErrUpgrade
+	}
+	return n.closeTemporary(r)
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_completion_binding_test.go b/rdd/pkg/managementconfig/runtime_fresh_denial_completion_binding_test.go
