+}
+
+// TLS must never become the raw socket closer. An unexpected Close only latches
+// refusal and wakes I/O. The actor joins it and performs the sole cached raw
+// Close. Flag/deadline serialization is short and never held over Read/Write.
+func (c *runtimeUpgradeManagementAbortConn) Close() (failure error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.aborted = true
+	failure = ErrUpgrade
+	defer func() {
+		if recover() != nil {
+			failure = ErrUpgrade
+		}
+	}()
+	if !c.sealed && c.conn != nil {
+		_ = c.conn.SetDeadline(time.Now())
+	}
+	return failure
+}
+func (c *runtimeUpgradeManagementAbortConn) setDeadline(t time.Time, which uint8) (failure error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted || c.sealed || c.conn == nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			c.aborted = true
+			failure = ErrUpgrade
+		}
+	}()
+	if t.IsZero() || t.After(c.deadline) {
+		t = c.deadline
+	}
+	switch which {
+	case 0:
+		failure = c.conn.SetDeadline(t)
+	case 1:
+		failure = c.conn.SetReadDeadline(t)
+	default:
+		failure = c.conn.SetWriteDeadline(t)
+	}
+	if failure != nil {
+		c.aborted = true
+		return ErrUpgrade
+	}
+	return nil
+}
+func (c *runtimeUpgradeManagementAbortConn) SetDeadline(t time.Time) error {
+	return c.setDeadline(t, 0)
+}
+func (c *runtimeUpgradeManagementAbortConn) SetReadDeadline(t time.Time) error {
+	return c.setDeadline(t, 1)
+}
+func (c *runtimeUpgradeManagementAbortConn) SetWriteDeadline(t time.Time) error {
+	return c.setDeadline(t, 2)
+}
+func (c *runtimeUpgradeManagementAbortConn) sealAndJoin() bool {
+	c.mu.Lock()
+	if !c.sealed {
+		c.sealed = true
+		if c.active == 0 {
+			close(c.idle)
+		}
+	}
+	idle := c.idle
+	c.mu.Unlock()
+	<-idle
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return !c.aborted
+}
