@@ -0,0 +1,80 @@
+package managementconfig
+
+import (
+	"crypto/sha256"
+	"testing"
+)
+
+func denialDirectoryFixture() runtimeFreshDenialDirectoryRecipe {
+	a := freshPublicationFixture()
+	v := freshSeedIntentFixture()
+	return runtimeFreshDenialDirectoryRecipe{Schema: 1, Plan: runtimeFreshDenialPlan{Transaction: v.Transaction, Seed: v.Seed, Intent: a.Intent, PrivateParent: UpgradeObject{1, 2, 3}, PublicParent: a.Parent, Controller: a.Controller, PrivateDescriptor: [32]byte{1}, PublicDescriptor: [32]byte{2}, ControllerDescriptor: [32]byte{3}}}
+}
+func denialObservation(body []byte, id uint32) runtimeFreshDenialRecipeObservation {
+	return runtimeFreshDenialRecipeObservation{Body: body, File: runtimePublicationFileWitness{Object: UpgradeObject{1, 0, id}, Size: uint64(len(body)), Written: 1, Descriptor: [32]byte{1}, Body: sha256.Sum256(body)}}
+}
+func TestRuntimeFreshDenialOldPartialsUseOriginalPredecessorPlan(t *testing.T) {
+	first := denialDirectoryFixture()
+	first.Ordinal = 1
+	partial := first
+	partial.Ordinal = 0
+	p, _ := runtimeFreshRecordBytes(partial)
+	b, _ := runtimeFreshRecordBytes(first)
+	slots := []runtimeFreshDenialRecipeObservation{denialObservation(p[:len(p)-10], 20), denialObservation(b, 21)}
+	next := first
+	next.Ordinal = 3
+	next.Count = 1
+	next.Previous = slots[1].File
+	next.Prefix[0] = runtimeFreshLegacyDirectoryFact{Object: UpgradeObject{2, 0, 30}, Descriptor: [32]byte{4}}
+	partial = next
+	partial.Ordinal = 2
+	p, _ = runtimeFreshRecordBytes(partial)
+	b, _ = runtimeFreshRecordBytes(next)
+	slots = append(slots, denialObservation(p[:len(p)-10], 22), denialObservation(b, 23))
+	current := next
+	current.Ordinal = 4
+	current.Count = 2
+	current.Previous = slots[3].File
+	current.Prefix[1] = runtimeFreshLegacyDirectoryFact{Object: UpgradeObject{2, 0, 31}, Descriptor: [32]byte{5}}
+	if validateRuntimeFreshDenialDirectoryHistory(slots, current) != nil {
+		t.Fatal("legitimate old partial plans rejected after child progress")
+	}
+	bad := append([]runtimeFreshDenialRecipeObservation(nil), slots...)
+	wrong := current
+	wrong.Ordinal = 0
+	p, _ = runtimeFreshRecordBytes(wrong)
+	bad[0] = denialObservation(p[:len(p)-10], 20)
+	if validateRuntimeFreshDenialDirectoryHistory(bad, current) == nil {
+		t.Fatal("current expanded plan blessed an older partial")
+	}
+	bad = append([]runtimeFreshDenialRecipeObservation(nil), slots...)
+	bad[2] = denialObservation([]byte("foreign"), 22)
+	if validateRuntimeFreshDenialDirectoryHistory(bad, current) == nil {
+		t.Fatal("foreign partial accepted")
+	}
+}
+func TestRuntimeFreshDenialRecordsAndNamesAreBounded(t *testing.T) {
+	r := denialDirectoryFixture()
+	if !r.valid() {
+		t.Fatal("empty original prefix refused")
+	}
+	for _, change := range []func(*runtimeFreshDenialDirectoryRecipe){func(r *runtimeFreshDenialDirectoryRecipe) { r.Count = 5 }, func(r *runtimeFreshDenialDirectoryRecipe) { r.Ordinal = 16 }, func(r *runtimeFreshDenialDirectoryRecipe) { r.Plan.Seed = runtimeFreshSeedFact{} }, func(r *runtimeFreshDenialDirectoryRecipe) {
+		r.Prefix[0] = runtimeFreshLegacyDirectoryFact{Object: UpgradeObject{2, 0, 50}}
+	}} {
+		bad := r
+		change(&bad)
+		if bad.valid() {
+			t.Fatal("invalid prefix record accepted")
+		}
+	}
+	for _, name := range []func(uint32) (string, error){runtimeFreshDenialDirectoryName, runtimeFreshDenialRepairName, runtimeFreshDenialArchiveName, runtimeFreshDenialCompletionName} {
+		for i := uint32(0); i < 16; i++ {
+			if _, e := name(i); e != nil {
+				t.Fatal(e)
+			}
+		}
+		if _, e := name(16); e == nil {
+			t.Fatal("unbounded namespace")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_prefix_windows.go b/rdd/pkg/managementconfig/runtime_fresh_denial_prefix_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..794d8d16d957c6355f9f6d76b3ff194076f21ada
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_denial_prefix_windows.go
@@ -0,0 +1,959 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strings"
+)
+
+// This strongly retained original attachment is a phase of actual r/o/n,
+// not another manager/closer. Construction and native boundary validation are
+// deliberately separate from this pure output-custody predicate.
+type nativeFreshDenialPrefix struct {
+	self      *nativeFreshDenialPrefix
+	recovery  *nativeFreshRecoveryOwner
+	producer  *runtimeFreshLegacyDenial
+	seed      *runtimeStorageObject
+	guest     *nativeFreshGuestPreflight
+	count     uint32
+	probe     *runtimeStorageObject
+	probeBody []byte
+}
+
+// Explicit original early-cut constructor; it is selected before the completed
+// denial reader. It performs only observations, never creates missing roles.
+// Returned custody is incomplete and cannot be advertised as r.complete.
+func (r *nativeFreshRecoveryOwner) captureOriginalDenialPrefix(ctx context.Context) (result *nativeFreshDenialPrefix, failure error) {
+	if r == nil || r.owner == nil || r.owner.storage == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o, n := r.owner, r.owner.storage
+	if !r.admitted(n) || r.complete || o.captureComplete || o.origin == nil || o.image == nil || o.intent.Schema != 2 || !o.intent.valid() || r.denialPrefix != nil || o.legacyDenial != nil || r.guestPreflight != nil {
+		return nil, ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			result = nil
+			failure = ErrUpgrade
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	o.origin.mu.Lock()
+	defer o.origin.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	o.origin.lease.mu.Lock()
+	defer o.origin.lease.mu.Unlock()
+	if !r.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) || o.origin.lease != o.image || o.origin.checkNativeMappedSelfHeld(ctx, o.intent.Transaction) != nil || r.admission != nil || r.committed != nil || r.stage != nil || r.target != nil || n.predecessor != nil || o.created != nil {
+		return nil, ErrUpgrade
+	}
+	intentBody, e := n.read(o.fenceObject, false)
+	actualIntent, ie := parseRuntimeFreshIntent(intentBody)
+	if e != nil || ie != nil || actualIntent != o.intent {
+		return nil, ErrUpgrade
+	}
+	private := n.ancestry[len(n.ancestry)-1]
+	for _, name := range []string{anchorName, upgradeFenceName} {
+		object, e := n.openFreshExistingTracked(ctx, private.resource.handle, name, name == anchorName, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	p := &nativeFreshDenialPrefix{recovery: r}
+	p.self = p
+	d := &runtimeFreshLegacyDenial{owner: o, prefix: p, failure: ErrUpgrade}
+	p.producer = d
+	r.denialPrefix = p
+	o.legacyDenial = d
+	name, e := (runtimeFreshSeedName{o.intent.Transaction, o.intent.Image, o.intent.Commit, o.intent.Seed.Binding}).name()
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	p.seed, e = n.openFreshExistingTracked(ctx, private.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || p.seed.identity.size != 0 || runtimeFreshSeedObjectFact(p.seed, o.intent.Seed.Binding) != o.intent.Seed {
+		return nil, ErrUpgrade
+	}
+	g := &nativeFreshGuestPreflight{recovery: r}
+	p.guest = g
+	r.guestPreflight = g
+	guid, _, _, e := g.registryLocked(ctx)
+	if e != nil || guid != "" {
+		return nil, ErrUpgrade
+	}
+	d.boundary = n.parent
+	parent := n.parent
+	for role := 0; role < runtimeFreshLegacyDirectoryCount; role++ {
+		fixed, _ := runtimeFreshLegacyDirectoryName(role)
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, fixed, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE|windows.GENERIC_WRITE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			break
+		}
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		d.directories[role] = object
+		p.count++
+		var names []string
+		if role == runtimeFreshLegacyDirectoryCount-1 {
+			names, e = n.freshDenialDirectoryNamesLocked(ctx, d.directories)
+		} else {
+			names, e = datastoreDirectoryNames(object.resource.handle)
+		}
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		if role < runtimeFreshLegacyDirectoryCount-1 {
+			next, _ := runtimeFreshLegacyDirectoryName(role + 1)
+			if len(names) > 1 || (len(names) == 1 && names[0] != next) {
+				return nil, ErrUpgrade
+			}
+		} else {
+			allowed := map[string]bool{runtimeFreshLegacyDenialName: true}
+			for ordinal := uint32(0); ordinal < runtimeFreshDenialSlots; ordinal++ {
+				a, _ := runtimeFreshDenialRepairName(ordinal)
+				b, _ := runtimeFreshDenialArchiveName(ordinal)
+				c, _ := runtimeFreshDenialCompletionName(ordinal)
+				allowed[a], allowed[b], allowed[c] = true, true, true
+			}
+			if len(names) > 49 {
+				return nil, ErrUpgrade
+			}
+			for _, entry := range names {
+				if !allowed[entry] {
+					return nil, ErrUpgrade
+				}
+			}
+		}
+		parent = object
+	}
+	if p.count > 0 {
+		object, e := n.openFreshExistingTracked(ctx, d.directories[0].resource.handle, ".rdorbwin", true, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, false, true)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if p.count == runtimeFreshLegacyDirectoryCount {
+		p.probe, e = n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_READ_DATA|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_DELETE, true, false)
+		if e != nil && e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return nil, ErrUpgrade
+		}
+		if e == nil {
+			if p.probe.identity.size > runtimeFreshLegacyDenialBudget {
+				return nil, ErrUpgrade
+			}
+			p.probeBody, e = n.read(p.probe, true)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+		}
+	}
+	return p, nil
+}
+
+func (p *nativeFreshDenialPrefix) admittedProducerLocked(d *runtimeFreshLegacyDenial) bool {
+	if p == nil || p.self != p || p.recovery == nil || p.producer != d || d == nil || d.prefix != p || d.owner == nil || d.failed {
+		return false
+	}
+	r, o := p.recovery, d.owner
+	n := o.storage
+	if n == nil || r.owner != o || r.denialPrefix != p || o.legacyDenial != d || !r.admitted(n) || !runtimeMappedSelfStorageKnownLocked(n) || n.captureKind != runtimeStorageFreshCapture || o.intent.Schema != 2 || !o.intent.Seed.valid() || o.fenceObject == nil || o.origin == nil || o.image == nil || p.seed == nil || p.seed.resource == nil {
+		return false
+	}
+	seedOwned, intentOwned := false, false
+	for _, slot := range n.resources {
+		if slot == nil || slot.attempted || slot.handle == 0 {
+			continue
+		}
+		seedOwned = seedOwned || slot == p.seed.resource
+		intentOwned = intentOwned || slot == o.fenceObject.resource
+	}
+	return seedOwned && intentOwned
+}
+
+// Only this original unpublished constructor may settle its earlier verifier's
+// exact appended observations. Original intent/seed witnesses are not in this
+// list. Stop on the first uncertain close; never seek a different lease.
+func (p *nativeFreshDenialPrefix) closeVerificationLocked(slots []*runtimeStorageResource) error {
+	if p == nil || !p.admittedProducerLocked(p.producer) {
+		return ErrUpgrade
+	}
+	n := p.recovery.owner.storage
+	for i := len(slots) - 1; i >= 0; i-- {
+		r := slots[i]
+		found := false
+		for _, v := range n.resources {
+			found = found || v == r
+		}
+		if !found || r == nil || r.attempted || r.handle == 0 || n.closeTemporary(r) != nil {
+			p.producer.fenceLocked()
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+func (p *nativeFreshDenialPrefix) verifySeedLocked(ctx context.Context) error {
+	if p == nil || !p.admittedProducerLocked(p.producer) {
+		return ErrUpgrade
+	}
+	o, n := p.recovery.owner, p.recovery.owner.storage
+	b, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	start := len(n.resources)
+	e = n.checkFreshSeedIntentLocked(ctx, o.intent, runtimeStorageFileData(o.fenceObject, b))
+	slots := append([]*runtimeStorageResource(nil), n.resources[start:]...)
+	if n.unknown || p.closeVerificationLocked(slots) != nil || e != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Exact graph, mapped original image, complete source history, strict fixed
+// topology and registry/path absence precede every consequential early effect.
+// Caller owns origin->n->image and the original controller throughout.
+func (p *nativeFreshDenialPrefix) checkLocked(ctx context.Context) error {
+	if p == nil || !p.admittedProducerLocked(p.producer) || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	r, o, d := p.recovery, p.recovery.owner, p.producer
+	n := o.storage
+	if r.complete || o.captureComplete || r.admission != nil || r.committed != nil || r.stage != nil || r.target != nil || n.predecessor != nil || o.created != nil || o.origin.lease != o.image || o.origin.checkNativeMappedSelfHeld(ctx, o.intent.Transaction) != nil || p.verifySeedLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	private := n.ancestry[len(n.ancestry)-1]
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	seedName, _ := (runtimeFreshSeedName{o.intent.Transaction, o.intent.Image, o.intent.Commit, o.intent.Seed.Binding}).name()
+	allowed := map[string]bool{seedName: true, runtimeFreshFenceName: true}
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		a, _ := runtimeFreshDenialDirectoryName(i)
+		b, _ := runtimeFreshIntentRepairName(i)
+		c, _ := runtimeFreshIntentArchiveName(i)
+		allowed[a], allowed[b], allowed[c] = true, true, true
+	}
+	for _, name := range names {
+		if strings.HasPrefix(strings.ToLower(name), "authority.") && !allowed[name] {
+			return ErrUpgrade
+		}
+	}
+	for _, v := range []struct {
+		name      string
+		directory bool
+	}{{anchorName, true}, {upgradeFenceName, false}} {
+		object, e := n.openFreshExistingTracked(ctx, private.resource.handle, v.name, v.directory, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil {
+			return ErrUpgrade
+		}
+	}
+	guid, _, _, e := p.guest.registryLocked(ctx)
+	if e != nil || guid != "" {
+		return ErrUpgrade
+	}
+	parent := n.parent
+	for i := uint32(0); i < p.count; i++ {
+		o := d.directories[i]
+		if o == nil || n.checkObject(o) != nil {
+			return ErrUpgrade
+		}
+		name, _ := runtimeFreshLegacyDirectoryName(int(i))
+		probe, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+		if e != nil || probe.identity != o.identity || n.closeTemporary(probe.resource) != nil {
+			return ErrUpgrade
+		}
+		var names []string
+		if i == runtimeFreshLegacyDirectoryCount-1 {
+			names, e = n.freshDenialDirectoryNamesLocked(ctx, d.directories)
+		} else {
+			names, e = datastoreDirectoryNames(o.resource.handle)
+		}
+		if e != nil {
+			return ErrUpgrade
+		}
+		if i < runtimeFreshLegacyDirectoryCount-1 {
+			next, _ := runtimeFreshLegacyDirectoryName(int(i + 1))
+			if len(names) > 1 || (len(names) == 1 && names[0] != next) || i+1 == p.count && len(names) != 0 {
+				return ErrUpgrade
+			}
+		}
+		parent = o
+	}
+	if p.count < runtimeFreshLegacyDirectoryCount {
+		name, _ := runtimeFreshLegacyDirectoryName(int(p.count))
+		missing, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || missing != nil {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+// READ -> positive close -> exact WRITE OPEN, flush only -> positive close ->
+// immutable exact reopen. No bytes/facts are rewritten or regenerated. All
+// failures after the handoff fence the same owner, including close uncertainty.
+func (d *runtimeFreshLegacyDenial) persistFileLocked(ctx context.Context, parent *runtimeStorageObject, name string, object *runtimeStorageObject, body []byte, share uint32) (result *runtimeStorageObject, failure error) {
+	if !d.knownLocked() || d.prefix == nil || !d.denialFileRoleLocked(parent, name, false) || object == nil || len(body) > runtimeFreshRecordBudget || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n := d.owner.storage
+	expected := object.identity
+	defer func() {
+		if recover() != nil {
+			failure = ErrUpgrade
+		}
+		if failure != nil {
+			d.fenceLocked()
+		}
+	}()
