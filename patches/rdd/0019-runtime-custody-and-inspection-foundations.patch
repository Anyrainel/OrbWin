+)
+
+func isFreshService(privateAuthority) bool { return false }
+func prepareFreshManagerAdmission(context.Context, privateAuthority, *controllers.SharedControllerManager) error {
+	return nil
+}
+func markFreshManagerStartScheduled(privateAuthority) {}
+func awaitFreshManagerServing(context.Context, privateAuthority, *controllers.SharedControllerManager) error {
+	return nil
+}
+func retainFreshServiceAfterAdmissionError(_ context.Context, _ privateAuthority, e error) error {
+	return e
+}
+func recheckFreshPendingAfterJoins(privateAuthority, bool, bool) error { return nil }
+
+func serviceReadinessConfig(_ privateAuthority, _ *rest.Config) (*rest.Config, error) {
+	return GetKubeRestConfig()
+}
+
+func installFreshRequestGate(privateAuthority, *options.Config) error { return nil }
+func freshPreparationContext(ctx context.Context, _ privateAuthority) (context.Context, context.CancelFunc) {
+	return ctx, func() {}
+}
+func prepareFreshPendingRetirement(privateAuthority) bool { return true }
diff --git a/rdd/pkg/service/cmd/fresh_app_service_windows.go b/rdd/pkg/service/cmd/fresh_app_service_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef2b42c354847c7d02e6e1483b66cb2fb31a0800
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_app_service_windows.go
@@ -0,0 +1,225 @@
+//go:build windows
+
+package service
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd/options"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/controllers"
+	"github.com/sirupsen/logrus"
+	genericapiserver "k8s.io/apiserver/pkg/server"
+	"k8s.io/client-go/rest"
+)
+
+var errFreshSetupPaused = errors.New("private setup paused")
+
+func isFreshService(authority privateAuthority) bool { return freshPrivateOwner(authority) != nil }
+
+func prepareFreshManagerAdmission(ctx context.Context, authority privateAuthority, mgr *controllers.SharedControllerManager) error {
+	w := freshPrivateOwner(authority)
+	if w == nil {
+		return nil
+	}
+	if mgr == nil || w.freshGate == nil || w.freshManagerStartScheduled.Load() {
+		return errPrivateAuthority
+	}
+	if e := mgr.PrepareRegisteredResources(ctx); e != nil {
+		return freshSetupFailure{stage: freshStageReadiness}
+	}
+	d, e := w.freshOwner.PrepareFreshRuntimeApp(ctx, w.created, w.publisher)
+	w.freshDecision.Store(d)
+	if e != nil {
+		return freshSetupFailure{stage: freshStageObservation}
+	}
+	if d != nil {
+		reason, nonce, e := d.Data()
+		if e != nil {
+			return errPrivateAuthority
+		}
+		decisionContext, endDecision := context.WithTimeout(ctx, 5*time.Minute)
+		continued := w.freshObserver != nil && w.freshObserver.awaitDecision(decisionContext, reason, nonce)
+		endDecision()
+		if !continued {
+			w.freshPauseWanted = true
+			return errFreshSetupPaused
+		}
+		if w.freshOwner.ContinueFreshRuntimeApp(ctx, w.created, w.publisher, d, nonce) != nil {
+			return errPrivateAuthority
+		}
+	}
+	if !w.freshObserver.claimBegin() {
+		w.freshPauseWanted = true
+		return errFreshSetupPaused
+	}
+	// This is only a conservative loss of the never-called cleanup branch.
+	// The native gate, not this flag/consent, determines whether cleanup can
+	// subsequently be admitted; native Seal/Recheck/Confirm remain mandatory.
+	w.freshBeginAttempted.Store(true)
+	if w.freshOwner.BeginFreshRuntimeApp(ctx, w.created, w.publisher) != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+func markFreshManagerStartScheduled(authority privateAuthority) {
+	if w := freshPrivateOwner(authority); w != nil {
+		w.freshManagerStartScheduled.Store(true)
+	}
+}
+func awaitFreshManagerServing(ctx context.Context, authority privateAuthority, mgr *controllers.SharedControllerManager) error {
+	if !isFreshService(authority) {
+		return nil
+	}
+	observation, cancel := context.WithTimeout(ctx, 2*time.Minute)
+	defer cancel()
+	if mgr == nil || mgr.AwaitServingReady(observation) != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+// No UI/protocol error can auto-cancel actors after actual Begin. A successful
+// native pending seal still permits own control-only cleanup before Start.
+func retainFreshServiceAfterAdmissionError(ctx context.Context, authority privateAuthority, cause error) error {
+	w := freshPrivateOwner(authority)
+	if w == nil || prepareFreshPendingRetirement(authority) {
+		return cause
+	}
+	var failure freshSetupFailure
+	if !errors.As(cause, &failure) {
+		failure = freshSetupFailure{stage: freshStageReadiness}
+	}
+	logrus.WithField("stage", failure.stage.String()).Error("private setup incomplete; original service retained")
+	w.freshObserver.incomplete(failure.stage.String())
+	// Preserve the original actual manager/server. Unknown never turns into a
+	// second Start, repeated POST, positive readiness, or owner-close grant.
+	<-ctx.Done()
+	return cause
+}
+
+func serviceReadinessConfig(authority privateAuthority, loopback *rest.Config) (*rest.Config, error) {
+	if freshPrivateOwner(authority) == nil {
+		return GetKubeRestConfig()
+	}
+	if loopback == nil {
+		return nil, errPrivateAuthority
+	}
+	return loopback, nil
+}
+
+func freshPrivateOwner(authority privateAuthority) *windowsPrivateAuthority {
+	w, ok := authority.(*windowsPrivateAuthority)
+	if !ok || w == nil || w.freshOwner == nil {
+		return nil
+	}
+	return w
+}
+
+// Every delegate's actual original chain supplies auth and RequestInfo before
+// the gate sees a resource request. No header/user/URL-prefix bypass exists.
+func installFreshRequestGate(authority privateAuthority, config *options.Config) error {
+	w := freshPrivateOwner(authority)
+	if w == nil {
+		return nil
+	}
+	if config == nil || config.ControlPlane == nil || config.APIExtensions == nil || config.Aggregator == nil || config.ControlPlane.Generic == nil || config.APIExtensions.GenericConfig == nil || config.Aggregator.GenericConfig == nil {
+		return errPrivateAuthority
+	}
+	seen := map[*genericapiserver.Config]bool{}
+	for _, c := range []*genericapiserver.Config{config.ControlPlane.Generic, &config.APIExtensions.GenericConfig.Config, &config.Aggregator.GenericConfig.Config} {
+		if seen[c] {
+			continue
+		}
+		seen[c] = true
+		original := c.BuildHandlerChainFunc
+		if original == nil {
+			return errPrivateAuthority
+		}
+		c.BuildHandlerChainFunc = func(inner http.Handler, actual *genericapiserver.Config) http.Handler {
+			gate := http.HandlerFunc(func(response http.ResponseWriter, request *http.Request) {
+				if w.freshGate == nil {
+					http.Error(response, "private setup admission unavailable", http.StatusServiceUnavailable)
+					return
+				}
+				w.freshGate.WrapResourceHandler(inner).ServeHTTP(response, request)
+			})
+			return original(gate, actual)
+		}
+	}
+	return nil
+}
+
+func freshPreparationContext(ctx context.Context, authority privateAuthority) (context.Context, context.CancelFunc) {
+	w := freshPrivateOwner(authority)
+	if w == nil {
+		return ctx, func() {}
+	}
+	if w.freshObserver != nil {
+		return w.freshObserver.preparationContext(ctx)
+	}
+	if w.freshStartup == nil {
+		failed, cancel := context.WithCancel(ctx)
+		cancel()
+		return failed, cancel
+	}
+	deadline, ok := w.freshStartup.Deadline()
+	if !ok {
+		failed, cancel := context.WithCancel(ctx)
+		cancel()
+		return failed, cancel
+	}
+	return context.WithDeadline(ctx, deadline)
+}
+
+// A native pending seal is necessary for a positive paused receipt. Actor
+// cleanup before any Begin call is separately safe even if native cleanup is
+// unknown: this original manager was never started and its gate never opened.
+func prepareFreshPendingRetirement(authority privateAuthority) bool {
+	w := freshPrivateOwner(authority)
+	if w == nil {
+		return true
+	}
+	if w.freshManagerStartScheduled.Load() {
+		return false
+	}
+	bounded, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if w.freshGate != nil && w.freshOwner.PrepareFreshRuntimeAppPause(bounded, w.created, w.publisher, w.freshDecision.Load()) == nil {
+		w.freshPausePrepared.Store(true)
+		return true
+	}
+	return !w.freshBeginAttempted.Load()
+}
+
+func recheckFreshPendingAfterJoins(authority privateAuthority, retired, managerScheduled bool) error {
+	w := freshPrivateOwner(authority)
+	if w == nil || !w.freshPausePrepared.Load() {
+		return nil
+	}
+	if !retired || managerScheduled || w.freshManagerStartScheduled.Load() {
+		w.freshPausePrepared.Store(false)
+		return errPrivateAuthority
+	}
+	bounded, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if w.freshOwner.RecheckFreshRuntimeAppPause(bounded, w.created, w.publisher, w.freshDecision.Load()) != nil {
+		w.freshPausePrepared.Store(false)
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+func confirmFreshPendingAfterClose(w *windowsPrivateAuthority, result error) error {
+	if w == nil || !w.freshPausePrepared.Load() || !(w.freshPauseWanted || errors.Is(result, errFreshSetupPaused) || w.freshObserver.pauseRequested()) {
+		return result
+	}
+	if w.freshOwner.ConfirmFreshRuntimeAppPause(w.freshDecision.Load()) != nil {
+		return freshSetupFailure{stage: freshStageSettlement}
+	}
+	w.freshObserver.paused()
+	return nil
+}
