diff --git a/rdd/pkg/util/lifecyclefailure/failure.go b/rdd/pkg/util/lifecyclefailure/failure.go
new file mode 100644
index 0000000000000000000000000000000000000000..553cab640954222cc85c2f3ad741de700e9a1679
--- /dev/null
+++ b/rdd/pkg/util/lifecyclefailure/failure.go
@@ -0,0 +1,26 @@
+// Package lifecyclefailure carries only sticky negative shutdown information
+// from existing controller runnables to their original serving owner.
+package lifecyclefailure
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+type key struct{}
+type Failure struct{ failed atomic.Bool }
+
+func WithContext(ctx context.Context) (context.Context, *Failure) {
+	f := &Failure{}
+	return context.WithValue(ctx, key{}, f), f
+}
+
+// Record can only invalidate retirement. It cannot clear a prior failure or
+// certify resources/processes stopped. The serving owner retains its own f.
+func Record(ctx context.Context) {
+	if f, ok := ctx.Value(key{}).(*Failure); ok {
+		f.failed.Store(true)
+	}
+}
+
+func (f *Failure) Failed() bool { return f != nil && f.failed.Load() }
diff --git a/rdd/pkg/util/lifecyclefailure/failure_test.go b/rdd/pkg/util/lifecyclefailure/failure_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b30bf70ed69ed6b90d5ab44d370ffdc6d3b5583f
--- /dev/null
+++ b/rdd/pkg/util/lifecyclefailure/failure_test.go
@@ -0,0 +1,27 @@
+package lifecyclefailure
+
+import (
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestFailureIsStickyAndContextLocal(t *testing.T) {
+	ctx, f := WithContext(context.Background())
+	other, sibling := WithContext(context.Background())
+	if f.Failed() || sibling.Failed() {
+		t.Fatal("new latch already failed")
+	}
+	var joins sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		joins.Go(func() { Record(ctx) })
+	}
+	joins.Wait()
+	if !f.Failed() || sibling.Failed() {
+		t.Fatal("failure lost or leaked into other owner")
+	}
+	Record(other)
+	if !f.Failed() || !sibling.Failed() {
+		t.Fatal("failure was reset")
+	}
+}
