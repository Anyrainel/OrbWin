--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_terminal.go
@@ -0,0 +1,22 @@
+package managementconfig
+
+// Deferred directly by the sole terminal owner, before any cleanup effect.
+// Panic becomes stable failure; no suffix cleanup, retry, or success publication
+// follows it. The caller sets complete only after its entire positive sequence.
+func sdkFinishTerminal(armed *bool, cached, result *error, complete *bool, failure error, fence func()) {
+	panicked := recover() != nil
+	if !*armed && !panicked {
+		return
+	}
+	if panicked {
+		*armed = true
+	}
+	if panicked || !*complete || *result != nil {
+		*cached, *result = failure, failure
+		if fence != nil {
+			fence()
+		}
+		return
+	}
+	*cached = nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_terminal_test.go b/rdd/pkg/managementconfig/upgrade_sdk_terminal_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ee7cbc1e6d5500671dbe3c9d50da64005649e29a
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_terminal_test.go
@@ -0,0 +1,82 @@
+package managementconfig
+
+import (
+	"errors"
+	"testing"
+)
+
+// The same directly deferred finalizer used by native owners. Steps model
+// dependent closes, final owner close, and deferred borrower bookkeeping.
+type sdkTerminalFixture struct {
+	attempted, complete bool
+	cached              error
+	calls, fenced       int
+}
+
+func (f *sdkTerminalFixture) run(cut int, fail bool) (result error) {
+	if f.attempted {
+		return f.cached
+	}
+	failure := errors.New("terminal uncertain")
+	f.attempted, f.cached, result = true, failure, failure
+	defer sdkFinishTerminal(&f.attempted, &f.cached, &result, &f.complete, failure, func() { f.fenced++ })
+	for step := 0; step < 5; step++ {
+		f.calls++
+		if step == cut {
+			if fail {
+				return failure
+			}
+			panic("lost terminal reply")
+		}
+	}
+	f.complete = true
+	return nil
+}
+func TestSDKTerminalPanicAndFailureNeverReplaySuccess(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		for cut := 0; cut < 5; cut++ {
+			f := new(sdkTerminalFixture)
+			if f.run(cut, fail) == nil || f.cached == nil || f.complete || f.calls != cut+1 || f.fenced != 1 {
+				t.Fatalf("cut %d fail %v: %+v", cut, fail, f)
+			}
+			if f.run(-1, false) == nil || f.calls != cut+1 || f.fenced != 1 {
+				t.Fatalf("replay: %+v", f)
+			}
+		}
+	}
+}
+func TestSDKTerminalSuccessOnlyAfterComplete(t *testing.T) {
+	f := new(sdkTerminalFixture)
+	if f.run(-1, false) != nil || f.cached != nil || !f.complete || f.calls != 5 || f.fenced != 0 {
+		t.Fatal(f)
+	}
+	if f.run(0, false) != nil || f.calls != 5 {
+		t.Fatal("successful replay reentered")
+	}
+}
+func TestSDKTerminalNilResultWithoutCompletionFails(t *testing.T) {
+	failure := errors.New("incomplete")
+	armed, complete := true, false
+	var cached error
+	run := func() (result error) {
+		defer sdkFinishTerminal(&armed, &cached, &result, &complete, failure, nil)
+		return nil
+	}
+	if run() != failure || cached != failure {
+		t.Fatal("incomplete nil published")
+	}
+}
+func TestSDKTerminalDeferredBookkeepingPanic(t *testing.T) {
+	failure := errors.New("bookkeeping uncertain")
+	armed, complete := true, false
+	var cached error
+	fenced := false
+	run := func() (result error) {
+		defer sdkFinishTerminal(&armed, &cached, &result, &complete, failure, func() { fenced = true })
+		defer func() { panic("borrow release") }()
+		return nil
+	}
+	if run() != failure || cached != failure || !fenced {
+		t.Fatal("deferred panic escaped failure cache")
+	}
+}
