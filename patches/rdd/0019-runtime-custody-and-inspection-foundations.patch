@@ -0,0 +1,34 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+)
+
+// Compile-only actual method/context test. The original lock is real, but no
+// native resource is acquired and no fake handle is passed to an API.
+func TestStoragePrepareActualLockedCancellationRefusesBeforeChecks(t *testing.T) {
+	base, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ctx := &observedPrepareContext{Context: base, first: make(chan struct{})}
+	n := &nativeRuntimeStorage{}
+	n.mu.Lock()
+	done := make(chan error, 1)
+	go func() {
+		ready, e := n.prepareStorage(ctx, runtimeIdentityRecord{})
+		if ready != nil {
+			done <- nil
+			return
+		}
+		done <- e
+	}()
+	<-ctx.first
+	cancel()
+	n.mu.Unlock()
+	e := <-done
+	if e == nil || ctx.calls.Load() < 2 || n.prepared || n.stage != nil || n.nativeOpen != nil || n.win32Open != nil || n.ioFrame != nil || n.renameFrame != nil || len(n.resources) != 0 {
+		t.Fatal("cancellation passed locked native admission")
+	}
+}
