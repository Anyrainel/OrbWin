+// Use the real API serializers. In particular Lima's Running condition has no
+// observedGeneration, and unrelated upstream spec/status fields are allowed.
+func runtimeManagementFixture(t *testing.T) ([]byte, []byte) {
+	t.Helper()
+	controller := true
+	app := appapi.App{TypeMeta: metav1.TypeMeta{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "App"}, ObjectMeta: metav1.ObjectMeta{Name: "app", UID: "app-one", ResourceVersion: "10", Generation: 3}, Spec: appapi.AppSpec{Running: true, Namespace: "workloads"}, Status: appapi.AppStatus{Conditions: []metav1.Condition{{Type: "Settled", Status: metav1.ConditionTrue, Reason: "Settled", ObservedGeneration: 3}}}}
+	vm := limaapi.LimaVM{TypeMeta: metav1.TypeMeta{APIVersion: "lima.rancherdesktop.io/v1alpha1", Kind: "LimaVM"}, ObjectMeta: metav1.ObjectMeta{Name: "orbwin", Namespace: "workloads", UID: "vm-one", ResourceVersion: "20", Generation: 2, OwnerReferences: []metav1.OwnerReference{{APIVersion: app.APIVersion, Kind: app.Kind, Name: app.Name, UID: app.UID, Controller: &controller}}}, Spec: limaapi.LimaVMSpec{Running: true, TemplateRef: limaapi.TemplateReference{Name: "rd", Namespace: "workloads"}}, Status: limaapi.LimaVMStatus{Conditions: []metav1.Condition{{Type: "Running", Status: metav1.ConditionTrue, Reason: "Started"}}}}
+	a, e := json.Marshal(app)
+	if e != nil {
+		t.Fatal("App fixture serialization")
+	}
+	v, e := json.Marshal(vm)
+	if e != nil {
+		t.Fatal("VM fixture serialization")
+	}
+	return a, v
+}
