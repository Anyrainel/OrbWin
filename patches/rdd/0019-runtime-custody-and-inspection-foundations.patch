+					}
+				}
+				runtimeCredentialAssertRetained(t, o, slot)
+				if o.Close() == nil || slot.attempted {
+					t.Fatal("cached unknown close attempted a resource")
+				}
+			})
+		}
+	}
+}
+
+func TestRuntimeUpgradeCredentialsConstructorSeesBorrowedUnknownBeforeIO(t *testing.T) {
+	o, n, l := runtimeCredentialBorrowedFixture(t)
+	l.closed = true
+	l.closeErr = ErrUpgrade
