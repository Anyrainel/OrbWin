+
+func TestRuntimeUpgradeCredentialsBorrowedUnknownBeforeOwnEffects(t *testing.T) {
+	for _, operation := range []string{"close", "digest"} {
+		for _, fault := range []string{"inventory-close-panic", "args-unknown", "storage-unknown", "domain-unknown"} {
