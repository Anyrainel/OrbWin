+// An authenticated observation only: no HOME, current/atomic snapshot, Stop,
+// supported-build or retirement authority. The storage's single actual pointer
+// retains this entire graph before Dial. No storage -> management Close callback
+// is allowed: the order is management -> credentials -> listener -> args ->
+// storage -> inventory, held throughout the bounded serial operation.
+type nativeRuntimeUpgradeManagementObservation struct {
+	mu          sync.Mutex
+	self        *nativeRuntimeUpgradeManagementObservation
+	listener    *nativeUpgradeOldListenerObservation
+	credentials *nativeRuntimeUpgradeCredentials
+	args        *nativeRuntimeUpgradeArgs
+	storage     *nativeRuntimeStorage
+	connections [3]*runtimeUpgradeManagementConnection
+	state       runtimeUpgradeManagementState
+	completed   bool
+	closed      bool
+	unknown     bool
+	closeErr    error
+}
+
+func (*nativeRuntimeUpgradeManagementObservation) String() string {
+	return "held authenticated legacy management observation DATA"
+}
+func (*nativeRuntimeUpgradeManagementObservation) GoString() string {
+	return "held authenticated legacy management observation DATA"
+}
+
+// Production always supplies the actual TCPConn returned by fixed tcp4 Dial.
+// The private net.Conn wrapper admits inert socket fakes in pure tests, never
+// an IPC-selected dialer, route, raw closer or positive native constructor.
+type runtimeUpgradeManagementAbortConn struct {
+	mu       sync.Mutex
+	conn     net.Conn
+	deadline time.Time
+	aborted  bool
+	sealed   bool
+	active   int
+	idle     chan struct{}
+}
+
+func newRuntimeUpgradeManagementAbortConn(conn net.Conn, deadline time.Time) *runtimeUpgradeManagementAbortConn {
+	return &runtimeUpgradeManagementAbortConn{conn: conn, deadline: deadline, idle: make(chan struct{})}
+}
+func (c *runtimeUpgradeManagementAbortConn) begin() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted || c.sealed || c.conn == nil {
+		return false
+	}
+	c.active++
+	return true
+}
+func (c *runtimeUpgradeManagementAbortConn) end() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.active--
+	if c.sealed && c.active == 0 {
+		close(c.idle)
+	}
+}
+func (c *runtimeUpgradeManagementAbortConn) Read(b []byte) (int, error) {
+	if !c.begin() {
+		return 0, ErrUpgrade
+	}
+	defer c.end()
+	return c.conn.Read(b)
+}
+func (c *runtimeUpgradeManagementAbortConn) Write(b []byte) (int, error) {
+	if !c.begin() {
+		return 0, ErrUpgrade
+	}
+	defer c.end()
