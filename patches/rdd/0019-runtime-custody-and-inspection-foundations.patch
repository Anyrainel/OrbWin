+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshRecoveryControlMetadataCannotReachRename(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n, captureComplete: true}
+	o.self = o
+	r := &nativeFreshRecoveryOwner{owner: o, complete: true}
+	r.self = r
+	n.freshRecovery = r
+	s := &nativeFreshControlRecovery{recovery: r, complete: true, record: freshControlRetentionFixture(), oldRoot: &runtimeStorageObject{resource: &runtimeStorageResource{handle: 42}}}
+	s.self = s
+	r.controlRetention = s
+	if s.prepareRetentionLocked(ctx, s.record.Args) == nil || s.retainOldControlLocked(ctx) == nil || len(n.resources) != 0 || s.oldRoot.resource.attempted || s.retainedObject != nil {
+		t.Fatal("record/phase data manufactured native original graph or rename")
+	}
+	if s.admitNewRootLocked(ctx, &Created{}, &runtimeStorageResource{handle: 44}, runtimeStorageIdentity{}) == nil || len(n.resources) != 0 || s.newCreated != nil {
+		t.Fatal("unborn control metadata admitted native root birth")
+	}
+	if found, e := r.captureRecordedControlLocked(ctx); e == nil || found || len(n.resources) != 0 {
+		t.Fatal("unborn record reader reached filesystem")
+	}
+	copy := *s
+	if copy.prepareRetentionLocked(ctx, s.record.Args) == nil || copy.retainOldControlLocked(ctx) == nil {
+		t.Fatal("copied native control owner accepted")
+	}
+}
