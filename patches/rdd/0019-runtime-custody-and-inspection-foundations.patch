index 0000000000000000000000000000000000000000..d40a993a5449e36e7a61c1de83d2bff4ce261622
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_directory.go
@@ -0,0 +1,142 @@
+package managementconfig
+
+import (
+	"encoding/binary"
+	"strings"
+	"unicode/utf16"
+)
+
+// Closed observational roles only; no caller-provided arbitrary retention cap.
+// Legacy datastore generation enumeration deliberately keeps its own16 limit.
+type runtimeFreshDirectoryRole uint8
+
+const (
+	runtimeFreshPrivateDirectory runtimeFreshDirectoryRole = iota + 1
+	runtimeFreshDenialDirectory
+)
+
+func (r runtimeFreshDirectoryRole) limit() int {
+	switch r {
+	case runtimeFreshPrivateDirectory:
+		return 512
+	case runtimeFreshDenialDirectory:
+		return 49
+	default:
+		return 0
+	}
+}
+
+// Parse copied FILE_ID_BOTH_DIR_INFO bytes with the original pinned ABI offsets.
+// Dot entries are returned to the aggregate state too, so repeated dot-only
+// pages cannot consume an unbounded or silently repeated directory stream.
+func runtimeFreshDirectoryPage(data []byte, role runtimeFreshDirectoryRole) ([]string, error) {
+	limit := role.limit()
+	if limit == 0 || len(data) > 64<<10 {
+		return nil, ErrUpgrade
+	}
+	var names []string
+	for offset, frames := 0, 0; frames < limit+2; frames++ {
+		if offset < 0 || offset+104 > len(data) {
+			return nil, ErrUpgrade
+		}
+		next := int(binary.LittleEndian.Uint32(data[offset:]))
+		length := int(binary.LittleEndian.Uint32(data[offset+60:]))
+		if length == 0 || length > 512 || length%2 != 0 || offset+104+length > len(data) || next != 0 && (next < 104+length || next%8 != 0 || offset+next > len(data)) {
+			return nil, ErrUpgrade
+		}
+		units := make([]uint16, length/2)
+		for i := range units {
+			units[i] = binary.LittleEndian.Uint16(data[offset+104+i*2:])
+			if units[i] == 0 {
+				return nil, ErrUpgrade
+			}
+		}
+		for i := 0; i < len(units); i++ {
+			v := units[i]
+			if v >= 0xd800 && v <= 0xdbff {
+				i++
+				if i >= len(units) || units[i] < 0xdc00 || units[i] > 0xdfff {
+					return nil, ErrUpgrade
+				}
+			} else if v >= 0xdc00 && v <= 0xdfff {
+				return nil, ErrUpgrade
+			}
+		}
+		name := string(utf16.Decode(units))
+		for _, prior := range names {
+			if strings.EqualFold(prior, name) {
+				return nil, ErrUpgrade
+			}
+		}
+		names = append(names, name)
+		if next == 0 {
+			count := 0
+			for _, name := range names {
+				if name != "." && name != ".." {
+					count++
+				}
+			}
+			if count > limit {
+				return nil, ErrUpgrade
+			}
+			return names, nil
+		}
+		offset += next
+	}
+	return nil, ErrUpgrade
+}
+
+// DATA-only bounded multi-page state, never a native enumeration permit. Every
+// success page is nonempty; at most limit names +two distinct dot entries plus
+// one precise terminal query are needed, even if each page contains one frame.
+type runtimeFreshDirectoryState struct {
+	role                  runtimeFreshDirectoryRole
+	names, seen           []string
+	pages                 int
+	pending, done, failed bool
+}
+
+func (s *runtimeFreshDirectoryState) begin() error {
+	if s == nil || s.role.limit() == 0 || s.failed || s.done || s.pending || s.pages >= s.role.limit()+3 {
+		return ErrUpgrade
+	}
+	s.pages++
+	s.pending = true
+	return nil
+}
+func (s *runtimeFreshDirectoryState) accept(data []byte) error {
+	if s == nil || !s.pending || s.done || s.failed {
+		return ErrUpgrade
+	}
+	s.pending = false
+	names, e := runtimeFreshDirectoryPage(data, s.role)
+	if e != nil {
+		s.failed = true
+		return ErrUpgrade
+	}
+	for _, name := range names {
+		for _, prior := range s.seen {
+			if strings.EqualFold(prior, name) {
+				s.failed = true
+				return ErrUpgrade
+			}
+		}
+		s.seen = append(s.seen, name)
+		if name != "." && name != ".." {
+			if len(s.names) >= s.role.limit() {
+				s.failed = true
+				return ErrUpgrade
+			}
+			s.names = append(s.names, name)
+		}
+	}
+	return nil
+}
+func (s *runtimeFreshDirectoryState) finish() ([]string, error) {
+	if s == nil || !s.pending || s.done || s.failed || s.role.limit() == 0 {
+		return nil, ErrUpgrade
+	}
+	s.pending = false
+	s.done = true
+	return append([]string(nil), s.names...), nil
+}
