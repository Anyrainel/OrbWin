+		return g.failCleanup()
+	}
+	return nil
+}
+func nativeCleanupError(e error) windows.Errno {
+	if n, ok := e.(windows.Errno); ok {
+		return n
+	}
+	return 0
+}
+
+func (g *DatastoreGeneration) cellKnown(slot *windows.Handle) bool {
+	if !g.exactCleanup() || slot == nil || g.captureCellAttempted(slot) {
+		return false
+	}
+	if slot == &g.directory && g.directoryClose.attempted || slot == &g.root && g.rootClose.attempted || slot == &g.db && g.dbClose.attempted {
+		return false
+	}
+	for n := range g.files {
+		if slot == &g.files[n] && (n >= 6 || g.fileClose[n].attempted) {
+			return false
+		}
+	}
+	for _, f := range g.frames {
+		if f.output == slot {
+			return g.frameOriginal(f) && f.state.usable() && !f.close.attempted
+		}
+	}
+	if slot == &g.directory || slot == &g.root || slot == &g.db {
+		return true
+	}
+	for n := range g.files {
+		if slot == &g.files[n] {
+			return n < 6
+		}
+	}
+	return false
+}
+
+func (g *DatastoreGeneration) closeCellOriginal(slot *windows.Handle, memo *datastoreCleanupOnce) bool {
+	for _, f := range g.frames {
+		if f.output == slot && !sdkImageReleaseState(&f.state) {
+			return false
+		}
+	}
+	for n := range g.files {
+		if slot == &g.files[n] {
+			return n < 6 && memo == &g.fileClose[n]
+		}
+	}
+	if slot == &g.directory {
+		return memo == &g.directoryClose
+	}
+	if slot == &g.root {
+		return memo == &g.rootClose
+	}
+	if slot == &g.db {
+		return memo == &g.dbClose
+	}
+	for _, f := range g.frames {
+		if slot == &f.handle {
+			return f.output == slot && memo == &f.close && g.frameOriginal(f)
+		}
+	}
+	return g.captureCloseCellOriginal(slot, memo)
+}
+
+func (g *DatastoreGeneration) closeCleanupCell(slot *windows.Handle, memo *datastoreCleanupOnce) error {
+	if !g.exactCleanup() || slot == nil || memo == nil || !g.closeCellOriginal(slot, memo) {
+		return ErrPublication
+	}
+	if memo.attempted {
+		if memo.complete {
+			return nil
+		}
+		return g.failCleanup()
+	}
+	// Zero is checked only for a cell known never entered/pending here.
+	if *slot == 0 {
+		return nil
+	}
+	if !memo.begin() {
+		return g.failCleanup()
+	}
+	memo.raw, _, memo.lastError = closeHandleRuntimeCleanup.Call(uintptr(*slot))
+	if uint32(memo.raw) == 0 || !memo.finish(true) {
+		return g.failCleanup()
+	}
+	*slot = 0
+	return nil
+}
+
+var cleanupKernel = windows.NewLazySystemDLL("kernel32.dll")
+var closeHandleRuntimeCleanup = cleanupKernel.NewProc("CloseHandle")
+var dispositionRuntimeCleanup = cleanupKernel.NewProc("SetFileInformationByHandle")
+var seekRuntimeCleanup = cleanupKernel.NewProc("SetFilePointerEx")
+var readRuntimeCleanup = cleanupKernel.NewProc("ReadFile")
+
+func (f *datastoreCleanupFrame) remove() error {
+	g := f.owner
+	if !g.frameOriginal(f) || (f.role != "file-delete" && f.role != "directory-delete") || !f.state.usable() || f.close.attempted || !f.deleteCall.begin() {
+		return g.failCleanup()
+	}
+	f.disposition = 1
+	f.raw, _, f.lastError = dispositionRuntimeCleanup.Call(uintptr(*f.output), uintptr(windows.FileDispositionInfo), uintptr(unsafe.Pointer(&f.disposition)), 4)
+	if uint32(f.raw) == 0 || !f.deleteCall.finish(true) {
+		return g.failCleanup()
+	}
+	return g.closeCleanupCell(f.output, &f.close)
+}
+
+type datastoreCleanupRead struct {
+	owner       *DatastoreGeneration
+	source      *windows.Handle
+	info, after windows.ByHandleFileInformation
+	buffer      []byte
+	count       uint32
+	offset      int64
+	raw         uintptr
+	lastError   error
+	entered     bool
+}
+
+func (g *DatastoreGeneration) readCleanupCell(slot *windows.Handle, limit uint32) ([]byte, ConfigVersion, error) {
+	if !g.cellKnown(slot) || len(g.reads) >= 24 {
+		return nil, ConfigVersion{}, ErrPublication
+	}
+	r := &datastoreCleanupRead{owner: g, source: slot}
+	g.reads = append(g.reads, r)
+	r.entered = true
+	if windows.GetFileInformationByHandle(*slot, &r.info) != nil || r.info.FileSizeHigh != 0 || r.info.FileSizeLow == 0 || r.info.FileSizeLow > limit {
+		return nil, ConfigVersion{}, g.failCleanup()
+	}
+	r.buffer = make([]byte, r.info.FileSizeLow)
+	r.raw, _, r.lastError = seekRuntimeCleanup.Call(uintptr(*slot), 0, uintptr(unsafe.Pointer(&r.offset)), 0)
+	if uint32(r.raw) == 0 {
+		return nil, ConfigVersion{}, g.failCleanup()
+	}
+	for at := 0; at < len(r.buffer); {
+		r.count = 0
+		r.raw, _, r.lastError = readRuntimeCleanup.Call(uintptr(*slot), uintptr(unsafe.Pointer(&r.buffer[at])), uintptr(len(r.buffer)-at), uintptr(unsafe.Pointer(&r.count)), 0)
+		// Failure may still own the actual original count/buffer. Do not inspect it.
+		if uint32(r.raw) == 0 {
+			return nil, ConfigVersion{}, g.failCleanup()
+		}
+		if r.count == 0 || uint64(r.count) > uint64(len(r.buffer)-at) {
+			return nil, ConfigVersion{}, g.failCleanup()
+		}
+		at += int(r.count)
+	}
+	if windows.GetFileInformationByHandle(*slot, &r.after) != nil {
+		return nil, ConfigVersion{}, g.failCleanup()
+	}
+	a, b := r.info, r.after
+	a.LastAccessTime = b.LastAccessTime
+	if a != b {
+		return nil, ConfigVersion{}, g.failCleanup()
+	}
+	hash := sha256.Sum256(r.buffer)
+	v := ConfigVersion{true, r.info.VolumeSerialNumber, r.info.FileIndexHigh, r.info.FileIndexLow, hash}
+	if !v.valid() {
+		return nil, ConfigVersion{}, g.failCleanup()
+	}
+	return r.buffer, v, nil
+}
+
+// Original metadata output is retained even on a refused/failed query.
+func (g *DatastoreGeneration) cleanupIdentity(slot *windows.Handle) (AnchorIdentity, error) {
+	if !g.cellKnown(slot) || len(g.reads) >= 24 {
+		return AnchorIdentity{}, ErrPublication
+	}
+	r := &datastoreCleanupRead{owner: g, source: slot, entered: true}
+	g.reads = append(g.reads, r)
+	if windows.GetFileInformationByHandle(*slot, &r.info) != nil {
+		return AnchorIdentity{}, g.failCleanup()
+	}
+	id := AnchorIdentity{Volume: r.info.VolumeSerialNumber, IndexHigh: r.info.FileIndexHigh, IndexLow: r.info.FileIndexLow}
+	if id.IndexHigh == 0 && id.IndexLow == 0 {
+		return AnchorIdentity{}, g.failCleanup()
+	}
+	return id, nil
+}
+
+// No c.mu acquisition under g.mu. Actual parent pointer is immutable and its
+// atomic active barrier stays true until every original/derivative is settled.
+func (g *DatastoreGeneration) closeHandles() (result error) {
+	if !g.exactCleanup() || !g.childrenReleased() {
+		return ErrPublication
+	}
+	for _, f := range g.frames {
+		if !sdkImageReleaseState(&f.state) {
+			return g.failCleanup()
+		}
+	}
+	defer func() {
+		if recover() != nil {
+			result = g.failCleanup()
+		}
+	}()
+	for n := len(g.frames) - 1; n >= 0; n-- {
+		f := g.frames[n]
+		if f.output != &f.handle {
+			continue
+		}
+		if !sdkImageReleaseState(&f.state) {
+			return g.failCleanup()
+		}
+		if g.closeCleanupCell(f.output, &f.close) != nil {
+			return ErrPublication
+		}
+	}
+	if g.closeCaptureCells() != nil {
+		return ErrPublication
+	}
+	for n := len(g.files) - 1; n >= 0; n-- {
+		if n >= 6 || g.closeCleanupCell(&g.files[n], &g.fileClose[n]) != nil {
+			return ErrPublication
+		}
+	}
+	for _, v := range []struct {
+		slot *windows.Handle
+		memo *datastoreCleanupOnce
+	}{{&g.directory, &g.directoryClose}, {&g.root, &g.rootClose}, {&g.db, &g.dbClose}} {
+		if g.closeCleanupCell(v.slot, v.memo) != nil {
+			return ErrPublication
+		}
+	}
+	if g.parents != nil {
+		if !g.parentClose.begin() {
+			if !g.parentClose.complete {
+				return g.failCleanup()
+			}
+		} else {
+			if g.parents.Close() != nil {
+				return g.failCleanup()
+			}
+			g.parentClose.finish(true)
+			g.parents = nil
+		}
+	}
+	return nil
+}
+
+func (g *DatastoreGeneration) Close() (result error) {
+	if g == nil {
+		return nil
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.self != g {
+		return ErrPublication
+	}
+	if g.closed {
+		if g.unknown || g.cleanupError != nil || !g.released.Load() || !g.constructionComplete || !g.cleanupAttempted {
+			return ErrPublication
+		}
+		return nil
+	}
+	if !g.exactCleanup() || !g.constructionComplete || !g.childrenReleased() {
+		return ErrPublication
+	}
+	if g.started && !g.retired {
+		return ErrPublication
+	}
+	if g.cleanupAttempted {
+		return g.cleanupError
+	}
+	g.cleanupAttempted = true
+	g.cleanupError = ErrPublication
+	result = ErrPublication
+	defer func() {
+		if recover() != nil {
+			result = g.failCleanup()
+		}
+	}()
