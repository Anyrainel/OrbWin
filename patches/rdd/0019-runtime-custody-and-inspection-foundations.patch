+package managementconfig
+
+import (
+	"errors"
+	"strings"
+)
+
+var errModernIncomingImage = errors.New("same-build incoming image unavailable")
+
+// Sequencing DATA only; original native owner/parent/slot guards are separate.
+type modernIncomingImageState struct{ entered, complete, closing, closed, unknown bool }
+
+func (s *modernIncomingImageState) begin() bool {
+	if s == nil || s.entered || s.complete || s.closing || s.closed || s.unknown {
+		return false
+	}
+	s.entered = true
+	return true
+}
+func (s *modernIncomingImageState) fail() {
+	if s != nil {
+		s.unknown = true
+	}
+}
+func (s *modernIncomingImageState) finish(consistent bool) bool {
+	if s == nil || !s.entered || s.complete || s.closing || s.closed || s.unknown || !consistent {
+		s.fail()
+		return false
+	}
+	s.complete = true
+	return true
+}
+func (s *modernIncomingImageState) closedKnown() bool {
+	return s != nil && s.entered && s.complete && s.closing && s.closed && !s.unknown
+}
+func (s *modernIncomingImageState) beginClose() (bool, error) {
+	if s.closedKnown() {
+		return false, nil
+	}
+	if s == nil || !s.entered || !s.complete || s.closing || s.closed || s.unknown {
+		return false, errModernIncomingImage
+	}
+	s.closing = true
+	return true, nil
+}
+func (s *modernIncomingImageState) finishClose() error {
+	if s == nil || !s.entered || !s.complete || !s.closing || s.closed || s.unknown {
+		s.fail()
+		return errModernIncomingImage
+	}
+	s.closed = true
+	return nil
+}
+
+// Path DATA only; used only below the original native leaf/query guards.
+func modernIncomingFinalPathMatches(actual, expected string) bool {
+	return strings.EqualFold(strings.TrimPrefix(actual, `\\?\`), expected)
+}
