+package managementconfig
+
+import "testing"
+
+// Fault cuts model the native phase outcomes, not a native authority. The real
+// native producer must separately establish exact parent, original and file.
+func TestModernIncomingBorrowRetainsAtEveryCaptureFailure(t *testing.T) {
+	for cut := 0; cut < 3; cut++ {
+		s := &modernIncomingImageState{}
+		if !s.begin() {
+			t.Fatal("begin")
+		}
+		for phase := 0; phase < 3; phase++ {
+			if phase == cut {
+				s.fail()
+				break
+			}
+		}
+		if s.finish(true) || s.closedKnown() {
+			t.Fatal("late positive repaired unknown")
+		}
+		if run, e := s.beginClose(); run || e == nil {
+			t.Fatal("failure released ancestor barrier")
+		}
+		if s.begin() {
+			t.Fatal("failed capture retried")
+		}
+	}
+}
+func TestModernIncomingKnownBorrowCloseAndReplay(t *testing.T) {
+	s := &modernIncomingImageState{}
+	if !s.begin() {
+		t.Fatal("begin")
+	}
+	if run, _ := s.beginClose(); run {
+		t.Fatal("incomplete capture released parent")
+	}
+	if !s.finish(true) || s.begin() {
+		t.Fatal("positive capture/reacquire")
+	}
+	// A caller cancellation after native checks does not invalidate completed
+	// custody; the same retained owner may explicitly close its logical borrow.
+	run, e := s.beginClose()
+	if !run || e != nil || s.closedKnown() {
+		t.Fatal("close not prearmed")
+	}
+	if s.finishClose() != nil || !s.closedKnown() {
+		t.Fatal("positive release")
+	}
+	if run, e = s.beginClose(); run || e != nil {
+		t.Fatal("positive close replay")
+	}
+}
+func TestModernIncomingMismatchAndClosePanicRetainParents(t *testing.T) {
+	s := &modernIncomingImageState{}
+	s.begin()
+	if s.finish(false) || s.closedKnown() {
+		t.Fatal("pre/post mismatch admitted")
+	}
+	s = &modernIncomingImageState{}
+	s.begin()
+	s.finish(true)
+	s.beginClose()
+	func() {
+		defer func() {
+			if recover() != nil {
+				s.fail()
+			}
+		}()
+		panic("close completion lost")
+	}()
+	if s.finishClose() == nil || s.closedKnown() {
+		t.Fatal("panic published closed")
+	}
+	if run, e := s.beginClose(); run || e == nil {
+		t.Fatal("panicked close retried")
+	}
+}
+
+func TestModernIncomingActualFinalPathPrefixAndSubstitution(t *testing.T) {
+	expected := `C:\Users\Owner\code.exe`
+	if !modernIncomingFinalPathMatches(`\\?\C:\Users\Owner\code.exe`, expected) || !modernIncomingFinalPathMatches(expected, expected) {
+		t.Fatal("actual DOS final path prefix rejected")
+	}
+	for _, bad := range []string{`\?C:\Users\Owner\code.exe`, `C:\Other\code.exe`, `C:\Users\Owner\other.exe`} {
+		if modernIncomingFinalPathMatches(bad, expected) {
+			t.Fatal("different native final path accepted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_image_windows.go b/rdd/pkg/managementconfig/runtime_modern_image_windows.go
