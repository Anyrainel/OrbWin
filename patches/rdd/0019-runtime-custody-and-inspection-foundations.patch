@@ -0,0 +1,38 @@
+package managementconfig
+
+import "strings"
+
+// Role DATA derived once from the original root profile and compiled pins.
+// These rows alone grant no native authority or ownership.
+type sdkImageProducerRole struct {
+	name                       string
+	parent                     int
+	directory, private, volume bool
+}
+
+func sdkImageProducerRoles(volume string, parts []string, profileParts int) ([]sdkImageProducerRole, bool) {
+	if volume == "" || len(parts) < 3 || profileParts < 0 || profileParts > len(parts)-3 {
+		return nil, false
+	}
+	rows := []sdkImageProducerRole{{name: volume, parent: -1, directory: true, volume: true}}
+	for n, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.ContainsAny(part, `\/`+"\x00") {
+			return nil, false
+		}
+		rows = append(rows, sdkImageProducerRole{name: part, parent: n, directory: true, private: n >= profileParts})
+	}
+	bundle := len(parts)
+	rows = append(rows, sdkImageProducerRole{name: "orbwin-session.exe", parent: bundle, private: true})
+	lan := len(rows)
+	rows = append(rows, sdkImageProducerRole{name: "lan", parent: bundle, directory: true, private: true})
+	for _, name := range []string{"assets.json", "assets.sig", "orbwin-lan-helper.exe", "orbwin-lan-worker.exe"} {
+		rows = append(rows, sdkImageProducerRole{name: name, parent: lan, private: true})
+	}
+	return rows, true
+}
+
+// Only an exact current tail with a completed no-output refusal, or no entered
+// call at all, can be discarded. Never inspect a possibly pending output cell.
+func sdkImageProducerDiscardable(s *runtimeStorageNativeOpenState) bool {
+	return s != nil && !s.unknown && !s.admitted && !s.attached && (!s.entered || s.returned)
+}
