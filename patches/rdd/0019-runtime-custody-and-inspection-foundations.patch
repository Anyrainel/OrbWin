+		n.fence()
+		return 0, ErrUpgrade
+	}
+	f := &runtimeStorageWin32Frame{owner: n, role: role}
+	f.resource = &runtimeStorageResource{win32Open: f}
+	access := uint32(windows.TOKEN_QUERY)
+	switch role {
+	case runtimeStorageThreadToken:
+		f.subject = windows.CurrentThread()
+	case runtimeStorageInitialToken:
