+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+// Compare-and-swap the actual listed object. A failed finalizer edit must not
+// fall through to an unconditioned delete of a same-name replacement.
+func deleteOwnedResourceSnapshot(ctx context.Context, c client.Client, item *metav1.PartialObjectMetadata, owner types.UID) error {
+	if item == nil || owner == "" || item.UID == "" || item.ResourceVersion == "" || !IsOwnedByUID(item, owner) {
+		return fmt.Errorf("cleanup lacks original owned object identity")
+	}
+	uid := item.UID
+	if removeOwnedFinalizers(item) {
+		patch, e := json.Marshal([]map[string]any{{"op": "test", "path": "/metadata/uid", "value": string(uid)}, {"op": "test", "path": "/metadata/resourceVersion", "value": item.ResourceVersion}, {"op": "add", "path": "/metadata/finalizers", "value": item.Finalizers}})
+		if e != nil {
+			return e
+		}
+		if e = c.Patch(ctx, item, client.RawPatch(types.JSONPatchType, patch)); e != nil {
+			return e
+		}
+	}
+	if item.UID != uid || item.ResourceVersion == "" || !IsOwnedByUID(item, owner) {
+		return fmt.Errorf("cleanup original object changed")
+	}
+	rv := item.ResourceVersion
+	return c.Delete(ctx, item, client.Preconditions{UID: &uid, ResourceVersion: &rv})
+}
