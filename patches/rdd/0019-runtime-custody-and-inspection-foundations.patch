+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+// Compile-only: no native entry or caller token query is invoked.
+func TestDatastoreCleanupZeroAndCopyRefuseBeforeNative(t *testing.T) {
+	zero := &DatastoreGeneration{}
+	if zero.Close() == nil || zero.cleanupAttempted {
+		t.Fatal("zero owner admitted")
+	}
+	fakeClosed := &DatastoreGeneration{closed: true}
+	fakeClosed.self = fakeClosed
+	if fakeClosed.Close() == nil {
+		t.Fatal("unissued closed marker admitted")
+	}
+	c := &Created{}
+	g := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c}
+	g.self = g
+	c.datastoreGeneration = g
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed lifetime admission")
+	}
+	defer g.releaseCleanup()
+	if !g.exactCleanup() {
+		t.Fatal("actual registration missing")
+	}
+	foreign := &DatastoreGeneration{self: g, owner: c}
+	if foreign.exactCleanup() || foreign.Close() == nil {
+		t.Fatal("copy admitted")
+	}
+	child := &DatastoreGeneration{issuance: datastoreCleanupReaped, issuer: g, reapName: "closed"}
+	child.self = child
+	g.children = append(g.children, child)
+	if g.childrenReleased() {
+		t.Fatal("unsettled original derivative ignored")
+	}
+	child.released.Store(true)
+	if !g.childrenReleased() {
+		t.Fatal("positive derivative release ignored")
+	}
+}
+
+func TestDatastoreCleanupOriginalFramePendingRefusesEveryClose(t *testing.T) {
+	c := &Created{}
+	g := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c, files: make([]windows.Handle, 6)}
+	g.self = g
+	c.datastoreGeneration = g
+	c.datastoreActive.Store(true)
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed admission")
+	}
+	defer g.releaseCleanup()
+	f := g.newCleanupFrame("file-delete", 1)
+	if f == nil || !g.frameOriginal(f) {
+		t.Fatal("original frame missing")
+	}
+	var foreign windows.Handle
+	f.output = &foreign
+	if g.frameOriginal(f) {
+		t.Fatal("foreign output admitted")
+	}
+	f.output = &f.handle
+	f.state.entered = true
+	if g.closeHandles() == nil || !g.unknown || f.close.attempted || !c.datastoreActive.Load() {
+		t.Fatal("pending output released parent")
+	}
+	if c.Close() == nil {
+		t.Fatal("active parent closed")
+	}
+}
+
+// Compile-only actual caller contract: unrelated name returns before root/cell
+// inspection, owner allocation or native entry. Invalid parent/ctx still fail.
+func TestDatastoreReaperUnrelatedEntryNoEffect(t *testing.T) {
+	c := &Created{}
+	g := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c}
+	g.self = g
+	c.datastoreGeneration = g
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed admission")
+	}
+	defer g.releaseCleanup()
+	if reaped, e := g.reapDatastoreGeneration(context.Background(), "unused", "foreign"); reaped || e != nil || len(g.children) != 0 || g.unknown {
+		t.Fatal("unrelated entry became startup failure/effect")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := g.reapDatastoreGeneration(ctx, "unused", "foreign"); e == nil {
+		t.Fatal("cancelled caller masked")
+	}
+	if _, e := g.reapDatastoreGeneration(nil, "unused", "foreign"); e == nil {
+		t.Fatal("missing context masked")
+	}
+}
diff --git a/rdd/pkg/managementconfig/datastore_generation_capture.go b/rdd/pkg/managementconfig/datastore_generation_capture.go
new file mode 100644
index 0000000000000000000000000000000000000000..b1915cbb3aa80745a53c755b301e2121aa1a0653
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_generation_capture.go
@@ -0,0 +1,59 @@
+package managementconfig
+
+import "context"
+
+// Interpretation only; the private native original supplies ownership/slots.
+type datastoreOwnerDisposition uint8
+
+const (
+	datastoreOwnerUnknown datastoreOwnerDisposition = iota
+	datastoreOwnerAbsent
+	datastoreOwnerDead
+	datastoreOwnerRecycled
+	datastoreOwnerLive
+	datastoreOwnerUnavailable
+)
+
+func datastoreGenerationAdmit(ctx context.Context) bool { return ctx != nil && ctx.Err() == nil }
+func datastoreGenerationWriteCount(count uint32, remaining int) bool {
+	return remaining > 0 && count > 0 && uint64(count) <= uint64(remaining)
+}
+func datastoreGenerationMissingTail(s *runtimeStorageNativeOpenState, status uint32) bool {
+	return s != nil && s.entered && s.returned && !s.admitted && !s.attached && !s.unknown && status == 0xc0000034
+}
+func datastoreCloneSecret(src []byte, limit int) ([]byte, bool) {
+	if len(src) < 1 || len(src) > limit {
+		return nil, false
+	}
+	return append([]byte(nil), src...), true
+}
+
+// OpenProcess returns a full-width HANDLE, not BOOL. LastError is irrelevant
+// on a valid handle; failed997/zero error/unexpected sentinel are unknown.
+func datastoreProcessOpenReply(raw uintptr, code uint32) (bool, datastoreOwnerDisposition) {
+	if raw == ^uintptr(0) {
+		return false, datastoreOwnerUnknown
+	}
+	if raw != 0 {
+		return true, datastoreOwnerUnknown
+	}
+	if code == 87 {
+		return false, datastoreOwnerAbsent
+	}
+	if code == 5 {
+		return false, datastoreOwnerUnavailable
+	}
+	return false, datastoreOwnerUnknown
+}
+func datastoreProcessWaitReply(same bool, wait uint32) (datastoreOwnerDisposition, bool) {
+	if !same {
+		return datastoreOwnerRecycled, true
+	}
+	if wait == 0 {
+		return datastoreOwnerDead, true
+	}
+	if wait == 258 {
+		return datastoreOwnerLive, true
+	}
+	return datastoreOwnerUnknown, false
+}
diff --git a/rdd/pkg/managementconfig/datastore_generation_capture_test.go b/rdd/pkg/managementconfig/datastore_generation_capture_test.go
new file mode 100644
