+}
+func runtimeCredentialLockFixture(o *nativeRuntimeUpgradeCredentials) func() {
+	o.mu.Lock()
+	o.args.mu.Lock()
+	o.storage.mu.Lock()
+	o.args.inventory.mu.Lock()
+	return func() { o.args.inventory.mu.Unlock(); o.storage.mu.Unlock(); o.args.mu.Unlock(); o.mu.Unlock() }
+}
+func runtimeCredentialAssertRetained(t *testing.T, o *nativeRuntimeUpgradeCredentials, slot *runtimeStorageResource) {
