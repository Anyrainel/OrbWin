+	freshSetupOwners.Unlock()
+	t.Cleanup(func() { freshSetupOwners.Lock(); delete(freshSetupOwners.owners, o); freshSetupOwners.Unlock() })
+}
+func TestRuntimeFreshOwnerRejectsBeforeNativeEligibility(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	for name, o := range map[string]*FreshSetupOwner{"nil": nil, "zero": {}, "forged": {}} {
+		if name == "forged" {
