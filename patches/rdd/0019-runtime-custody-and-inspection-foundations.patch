+func (s *inspectionFreshRecords) denialGraph(ctx context.Context) error {
+	parent := s.public
+	var dirs [runtimeFreshLegacyDirectoryCount]*inspectionNativeObject
+	var facts [runtimeFreshLegacyDirectoryCount]runtimeFreshLegacyDirectoryFact
+	for i := 0; i < runtimeFreshLegacyDirectoryCount; i++ {
