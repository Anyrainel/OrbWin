+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+// All cases return before the native API. A live bounded context is deliberately
+// absent: this source lane must never observe the actual host's job membership.
+func TestFreshPersistentProcessRejectsInvalidContextBeforeNativeQuery(t *testing.T) {
+	cancelled, cancel := context.WithTimeout(context.Background(), time.Minute)
+	cancel()
+	expired, finish := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer finish()
+	for _, test := range []struct {
+		name string
+		ctx  context.Context
+	}{
+		{"nil", nil},
+		{"unbounded", context.Background()},
+		{"cancelled", cancelled},
+		{"expired", expired},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if !errors.Is(requireFreshPersistentProcess(test.ctx), ErrUpgrade) {
+				t.Fatal("invalid context admitted persistent process observation")
+			}
+		})
+	}
+}
+
+func TestFreshPersistentProcessObservationRequiresSuccessfulQueryAndExactFalseMembership(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		result uintptr
+		member uint32
+		ok     bool
+	}{
+		{"outside", 1, 0, true},
+		{"query failure", 0, 0, false},
+		{"member", 1, 1, false},
+		{"unwritten sentinel", 1, 2, false},
+		{"noncanonical membership", 1, ^uint32(0), false},
+		{"nonzero success", 2, 0, true},
+		{"nonzero success with member", 2, 1, false},
+		{"nonzero success with sentinel", 2, 2, false},
+		{"failure with membership", 0, 1, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := freshPersistentJobObservation(test.result, test.member)
+			if test.ok {
+				if err != nil {
+					t.Fatal("positive DATA observation rejected", err)
+				}
+			} else if !errors.Is(err, ErrUpgrade) {
+				t.Fatal("failed/member/noncanonical observation accepted", err)
+			}
+		})
+	}
+}
