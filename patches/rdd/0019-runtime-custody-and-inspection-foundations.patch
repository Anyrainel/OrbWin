+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+)
+
+const runtimeFreshAdmissionName = "authority.fresh.admission"
+const runtimeFreshCommittedName = "authority.fresh.committed"
+const runtimeFreshRecordBudget = 8192
+
+// Historical DATA only. Neither decoding nor any field issues a native grant.
+type runtimeFreshAdmission struct {
+	Schema                                                          int                           `json:"schema"`
+	Transaction                                                     string                        `json:"transaction"`
+	Intent                                                          runtimePublicationFileWitness `json:"intent"`
+	LegacyDenial                                                    runtimePublicationFileWitness `json:"legacyDenial"`
+	DenialCompletion                                                runtimePublicationFileWitness `json:"denialCompletion"`
+	Parent, Controller, Authority, AuthorityLock                    UpgradeObject
+	ParentDescriptor, ControllerDescriptor, AuthorityLockDescriptor [32]byte
+	Args, Initialization                                            runtimePublicationFileWitness
+	Candidate                                                       UpgradeProcess
+	Stage                                                           runtimePublicationFileWitness
+	Runtime                                                         runtimeIdentityRecord
+	ControlRetention, ControlBirth                                  runtimePublicationFileWitness
+	Seed                                                            runtimeFreshSeedFact `json:"seed"`
+}
+
+// Preserve canonical pre-control records byte for byte. Zero witnesses mean
+// the ordinary producer; actual native namespace checks still have to prove
+// that no control-retention transaction is being silently bypassed.
+func (a runtimeFreshAdmission) MarshalJSON() ([]byte, error) {
+	type plain runtimeFreshAdmission
+	v := struct {
+		plain
+		ControlRetention *runtimePublicationFileWitness `json:",omitempty"`
+		ControlBirth     *runtimePublicationFileWitness `json:",omitempty"`
+		Seed             *runtimeFreshSeedFact          `json:"seed,omitempty"`
+		DenialCompletion *runtimePublicationFileWitness `json:"denialCompletion,omitempty"`
+	}{plain: plain(a)}
+	if a.ControlRetention != (runtimePublicationFileWitness{}) {
+		v.ControlRetention = &a.ControlRetention
+	}
+	if a.ControlBirth != (runtimePublicationFileWitness{}) {
+		v.ControlBirth = &a.ControlBirth
+	}
+	if a.Seed != (runtimeFreshSeedFact{}) {
+		v.Seed = &a.Seed
+	}
+	if a.DenialCompletion != (runtimePublicationFileWitness{}) {
+		v.DenialCompletion = &a.DenialCompletion
+	}
+	return json.Marshal(v)
+}
+
+func (a runtimeFreshAdmission) controlValid() bool {
+	zero := runtimePublicationFileWitness{}
+	if a.ControlRetention == zero && a.ControlBirth == zero {
+		return true
+	}
+	if !a.ControlRetention.valid() || !a.ControlBirth.valid() || a.ControlRetention.Object == a.ControlBirth.Object {
+		return false
+	}
+	for _, witness := range []runtimePublicationFileWitness{a.ControlRetention, a.ControlBirth} {
+		if witness.Object.Volume != a.Intent.Object.Volume {
+			return false
+		}
+		for _, other := range []UpgradeObject{a.Intent.Object, a.Authority, a.AuthorityLock, a.Args.Object, a.Initialization.Object} {
+			if witness.Object == other {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Completion remains DATA: actual callers must compare it to the real reader.
+func (a runtimeFreshAdmission) denialCompletionValid() bool {
+	zero := runtimePublicationFileWitness{}
+	if a.Seed == (runtimeFreshSeedFact{}) {
+		return a.DenialCompletion == zero
+	}
+	w := a.DenialCompletion
+	if !w.valid() || w.Object.Volume != a.LegacyDenial.Object.Volume {
+		return false
+	}
+	for _, object := range []UpgradeObject{a.Intent.Object, a.LegacyDenial.Object, a.Parent, a.Controller, a.Authority, a.AuthorityLock, a.Args.Object, a.Initialization.Object, a.Stage.Object, a.ControlRetention.Object, a.ControlBirth.Object, a.Seed.Object} {
+		if w.Object == object {
+			return false
+		}
+	}
+	return true
+}
+
+// The admission wire version stays1 for both producers. The actual native
+// intent, not admission.Schema, determines whether completion is mandatory.
+func runtimeFreshDenialCompletionMatchesIntent(intent runtimeFreshIntent, witness runtimePublicationFileWitness) bool {
+	switch intent.Schema {
+	case 1:
+		return intent.Seed == (runtimeFreshSeedFact{}) && witness == (runtimePublicationFileWitness{})
+	case 2:
+		return intent.Seed.valid() && witness.valid()
+	}
+	return false
+}
+
+func (a runtimeFreshAdmission) valid() bool {
+	if !a.denialCompletionValid() {
+		return false
+	}
+	if a.Seed != (runtimeFreshSeedFact{}) && (!a.Seed.valid() || a.Seed.Object.Volume != a.Intent.Object.Volume || a.Seed.Object == a.Intent.Object || a.Seed.Object == a.Authority || a.Seed.Object == a.AuthorityLock) {
+		return false
+	}
+	if !a.controlValid() {
+		return false
+	}
+	if a.Schema != 1 || !upgradeHex(a.Transaction, 32) || !a.Intent.valid() || !a.LegacyDenial.valid() || !a.Parent.valid() || !a.Controller.valid() || !a.Authority.valid() || !a.AuthorityLock.valid() || a.AuthorityLockDescriptor == [32]byte{} || !a.Args.valid() || !a.Initialization.valid() || !a.Candidate.valid() || !a.Stage.valid() || a.ParentDescriptor == [32]byte{} || a.ControllerDescriptor == [32]byte{} || !a.Runtime.valid(a.Runtime.Home) {
+		return false
+	}
+	if hex.EncodeToString(a.Candidate.Image[:]) != a.Runtime.BinarySHA {
+		return false
+	}
+	private := []UpgradeObject{a.Intent.Object, a.Authority, a.AuthorityLock, a.Args.Object, a.Initialization.Object}
+	for i, id := range private {
+		if id.Volume != a.Intent.Object.Volume {
+			return false
+		}
+		for _, other := range private[:i] {
+			if id == other {
+				return false
+			}
+		}
+	}
+	if a.LegacyDenial.Object.Volume != a.Parent.Volume || a.LegacyDenial.Object == a.Parent || a.LegacyDenial.Object == a.Controller || a.LegacyDenial.Object == a.Stage.Object {
+		return false
+	}
+	if a.Parent == a.Controller || a.Stage.Object == a.Parent || a.Stage.Object == a.Controller || a.Stage.Object.Volume != a.Parent.Volume || a.Controller.Volume != a.Parent.Volume {
+		return false
+	}
+	return true
+}
+
+type runtimeFreshCommitted struct {
+	Schema      int                           `json:"schema"`
+	Transaction string                        `json:"transaction"`
+	Admission   runtimePublicationFileWitness `json:"admission"`
+	Target      runtimePublicationFileWitness `json:"target"`
+}
+
+func (c runtimeFreshCommitted) matches(a runtimeFreshAdmission) bool {
+	return c.Schema == 1 && c.Transaction == a.Transaction && a.valid() && c.Admission.valid() && c.Target == a.Stage
+}
+
+// Canonical encoding rejects duplicate/case-folded/unknown fields, trailing
+// records and alternate spellings as well as malformed JSON. Small fixed DATA.
+func runtimeFreshRecordBytes(v any) ([]byte, error) {
+	b, e := json.Marshal(v)
+	if e != nil || len(b) == 0 || len(b) > runtimeFreshRecordBudget {
+		return nil, ErrUpgrade
+	}
+	return append(b, '\n'), nil
+}
+func parseRuntimeFreshRecord(b []byte, v any) error {
+	if len(b) == 0 || len(b) > runtimeFreshRecordBudget || !runtimeIdentityUnicode(b) {
+		return ErrUpgrade
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if d.Decode(v) != nil {
+		return ErrUpgrade
+	}
+	canonical, e := runtimeFreshRecordBytes(v)
+	if e != nil || !bytes.Equal(canonical, b) {
+		return ErrUpgrade
+	}
+	return nil
+}
