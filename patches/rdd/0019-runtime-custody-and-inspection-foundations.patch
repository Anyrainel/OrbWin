+package managementconfig
+
+import (
+	"encoding/binary"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode/utf16"
+)
+
+func freshDirectoryPageFixture(names ...string) []byte {
+	var out []byte
+	for i, name := range names {
+		units := utf16.Encode([]rune(name))
+		size := 104 + len(units)*2
+		aligned := (size + 7) &^ 7
+		entry := make([]byte, aligned)
+		binary.LittleEndian.PutUint32(entry[60:], uint32(len(units)*2))
+		if i+1 < len(names) {
+			binary.LittleEndian.PutUint32(entry, uint32(aligned))
+		}
+		for j, v := range units {
+			binary.LittleEndian.PutUint16(entry[104+j*2:], v)
+		}
+		out = append(out, entry...)
+	}
+	return out
+}
+func TestRuntimeFreshDirectoryCapacityAndLegacyLimit(t *testing.T) {
+	public := []string{runtimeFreshLegacyDenialName}
+	for i := uint32(0); i < 8; i++ {
+		a, _ := runtimeFreshDenialRepairName(i)
+		b, _ := runtimeFreshDenialArchiveName(i)
+		public = append(public, a, b)
+	}
+	if len(public) != 17 {
+		t.Fatal("fixture17")
+	}
+	page := freshDirectoryPageFixture(public...)
+	if _, e := datastoreDirectoryBatch(page); e == nil {
+		t.Fatal("legacy datastore16 was relaxed")
+	}
+	if names, e := runtimeFreshDirectoryPage(page, runtimeFreshDenialDirectory); e != nil || len(names) != 17 {
+		t.Fatal("legal17 denial files refused")
+	}
+	public = []string{runtimeFreshLegacyDenialName}
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		a, _ := runtimeFreshDenialRepairName(i)
+		b, _ := runtimeFreshDenialArchiveName(i)
+		c, _ := runtimeFreshDenialCompletionName(i)
+		public = append(public, a, b, c)
+	}
+	if names, e := runtimeFreshDirectoryPage(freshDirectoryPageFixture(public...), runtimeFreshDenialDirectory); e != nil || len(names) != 49 {
+		t.Fatal("public49 boundary")
+	}
+	public = append(public, "overflow")
+	if _, e := runtimeFreshDirectoryPage(freshDirectoryPageFixture(public...), runtimeFreshDenialDirectory); e == nil {
+		t.Fatal("public50")
+	}
+	for _, limit := range []int{17, 512} {
+		s := runtimeFreshDirectoryState{role: runtimeFreshPrivateDirectory}
+		for start := 0; start < limit; start += 100 {
+			end := start + 100
+			if end > limit {
+				end = limit
+			}
+			var names []string
+			for i := start; i < end; i++ {
+				names = append(names, fmt.Sprintf("%04d", i)+strings.Repeat("x", 251))
+			}
+			page := freshDirectoryPageFixture(names...)
+			if len(page) > 64<<10 {
+				t.Fatal("test page overflow")
+			}
+			if s.begin() != nil || s.accept(page) != nil {
+				t.Fatalf("private%d multipart", limit)
+			}
+		}
+		if s.begin() != nil {
+			t.Fatal("terminal budget")
+		}
+		names, e := s.finish()
+		if e != nil || len(names) != limit {
+			t.Fatalf("private%d terminal", limit)
+		}
+		if limit == 512 && s.pages < 3 {
+			t.Fatal("not a real >64KiB multi-page case")
+		}
+	}
+	s := runtimeFreshDirectoryState{role: runtimeFreshPrivateDirectory}
+	for i := 0; i < 512; i++ {
+		if s.begin() != nil || s.accept(freshDirectoryPageFixture(fmt.Sprintf("%d", i))) != nil {
+			t.Fatal("single-frame pages")
+		}
+	}
+	if s.begin() != nil || s.accept(freshDirectoryPageFixture("513th")) == nil {
+		t.Fatal("aggregate513")
+	}
+}
+func TestRuntimeFreshDirectoryMalformedDuplicateAndTerminalRefusal(t *testing.T) {
+	good := freshDirectoryPageFixture("name")
+	malformed := map[string][]byte{"empty": nil, "truncated": good[:105], "oversized": make([]byte, (64<<10)+1), "zero frame": make([]byte, 104)}
+	edit := func(at int, value uint32) []byte {
+		b := append([]byte(nil), good...)
+		binary.LittleEndian.PutUint32(b[at:], value)
+		return b
+	}
+	malformed["odd length"] = edit(60, 3)
+	malformed["next overlap"] = edit(0, 8)
+	malformed["next misaligned"] = edit(0, 113)
+	malformed["next beyond page"] = edit(0, 65536)
+	for name, unit := range map[string]uint16{"unpaired high": 0xd800, "unpaired low": 0xdc00, "nul": 0} {
+		b := append([]byte(nil), good...)
+		binary.LittleEndian.PutUint32(b[60:], 2)
+		binary.LittleEndian.PutUint16(b[104:], unit)
+		malformed[name] = b
+	}
+	malformed["same page duplicate"] = freshDirectoryPageFixture("same", "same")
+	malformed["same page casefold"] = freshDirectoryPageFixture("same", "SAME")
+	for name, page := range malformed {
+		if _, e := runtimeFreshDirectoryPage(page, runtimeFreshPrivateDirectory); e == nil {
+			t.Fatalf("accepted%s", name)
+		}
+	}
+	if names, e := runtimeFreshDirectoryPage(freshDirectoryPageFixture("valid-😀"), runtimeFreshPrivateDirectory); e != nil || len(names) != 1 {
+		t.Fatal("valid surrogate pair")
+	}
+	for _, role := range []runtimeFreshDirectoryRole{0, 3, 255} {
+		if _, e := runtimeFreshDirectoryPage(good, role); e == nil {
+			t.Fatal("arbitrary role")
+		}
+	}
+	for _, name := range []string{"alpha", "ALPHA"} {
+		s := runtimeFreshDirectoryState{role: runtimeFreshPrivateDirectory}
+		if s.begin() != nil || s.accept(freshDirectoryPageFixture("alpha")) != nil || s.begin() != nil || s.accept(freshDirectoryPageFixture(name)) == nil {
+			t.Fatal("cross-page duplicate")
+		}
+		if _, e := s.finish(); e == nil {
+			t.Fatal("failed stream completed")
+		}
+	}
+	s := runtimeFreshDirectoryState{role: runtimeFreshDenialDirectory}
+	if _, e := s.finish(); e == nil {
+		t.Fatal("no precise terminal query")
+	}
+	if s.begin() != nil || s.begin() == nil {
+		t.Fatal("two pending calls")
+	}
+	if _, e := s.finish(); e != nil {
+		t.Fatal("precise empty terminal")
+	}
+	if s.begin() == nil {
+		t.Fatal("query after terminal")
+	}
+	// Worst-case valid pages: one frame each,49 names plus two distinct dot
+	// entries, then one exact terminal query. No extra page/retry is permitted.
+	s = runtimeFreshDirectoryState{role: runtimeFreshDenialDirectory}
+	for _, name := range []string{".", ".."} {
+		if s.begin() != nil || s.accept(freshDirectoryPageFixture(name)) != nil {
+			t.Fatal("dot frame")
+		}
+	}
+	for i := 0; i < 49; i++ {
+		if s.begin() != nil || s.accept(freshDirectoryPageFixture(fmt.Sprintf("n%d", i))) != nil {
+			t.Fatal("bounded fragmented stream")
+		}
+	}
+	if s.begin() != nil {
+		t.Fatal("last terminal allowance")
+	}
+	names, e := s.finish()
+	if e != nil || len(names) != 49 || s.pages != 52 {
+		t.Fatal("wrong complete stream budget")
+	}
+	s = runtimeFreshDirectoryState{role: runtimeFreshPrivateDirectory, pages: 515}
+	if s.begin() == nil {
+		t.Fatal("unbounded native page retries")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_directory_windows.go b/rdd/pkg/managementconfig/runtime_fresh_directory_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..baa8c2787ae7352b6cdf598827364439b67f330d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_directory_windows.go
@@ -0,0 +1,214 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"unsafe"
+)
+
+// One synchronous query frame, published in original n before the FILE_OPEN
+// output or any native metadata output. Unknown output/query/panic fences n and
+// retains this backing/slot; it is not another owner or closer.
+type nativeFreshDirectoryQuery struct {
+	source, parent    *runtimeStorageObject
+	role              runtimeFreshDirectoryRole
+	backing           []uint64
+	buffer            []byte
+	resource          *runtimeStorageResource
+	status            windows.IO_STATUS_BLOCK // native output retained even for pending zero-handle reply
+	objectName        *windows.NTUnicodeString
+	attributes        windows.OBJECT_ATTRIBUTES
+	lease             *runtimeStorageObject
+	sourceID, leaseID [3]uint64 // FILE_ID_INFO: full volume64 +fileID128 (24bytes)
+	state             runtimeFreshDirectoryState
+}
+
+// Pure custody admission only. Actual token/native identity/descriptor and
+// full FILE_ID_INFO checks below remain mandatory before any enumeration.
+func (n *nativeRuntimeStorage) freshDirectoryCustodyKnownLocked(source, parent *runtimeStorageObject, role runtimeFreshDirectoryRole) bool {
+	if n == nil || n.captureSelf != n || !n.captureStarted || n.unknown || n.closeAttempted || role.limit() == 0 || source == nil || parent == nil || !source.directory || !source.private || source.traversal || !parent.directory || len(n.ancestry) < 2 {
+		return false
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known {
+		return false
+	}
+	if role == runtimeFreshPrivateDirectory {
+		if source != n.ancestry[len(n.ancestry)-1] || parent != n.ancestry[len(n.ancestry)-2] {
+			return false
+		}
+	}
+	if !n.captureComplete {
+		s := n.freshChoice
+		if role != runtimeFreshPrivateDirectory || n.captureKind != runtimeStorageFreshCapture || s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.storage != n || s.owner.closed || s.owner.unknown || s.owner.captureComplete {
+			return false
+		}
+		freshSetupOwners.Lock()
+		known = freshSetupOwners.owners[s.owner]
+		freshSetupOwners.Unlock()
+		if !known {
+			return false
+		}
+	}
+	sourceOwned, parentOwned := false, false
+	for _, slot := range n.resources {
+		if slot == nil || slot.attempted || slot.handle == 0 || slot.handle == windows.InvalidHandle {
+			continue
+		}
+		sourceOwned = sourceOwned || slot == source.resource
+		parentOwned = parentOwned || slot == parent.resource
+	}
+	return sourceOwned && parentOwned
+}
+func (n *nativeRuntimeStorage) freshPrivateDirectoryNamesLocked(ctx context.Context) ([]string, error) {
+	if n == nil || len(n.ancestry) < 2 {
+		return nil, ErrUpgrade
+	}
+	return n.freshDirectoryNamesLocked(ctx, n.ancestry[len(n.ancestry)-1], n.ancestry[len(n.ancestry)-2], runtimeFreshPrivateDirectory)
+}
+func (n *nativeRuntimeStorage) freshDenialDirectoryNamesLocked(ctx context.Context, dirs [runtimeFreshLegacyDirectoryCount]*runtimeStorageObject) ([]string, error) {
+	return n.freshDirectoryNamesLocked(ctx, dirs[4], dirs[3], runtimeFreshDenialDirectory)
+}
+
+// Original n.mu/thread/controller (or registered original pre-controller
+// selector) is held. Only fixed same-object FILE_OPEN LIST leases are acquired:
+// .orbwin-private or final rdd.pid, never guessed paths or original handle
+// broadening. Legacy generation enumeration remains unchanged.
+func (n *nativeRuntimeStorage) freshDirectoryNamesLocked(ctx context.Context, source, parent *runtimeStorageObject, role runtimeFreshDirectoryRole) (result []string, failure error) {
+	if !freshBoundedContext(ctx) || !n.freshDirectoryCustodyKnownLocked(source, parent, role) || n.freshDirectoryQuery != nil {
+		return nil, ErrUpgrade
+	}
+	if n.captureComplete {
+		if n.check() != nil {
+			return nil, ErrUpgrade
+		}
+	} else if n.checkToken() != nil {
+		return nil, ErrUpgrade
+	}
+	if n.checkObject(source) != nil || n.checkObject(parent) != nil {
+		return nil, ErrUpgrade
+	}
+	backing, buffer, e := managementDirectoryBuffer(64 << 10)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	f := &nativeFreshDirectoryQuery{source: source, parent: parent, role: role, backing: backing, buffer: buffer, state: runtimeFreshDirectoryState{role: role}}
+	n.freshDirectoryQuery = f
+	defer func() {
+		if recover() != nil {
+			n.fence()
+			result = nil
+			failure = ErrUpgrade
+		}
+		if n.unknown {
+			return
+		}
+		if f.lease != nil {
+			if n.closeTemporary(f.resource) != nil {
+				result = nil
+				failure = ErrUpgrade
+				return
+			}
+		}
+		n.freshDirectoryQuery = nil
+	}()
+	name := ".orbwin-private"
+	if role == runtimeFreshDenialDirectory {
+		name = "rdd.pid"
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	f.objectName = text
+	f.attributes = windows.OBJECT_ATTRIBUTES{RootDirectory: parent.resource.handle, ObjectName: f.objectName, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	f.attributes.Length = uint32(unsafe.Sizeof(f.attributes))
+	f.resource = n.keep(0)
+	e = windows.NtCreateFile(&f.resource.handle, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &f.attributes, &f.status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, windows.FILE_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	runtime.KeepAlive(f)
+	if n.freshDirectoryOpenReplyLocked(f, e) != nil {
+		return nil, ErrUpgrade
+	}
+
+	// Mark actual successful custody before even identity inspection, so known
+	// refusal closes it once; uncertainty/panic retains its preregistered slot.
+	f.lease = &runtimeStorageObject{resource: f.resource, directory: true, private: source.private, traversal: source.traversal}
+	id, e := runtimeStorageIdentityOf(f.resource.handle, n.sid, true, source.private, source.traversal)
+	if e != nil || id != source.identity {
+		return nil, ErrUpgrade
+	}
+	f.lease.identity = id
+	// These outputs are in the preregistered aligned frame. Comparing legacy
+	// volume32/file64 facts alone would not establish full same-object identity.
+	if windows.GetFileInformationByHandleEx(source.resource.handle, windows.FileIdInfo, (*byte)(unsafe.Pointer(&f.sourceID[0])), 24) != nil {
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	if windows.GetFileInformationByHandleEx(f.resource.handle, windows.FileIdInfo, (*byte)(unsafe.Pointer(&f.leaseID[0])), 24) != nil {
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	runtime.KeepAlive(f)
+	if f.sourceID == ([3]uint64{}) || f.sourceID != f.leaseID || n.checkObject(source) != nil || n.checkObject(f.lease) != nil {
+		return nil, ErrUpgrade
+	}
+	class := uint32(windows.FileIdBothDirectoryRestartInfo)
+	for {
+		if !freshBoundedContext(ctx) || f.state.begin() != nil || n.checkObject(source) != nil || n.checkObject(f.lease) != nil {
+			return nil, ErrUpgrade
+		}
+		e = windows.GetFileInformationByHandleEx(f.resource.handle, class, &f.buffer[0], uint32(len(f.buffer)))
+		runtime.KeepAlive(f.backing)
+		if e == windows.ERROR_NO_MORE_FILES {
+			if !freshBoundedContext(ctx) || n.checkObject(source) != nil || n.checkObject(f.lease) != nil {
+				return nil, ErrUpgrade
+			}
+			return f.state.finish()
+		}
+		if e != nil {
+			n.fence()
+			return nil, ErrUpgrade
+		} // never parse failed/partial metadata
+		if !freshBoundedContext(ctx) || f.state.accept(f.buffer) != nil {
+			return nil, ErrUpgrade
+		}
+		class = windows.FileIdBothDirectoryInfo
+		clear(f.buffer)
+	}
+}
+
+// Pure classification of the actual preregistered FILE_OPEN output. Pending
+// is not a completed no-output error: retain its IOSB, slot and query backing
+// even while handle is zero, and never query/close/retry an unresolved call.
+// The shared open-reply classifier remains unchanged for all other callers.
+func (n *nativeRuntimeStorage) freshDirectoryOpenReplyLocked(f *nativeFreshDirectoryQuery, callErr error) error {
+	if n == nil || f == nil || n.freshDirectoryQuery != f {
+		return ErrUpgrade
+	}
+	if !n.freshDirectoryCustodyKnownLocked(f.source, f.parent, f.role) || f.resource == nil || f.resource.attempted || len(n.resources) == 0 || n.resources[len(n.resources)-1] != f.resource {
+		n.fence()
+		return ErrUpgrade
+	}
+	if callErr == windows.STATUS_PENDING || f.status.Status == windows.STATUS_PENDING {
+		n.fence()
+		return ErrUpgrade
+	}
+	// A successful fixed FILE_OPEN must settle synchronously with STATUS_SUCCESS
+	// and FILE_OPENED, not an uninitialized or contradictory IOSB. Unknown state
+	// retains the exact slot even if the current handle happens to be zero.
+	if callErr == nil && (f.status.Status != 0 || f.status.Information != 1) {
+		n.fence()
+		return ErrUpgrade
+	}
+	reply := runtimeStorageOpenReply(callErr, f.resource.handle != 0 && f.resource.handle != windows.InvalidHandle, func() {}, n.fence)
+	if reply != nil && !n.unknown {
+		n.resources = n.resources[:len(n.resources)-1]
+		f.resource = nil
+	}
+	return reply
+}
