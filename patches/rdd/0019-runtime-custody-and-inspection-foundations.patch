+func TestRuntimeUpgradeCredentialsTerminalBuffersSurviveNoPanicLeak(t *testing.T) {
+	data := runtimeUpgradeCredentialData{ca: []byte("synthetic-ca"), admin: []byte("synthetic-admin"), user: []byte("synthetic-user")}
+	ca, admin, user := data.ca, data.admin, data.user
+	complete := false
+	func() { defer func() { recover() }(); defer data.clearUnlessComplete(&complete); panic(ErrUpgrade) }()
+	if data.ca != nil || data.admin != nil || data.user != nil || !bytes.Equal(ca, make([]byte, len(ca))) || !bytes.Equal(admin, make([]byte, len(admin))) || !bytes.Equal(user, make([]byte, len(user))) {
+		t.Fatal("terminal parser guard failed to clear owned buffers on panic")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var partial []byte
+	var recovered any
+	func() {
+		defer func() { recovered = recover() }()
+		_, _ = readRuntimeUpgradeCredentials(ctx, 32, func() error { return nil }, func(b []byte) (uint32, error) {
+			partial = b
+			copy(b, []byte("synthetic-private-read"))
+			panic(ErrUpgrade)
+		})
+	}()
+	if recovered != ErrUpgrade || len(partial) != 32 || !bytes.Equal(partial, make([]byte, 32)) {
+		t.Fatal("read callback panic leaked unassigned private buffer")
+	}
+	data.admin = []byte("known-success")
+	retained := data.admin
+	complete = true
+	data.clearUnlessComplete(&complete)
+	if !bytes.Equal(data.admin, retained) || len(data.admin) == 0 {
+		t.Fatal("successful private result prematurely cleared")
+	}
+	data.clear()
