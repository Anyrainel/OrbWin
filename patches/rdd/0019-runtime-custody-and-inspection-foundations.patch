+	g := p.guest
+	var e error
+	g.directories, g.disk, e = g.capturePathLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	g.shape = classifyRuntimeFreshGuest(g.guid != "", len(g.directories) > 0, g.disk != nil)
+	if g.shape != runtimeFreshGuestAbsent {
+		return ErrUpgrade
+	}
+	return g.checkLocked(ctx)
+}
+
+// Lower native writer names are derived only from this exact issuer's original
+// graph. Initial producers may CREATE only completion here; pending producers
+// additionally issue their fixed directory/repair records. No generic file API.
+func (d *runtimeFreshLegacyDenial) denialFileRoleLocked(parent *runtimeStorageObject, name string, create bool) bool {
+	if !d.knownLocked() || parent == nil {
+		return false
+	}
+	n := d.owner.storage
+	private := len(n.ancestry) > 0 && parent == n.ancestry[len(n.ancestry)-1]
+	public := parent == d.directories[4]
+	if !private && !public {
+		return false
+	}
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		directory, _ := runtimeFreshDenialDirectoryName(i)
+		repair, _ := runtimeFreshDenialRepairName(i)
+		completion, _ := runtimeFreshDenialCompletionName(i)
+		if public && name == completion {
+			return true
+		}
+		if d.prefix != nil && (private && name == directory || public && name == repair) {
+			return true
+		}
+		if !create && d.prefix != nil {
+			archive, _ := runtimeFreshDenialArchiveName(i)
+			ir, _ := runtimeFreshIntentRepairName(i)
+			ia, _ := runtimeFreshIntentArchiveName(i)
+			if public && name == archive || private && (name == ir || name == ia) {
+				return true
+			}
+		}
+	}
+	if !create && d.prefix != nil {
+		seed, _ := (runtimeFreshSeedName{d.owner.intent.Transaction, d.owner.intent.Image, d.owner.intent.Commit, d.owner.intent.Seed.Binding}).name()
+		return private && (name == seed || name == runtimeFreshFenceName) || public && name == runtimeFreshLegacyDenialName
+	}
+	return false
+}
+
+func (p *nativeFreshDenialPrefix) closeSelectedVerificationLocked(ctx context.Context) error {
+	if p == nil || !p.admittedProducerLocked(p.producer) || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	r, o := p.recovery, p.recovery.owner
+	n := o.storage
+	if r.selectedSeed == nil && r.selectedIntent == nil {
+		return nil
+	}
+	s := n.freshChoice
+	seed := r.selectedSeed
+	if s == nil || s.self != s || s.owner != o || s.resume != r || s.seed != seed || seed == nil || seed.self != seed || seed.owner != o || o.seed != seed || seed.object == nil || r.selectedIntent == nil || seed.object == p.seed || r.selectedIntent == o.fenceObject || seed.object.identity != p.seed.identity || r.selectedIntent.identity != o.fenceObject.identity {
+		return ErrUpgrade
+	}
+	b, e := n.read(r.selectedIntent, false)
+	ib, ie := n.read(o.fenceObject, false)
+	if e != nil || ie != nil || !bytes.Equal(b, ib) || runtimeFreshSeedObjectFact(seed.object, o.intent.Seed.Binding) != o.intent.Seed {
+		return ErrUpgrade
+	}
+	// Both originals remain pointer-identifiable; only their redundant selector
+	// observations close. The authoritative original o intent and p seed survive.
+	if n.closeTemporary(r.selectedIntent.resource) != nil || n.closeTemporary(seed.object.resource) != nil {
+		p.producer.fenceLocked()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Pure custody admission after the actual same-parent rename, positive DELETE
+// source close, immutable archive reopen, exact identity and byte readback above.
+// This adds no closer and issues no native operation. SAME n still owns the
+// exact latest successful open. Cache reuse only rechecks this held READ lease;
+// it must never close/reopen WRITE to reflush the just-archived source again.
+func (d *runtimeFreshLegacyDenial) retainRenamedArchiveLocked(archived *runtimeStorageObject, recipe runtimeFreshDenialRepair) error {
+	if !d.knownLocked() || d.prefix == nil || archived == nil || archived.resource == nil || archived.resource.attempted || archived.resource.handle == 0 || archived.resource.handle == windows.InvalidHandle || archived.directory || !archived.private || archived.traversal || !recipe.valid() {
+		return ErrUpgrade
+	}
+	p, n := d.prefix, d.owner.storage
+	if p.recovery.complete || d.owner.captureComplete || p.count != runtimeFreshLegacyDirectoryCount || p.probe == nil || !runtimeArgsSlotClosed(p.probe.resource) || archived.resource == p.probe.resource || archived.identity != p.probe.identity || len(n.resources) == 0 || n.resources[len(n.resources)-1] != archived.resource || runtimeStorageFileData(archived, p.probeBody) != recipe.Old || recipe.DesiredSize != uint64(len(d.body)) || recipe.Desired != sha256.Sum256(d.body) {
+		return ErrUpgrade
+	}
+	plan, e := n.denialPlanLocked(d.owner.intent, d.record.Intent)
+	if e != nil || recipe.Plan != plan {
+		return ErrUpgrade
+	}
+	parent := d.directories[runtimeFreshLegacyDirectoryCount-1]
+	name, _ := runtimeFreshDenialArchiveName(recipe.Ordinal)
+	if parent == nil || !d.denialFileRoleLocked(parent, name, false) {
+		return ErrUpgrade
+	}
+	for _, held := range d.durable {
+		if held.parent == parent && held.name == name || held.object == archived || held.object != nil && held.object.resource == archived.resource {
+			return ErrUpgrade
+		}
+	}
+	d.durable = append(d.durable, nativeFreshDenialDurableFile{parent, name, archived, append([]byte(nil), p.probeBody...)})
+	return nil
+}
