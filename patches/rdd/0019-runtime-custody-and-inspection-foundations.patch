+func TestRuntimeUpgradeManagementProjectionOwnershipAndTerminalClear(t *testing.T) {
+	a, v := runtimeManagementFixture(t)
+	app, err := parseRuntimeUpgradeManagementApp(a)
+	if err != nil {
+		t.Fatal("App fixture")
+	}
+	vm, err := parseRuntimeUpgradeManagementVM(v, app)
+	if err != nil {
+		t.Fatal("VM fixture")
+	}
+	appCopy, vmCopy := app.clone(), vm.clone()
+	appCopy.spec[0], appCopy.status[0] = '!', '!'
+	vmCopy.spec[0], vmCopy.status[0] = '!', '!'
+	if app.spec[0] != '{' || app.status[0] != '{' || vm.spec[0] != '{' || vm.status[0] != '{' {
+		t.Fatal("projection clones alias original owned buffers")
+	}
+	appCopy.clear()
+	vmCopy.clear()
+	state, err := composeRuntimeUpgradeManagementState(app, app, vm)
+	if err != nil {
+		t.Fatal("state fixture")
+	}
+	projectionBuffers := [][]byte{app.spec, app.status, vm.spec, vm.status}
+	func() {
+		defer func() { recover() }()
+		defer app.clear()
+		defer vm.clear()
+		panic(ErrUpgrade)
+	}()
+	for _, buffer := range projectionBuffers {
+		if !bytes.Equal(buffer, make([]byte, len(buffer))) {
+			t.Fatal("terminal projection clear left owned bytes")
+		}
+	}
+	returned := state.clone()
+	returned.appSpec[0], returned.appStatus[0], returned.vmSpec[0], returned.vmStatus[0] = '!', '!', '!', '!'
+	if state.appSpec[0] != '{' || state.appStatus[0] != '{' || state.vmSpec[0] != '{' || state.vmStatus[0] != '{' {
+		t.Fatal("returned state aliases retained capture")
+	}
+	returned.clear()
+	owned := [][]byte{state.appSpec, state.appStatus, state.vmSpec, state.vmStatus}
+	state.clear()
+	for _, buffer := range owned {
+		if !bytes.Equal(buffer, make([]byte, len(buffer))) {
+			t.Fatal("terminal capture clear left owned bytes")
+		}
+	}
+	if state.appUID != "" || state.appSpec != nil || app.uid != "" || vm.uid != "" {
+		t.Fatal("terminal projections retained metadata")
+	}
+}
