+func runtimeManagementChange(t *testing.T, body []byte, change func(map[string]any)) []byte {
+	t.Helper()
+	var value map[string]any
+	if json.Unmarshal(body, &value) != nil {
+		t.Fatal("fixture parse")
+	}
+	change(value)
+	out, e := json.Marshal(value)
+	if e != nil {
+		t.Fatal("fixture marshal")
+	}
+	return out
+}
