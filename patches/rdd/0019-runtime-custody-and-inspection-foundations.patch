+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+)
+
+func TestSelectionOwnerFactoriesRejectBeforeNativeCapture(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	stopped, stop := context.WithCancel(ctx)
+	stop()
+	expired, end := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer end()
+	servingImageCaptures.Lock()
+	count, failed := len(servingImageCaptures.owners), servingImageCaptures.failed
+	servingImageCaptures.Unlock()
+	for _, input := range []context.Context{nil, context.Background(), ctx, stopped, expired} {
+		for _, owner := range []*authoritypath.ProductSelectionOwner{nil, {}} {
+			if root, e := ResolveOrbWinRootFromSelectionOwner(input, owner); e == nil || root != nil {
+				t.Fatal("unowned/unbounded root admitted")
+			}
+			if lease, e := HoldServingImageFromSelectionOwner(input, owner); e == nil || lease != nil {
+				t.Fatal("unowned/unbounded image admitted")
+			}
+			if lease, e := HoldServingForwarderFromSelectionOwner(input, owner, [32]byte{1}); e == nil || lease != nil {
+				t.Fatal("unowned forwarder admitted")
+			}
+		}
+	}
+	if lease, e := HoldServingForwarderFromSelectionOwner(ctx, nil, [32]byte{}); e == nil || lease != nil {
+		t.Fatal("empty sibling digest admitted")
+	}
+	servingImageCaptures.Lock()
+	defer servingImageCaptures.Unlock()
+	if len(servingImageCaptures.owners) != count || servingImageCaptures.failed != failed {
+		t.Fatal("refusal created/fenced an actual serving graph")
+	}
+}
+
+func TestSelectionOwnerRootFactsAreRefusalDataOnly(t *testing.T) {
+	profile := `C:\Users\native`
+	home := `D:\Local\OrbWinData\home`
+	parent := profile + `\.orbwin-private`
+	sid := "S-1-5-21-1"
+	if !selectionOwnerRootFactsValid(profile, home, parent, sid) || !selectionOwnerRootFactsValid(profile, strings.ToUpper(home), strings.ToUpper(parent), sid) {
+		t.Fatal("native redirected local home/case policy changed")
+	}
+	for _, v := range []struct{ profile, home, parent, sid string }{
+		{"", home, parent, sid}, {profile, `relative\OrbWinData\home`, parent, sid}, {profile, `D:\Local\home`, parent, sid},
+		{profile, `D:\Local\OrbWinData\home\..`, parent, sid}, {profile, home, profile + `\authority`, sid}, {profile, home, parent, ""},
+		{profile, home, parent, "S-1-5\x00-1"}, {`\\server\profile`, home, parent, sid}, {profile, `D:\Local\OrbWinData\home.`, parent, sid},
+	} {
+		if selectionOwnerRootFactsValid(v.profile, v.home, v.parent, v.sid) {
+			t.Fatal("malformed selected shape accepted", v)
+		}
+	}
+	// Shape can describe native redirects but cannot construct Selection/owner,
+	// InstanceRoot, a file output or a native successful factory in this test.
+}
diff --git a/rdd/pkg/managementconfig/serving_image_custody_windows_test.go b/rdd/pkg/managementconfig/serving_image_custody_windows_test.go
