+)
+
+func TestAppTemplateConsumerBindsActualController(t *testing.T) {
+	yes := true
+	ref := metav1.OwnerReference{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "App", Name: "app", UID: "original-app-uid", Controller: &yes}
+	vm := &metav1.PartialObjectMetadata{ObjectMeta: metav1.ObjectMeta{OwnerReferences: []metav1.OwnerReference{ref}}}
+	source := vm.DeepCopy()
+	if RequireAppTemplateController(vm, source) != nil {
+		t.Fatal("same App controller refused")
+	}
+	for _, change := range []func(*metav1.PartialObjectMetadata){func(o *metav1.PartialObjectMetadata) { o.OwnerReferences = nil }, func(o *metav1.PartialObjectMetadata) { o.OwnerReferences[0].UID = "other" }, func(o *metav1.PartialObjectMetadata) { o.OwnerReferences[0].Name = "other" }, func(o *metav1.PartialObjectMetadata) { o.OwnerReferences[0].Kind = "Other" }, func(o *metav1.PartialObjectMetadata) { o.OwnerReferences[0].APIVersion = "other/v1" }, func(o *metav1.PartialObjectMetadata) { o.OwnerReferences[0].Controller = nil }, func(o *metav1.PartialObjectMetadata) {
+		o.OwnerReferences = append(o.OwnerReferences, o.OwnerReferences[0])
+	}} {
+		bad := source.DeepCopy()
+		change(bad)
+		if RequireAppTemplateController(vm, bad) == nil {
+			t.Fatal("foreign source template consumed")
+		}
+	}
+	badVM := vm.DeepCopy()
+	badVM.OwnerReferences[0].UID = ""
+	if RequireAppTemplateController(badVM, source) == nil {
+		t.Fatal("invalid VM App owner")
+	}
+	if RequireAppTemplateController(&metav1.PartialObjectMetadata{}, &metav1.PartialObjectMetadata{}) != nil {
+		t.Fatal("standalone explicit-template behavior changed")
+	}
+}
