@@ -0,0 +1,66 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Actual retained peer/process-derived path only, never a caller selected walk.
+// Capacity is fixed before entry so no append relocates an original out-cell.
+func (i *upgradeLegacySDKObservedImage) openObservedPart(ctx context.Context) (h windows.Handle, failure error) {
+	if i == nil || i.captureSelf != i || i.peer == nil || i.peer.image != i || i.closed || i.unknown || i.openFrame != nil || !freshBoundedContext(ctx) || len(i.chain) > len(i.parts) || cap(i.chain) != len(i.parts)+1 {
+		return 0, ErrUpgrade
+	}
+	at := len(i.chain)
+	i.chain = append(i.chain, 0)
+	f := &runtimeImageOpenFrame{owner: i, output: &i.chain[at]}
+	if at == 0 {
+		f.name = i.volume
+	} else {
+		if !i.frames[at-1].state.usable() {
+			i.fenceRuntimeImageOpenFrame()
+			return 0, ErrUpgrade
+		}
+		f.parent = i.chain[at-1]
+		f.name = i.parts[at-1]
+	}
+	i.frames = append(i.frames, f)
+	i.openFrame = f
+	defer func() {
+		if recover() != nil {
+			f.fence()
+			h = 0
+			failure = ErrUpgrade
+		}
+	}()
+	var e error
+	switch {
+	case at == 0:
+		_, e = f.volume(i.volume)
+	case at < len(i.parts):
+		_, e = f.ntCall(f.parent, f.name, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	default:
+		_, e = openUpgradeObservedImageFileInto(f, f.parent, f.name)
+	}
+	if e != nil {
+		if sdkImageReleaseState(&f.state) && !f.state.admitted {
+			// Exact terminal no-output/pre-entry-no-effect tail only; never touch a
+			// pending output. Win32 INVALID_HANDLE_VALUE is a failure sentinel.
+			*f.output = 0
+			i.chain = i.chain[:at]
+			i.openFrame = nil
+		}
+		return 0, e
+	}
+	if !runtimeStorageRealWin32Output(uintptr(*f.output)) || !f.state.attach() {
+		f.fence()
+		return 0, ErrUpgrade
+	}
+	i.openFrame = nil
+	if ctx.Err() != nil {
+		return 0, ErrUpgrade
+	}
+	return *f.output, nil
+}
