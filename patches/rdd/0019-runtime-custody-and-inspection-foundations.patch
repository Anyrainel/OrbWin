+func TestRuntimeBuildOriginMappedStoragePhaseCannotUseCopiedMutexGraph(t *testing.T) {
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	slot := &runtimeStorageResource{}
+	n.resources = []*runtimeStorageResource{slot}
+	copy := &nativeRuntimeStorage{captureSelf: n, captureStarted: true, captureComplete: true, resources: n.resources}
+	runtimeStorageDomain.Lock()
+	oldFailed := runtimeStorageDomain.failed
+	runtimeStorageDomain.failed = false
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	defer func() {
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = oldFailed
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.Unlock()
+	}()
+	n.mu.Lock()
+	known := runtimeMappedSelfStorageKnownLocked(n)
+	n.mu.Unlock()
+	copy.mu.Lock()
+	copied := runtimeMappedSelfStorageKnownLocked(copy)
+	copy.mu.Unlock()
+	if !known || copied || slot.attempted {
+		t.Fatal("copied wrapper selected an independent controller mutex")
+	}
+	n.mu.Lock()
+	n.captureComplete = false
+	incomplete := runtimeMappedSelfStorageKnownLocked(n)
+	n.captureComplete = true
+	n.closeAttempted = true
+	closing := runtimeMappedSelfStorageKnownLocked(n)
+	n.mu.Unlock()
+	if incomplete || closing {
+		t.Fatal("incomplete/closing storage phase admitted")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
