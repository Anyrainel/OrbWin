+func TestRuntimeUpgradeManagementFixedHTTPExchange(t *testing.T) {
+	for _, response := range []string{runtimeManagementResponse(`{"value":true}`), "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\ne\r\n{\"value\":true}\r\n0\r\n\r\n"} {
+		connection := &runtimeManagementMemoryConnection{input: strings.NewReader(response)}
+		body, err := runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath)
+		if err != nil || string(body) != `{"value":true}` || connection.writes != 1 || connection.closed {
+			t.Fatal("bounded framed exchange or raw ownership")
+		}
+		request, err := http.ReadRequest(bufio.NewReader(bytes.NewReader(connection.out.Bytes())))
+		if err != nil || request.Method != "GET" || request.RequestURI != runtimeUpgradeManagementAppPath || request.Host != "127.0.0.1:6443" || request.Close || request.Header.Get("Authorization") != "Bearer "+credentialTestAdmin || request.Header.Get("Accept-Encoding") != "identity" {
+			t.Fatal("fixed credential request changed")
+		}
+		clear(body)
+	}
+}
