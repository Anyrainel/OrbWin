--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_startup_windows.go
@@ -0,0 +1,206 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+
+	"golang.org/x/sys/windows"
+)
+
+// Fixed namespace check is mandatory even for legacy admissions without C
+// fields. Otherwise removing the fields could silently bypass a retained root.
+// Caller holds actual storage/controller exclusion and OS thread.
+func (n *nativeRuntimeStorage) controlNamespaceLocked(ctx context.Context, transaction string, hasControl bool) error {
+	if n == nil || len(n.ancestry) == 0 || !freshBoundedContext(ctx) || !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil {
+		return ErrUpgrade
+	}
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if !runtimeFreshControlNamespaceNamesValid(names, transaction, hasControl) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Ordinary startup validates C using only its actual n, under the existing
+// controller lock. No synthetic FreshSetupOwner/recovery grant is constructed.
+// Every open is FILE_OPEN; unknown replies preserve original output slots.
+// Success requires native old ID/SD/body graph and actual canonical birth.
+func (n *nativeRuntimeStorage) checkFreshControlStartupLocked(ctx context.Context, a runtimeFreshAdmission) (failure error) {
+	zero := runtimePublicationFileWitness{}
+	if !a.valid() || n.controlNamespaceLocked(ctx, a.Transaction, a.ControlRetention != zero) != nil {
+		return ErrUpgrade
+	}
+	if a.ControlRetention == zero {
+		return nil
+	}
+	start := len(n.resources)
+	defer func() {
+		if recover() != nil {
+			n.fence()
+			failure = ErrUpgrade
+			return
+		}
+		if n.unknown || !runtimeStorageDomainKnown() {
+			failure = ErrUpgrade
+			return
+		}
+		// Successful immutable witnesses remain n-owned through handoff.
+		if failure == nil {
+			return
+		}
+		for len(n.resources) > start {
+			if n.closeTemporary(n.resources[len(n.resources)-1]) != nil {
+				failure = ErrUpgrade
+				return
+			}
+		}
+	}()
+	parent := n.ancestry[len(n.ancestry)-1]
+	open := func(parent *runtimeStorageObject, name string, directory bool) (*runtimeStorageObject, error) {
+		access := uint32(windows.FILE_READ_DATA)
+		if directory {
+			access = windows.FILE_LIST_DIRECTORY | windows.FILE_TRAVERSE
+		}
+		return n.openFreshExistingTracked(ctx, parent.resource.handle, name, directory, access, windows.FILE_SHARE_READ, true, false)
+	}
+	type slot struct {
+		ordinal uint32
+		body    []byte
+	}
+	var partials []slot
+	var record runtimeFreshControlRetention
+	var recordObject *runtimeStorageObject
+	var recordBody []byte
+	gap := false
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlRecordName(ordinal)
+		object, e := open(parent, name, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || recordObject != nil {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		var value runtimeFreshControlRetention
+		if parseRuntimeFreshRecord(body, &value) == nil && value.valid() {
+			if value.Ordinal != ordinal || runtimeStorageFileData(object, body) != a.ControlRetention {
+				return ErrUpgrade
+			}
+			record, recordObject, recordBody = value, object, body
+		} else {
+			partials = append(partials, slot{ordinal, body})
+		}
+	}
+	if recordObject == nil {
+		return ErrUpgrade
+	}
+	for _, partial := range partials {
+		value := record
+		value.Ordinal = partial.ordinal
+		wanted, e := runtimeFreshRecordBytes(value)
+		if e != nil || !runtimeFreshControlPrefixBytes(partial.body, wanted) {
+			return ErrUpgrade
+		}
+	}
+	if record.Transaction != a.Transaction || record.Intent != a.Intent || record.Denial != a.LegacyDenial || record.PrivateParent != runtimeStorageObjectData(parent) || record.PrivateDescriptor != parent.identity.descriptor || record.PublicParent != runtimeStorageObjectData(n.parent) || record.Controller != runtimeStorageObjectData(n.controller) || record.PublicDescriptor != n.parent.identity.descriptor || record.ControllerDescriptor != n.controller.identity.descriptor {
+		return ErrUpgrade
+	}
+	init, e := initializationBytes(record.Args)
+	if e != nil || uint64(len(record.Args)) != a.Args.Size || sha256.Sum256(record.Args) != a.Args.Body || uint64(len(init)) != a.Initialization.Size || sha256.Sum256(init) != a.Initialization.Body {
+		return ErrUpgrade
+	}
+	name, _ := runtimeFreshControlRetainedName(a.Transaction)
+	old, e := open(parent, name, true)
+	if e != nil || runtimeStorageObjectData(old) != record.OldAuthority || old.identity.descriptor != record.OldDescriptor {
+		return ErrUpgrade
+	}
+	lock, e := open(old, "authority.owner.lock", false)
+	if e != nil || runtimeStorageObjectData(lock) != record.OldOwnerLock || lock.identity.descriptor != record.OwnerDescriptor || lock.identity.size != 0 {
+		return ErrUpgrade
+	}
+	names, e := datastoreDirectoryNames(old.resource.handle)
+	if e != nil || len(names) != len(record.Inventory)+1 {
+		return ErrUpgrade
+	}
+	expected := map[string]bool{"authority.owner.lock": true}
+	roleNames := map[string]string{"tls": "tls", "db": "db", "args": "args.json", "init": "authority.init"}
+	for _, fact := range record.Inventory {
+		fixed := roleNames[fact.Role]
+		expected[fixed] = true
+		object, e := open(old, fixed, fact.Directory)
+		if e != nil || runtimeStorageObjectData(object) != fact.Object || object.identity.descriptor != fact.Descriptor || object.identity.size != fact.Size {
+			return ErrUpgrade
+		}
+		if fact.Directory {
+			children, e := datastoreDirectoryNames(object.resource.handle)
+			if e != nil || len(children) != 0 {
+				return ErrUpgrade
+			}
+		} else {
+			body, e := n.read(object, true)
+			wanted := record.Args
+			if fact.Role == "init" {
+				wanted = init
+			}
+			if e != nil || sha256.Sum256(body) != fact.Body || !runtimeFreshControlPrefixBytes(body, wanted) {
+				return ErrUpgrade
+			}
+		}
+	}
+	for _, name := range names {
+		if !expected[name] {
+			return ErrUpgrade
+		}
+		delete(expected, name)
+	}
+	if len(expected) != 0 {
+		return ErrUpgrade
+	}
+	current, e := open(parent, anchorName, true)
+	if e != nil || runtimeStorageObjectData(current) != a.Authority || a.Authority == record.OldAuthority {
+		return ErrUpgrade
+	}
+	gap = false
+	found := false
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		name, _ := runtimeFreshControlBirthName(ordinal)
+		object, e := open(parent, name, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || found {
+			return ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		birth := runtimeFreshControlBirth{Schema: 1, Transaction: a.Transaction, Ordinal: ordinal, Retention: runtimeStorageFileData(recordObject, recordBody), Authority: a.Authority, Descriptor: current.identity.descriptor}
+		wanted, e := runtimeFreshRecordBytes(birth)
+		if e != nil || !runtimeFreshControlPrefixBytes(body, wanted) {
+			return ErrUpgrade
+		}
+		if bytes.Equal(body, wanted) {
+			if !birth.matches(record, a.ControlRetention, a.Authority, current.identity.descriptor) || runtimeStorageFileData(object, body) != a.ControlBirth {
+				return ErrUpgrade
+			}
+			found = true
+		}
+	}
+	if !found || !freshBoundedContext(ctx) || n.check() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
