+	}
+	for _, command := range [][]string{{image, "service", "stop", "--secure-port", "6443"}, {`C:\Other\rdd.exe`, "service", "serve", "--secure-port", "6443"}, {image, "service", "serve", "--secure-port", "6444"}, append(append([]string{}, base...), "--home=foreign"), append(append([]string{}, base...), "--controllers=*"), append(append([]string{}, base...), "--secure-port", "6443")} {
+		if runtimeUpgradeOldCommandMatches(command, image, saved) {
