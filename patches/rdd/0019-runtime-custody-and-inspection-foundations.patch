+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshRecoveryMissingControlDataCannotEnterCreate(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n, captureComplete: true}
+	o.self = o
+	r := &nativeFreshRecoveryOwner{owner: o, complete: true}
+	r.self = r
+	n.freshRecovery = r
+	proof := &nativeFreshMissingControl{recovery: r}
+	proof.self = proof
+	r.missingControl = proof
+	if proof.checkLocked(ctx) == nil || len(n.resources) != 0 {
+		t.Fatal("decoded missing claim reached native provider")
+	}
+	if c, e := o.createMissingControlAuthority(ctx, []byte(`[]`)); e == nil || c != nil || o.created != nil || len(n.resources) != 0 {
+		t.Fatal("unregistered owner manufactured CREATE lineage")
+	}
+	copy := &FreshSetupOwner{storage: n, captureComplete: true}
+	copy.self = copy
+	if c, e := copy.createMissingControlAuthority(ctx, []byte(`[]`)); e == nil || c != nil || copy.created != nil || len(n.resources) != 0 {
+		t.Fatal("copied owner consumed original missing-control capability")
+	}
+	if c, e := o.createMissingControlAuthority(context.Background(), []byte(`[]`)); e == nil || c != nil {
+		t.Fatal("unbounded create reached provider")
+	}
+	if e := (*nativeFreshMissingControl)(nil).checkLocked(ctx); e == nil {
+		t.Fatal("nil absence claim admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_observation.go b/rdd/pkg/managementconfig/runtime_fresh_observation.go
new file mode 100644
index 0000000000000000000000000000000000000000..b67a5d362dbe61f2d01f8e4529e7dd30508ca4ec
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_observation.go
@@ -0,0 +1,212 @@
+package managementconfig
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	lima "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"unicode/utf16"
+)
+
+const freshRuntimeNamespace = "rancher-desktop"
+const freshRuntimeResponseBudget = 1 << 20
+
+var errFreshRuntimePending = errors.New("fresh runtime observation pending")
+
+func freshRuntimeManagementEndpoint(raw string) bool {
+	u, e := url.Parse(raw)
+	if e != nil || u.Scheme != "https" || u.Hostname() != "127.0.0.1" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || u.ForceQuery || u.Opaque != "" {
+		return false
+	}
+	p, e := strconv.ParseUint(u.Port(), 10, 16)
+	return e == nil && p > 0 && u.Port() == strconv.FormatUint(p, 10) && raw == "https://"+net.JoinHostPort("127.0.0.1", u.Port())
+}
+
+func parseFreshRuntimeSavedArguments(body []byte) error {
+	if _, e := parseRuntimeUpgradeArgs(body); e != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func freshRuntimeRegistryText(units []uint16) (string, error) {
+	if len(units) < 2 || units[len(units)-1] != 0 {
+		return "", ErrUpgrade
+	}
+	units = units[:len(units)-1]
+	for i := 0; i < len(units); i++ {
+		u := units[i]
+		if u == 0 || u >= 0xdc00 && u <= 0xdfff {
+			return "", ErrUpgrade
+		}
+		if u >= 0xd800 && u <= 0xdbff {
+			i++
+			if i >= len(units) || units[i] < 0xdc00 || units[i] > 0xdfff {
+				return "", ErrUpgrade
+			}
+		}
+	}
+	return string(utf16.Decode(units)), nil
+}
+
+func freshRuntimeRegistrationBase(base, home string) bool {
+	base = strings.TrimSuffix(strings.TrimPrefix(base, `\\?\`), `\`)
+	return len(home) > 3 && home[1] == ':' && home[2] == '\\' && !strings.ContainsAny(home[2:], ":/\x00") && strings.EqualFold(base, home+`\.rdorbwin\lima\orbwin`)
+}
+
+func freshRuntimeDockerRead(method, route string) bool {
+	if (method == "GET" || method == "HEAD") && route == "/_ping" {
+		return true
+	}
+	if method != "GET" {
+		return false
+	}
+	if route == "/info" {
+		return true
+	}
+	if !strings.HasPrefix(route, "/v") || !strings.HasSuffix(route, "/info") {
+		return false
+	}
+	version := strings.TrimSuffix(strings.TrimPrefix(route, "/v"), "/info")
+	fields := strings.Split(version, ".")
+	if len(fields) != 2 {
+		return false
+	}
+	for _, s := range fields {
+		n, e := strconv.ParseUint(s, 10, 16)
+		if e != nil || strconv.FormatUint(n, 10) != s {
+			return false
+		}
+	}
+	return true
+}
+
+// The same creation-only defaults as the existing installation flow. This is
+// desired DATA for the existing API/controllers, never readiness evidence.
+func freshRuntimeDesiredApp() *app.App {
+	return &app.App{
+		TypeMeta:   metav1.TypeMeta{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "App"},
+		ObjectMeta: metav1.ObjectMeta{Name: "app"},
+		Spec: app.AppSpec{Running: true, Namespace: freshRuntimeNamespace,
+			ContainerEngine: app.ContainerEngineSpec{Name: "moby"},
+			Kubernetes:      app.KubernetesSpec{Enabled: false, Version: "1.35.3"},
+			Application:     app.ApplicationSpec{AddPath: "manual"}},
+	}
+}
+
+// Selected nonsecret observations only. No field constructs a native witness.
+type freshRuntimeAPIData struct {
+	AppUID, AppVersion, VMUID, VMVersion string
+	AppGeneration, VMGeneration          int64
+	HostPID                              uint32
+	HostCreation                         uint64
+	HostSession                          uint32
+	TransportEpoch                       string
+}
+
+func freshRuntimeCurrentCondition(conditions []metav1.Condition, kind string, generation int64) bool {
+	found := false
+	for _, c := range conditions {
+		if c.Type == kind {
+			if found || c.Status != metav1.ConditionTrue || c.ObservedGeneration != generation {
+				return false
+			}
+			found = true
+		}
+	}
+	return found
+}
+
+func freshRuntimeVMRunning(conditions []metav1.Condition, generation int64) bool {
+	found := false
+	for _, c := range conditions {
+		if c.Type == "Running" {
+			// Pinned LimaReconciler.setCondition does not stamp observedGeneration.
+			// App mirrors it at its current generation; Settled checks actual
+			// template progress. Never relabel the unstamped zero as a VM witness.
+			if found || c.Status != metav1.ConditionTrue || c.Reason != "Started" || c.ObservedGeneration != 0 && c.ObservedGeneration != generation {
+				return false
+			}
+			found = true
+		}
+	}
+	return found
+}
+
+// Actual API responses must still be obtained through the concrete owned TLS
+// client. A successful pure validation cannot register an observation owner.
+func freshRuntimeAPI(a *app.App, v *lima.LimaVM) (freshRuntimeAPIData, error) {
+	var d freshRuntimeAPIData
+	if a == nil || v == nil || a.APIVersion != "app.rancherdesktop.io/v1alpha1" || a.Kind != "App" || v.APIVersion != "lima.rancherdesktop.io/v1alpha1" || v.Kind != "LimaVM" || a.Name != "app" || a.Namespace != "" || a.DeletionTimestamp != nil || v.DeletionTimestamp != nil ||
+		!upgradeASCII(string(a.UID), 128) || !upgradeASCII(a.ResourceVersion, 128) || a.Generation < 1 ||
+		!upgradeASCII(string(v.UID), 128) || !upgradeASCII(v.ResourceVersion, 128) || v.Generation < 1 ||
+		a.Spec.Namespace != freshRuntimeNamespace || !a.Spec.Running || a.Spec.ContainerEngine.Name != "moby" || string(a.Spec.Application.AddPath) != "manual" ||
+		v.Namespace != freshRuntimeNamespace || v.Name != "orbwin" || !v.Spec.Running || a.Status.SupportsNamespaces == nil || *a.Status.SupportsNamespaces {
+		return d, ErrUpgrade
+	}
+	for _, kind := range []string{app.AppConditionRunning, app.AppConditionContainerEngineReady, app.AppConditionSettled} {
+		if !freshRuntimeCurrentCondition(a.Status.Conditions, kind, a.Generation) {
+			return d, ErrUpgrade
+		}
+	}
+	if a.Spec.Kubernetes.Enabled && !freshRuntimeCurrentCondition(a.Status.Conditions, app.AppConditionKubernetesReady, a.Generation) || !freshRuntimeVMRunning(v.Status.Conditions, v.Generation) {
+		return d, ErrUpgrade
+	}
+	owned := false
+	for _, r := range v.OwnerReferences {
+		if r.Controller != nil && *r.Controller {
+			if owned || r.APIVersion != "app.rancherdesktop.io/v1alpha1" || r.Kind != "App" || r.Name != "app" || r.UID != a.UID {
+				return d, ErrUpgrade
+			}
+			owned = true
+		}
+	}
+	l := v.Status.NetworkProxyLaunch
+	if !owned || l == nil || l.AppUID != string(a.UID) || l.LimaVMUID != string(v.UID) || l.HostPID < 1 || l.HostPID > 1<<32-1 || l.Session == 0 || len(l.HostCreationTime) != 16 || !upgradeHex(l.HostCreationTime, 16) || !upgradeHex(l.TransportEpoch, 32) {
+		return d, ErrUpgrade
+	}
+	creation, e := strconv.ParseUint(l.HostCreationTime, 16, 64)
+	if e != nil || creation == 0 {
+		return d, ErrUpgrade
+	}
+	return freshRuntimeAPIData{string(a.UID), a.ResourceVersion, string(v.UID), v.ResourceVersion, a.Generation, v.Generation, uint32(l.HostPID), creation, l.Session, l.TransportEpoch}, nil
+}
+
+func freshRuntimeDaemon(id, osType string) bool {
+	return osType == "linux" && upgradeASCII(id, 256)
+}
+
+func (d freshRuntimeAPIData) sameIdentity(other freshRuntimeAPIData) bool {
+	// Status-only writes may legitimately change resourceVersion. Desired
+	// generations, UIDs and actual launch incarnation must remain identical.
+	d.AppVersion, d.VMVersion = "", ""
+	other.AppVersion, other.VMVersion = "", ""
+	return d == other
+}
+
+func freshRuntimeGUID(text string) bool {
+	return len(text) == 38 && text[0] == '{' && text[37] == '}' && text[9] == '-' && text[14] == '-' && text[19] == '-' && text[24] == '-' && upgradeHex(strings.ReplaceAll(text[1:37], "-", ""), 32)
+}
+
+func freshRuntimeObservationDigest(api freshRuntimeAPIData, daemon, guid string, directory UpgradeObject) ([32]byte, error) {
+	if !freshRuntimeDaemon(daemon, "linux") || !freshRuntimeGUID(guid) || !directory.valid() || api.HostPID == 0 || api.HostCreation == 0 {
+		return [32]byte{}, ErrUpgrade
+	}
+	body, e := json.Marshal(struct {
+		API       freshRuntimeAPIData
+		Daemon    string
+		GUID      string
+		Directory UpgradeObject
+	}{api, daemon, guid, directory})
+	if e != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(body), nil
+}
