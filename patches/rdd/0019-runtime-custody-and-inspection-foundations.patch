@@ -0,0 +1,83 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"strconv"
+
+	"golang.org/x/sys/windows"
+)
+
+// PID text and archive names are diagnostics DATA only. Recovery preserves the
+// previous native file without interpreting its numeric PID as a live process.
+func runtimeFreshPIDData(b []byte) bool {
+	if len(b) == 0 { // A prior process can die immediately after CREATE.
+		return true
+	}
+	if len(b) > 10 || b[0] == '0' {
+		return false
+	}
+	n, e := strconv.ParseUint(string(b), 10, 32)
+	return e == nil && n != 0 && strconv.FormatUint(n, 10) == string(b)
+}
+
+func runtimeFreshPIDArchiveName(g UpgradeProcess, id runtimeStorageIdentity) string {
+	return fmt.Sprintf("rdd.pid.previous-%08x-%016x-%08x-%08x-%08x", g.PID, g.Creation, id.volume, id.high, id.low)
+}
+
+// Caller holds original owner, SAME Created and native storage locks on an OS
+// thread. The actual exclusive Created owner lock remains held throughout.
+// No delete/replace occurs: old bytes are renamed to a collision-refusing
+// diagnostic archive, checked, then the fixed canonical role is CREATE-only.
+// A crash between rename and CREATE leaves an exact missing canonical role;
+// the next original recovery owner can create it while preserving the archive.
+func (o *FreshSetupOwner) writeServingPIDLocked(ctx context.Context, c *Created) error {
+	n := o.storage
+	if n.checkPrevious() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if n.freshRecovery != nil {
+		old, e := o.openFixed(c.anchor, "rdd.pid", false, windows.FILE_OPEN, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.DELETE, nil)
+		if e != nil && e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return ErrUpgrade
+		}
+		if e == nil {
+			id, e := runtimeStorageIdentityOf(old.handle, n.sid, false, true, false)
+			if e != nil || id.size > 10 {
+				return ErrUpgrade
+			}
+			object := &runtimeStorageObject{resource: old, identity: id, private: true}
+			before, e := n.read(object, true)
+			if e != nil || !runtimeFreshPIDData(before) || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			archive := runtimeFreshPIDArchiveName(o.origin.generation, id)
+			if renameUpgradeChild(old.handle, c.anchor, archive) != nil || windows.FlushFileBuffers(old.handle) != nil || n.checkObject(object) != nil || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			if n.closeTemporary(old) != nil {
+				return ErrUpgrade
+			}
+			reader, e := o.openFixed(c.anchor, archive, false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+			if e != nil {
+				return ErrUpgrade
+			}
+			actual, e := runtimeStorageIdentityOf(reader.handle, n.sid, false, true, false)
+			if e != nil || actual != id {
+				return ErrUpgrade
+			}
+			body, e := n.read(&runtimeStorageObject{resource: reader, identity: actual, private: true}, true)
+			if e != nil || !bytes.Equal(body, before) || n.closeTemporary(reader) != nil || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	pid := o.origin.generation.PID
+	if pid == 0 || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return o.writeCreatedFile(ctx, c.anchor, "rdd.pid", []byte(strconv.FormatUint(uint64(pid), 10)))
+}
