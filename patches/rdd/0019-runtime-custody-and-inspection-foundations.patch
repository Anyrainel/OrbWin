+//go:build windows
+
+package service
+
+import (
+	"github.com/sirupsen/logrus"
+	"k8s.io/kube-openapi/pkg/validation/validate"
+	"os"
+	"testing"
+)
+
+func TestFreshProtocolLoggingDisablesCachedStdoutTrace(t *testing.T) {
+	prior := validate.Debug
+	level, out := logrus.GetLevel(), logrus.StandardLogger().Out
+	defer func() { validate.Debug = prior; logrus.SetLevel(level); logrus.SetOutput(out) }()
+	validate.Debug = true
+	if enforceFreshProtocolLogging() != nil {
+		t.Fatal("fixed role logging configuration failed")
+	}
+	if validate.Debug || logrus.GetLevel() != logrus.WarnLevel || logrus.StandardLogger().Out != os.Stderr {
+		t.Fatal("fixed role retained selected cached-stdout schema trace")
+	}
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_protocol.go b/rdd/pkg/service/cmd/fresh_setup_protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..e1e162ff18cc824cf4f1f6123c08adcc1a7f9963
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_protocol.go
@@ -0,0 +1,376 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+	"sync"
+	"time"
+)
+
+const freshSetupFrameMax = 128
+
+var errFreshSetupProtocol = errors.New("private setup protocol refused")
+
+type freshSetupCommand struct{ operation, nonce string }
+
+// Closed protocol DATA only. No path/PID/hash, native receipt or owner may be
+// supplied. Positive native admission always comes from the fixed service.
+func readFreshSetupFrame(input io.Reader, want string) error {
+	command, e := readFreshSetupCommand(input)
+	if e != nil || command.operation != want || command.nonce != "" {
+		return errFreshSetupProtocol
+	}
+	return nil
+}
+
+func freshSetupNonce(nonce string) bool {
+	if len(nonce) != 32 {
+		return false
+	}
+	for _, c := range nonce {
+		if c < '0' || c > '9' {
+			if c < 'a' || c > 'f' {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func readFreshSetupCommand(input io.Reader) (freshSetupCommand, error) {
+	if input == nil {
+		return freshSetupCommand{}, errFreshSetupProtocol
+	}
+	var header [4]byte
+	if _, e := io.ReadFull(input, header[:]); e != nil {
+		return freshSetupCommand{}, errFreshSetupProtocol
+	}
+	n := binary.LittleEndian.Uint32(header[:])
+	if n == 0 || n > freshSetupFrameMax {
+		return freshSetupCommand{}, errFreshSetupProtocol
+	}
+	body := make([]byte, n)
+	if _, e := io.ReadFull(input, body); e != nil {
+		return freshSetupCommand{}, errFreshSetupProtocol
+	}
+	for _, operation := range []string{"setup", "cancel"} {
+		if bytes.Equal(body, []byte(`{"schema":2,"operation":"`+operation+`"}`)) {
+			return freshSetupCommand{operation: operation}, nil
+		}
+	}
+	prefix, suffix := []byte(`{"schema":2,"operation":"continue-original-setup","nonce":"`), []byte(`"}`)
+	if len(body) == len(prefix)+32+len(suffix) && bytes.HasPrefix(body, prefix) && bytes.HasSuffix(body, suffix) {
+		nonce := string(body[len(prefix) : len(prefix)+32])
+		if freshSetupNonce(nonce) {
+			return freshSetupCommand{operation: "continue-original-setup", nonce: nonce}, nil
+		}
+	}
+	return freshSetupCommand{}, errFreshSetupProtocol
+}
+
+type freshSetupEvent struct {
+	Schema             int    `json:"schema"`
+	State              string `json:"state"`
+	SetupSuccess       bool   `json:"setupSuccess"`
+	RuntimePublication bool   `json:"runtimePublication"`
+	Reason             string `json:"reason,omitempty"`
+	Nonce              string `json:"nonce,omitempty"`
+	Stage              string `json:"stage,omitempty"`
+}
+
+// This observation worker owns DATA/cancellation only, never a native owner or
+// serving lifetime context. Blocked/broken output cannot block service cleanup.
+type freshSetupObserver struct {
+	mu              sync.Mutex
+	startup         context.Context
+	cancelStartup   context.CancelFunc
+	admitted        bool
+	finished        bool
+	disconnected    bool
+	disconnectedCh  chan struct{}
+	beginClaimed    bool
+	pendingNonce    string
+	pendingResult   chan bool
+	continueClaimed bool
+	publishedFlag   bool
+	pausedFlag      bool
+	incompleteFlag  bool
+	events          chan freshSetupEvent
+	workerDone      chan struct{} // only the actual DATA output goroutine closes this
+	workerErr       error
+}
+
+func newFreshSetupObserver(ctx context.Context, cancel context.CancelFunc, output io.Writer) *freshSetupObserver {
+	o := &freshSetupObserver{startup: ctx, cancelStartup: cancel, events: make(chan freshSetupEvent, 8), disconnectedCh: make(chan struct{}), workerDone: make(chan struct{})}
+	go func() {
+		// Output owns DATA only. A broken/panicking observer cannot kill the
+		// admitted service or release its native graph.
+		failed := true
+		defer func() {
+			if recover() != nil {
+				failed = true
+			}
+			o.mu.Lock()
+			if failed {
+				o.workerErr = errFreshSetupProtocol
+			}
+			o.disconnectLocked()
+			close(o.workerDone)
+			o.mu.Unlock()
+		}()
+		for event := range o.events {
+			body, e := json.Marshal(event)
+			if e != nil || len(body) > 256 {
+				return
+			}
+			body = append(body, '\n')
+			n, e := output.Write(body)
+			if e != nil || n != len(body) {
+				return
+			}
+		}
+		failed = false
+	}()
+	return o
+}
+func (o *freshSetupObserver) disconnect() {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.disconnectLocked()
+}
+
+// Used only AFTER native sealed-gate recheck and actual positive closes.
+// Disconnection is cancellation DATA; it cannot issue a paused receipt.
+func (o *freshSetupObserver) pauseRequested() bool {
+	if o == nil {
+		return false
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.disconnected && !o.publishedFlag
+}
+func (o *freshSetupObserver) disconnectLocked() {
+	if !o.disconnected {
+		o.disconnected = true
+		if o.disconnectedCh != nil {
+			close(o.disconnectedCh)
+		}
+	}
+	if o.pendingNonce != "" && !o.continueClaimed {
+		o.pendingNonce = ""
+		select {
+		case o.pendingResult <- false:
+		default:
+		}
+	}
+	if !o.admitted && o.cancelStartup != nil {
+		o.cancelStartup()
+	}
+}
+
+// Used only while actual gate has never opened and SAME manager has not been
+// started. EOF can cancel CRD preparation even before a native decision exists.
+func (o *freshSetupObserver) preparationContext(parent context.Context) (context.Context, context.CancelFunc) {
+	if parent == nil {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		return ctx, cancel
+	}
+	ctx, cancel := context.WithCancel(parent)
+	if o == nil {
+		return ctx, cancel
+	}
+	o.mu.Lock()
+	if o.startup == nil {
+		o.mu.Unlock()
+		cancel()
+		return ctx, cancel
+	}
+	deadline, bounded := o.startup.Deadline()
+	ch := o.disconnectedCh
+	stop := o.disconnected && !o.continueClaimed && !o.beginClaimed
+	o.mu.Unlock()
+	if !bounded || ch == nil || stop {
+		cancel()
+		return ctx, cancel
+	}
+	boundedCtx, end := context.WithDeadline(ctx, deadline)
+	go func() {
+		select {
+		case <-boundedCtx.Done():
+		case <-ch:
+			o.mu.Lock()
+			stop := !o.continueClaimed && !o.beginClaimed
+			o.mu.Unlock()
+			if stop {
+				cancel()
+			}
+		}
+	}()
+	return boundedCtx, func() { end(); cancel() }
+}
+
+// This controls only the DATA cancellation race. Actual native gate.Begin,
+// not this claim, determines whether later service errors must persist.
+func (o *freshSetupObserver) claimBegin() bool {
+	if o == nil {
+		return true
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || !o.admitted || o.beginClaimed || o.publishedFlag || o.pausedFlag || o.incompleteFlag || o.pendingNonce != "" || o.disconnected && !o.continueClaimed {
+		return false
+	}
+	o.beginClaimed = true
+	return true
+}
+func (o *freshSetupObserver) enqueueLocked(event freshSetupEvent) bool {
+	select {
+	case o.events <- event:
+		return true
+	default:
+		o.disconnectLocked()
+		return false
+	}
+}
+
+// Pending decision owns cancellation DATA only. The exact continuation claim
+// atomically leaves this mode BEFORE the native caller attempts any App POST.
+func (o *freshSetupObserver) awaitDecision(ctx context.Context, reason, nonce string) bool {
+	if o == nil || ctx == nil || ctx.Err() != nil || reason != "prior-app-absent" || !freshSetupNonce(nonce) {
+		return false
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return false
+	}
+	o.mu.Lock()
+	if o.finished || !o.admitted || o.disconnected || o.pendingResult != nil || o.continueClaimed || o.publishedFlag || o.pausedFlag || o.incompleteFlag {
+		o.mu.Unlock()
+		return false
+	}
+	o.pendingNonce = nonce
+	o.pendingResult = make(chan bool, 1)
+	result := o.pendingResult
+	o.enqueueLocked(freshSetupEvent{Schema: 2, State: "decision-required", Reason: reason, Nonce: nonce})
+	o.mu.Unlock()
+	select {
+	case <-result:
+	case <-ctx.Done():
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.continueClaimed {
+		return true
+	}
+	o.pendingNonce = ""
+	return false
+}
+func (o *freshSetupObserver) claimContinuation(nonce string) bool {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || o.disconnected || o.pendingNonce == "" || o.pendingNonce != nonce || o.continueClaimed {
+		return false
+	}
+	o.continueClaimed = true
+	o.pendingNonce = ""
+	select {
+	case o.pendingResult <- true:
+	default:
+	}
+	return true
+}
+func (o *freshSetupObserver) admit() bool {
+	if o == nil {
+		return true
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || o.admitted || o.disconnected || o.startup == nil || o.startup.Err() != nil {
+		return false
+	}
+	o.admitted = true
+	o.enqueueLocked(freshSetupEvent{Schema: 2, State: "startup-admitted"})
+	return true
+}
+
+// Called only after the actual fresh publisher's checked durable receipt+seal
+// is wired at the native service callee. No inbound frame invokes this method.
+func (o *freshSetupObserver) published() {
+	if o == nil {
+		return
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || !o.admitted || o.pendingNonce != "" || o.publishedFlag || o.pausedFlag || o.incompleteFlag {
+		return
+	}
+	o.publishedFlag = true
+	o.enqueueLocked(freshSetupEvent{Schema: 2, State: "runtime-published", SetupSuccess: true, RuntimePublication: true})
+}
+
+// Only the original service's actual positive settlement emits this DATA.
+func (o *freshSetupObserver) paused() {
+	if o == nil {
+		return
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || !o.admitted || o.publishedFlag || o.pausedFlag || o.incompleteFlag {
+		return
+	}
+	o.pausedFlag = true
+	o.enqueueLocked(freshSetupEvent{Schema: 2, State: "setup-paused"})
+}
+
+// The actual post-Begin retention path emits diagnostic DATA only. This cannot
+// cancel actors or certify native settlement/publication. Queue failure detaches
+// the observer and still leaves the original service alive.
+func (o *freshSetupObserver) incomplete(stage string) {
+	if o == nil || stage != "service-readiness" && stage != "runtime-observation" && stage != "runtime-publication" {
+		return
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.finished || !o.admitted || !o.beginClaimed || o.pendingNonce != "" || o.publishedFlag || o.pausedFlag || o.incompleteFlag {
+		return
+	}
+	o.incompleteFlag = true
+	o.enqueueLocked(freshSetupEvent{Schema: 2, State: "setup-incomplete", Stage: stage})
+}
+func (o *freshSetupObserver) finish() error { return o.finishBounded(2 * time.Second) }
+
+// Native settlement happens before this DATA-only drain. A blocked output
+// cannot retain/cancel core actors; timeout is an incomplete transport result.
+func (o *freshSetupObserver) finishBounded(budget time.Duration) error {
+	if o == nil {
+		return nil
+	}
+	o.mu.Lock()
+	if !o.finished {
+		o.finished = true
+		o.disconnectLocked()
+		close(o.events)
+	}
+	done := o.workerDone
+	o.mu.Unlock()
+	if done == nil {
+		return nil
+	} // no actual output worker existed (pure helpers)
+	if budget <= 0 || budget > 2*time.Second {
+		return errFreshSetupProtocol
+	}
+	timer := time.NewTimer(budget)
+	defer timer.Stop()
+	select {
+	case <-done:
+	case <-timer.C:
+		return errFreshSetupProtocol
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.workerErr
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_protocol_test.go b/rdd/pkg/service/cmd/fresh_setup_protocol_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..22e7dc5645febcf332f72bfdb7feafe94f4d6999
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_protocol_test.go
@@ -0,0 +1,366 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type freshBlockingWriter struct {
+	entered, release chan struct{}
+	once             sync.Once
+}
+
+func TestFreshSetupIncompleteExactStagesAreTerminalData(t *testing.T) {
+	for _, stage := range []string{"service-readiness", "runtime-observation", "runtime-publication"} {
+		t.Run(stage, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			var output bytes.Buffer
+			o := newFreshSetupObserver(ctx, cancel, &output)
+			if !o.admit() || !o.claimBegin() {
+				t.Fatal("original DATA order refused")
+			}
+			o.incomplete(stage)
+			o.incomplete(stage)
+			o.published()
+			o.paused()
+			if o.finishBounded(time.Second) != nil || ctx.Err() != nil {
+				t.Fatal("incomplete DATA cancelled lifetime or failed output")
+			}
+			lines := bytes.Split(bytes.TrimSpace(output.Bytes()), []byte{'\n'})
+			want := `{"schema":2,"state":"setup-incomplete","setupSuccess":false,"runtimePublication":false,"stage":"` + stage + `"}`
+			if len(lines) != 2 || string(lines[1]) != want || bytes.Contains(lines[0], []byte(`"stage"`)) {
+				t.Fatal("incomplete shape/order/terminal protection changed")
+			}
+		})
+	}
+}
+
+func TestFreshSetupIncompleteRefusesWrongPhaseAndUnknownStage(t *testing.T) {
+	for _, phase := range []string{"before-admission", "before-begin", "pending", "published", "paused", "invalid-stage"} {
+		t.Run(phase, func(t *testing.T) {
+			o, _, cancel := freshPendingObserver(t, 8)
+			defer cancel()
+			defer o.finish()
+			<-o.events
+			switch phase {
+			case "before-admission":
+				o.admitted = false
+			case "pending":
+				o.pendingNonce = strings.Repeat("a", 32)
+			case "published":
+				o.published()
+				<-o.events
+			case "paused":
+				o.paused()
+				<-o.events
+			case "invalid-stage":
+				if !o.claimBegin() {
+					t.Fatal("begin refused")
+				}
+				o.incomplete("arbitrary secret")
+			}
+			if phase != "invalid-stage" {
+				o.incomplete("service-readiness")
+			}
+			if o.incompleteFlag || len(o.events) != 0 {
+				t.Fatal("invalid phase/stage emitted incomplete DATA")
+			}
+		})
+	}
+}
+
+func TestFreshSetupIncompletePressureAndOutputFailureRetainAdmittedLifetime(t *testing.T) {
+	o, ctx, cancel := freshPendingObserver(t, 1)
+	defer cancel()
+	defer o.finish()
+	if !o.claimBegin() {
+		t.Fatal("begin refused")
+	}
+	o.incomplete("runtime-publication") // admission still occupies sole queue slot
+	if !o.incompleteFlag || !o.disconnected || ctx.Err() != nil {
+		t.Fatal("queue pressure blocked or cancelled admitted lifetime")
+	}
+	<-o.events
+	o.published()
+	if len(o.events) != 0 {
+		t.Fatal("undelivered incomplete allowed later success")
+	}
+
+	ctx2, cancel2 := context.WithTimeout(context.Background(), time.Second)
+	defer cancel2()
+	w := &freshBlockingWriter{entered: make(chan struct{}), release: make(chan struct{})}
+	p := newFreshSetupObserver(ctx2, cancel2, w)
+	if !p.admit() || !p.claimBegin() {
+		t.Fatal("original begin refused")
+	}
+	<-w.entered
+	p.incomplete("runtime-observation")
+	if p.finishBounded(time.Millisecond) == nil || ctx2.Err() != nil {
+		t.Fatal("blocked incomplete output claimed delivery or cancelled core")
+	}
+	close(w.release)
+	<-p.workerDone
+}
+
+func (w *freshBlockingWriter) Write(p []byte) (int, error) {
+	w.once.Do(func() { close(w.entered) })
+	<-w.release
+	return len(p), nil
+}
+
+func TestFreshSetupTerminalDataDrainsBeforeCallerReturns(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var output bytes.Buffer
+	o := newFreshSetupObserver(ctx, cancel, &output)
+	if !o.admit() {
+		t.Fatal("startup DATA refused")
+	}
+	o.paused() // DATA-codec test only; no native pause capability is issued.
+	if o.finishBounded(time.Second) != nil {
+		t.Fatal("actual DATA worker failed to drain terminal frame")
+	}
+	lines := bytes.Split(bytes.TrimSpace(output.Bytes()), []byte{'\n'})
+	if len(lines) != 2 || !bytes.Contains(lines[1], []byte(`"state":"setup-paused"`)) {
+		t.Fatal("caller returned before terminal DATA was written")
+	}
+}
+
+func TestFreshSetupBlockedTerminalDrainIsBoundedAndDoesNotCancelAdmittedLifetime(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	w := &freshBlockingWriter{entered: make(chan struct{}), release: make(chan struct{})}
+	o := newFreshSetupObserver(ctx, cancel, w)
+	if !o.admit() {
+		t.Fatal("startup DATA refused")
+	}
+	<-w.entered
+	o.paused()
+	if o.finishBounded(time.Millisecond) == nil || ctx.Err() != nil {
+		t.Fatal("blocked terminal output claimed delivery or cancelled admitted lifetime")
+	}
+	close(w.release)
+	select {
+	case <-o.workerDone:
+	case <-time.After(time.Second):
+		t.Fatal("DATA worker did not drain after output resumed")
+	}
+}
+
+func freshProtocolFrame(body string) []byte {
+	b := make([]byte, 4+len(body))
+	binary.LittleEndian.PutUint32(b, uint32(len(body)))
+	copy(b[4:], body)
+	return b
+}
+
+type freshPanicWriter struct{ started chan struct{} }
+
+func (w freshPanicWriter) Write([]byte) (int, error) { close(w.started); panic("observer DATA panic") }
+func TestFreshSetupOutputPanicCannotCancelAdmittedLifetime(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{})
+	o := newFreshSetupObserver(ctx, cancel, freshPanicWriter{started})
+	defer o.finish()
+	if !o.admit() {
+		t.Fatal("admission failed")
+	}
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("DATA worker did not run")
+	}
+	o.disconnect()
+	if ctx.Err() != nil {
+		t.Fatal("output failure canceled admitted lifetime")
+	}
+}
+func TestFreshSetupProtocolClosedNoTargetAuthority(t *testing.T) {
+	if readFreshSetupFrame(bytes.NewReader(freshProtocolFrame(`{"schema":2,"operation":"setup"}`)), "setup") != nil {
+		t.Fatal("closed request refused")
+	}
+	for _, body := range []string{"", `{"schema":2,"operation":"preflight"}`, `{"schema":2,"operation":"setup","home":"C:\\foreign"}`, `{"schema":2,"operation":"setup","ready":true}`, `{"schema":2,"operation":"setup","schema":2}`, ` {"schema":2,"operation":"setup"}`} {
+		if readFreshSetupFrame(bytes.NewReader(freshProtocolFrame(body)), "setup") == nil {
+			t.Fatal("admitted extra/foreign request DATA")
+		}
+	}
+	for _, frame := range [][]byte{nil, {1, 0, 0}, {129, 0, 0, 0}, {8, 0, 0, 0, '{', '}'}} {
+		if readFreshSetupFrame(bytes.NewReader(frame), "setup") == nil {
+			t.Fatal("admitted partial/oversized frame")
+		}
+	}
+}
+
+func TestFreshSetupSchema2ContinuationClosedFrame(t *testing.T) {
+	nonce := strings.Repeat("a", 32)
+	body := `{"schema":2,"operation":"continue-original-setup","nonce":"` + nonce + `"}`
+	command, e := readFreshSetupCommand(bytes.NewReader(freshProtocolFrame(body)))
+	if e != nil || command.operation != "continue-original-setup" || command.nonce != nonce {
+		t.Fatal("closed continuation refused")
+	}
+	for _, bad := range []string{
+		`{"schema":1,"operation":"setup"}`,
+		strings.Replace(body, nonce, strings.Repeat("A", 32), 1),
+		strings.Replace(body, nonce, strings.Repeat("a", 31), 1),
+		strings.Replace(body, `"nonce":`, `"ready":true,"nonce":`, 1),
+		body + " ",
+	} {
+		if _, e := readFreshSetupCommand(bytes.NewReader(freshProtocolFrame(bad))); e == nil {
+			t.Fatal("foreign/extra decision frame admitted")
+		}
+	}
+	encoded, e := json.Marshal(freshSetupEvent{Schema: 2, State: "decision-required", Reason: "prior-app-absent", Nonce: nonce})
+	if e != nil || len(encoded) > 256 {
+		t.Fatal("bounded decision event exceeds wire limit")
+	}
+}
+
+func freshPendingObserver(t *testing.T, capacity int) (*freshSetupObserver, context.Context, context.CancelFunc) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	o := &freshSetupObserver{startup: ctx, cancelStartup: cancel, events: make(chan freshSetupEvent, capacity), disconnectedCh: make(chan struct{})}
+	if !o.admit() {
+		t.Fatal("startup observation failed")
+	}
+	return o, ctx, cancel
+}
+
+func TestFreshSetupEOFDuringPreparationCancelsOnlyControlPreparation(t *testing.T) {
+	o, startup, end := freshPendingObserver(t, 8)
+	defer end()
+	defer o.finish()
+	<-o.events
+	lifetime, stopLifetime := context.WithCancel(context.Background())
+	defer stopLifetime()
+	preparation, stopPreparation := o.preparationContext(lifetime)
+	defer stopPreparation()
+	o.disconnect()
+	select {
+	case <-preparation.Done():
+	case <-time.After(time.Second):
+		t.Fatal("early EOF left preparation running before a decision existed")
+	}
+	if startup.Err() != nil || lifetime.Err() != nil {
+		t.Fatal("preparation cancellation directly killed original admitted lifetime")
+	}
+}
+
+func TestFreshSetupClaimedContinuationKeepsPreparationAcrossEOF(t *testing.T) {
+	o, startup, end := freshPendingObserver(t, 8)
+	defer end()
+	defer o.finish()
+	<-o.events
+	preparation, stop := o.preparationContext(context.Background())
+	defer stop()
+	nonce := strings.Repeat("d", 32)
+	result := make(chan bool, 1)
+	go func() { result <- o.awaitDecision(preparation, "prior-app-absent", nonce) }()
+	<-o.events
+	if !o.claimContinuation(nonce) || !<-result {
+		t.Fatal("original continuation not claimed")
+	}
+	o.disconnect()
+	select {
+	case <-preparation.Done():
+		t.Fatal("claimed continuation was reverted to EOF cancellation")
+	case <-time.After(20 * time.Millisecond):
+	}
+	if startup.Err() != nil {
+		t.Fatal("claimed continuation canceled original startup")
+	}
+}
+
+func TestFreshSetupPendingEOFOnlyCancelsDecisionData(t *testing.T) {
+	o, startup, cancel := freshPendingObserver(t, 8)
+	defer cancel()
+	defer o.finish()
+	<-o.events
+	ctx, end := context.WithTimeout(context.Background(), time.Second)
+	defer end()
+	nonce := strings.Repeat("a", 32)
+	result := make(chan bool, 1)
+	go func() { result <- o.awaitDecision(ctx, "prior-app-absent", nonce) }()
+	event := <-o.events
+	if event.State != "decision-required" || event.SetupSuccess || event.RuntimePublication {
+		t.Fatal("decision DATA claimed native success")
+	}
+	o.disconnect()
+	if <-result || startup.Err() != nil || o.claimContinuation(nonce) {
+		t.Fatal("pending EOF claimed consent or canceled original admitted lifetime directly")
+	}
+}
+
+func TestFreshSetupContinuationClaimAtomicallyDetachesBeforePOST(t *testing.T) {
+	o, startup, cancel := freshPendingObserver(t, 8)
+	defer cancel()
+	defer o.finish()
+	<-o.events
+	ctx, end := context.WithTimeout(context.Background(), time.Second)
+	defer end()
+	nonce := strings.Repeat("b", 32)
+	result := make(chan bool, 1)
+	go func() { result <- o.awaitDecision(ctx, "prior-app-absent", nonce) }()
+	<-o.events
+	if !o.claimContinuation(nonce) {
+		t.Fatal("exact pending continuation refused")
+	}
+	o.disconnect()
+	if !<-result || startup.Err() != nil || o.claimContinuation(nonce) {
+		t.Fatal("EOF raced continuation back into cancellation or replay admitted")
+	}
+	o.paused()
+	// A consumed consent can still fail native revalidation before gate Begin.
+	// Only the original service's actual positive sealed-gate settlement calls
+	// paused; the DATA codec must accept that outcome after a claim.
+	if e := <-o.events; e.State != "setup-paused" || e.SetupSuccess || e.RuntimePublication {
+		t.Fatal("pre-Begin settled pause shape changed")
+	}
+}
+
+func TestFreshSetupDecisionQueuePressureRefusesWithoutBlockingCore(t *testing.T) {
+	o, startup, cancel := freshPendingObserver(t, 1)
+	defer cancel()
+	defer o.finish()
+	ctx, end := context.WithTimeout(context.Background(), time.Second)
+	defer end()
+	if o.awaitDecision(ctx, "prior-app-absent", strings.Repeat("c", 32)) || startup.Err() != nil || o.claimContinuation(strings.Repeat("c", 32)) {
+		t.Fatal("undeliverable decision admitted continuation or native cancellation")
+	}
+}
+func TestFreshSetupObserverCancellationBoundaryOwnsDataOnly(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	o := &freshSetupObserver{startup: ctx, cancelStartup: cancel, events: make(chan freshSetupEvent, 2)}
+	o.disconnect()
+	if ctx.Err() == nil || o.admit() {
+		t.Fatal("pre-admission EOF failed to cancel startup")
+	}
+	o.finish()
+	ctx2, cancel2 := context.WithCancel(context.Background())
+	defer cancel2()
+	p := &freshSetupObserver{startup: ctx2, cancelStartup: cancel2, events: make(chan freshSetupEvent, 2)}
+	if !p.admit() {
+		t.Fatal("actual transition refused")
+	}
+	p.disconnect()
+	if ctx2.Err() != nil || p.admit() {
+		t.Fatal("observer EOF canceled admitted lifetime or duplicate admission accepted")
+	}
+	event := <-p.events
+	if event.State != "startup-admitted" || event.SetupSuccess || event.RuntimePublication {
+		t.Fatal("startup DATA falsely claimed setup/runtime success")
+	}
+	p.finish()
+	p.published()
+	if p.admit() {
+		t.Fatal("finished observation reopened")
+	}
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_stdout_windows.go b/rdd/pkg/service/cmd/fresh_setup_stdout_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..af408226fa80cb96692c5a548796a575311b95c2
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_stdout_windows.go
@@ -0,0 +1,77 @@
+//go:build windows
+
+package service
+
+import (
+	"context"
+	"github.com/fatih/color"
+	"golang.org/x/sys/windows"
+	"io"
+	"os"
+	"unsafe"
+)
+
+var freshGetHandleInformation = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetHandleInformation")
+
+func freshStdoutNonInherited(reply uintptr, flags uint32) bool {
+	return reply != 0 && flags&windows.HANDLE_FLAG_INHERIT == 0
+}
+
+// Keep the original frame file exclusively in the protocol writer. All later
+// Go/upstream and native standard-output lookups use the inherited private
+// stderr sink instead; never restore stdout while the serving process lives.
+func redirectFreshProcessOutput(ctx context.Context, frame io.Writer) error {
+	if ctx == nil || ctx.Err() != nil {
+		return errPrivateAuthority
+	}
+	file, ok := frame.(*os.File)
+	if !ok || file == nil || file != os.Stdout || file == os.Stderr {
+		return errPrivateAuthority
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return errPrivateAuthority
+	}
+	stderr, e := windows.GetStdHandle(windows.STD_ERROR_HANDLE)
+	if e != nil || stderr == 0 || stderr == windows.InvalidHandle || stderr != windows.Handle(os.Stderr.Fd()) || stderr == windows.Handle(file.Fd()) {
+		return errPrivateAuthority
+	}
+	if windows.SetStdHandle(windows.STD_OUTPUT_HANDLE, stderr) != nil {
+		return errPrivateAuthority
+	}
+	os.Stdout = os.Stderr
+	// This dependency caches a stdout writer during package initialization.
+	color.Output = os.Stderr
+	actual, e := windows.GetStdHandle(windows.STD_OUTPUT_HANDLE)
+	if e != nil || actual != stderr || ctx.Err() != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
+
+// Own stdio metadata only: clear inheritance on actual process stdout before
+// upstream children can start. A caller writer/number cannot substitute for it.
+func prepareFreshProtocolStdout(ctx context.Context, output io.Writer) error {
+	if ctx == nil || ctx.Err() != nil {
+		return errPrivateAuthority
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return errPrivateAuthority
+	}
+	file, ok := output.(*os.File)
+	if !ok || file == nil || file != os.Stdout {
+		return errPrivateAuthority
+	}
+	h, e := windows.GetStdHandle(windows.STD_OUTPUT_HANDLE)
+	if e != nil || h == 0 || h == windows.InvalidHandle || h != windows.Handle(file.Fd()) {
+		return errPrivateAuthority
+	}
+	if windows.SetHandleInformation(h, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+		return errPrivateAuthority
+	}
+	flags := ^uint32(0)
+	reply, _, _ := freshGetHandleInformation.Call(uintptr(h), uintptr(unsafe.Pointer(&flags)))
+	if !freshStdoutNonInherited(reply, flags) || ctx.Err() != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
