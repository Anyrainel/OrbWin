+func TestRuntimeUpgradeOldListenerMissingOwnersNoNativeCalls(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, c := range []*nativeRuntimeUpgradeCredentials{nil, {}, {self: &nativeRuntimeUpgradeCredentials{}}} {
+		if runtimeUpgradeCredentialsKnown(c) {
+			t.Fatal("missing/copied credential birth admitted")
+		}
+		if o, e := captureRuntimeUpgradeOldListener(ctx, c); e == nil || o != nil {
+			t.Fatal("missing/copied args reached native capture")
+		}
+	}
+	for _, o := range []*nativeUpgradeOldListenerObservation{nil, {}, {self: &nativeUpgradeOldListenerObservation{}}} {
+		if _, e := o.observed(ctx); e == nil {
+			t.Fatal("DTO/copy issued observed process")
+		}
+		if o.Close() == nil {
+			t.Fatal("DTO/copy closed native resources")
+		}
+	}
+	forged := &nativeUpgradeOldListenerObservation{}
+	forged.self = forged
+	if runtimeUpgradeOldListenerKnown(forged) {
+		t.Fatal("unregistered self-backed wrapper admitted")
+	}
+	if _, e := forged.observed(ctx); e == nil {
+		t.Fatal("unregistered wrapper queried native process")
+	}
+}
