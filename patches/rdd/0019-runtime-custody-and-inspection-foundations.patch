+)
+
+// Historical live loopback-listener observation ONLY. No supported-build,
+// old-home, management authentication, full family, retirement or Stop grant.
+// No caller PID/path/hash/command/port is accepted. Native selection is derived
+// from actual held credentials, independently checked saved args, then real TCP
+// and process/file objects. The credential pointer and actual port are frozen
+// under credentials -> new listener -> args -> storage -> inventory at birth.
+// Lifetime methods never lock credentials or read its mutable secret bytes.
+type nativeUpgradeOldListenerObservation struct {
+	mu                    sync.Mutex
+	self                  *nativeUpgradeOldListenerObservation
+	credentials           *nativeRuntimeUpgradeCredentials // immutable original constructor owner
+	args                  *nativeRuntimeUpgradeArgs
+	storage               *nativeRuntimeStorage
+	process, token, image *runtimeStorageResource
+	tokenID               windows.LUID
+	resources             []*runtimeStorageResource
+	port                  uint16
+	generation            UpgradeProcess
+	path, command         string
+	imageIdentity         runtimeStorageIdentity
+	binding               upgradeObservedImageBinding
+	closed, unknown       bool
+}
+
+var runtimeUpgradeOldListeners = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeOldListenerObservation]bool
+}{owners: map[*nativeUpgradeOldListenerObservation]bool{}}
+
+func runtimeUpgradeOldListenerKnown(o *nativeUpgradeOldListenerObservation) bool {
+	if o == nil || o.self != o || o.credentials == nil || o.credentials.self != o.credentials || o.credentials.args != o.args || o.credentials.storage != o.storage {
+		return false
+	}
+	runtimeUpgradeOldListeners.Lock()
+	defer runtimeUpgradeOldListeners.Unlock()
+	return runtimeUpgradeOldListeners.owners[o]
+}
+
+func runtimeUpgradeOldArgsBirthKnown(a *nativeRuntimeUpgradeArgs) bool {
+	if !runtimeUpgradeArgsBorrowedBirth(a) {
+		return false
+	}
+	runtimeUpgradeArgsCustody.Lock()
+	known := runtimeUpgradeArgsCustody.owners[a]
+	runtimeUpgradeArgsCustody.Unlock()
+	return known
+}
+
+// All four mutexes held. The shared classifier is DATA only; this actual
+// outer owner fences itself and its actual storage immediately on unknown.
+func (o *nativeUpgradeOldListenerObservation) admitBorrowedLocked() runtimeArgsBorrowedState {
+	if o == nil || o.self != o || o.storage == nil || o.storage.captureSelf != o.storage {
+		return runtimeBorrowedUnknown
+	}
+	if !runtimeUpgradeOldListenerKnown(o) || !runtimeUpgradeArgsBorrowedBirth(o.args) || o.storage != o.args.storage {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	state := o.args.borrowedStateLocked(o.resources)
+	if o.unknown || state == runtimeBorrowedUnknown {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	return state
+}
+func (o *nativeUpgradeOldListenerObservation) fenceLocked() { o.unknown = true; o.storage.fence() }
+func (o *nativeUpgradeOldListenerObservation) slot() *runtimeStorageResource {
+	r := o.storage.keep(0)
+	o.resources = append(o.resources, r)
+	return r
+}
+func (o *nativeUpgradeOldListenerObservation) output(r *runtimeStorageResource, e error) error {
+	valid := r.handle != 0 && r.handle != windows.InvalidHandle
+	if runtimeStorageOpenReply(e, valid, func() {}, o.fenceLocked) == nil {
+		return nil
+	}
+	if !o.unknown {
+		n := o.storage
+		if len(n.resources) == 0 || n.resources[len(n.resources)-1] != r || len(o.resources) == 0 || o.resources[len(o.resources)-1] != r {
+			o.fenceLocked()
+		} else {
+			n.resources = n.resources[:len(n.resources)-1]
+			o.resources = o.resources[:len(o.resources)-1]
+		}
+	}
+	return ErrUpgrade
+}
+func (o *nativeUpgradeOldListenerObservation) open(parent windows.Handle, name string, directory bool) (*runtimeStorageResource, error) {
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	share := uint32(windows.FILE_SHARE_READ)
+	if directory {
+		access |= windows.FILE_TRAVERSE
+		options |= windows.FILE_DIRECTORY_FILE
+		share |= windows.FILE_SHARE_WRITE
+	} else {
+		access |= windows.FILE_READ_DATA | windows.FILE_EXECUTE
+		options |= windows.FILE_NON_DIRECTORY_FILE
+	}
+	r := o.slot()
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access, &oa, &status, nil, 0, share, windows.FILE_OPEN, options, 0, 0)
+	if o.output(r, e) != nil {
+		return nil, ErrUpgrade
+	}
+	if objectKind(r.handle, directory) != nil {
+		return nil, ErrUpgrade
+	}
+	return r, nil
+}
+func (o *nativeUpgradeOldListenerObservation) currentListener(ctx context.Context) (uint32, error) {
+	v4, e := observeUpgradeTCPTable(ctx, 4)
+	if e != nil {
+		return 0, e
+	}
+	v6, e := observeUpgradeTCPTable(ctx, 6)
+	if e != nil {
+		return 0, e
+	}
+	return runtimeUpgradeOldListenerPID(v4, v6, o.port)
+}
+
+// Queries the actual current process primary token into an independently owned
+// temporary slot; a retained older token alone cannot prove current attachment.
+func (o *nativeUpgradeOldListenerObservation) checkCurrentToken(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	r := o.slot()
+	e := windows.OpenProcessToken(o.process.handle, windows.TOKEN_QUERY, (*windows.Token)(&r.handle))
+	if o.output(r, e) != nil {
+		return ErrUpgrade
+	}
+	id, e := legacySDKTokenID(windows.Token(r.handle))
+	ordinary := legacySDKOrdinaryToken(windows.Token(r.handle), o.storage.sid, o.generation.Session)
+	if o.storage.closeOne(r) != nil {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	n := o.storage
+	if len(n.resources) == 0 || n.resources[len(n.resources)-1] != r || len(o.resources) == 0 || o.resources[len(o.resources)-1] != r {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	n.resources = n.resources[:len(n.resources)-1]
+	o.resources = o.resources[:len(o.resources)-1]
+	if e != nil || ordinary != nil || id != o.tokenID {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (o *nativeUpgradeOldListenerObservation) checkProcess(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if o.process == nil || o.token == nil || o.process.attempted || o.token.attempted || o.generation.PID == 0 || o.generation.Creation == 0 || o.generation.Session == 0 {
+		return ErrUpgrade
+	}
+	pid, e := windows.GetProcessId(o.process.handle)
+	var made, exit, kernel, user windows.Filetime
+	var session uint32
+	state, f := windows.WaitForSingleObject(o.process.handle, 0)
+	if e != nil || pid != o.generation.PID || f != nil || state != uint32(windows.WAIT_TIMEOUT) || windows.GetProcessTimes(o.process.handle, &made, &exit, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != o.generation.Creation || windows.ProcessIdToSessionId(pid, &session) != nil || session != o.generation.Session || legacySDKOrdinaryToken(windows.Token(o.token.handle), o.storage.sid, session) != nil {
+		return ErrUpgrade
+	}
+	id, e := legacySDKTokenID(windows.Token(o.token.handle))
+	if e != nil || id != o.tokenID || o.checkCurrentToken(ctx) != nil {
+		return ErrUpgrade
+	}
+	path, e := upgradeProcessPath(o.process.handle)
+	if e != nil || !strings.EqualFold(path, o.path) {
+		return ErrUpgrade
+	}
+	command, e := legacySDKCommandLine(o.process.handle)
+	if e != nil || command != o.command {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (o *nativeUpgradeOldListenerObservation) checkLocked(ctx context.Context) error {
+	if !runtimeUpgradeOldListenerKnown(o) || ctx == nil || ctx.Err() != nil || o.closed || o.unknown || o.args == nil || o.storage == nil || o.storage != o.args.storage || o.image == nil || o.image.attempted {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	if o.admitBorrowedLocked() != runtimeBorrowedLive {
+		return ErrUpgrade
+	}
+	if _, e := o.args.digestLocked(ctx); e != nil {
+		return e
+	}
+	pid, e := o.currentListener(ctx)
+	if e != nil || pid != o.generation.PID || o.checkProcess(ctx) != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageMeasureIdentity(o.image.handle, false)
+	if e != nil || id != o.imageIdentity || objectKind(o.image.handle, false) != nil || o.binding.same() != nil {
+		return ErrUpgrade
+	}
+	pid, e = o.currentListener(ctx)
+	var made, exit, kernel, user windows.Filetime
+	state, f := windows.WaitForSingleObject(o.process.handle, 0)
+	if e != nil || pid != o.generation.PID || f != nil || state != uint32(windows.WAIT_TIMEOUT) || windows.GetProcessTimes(o.process.handle, &made, &exit, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != o.generation.Creation || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
