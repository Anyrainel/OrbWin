--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_cli_model.go
@@ -0,0 +1,25 @@
+package managementconfig
+
+import "strings"
+
+const runtimeInspectionCLIFlag = "--orbwin-runtime-inspect"
+
+// Reserved syntax selects refusal rather than falling through to ordinary CLI
+// environment preparation. It carries no target, path, PID or native authority.
+func runtimeInspectionCLIArguments(args []string) (selected, valid bool) {
+	for _, arg := range args {
+		if strings.HasPrefix(arg, runtimeInspectionCLIFlag) {
+			selected = true
+		}
+	}
+	return selected, selected && len(args) == 1 && args[0] == runtimeInspectionCLIFlag
+}
+func runtimeInspectionCLIExit(domainEmptyKnown bool, failure error) (code int, terminal bool) {
+	if !domainEmptyKnown {
+		return 0, false
+	}
+	if failure != nil {
+		return 2, true
+	}
+	return 0, true
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_cli_model_test.go b/rdd/pkg/managementconfig/runtime_inspection_cli_model_test.go
new file mode 100644
