+)
+
+func TestRuntimeUpgradeArgsClosedSavedPolicy(t *testing.T) {
+	for _, body := range []string{`["--secure-port","6443"]`, `["--secure-port","1","--controllers=*,-path-management"]`, `["--secure-port","65535","--controllers","*,-path-management"]`} {
+		got, e := parseRuntimeUpgradeArgs([]byte(body))
+		if e != nil || got != sha256.Sum256([]byte(body)) {
+			t.Fatal("supported saved bytes rejected", body)
+		}
+	}
+	for _, body := range [][]byte{nil, []byte(`[]`), []byte(`null`), []byte(`{"args":[]}`), []byte(`["--secure-port","0"]`), []byte(`["--secure-port","06443"]`), []byte(`["--secure-port","65536"]`), []byte(`["--secure-port","6443","--controllers=*"]`), []byte(`["--secure-port","6443","--home=C:/foreign"]`), []byte(`["--secure-port","6443"] []`), []byte(`["--secure-port","6443","\ud800"]`), {0xff}, bytes.Repeat([]byte(" "), runtimeUpgradeArgsBudget+1)} {
+		if _, e := parseRuntimeUpgradeArgs(body); e == nil {
+			t.Fatal("unsupported or malformed arguments accepted", string(body))
+		}
+	}
+}
+
+func TestRuntimeUpgradeArgsBoundedActualReader(t *testing.T) {
+	body := []byte(`["--secure-port","6443"]`)
+	for _, chunk := range []int{1, 7, len(body)} {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		r := bytes.NewReader(body)
+		seeks := 0
+		got, e := readRuntimeUpgradeArgs(ctx, uint64(len(body)), func() error { seeks++; _, e := r.Seek(0, 0); return e }, func(b []byte) (uint32, error) {
+			if len(b) > chunk {
+				b = b[:chunk]
+			}
+			n, e := r.Read(b)
+			return uint32(n), e
+		})
+		cancel()
+		if e != nil || !bytes.Equal(got, body) || seeks != 1 {
+			t.Fatal("short chunk read failed", chunk, e)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, size := range []uint64{0, runtimeUpgradeArgsBudget + 1} {
+		calls := 0
+		if _, e := readRuntimeUpgradeArgs(ctx, size, func() error { calls++; return nil }, func([]byte) (uint32, error) { calls++; return 0, nil }); e == nil || calls != 0 {
+			t.Fatal("invalid size reached IO")
+		}
+	}
+	for _, kind := range []string{"short", "extra", "zero", "error", "oversized", "seek", "invalid", "cancel"} {
+		local, stop := context.WithTimeout(context.Background(), time.Second)
+		data := append([]byte{}, body...)
+		if kind == "extra" {
+			data = append(data, 'x')
+		}
+		if kind == "short" {
+			data = data[:len(data)-1]
+		}
+		if kind == "invalid" {
+			data[0] = '!'
+		}
+		r := bytes.NewReader(data)
+		reads := 0
+		got, e := readRuntimeUpgradeArgs(local, uint64(len(body)), func() error {
+			if kind == "seek" {
+				return ErrUpgrade
+			}
+			return nil
+		}, func(b []byte) (uint32, error) {
+			reads++
+			switch kind {
+			case "zero":
+				return 0, nil
+			case "error":
+				return 1, ErrUpgrade
+			case "oversized":
+				return uint32(len(b) + 1), nil
+			case "cancel":
+				stop()
+			}
+			n, e := r.Read(b)
+			return uint32(n), e
+		})
+		stop()
+		if e == nil || got != nil {
+			t.Fatal("lost/uncertain read accepted", kind)
+		}
+		if kind == "seek" && reads != 0 {
+			t.Fatal("read after failed seek")
+		}
+	}
+	background := context.Background()
+	calls := 0
+	if _, e := readRuntimeUpgradeArgs(background, uint64(len(body)), func() error { calls++; return nil }, func([]byte) (uint32, error) { calls++; return 0, io.EOF }); e == nil || calls != 0 {
+		t.Fatal("unbounded context reached IO")
+	}
+}
+
+func TestRuntimeUpgradeArgsPartialOutputAndCloseUncertainty(t *testing.T) {
+	for _, callErr := range []error{nil, ErrUpgrade} {
+		for _, hasOutput := range []bool{false, true} {
+			retained, fenced := false, false
+			e := runtimeStorageOpenReply(callErr, hasOutput, func() { retained = true }, func() { fenced = true })
+			if fenced != (callErr != nil && hasOutput || callErr == nil && !hasOutput) {
+				t.Fatal("wrong uncertainty boundary")
+			}
+			if callErr != nil && hasOutput && (!retained || e == nil) {
+				t.Fatal("partial output dropped")
+			}
+		}
+	}
+	for _, panics := range []bool{false, true} {
+		var a runtimeStorageCloseAttempt
+		effects, fences := 0, 0
+		func() {
+			defer func() { recover() }()
+			a.run(func() error {
+				effects++
+				if panics {
+					panic("lost close")
+				}
+				return ErrUpgrade
+			}, func() { fences++ })
+		}()
+		if a.run(func() error { effects++; return nil }, func() { fences++ }) == nil || effects != 1 || fences != 1 {
+			t.Fatal("uncertain actual-slot close retried")
+		}
+	}
+}
