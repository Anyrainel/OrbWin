+func (w *FreshRuntimeObservation) observeRegistrationLocked(ctx context.Context) error {
+	n := w.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !w.owner.nativeOutputsAdmittedLocked() || n.checkToken() != nil {
+		return ErrUpgrade
+	}
+	root, e := w.openRegistryLocked(windows.HKEY_CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`)
+	if e != nil {
+		return ErrUpgrade
+	}
+	found := ""
+	for i := uint32(0); i <= 512; i++ {
+		if !freshBoundedContext(ctx) || !w.owner.nativeOutputsAdmittedLocked() {
+			return ErrUpgrade
+		}
+		var name [64]uint16
+		count := uint32(len(name))
+		e := windows.RegEnumKeyEx(root.handle, i, &name[0], &count, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			break
+		}
+		if e != nil || i == 512 || count == 0 || count >= 64 {
+			return ErrUpgrade
+		}
+		guid := strings.ToLower(windows.UTF16ToString(name[:count]))
+		if !freshRuntimeGUID(guid) {
+			return ErrUpgrade
+		}
+		key, e := w.openRegistryLocked(root.handle, guid)
+		if e != nil {
+			return ErrUpgrade
+		}
+		distro, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+		if e != nil {
+			return ErrUpgrade
+		}
+		if runtimeFreshOwnedRegistrationName(distro) {
+			if found != "" {
+				return ErrUpgrade
+			}
+			base, e := freshRuntimeRegistryValue(key.handle, "BasePath")
+			if e != nil {
+				return ErrUpgrade
+			}
+			var raw [4]byte
+			size := uint32(4)
+			var kind uint32
+			value, _ := windows.UTF16PtrFromString("Version")
+			if windows.RegQueryValueEx(key.handle, value, nil, &kind, &raw[0], &size) != nil || kind != windows.REG_DWORD || size != 4 || binary.LittleEndian.Uint32(raw[:]) != 2 || !freshRuntimeRegistrationBase(base, n.home) {
+				return ErrUpgrade
+			}
+			again, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+			if e != nil || again != distro {
+				return ErrUpgrade
+			}
