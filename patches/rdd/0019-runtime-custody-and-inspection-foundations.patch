+package managementconfig
+
+import (
+	"crypto/sha256"
+	"testing"
+)
+
+func TestRuntimeFreshRecoveryBirthBindsExactOriginalRecipeAndCurrentRoot(t *testing.T) {
+	r := freshControlRetentionFixture()
+	witness := r.Intent
+	current := UpgradeObject{r.PrivateParent.Volume, 30, 1}
+	sd := [32]byte{9}
+	b := runtimeFreshControlBirth{Schema: 1, Transaction: r.Transaction, Retention: witness, Authority: current, Descriptor: sd}
+	if !b.matches(r, witness, current, sd) {
+		t.Fatal("actual current birth facts refused")
+	}
+	for _, change := range []func(*runtimeFreshControlBirth){func(b *runtimeFreshControlBirth) { b.Retention.Body[0]++ }, func(b *runtimeFreshControlBirth) { b.Authority.Low++ }, func(b *runtimeFreshControlBirth) { b.Descriptor[0]++ }, func(b *runtimeFreshControlBirth) { b.Ordinal = runtimeFreshControlSlots }, func(b *runtimeFreshControlBirth) { b.Authority = r.OldAuthority }} {
+		bad := b
+		change(&bad)
+		if bad.matches(r, witness, current, sd) {
+			t.Fatal("mismatched native birth/recipe accepted")
+		}
+	}
+}
+
+func freshControlRetentionFixture() runtimeFreshControlRetention {
+	a := freshPublicationFixture()
+	return runtimeFreshControlRetention{Schema: 1, Transaction: a.Transaction, Intent: a.Intent, Denial: a.LegacyDenial, PrivateParent: UpgradeObject{a.Authority.Volume, 9, 1}, PublicParent: a.Parent, Controller: a.Controller, OldAuthority: a.Authority, OldOwnerLock: a.AuthorityLock, PrivateDescriptor: [32]byte{1}, PublicDescriptor: a.ParentDescriptor, ControllerDescriptor: a.ControllerDescriptor, OldDescriptor: [32]byte{2}, OwnerDescriptor: a.AuthorityLockDescriptor, Args: []byte(`["--secure-port","6443","--controllers","*,-path-management"]`)}
+}
+
+func TestRuntimeFreshRecoveryControlRetainedCrashCutsPreserveIdentities(t *testing.T) {
+	old, newRoot, foreign := UpgradeObject{1, 1, 1}, UpgradeObject{1, 1, 2}, UpgradeObject{1, 1, 3}
+	zero := UpgradeObject{}
+	for _, row := range []struct {
+		name                       string
+		canonical, retained, birth UpgradeObject
+		empty                      bool
+		want                       runtimeFreshControlCut
+	}{
+		{"recipe before rename", old, zero, zero, false, runtimeFreshControlBeforeRename},
+		{"rename before create", zero, old, zero, false, runtimeFreshControlBeforeRootCreate},
+		{"create before birth", newRoot, old, zero, true, runtimeFreshControlBeforeBirth},
+		{"birth before children", newRoot, old, newRoot, true, runtimeFreshControlBoundRoot},
+		{"partial new authority", newRoot, old, newRoot, false, runtimeFreshControlBoundRoot},
+		{"children without birth", newRoot, old, zero, false, runtimeFreshControlInvalid},
+		{"old both names", old, old, zero, false, runtimeFreshControlInvalid},
+		{"foreign retained", newRoot, foreign, newRoot, false, runtimeFreshControlInvalid},
+		{"missing after bound birth", zero, old, newRoot, false, runtimeFreshControlInvalid},
+		{"different new identity", newRoot, old, foreign, false, runtimeFreshControlInvalid},
+	} {
+		t.Run(row.name, func(t *testing.T) {
+			if classifyRuntimeFreshControlCut(old, row.canonical, row.retained, row.birth, row.empty) != row.want {
+				t.Fatal("unsafe interrupted root combination accepted or safe cut lost")
+			}
+		})
+	}
+}
+
+func TestRuntimeFreshRecoveryControlRecordIsClosedBoundedPrefixData(t *testing.T) {
+	r := freshControlRetentionFixture()
+	if !r.valid() {
+		t.Fatal("native expected structural metadata refused")
+	}
+	r.Inventory = []runtimeFreshControlObject{{Role: "tls", Object: UpgradeObject{r.OldAuthority.Volume, 20, 1}, Descriptor: [32]byte{1}, Directory: true}, {Role: "db", Object: UpgradeObject{r.OldAuthority.Volume, 20, 2}, Descriptor: [32]byte{2}, Directory: true}, {Role: "args", Object: UpgradeObject{r.OldAuthority.Volume, 20, 3}, Descriptor: [32]byte{3}, Body: sha256.Sum256(nil)}}
+	if !r.valid() {
+		t.Fatal("zero-byte original args write cut refused")
+	}
+	for _, change := range []func(*runtimeFreshControlRetention){func(r *runtimeFreshControlRetention) { r.Inventory = r.Inventory[1:] }, func(r *runtimeFreshControlRetention) { r.Inventory[1].Object = r.Inventory[0].Object }, func(r *runtimeFreshControlRetention) { r.Inventory[0].Object = r.OldOwnerLock }, func(r *runtimeFreshControlRetention) { r.Inventory[1].Size = 1 }, func(r *runtimeFreshControlRetention) { r.Ordinal = runtimeFreshControlSlots }, func(r *runtimeFreshControlRetention) { r.ControllerDescriptor = [32]byte{} }, func(r *runtimeFreshControlRetention) { r.Args = []byte(`null`) }} {
+		bad := r
+		bad.Inventory = append([]runtimeFreshControlObject(nil), r.Inventory...)
+		change(&bad)
+		if bad.valid() {
+			t.Fatal("malformed source prefix metadata accepted")
+		}
+	}
+	if _, e := runtimeFreshControlRecordName(runtimeFreshControlSlots); e == nil {
+		t.Fatal("unbounded recipe slots")
+	}
+	if _, e := runtimeFreshControlRetainedName(`..\foreign`); e == nil {
+		t.Fatal("arbitrary retained path")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_recovery_windows.go b/rdd/pkg/managementconfig/runtime_fresh_control_recovery_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..1621b92ffa4014eef9dd8738cb825133bb88120e
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_recovery_windows.go
@@ -0,0 +1,341 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type nativeFreshControlEntry struct {
+	name, role string
+	object     *runtimeStorageObject
+	body       []byte
+}
+
+// Original structural source prefix, not an initialized authority. All slots
+// belong to SAME n; old original ownerlock is held across retained-root rename.
+type nativeFreshControlRecovery struct {
+	self                      *nativeFreshControlRecovery
+	recovery                  *nativeFreshRecoveryOwner
+	parent, oldRoot, oldLock  *runtimeStorageObject
+	entries                   []nativeFreshControlEntry
+	createdOldLock            *runtimeStorageResource
+	complete                  bool
+	recordObject, birthObject *runtimeStorageObject
+	retainedObject            *runtimeStorageObject
+	newRoot                   *runtimeStorageObject
+	newCreated                *Created
+	birth                     runtimeFreshControlBirth
+	recordBody, birthBody     []byte
+	record                    runtimeFreshControlRetention
+}
+
+// Caller holds original o/n locks and OS thread. This recognizes only the
+// actual fixed structural prefix BEFORE any tuple or TLS leaf/DB material.
+// Everything else stays in the initialized read-only reader or refuses there;
+// failure of that reader never selects this recovery path.
+func (r *nativeFreshRecoveryOwner) captureStructuralControlLocked(ctx context.Context, root *runtimeStorageObject) (result *nativeFreshControlRecovery, failure error) {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return nil, ErrUpgrade
+	}
+	n := r.owner.storage
+	if !r.admitted(n) || r.controlRetention != nil || r.admission != nil || r.stage != nil || r.target != nil || root == nil || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.checkLayoutLocked(ctx) != nil || r.guestPreflight.checkLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	names, e := datastoreDirectoryNames(root.resource.handle)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	ordered := []string{"tls", "db", "args.json", "authority.init"}
+	roles := []string{"tls", "db", "args", "init"}
+	if len(names) > len(ordered)+1 {
+		return nil, nil
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		if seen[name] {
+			return nil, ErrUpgrade
+		}
+		seen[name] = true
+	}
+	ownerPresent := seen["authority.owner.lock"]
+	count := len(names)
+	if ownerPresent {
+		count--
+	}
+	if count > len(ordered) {
+		return nil, nil
+	}
+	for i, name := range ordered {
+		if (i < count) != seen[name] {
+			return nil, nil
+		}
+	}
+	s := &nativeFreshControlRecovery{recovery: r, parent: n.ancestry[len(n.ancestry)-1], oldRoot: root}
+	s.self = s
+	r.controlRetention = s
+	start := len(n.resources)
+	retain := false
+	defer func() {
+		if retain {
+			return
+		}
+		for _, entry := range s.entries {
+			clear(entry.body)
+		}
+		if recover() != nil {
+			r.owner.unknown = true
+			n.fence()
+			failure = ErrUpgrade
+			result = nil
+			return
+		}
+		if n.unknown || r.owner.unknown || !runtimeStorageDomainKnown() {
+			failure = ErrUpgrade
+			return
+		}
+		for len(n.resources) > start {
+			last := n.resources[len(n.resources)-1]
+			if n.closeTemporary(last) != nil {
+				failure = ErrUpgrade
+				return
+			}
+		}
+		r.controlRetention = nil
+	}()
+	for i, name := range ordered[:count] {
+		access := uint32(windows.FILE_READ_DATA | windows.DELETE)
+		if i < 2 {
+			access = windows.FILE_LIST_DIRECTORY | windows.FILE_TRAVERSE | windows.DELETE
+		}
+		share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_DELETE)
+		if i < 2 {
+			share |= windows.FILE_SHARE_WRITE
+		}
+		object, e := n.openFreshExistingTracked(ctx, root.resource.handle, name, i < 2, access, share, true, false)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		entry := nativeFreshControlEntry{name: name, role: roles[i], object: object}
+		if i < 2 {
+			children, e := datastoreDirectoryNames(object.resource.handle)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			if len(children) != 0 {
+				return nil, nil
+			}
+		} else {
+			entry.body, e = n.read(object, true)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+		}
+		s.entries = append(s.entries, entry)
+	}
+	if ownerPresent {
+		lock, e := n.openFreshExistingTracked(ctx, root.resource.handle, "authority.owner.lock", false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, windows.FILE_SHARE_DELETE, true, false)
+		if e != nil || lock.identity.size != 0 {
+			return nil, ErrUpgrade
+		}
+		s.oldLock = lock
+	}
+	if s.oldLock == nil {
+		// Current original setup.lock excludes the selected producer; exact
+		// structural ordering proves it cannot have reached keys/DB/controllers
+		// before this ownerlock. Missing is not a general retired-owner grant.
+		if r.guestPreflight.checkLocked(ctx) != nil || r.checkLayoutLocked(ctx) != nil {
+			return nil, ErrUpgrade
+		}
+		lock, e := s.createMissingOldOwnerLockLocked(ctx)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		s.oldLock = lock
+	}
+	if s.checkPrefixLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	s.complete = true
+	retain = true
+	return s, nil
+}
+
+func (s *nativeFreshControlRecovery) createMissingOldOwnerLockLocked(ctx context.Context) (*runtimeStorageObject, error) {
+	r := s.recovery
+	n := r.owner.storage
+	if s.self != s || r.controlRetention != s || !r.admitted(n) || !freshBoundedContext(ctx) || r.checkLayoutLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	name, e := windows.NewNTUnicodeString("authority.owner.lock")
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: s.oldRoot.resource.handle, ObjectName: name, SecurityDescriptor: sd, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	s.createdOldLock = slot
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&slot.handle, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_DELETE, windows.FILE_CREATE, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if runtimeStorageOpenReply(e, slot.handle != 0 && slot.handle != windows.InvalidHandle, func() {}, n.fence) != nil {
+		if !n.unknown && len(n.resources) > 0 && n.resources[len(n.resources)-1] == slot {
+			n.resources = n.resources[:len(n.resources)-1]
+			s.createdOldLock = nil
+		}
+		return nil, ErrUpgrade
+	}
+	if windows.FlushFileBuffers(slot.handle) != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil || id.size != 0 || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: slot, identity: id, private: true}, nil
+}
+
+func (s *nativeFreshControlRecovery) checkPrefixLocked(ctx context.Context) error {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil || s.recovery.owner.storage == nil {
+		return ErrUpgrade
+	}
+	r := s.recovery
+	n := r.owner.storage
+	if !r.admitted(n) || r.controlRetention != s || !runtimeMappedSelfStorageKnownLocked(n) || r.admission != nil || r.stage != nil || r.target != nil || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.checkLayoutLocked(ctx) != nil || r.guestPreflight.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return s.checkOldGraphLocked(ctx)
+}
+
+// Read-only retained graph check remains valid after current runtime rename.
+// Only checkPrefixLocked additionally authorizes an early mutation boundary.
+func (s *nativeFreshControlRecovery) checkOldGraphLocked(ctx context.Context) error {
+	if s == nil || s.self != s || s.recovery == nil || s.recovery.owner == nil {
+		return ErrUpgrade
+	}
+	r := s.recovery
+	n := r.owner.storage
+	if n == nil || !r.admitted(n) || r.controlRetention != s || len(n.ancestry) == 0 || s.parent != n.ancestry[len(n.ancestry)-1] || s.oldRoot == nil || s.oldLock == nil || r.checkAdmittedStorageLocked(ctx) != nil || n.checkObject(s.oldRoot) != nil || n.checkObject(s.oldLock) != nil {
+		return ErrUpgrade
+	}
+	rootName := anchorName
+	if s.retainedObject != nil {
+		var e error
+		rootName, e = runtimeFreshControlRetainedName(r.owner.intent.Transaction)
+		if e != nil {
+			return ErrUpgrade
+		}
+	}
+	if s.recheckEdgeLocked(ctx, s.parent, rootName, s.oldRoot) != nil || s.recheckEdgeLocked(ctx, s.oldRoot, "authority.owner.lock", s.oldLock) != nil {
+		return ErrUpgrade
+	}
+	names, e := datastoreDirectoryNames(s.oldRoot.resource.handle)
+	if e != nil {
+		return ErrUpgrade
+	}
+	expected := map[string]bool{"authority.owner.lock": true}
+	for _, entry := range s.entries {
+		expected[entry.name] = true
+	}
+	if len(names) != len(expected) {
+		return ErrUpgrade
+	}
+	for _, name := range names {
+		if !expected[name] {
+			return ErrUpgrade
+		}
+	}
+	for _, entry := range s.entries {
+		if n.checkObject(entry.object) != nil || s.recheckEdgeLocked(ctx, s.oldRoot, entry.name, entry.object) != nil {
+			return ErrUpgrade
+		}
+		if entry.object.directory {
+			children, e := datastoreDirectoryNames(entry.object.resource.handle)
+			if e != nil || len(children) != 0 {
+				return ErrUpgrade
+			}
+		} else {
+			body, e := n.read(entry.object, true)
+			if e != nil || !bytes.Equal(body, entry.body) {
+				return ErrUpgrade
+			}
+		}
+	}
+	return finishRuntimeFreshGuestPreflight(ctx)
+}
+
+func (s *nativeFreshControlRecovery) recheckEdgeLocked(ctx context.Context, parent *runtimeStorageObject, name string, expected *runtimeStorageObject) error {
+	n := s.recovery.owner.storage
+	if expected == nil || parent == nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	actual, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, expected.directory, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	same := actual.identity == expected.identity
+	if n.unknown || s.recovery.owner.unknown || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	if n.closeTemporary(actual.resource) != nil || !same || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Build only public metadata from actual original held objects. Full args/init
+// and their partial writes must be exact prefixes of this SAME source's fixed
+// intended args; arbitrary preexisting bytes cannot be archived as a source cut.
+func (s *nativeFreshControlRecovery) retentionLocked(ctx context.Context, args []byte, ordinal uint32) (runtimeFreshControlRetention, error) {
+	if s == nil || s.checkPrefixLocked(ctx) != nil {
+		return runtimeFreshControlRetention{}, ErrUpgrade
+	}
+	return s.retentionMetadataLocked(ctx, args, ordinal)
+}
+
+func (s *nativeFreshControlRecovery) retentionMetadataLocked(ctx context.Context, args []byte, ordinal uint32) (runtimeFreshControlRetention, error) {
+	var record runtimeFreshControlRetention
+	if s == nil || !s.complete || s.checkOldGraphLocked(ctx) != nil {
+		return record, ErrUpgrade
+	}
+	r := s.recovery
+	o := r.owner
+	n := o.storage
+	init, e := initializationBytes(args)
+	if e != nil || parseFreshRuntimeSavedArguments(args) != nil {
+		return record, ErrUpgrade
+	}
+	for _, entry := range s.entries {
+		if entry.role == "args" && !runtimeFreshControlPrefixBytes(entry.body, args) || entry.role == "init" && !runtimeFreshControlPrefixBytes(entry.body, init) {
+			return record, ErrUpgrade
+		}
+	}
+	body, e := n.read(o.fenceObject, false)
+	if e != nil {
+		return record, ErrUpgrade
+	}
+	if r.denial == nil || r.denial.checkLocked(ctx) != nil {
+		return record, ErrUpgrade
+	}
+	denial := runtimeStorageFileData(r.denial.receipt, r.denial.body)
+	record = runtimeFreshControlRetention{Schema: 1, Transaction: o.intent.Transaction, Ordinal: ordinal, Intent: runtimeStorageFileData(o.fenceObject, body), Denial: denial, PrivateParent: runtimeStorageObjectData(s.parent), PublicParent: runtimeStorageObjectData(n.parent), Controller: runtimeStorageObjectData(n.controller), OldAuthority: runtimeStorageObjectData(s.oldRoot), OldOwnerLock: runtimeStorageObjectData(s.oldLock), PrivateDescriptor: s.parent.identity.descriptor, PublicDescriptor: n.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor, OldDescriptor: s.oldRoot.identity.descriptor, OwnerDescriptor: s.oldLock.identity.descriptor, Args: append([]byte(nil), args...)}
+	for _, entry := range s.entries {
+		fact := runtimeFreshControlObject{Role: entry.role, Object: runtimeStorageObjectData(entry.object), Descriptor: entry.object.identity.descriptor, Directory: entry.object.directory, Size: entry.object.identity.size}
+		if !entry.object.directory {
+			fact.Body = sha256.Sum256(entry.body)
+		}
+		record.Inventory = append(record.Inventory, fact)
+	}
+	if !record.valid() || !freshBoundedContext(ctx) {
+		return runtimeFreshControlRetention{}, ErrUpgrade
+	}
+	return record, nil
+}
