+package limavm
+
+import (
+	"context"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+	"testing"
+)
+
+// Compile-only: this package imports real WSL/account initializers. The actual
+// consumer must reject bytes from a raced same-name input, not just a predicate.
+func TestAppTemplateActualConsumerRejectsForeignInput(t *testing.T) {
+	s := runtime.NewScheme()
+	_ = corev1.AddToScheme(s)
+	_ = v1alpha1.AddToScheme(s)
+	yes := true
+	owner := metav1.OwnerReference{APIVersion: "app.rancherdesktop.io/v1alpha1", Kind: "App", Name: "app", UID: "actual-app", Controller: &yes}
+	vm := &v1alpha1.LimaVM{ObjectMeta: metav1.ObjectMeta{Name: "orbwin", Namespace: "test-ns", OwnerReferences: []metav1.OwnerReference{owner}}, Spec: v1alpha1.LimaVMSpec{TemplateRef: v1alpha1.TemplateReference{Name: "input", Namespace: "test-ns"}}}
+	for _, same := range []bool{false, true} {
+		cm := &corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: "input", Namespace: "test-ns", UID: "input-uid"}, Data: map[string]string{v1alpha1.TemplateConfigMapKey: "original-template"}}
+		if same {
+			cm.OwnerReferences = []metav1.OwnerReference{owner}
+		}
+		d := &defaulter{Reader: fake.NewClientBuilder().WithScheme(s).WithObjects(cm).Build()}
+		text, e := d.fetchTemplateRefData(context.Background(), vm)
+		if !same && (e == nil || text != "") {
+			t.Fatal("actual consumer returned foreign input")
+		}
+		if same && (e != nil || text != "original-template") {
+			t.Fatal("actual App-owned input rejected")
+		}
+	}
+}
