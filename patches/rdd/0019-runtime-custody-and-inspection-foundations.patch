@@ -0,0 +1,90 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/pem"
+	"net"
+	"testing"
+
+	certutil "k8s.io/client-go/util/cert"
+)
+
+// The actual default upstream generator stays in memory when fixtures is empty.
+// No native authority, loader, credential file, listener or network is involved.
+func TestAuthorityDefaultGeneratorChain(t *testing.T) {
+	cert, key, err := certutil.GenerateSelfSignedCertKey("127.0.0.1", []net.IP{net.IPv4(127, 0, 0, 1)}, nil)
+	if err != nil {
+		t.Fatal("default generator failed")
+	}
+	defer clear(key)
+	leaf, tail := pem.Decode(cert)
+	root, rest := pem.Decode(tail)
+	if leaf == nil || root == nil || len(rest) != 0 {
+		t.Fatal("default generator's leaf/CA contract changed")
+	}
+	seed := bytes.Repeat([]byte{0x35}, ed25519.SeedSize)
+	sa := ed25519.NewKeyFromSeed(seed)
+	clear(seed)
+	defer clear(sa)
+	der, err := x509.MarshalPKCS8PrivateKey(sa)
+	if err != nil {
+		t.Fatal("fixture key failed")
+	}
+	defer clear(der)
+	saPEM := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: der})
+	defer clear(saPEM)
+	if validateAuthorityMaterial(cert, key, saPEM) != nil {
+		t.Fatal("actual upstream default authority rejected")
+	}
+	digest, err := authorityCertificate(cert)
+	if err != nil || digest != sha256.Sum256(leaf.Bytes) {
+		t.Fatal("chain changed serving-leaf fingerprint")
+	}
+	binding, err := BindServing(101, 1234, 1, "https://127.0.0.1:6443", cert)
+	if err != nil || binding.Certificate != digest {
+		t.Fatal("actual serving binding rejected upstream chain or changed leaf identity")
+	}
+	other, otherKey, err := certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+	if err != nil {
+		t.Fatal("second generator failed")
+	}
+	defer clear(otherKey)
+	_, otherRoot := pem.Decode(other)
+	leafPEM, rootPEM := pem.EncodeToMemory(leaf), pem.EncodeToMemory(root)
+	badLeaf := append([]byte{}, leaf.Bytes...)
+	badLeaf[len(badLeaf)-1] ^= 1
+	badRoot := append([]byte{}, root.Bytes...)
+	badRoot[len(badRoot)-1] ^= 1
+	withHeaders := &pem.Block{Type: "CERTIFICATE", Bytes: leaf.Bytes, Headers: map[string]string{"Unsupported": "header"}}
+	for name, invalid := range map[string][]byte{
+		"reversed":               append(append([]byte{}, rootPEM...), leafPEM...),
+		"duplicate-leaf":         append(append([]byte{}, leafPEM...), leafPEM...),
+		"unrelated-root":         append(append([]byte{}, leafPEM...), otherRoot...),
+		"extra":                  append(append([]byte{}, cert...), rootPEM...),
+		"bad-leaf-signature":     append(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: badLeaf}), rootPEM...),
+		"bad-root-signature":     append(append([]byte{}, leafPEM...), pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: badRoot})...),
+		"headers":                append(pem.EncodeToMemory(withHeaders), rootPEM...),
+		"skipped-invalid-prefix": append([]byte("-----BEGIN CERTIFICATE-----\ninvalid\n-----END CERTIFICATE-----\n"), cert...),
+		"prefix":                 append([]byte("not certificate data\n"), cert...),
+		"suffix":                 append(append([]byte{}, cert...), []byte("garbage")...),
+		"oversized":              bytes.Repeat([]byte("x"), (64<<10)+1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := authorityCertificate(invalid); err == nil {
+				t.Fatal("invalid certificate material accepted")
+			}
+			if validateAuthorityMaterial(invalid, key, saPEM) == nil {
+				t.Fatal("invalid authority material accepted")
+			}
+		})
+	}
+	if validateAuthorityMaterial(cert, otherKey, saPEM) == nil {
+		t.Fatal("unrelated serving private key accepted")
+	}
+	if validateAuthorityMaterial(cert, key, key) == nil {
+		t.Fatal("TLS/service-account key reuse accepted")
+	}
+}
