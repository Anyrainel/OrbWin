+func TestRuntimeUpgradeManagementActualStateAndStatusChurn(t *testing.T) {
+	a, v := runtimeManagementFixture(t)
+	before, err := parseRuntimeUpgradeManagementApp(a)
+	if err != nil {
+		t.Fatal("real App shape refused")
+	}
+	path, err := runtimeUpgradeManagementVMPath(before)
+	if err != nil || path != "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/workloads/limavms/orbwin" {
+		t.Fatal("fixed VM route")
+	}
+	vm, err := parseRuntimeUpgradeManagementVM(v, before)
+	if err != nil {
+		t.Fatal("real owned VM without observedGeneration refused")
+	}
+	changed := runtimeManagementChange(t, a, func(m map[string]any) {
+		m["metadata"].(map[string]any)["resourceVersion"] = "11"
+		m["status"].(map[string]any)["conditions"] = []any{}
+	})
+	after, err := parseRuntimeUpgradeManagementApp(changed)
+	if err != nil {
+		t.Fatal("status-only App reread refused")
+	}
+	state, err := composeRuntimeUpgradeManagementState(before, after, vm)
+	if err != nil || state.appResourceVersion != "10" || state.appResourceVersionAfter != "11" || state.appUID != "app-one" || state.vmUID != "vm-one" || !state.desiredRunning || !state.vmDesiredRunning {
+		t.Fatal("status churn confused desired state or identity")
+	}
+	before.spec[0] = '!'
+	if len(state.appSpec) == 0 || state.appSpec[0] != '{' {
+		t.Fatal("state aliases caller's spec")
+	}
+	for _, format := range []string{"%v", "%+v", "%#v"} {
+		if strings.Contains(fmt.Sprintf(format, state), "app-one") {
+			t.Fatal("private projection formatting")
+		}
+	}
+	encoded, err := json.Marshal(state)
+	if err != nil || string(encoded) != "{}" {
+		t.Fatal("private state exported as DTO")
+	}
+}
