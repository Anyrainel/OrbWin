+type datastoreCleanupFrame struct {
+	owner       *DatastoreGeneration
+	role        string
+	index       int
+	parent      *windows.Handle
+	name        string
+	handle      windows.Handle
+	output      *windows.Handle
+	text        *windows.NTUnicodeString
