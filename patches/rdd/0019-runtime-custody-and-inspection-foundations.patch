+// Exact original owner and actual native publisher only. The one authenticated
+// App CREATE replaces the old Rust creation step; existing controllers perform
+// all engine/guest work. A lost POST response is never retried or adopted.
+func (o *FreshSetupOwner) ObserveFreshRuntime(ctx context.Context, c *Created, p *ConfigPublisher) (w *FreshRuntimeObservation, result error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) || c == nil || p == nil {
+		return nil, ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Minute)
+	defer cancel()
+	o.mu.Lock()
+	defer o.mu.Unlock()
