+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+	"golang.org/x/sys/windows"
+)
+
+func TestRuntimeFreshAppGateRejectsUnissuedBirthAndPauseBeforeNative(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, o := range []*FreshSetupOwner{nil, {}, {self: &FreshSetupOwner{}}} {
+		if g, e := o.CaptureFreshAppGate(ctx, &Created{}, &ConfigPublisher{}); e == nil || g != nil {
+			t.Fatal("unissued owner captured gate")
+		}
+		if o.BeginFreshRuntimeApp(ctx, nil, nil) == nil || o.CompleteFreshRuntimeApp(ctx, nil, nil) == nil {
+			t.Fatal("unissued App began serving")
+		}
+		if o.PrepareFreshRuntimeAppPause(ctx, nil, nil, nil) == nil || o.RecheckFreshRuntimeAppPause(ctx, nil, nil, nil) == nil || o.ConfirmFreshRuntimeAppPause(nil) == nil {
+			t.Fatal("unissued early pause confirmed")
+		}
+	}
+	for _, g := range []*FreshAppGate{nil, {}, {self: &FreshAppGate{}}} {
+		if g.SealPending(ctx, nil, nil) == nil {
+			t.Fatal("unissued gate sealed")
+		}
+	}
+	// A cached known Created close failure must refuse before mapped-self or
+	// storage providers. The original method receives no native handle fixture.
+	o := &FreshSetupOwner{captureComplete: true}
+	o.self = o
+	c := &Created{closeErr: ErrCreate, servingLease: true,anchor:windows.Handle(42)}
+	p := &ConfigPublisher{backend: &nativeAuthority{created: c}}
+	w := &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+	w.self = w
+	o.created = c
+	o.observation = w
+	n,l:=&nativeRuntimeStorage{},&ServingImageLease{}
+	origin:=&nativeRuntimeBuildOrigin{storage:n,lease:l}
+	o.storage=n;o.image=l;o.origin=origin
+	freshTestRegister(t, o)
+	// The actual lower origin helper takes this mutex before any provenance
+	// provider. On a guard regression it is released before failing the test;
+	// its incomplete lease then still refuses before any native query.
+	origin.mu.Lock()
+	done:=make(chan error,1);go func(){done<-w.checkFreshGateParentsLocked(ctx)}()
+	select{
+	case e:=<-done:origin.mu.Unlock();if e==nil{t.Fatal("borrowed unknown admitted gate")}
+	case <-time.After(100*time.Millisecond):origin.mu.Unlock();<-done;t.Fatal("borrowed unknown reached lower mapped-source helper")
+	}
+}
