+		kind = runtimeStorageClassifyTokenOpen(f.raw, uintptr(f.resource.handle), code, known)
+	case runtimeStoragePrivateVolume, runtimeStoragePublicVolume:
+		if uintptr(f.resource.handle) != f.raw {
