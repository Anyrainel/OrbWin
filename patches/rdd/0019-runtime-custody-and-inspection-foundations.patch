+func TestRuntimeUpgradeManagementAppRefusals(t *testing.T) {
+	a, _ := runtimeManagementFixture(t)
+	for _, fault := range []string{"api", "kind", "name", "namespace", "uid", "rv", "generation-zero", "generation-fraction", "deleting", "missing-running", "null-running", "string-running", "case-running", "bad-namespace", "null-namespace", "status-array", "metadata-case"} {
+		t.Run(fault, func(t *testing.T) {
+			changed := runtimeManagementChange(t, a, func(m map[string]any) {
+				meta := m["metadata"].(map[string]any)
+				spec := m["spec"].(map[string]any)
+				switch fault {
+				case "api":
+					m["apiVersion"] = "other/v1"
+				case "kind":
+					m["kind"] = "AppList"
+				case "name":
+					meta["name"] = "another"
+				case "namespace":
+					meta["namespace"] = "default"
+				case "uid":
+					delete(meta, "uid")
+				case "rv":
+					meta["resourceVersion"] = ""
+				case "generation-zero":
+					meta["generation"] = 0
+				case "generation-fraction":
+					meta["generation"] = 1.5
+				case "deleting":
+					meta["deletionTimestamp"] = "2026-11-06T00:00:00Z"
+				case "missing-running":
+					delete(spec, "running")
+				case "null-running":
+					spec["running"] = nil
+				case "string-running":
+					spec["running"] = "true"
+				case "case-running":
+					spec["Running"] = true
+				case "bad-namespace":
+					spec["namespace"] = "../elsewhere"
+				case "null-namespace":
+					spec["namespace"] = nil
+				case "status-array":
+					m["status"] = []any{}
+				case "metadata-case":
+					meta["UID"] = "app-two"
+				}
+			})
+			if _, err := parseRuntimeUpgradeManagementApp(changed); err == nil {
+				t.Fatal("invalid App admitted")
+			}
+		})
+	}
+	for _, input := range [][]byte{
+		[]byte(strings.Replace(string(a), `"running":true`, `"running":true,"running":false`, 1)),
+		[]byte(strings.Replace(string(a), `"running":true`, `"running":true,"\u0072unning":false`, 1)),
+		[]byte(strings.Replace(string(a), `"app-one"`, `"\ud800"`, 1)),
+		append(bytes.Clone(a), []byte(" {}")...),
+		bytes.Repeat([]byte("x"), runtimeUpgradeManagementBodyBudget+1),
+		[]byte(`{"x":` + strings.Repeat("[", 34) + "0" + strings.Repeat("]", 34) + "}"),
+		{0xff},
+	} {
+		if _, err := parseRuntimeUpgradeManagementApp(input); err == nil {
+			t.Fatal("duplicate/lossy/unbounded JSON admitted")
+		}
+	}
+	defaulted := runtimeManagementChange(t, a, func(m map[string]any) { delete(m["spec"].(map[string]any), "namespace") })
+	app, err := parseRuntimeUpgradeManagementApp(defaulted)
+	if err != nil || app.namespace != "default" {
+		t.Fatal("actual namespace default refused")
+	}
+}
