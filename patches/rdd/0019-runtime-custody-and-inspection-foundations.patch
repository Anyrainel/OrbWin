@@ -0,0 +1,79 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"strings"
+)
+
+// HoldServingForwarder is called with binlinks' independently compiled source
+// pin, never protocol/user hash input. The pin alone issues nothing: capture
+// uses actual mapped self's fixed sibling and native private graph. The SAME
+// original partial lease enters the actual owner before error handling.
+func (o *FreshSetupOwner) HoldServingForwarder(ctx context.Context, expected [32]byte) error {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || !o.captureComplete || o.closed || o.unknown || o.forwarderStarted || o.origin == nil || o.image == nil || o.storage == nil {
+		return ErrUpgrade
+	}
+	o.forwarderStarted = true
+	if o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	var e error
+	o.forwarder, e = HoldServingForwarder(ctx, o.storage.home, "orbwin", expected)
+	if e != nil || o.forwarder == nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	l := o.forwarder
+	l.mu.Lock()
+	valid := l.captureSelf == l && l.captureComplete && l.forwarder && !l.closed && !l.unknown && l.err == nil && strings.EqualFold(l.home, o.storage.home) && l.mainImage == o.origin.leased.Hash
+	l.mu.Unlock()
+	if !valid || ctx.Err() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// A failed convenience-code publication cannot become successful startup or
+// release a potentially unknown preparation graph. Negative settlement only.
+func (o *FreshSetupOwner) RefuseServingPreparation() error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if registered {
+		o.fence()
+	}
+	return ErrUpgrade
+}
+
+func (o *FreshSetupOwner) closeServingForwarderLocked() (result error) {
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			result = ErrUpgrade
+		}
+	}()
+	if o.forwarder == nil {
+		return nil
+	}
+	if o.forwarder.Close() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
