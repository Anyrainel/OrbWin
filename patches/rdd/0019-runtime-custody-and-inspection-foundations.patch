+func (s *inspectionFreshRecords) family(ctx context.Context, parent *inspectionNativeObject, name func(uint32) (string, error)) ([]runtimeFreshDenialRecipeObservation, error) {
+	var out []runtimeFreshDenialRecipeObservation
