+	defer unlock()
+	defer func() {
+		if recover() != nil {
+			o.fenceLocked()
+			panic(ErrUpgrade)
+		}
+	}()
+	if o.admitLocked() == runtimeBorrowedUnknown {
+		return ErrUpgrade
+	}
+	for _, c := range o.connections {
+		if c != nil && (!c.close.attempted || c.close.closeErr != nil || c.unknown) {
+			o.fenceLocked()
+			return ErrUpgrade
+		}
+	}
+	o.closed = true
+	o.closeErr = nil
+	o.state.clear()
+	o.connections = [3]*runtimeUpgradeManagementConnection{}
+	o.storage.management = nil
