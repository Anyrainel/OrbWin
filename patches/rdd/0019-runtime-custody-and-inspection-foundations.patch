+
+func TestRuntimeUpgradeOldListenerCheckedCloseSuffix(t *testing.T) {
+	for fail := 0; fail < 5; fail++ {
+		var slots [5]runtimeStorageCloseAttempt
+		calls := []int{}
+		fences := 0
+		close := func(i int) error {
+			return slots[i].run(func() error {
+				calls = append(calls, i)
+				if i == fail {
+					return ErrUpgrade
+				}
+				return nil
+			}, func() { fences++ })
+		}
+		if closeRuntimeUpgradeOldListener(len(slots), close) == nil || fences != 1 || len(calls) != 5-fail {
+			t.Fatal("crossed failed close suffix", fail, calls)
+		}
+		before := len(calls)
+		if closeRuntimeUpgradeOldListener(len(slots), close) == nil || len(calls) != before {
+			t.Fatal("retried consumed close suffix", fail)
+		}
+	}
+	for _, n := range []int{-1, 265} {
+		calls := 0
+		if closeRuntimeUpgradeOldListener(n, func(int) error { calls++; return nil }) == nil || calls != 0 {
+			t.Fatal("invalid close graph reached effects")
+		}
+	}
+	calls := 0
+	if closeRuntimeUpgradeOldListener(0, func(int) error { calls++; return nil }) != nil || calls != 0 {
+		t.Fatal("empty known partial cleanup failed")
+	}
+}
