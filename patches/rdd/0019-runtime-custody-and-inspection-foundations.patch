+package managementconfig
+
+// Known borrowed pseudo handles are never native output resources. Width is
+// retained; high-bit real handles are not truncated to DWORD values.
+func runtimeStorageRealWin32Output(raw uintptr) bool {
+	return raw != 0 && raw != ^uintptr(0) && raw != ^uintptr(1) && raw != ^uintptr(3) && raw != ^uintptr(4) && raw != ^uintptr(5)
+}
+func runtimeStorageClassifyTokenOpen(rawBool uintptr, output uintptr, code uint32, errorKnown bool) runtimeStorageNativeOpenReply {
+	if uint32(rawBool) != 0 {
+		if runtimeStorageRealWin32Output(output) {
+			return runtimeStorageNativeOpenSuccess
+		}
+		return runtimeStorageNativeOpenUnknown
+	}
+	if output != 0 || !errorKnown || code == 0 || code == 996 || code == 997 {
+		return runtimeStorageNativeOpenUnknown
+	}
+	return runtimeStorageNativeOpenFailure
+}
