+func (n *nativeManagedNamespace) captureRegistration(ctx context.Context) error {
+	root, e := n.openKey(ctx, windows.HKEY_CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`)
+	if e == windows.ERROR_FILE_NOT_FOUND {
+		return nil
+	}
+	if e != nil {
+		return ErrUpgrade
+	}
+	n.root = root
+	for i := uint32(0); i <= 512; i++ {
+		if !n.known(ctx) {
+			return ErrUpgrade
+		}
+		var text [64]uint16
+		count := uint32(len(text))
+		e := windows.RegEnumKeyEx(root.handle, i, &text[0], &count, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			return nil
+		}
+		if e != nil || i == 512 || count == 0 || count >= 64 {
+			return ErrUpgrade
+		}
+		guid := strings.ToLower(windows.UTF16ToString(text[:count]))
+		if !freshRuntimeGUID(guid) {
+			return ErrUpgrade
+		}
+		key, e := n.openKey(ctx, root.handle, guid)
+		if e != nil {
+			return ErrUpgrade
+		}
+		name, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+		if e != nil {
+			return ErrUpgrade
+		}
+		if runtimeFreshOwnedRegistrationName(name) {
+			if n.selected != nil {
+				return ErrUpgrade
+			}
+			name, base, e := n.registrationValues(key.handle)
+			if e != nil {
+				return ErrUpgrade
+			}
+			n.selected, n.guid, n.name, n.base = key, guid, name, base
+			// Unlike the original observation, keep this ACTUAL selected key.
+			continue
+		}
+		if n.closeKey(key) != nil {
+			return ErrUpgrade
+		}
+	}
+	return ErrUpgrade
+}
+
+func (n *nativeManagedNamespace) capturePaths(ctx context.Context) error {
+	parent := n.directories[0].resource.handle
+	for _, name := range []string{".rdorbwin", "lima", "orbwin"} {
+		o, e := n.openChild(ctx, parent, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return nil
+		}
+		if e != nil {
+			return ErrUpgrade
+		}
+		n.directories = append(n.directories, o)
+		parent = o.resource.handle
+	}
+	disk, e := n.openChild(ctx, parent, "ext4.vhdx", false, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil
+	}
+	if e != nil || disk.identity.size == 0 {
+		return ErrUpgrade
+	}
+	n.disk = disk
+	return nil
+}
+
+func (n *nativeManagedNamespace) capture(ctx context.Context, home *runtimeStorageObject, token windows.Token) error {
+	if !n.known(ctx) || home == nil || token == 0 {
+		return ErrUpgrade
+	}
+	n.selfToken = n.slot()
+	e := windows.DuplicateHandle(windows.CurrentProcess(), windows.Handle(token), windows.CurrentProcess(), &n.selfToken.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	if n.reply(n.selfToken, e) != nil || windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &n.session) != nil || n.session == 0 || n.checkCurrentToken() != nil {
+		return ErrUpgrade
+	}
+	h, e := n.duplicateObject(home)
+	if e != nil {
+		return ErrUpgrade
+	}
+	n.directories = append(n.directories, h)
+	if n.capturePaths(ctx) != nil || n.captureRegistration(ctx) != nil {
+		return ErrUpgrade
+	}
+	n.shape = classifyRuntimeFreshGuest(n.selected != nil, len(n.directories) == 4, n.disk != nil)
+	if n.shape == runtimeFreshGuestUnknown || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	n.complete = true
+	return nil
+}
