@@ -0,0 +1,147 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+)
+
+// A complete original retention record can describe an interrupted namespace
+// even before a new authority exists. No record is upgraded into a writer.
+func (s *inspectionFreshRecords) controlCut(ctx context.Context) runtimeInspectionResult {
+	unknown := inspectionUnknown("control-cut-unsupported")
+	if !runtimeFreshControlNamespaceNamesValid(s.privateNames, s.intent.Transaction, true) || s.denialGraph(ctx) != nil {
+		return unknown
+	}
+	for _, n := range []string{runtimeFreshAdmissionName, runtimeFreshCommittedName, runtimeFreshAppAdmissionName} {
+		if inspectionNamesContain(s.privateNames, n) {
+			return unknown
+		}
+	}
+	for i := uint32(1); i <= runtimeFreshRecoveryLimit; i++ {
+		n, _ := runtimeFreshRecoveryRecordName(i)
+		if inspectionNamesContain(s.privateNames, n) {
+			return unknown
+		}
+	}
+	names, e := s.o.snapshotDirectory(ctx, s.public)
+	if e != nil {
+		return unknown
+	}
+	for _, n := range names {
+		if n != "home" && n != "setup.lock" {
+			return unknown
+		}
+	}
+	type part struct {
+		ordinal uint32
+		body    []byte
+	}
+	var partials []part
+	var r runtimeFreshControlRetention
+	var object *inspectionNativeObject
+	var body []byte
+	gap := false
+	for i := uint32(0); i < runtimeFreshControlSlots; i++ {
+		n, _ := runtimeFreshControlRecordName(i)
+		v, b, e := s.o.inspectionFragment(ctx, s.private, n, runtimeFreshRecordBudget)
+		if e != nil {
+			return unknown
+		}
+		if v == nil {
+			gap = true
+			continue
+		}
+		if gap || object != nil {
+			return unknown
+		}
+		var value runtimeFreshControlRetention
+		if parseRuntimeFreshRecord(b, &value) == nil && value.valid() {
+			if value.Ordinal != i {
+				return unknown
+			}
+			r, object, body = value, v, b
+		} else {
+			partials = append(partials, part{i, b})
+		}
+	}
+	if object == nil {
+		return unknown
+	}
+	for _, p := range partials {
+		v := r
+		v.Ordinal = p.ordinal
+		b, e := runtimeFreshRecordBytes(v)
+		if e != nil || !runtimeFreshControlPrefixBytes(p.body, b) {
+			return unknown
+		}
+	}
+	if r.Transaction != s.intent.Transaction || r.Intent != inspectionFileWitness(s.intentObject, s.intentBody) || r.Denial != s.denialWitness || r.PrivateParent != inspectionObjectWitness(s.private) || r.PublicParent != inspectionObjectWitness(s.public) || r.Controller != inspectionObjectWitness(s.controller) || r.PrivateDescriptor != s.private.legacy.descriptor || r.PublicDescriptor != s.public.legacy.descriptor || r.ControllerDescriptor != s.controller.legacy.descriptor {
+		return unknown
+	}
+	canonical, e := s.o.optional(ctx, s.private, anchorName, true, true, false, 0)
+	if e != nil {
+		return unknown
+	}
+	n, _ := runtimeFreshControlRetainedName(s.intent.Transaction)
+	retained, e := s.o.optional(ctx, s.private, n, true, true, false, 0)
+	if e != nil {
+		return unknown
+	}
+	old := retained
+	if old == nil {
+		old = canonical
+	}
+	if old == nil || inspectionObjectWitness(old) != r.OldAuthority || old.legacy.descriptor != r.OldDescriptor || s.checkControlInventory(ctx, r, old) != nil {
+		return unknown
+	}
+	canonicalID, retainedID, birthID := UpgradeObject{}, UpgradeObject{}, UpgradeObject{}
+	canonicalEmpty := false
+	if canonical != nil {
+		canonicalID = inspectionObjectWitness(canonical)
+		names, e := s.o.snapshotDirectory(ctx, canonical)
+		if e != nil {
+			return unknown
+		}
+		canonicalEmpty = len(names) == 0
+	}
+	if retained != nil {
+		retainedID = inspectionObjectWitness(retained)
+	}
+	gap = false
+	found := false
+	for i := uint32(0); i < runtimeFreshControlSlots; i++ {
+		name, _ := runtimeFreshControlBirthName(i)
+		v, b, e := s.o.inspectionFragment(ctx, s.private, name, runtimeFreshRecordBudget)
+		if e != nil {
+			return unknown
+		}
+		if v == nil {
+			gap = true
+			continue
+		}
+		if gap || found || canonical == nil || canonicalID == r.OldAuthority {
+			return unknown
+		}
+		expected := runtimeFreshControlBirth{Schema: 1, Transaction: r.Transaction, Ordinal: i, Retention: inspectionFileWitness(object, body), Authority: canonicalID, Descriptor: canonical.legacy.descriptor}
+		wanted, e := runtimeFreshRecordBytes(expected)
+		if e != nil || !expected.matches(r, inspectionFileWitness(object, body), canonicalID, canonical.legacy.descriptor) || !runtimeFreshControlPrefixBytes(b, wanted) {
+			return unknown
+		}
+		if bytes.Equal(b, wanted) {
+			found = true
+			birthID = canonicalID
+		}
+	}
+	cut := classifyRuntimeFreshControlCut(r.OldAuthority, canonicalID, retainedID, birthID, canonicalEmpty)
+	if cut == runtimeFreshControlInvalid {
+		return unknown
+	}
+	// A populated successor can contain tuple/role crash cuts that need their
+	// own complete input witness; do not infer those from an old control record.
+	if cut == runtimeFreshControlBoundRoot && !canonicalEmpty {
+		return inspectionUnknown("tuple-cut-unsupported")
+	}
+	return s.imageResult(ctx, "interrupted-same-image", "uncommitted")
+}
