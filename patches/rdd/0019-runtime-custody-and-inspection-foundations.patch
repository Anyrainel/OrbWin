+func TestRuntimeUpgradeOldListenerCommandScope(t *testing.T) {
+	image := `C:\Code\rdd.exe`
+	saved := []byte(`["--secure-port","6443"]`)
+	base := []string{image, "service", "serve", "--secure-port", "6443"}
+	for _, tail := range [][]string{nil, {"--controllers=*,-path-management"}, {"--controllers", "*,-path-management"}} {
