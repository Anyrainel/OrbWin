index 0000000000000000000000000000000000000000..3bfd7f48e4eb3af1340a42fc90491b3d4d8b029a
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_launch_windows.go
@@ -0,0 +1,390 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"runtime"
+	"strconv"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// This launch DATA locates actual inherited objects. It cannot issue native
+// ownership; the child independently validates original parent and file caps.
+type managedLifetimeData struct {
+	Schema    uint32         `json:"schema"`
+	Parent    uint32         `json:"parent"`
+	Creation  uint64         `json:"creation"`
+	Session   uint32         `json:"session"`
+	Anchor    uint64         `json:"anchor"`
+	Lock      uint64         `json:"lock"`
+	Interrupt uint64         `json:"interrupt"`
+	AnchorID  AnchorIdentity `json:"anchorId"`
+	LockID    AnchorIdentity `json:"lockId"`
+}
+
+const managedAnchorRights = windows.READ_CONTROL | windows.FILE_LIST_DIRECTORY | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE
+const managedLockRights = windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE
+const managedInterruptRights = windows.EVENT_MODIFY_STATE | windows.SYNCHRONIZE
+
+// ManagedHostagentLaunch is born only under the original native serving owner.
+// Its command is retained BEFORE duplicate/spawn; parent closes preserve the
+// actual partial output graph on any uncertainty. No public handle constructor
+// or caller-supplied Start callback exists.
+type ManagedHostagentLaunch struct {
+	self                       *ManagedHostagentLaunch
+	mu                         sync.Mutex
+	owner                      *nativeManagedRuntimeAuthority
+	cmd                        *exec.Cmd
+	birth                      *ManagedHostagentBirth
+	boundOriginal              *os.Process // immutable actual bind; birth.Close clears its mutable original reference
+	resources                  []*runtimeStorageResource
+	anchor, lock, interrupt    *runtimeStorageResource
+	data                       managedLifetimeData
+	complete, started, unknown bool
+	closeAttempt               runtimeStorageCloseAttempt
+}
+
+func (*ManagedHostagentLaunch) String() string   { return "private original hostagent launch" }
+func (*ManagedHostagentLaunch) GoString() string { return "private original hostagent launch" }
+func (l *ManagedHostagentLaunch) fence() {
+	l.unknown = true
+	if l.owner != nil && l.owner.image != nil {
+		l.owner.image.managedUnknown.Store(true)
+	}
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.Unlock()
+}
+func (l *ManagedHostagentLaunch) slot() *runtimeStorageResource {
+	r := &runtimeStorageResource{}
+	l.resources = append(l.resources, r)
+	return r
+}
+func (l *ManagedHostagentLaunch) duplicate(source windows.Handle, access uint32) (*runtimeStorageResource, error) {
+	r := l.slot()
+	e := windows.DuplicateHandle(windows.CurrentProcess(), source, windows.CurrentProcess(), &r.handle, access, true, 0)
+	if runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, l.fence) != nil {
+		return r, ErrUpgrade
+	}
+	if upgradeSDKCohortHandleRights(r.handle, access, access) != nil || sameUpgradeSDKKernelObject(source, r.handle) != nil {
+		return r, ErrUpgrade
+	}
+	return r, nil
+}
+
+func (a *ManagedRuntimeAuthority) PrepareHostagentLaunch(ctx context.Context, cmd *exec.Cmd) (out *ManagedHostagentLaunch, result error) {
+	n, e := a.exact()
+	if e != nil || cmd == nil || cmd.Process != nil || cmd.Cancel != nil || cmd.WaitDelay != 0 || !freshBoundedContext(ctx) || cmd.SysProcAttr != nil && (len(cmd.SysProcAttr.AdditionalInheritedHandles) != 0 || cmd.SysProcAttr.NoInheritHandles || cmd.SysProcAttr.ParentProcess != 0) {
+		return nil, ErrUpgrade
+	}
+	if a.RequireHostagentLaunch(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !n.admitted() || !n.controllersStarted || n.created.managedOwnerLock == 0 || cmd.Cancel != nil || cmd.WaitDelay != 0 || cmd.SysProcAttr != nil && (len(cmd.SysProcAttr.AdditionalInheritedHandles) != 0 || cmd.SysProcAttr.NoInheritHandles || cmd.SysProcAttr.ParentProcess != 0) {
+		return nil, ErrUpgrade
+	}
+	if !n.launchAvailableLocked() {
+		return nil, ErrUpgrade
+	}
+	for _, old := range n.launches {
+		if old.closeForAuthorityHeld(n) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	n.launches = nil // every previous source cap has actual cached positive close
+	l := &ManagedHostagentLaunch{owner: n, cmd: cmd}
+	l.self = l
+	n.launches = append(n.launches, l)
+	out = l
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			l.fence()
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	thread := l.slot()
+	e = windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, (*windows.Token)(unsafe.Pointer(&thread.handle)))
+	if runtimeStorageOpenReply(e, thread.handle != 0 && thread.handle != windows.InvalidHandle, func() {}, l.fence) != windows.ERROR_NO_TOKEN {
+		return l, ErrUpgrade
+	}
+	l.resources = l.resources[:len(l.resources)-1]
+	token := l.slot()
+	e = windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&token.handle)))
+	if runtimeStorageOpenReply(e, token.handle != 0 && token.handle != windows.InvalidHandle, func() {}, l.fence) != nil {
+		return l, ErrUpgrade
+	}
+	user, e := windows.Token(token.handle).GetTokenUser()
+	if e != nil || user.User.Sid == nil || !user.User.Sid.IsValid() {
+		return l, ErrUpgrade
+	}
+	sid := user.User.Sid.String()
+	if legacySDKOrdinaryToken(windows.Token(token.handle), sid, n.publisher.serving.Session) != nil || verifyPrivate(n.created.anchor, sid, true) != nil || verifyPrivate(n.created.managedOwnerLock, sid, false) != nil || n.main.same() != nil {
+		return l, ErrUpgrade
+	}
+	anchorID, e := anchorIdentity(n.created.anchor)
+	if e != nil {
+		return l, ErrUpgrade
+	}
+	lockID, e := anchorIdentity(n.created.managedOwnerLock)
+	if e != nil {
+		return l, ErrUpgrade
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(n.created.managedOwnerLock, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow != 0 || info.NumberOfLinks != 1 {
+		return l, ErrUpgrade
+	}
+	l.anchor, e = l.duplicate(n.created.anchor, managedAnchorRights)
+	if e != nil {
+		return l, ErrUpgrade
+	}
+	l.lock, e = l.duplicate(n.created.managedOwnerLock, managedLockRights)
+	if e != nil {
+		return l, ErrUpgrade
+	}
+	control := l.slot()
+	control.handle, e = windows.CreateEvent(nil, 1, 0, nil)
+	if runtimeStorageOpenReply(e, control.handle != 0 && control.handle != windows.InvalidHandle, func() {}, l.fence) != nil {
+		return l, ErrUpgrade
+	}
+	l.interrupt, e = l.duplicate(control.handle, managedInterruptRights)
+	if e != nil {
+		return l, ErrUpgrade
+	}
+	l.data = managedLifetimeData{Schema: 1, Parent: n.publisher.serving.PID, Creation: n.publisher.serving.Creation, Session: n.publisher.serving.Session, Anchor: uint64(l.anchor.handle), Lock: uint64(l.lock.handle), Interrupt: uint64(l.interrupt.handle), AnchorID: anchorID, LockID: lockID}
+	if !validManagedLifetimeData(l.data) || ctx.Err() != nil {
+		return l, ErrUpgrade
+	}
+	l.complete = true
+	return l, nil
+}
+
+func validManagedLifetimeData(d managedLifetimeData) bool {
+	return d.Schema == 1 && d.Parent != 0 && d.Creation != 0 && d.Session != 0 && d.Anchor != 0 && d.Lock != 0 && d.Interrupt != 0 && d.Interrupt != d.Anchor && d.Interrupt != d.Lock && uint64(uintptr(d.Interrupt)) == d.Interrupt && windows.Handle(d.Interrupt) != windows.InvalidHandle && d.Anchor != d.Lock && uint64(uintptr(d.Anchor)) == d.Anchor && uint64(uintptr(d.Lock)) == d.Lock && windows.Handle(d.Anchor) != windows.InvalidHandle && windows.Handle(d.Lock) != windows.InvalidHandle && (d.AnchorID.IndexHigh != 0 || d.AnchorID.IndexLow != 0) && (d.LockID.IndexHigh != 0 || d.LockID.IndexLow != 0)
+}
+
+func encodeManagedLifetimeData(d managedLifetimeData) (string, error) {
+	if !validManagedLifetimeData(d) {
+		return "", ErrUpgrade
+	}
+	b, e := json.Marshal(d)
+	if e != nil || len(b) > 512 {
+		return "", ErrUpgrade
+	}
+	return base64.RawURLEncoding.EncodeToString(b), nil
+}
+
+// Start is the sole fixed caller of cmd.Start. Optional proxy custody is an
+// actual AnchorTransfer, never a raw extra handle/list from the caller.
+func (l *ManagedHostagentLaunch) Start(ctx context.Context, proxy *AnchorTransfer) (result error) {
+	if l == nil || l.self != l || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	n := l.owner
+	if n == nil || n.self == nil || n.self.native != n || n.publisher == nil || n.created == nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	member := false
+	for _, owned := range n.launches {
+		if owned == l {
+			member = true
+			break
+		}
+	}
+	if !member || !n.admitted() {
+		return ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.unknown || !l.complete || l.started || l.closeAttempt.attempted || l.cmd == nil || l.cmd.Process != nil || l.owner.image.managedUnknown.Load() || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	l.started = true
+	defer func() {
+		if recover() != nil {
+			l.fence()
+			result = ErrUpgrade
+		}
+		runtime.KeepAlive(l.cmd)
+	}()
+	start := func(extra uintptr, _ AnchorIdentity) error {
+		if ctx.Err() != nil || l.cmd.SysProcAttr != nil && (len(l.cmd.SysProcAttr.AdditionalInheritedHandles) != 0 || l.cmd.SysProcAttr.NoInheritHandles || l.cmd.SysProcAttr.ParentProcess != 0) {
+			return ErrUpgrade
+		}
+		argument, e := encodeManagedLifetimeData(l.data)
+		if e != nil {
+			return e
+		}
+		if l.cmd.SysProcAttr == nil {
+			l.cmd.SysProcAttr = &syscall.SysProcAttr{}
+		}
+		l.cmd.SysProcAttr.AdditionalInheritedHandles = []syscall.Handle{syscall.Handle(l.anchor.handle), syscall.Handle(l.lock.handle), syscall.Handle(l.interrupt.handle)}
+		if extra != 0 {
+			l.cmd.SysProcAttr.AdditionalInheritedHandles = append(l.cmd.SysProcAttr.AdditionalInheritedHandles, syscall.Handle(extra))
+		}
+		l.cmd.Args = append(l.cmd.Args, "--orbwin-native-lifetime", argument)
+		e = l.cmd.Start()
+		// Each child copy has independent handle flags. Stop the original
+		// parent's retained copies propagating to any later subprocess.
+		for _, r := range []*runtimeStorageResource{l.anchor, l.lock, l.interrupt} {
+			if windows.SetHandleInformation(r.handle, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+				l.fence()
+				return ErrUpgrade
+			}
+		}
+		return e
+	}
+	if proxy != nil {
+		return proxy.Start(start)
+	}
+	return start(0, AnchorIdentity{})
+}
+
+// Only parent copies are closed. The original inherited child handles retain
+// the SAME file object/share reservation until actual child process exit.
+func (l *ManagedHostagentLaunch) Close() error {
+	if l == nil {
+		return nil
+	}
+	if l.self != l {
+		return ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.unknown {
+		return ErrUpgrade
+	}
+	if l.cmd != nil && l.cmd.Process != nil {
+		return ErrUpgrade
+	}
+	if l.closeAttempt.attempted {
+		return l.closeAttempt.closeErr
+	}
+	return l.closeAttempt.run(func() error {
+		for i := len(l.resources) - 1; i >= 0; i-- {
+			r := l.resources[i]
+			if r.run(func() error {
+				if windows.CloseHandle(r.handle) != nil {
+					return ErrUpgrade
+				}
+				r.handle = 0
+				return nil
+			}, l.fence) != nil {
+				return ErrUpgrade
+			}
+		}
+		return nil
+	}, l.fence)
+}
+
+// The authority holds its mutex. This reads only original cached closes and
+// original cmd.Process membership; it performs no native cleanup or query.
+func (l *ManagedHostagentLaunch) readyForAuthorityClose(a *nativeManagedRuntimeAuthority) bool {
+	if l == nil || l.self != l || l.owner != a {
+		return false
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.unknown || l.closeAttempt.closeErr != nil || l.cmd == nil {
+		return false
+	}
+	if l.cmd.Process != nil {
+		return l.birth != nil && l.boundOriginal == l.cmd.Process && l.birth.closedForParent(a.image)
+	}
+	return true
+}
+
+func (l *ManagedHostagentLaunch) blocksNextLaunch(a *nativeManagedRuntimeAuthority) bool {
+	if l == nil || l.self != l || l.owner != a {
+		return true
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.unknown || l.cmd == nil {
+		return true
+	}
+	if l.cmd.Process != nil {
+		return l.birth == nil || l.boundOriginal != l.cmd.Process || !l.birth.closedForParent(a.image)
+	}
+	if !l.closeAttempt.attempted || l.closeAttempt.closeErr != nil {
+		return true
+	}
+	for _, r := range l.resources {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// Parent authority holds its mutex and has checked every original birth's
+// actual cached positive native retirement before reaching this suffix.
+func (l *ManagedHostagentLaunch) closeForAuthorityHeld(a *nativeManagedRuntimeAuthority) error {
+	if l == nil || l.self != l || l.owner != a {
+		return ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.unknown {
+		return ErrUpgrade
+	}
+	if l.closeAttempt.attempted {
+		return l.closeAttempt.closeErr
+	}
+	return l.closeAttempt.run(func() error {
+		for i := len(l.resources) - 1; i >= 0; i-- {
+			r := l.resources[i]
+			if r.run(func() error {
+				if windows.CloseHandle(r.handle) != nil {
+					return ErrUpgrade
+				}
+				r.handle = 0
+				return nil
+			}, l.fence) != nil {
+				return ErrUpgrade
+			}
+		}
+		return nil
+	}, l.fence)
+}
+
+// DATA only, used by the fixed role parser; no native query/constructor here.
+func decodeManagedLifetimeData(value string) (managedLifetimeData, error) {
+	var d managedLifetimeData
+	if len(value) < 1 || len(value) > 684 {
+		return d, ErrUpgrade
+	}
+	b, e := base64.RawURLEncoding.DecodeString(value)
+	if e != nil || len(b) > 512 || json.Unmarshal(b, &d) != nil || !validManagedLifetimeData(d) {
+		return managedLifetimeData{}, ErrUpgrade
+	}
+	canonical, e := encodeManagedLifetimeData(d)
+	if e != nil || canonical != value || strconv.IntSize == 32 && (d.Anchor > 1<<32-1 || d.Lock > 1<<32-1) {
+		return managedLifetimeData{}, ErrUpgrade
+	}
+	return d, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_managed_launch_windows_test.go b/rdd/pkg/managementconfig/runtime_managed_launch_windows_test.go
