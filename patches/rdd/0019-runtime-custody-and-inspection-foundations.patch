+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestManagedHostagentBirthRejectsCopiesAndMissingOriginalBeforeNative(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	l := &ServingImageLease{captureComplete: true}
+	l.captureSelf = l
+	if b, e := l.CaptureManagedHostagent(ctx, nil); e == nil || b != nil || len(l.managedBirths) != 0 {
+		t.Fatal("missing original Go handle entered native capture")
+	}
+	b := &ManagedHostagentBirth{}
+	b.self = b
+	// Shared native graph fields do not provide the copied wrapper's birth.
+	copy := &ManagedHostagentBirth{self: b, process: &runtimeStorageResource{handle: 42}, complete: true}
+	if copy.CheckExited(ctx) == nil || copy.Close() == nil || copy.process.attempted {
+		t.Fatal("copied birth reached native observation/close")
+	}
+}
+
+func TestManagedHostagentBirthParentUnknownPreventsSiblingNativeEffects(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	l := &ServingImageLease{captureComplete: true}
+	l.captureSelf = l
+	l.managedUnknown.Store(true)
+	r := &runtimeStorageResource{handle: 42}
+	b := &ManagedHostagentBirth{parent: l, complete: true, process: r}
+	b.self = b
+	if b.CheckExited(ctx) == nil || b.Close() == nil || r.attempted {
+		t.Fatal("parent uncertainty allowed sibling query/close")
+	}
+	if next, e := l.CaptureManagedHostagent(ctx, &os.Process{}); e == nil || next != nil || len(l.managedBirths) != 0 {
+		t.Fatal("parent uncertainty allowed another native birth capture")
+	}
+}
+
+func TestManagedHostagentBirthUnknownRetainsActualSourceClose(t *testing.T) {
+	r := &runtimeStorageResource{handle: 42}
+	l := &ServingImageLease{chain: []windows.Handle{42}, resources: []*runtimeStorageResource{r}}
+	l.captureSelf = l
+	b := &ManagedHostagentBirth{parent: l, unknown: true}
+	b.self = b
+	l.managedBirths = []*ManagedHostagentBirth{b}
+	if l.Close() == nil || l.closed || r.attempted || r.handle != 42 {
+		t.Fatal("unknown derivative birth released parent source")
+	}
+}
+
+func TestManagedHostagentBirthParentReleaseRequiresExactPositiveCaches(t *testing.T) {
+	l := &ServingImageLease{}
+	b := &ManagedHostagentBirth{parent: l}
+	b.self = b
+	if b.closedForParent(l) {
+		t.Fatal("unattempted birth close released source")
+	}
+	b.closeAttempt.attempted = true
+	b.closeAttempt.closeErr = ErrUpgrade
+	if b.closedForParent(l) {
+		t.Fatal("unknown close released source")
+	}
+	b.closeAttempt.closeErr = nil
+	b.resources = []*runtimeStorageResource{{runtimeStorageCloseAttempt: runtimeStorageCloseAttempt{attempted: true}}}
+	if !b.closedForParent(l) || b.closedForParent(&ServingImageLease{}) {
+		t.Fatal("actual positive cache lost parent binding")
+	}
+	b.resources[0].handle = 42
+	if b.closedForParent(l) {
+		t.Fatal("nonzero native output accepted as closed")
+	}
+}
+
+func managedBirthRestoreDomain(t *testing.T) {
+	t.Helper()
+	runtimeStorageDomain.Lock()
+	prior := runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	t.Cleanup(func() {
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = prior
+		runtimeStorageDomain.Unlock()
+	})
+}
+
+func TestManagedHostagentBirthNativeReplyUncertaintyIsSticky(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		state   uint32
+		err     error
+		unknown bool
+	}{
+		{"live", uint32(windows.WAIT_TIMEOUT), nil, false},
+		{"failed-wait", uint32(windows.WAIT_OBJECT_0), ErrUpgrade, true},
+		{"unexpected-wait", uint32(windows.WAIT_ABANDONED), nil, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			managedBirthRestoreDomain(t)
+			l := &ServingImageLease{}
+			l.captureSelf = l
+			r := &runtimeStorageResource{handle: 42}
+			b := &ManagedHostagentBirth{parent: l, process: r, complete: true}
+			b.self = b
+			l.managedBirths = []*ManagedHostagentBirth{b}
+			if b.waitReply(tc.state, tc.err) == nil || b.unknown != tc.unknown || l.managedUnknown.Load() != tc.unknown {
+				t.Fatal("native wait reply lost known-live/unknown distinction")
+			}
+			if tc.unknown && (b.Close() == nil || l.Close() == nil || r.attempted || b.closedForParent(l)) {
+				t.Fatal("failed native wait was erased by later close")
+			}
+		})
+	}
+	t.Run("failed-exit-or-image-query", func(t *testing.T) {
+		managedBirthRestoreDomain(t)
+		l := &ServingImageLease{}
+		l.captureSelf = l
+		r := &runtimeStorageResource{handle: 42}
+		b := &ManagedHostagentBirth{parent: l, process: r, complete: true}
+		b.self = b
+		if b.queryReply(ErrUpgrade) == nil || !b.unknown || b.Close() == nil || r.attempted {
+			t.Fatal("query uncertainty permitted later native cleanup")
+		}
+		b.closeAttempt.attempted = true
+		if b.closedForParent(l) {
+			t.Fatal("synthetic positive close cache erased prior uncertainty")
+		}
+	})
+}
diff --git a/rdd/pkg/managementconfig/runtime_managed_wait_windows.go b/rdd/pkg/managementconfig/runtime_managed_wait_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..3d19d84444502fee3a10e41a0797aa8f8b15470a
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_wait_windows.go
@@ -0,0 +1,51 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+// RecordOriginalWait records DATA from the original controller's sole Cmd.Wait
+// owner, before publishing procExited. It grants no native retirement: actual
+// native exit, peer identity, registry and VHDX checks remain mandatory.
+func (b *ManagedHostagentBirth) RecordOriginalWait(waitErr error) error {
+	if b == nil || b.self != b {
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.waitDone == nil {
+		return ErrUpgrade
+	}
+	if waitErr != nil {
+		b.waitFailed = true
+	}
+	if !b.waitRecorded {
+		b.waitRecorded = true
+		close(b.waitDone)
+	}
+	return nil
+}
+
+func (b *ManagedHostagentBirth) awaitOriginalWait(ctx context.Context) error {
+	if b == nil || b.self != b || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	if b.waitDone == nil || b.unknown {
+		b.mu.Unlock()
+		return ErrUpgrade
+	}
+	done := b.waitDone
+	b.mu.Unlock()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if !b.waitRecorded || b.waitFailed || b.unknown || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_candidate_statement.go b/rdd/pkg/managementconfig/runtime_modern_candidate_statement.go
new file mode 100644
index 0000000000000000000000000000000000000000..a14c912bc225feb7d34c0df7460b6f7921edae23
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_modern_candidate_statement.go
@@ -0,0 +1,148 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"unicode/utf8"
+)
+
+var errModernCandidateStatement = errors.New("signed rdd candidate data unavailable")
+
+const modernCandidateStatementLimit = 4096
+const modernCandidateSigningDomain = "orbwin-rdd-candidate-bundle-v1\n"
+
+// Signed DATA only. This is not a native image/launch/ownership capability.
+type modernCandidateAssetData struct {
+	Role   string `json:"role"`
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+	Size   uint64 `json:"size"`
+}
+type modernCandidateStatementData struct {
+	Schema       int                        `json:"schema"`
+	Purpose      string                     `json:"purpose"`
+	Platform     string                     `json:"platform"`
+	Protocol     string                     `json:"protocol"`
+	TrustScope   string                     `json:"trustScope"`
+	SourceCommit string                     `json:"sourceCommit"`
+	Assets       []modernCandidateAssetData `json:"assets"`
+}
+
+func modernCandidateHex(text string, digits int) bool {
+	if len(text) != digits {
+		return false
+	}
+	nonzero := false
+	for _, c := range text {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+		nonzero = nonzero || c != '0'
+	}
+	return nonzero
+}
+func modernCandidateScope(scope string) bool {
+	return scope == "local-qualification" || scope == "product-release"
+}
+func (v modernCandidateStatementData) canonical() ([]byte, error) {
+	if v.Schema != 1 || v.Purpose != "rdd-modern-candidate" || v.Platform != "windows-amd64" || v.Protocol != "modern-no-writer-v1" || !modernCandidateScope(v.TrustScope) || !modernCandidateHex(v.SourceCommit, 40) || len(v.Assets) != 2 {
+		return nil, errModernCandidateStatement
+	}
+	roles := [2]string{"rdd", "rdd-forwarder"}
+	paths := [2]string{"rdd.exe", "rdd-forwarder.exe"}
+	limits := [2]uint64{512 << 20, 4 << 20}
+	for n, a := range v.Assets {
+		if a.Role != roles[n] || a.Path != paths[n] || !modernCandidateHex(a.SHA256, 64) || a.Size == 0 || a.Size > limits[n] {
+			return nil, errModernCandidateStatement
+		}
+	}
+	raw, e := json.Marshal(v)
+	if e != nil || len(raw) == 0 || len(raw) > modernCandidateStatementLimit {
+		return nil, errModernCandidateStatement
+	}
+	return raw, nil
+}
+func parseModernCandidateStatement(raw []byte) (modernCandidateStatementData, error) {
+	var v modernCandidateStatementData
+	if len(raw) == 0 || len(raw) > modernCandidateStatementLimit || !utf8.Valid(raw) {
+		return v, errModernCandidateStatement
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if d.Decode(&v) != nil {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	var extra any
+	if d.Decode(&extra) != io.EOF {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	canonical, e := v.canonical()
+	if e != nil || !bytes.Equal(canonical, raw) {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	return v, nil
+}
+
+// Private public-only verifier configuration. Production obtains it solely
+// from compiledModernCandidateVerifier; no renderer/manifest constructor exists.
+type modernCandidateVerifier struct {
+	key   [ed25519.PublicKeySize]byte
+	scope string
+}
+
+func parseModernCandidateVerifier(keyHex, scope string) (modernCandidateVerifier, error) {
+	var v modernCandidateVerifier
+	if !modernCandidateHex(keyHex, 64) || !modernCandidateScope(scope) {
+		return v, errModernCandidateStatement
+	}
+	raw, e := hex.DecodeString(keyHex)
+	if e != nil || len(raw) != ed25519.PublicKeySize {
+		return v, errModernCandidateStatement
+	}
+	copy(v.key[:], raw)
+	v.scope = scope
+	return v, nil
+}
+func (v modernCandidateVerifier) verify(raw, signature []byte) (modernCandidateStatementData, error) {
+	if v.key == [ed25519.PublicKeySize]byte{} || !modernCandidateScope(v.scope) {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	data, e := parseModernCandidateStatement(raw)
+	if e != nil || data.TrustScope != v.scope || len(signature) != 88 {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	sig, e := base64.StdEncoding.Strict().DecodeString(string(signature))
+	if e != nil || len(sig) != ed25519.SignatureSize || base64.StdEncoding.EncodeToString(sig) != string(signature) {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	message := make([]byte, 0, len(modernCandidateSigningDomain)+len(raw))
+	message = append(message, modernCandidateSigningDomain...)
+	message = append(message, raw...)
+	if !ed25519.Verify(ed25519.PublicKey(v.key[:]), message, sig) {
+		return modernCandidateStatementData{}, errModernCandidateStatement
+	}
+	return data, nil
+}
+
+// Byte verification only, never a native file or path authority constructor.
+func (v modernCandidateStatementData) verifyAsset(role string, body []byte) error {
+	if _, e := v.canonical(); e != nil {
+		return e
+	}
+	for _, a := range v.Assets {
+		if a.Role == role {
+			actual := sha256.Sum256(body)
+			if uint64(len(body)) != a.Size || hex.EncodeToString(actual[:]) != a.SHA256 {
+				return errModernCandidateStatement
+			}
+			return nil
+		}
+	}
+	return errModernCandidateStatement
+}
