@@ -0,0 +1,36 @@
+//go:build windows
+
+package authoritypath
+
+import "golang.org/x/sys/windows"
+
+// KnownForReadOnlyInspection is a cached negative guard for a read-only owner
+// that already holds THIS actual selector. It performs no native query and
+// returns no routing, owner, handle, mutation permit or positive-close fact.
+// Selection(ctx) remains the actual native admission/recheck API. A reader's
+// own positive closed replay must use its own cache instead of calling here.
+func (o *ProductSelectionOwner) KnownForReadOnlyInspection() error {
+	if o == nil || o.self != o {
+		return ErrSelection
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	productSelectionDomain.Lock()
+	defer productSelectionDomain.Unlock()
+	if productSelectionDomain.failed || !productSelectionDomain.owners[o] || o.unknown || o.closed || o.close.used || o.close.err != nil || o.selection == nil || o.process == 0 || o.session == 0 || o.sid == "" || o.local == "" || o.token == 0 || windows.Handle(o.token) == windows.InvalidHandle || o.selection.owner != o.sid || o.selection.profile == "" || o.selection.home != o.local+`\OrbWinData\home` || len(o.resources) == 0 {
+		return ErrSelection
+	}
+	found := false
+	for _, r := range o.resources {
+		if r == nil || r.pending || r.close.used || r.close.err != nil || r.token == 0 || windows.Handle(r.token) == windows.InvalidHandle {
+			return ErrSelection
+		}
+		if r.token == o.token {
+			found = true
+		}
+	}
+	if !found {
+		return ErrSelection
+	}
+	return nil
+}
