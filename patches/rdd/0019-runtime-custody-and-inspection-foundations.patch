+// Original startup producer, called while SAME controller and service-owner
+// lock overlap. Independent native copies survive f.closeOwned/handoff.
+func (f *freshCommittedStartupPermit) captureManagedNamespaceLocked(ctx context.Context, c *Created) (result error) {
+	if f == nil || f.self != f || f.created != c || c == nil || c.managedNamespace != nil || f.denial == nil || f.storage == nil {
+		return ErrUpgrade
+	}
+	native := f.storage
+	native.mu.Lock()
+	defer native.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !f.admittedCapture(native) || !runtimeMappedSelfStorageKnownLocked(native) || native.check() != nil || c.closed || c.closeErr != nil || len(c.authorityHandles) == 0 {
+		return ErrUpgrade
+	}
+	cap := &ManagedRuntimeNamespace{}
+	n := &nativeManagedNamespace{self: cap, created: c, sid: native.sid, home: native.home}
+	cap.native = n
+	c.managedNamespace = cap
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			n.fence()
+		}
+	}()
+	return n.capture(ctx, f.denial.directories[0], native.token)
+}
