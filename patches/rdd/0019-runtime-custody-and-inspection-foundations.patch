@@ -0,0 +1,61 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+// Compile-only actual entry guard tests; no sentinel reaches a native API.
+func TestRuntimeImageOutputActualUnownedEntryRefuses(t *testing.T) {
+	for _, f := range []*runtimeImageOpenFrame{nil, {}, {resource: &runtimeStorageResource{handle: windows.Handle(42)}}} {
+		if _, e := openUpgradeObservedImageFileInto(f, windows.Handle(42), "rdd.exe"); e == nil {
+			t.Fatal("unowned entry")
+		}
+		if f != nil {
+			if _, e := f.duplicate(windows.CurrentProcess(), 0, windows.DUPLICATE_SAME_ACCESS); e == nil {
+				t.Fatal("unowned duplicate")
+			}
+		}
+	}
+}
+
+// This actual-domain regression is compile-only in this epoch. It exercises Go
+// owner-map guards if separately selected; it never supplies a handle to an API.
+func TestRuntimeImageServingDomainFailureDeniesCleanOtherLease(t *testing.T) {
+	l1, l2 := &ServingImageLease{}, &ServingImageLease{}
+	l1.captureSelf = l1
+	l1.captureComplete = true
+	l2.captureSelf = l2
+	l2.captureComplete = true
+	servingImageCaptures.Lock()
+	oldFailed := servingImageCaptures.failed
+	servingImageCaptures.failed = false
+	servingImageCaptures.owners[l1] = true
+	servingImageCaptures.owners[l2] = true
+	servingImageCaptures.Unlock()
+	defer func() {
+		servingImageCaptures.Lock()
+		delete(servingImageCaptures.owners, l1)
+		delete(servingImageCaptures.owners, l2)
+		servingImageCaptures.failed = oldFailed
+		servingImageCaptures.Unlock()
+	}()
+	if !servingImageCaptureKnown(l2) {
+		t.Fatal("registered local clean setup")
+	}
+	l1.fail()
+	if l2.unknown || l2.err != nil {
+		t.Fatal("fixture must leave L2 locally clean")
+	}
+	if servingImageCaptureKnown(l2) {
+		t.Fatal("other original failure admitted L2")
+	}
+	// A locally clean unregistered wrapper cannot use an original map entry.
+	wrapper := &ServingImageLease{captureComplete: true}
+	wrapper.captureSelf = wrapper
+	if servingImageCaptureKnown(wrapper) {
+		t.Fatal("wrapper minted serving domain membership")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_classify_windows.go b/rdd/pkg/managementconfig/runtime_inspection_classify_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..c0bc8f97a977149e5b38ad104a7181254a705784
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_classify_windows.go
@@ -0,0 +1,269 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+
+	"golang.org/x/sys/windows"
+)
+
+func inspectionObserved(phase, reason, state, image string) runtimeInspectionResult {
+	return runtimeInspectionResult{2, "bounded-observation", "product", phase, reason, state, image, "not-checked", "not-checked", inspectionUnsupportedActions()}
+}
+func (o *inspectionNativeOwner) record(ctx context.Context, parent *inspectionNativeObject, name string, budget uint64) (*inspectionNativeObject, []byte, error) {
+	object, e := o.open(ctx, parent, name, false, true, false, windows.FILE_READ_DATA)
+	if e != nil {
+		return nil, nil, e
+	}
+	body, e := o.read(ctx, object, budget)
+	return object, body, e
+}
+func inspectionCommittedPrivateNames(names []string) bool {
+	return inspectionFreshNamespace(names)
+}
+func (o *inspectionNativeOwner) classify(ctx context.Context) runtimeInspectionResult {
+	unknown := inspectionUnknown("observation-unknown")
+	profile, e := o.walk(ctx, o.selected.Profile(), false)
+	if e != nil {
+		return unknown
+	}
+	private, e := o.optional(ctx, profile, ".orbwin-private", true, true, false, 0)
+	if e != nil {
+		return unknown
+	}
+	localPath := o.selected.GuestHome()
+	suffix := `\OrbWinData\home`
+	if len(localPath) <= len(suffix) || localPath[len(localPath)-len(suffix):] != suffix {
+		return unknown
+	}
+	localPath = localPath[:len(localPath)-len(suffix)]
+	local, e := o.walk(ctx, localPath, false)
+	if e != nil {
+		return unknown
+	}
+	public, e := o.optional(ctx, local, "OrbWinData", true, false, false, 0)
+	if e != nil {
+		return unknown
+	}
+	var privateNames, publicNames []string
+	if private != nil {
+		privateNames, e = o.snapshotDirectory(ctx, private)
+		if e != nil {
+			return unknown
+		}
+		for _, name := range privateNames {
+			if name == "runtime" || name == "setup-logs" {
+				if _, e = o.open(ctx, private, name, true, true, false, 0); e != nil {
+					return unknown
+				}
+			}
+		}
+	}
+	if public != nil {
+		publicNames, e = o.snapshotDirectory(ctx, public)
+		if e != nil {
+			return unknown
+		}
+	}
+	if inspectionFreshPrivateNames(privateNames) && len(publicNames) == 0 {
+		owned, e := o.captureRegistry(ctx)
+		if e != nil {
+			return unknown
+		}
+		if owned {
+			return inspectionObserved("conflict", "namespace-conflict", "unknown", "unknown")
+		}
+		return inspectionObserved("fresh", "initial-absence-observed", "absent", "unknown")
+	}
+	if private == nil || public == nil {
+		return inspectionUnknown("partial-record-unsupported")
+	}
+	if !inspectionCommittedPrivateNames(privateNames) {
+		return inspectionUnknown("control-cut-unsupported")
+	}
+	for _, name := range publicNames {
+		if name != "home" && name != "runtime.json" && name != "setup.lock" && name != "runtime.publication.stage" {
+			return inspectionUnknown("partial-record-unsupported")
+		}
+	}
+	return o.classifyCommitted(ctx, private, public)
+}
+func (o *inspectionNativeOwner) classifyCommitted(ctx context.Context, private, public *inspectionNativeObject) runtimeInspectionResult {
+	unknown := inspectionUnknown("partial-record-unsupported")
+	s := &inspectionFreshRecords{o: o, private: private, public: public}
+	var se error
+	s.privateNames, se = o.snapshotDirectory(ctx, private)
+	if se != nil {
+		return inspectionUnknown("observation-unknown")
+	}
+	if s.readIntent(ctx) != nil {
+		return unknown
+	}
+	intentObject, body, intent := s.intentObject, s.intentBody, s.intent
+	wanted, _ := encodeRuntimeFreshIntent(intent)
+	if intentObject == nil || !bytes.Equal(body, wanted) {
+		return s.earlyIntent(ctx)
+	}
+	intentWitness := inspectionFileWitness(intentObject, body)
+	admissionObject, admissionBody, e := o.inspectionFragment(ctx, private, runtimeFreshAdmissionName, runtimeFreshRecordBudget)
+	if e != nil {
+		return unknown
+	}
+	if admissionObject == nil {
+		return s.noAdmission(ctx)
+	}
+	a, e := inspectionParseFreshAdmission(admissionBody, intent, intentWitness, o.selected.GuestHome())
+	if e != nil {
+		return inspectionUnknown("malformed-record")
+	}
+
+	gap := false
+	for sequence := uint32(1); sequence <= runtimeFreshRecoveryLimit; sequence++ {
+		name, _ := runtimeFreshRecoveryRecordName(sequence)
+		object, e := o.optional(ctx, private, name, false, true, false, windows.FILE_READ_DATA)
+		if e != nil {
+			return unknown
+		}
+		if object == nil {
+			gap = true
+			continue
+		}
+		if gap {
+			return inspectionUnknown("malformed-record")
+		}
+		b, e := o.read(ctx, object, runtimeFreshRecordBudget)
+		if e != nil {
+			return unknown
+		}
+		var r runtimeFreshRecoveryAdmission
+		if parseRuntimeFreshRecord(b, &r) != nil || !r.matches(a, inspectionFileWitness(admissionObject, admissionBody), sequence) {
+			return inspectionUnknown("malformed-record")
+		}
+		a = r.Current
+		admissionObject, admissionBody = object, b
+	}
+	committedObject, committedBody, e := o.inspectionFragment(ctx, private, runtimeFreshCommittedName, runtimeFreshRecordBudget)
+	if e != nil {
+		return unknown
+	}
+	var committed runtimeFreshCommitted
+	if committedObject != nil && (parseRuntimeFreshRecord(committedBody, &committed) != nil || !committed.matches(a) || committed.Admission != inspectionFileWitness(admissionObject, admissionBody)) {
+		return inspectionUnknown("malformed-record")
+	}
+	controller := s.controller
+	if controller.legacy.size != 0 || !runtimeFreshAdmittedStorageMatches(a, inspectionObjectWitness(public), inspectionObjectWitness(controller), public.legacy.descriptor, controller.legacy.descriptor) {
+		return unknown
+	}
+	authority, e := o.open(ctx, private, anchorName, true, true, false, 0)
+	if e != nil || inspectionObjectWitness(authority) != a.Authority || s.checkControl(ctx, a, authority) != nil {
+		return unknown
+	}
+	lock, e := o.open(ctx, authority, "authority.owner.lock", false, true, false, 0)
+	if e != nil || lock.legacy.size != 0 || inspectionObjectWitness(lock) != a.AuthorityLock || lock.legacy.descriptor != a.AuthorityLockDescriptor {
+		return unknown
+	}
+	args, argsBody, e := o.record(ctx, authority, "args.json", 65536)
+	if e != nil || inspectionFileWitness(args, argsBody) != a.Args {
+		return unknown
+	}
+	init, initBody, e := o.record(ctx, authority, "authority.init", runtimeFreshRecordBudget)
+	if e != nil || inspectionFileWitness(init, initBody) != a.Initialization || validateInitialization(initBody, argsBody) != nil {
+		return unknown
+	}
+	tls, e := o.open(ctx, authority, "tls", true, true, false, 0)
+	if e != nil {
+		return unknown
+	}
+	obsolete, e := o.optional(ctx, tls, ".admin-token-store", false, true, false, 0)
+	if e != nil || obsolete != nil {
+		return unknown
+	}
+	for _, name := range []string{"apiserver.crt", "apiserver.key", "sa.key"} {
+		object, e := o.open(ctx, tls, name, false, true, false, 0)
+		if e != nil || object.legacy.size == 0 || object.legacy.size > 65536 {
+			return unknown
+		}
+	}
+	parent := public
+	var legacy [runtimeFreshLegacyDirectoryCount]runtimeFreshLegacyDirectoryFact
+	var dirs [runtimeFreshLegacyDirectoryCount]*inspectionNativeObject
+	for role := 0; role < runtimeFreshLegacyDirectoryCount; role++ {
+		name, _ := runtimeFreshLegacyDirectoryName(role)
+		object, e := o.open(ctx, parent, name, true, true, false, 0)
+		if e != nil {
+			return unknown
+		}
+		dirs[role] = object
+		legacy[role] = runtimeFreshLegacyDirectoryFact{Object: inspectionObjectWitness(object), Descriptor: object.legacy.descriptor}
+		parent = object
+	}
+	denial, denialBody, e := o.record(ctx, parent, runtimeFreshLegacyDenialName, runtimeFreshLegacyDenialBudget)
+	if e != nil || inspectionFileWitness(denial, denialBody) != a.LegacyDenial {
+		return unknown
+	}
+	d, e := parseRuntimeFreshLegacyDenial(denialBody)
+	if e != nil || d.Transaction != a.Transaction || d.Intent != intentWitness || d.Parent != (runtimeFreshLegacyDirectoryFact{Object: inspectionObjectWitness(public), Descriptor: public.legacy.descriptor}) || d.Directories != legacy {
+		return unknown
+	}
+	completion, ce := s.checkDenial(ctx, dirs, denialBody, denial)
+	if ce != nil || completion != a.DenialCompletion {
+		return unknown
+	}
+	_, appBody, e := o.record(ctx, private, runtimeFreshAppAdmissionName, runtimeFreshRecordBudget)
+	if e != nil {
+		return unknown
+	}
+	var app runtimeFreshAppRecord
+	if parseRuntimeFreshRecord(appBody, &app) != nil || !app.valid() || app.Transaction != a.Transaction || app.Intent != intentWitness || app.Parent != a.Parent || app.Controller != a.Controller || app.Authority != a.Authority || app.AuthorityLock != a.AuthorityLock || app.ParentDescriptor != a.ParentDescriptor || app.ControllerDescriptor != a.ControllerDescriptor || app.AuthorityDescriptor != authority.legacy.descriptor || app.LockDescriptor != a.AuthorityLockDescriptor || app.Args != a.Args || app.Initialization != a.Initialization || app.Producer.Image != a.Candidate.Image {
+		return unknown
+	}
+	stage, stageBody, e := o.inspectionFragment(ctx, public, "runtime.publication.stage", runtimeIdentityBudget)
+	if e != nil {
+		return unknown
+	}
+	target, targetBody, e := o.inspectionFragment(ctx, public, "runtime.json", runtimeIdentityBudget)
+	if e != nil {
+		return unknown
+	}
+	sw, tw := runtimePublicationFileWitness{}, runtimePublicationFileWitness{}
+	if stage != nil {
+		sw = inspectionFileWitness(stage, stageBody)
+		if !runtimeFreshRecoveryBodyMatches(a, stageBody, o.selected.GuestHome()) {
+			return unknown
+		}
+	}
+	if target != nil {
+		tw = inspectionFileWitness(target, targetBody)
+		if !runtimeFreshRecoveryBodyMatches(a, targetBody, o.selected.GuestHome()) {
+			return unknown
+		}
+	}
+	var cp *runtimeFreshCommitted
+	if committedObject != nil {
+		cp = &committed
+	}
+	layout := classifyRuntimeFreshRecovery(&a, cp, sw, tw)
+	if reason := inspectionPublicationCutReason(layout); reason != "" {
+		return s.imageResult(ctx, reason, "uncommitted")
+	}
+	if layout != runtimeFreshRecoveryCommitted {
+		return unknown
+	}
+	canonical, e := encodeRuntimeIdentity(a.Runtime, o.selected.GuestHome())
+	if e != nil || !bytes.Equal(canonical, targetBody) {
+		return inspectionUnknown("malformed-record")
+	}
+	if o.captureImage(ctx) != nil {
+		return inspectionUnknown("observation-unknown")
+	}
+	if hex.EncodeToString(o.selfHash[:]) != a.Runtime.BinarySHA {
+		return inspectionObserved("unsupported-version", "different-image", "committed", "different")
+	}
+	if o.selfCommit != a.Runtime.SourceCommit {
+		return inspectionObserved("unsupported-version", "different-source", "committed", "different")
+	}
+	return inspectionObserved("committed", "committed-receipt", "committed", "same")
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_cli.go b/rdd/pkg/managementconfig/runtime_inspection_cli.go
new file mode 100644
index 0000000000000000000000000000000000000000..7e3c99b51f30a3d6a84f56dda4a489cffcc6961d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_cli.go
@@ -0,0 +1,45 @@
+package managementconfig
+
+import (
+	"context"
+	"io"
+	"time"
+)
+
+// RunNativeRuntimeInspection runs only the fixed framed schema2 request. A
+// returned error does NOT establish that retained native custody may exit.
+// Non-CLI callers must retain their process when the native domain is unknown.
+func RunNativeRuntimeInspection(parent context.Context, input io.Reader, output io.Writer) error {
+	return runRuntimeInspectionEntry(parent, input, output, inspectRuntimeNative)
+}
+
+// RuntimeInspectionCLI is the fixed same-rdd-image DATA producer. It returns an
+// exit code only after known empty native custody. An unknown/retained graph
+// parks this process indefinitely; no timeout, parent cancellation or parse DTO
+// can grant exit, cleanup or retry. The parent must never force-kill this mode.
+func RuntimeInspectionCLI(args []string, input io.Reader, output io.Writer) (handled bool, code int) {
+	selected, valid := runtimeInspectionCLIArguments(args)
+	if !selected {
+		return false, 0
+	}
+	failure := errRuntimeInspection
+	if valid {
+		failure = func() (err error) {
+			defer func() {
+				if recover() != nil {
+					err = errRuntimeInspection
+				}
+			}()
+			return RunNativeRuntimeInspection(context.Background(), input, output)
+		}()
+	}
+	code, terminal := runtimeInspectionCLIExit(inspectionNativeExitKnown(), failure)
+	if terminal {
+		return true, code
+	}
+	// Global domain retains each exact owner. No native calls, waits on native
+	// objects, output, cleanup or dependent work occurs once keeper is entered.
+	for {
+		time.Sleep(time.Second)
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_cli_model.go b/rdd/pkg/managementconfig/runtime_inspection_cli_model.go
