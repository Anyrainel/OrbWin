+func (s *inspectionFreshRecords) noAdmission(ctx context.Context) runtimeInspectionResult {
+	unknown := inspectionUnknown("partial-record-unsupported")
+	// An initialized partial producer has no admitted recovery chain. Do not
+	// mistake a missing original admission for an intact later chain.
+	for _, name := range []string{runtimeFreshCommittedName} {
+		v, _, e := s.o.inspectionFragment(ctx, s.private, name, runtimeFreshRecordBudget)
