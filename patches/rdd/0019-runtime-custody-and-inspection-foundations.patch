+//go:build windows
+
+package service
+
+// Fixed stage labels are diagnostic DATA. Never include native error bodies,
+// paths, credentials, request bytes or panic values in fixed-role failures.
+type freshSetupStage uint8
+
+const (
+	freshStageCapture freshSetupStage = iota
+	freshStageDenial
+	freshStageEnvironment
+	freshStageBinlinks
+	freshStageAuthority
+	freshStageLifecycle
+	freshStageReadiness
+	freshStageObservation
+	freshStagePublication
+	freshStageSettlement
+)
+
+func (s freshSetupStage) String() string {
+	labels := [...]string{"capture", "legacy-denial", "environment", "binlinks", "authority", "service-lifecycle", "service-readiness", "runtime-observation", "runtime-publication", "settlement"}
+	if int(s) >= len(labels) {
+		return "unknown"
+	}
+	return labels[s]
+}
+
+type freshSetupFailure struct{ stage freshSetupStage }
+
+func (e freshSetupFailure) Error() string { return "private setup failed at " + e.stage.String() }
+func (e freshSetupFailure) Unwrap() error { return errPrivateAuthority }
