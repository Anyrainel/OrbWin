+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshSelectionRefusesBeforeNativeOrEnvironmentEffects(t *testing.T) {
+	for _, ctx := range []context.Context{nil, context.Background()} {
+		if o, e := CaptureSelectedFreshSetupOwner(ctx); e == nil || o != nil {
+			t.Fatal("unbounded selection reached native acquisition")
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, o := range []*FreshSetupOwner{nil, {}, {self: &FreshSetupOwner{}}} {
+		if c, e := o.OpenSelectedSetupServiceAuthority(ctx, []byte(`[]`)); e == nil || c != nil {
+			t.Fatal("unissued owner selected creation/resume")
+		}
+	}
+	o := &FreshSetupOwner{}
+	o.self = o
+	n := &nativeRuntimeStorage{}
+	n.captureSelf = n
+	o.storage = n
+	s := &nativeFreshSetupChoice{owner: o}
+	s.self = s
+	n.freshChoice = s
+	// No actual constructor registration/private-prefix phase. A caller's
+	// in-memory choice cannot observe files or manufacture initial eligibility.
+	if s.chooseNativeIntent(ctx) == nil || s.initial || s.resume != nil || len(n.resources) != 0 {
+		t.Fatal("unborn selection performed native namespace effects")
+	}
+}
