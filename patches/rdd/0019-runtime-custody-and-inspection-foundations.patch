+type runtimeManagementPanicReader struct {
+	header  string
+	partial []byte
+}
+
+func TestRuntimeUpgradeManagementRejectedHeadersDoNotDrainBody(t *testing.T) {
+	for _, header := range []string{
+		"HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: 10000\r\n\r\n",
+		"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Encoding: gzip\r\nContent-Length: 10000\r\n\r\n",
+		"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 524289\r\n\r\n",
+		"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n",
+	} {
+		// A second read panics. Header policy refusal must return to the raw
+		// owner immediately rather than calling Body.Close to drain it.
+		r := &runtimeManagementPanicReader{header: header}
+		connection := &runtimeManagementMemoryConnection{input: r}
+		body, err := runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath)
+		if err == nil || body != nil || r.partial != nil || connection.closed {
+			t.Fatal("rejected header initiated body drain/raw close")
+		}
+	}
+}
+
+func (r *runtimeManagementPanicReader) Read(p []byte) (int, error) {
+	if r.header != "" {
+		n := copy(p, r.header)
+		r.header = r.header[n:]
+		return n, nil
+	}
+	r.partial = p
+	copy(p, "synthetic-private-response")
+	panic(ErrUpgrade)
+}
+func TestRuntimeUpgradeManagementHTTPPanicClearsOwnedBody(t *testing.T) {
+	r := &runtimeManagementPanicReader{header: "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 10000\r\n\r\n"}
+	connection := &runtimeManagementMemoryConnection{input: r}
+	var recovered any
+	func() {
+		defer func() { recovered = recover() }()
+		_, _ = runtimeUpgradeManagementExchange(connection, "https://127.0.0.1:6443", []byte(credentialTestAdmin), runtimeUpgradeManagementAppPath)
+	}()
+	if recovered != ErrUpgrade || len(r.partial) < 10000 || !bytes.Equal(r.partial, make([]byte, len(r.partial))) || connection.closed {
+		t.Fatal("panic buffer clearing or raw ownership failed")
+	}
+}
