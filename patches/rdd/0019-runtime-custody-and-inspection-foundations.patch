+// The completion is checked against the actual seed, directory graph and all
+// predecessor histories. A complete-looking canonical denial alone is not it.
+func (s *inspectionFreshRecords) checkDenial(ctx context.Context, dirs [runtimeFreshLegacyDirectoryCount]*inspectionNativeObject, body []byte, canonical *inspectionNativeObject) (runtimePublicationFileWitness, error) {
+	zero := runtimePublicationFileWitness{}
+	plan := runtimeFreshDenialPlan{Transaction: s.intent.Transaction, Seed: s.intent.Seed, Intent: inspectionFileWitness(s.intentObject, s.intentBody), PrivateParent: inspectionObjectWitness(s.private), PublicParent: inspectionObjectWitness(s.public), Controller: inspectionObjectWitness(s.controller), PrivateDescriptor: s.private.legacy.descriptor, PublicDescriptor: s.public.legacy.descriptor, ControllerDescriptor: s.controller.legacy.descriptor}
+	pid := dirs[runtimeFreshLegacyDirectoryCount-1]
+	names, e := s.o.snapshotDirectory(ctx, pid)
+	if e != nil || !runtimeFreshDenialNamespaceValid(names, s.intent.Schema == 2, false) || !runtimeFreshDenialNamespaceValid(s.privateNames, s.intent.Schema == 2, true) {
+		return zero, ErrUpgrade
+	}
+	if s.intent.Schema == 1 {
+		return zero, nil
+	}
+	directory, e := s.family(ctx, s.private, runtimeFreshDenialDirectoryName)
+	if e != nil {
+		return zero, ErrUpgrade
+	}
+	current := runtimeFreshDenialDirectoryRecipe{Schema: 1, Plan: plan, Count: runtimeFreshLegacyDirectoryCount}
+	head := zero
+	for i, v := range dirs {
+		current.Prefix[i] = runtimeFreshLegacyDirectoryFact{Object: inspectionObjectWitness(v), Descriptor: v.legacy.descriptor}
+	}
+	for _, v := range directory {
+		var r runtimeFreshDenialDirectoryRecipe
+		if parseRuntimeFreshRecord(v.Body, &r) == nil && r.valid() {
+			head = v.File
+		}
+	}
+	current.Previous = head
+	if validateRuntimeFreshDenialDirectoryHistory(directory, current) != nil {
+		return zero, ErrUpgrade
+	}
+	repairs, e := s.family(ctx, pid, runtimeFreshDenialRepairName)
+	if e != nil {
+		return zero, ErrUpgrade
+	}
+	archives := make([]*runtimeFreshDenialRecipeObservation, runtimeFreshDenialSlots)
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		n, _ := runtimeFreshDenialArchiveName(i)
+		v, b, e := s.o.inspectionFragment(ctx, pid, n, runtimeFreshRecordBudget)
+		if e != nil {
+			return zero, ErrUpgrade
+		}
+		if v != nil {
+			archives[i] = &runtimeFreshDenialRecipeObservation{Body: b, File: inspectionFileWitness(v, b)}
+		}
+	}
+	completions, e := s.family(ctx, pid, runtimeFreshDenialCompletionName)
+	if e != nil {
+		return zero, ErrUpgrade
+	}
+	_, _, unarchived, complete, e := validateRuntimeFreshDenialReceiptHistory(plan, body, runtimeFreshDenialRecipeObservation{Body: body, File: inspectionFileWitness(canonical, body)}, true, repairs, archives, completions, head)
