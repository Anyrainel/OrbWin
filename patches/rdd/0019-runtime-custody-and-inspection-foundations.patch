+		}
+		t.Run(name, func(t *testing.T) {
+			if _, e := o.CreateServiceAuthority(ctx, []byte("[]")); e == nil {
+				t.Fatal("admitted owner without actual completed custody")
+			}
+		})
+	}
+	o := &FreshSetupOwner{}
+	o.self = o
+	freshTestRegister(t, o)
+	copy := &FreshSetupOwner{self: o}
+	if _, e := copy.CreateServiceAuthority(ctx, []byte("[]")); e == nil {
+		t.Fatal("copied owner admitted")
+	}
+	if copy.Close() == nil {
+		t.Fatal("copied owner closed shared graph")
+	}
+	if _, e := o.CreateServiceAuthority(ctx, []byte("[]")); e == nil {
+		t.Fatal("registered incomplete owner admitted")
+	}
+	if o.created != nil {
+		t.Fatal("incomplete owner performed private effects")
+	}
+	for _, bad := range []context.Context{nil, context.Background()} {
+		if got, e := CaptureFreshSetupOwner(bad); e == nil || got != nil {
+			t.Fatal("invalid context reached actual process query")
+		}
+	}
+}
