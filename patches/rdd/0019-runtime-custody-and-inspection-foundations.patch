+func freshRuntimeRegistryValue(handle windows.Handle, name string) (string, error) {
+	text, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return "", ErrUpgrade
+	}
+	var body [2048]byte
+	size := uint32(len(body))
+	var kind uint32
+	if windows.RegQueryValueEx(handle, text, nil, &kind, &body[0], &size) != nil || kind != windows.REG_SZ || size < 2 || size > uint32(len(body)) || size%2 != 0 {
+		return "", ErrUpgrade
+	}
+	units := make([]uint16, size/2)
+	for i := range units {
+		units[i] = binary.LittleEndian.Uint16(body[2*i:])
+	}
+	return freshRuntimeRegistryText(units)
+}
