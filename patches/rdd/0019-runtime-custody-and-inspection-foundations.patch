+//go:build windows
+
+package service
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+	"testing"
+	"time"
+)
+
+func TestFreshSetupStdoutRequiresActualStandardHandleBeforeNative(t *testing.T) {
+	var output bytes.Buffer
+	for _, ctx := range []context.Context{nil, context.Background()} {
+		if prepareFreshProtocolStdout(ctx, &output) == nil {
+			t.Fatal("unbounded caller reached own-stdio native mutation")
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	if prepareFreshProtocolStdout(ctx, &output) == nil {
+		t.Fatal("caller writer substituted for actual stdout")
+	}
+}
+func TestFreshSetupStdoutNativeResultTranslation(t *testing.T) {
+	for _, tc := range []struct {
+		reply   uintptr
+		flags   uint32
+		allowed bool
+	}{{0, 0, false}, {0, windows.HANDLE_FLAG_INHERIT, false}, {1, 0, true}, {2, 0, true}, {1, windows.HANDLE_FLAG_INHERIT, false}, {1, ^uint32(0), false}} {
+		if freshStdoutNonInherited(tc.reply, tc.flags) != tc.allowed {
+			t.Fatal("stdio inheritance result misclassified")
+		}
+	}
+}
diff --git a/rdd/pkg/service/cmd/fresh_setup_windows.go b/rdd/pkg/service/cmd/fresh_setup_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..445cd15470cecfe0f0fab6478d7867e901fa9da3
--- /dev/null
+++ b/rdd/pkg/service/cmd/fresh_setup_windows.go
@@ -0,0 +1,192 @@
+//go:build windows
+
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/binlinks"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd/options"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/util/process"
+	"io"
+	genericapiserver "k8s.io/apiserver/pkg/server"
+	cliflag "k8s.io/component-base/cli/flag"
+	"os"
+	"runtime"
+	"strconv"
+
+	"github.com/sirupsen/logrus"
+)
+
+// RunFreshSetupService composes the actual fresh owner into the EXISTING
+// upstream serving process. No child, second manager or callback can provide
+// its authority. This component is not registered in CLI dispatch yet: actual
+// engine observation/fresh publication/recovery and observer handoff remain
+// required before enabling the product setup route. Serving management alone
+// is not setup success or an engine-ready observation.
+func RunFreshSetupService(startup context.Context) (result error) {
+	return runFreshSetupService(startup, nil)
+}
+
+func RunFreshSetupOperation(ctx context.Context, input io.Reader, output io.Writer) (result error) {
+	defer func() { runtime.KeepAlive(output) }()
+	if ctx == nil || ctx.Err() != nil || input == nil || output == nil {
+		return errPrivateAuthority
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return errPrivateAuthority
+	}
+	startup, cancel := context.WithCancel(ctx)
+	defer cancel()
+	observer := newFreshSetupObserver(startup, cancel, output)
+	defer func() {
+		if observer.finish() != nil && result == nil {
+			result = errPrivateAuthority
+		}
+	}()
+	first := make(chan error, 1)
+	go func() {
+		defer func() {
+			if recover() != nil {
+				select {
+				case first <- errPrivateAuthority:
+				default:
+				}
+				observer.disconnect()
+			}
+		}()
+		e := readFreshSetupFrame(input, "setup")
+		first <- e
+		if e != nil {
+			return
+		}
+		command, e := readFreshSetupCommand(input)
+		if e != nil || command.operation != "continue-original-setup" || !observer.claimContinuation(command.nonce) {
+			observer.disconnect()
+		}
+	}()
+	select {
+	case e := <-first:
+		if e != nil {
+			return errPrivateAuthority
+		}
+	case <-startup.Done():
+		return errPrivateAuthority
+	}
+	if enforceFreshProtocolLogging() != nil {
+		return errPrivateAuthority
+	}
+	if prepareFreshProtocolStdout(startup, output) != nil {
+		return errPrivateAuthority
+	}
+	if redirectFreshProcessOutput(startup, output) != nil {
+		return errPrivateAuthority
+	}
+	return runFreshSetupService(startup, observer)
+}
+
+func runFreshSetupService(startup context.Context, observer *freshSetupObserver) (result error) {
+	stage := freshStageCapture
+	defer func() {
+		if result != nil {
+			var failure freshSetupFailure
+			if !errors.As(result, &failure) {
+				failure = freshSetupFailure{stage: stage}
+			}
+			result = failure
+			logrus.WithField("stage", failure.stage.String()).Error("private setup failed")
+		}
+	}()
+	owner, e := managementconfig.CaptureSelectedFreshSetupOwner(startup)
+	if owner != nil {
+		defer func() {
+			if owner.Close() != nil {
+				result = freshSetupFailure{stage: freshStageSettlement}
+			}
+		}()
+	}
+	if e != nil {
+		return errPrivateAuthority
+	}
+	stage = freshStageDenial
+	if owner.PrepareLegacyStartDenial(startup) != nil {
+		return errPrivateAuthority
+	}
+	// No Cobra/options constructor (which may briefly bind a port) runs before
+	// the real native selection, SAME storage and durable fresh intent.
+	stage = freshStageEnvironment
+	if owner.ProjectUpstreamEnvironment(startup) != nil {
+		return errPrivateAuthority
+	}
+	home, e := os.UserHomeDir()
+	if e != nil || owner.VerifyUpstreamDirectories(startup, instance.Suffix(), home, instance.Dir(), instance.LimaHome(), instance.BinDir()) != nil {
+		return errPrivateAuthority
+	}
+	// Actual upstream command publication follows durable fence +D07b HOME,
+	// with independently pinned source custody retained by SAME actual owner.
+	stage = freshStageBinlinks
+	if binlinks.LinkFreshBundledBinaries(startup, owner) != nil {
+		return errPrivateAuthority
+	}
+	stage = freshStageAuthority
+	s := options.NewOptions(startup, instance.Dir())
+	// Upstream AddFlags initializes real option defaults (including controller
+	// defaults). Do this only after the durable fence, then apply fixed product
+	// choices; no inherited CLI/environment controller selector is accepted.
+	var namedFlags cliflag.NamedFlagSets
+	s.AddFlags(&namedFlags)
+	port := 6443 + instance.Index()
+	s.ControlPlane.SecureServing.BindPort = port
+	s.Controllers.Controllers = "*,-path-management"
+	args, e := json.Marshal([]string{"--secure-port", strconv.Itoa(port), "--controllers", "*,-path-management"})
+	if e != nil {
+		return errPrivateAuthority
+	}
+	c, e := owner.OpenSelectedSetupServiceAuthority(startup, args)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	image, e := owner.ServingImageForAuthority(startup, c)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	w, e := preparePrivateAuthorityCreated(startup, s, c)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	w.freshOwner = owner
+	w.freshStartup = startup
+	w.freshObserver = observer
+	defer func() {
+		if w.Close() != nil {
+			result = freshSetupFailure{stage: freshStageSettlement}
+		} else {
+			result = confirmFreshPendingAfterClose(w, result)
+		}
+	}()
+	if w.AdoptImage(image) != nil || startup.Err() != nil {
+		return errPrivateAuthority
+	}
+	// The fixed service lifetime is upstream's signal/owned interrupt scope.
+	// The bounded caller context governs acquisition only; it is not a UI
+	// lifetime context capable of killing the admitted serving process.
+	stage = freshStageLifecycle
+	lifetime, cancel := context.WithCancel(genericapiserver.SetupSignalContext())
+	defer cancel()
+	release, e := process.RegisterInterruptHandler(process.ServeInterruptKey, cancel)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	defer release()
+	if owner.WriteServingPID(startup, c) != nil || startup.Err() != nil {
