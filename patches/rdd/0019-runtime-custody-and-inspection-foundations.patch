diff --git a/rdd/pkg/managementconfig/runtime_fresh_seed_windows.go b/rdd/pkg/managementconfig/runtime_fresh_seed_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..381e4590fd739539ad1604e344a1cc50f3bb0f9f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_seed_windows.go
@@ -0,0 +1,240 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"strings"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual original owner graph, never a parsed-name capability or second closer.
+type nativeFreshSeedCapture struct {
+	self          *nativeFreshSeedCapture
+	owner         *FreshSetupOwner
+	name          runtimeFreshSeedName
+	object        *runtimeStorageObject
+	canonical     *runtimeStorageObject // DELETE-capable inherited intent prefix only
+	canonicalBody []byte
+}
+
+func runtimeFreshSeedObjectFact(object *runtimeStorageObject, binding string) runtimeFreshSeedFact {
+	w := runtimeStorageFileData(object, nil)
+	return runtimeFreshSeedFact{Object: w.Object, Descriptor: w.Descriptor, Written: w.Written, Binding: binding}
+}
+func (n *nativeRuntimeStorage) freshSeedBindingLocked() string {
+	if n == nil || len(n.ancestry) == 0 || n.parent == nil || n.controller == nil {
+		return ""
+	}
+	p := n.ancestry[len(n.ancestry)-1]
+	return runtimeFreshSeedBinding(runtimeStorageObjectData(p), runtimeStorageObjectData(n.parent), runtimeStorageObjectData(n.controller), p.identity.descriptor, n.parent.identity.descriptor, n.controller.identity.descriptor)
+}
+func (n *nativeRuntimeStorage) checkSeedNamespaceLocked(ctx context.Context, expected string) error {
+	if n == nil || len(n.ancestry) == 0 || !freshBoundedContext(ctx) || !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil {
+		return ErrUpgrade
+	}
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil || len(names) > 512 {
+		return ErrUpgrade
+	}
+	allowed := map[string]bool{}
+	if expected != "" {
+		allowed[expected] = true
+		for ordinal := uint32(0); ordinal < runtimeFreshIntentRepairSlots; ordinal++ {
+			r, _ := runtimeFreshIntentRepairName(ordinal)
+			a, _ := runtimeFreshIntentArchiveName(ordinal)
+			allowed[r], allowed[a] = true, true
+		}
+	}
+	for _, name := range names {
+		lower := strings.ToLower(name)
+		if (strings.HasPrefix(lower, "authority.fresh.seed") || strings.HasPrefix(lower, "authority.fresh.intent-")) && !allowed[name] {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+func (s *nativeFreshSeedCapture) knownLocked(ctx context.Context) bool {
+	if s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.seed != s || s.owner.storage == nil || s.object == nil || !freshBoundedContext(ctx) {
+		return false
+	}
+	o, n := s.owner, s.owner.storage
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	owned := false
+	for _, slot := range n.resources {
+		if slot != nil && slot == s.object.resource && !slot.attempted && slot.handle != 0 {
+			owned = true
+			break
+		}
+	}
+	return registered && owned && !o.closed && !o.unknown && runtimeMappedSelfStorageKnownLocked(n) && n.check() == nil && n.checkObject(s.object) == nil && s.object.identity.size == 0 && s.name.Binding == n.freshSeedBindingLocked()
+}
+func (s *nativeFreshSeedCapture) checkLocked(ctx context.Context) error {
+	if !s.knownLocked(ctx) {
+		return ErrUpgrade
+	}
+	o, n := s.owner, s.owner.storage
+	name, e := s.name.name()
+	if e != nil || o.intent.Schema != 2 || o.intent.Transaction != s.name.Transaction || o.intent.Image != s.name.Image || o.intent.Commit != s.name.Commit || o.intent.Seed != runtimeFreshSeedObjectFact(s.object, s.name.Binding) || n.checkSeedNamespaceLocked(ctx, name) != nil {
+		return ErrUpgrade
+	}
+	actual, e := n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	same := actual.identity == s.object.identity
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(actual.resource) != nil || !same {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Both real initial constructors share this source-bound seed producer. A
+// nonce is generated once, never rerolled after any seed CREATE attempt.
+func (o *FreshSetupOwner) captureInitialSeed(ctx context.Context) error {
+	if o == nil || o.self != o || o.storage == nil || o.seed != nil || o.checkFreshAbsence(ctx) != nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	var e error
+	o.image, e = HoldServingImage(ctx, n.root.home, "orbwin")
+	if e != nil {
+		return ErrUpgrade
+	}
+	var nonce [16]byte
+	if _, e = rand.Read(nonce[:]); e != nil {
+		return ErrUpgrade
+	}
+	o.intent.Transaction = hex.EncodeToString(nonce[:])
+	o.origin, e = captureRuntimeMappedSelfOrigin(ctx, n, o.image, o.intent.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	commit, e := o.origin.mappedSourceCommit(ctx, o.intent.Transaction)
+	if e != nil {
+		return ErrUpgrade
+	}
+	image := o.image.Image()
+	o.intent.Schema = 2
+	o.intent.Image = hex.EncodeToString(image.Hash[:])
+	o.intent.Commit = commit
+	if o.checkFreshAbsence(ctx) != nil {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !o.nativeOutputsAdmittedLocked() || n.checkPrevious() != nil || n.checkSeedNamespaceLocked(ctx, "") != nil {
+		return ErrUpgrade
+	}
+	private := runtimeStorageObjectData(n.ancestry[len(n.ancestry)-1])
+	public := runtimeStorageObjectData(n.parent)
+	o.intent.PrivateParent = [3]uint32{private.Volume, private.High, private.Low}
+	o.intent.PublicParent = [3]uint32{public.Volume, public.High, public.Low}
+	s := &nativeFreshSeedCapture{owner: o, name: runtimeFreshSeedName{o.intent.Transaction, o.intent.Image, o.intent.Commit, n.freshSeedBindingLocked()}}
+	s.self = s
+	o.seed = s
+	name, e := s.name.name()
+	if e != nil {
+		return ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	creator, e := o.openFixed(n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, sd)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if windows.FlushFileBuffers(creator.handle) != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(creator.handle, n.sid, false, true, false)
+	if e != nil || id.size != 0 {
+		return ErrUpgrade
+	}
+	if n.closeTemporary(creator) != nil {
+		return ErrUpgrade
+	}
+	object, e := n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || !runtimeStorageCreatedSame(object.identity, id) || object.identity.size != 0 {
+		return ErrUpgrade
+	}
+	s.object = object
+	o.intent.Seed = runtimeFreshSeedObjectFact(object, s.name.Binding)
+	if s.checkLocked(ctx) != nil || o.flushFreshSeedParentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Fixed same private parent, measured again; no caller path or broad parent
+// grant. A failed/unsupported directory persistence barrier forbids effects.
+func (o *FreshSetupOwner) flushFreshSeedParentLocked(ctx context.Context) error {
+	n := o.storage
+	if o.seed == nil || !o.seed.knownLocked(ctx) || len(n.ancestry) < 2 {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	writer, e := n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-2].resource.handle, ".orbwin-private", true, windows.GENERIC_WRITE|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil || writer.identity != parent.identity || windows.FlushFileBuffers(writer.resource.handle) != nil {
+		return ErrUpgrade
+	}
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(writer.resource) != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// A FILE_OPEN inherited seed may precede its old creator's persistence
+// barrier. Re-establish seed + parent ordering BEFORE dependent CREATE/rename.
+// Original owner/n/thread stay held. No seed body write, truncate, CREATE or
+// fact update is permitted; even a changed finalized write time refuses.
+func (s *nativeFreshSeedCapture) reestablishPersistenceLocked(ctx context.Context) (failure error) {
+	if !s.knownLocked(ctx) || s.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	o, n := s.owner, s.owner.storage
+	expected := s.object.identity
+	name, e := s.name.name()
+	if e != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			failure = ErrUpgrade
+		}
+		if failure != nil {
+			o.unknown = true
+			n.fence()
+		}
+	}()
+	// The exact immutable read lease must close once before a WRITE reopen.
+	if n.closeTemporary(s.object.resource) != nil {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	writer, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || writer.identity != expected || writer.identity.size != 0 {
+		return ErrUpgrade
+	}
+	if windows.FlushFileBuffers(writer.resource.handle) != nil || n.checkObject(writer) != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(writer.resource) != nil {
+		return ErrUpgrade
+	}
+	immutable, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || immutable.identity != expected || immutable.identity.size != 0 {
+		return ErrUpgrade
+	}
+	s.object = immutable
+	if s.checkLocked(ctx) != nil || o.flushFreshSeedParentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_seed_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_seed_windows_test.go
