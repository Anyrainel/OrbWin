+		if runtimeStorageClassifyTokenOpen(0, 0, code, true) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("pending/uncertain became absence", code)
+		}
+	}
+	if runtimeStorageClassifyTokenOpen(0, 0, 1008, false) != runtimeStorageNativeOpenUnknown {
+		t.Fatal("uncertain error became absence")
+	}
+}
+func TestRuntimeStorageWin32FaultsKeepUnboundOriginal(t *testing.T) {
