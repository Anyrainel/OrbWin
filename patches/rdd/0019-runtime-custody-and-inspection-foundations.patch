diff --git a/rdd/pkg/managementconfig/upgrade_sdk_image_output.go b/rdd/pkg/managementconfig/upgrade_sdk_image_output.go
new file mode 100644
index 0000000000000000000000000000000000000000..463136818f2abc8f3d64ea2bdb8fd96bcaa218bf
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_image_output.go
@@ -0,0 +1,59 @@
+package managementconfig
+
+import "sync/atomic"
+
+const upgradeSDKImageOwnerLimit = 16
+const (
+	sdkImageCapturing uint32 = iota
+	sdkImageLive
+	sdkImageUnknown
+	sdkImageClosed
+	sdkImageClosing
+)
+
+// Parent lists are protected by parent mutexes. Native child errors/close
+// report atomic state without taking a parent lock in reverse order.
+type upgradeSDKImageBorrowState struct{ value atomic.Uint32 }
+
+func (s *upgradeSDKImageBorrowState) admit() bool {
+	return s != nil && s.value.CompareAndSwap(sdkImageCapturing, sdkImageLive)
+}
+func (s *upgradeSDKImageBorrowState) fail() {
+	if s != nil {
+		s.value.Store(sdkImageUnknown)
+	}
+}
+func (s *upgradeSDKImageBorrowState) beginClose() bool {
+	return s != nil && s.value.CompareAndSwap(sdkImageLive, sdkImageClosing)
+}
+func (s *upgradeSDKImageBorrowState) closeKnown() bool {
+	return s != nil && s.value.CompareAndSwap(sdkImageClosing, sdkImageClosed)
+}
+func (s *upgradeSDKImageBorrowState) noEffect() bool {
+	return s != nil && s.value.CompareAndSwap(sdkImageCapturing, sdkImageClosed)
+}
+func (s *upgradeSDKImageBorrowState) readable() bool {
+	return s != nil && s.value.Load() == sdkImageLive
+}
+func (s *upgradeSDKImageBorrowState) parentKnown() bool {
+	if s == nil {
+		return false
+	}
+	v := s.value.Load()
+	return v == sdkImageLive || v == sdkImageClosed
+}
+func sdkImageReleaseState(s *runtimeStorageNativeOpenState) bool {
+	return s != nil && !s.unknown && (!s.entered || s.returned && (!s.admitted || s.attached))
+}
+
+// Go lifetime quota only: does not look up or authorize a native image.
+func sdkRememberOwner[T comparable](m map[T]struct{}, o T) bool {
+	if _, ok := m[o]; ok {
+		return true
+	}
+	if len(m) >= upgradeSDKImageOwnerLimit {
+		return false
+	}
+	m[o] = struct{}{}
+	return true
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_image_output_test.go b/rdd/pkg/managementconfig/upgrade_sdk_image_output_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9cca561311d2b7510178a0dff120a040e91648d4
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_image_output_test.go
@@ -0,0 +1,67 @@
+package managementconfig
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestSDKImageBorrowBlocksParentUntilKnownClosure(t *testing.T) {
+	b := &upgradeSDKImageBorrowState{}
+	if b.parentKnown() || b.readable() || b.beginClose() || b.closeKnown() {
+		t.Fatal("unreturned output usable")
+	}
+	if !b.admit() || b.admit() || !b.readable() || !b.parentKnown() {
+		t.Fatal("known attachment")
+	}
+	if !b.beginClose() || b.readable() || b.parentKnown() || b.beginClose() {
+		t.Fatal("close entered twice or invisible to parent")
+	}
+	if !b.closeKnown() || b.readable() || !b.parentKnown() || b.closeKnown() {
+		t.Fatal("known close completion")
+	}
+	unknown := &upgradeSDKImageBorrowState{}
+	unknown.fail()
+	if unknown.noEffect() || unknown.admit() || unknown.closeKnown() || unknown.parentKnown() {
+		t.Fatal("unknown recovered from DATA")
+	}
+	empty := &upgradeSDKImageBorrowState{}
+	if !empty.noEffect() || !empty.parentKnown() || empty.readable() || empty.admit() {
+		t.Fatal("no-effect refusal became image")
+	}
+}
+func TestSDKImageUnknownWinsConcurrentAttachmentAndClose(t *testing.T) {
+	for i := 0; i < 64; i++ {
+		b := &upgradeSDKImageBorrowState{}
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() { defer wg.Done(); b.admit(); b.beginClose(); b.closeKnown() }()
+		go func() { defer wg.Done(); b.fail() }()
+		wg.Wait()
+		if b.value.Load() != sdkImageUnknown || b.readable() || b.parentKnown() {
+			t.Fatal("unknown overwritten")
+		}
+	}
+}
+func TestSDKImagePendingFramesCannotReleaseAncestors(t *testing.T) {
+	for _, s := range []*runtimeStorageNativeOpenState{nil, {entered: true}, {entered: true, returned: true, unknown: true}, {entered: true, returned: true, admitted: true}, {unknown: true}} {
+		if sdkImageReleaseState(s) {
+			t.Fatal("unresolved original output released", s)
+		}
+	}
+	for _, s := range []*runtimeStorageNativeOpenState{{}, {entered: true, returned: true}, {entered: true, returned: true, admitted: true, attached: true}} {
+		if !sdkImageReleaseState(s) {
+			t.Fatal("known no-effect/completion refused", s)
+		}
+	}
+}
+func TestSDKImageOwnerLifetimeQuotaIsBoundedAndIdempotent(t *testing.T) {
+	owners := map[int]struct{}{}
+	for i := 0; i < upgradeSDKImageOwnerLimit; i++ {
+		if !sdkRememberOwner(owners, i) {
+			t.Fatal("finite quota", i)
+		}
+	}
+	if sdkRememberOwner(owners, upgradeSDKImageOwnerLimit) || len(owners) != upgradeSDKImageOwnerLimit || !sdkRememberOwner(owners, 0) {
+		t.Fatal("overflow or duplicate original")
+	}
+}
