+	n := w.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !freshBoundedContext(ctx) || !w.owner.nativeOutputsAdmittedLocked() || n.checkToken() != nil {
+		return ErrUpgrade
+	}
+	if w.peerProcess == nil {
+		r := n.keep(0)
+		w.resources = append(w.resources, r)
+		var e error
+		r.handle, e = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+		if e = w.owner.fileOutputLocked(r, e); e != nil {
+			if !n.unknown {
+				w.resources = w.resources[:len(w.resources)-1]
+			}
+			return ErrUpgrade
+		}
+		w.peerProcess = r
+		t := n.keep(0)
+		w.resources = append(w.resources, t)
+		e = windows.OpenProcessToken(r.handle, windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&t.handle)))
+		if e = w.owner.fileOutputLocked(t, e); e != nil {
+			if !n.unknown {
+				w.resources = w.resources[:len(w.resources)-1]
+			}
+			return ErrUpgrade
+		}
+		w.peerToken = t
+		if w.peerBinding.capture(r.handle, w.owner.origin.image.handle) != nil {
+			return ErrUpgrade
+		}
+	}
+	return w.checkPipePeerNativeLocked(ctx)
+}
+
+// Caller holds storage.mu in addition to the observation/owner locks.
+func (w *FreshRuntimeObservation) checkPipePeerNativeLocked(ctx context.Context) error {
+	if w.peerProcess == nil || w.peerToken == nil {
+		return ErrUpgrade
+	}
+	pid, e := windows.GetProcessId(w.peerProcess.handle)
+	var created, exit, kernel, user windows.Filetime
+	var session uint32
+	state, waitErr := windows.WaitForSingleObject(w.peerProcess.handle, 0)
+	if e != nil || pid != w.api.HostPID || windows.GetProcessTimes(w.peerProcess.handle, &created, &exit, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != w.api.HostCreation || windows.ProcessIdToSessionId(pid, &session) != nil || session != w.api.HostSession || waitErr != nil || state != uint32(windows.WAIT_TIMEOUT) || legacySDKOrdinaryToken(windows.Token(w.peerToken.handle), w.owner.storage.sid, session) != nil || w.peerBinding.same() != nil {
+		return ErrUpgrade
+	}
+	// Retained token properties are insufficient if the process replaced its
+	// primary token. Capture/close a fresh actual attachment before success.
+	n := w.owner.storage
+	if !freshBoundedContext(ctx) || !w.owner.nativeOutputsAdmittedLocked() {
+		return ErrUpgrade
+	}
+	r := n.keep(0)
+	w.resources = append(w.resources, r)
+	e = windows.OpenProcessToken(w.peerProcess.handle, windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&r.handle)))
+	if e = w.owner.fileOutputLocked(r, e); e != nil {
+		if !n.unknown {
+			w.resources = w.resources[:len(w.resources)-1]
+		}
+		return ErrUpgrade
+	}
+	held, heldErr := legacySDKTokenID(windows.Token(w.peerToken.handle))
+	current, currentErr := legacySDKTokenID(windows.Token(r.handle))
+	closeErr := n.closeTemporary(r)
+	if heldErr != nil || currentErr != nil || held != current || closeErr != nil {
+		return ErrUpgrade
+	}
+	state, e = windows.WaitForSingleObject(w.peerProcess.handle, 0)
+	if e != nil || state != uint32(windows.WAIT_TIMEOUT) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+type freshDockerTransport struct{ w *FreshRuntimeObservation }
+
+func (t freshDockerTransport) RoundTrip(request *http.Request) (response *http.Response, failure error) {
+	w := t.w
+	if w == nil || w.syncTransportUnknownLocked() || !freshRuntimeDockerRead(request.Method, request.URL.Path) || !freshBoundedContext(request.Context()) || w.unknown || len(w.connections) >= 4096 {
+		return nil, ErrUpgrade
+	}
+	r := &freshObservationConnection{}
+	w.connections = append(w.connections, r)
+	handedOff := false
+	defer func() {
+		panicked := recover() != nil
+		if !handedOff || panicked {
+			if w.settleTransportLocked(r, panicked) != nil || panicked {
+				response = nil
+				failure = ErrUpgrade
+			}
+		}
+	}()
+	returned, e := winio.DialPipeAccessImpLevel(request.Context(), freshDockerPipe, windows.GENERIC_READ|windows.GENERIC_WRITE, winio.PipeImpLevelIdentification)
+	if w.retainTransportDialLocked(r, returned, e) != nil {
+		return nil, ErrUpgrade
+	}
+	fail := func() (*http.Response, error) { return nil, ErrUpgrade }
+	if r.prepareIO(request.Context()) != nil || w.capturePipePeerLocked(request.Context(), r.conn) != nil {
+		return fail()
+	}
+	copy := request.Clone(request.Context())
+	copy.Close = true
+	if copy.Write(r.guard) != nil {
+		return fail()
+	}
+	response, e = http.ReadResponse(bufio.NewReader(io.LimitReader(r.guard, freshRuntimeResponseBudget+(64<<10))), copy)
+	if e != nil {
+		return fail()
+	}
+	response.Body = &freshDockerBody{reader: io.LimitReader(response.Body, freshRuntimeResponseBudget+1), connection: r, w: w}
+	handedOff = true
+	return response, nil
+}
+
+type freshDockerBody struct {
+	reader     io.Reader
+	connection *freshObservationConnection
+	w          *FreshRuntimeObservation
+	read       int
+}
+
+func (b *freshDockerBody) Read(out []byte) (count int, failure error) {
+	defer func() {
+		if recover() != nil {
+			_ = b.w.settleTransportLocked(b.connection, true)
+			count = 0
+			failure = ErrUpgrade
+		}
+	}()
+	n, e := b.reader.Read(out)
+	b.read += n
+	if b.read > freshRuntimeResponseBudget {
+		return 0, ErrUpgrade
+	}
+	return n, e
+}
+func (b *freshDockerBody) Close() error {
+	return b.w.settleTransportLocked(b.connection, false)
+}
+
+func (w *FreshRuntimeObservation) reobserveLocked(ctx context.Context) error {
+	if w.checkParentsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	n := w.owner.storage
+	n.mu.Lock()
+	if n.checkObject(w.config) != nil || n.checkObject(w.args) != nil {
+		n.mu.Unlock()
+		return ErrUpgrade
+	}
+	n.mu.Unlock()
+	api, e := w.readAPILocked(ctx)
+	if e != nil || !w.api.sameIdentity(api) {
+		return ErrUpgrade
+	}
+	if w.observeRegistrationLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	info, e := w.docker.Info(ctx, mobyclient.InfoOptions{})
+	if e != nil || !freshRuntimeDaemon(info.Info.ID, info.Info.OSType) || info.Info.ID != w.daemon {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	runtime.LockOSThread()
+	peerErr := w.checkPipePeerNativeLocked(ctx)
+	runtime.UnlockOSThread()
+	n.mu.Unlock()
+	if peerErr != nil {
+		return ErrUpgrade
+	}
+	again, e := w.readAPILocked(ctx)
+	if e != nil || !api.sameIdentity(again) || w.checkParentsLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Caller holds ONLY owner.mu; this method acquires/releases witness/publisher
+// locks. Concrete callers recheck immediately around their real native effect.
+func (w *FreshRuntimeObservation) checkHeld(ctx context.Context, o *FreshSetupOwner, c *Created, p *ConfigPublisher) (failure error) {
+	if w == nil || w.self != w || !w.exactLocked(o, c, p) {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !w.complete || w.digest == [32]byte{} {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			w.fenceLocked()
+			failure = ErrUpgrade
+		}
+		if failure != nil {
+			w.fenceLocked()
+		}
+	}()
+	return w.reobserveLocked(ctx)
+}
+
+func (w *FreshRuntimeObservation) runtimeIdentityHeld(ctx context.Context, o *FreshSetupOwner, c *Created, p *ConfigPublisher) (runtimeIdentityRecord, error) {
+	if w.checkHeld(ctx, o, c, p) != nil {
+		return runtimeIdentityRecord{}, ErrUpgrade
+	}
+	// The linked source/image are immutable captured native provenance. This
+	// compatibility record is DATA; the publisher retains all separate grants.
+	r := runtimeIdentityRecord{Endpoint: runtimeIdentityEndpoint, Home: o.storage.home, Daemon: w.daemon, SourceCommit: o.origin.commit, BinarySHA: o.intent.Image, Verified: true}
+	if !r.valid(o.storage.home) {
+		return runtimeIdentityRecord{}, ErrUpgrade
+	}
+	return r, nil
+}
+
+func closeFreshRuntimeObservationLocked(o *FreshSetupOwner) error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	if o.observation == nil {
+		return nil
+	}
+	return o.observation.closeHeld(o)
+}
+func (w *FreshRuntimeObservation) Close() error {
+	if w == nil {
+		return nil
+	}
+	if w.self != w || w.owner == nil {
+		return ErrUpgrade
+	}
+	w.owner.mu.Lock()
+	defer w.owner.mu.Unlock()
+	return w.closeHeld(w.owner)
+}
+func (w *FreshRuntimeObservation) closeHeld(o *FreshSetupOwner) error {
+	if w == nil || w.self != w || o == nil || o.self != o || w.owner != o || o.observation != w || w.created == nil || w.publisher == nil || o.created != w.created {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closeAttempt.attempted {
+		return w.closeAttempt.closeErr
+	}
+	if !w.exactLocked(o, w.created, w.publisher) {
+		return ErrUpgrade
+	}
+	defer func() { clear(w.credentials.admin); clear(w.credentials.user); clear(w.credentials.ca) }()
+	n := o.storage
+	if n == nil || n.captureSelf != n || o.image == nil || o.origin == nil || o.unknown || w.unknown {
+		return ErrUpgrade
+	}
+	w.publisher.mu.Lock()
+	publisherUnknown := w.publisher.closeErr != nil || w.publisher.pending != nil
+	w.publisher.mu.Unlock()
+	if publisherUnknown {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	runtimeStorageDomain.Lock()
+	bad := n.unknown || n.closeErr != nil || runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	n.mu.Unlock()
+	o.image.mu.Lock()
+	bad = bad || o.image.err != nil
+	o.image.mu.Unlock()
+	w.created.mu.Lock()
+	bad = bad || w.created.closeErr != nil
+	w.created.mu.Unlock()
+	if bad {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	return w.closeAttempt.run(func() error {
+		for i := len(w.connections) - 1; i >= 0; i-- {
+			r := w.connections[i]
+			if r.conn != nil && w.settleTransportLocked(r, false) != nil {
+				return ErrUpgrade
+			}
+		}
+		if w.docker != nil && w.docker.Close() != nil {
+			return ErrUpgrade
+		}
+		for i := len(w.keys) - 1; i >= 0; i-- {
+			r := w.keys[i]
+			if r.run(func() error {
+				if windows.RegCloseKey(r.handle) != nil {
+					return ErrUpgrade
+				}
+				r.handle = 0
+				return nil
+			}, w.fenceLocked) != nil {
+				return ErrUpgrade
+			}
+		}
+		for i := len(w.resources) - 1; i >= 0; i-- {
+			r := w.resources[i]
+			if r.run(func() error {
+				if r.handle == 0 || windows.CloseHandle(r.handle) != nil {
+					return ErrUpgrade
+				}
+				r.handle = 0
+				return nil
+			}, w.fenceLocked) != nil {
+				return ErrUpgrade
+			}
+		}
+		w.closed = true
+		return nil
+	}, w.fenceLocked)
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_observation_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_observation_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f81218a0cc52b577b73f4c89c692dbec28bc732
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_observation_windows_test.go
@@ -0,0 +1,120 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshObservationRefusesForgedOwnerBeforeProviderEligibility(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, o := range []*FreshSetupOwner{nil, {}, {captureComplete: true}} {
+		if w, e := o.ObserveFreshRuntime(ctx, &Created{}, &ConfigPublisher{}); e == nil || w != nil {
+			t.Fatal("unissued owner reached actual observation")
+		}
+	}
+	o := &FreshSetupOwner{}
+	o.self = o
+	freshTestRegister(t, o)
+	if w, e := o.ObserveFreshRuntime(context.Background(), &Created{}, &ConfigPublisher{}); e == nil || w != nil {
+		t.Fatal("unbounded call admitted")
+	}
+	w := &FreshRuntimeObservation{owner: o, created: &Created{}, publisher: &ConfigPublisher{}}
+	w.self = w
+	o.observation = w
+	copy := new(FreshRuntimeObservation)
+	reflect.ValueOf(copy).Elem().Set(reflect.ValueOf(w).Elem()) // Inert only; no actual native handles.
+	if copy.Close() == nil || copy.checkHeld(ctx, o, w.created, w.publisher) == nil {
+		t.Fatal("copied witness gained close/query admission")
+	}
+	if w.checkHeld(ctx, o, w.created, w.publisher) == nil {
+		t.Fatal("incomplete witness queried provider")
+	}
+}
+
+func TestRuntimeFreshObservationPartialCloseRefusesUnknownBeforeNativeSuffix(t *testing.T) {
+	o := &FreshSetupOwner{unknown: true}
+	o.self = o
+	freshTestRegister(t, o)
+	c := &Created{}
+	p := &ConfigPublisher{}
+	o.created = c
+	w := &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+	w.self = w
+	o.observation = w
+	if w.Close() == nil || w.closeAttempt.attempted {
+		t.Fatal("borrowed unknown entered own native cleanup")
+	}
+}
+
+// These fixtures contain no handles, connections or clients. Even a regression
+// can only enter the empty cleanup suffix; it cannot execute a native query.
+func TestRuntimeFreshObservationBorrowedFailurePrecedesOwnCleanup(t *testing.T) {
+	for _, name := range []string{"publisher", "created", "image", "storage"} {
+		t.Run(name, func(t *testing.T) {
+			n := &nativeRuntimeStorage{}
+			n.captureSelf = n
+			runtimeStorageDomain.Lock()
+			previousFailure := runtimeStorageDomain.failed
+			runtimeStorageDomain.Unlock()
+			o := &FreshSetupOwner{storage: n, image: &ServingImageLease{}, origin: &nativeRuntimeBuildOrigin{}}
+			o.self = o
+			freshTestRegister(t, o)
+			c, p := &Created{}, &ConfigPublisher{}
+			o.created = c
+			w := &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+			w.self = w
+			o.observation = w
+			switch name {
+			case "publisher":
+				p.closeErr = ErrPublication
+			case "created":
+				c.closeErr = ErrCreate
+			case "image":
+				o.image.err = ErrUpgrade
+			case "storage":
+				n.closeErr = ErrUpgrade
+			}
+			if w.Close() == nil || w.closeAttempt.attempted {
+				t.Fatal("borrowed failure reached own cleanup")
+			}
+			// Fencing is intentionally process-wide; restore this synthetic owner
+			// only after asserting the actual close classifier, without providers.
+			runtimeStorageDomain.Lock()
+			delete(runtimeStorageDomain.owners, n)
+			runtimeStorageDomain.failed = previousFailure
+			runtimeStorageDomain.Unlock()
+		})
+	}
+}
+
+func TestRuntimeFreshObservationCachedCloseSurvivesParentRetirement(t *testing.T) {
+	n := &nativeRuntimeStorage{}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n, image: &ServingImageLease{}, origin: &nativeRuntimeBuildOrigin{}}
+	o.self = o
+	freshTestRegister(t, o)
+	c, p := &Created{}, &ConfigPublisher{}
+	o.created = c
+	w := &FreshRuntimeObservation{owner: o, created: c, publisher: p}
+	w.self = w
+	o.observation = w
+	if w.Close() != nil || !w.closed {
+		t.Fatal("empty retained witness did not close")
+	}
+	freshSetupOwners.Lock()
+	delete(freshSetupOwners.owners, o)
+	freshSetupOwners.Unlock()
+	if w.Close() != nil {
+		t.Fatal("actual positive cached close depended on retired registration")
+	}
+	copy := new(FreshRuntimeObservation)
+	reflect.ValueOf(copy).Elem().Set(reflect.ValueOf(w).Elem())
+	if copy.Close() == nil {
+		t.Fatal("copied positive cache was accepted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_ordinary_windows.go b/rdd/pkg/managementconfig/runtime_fresh_ordinary_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..1e238814046de109087bd7c224b1381714d6fa2a
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_ordinary_windows.go
@@ -0,0 +1,223 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+type freshOrdinaryObservation struct {
+	parents         *ParentLease
+	resources       []*runtimeStorageResource
+	unknown, closed bool
+	closeErr        error
+}
+
+var freshOrdinaryUnknown = struct {
+	sync.Mutex
+	owners map[*freshOrdinaryObservation]bool
+}{owners: make(map[*freshOrdinaryObservation]bool)}
+
+type freshOrdinaryRecords struct {
+	intent    runtimeFreshIntent
+	admission runtimeFreshAdmission
+	committed runtimeFreshCommitted
+}
+
+func (o *freshOrdinaryObservation) fence() { o.unknown = true }
+func (o *freshOrdinaryObservation) open(parent windows.Handle, name string, directory bool) (*runtimeStorageObject, error) {
+	if o.unknown || o.closed {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	r := &runtimeStorageResource{}
+	o.resources = append(o.resources, r)
+	access := uint32(windows.FILE_READ_DATA | windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		access = windows.FILE_LIST_DIRECTORY | windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, options, 0, 0)
+	e = runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, o.fence)
+	if e != nil {
+		if !o.unknown {
+			o.resources = o.resources[:len(o.resources)-1]
+		}
+		return nil, e
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, o.parents.sid, directory, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: r, identity: id, directory: directory, private: true}, nil
+}
+func (o *freshOrdinaryObservation) read(ctx context.Context, parent windows.Handle, name string) (*runtimeStorageObject, []byte, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	object, e := o.open(parent, name, false)
+	if e != nil {
+		return nil, nil, e
+	}
+	if object.identity.size > runtimeFreshRecordBudget {
+		return nil, nil, ErrUpgrade
+	}
+	b, e := authorityRead(object.resource.handle, runtimeFreshRecordBudget)
+	actual, identityErr := runtimeStorageIdentityOf(object.resource.handle, o.parents.sid, false, true, false)
+	if e != nil || identityErr != nil || actual != object.identity || uint64(len(b)) != actual.size || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	return object, b, nil
+}
+func (o *freshOrdinaryObservation) close() error {
+	if o.unknown {
+		return ErrUpgrade
+	}
+	if o.closed {
+		return o.closeErr
+	}
+	o.closed = true
+	o.closeErr = ErrUpgrade
+	for i := len(o.resources) - 1; i >= 0; i-- {
+		r := o.resources[i]
+		if r.run(func() error {
+			if windows.CloseHandle(r.handle) != nil {
+				return ErrUpgrade
+			}
+			r.handle = 0
+			return nil
+		}, o.fence) != nil {
+			return ErrUpgrade
+		}
+	}
+	o.closeErr = nil
+	freshOrdinaryUnknown.Lock()
+	delete(freshOrdinaryUnknown.owners, o)
+	freshOrdinaryUnknown.Unlock()
+	return nil
+}
+
+// All observations, including partial native outputs, are retained before the
+// first syscall. Decoding these records never issues an activation permit.
+func observeFreshOrdinary(ctx context.Context, parents *ParentLease) (o *freshOrdinaryObservation, records *freshOrdinaryRecords, result error) {
+	if ctx == nil || ctx.Err() != nil || parents == nil || parents.leaf() == 0 {
+		return nil, nil, ErrUpgrade
+	}
+	o = &freshOrdinaryObservation{parents: parents}
+	freshOrdinaryUnknown.Lock()
+	freshOrdinaryUnknown.owners[o] = true
+	freshOrdinaryUnknown.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			records = nil
+			result = ErrUpgrade
+		}
+	}()
+	intentObject, body, e := o.read(ctx, parents.leaf(), runtimeFreshFenceName)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return o, nil, nil
+	}
+	if e != nil {
+		return o, nil, ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(body)
+	if e != nil {
+		return o, nil, ErrUpgrade
+	}
+	private, e := runtimeStorageIdentityOf(parents.leaf(), parents.sid, true, true, false)
+	if e != nil || intent.PrivateParent != [3]uint32{private.volume, private.high, private.low} {
+		return o, nil, ErrUpgrade
+	}
+	admissionObject, ab, e := o.read(ctx, parents.leaf(), runtimeFreshAdmissionName)
+	if e != nil {
+		return o, nil, ErrUpgrade
+	}
+	var a runtimeFreshAdmission
+	if parseRuntimeFreshRecord(ab, &a) != nil || !a.valid() || a.Transaction != intent.Transaction || a.Parent != (UpgradeObject{intent.PublicParent[0], intent.PublicParent[1], intent.PublicParent[2]}) || a.Intent != runtimeStorageFileData(intentObject, body) || a.Runtime.BinarySHA != intent.Image || a.Runtime.SourceCommit != intent.Commit || a.Seed != intent.Seed {
+		return o, nil, ErrUpgrade
+	}
+	gap := false
+	for sequence := uint32(1); sequence <= runtimeFreshRecoveryLimit; sequence++ {
+		name, _ := runtimeFreshRecoveryRecordName(sequence)
+		object, b, readErr := o.read(ctx, parents.leaf(), name)
+		if readErr == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if readErr != nil || gap {
+			return o, nil, ErrUpgrade
+		}
+		var recovered runtimeFreshRecoveryAdmission
+		if parseRuntimeFreshRecord(b, &recovered) != nil || !recovered.matches(a, runtimeStorageFileData(admissionObject, ab), sequence) {
+			return o, nil, ErrUpgrade
+		}
+		a = recovered.Current
+		admissionObject, ab = object, b
+	}
+	_, cb, e := o.read(ctx, parents.leaf(), runtimeFreshCommittedName)
+	if e != nil {
+		return o, nil, ErrUpgrade
+	}
+	var c runtimeFreshCommitted
+	if parseRuntimeFreshRecord(cb, &c) != nil || !c.matches(a) || c.Admission != runtimeStorageFileData(admissionObject, ab) {
+		return o, nil, ErrUpgrade
+	}
+	anchor, e := o.open(parents.leaf(), anchorName, true)
+	if e != nil || runtimeStorageObjectData(anchor) != a.Authority {
+		return o, nil, ErrUpgrade
+	}
+	args, argsBody, e := o.read(ctx, anchor.resource.handle, "args.json")
+	if e != nil || runtimeStorageFileData(args, argsBody) != a.Args {
+		return o, nil, ErrUpgrade
+	}
+	init, initBody, e := o.read(ctx, anchor.resource.handle, "authority.init")
+	if e != nil || runtimeStorageFileData(init, initBody) != a.Initialization || validateInitialization(initBody, argsBody) != nil {
+		return o, nil, ErrUpgrade
+	}
+	return o, &freshOrdinaryRecords{intent, a, c}, nil
+}
+
+// Preflight is read-only; the actual startup callee separately acquires SAME
+// setup.lock through the existing exclusive service-lock handoff and recheck.
+func requireNoFreshIntent(parents *ParentLease) (result error, retain bool) {
+	var o *freshOrdinaryObservation
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+			retain = true
+			if o != nil {
+				o.fence()
+			}
+		}
+	}()
+	var e error
+	o, _, e = observeFreshOrdinary(context.Background(), parents)
+	if o == nil {
+		return ErrUpgrade, false
+	}
+	if o.unknown {
+		return ErrUpgrade, true
+	}
+	closeErr := o.close()
+	if closeErr != nil {
+		return ErrUpgrade, true
+	}
+	if e != nil {
+		return ErrUpgrade, false
+	}
+	return nil, false
+}
