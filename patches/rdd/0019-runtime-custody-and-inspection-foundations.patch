+++ b/rdd/pkg/managementconfig/upgrade_sdk_image_capture_model_test.go
@@ -0,0 +1,108 @@
+package managementconfig
+
+import "testing"
+
+func TestSDKImageProducerRoles(t *testing.T) {
+	parts := []string{"Users", "synthetic", ".orbwin-private", "runtime", "orbwin-session-fixed"}
+	rows, ok := sdkImageProducerRoles(`C:\`, parts, 2)
+	if !ok || len(rows) != 12 {
+		t.Fatalf("role count %d/%v", len(rows), ok)
+	}
+	if rows[0].parent != -1 || !rows[0].volume || !rows[0].directory || rows[0].private {
+		t.Fatal("volume role")
+	}
+	for n := range parts {
+		r := rows[n+1]
+		if r.name != parts[n] || r.parent != n || !r.directory || r.private != (n >= 2) {
+			t.Fatal("ancestor policy", n)
+		}
+	}
+	if rows[6].name != "orbwin-session.exe" || rows[6].parent != 5 || rows[6].directory || rows[7].name != "lan" || rows[7].parent != 5 || !rows[7].directory {
+		t.Fatal("bundle edges")
+	}
+	for n, name := range []string{"assets.json", "assets.sig", "orbwin-lan-helper.exe", "orbwin-lan-worker.exe"} {
+		r := rows[n+8]
+		if r.name != name || r.parent != 7 || r.directory || !r.private {
+			t.Fatal("leaf edge", n)
+		}
+	}
+	parts[0] = "changed"
+	if rows[1].name != "Users" {
+		t.Fatal("rows alias caller parts")
+	}
+}
+
+func TestSDKImageProducerRejectAmbiguousRoles(t *testing.T) {
+	for _, parts := range [][]string{nil, {"x", "y"}, {"x", "..", "z"}, {"x", "a/b", "z"}, {"x", "a\\b", "z"}, {"x", "a\x00b", "z"}} {
+		if _, ok := sdkImageProducerRoles(`C:\`, parts, 0); ok {
+			t.Fatal("accepted ambiguous role", parts)
+		}
+	}
+	if _, ok := sdkImageProducerRoles("", []string{"a", "b", "c"}, 0); ok {
+		t.Fatal("empty volume")
+	}
+	if _, ok := sdkImageProducerRoles(`C:\`, []string{"a", "b", "c"}, 1); ok {
+		t.Fatal("private suffix shortened")
+	}
+}
+
+func TestSDKImageProducerNativeCustodyFaults(t *testing.T) {
+	tests := []struct {
+		name            string
+		raw, iosb       uint32
+		information     uintptr
+		output, valid   bool
+		discard, usable bool
+	}{
+		{"known refusal", 0xc0000034, 0, 0, false, false, true, false},
+		{"pending zero", 0x103, 0, 0, false, false, false, false},
+		{"iosb pending zero", 0xc0000034, 0x103, 0, false, false, false, false},
+		{"error partial", 0xc0000022, 0, 0, true, true, false, false},
+		{"success no output", 0, 0, 1, false, false, false, false},
+		{"wrong disposition", 0, 0, 2, true, true, false, false},
+		{"success", 0, 0, 1, true, true, false, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := runtimeStorageNativeOpenState{entered: true}
+			kind := runtimeStorageClassifyNativeOpen(tt.raw, tt.iosb, tt.information, 1, tt.output, tt.valid)
+			s.reply(kind)
+			if sdkImageProducerDiscardable(&s) != tt.discard {
+				t.Fatal("tail release classification")
+			}
+			if s.admitted {
+				if !s.attach() {
+					t.Fatal("positive output not attached")
+				}
+			}
+			if s.usable() != tt.usable {
+				t.Fatal("output readability")
+			}
+			if s.reply(kind) || s.attach() {
