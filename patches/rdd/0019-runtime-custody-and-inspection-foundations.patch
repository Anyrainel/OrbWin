diff --git a/rdd/pkg/managementconfig/runtime_fresh_selection_windows.go b/rdd/pkg/managementconfig/runtime_fresh_selection_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ea9709f609a1c1892dc7a38f48a7fd65385424f0
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_selection_windows.go
@@ -0,0 +1,223 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+type nativeFreshSetupChoice struct {
+	self    *nativeFreshSetupChoice
+	owner   *FreshSetupOwner
+	resume  *nativeFreshRecoveryOwner
+	seed    *nativeFreshSeedCapture
+	initial bool // actual precise native absence, not a caller mode/grant
+}
+
+// Core invokes this after actual token/private-prefix capture and BEFORE any
+// public route/controller effect. It chooses exactly one native constructor;
+// unknown/malformed input never becomes initial setup or a retry fallback.
+func (s *nativeFreshSetupChoice) chooseNativeIntent(ctx context.Context) error {
+	if s == nil || s.self != s || s.owner == nil || s.owner.self != s.owner || s.owner.storage == nil {
+		return ErrUpgrade
+	}
+	o := s.owner
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || n.freshChoice != s || n.captureSelf != n || !n.captureStarted || n.captureComplete || n.closeAttempted || n.unknown || n.captureKind != runtimeStorageFreshCapture || len(n.ancestry) == 0 || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known {
+		return ErrUpgrade
+	}
+	if n.checkToken() != nil {
+		return ErrUpgrade
+	}
+	for _, object := range n.ancestry {
+		if n.checkObject(object) != nil {
+			return ErrUpgrade
+		}
+	}
+	if found, e := s.captureSeedChoiceLocked(ctx); e != nil {
+		return ErrUpgrade
+	} else if found {
+		return s.chooseSeededIntentLocked(ctx)
+	}
+	text, e := windows.NewNTUnicodeString(runtimeFreshFenceName)
+	if e != nil {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent.resource.handle, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	slot := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&slot.handle, windows.FILE_READ_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	reply := runtimeStorageOpenReply(e, slot.handle != 0 && slot.handle != windows.InvalidHandle, func() {}, n.fence)
+	if reply != nil {
+		if n.unknown {
+			return ErrUpgrade
+		}
+		n.resources = n.resources[:len(n.resources)-1]
+		if reply == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			s.initial = true
+			return nil
+		}
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(slot.handle, n.sid, false, true, false)
+	if e != nil || id.size == 0 || id.size > 1024 {
+		return ErrUpgrade
+	}
+	body, e := n.read(&runtimeStorageObject{resource: slot, identity: id, private: true}, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(body)
+	private := runtimeStorageObjectData(parent)
+	if e != nil || intent.PrivateParent != [3]uint32{private.Volume, private.High, private.Low} || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	r := &nativeFreshRecoveryOwner{owner: o}
+	r.self = r
+	nativeFreshRecoveries.Lock()
+	nativeFreshRecoveries.owners[r] = true
+	nativeFreshRecoveries.Unlock()
+	s.resume = r
+	n.freshRecovery = r
+	return nil
+}
+
+// CaptureSelectedFreshSetupOwner takes no mode/path/hash/PID. Initial versus
+// same-build interrupted capture is selected by actual protected native state
+// while ONE original selection/storage is held. SAME setup.lock is acquired
+// once and retained continuously through the chosen source recipe.
+func CaptureSelectedFreshSetupOwner(ctx context.Context) (o *FreshSetupOwner, failure error) {
+	if requireFreshPersistentProcess(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	o = &FreshSetupOwner{}
+	o.self = o
+	freshSetupOwners.Lock()
+	if len(freshSetupOwners.owners) >= 16 {
+		freshSetupOwners.Unlock()
+		return nil, ErrUpgrade
+	}
+	freshSetupOwners.owners[o] = true
+	freshSetupOwners.Unlock()
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			failure = ErrUpgrade
+		}
+	}()
+	var e error
+	o.selection, e = authoritypath.CaptureCurrentProduct(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	selection, e := o.selection.Selection(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	root := &InstanceRoot{home: selection.GuestHome(), sid: selection.Owner(), selection: selection}
+	o.storage, e = allocateNativeFreshRuntimeStorageCapture(ctx, root)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	s := &nativeFreshSetupChoice{owner: o}
+	s.self = s
+	o.storage.freshChoice = s
+	if o.storage.captureNativeFresh(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	if s.seed != nil && s.resume == nil {
+		if o.finishSelectedSeedCapture(ctx) != nil {
+			return o, ErrUpgrade
+		}
+		return o, nil
+	}
+	if s.resume != nil {
+		if s.resume.finishOwnerCapture(ctx) != nil {
+			return o, ErrUpgrade
+		}
+		return o, nil
+	}
+	if !s.initial || o.finishSelectedInitialCapture(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	return o, nil
+}
+
+// Original initial recipe after actual capture, shared functions and SAME
+// storage. No existing state or failed recovery is converted into initial.
+func (o *FreshSetupOwner) finishSelectedInitialCapture(ctx context.Context) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if o.storage.freshRecovery != nil || o.storage.freshChoice == nil || !o.storage.freshChoice.initial || o.checkFreshAbsence(ctx) != nil {
+		return ErrUpgrade
+	}
+	if o.captureInitialSeed(ctx) != nil {
+		return ErrUpgrade
+	}
+	if o.checkFreshAbsence(ctx) != nil || o.writeIntent(ctx) != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.captureComplete = true
+	return nil
+}
+
+// The service consumes only this actual native choice. Resume never rewrites
+// saved arguments/defaults or obtains another controller through OpenInitialized.
+func (o *FreshSetupOwner) OpenSelectedSetupServiceAuthority(ctx context.Context, args []byte) (*Created, error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	n := o.storage
+	if n == nil || o.closed || o.unknown {
+		o.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	if r != nil {
+		if !r.admitted(n) || !r.complete || (r.missingControl == nil && r.controlRetention == nil && r.tupleRecovery == nil && !bytes.Equal(args, r.argsBody)) {
+			o.mu.Unlock()
+			return nil, ErrUpgrade
+		}
+	}
+	o.mu.Unlock()
+	if r != nil {
+		if r.tupleRecovery != nil {
+			return o.openTupleRecoveryAuthority(ctx, args)
+		}
+		if r.controlRetention != nil {
+			return o.openControlRecoveryAuthority(ctx, args)
+		}
+		if r.missingControl != nil {
+			return o.createMissingControlAuthority(ctx, args)
+		}
+		return o.OpenRecoveryServiceAuthority(ctx)
+	}
+	return o.CreateServiceAuthority(ctx, args)
+}
