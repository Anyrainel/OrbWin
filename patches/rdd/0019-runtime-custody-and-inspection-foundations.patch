+	matches := 0
+	for _, row := range rows {
+		if row.family != family || row.state != 5 ||
+			!upgradeTCPRowEndpointMatches(row.address, row.scope, row.port, clientRemote) ||
+			!upgradeTCPRowEndpointMatches(row.remoteAddress, row.remoteScope, row.remotePort, clientLocal) {
+			continue
+		}
+		matches++
+		if matches != 1 || row.pid != pid {
+			return ErrUpgrade
+		}
+	}
+	if matches != 1 {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func upgradeTCPRowEndpointMatches(address [16]byte, scope uint32, port uint16, endpoint netip.AddrPort) bool {
+	if port != endpoint.Port() {
+		return false
+	}
+	addr := endpoint.Addr()
+	if addr.Is4() {
+		var expected [16]byte
+		v4 := addr.As4()
+		copy(expected[:4], v4[:])
+		return scope == 0 && address == expected
+	}
+	if !addr.Is6() || address != addr.As16() {
+		return false
+	}
+	if addr.Zone() == "" {
+		return scope == 0
+	}
+	// Getsockname/Getpeername expose numeric native scope IDs. Never turn a
+	// zone name into an ambient interface lookup to satisfy this comparison.
+	zone, err := strconv.ParseUint(addr.Zone(), 10, 32)
+	return err == nil && uint32(zone) == scope
+}
