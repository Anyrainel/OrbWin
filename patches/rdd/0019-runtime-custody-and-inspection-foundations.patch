+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+// Compile-only in the qualification recipe: real production guards and actual
+// native reply classifier, without invoking any native entry or token query.
+func TestSDKImageProducerOriginalOutputGuards(t *testing.T) {
+	i := &nativeUpgradeSDKImage{root: &InstanceRoot{}, captureRoles: []sdkImageProducerRole{{name: `C:\`, parent: -1, directory: true, volume: true}}}
+	i.captureSelf, i.captureRoot = i, i.root
+	if sdkHoldImage(i) != nil {
+		t.Fatal("typed lifetime admission")
+	}
+	defer sdkClosedImage(i)
+	slot := &upgradeSDKCodeObject{directory: true}
+	f := &runtimeImageOpenFrame{owner: i, name: `C:\`, output: &slot.handle}
+	slot.frame = f
+	i.held = []*upgradeSDKCodeObject{slot}
+	i.captureFrame = f
+	if !f.entryReady() {
+		t.Fatal("original slot rejected")
+	}
+	var foreign windows.Handle
+	f.output = &foreign
+	if f.original() {
+		t.Fatal("foreign output admitted")
+	}
+	f.output = &slot.handle
+	f.name = "foreign"
+	if f.original() {
+		t.Fatal("foreign name admitted")
+	}
+	f.name = `C:\`
+	copyOwner := nativeUpgradeSDKImage{captureSelf: i, root: i.root, captureRoot: i.root, captureRoles: i.captureRoles, captureFrame: f, held: i.held}
+	f.owner = &copyOwner
+	if f.original() {
+		t.Fatal("owner copy admitted")
+	}
+	f.owner = i
+	f.state.entered = true
+	f.raw = 0x103
+	if _, e := f.ntReply(); e == nil || !i.captureUnknown || !f.state.unknown || i.producerCloseReady() {
+		t.Fatal("actual pending-zero reply not retained")
+	}
+	if i.Close() == nil || i.closed {
+		t.Fatal("unknown Close settled")
+	}
+}
+
+func TestSDKImageProducerStableCloseCells(t *testing.T) {
+	i := &nativeUpgradeSDKImage{}
+	first := &upgradeSDKCodeObject{}
+	f := &runtimeImageOpenFrame{owner: i, output: &first.handle}
+	first.frame = f
+	i.held = append(i.held, first)
+	for n := 0; n < 4096; n++ {
+		i.held = append(i.held, &upgradeSDKCodeObject{})
+	}
+	if f.output != &i.held[0].handle {
+		t.Fatal("slice growth moved native output")
+	}
+	*f.output = windows.Handle(17)
+	if i.held[0].handle != 17 {
+		t.Fatal("output/sole closer diverged")
+	}
+}
