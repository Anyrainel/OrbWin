+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshPublicationRejectsUnbornAndCopiedOwnersBeforeNative(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, o := range []*FreshSetupOwner{nil, {}, {self: &FreshSetupOwner{}}} {
+		if o.PublishFreshRuntime(ctx) == nil {
+			t.Fatal("unborn/copy admitted")
+		}
+	}
+	o := &FreshSetupOwner{}
+	o.self = o
+	if o.PublishFreshRuntime(ctx) == nil || o.publication != nil {
+		t.Fatal("incomplete owner created publisher")
+	}
+	if _, e := captureFreshCommittedStartup(nil, nil); e == nil {
+		t.Fatal("nil startup reached native")
+	}
+	p := &freshCommittedStartupPermit{}
+	p.self = p
+	if p.admittedCapture(&nativeRuntimeStorage{}) {
+		t.Fatal("unregistered startup minted native admission")
+	}
+}
+
+func TestRuntimeFreshPublicationSealRequiresExactPositiveNativeCaches(t *testing.T) {
+	o := &FreshSetupOwner{}
+	o.self = o
+	n := &nativeRuntimeStorage{closeAttempted: true}
+	n.captureSelf = n
+	o.storage = n
+	origin := &nativeRuntimeBuildOrigin{closed: true, closeAttempt: runtimeStorageCloseAttempt{attempted: true}}
+	o.origin = origin
+	w := &FreshRuntimeObservation{owner: o, closed: true, closeAttempt: runtimeStorageCloseAttempt{attempted: true}}
+	w.self = w
+	o.observation = w
+	p := &nativeFreshRuntimePublisher{owner: o, observation: w}
+	o.publication = p
+	r := &nativeFreshCommittedReceipt{owner: o, publisher: p, sealAttempted: true, selectionClosed: true, target: &nativeRuntimeStorageReceipt{owner: n}, object: &runtimeStorageObject{}, body: []byte("cached committed body")}
+	p.receipt = r
+	o.sealed = r
+	runtimeStorageDomain.Lock()
+	old := runtimeStorageDomain.failed
+	runtimeStorageDomain.failed = false
+	delete(runtimeStorageDomain.owners, n)
+	runtimeStorageDomain.Unlock()
+	t.Cleanup(func() {
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = old
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.Unlock()
+	})
+	if !r.sealedStateLocked(o) {
+		t.Fatal("actual exact positive cached seal refused")
+	}
+	for name, mutate := range map[string]func(){
+		"unknown origin":     func() { origin.unknown = true },
+		"unsettled resource": func() { n.resources = []*runtimeStorageResource{{}} },
+		"unsettled registry": func() { o.keys = []*freshRegistryResource{{}} },
+		"domain still owns storage": func() {
+			runtimeStorageDomain.Lock()
+			runtimeStorageDomain.owners[n] = true
+			runtimeStorageDomain.Unlock()
+		},
+		"selection not closed": func() { r.selectionClosed = false },
+	} {
+		t.Run(name, func(t *testing.T) {
+			mutate()
+			if r.sealedStateLocked(o) {
+				t.Fatal("incomplete seal released controller authority")
+			}
+			origin.unknown = false
+			n.resources = nil
+			o.keys = nil
+			r.selectionClosed = true
+			runtimeStorageDomain.Lock()
+			delete(runtimeStorageDomain.owners, n)
+			runtimeStorageDomain.Unlock()
+		})
+	}
+	copy := *r
+	o.sealed = &copy
+	if copy.sealedStateLocked(o) {
+		t.Fatal("copied receipt admitted")
+	}
+}
+
+func TestRuntimeFreshPublicationStartupUnknownRetainsObservationBeforeOwnClose(t *testing.T) {
+	n := &nativeRuntimeStorage{unknown: true}
+	n.captureSelf = n
+	slot := &runtimeStorageResource{handle: 42}
+	o := &freshOrdinaryObservation{resources: []*runtimeStorageResource{slot}}
+	f := &freshCommittedStartupPermit{storage: n, observation: o}
+	f.self = f
+	freshCommittedStartups.Lock()
+	freshCommittedStartups.owners[f] = true
+	freshCommittedStartups.Unlock()
+	runtimeStorageDomain.Lock()
+	oldFailed := runtimeStorageDomain.failed
+	runtimeStorageDomain.failed = false
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	t.Cleanup(func() {
+		freshCommittedStartups.Lock()
+		delete(freshCommittedStartups.owners, f)
+		freshCommittedStartups.Unlock()
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = oldFailed
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.Unlock()
+	})
+	if f.Close() == nil || f.Close() == nil || !f.unknown || slot.attempted || slot.handle != 42 || o.closed || n.closeAttempted {
+		t.Fatal("unknown native graph consumed own observation or retried cleanup")
+	}
+	copy := &freshCommittedStartupPermit{self: f, storage: n, observation: o}
+	if copy.Close() == nil {
+		t.Fatal("copied startup owner admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_recovery.go b/rdd/pkg/managementconfig/runtime_fresh_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..475d64e62f74cbf7cb9bbd9cf2d7f2a748842e68
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_recovery.go
@@ -0,0 +1,92 @@
+package managementconfig
+
+import "fmt"
+
+const runtimeFreshRecoveryLimit = 16
+
+// DATA refusal only. Native callers also recheck the SAME actual held objects;
+// current exclusive ownership is not identity of the originally admitted lock.
+func runtimeFreshAdmittedStorageMatches(a runtimeFreshAdmission, parent, controller UpgradeObject, parentDescriptor, controllerDescriptor [32]byte) bool {
+	return a.valid() && a.Parent == parent && a.Controller == controller && a.ParentDescriptor == parentDescriptor && a.ControllerDescriptor == controllerDescriptor
+}
+
+func runtimeFreshRecoveryBodyMatches(a runtimeFreshAdmission, body []byte, home string) bool {
+	record, e := parseRuntimeIdentity(body, home)
+	return e == nil && record == a.Runtime
+}
+
+func runtimeFreshRecoveryRecordName(sequence uint32) (string, error) {
+	if sequence < 1 || sequence > runtimeFreshRecoveryLimit {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.recovery.%04d.json", sequence), nil
+}
+
+// Current live observation replaces only process generation, never the actual
+// held original stage, initialized authority, credentials, intent or denial.
+// The concrete native recovery owner separately issues all effect capabilities.
+type runtimeFreshRecoveryAdmission struct {
+	Schema   int                           `json:"schema"`
+	Sequence uint32                        `json:"sequence"`
+	Previous runtimePublicationFileWitness `json:"previous"`
+	Current  runtimeFreshAdmission         `json:"current"`
+}
+
+func (r runtimeFreshRecoveryAdmission) matches(previous runtimeFreshAdmission, witness runtimePublicationFileWitness, sequence uint32) bool {
+	if r.Schema != 1 || r.Sequence != sequence || sequence == 0 || sequence > runtimeFreshRecoveryLimit || !r.Previous.valid() || r.Previous != witness || !previous.valid() || !r.Current.valid() {
+		return false
+	}
+	a := r.Current
+	a.Candidate = previous.Candidate
+	return a == previous
+}
+
+type runtimeFreshRecoveryLayout uint8
+
+const (
+	runtimeFreshRecoveryInvalid runtimeFreshRecoveryLayout = iota
+	runtimeFreshRecoveryInitialized
+	runtimeFreshRecoveryPrepared
+	runtimeFreshRecoveryRenamed
+	runtimeFreshRecoveryCommitted
+	runtimeFreshRecoveryUnadmittedStage
+)
+
+// Snapshot classification DATA only. Zero witness means an actual precise
+// no-output name-not-found was captured and must be rechecked by the native
+// constructor. This function never changes n.prepared or issues a native grant.
+func classifyRuntimeFreshRecovery(a *runtimeFreshAdmission, committed *runtimeFreshCommitted, stage, target runtimePublicationFileWitness) runtimeFreshRecoveryLayout {
+	if a == nil {
+		if committed == nil && stage == (runtimePublicationFileWitness{}) && target == (runtimePublicationFileWitness{}) {
+			return runtimeFreshRecoveryInitialized
+		}
+		if committed == nil && stage.valid() && target == (runtimePublicationFileWitness{}) {
+			return runtimeFreshRecoveryUnadmittedStage
+		}
+		return runtimeFreshRecoveryInvalid
+	}
+	if !a.valid() {
+		return runtimeFreshRecoveryInvalid
+	}
+	if committed != nil {
+		if committed.matches(*a) && stage == (runtimePublicationFileWitness{}) && target == committed.Target {
+			return runtimeFreshRecoveryCommitted
+		}
+		return runtimeFreshRecoveryInvalid
+	}
+	if stage == a.Stage && target == (runtimePublicationFileWitness{}) {
+		return runtimeFreshRecoveryPrepared
+	}
+	if target == a.Stage && stage == (runtimePublicationFileWitness{}) {
+		return runtimeFreshRecoveryRenamed
+	}
+	return runtimeFreshRecoveryInvalid
+}
+
+// DATA comparison only; the concrete native recovery must separately prove the
+// original retained stage and target absence. A new authenticated observation
+// must reproduce its entire record; same build alone cannot admit old readiness.
+func runtimeFreshOrphanStageMatches(intent runtimeFreshIntent, body []byte, observed runtimeIdentityRecord, home string) bool {
+	actual, e := parseRuntimeIdentity(body, home)
+	return e == nil && actual == observed && actual.BinarySHA == intent.Image && actual.SourceCommit == intent.Commit
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_recovery_publication_windows.go b/rdd/pkg/managementconfig/runtime_fresh_recovery_publication_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef938d05ef576697923d1bf33da53c82b6b56a0d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_recovery_publication_windows.go
@@ -0,0 +1,160 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"runtime"
+)
+
+// Same actual publisher/storage/witness, with an original native resume graph.
+// No upgrade journal is invented and the admitted stage is never rewritten.
+func (p *nativeFreshRuntimePublisher) publishRecoveryHeld(ctx context.Context) error {
+	o := p.owner
+	n := o.storage
+	r := n.freshRecovery
+	if r != nil {
+		bindingErr := func() error {
+			n.mu.Lock()
+			defer n.mu.Unlock()
+			runtime.LockOSThread()
+			defer runtime.UnlockOSThread()
+			return r.checkAdmittedStorageLocked(ctx)
+		}()
+		if bindingErr != nil {
+			return ErrUpgrade
+		}
+	}
+	if r == nil || !r.admitted(n) || !r.complete || r.admission == nil || p.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	storedBody := r.stageBody
+	if r.stage == nil {
+		storedBody = r.targetBody
+	}
+	if !runtimeFreshRecoveryBodyMatches(*r.admission, storedBody, n.home) {
+		return ErrUpgrade
+	}
+	record, e := p.observation.runtimeIdentityHeld(ctx, o, o.created, p.observation.publisher)
+	if e != nil || record != r.admission.Runtime {
+		return ErrUpgrade
+	}
+	authority, e := p.captureAuthorityHeld(ctx)
+	if e != nil || authority.authority != r.admission.Authority || authority.lock != r.admission.AuthorityLock || authority.lockDescriptor != r.admission.AuthorityLockDescriptor || authority.args != r.admission.Args || authority.initialization != r.admission.Initialization {
+		return ErrUpgrade
+	}
+	if r.committed != nil {
+		// A previously checked commit describes initialization, not this new
+		// process's readiness. The actual NEW witness above remains indispensable.
+		p.admission = *r.admission
+		p.admissionObject = r.admissionObject
+		p.admissionBody = append([]byte(nil), r.admissionBody...)
+		p.receipt = &nativeFreshCommittedReceipt{owner: o, publisher: p, sealErr: ErrUpgrade, object: r.commitObject, body: append([]byte(nil), r.commitBody...)}
+		p.receipt.target, e = n.resumeRenamedStorageReceipt(ctx)
+		if e != nil || p.receipt.target.checkStorage() != nil || p.checkHeld(ctx) != nil {
+			return ErrUpgrade
+		}
+		return p.receipt.sealHeld(ctx, o)
+	}
+	p.admission = *r.admission
+	p.admission.Candidate = o.origin.generation
+	recovered := runtimeFreshRecoveryAdmission{Schema: 1, Sequence: r.sequence + 1, Previous: runtimeStorageFileData(r.admissionObject, r.admissionBody), Current: p.admission}
+	if !recovered.matches(*r.admission, runtimeStorageFileData(r.admissionObject, r.admissionBody), r.sequence+1) {
+		return ErrUpgrade
+	}
+	name, e := runtimeFreshRecoveryRecordName(recovered.Sequence)
+	if e != nil {
+		return ErrUpgrade
+	}
+	p.admissionBody, e = runtimeFreshRecordBytes(recovered)
+	if e != nil {
+		return ErrUpgrade
+	}
+	p.admissionObject, e = o.writeFreshRecordHeld(ctx, name, p.admissionBody)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil || o.checkFreshRecordHeld(ctx, p.admissionObject, p.admissionBody) != nil {
+		return ErrUpgrade
+	}
+	p.receipt = &nativeFreshCommittedReceipt{owner: o, publisher: p, sealErr: ErrUpgrade}
+	switch r.layoutLocked() {
+	case runtimeFreshRecoveryPrepared:
+		p.prepared, e = n.resumePreparedStorage(ctx)
+		if e != nil {
+			return ErrUpgrade
+		}
+		p.receipt.target, e = p.prepared.commitStorage()
+	case runtimeFreshRecoveryRenamed:
+		p.receipt.target, e = n.resumeRenamedStorageReceipt(ctx)
+	default:
+		return ErrUpgrade
+	}
+	if e != nil || p.receipt.target == nil || p.receipt.target.checkStorage() != nil || p.checkHeld(ctx) != nil || sha256.Sum256(p.receipt.target.body) != p.admission.Stage.Body {
+		return ErrUpgrade
+	}
+	return p.commitRecoveryReceiptHeld(ctx)
+}
+
+func (p *nativeFreshRuntimePublisher) commitRecoveryReceiptHeld(ctx context.Context) error {
+	o, r := p.owner, p.receipt
+	n := o.storage
+	n.mu.Lock()
+	target := runtimeStorageFileData(r.target.target, r.target.body)
+	n.mu.Unlock()
+	c := runtimeFreshCommitted{Schema: 1, Transaction: o.intent.Transaction, Admission: runtimeStorageFileData(p.admissionObject, p.admissionBody), Target: target}
+	if !c.matches(p.admission) {
+		return ErrUpgrade
+	}
+	var e error
+	r.body, e = runtimeFreshRecordBytes(c)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r.object, e = o.writeFreshRecordHeld(ctx, runtimeFreshCommittedName, r.body)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if p.checkHeld(ctx) != nil || r.target.checkStorage() != nil || o.checkFreshRecordHeld(ctx, r.object, r.body) != nil || o.checkFreshRecordHeld(ctx, p.admissionObject, p.admissionBody) != nil {
+		return ErrUpgrade
+	}
+	return r.sealHeld(ctx, o)
+}
+
+// Called after actual positive owner cleanup, never as a second closer.
+func forgetFreshRecoveryLocked(o *FreshSetupOwner) {
+	if o == nil || !o.closed || o.closeErr != nil {
+		return
+	}
+	if n := o.storage; n != nil {
+		n.mu.Lock()
+		runtimeStorageDomain.Lock()
+		positive := n.closeAttempted && n.closeErr == nil && !n.unknown && !runtimeStorageDomain.failed && !runtimeStorageDomain.owners[n]
+		runtimeStorageDomain.Unlock()
+		n.mu.Unlock()
+		if !positive {
+			return
+		}
+	}
+	nativeFreshRecoveries.Lock()
+	defer nativeFreshRecoveries.Unlock()
+	for r := range nativeFreshRecoveries.owners {
+		if r.owner == o {
+			delete(nativeFreshRecoveries.owners, r)
+		}
+	}
+}
+
+// Recheck actual denial graph with original owner/storage lock order.
+func (r *nativeFreshRecoveryOwner) checkDenialHeld(ctx context.Context) error {
+	n := r.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !r.admitted(n) || r.denial == nil {
+		return ErrUpgrade
+	}
+	return r.denial.checkLocked(ctx)
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_recovery_test.go b/rdd/pkg/managementconfig/runtime_fresh_recovery_test.go
