+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshGuestPreflightFinalProviderCancellationRefuses(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	if finishRuntimeFreshGuestPreflight(ctx) != nil {
+		t.Fatal("live bounded completion refused")
+	}
+	// Model cancellation during the final synchronous registry/file query.
+	// The actual absent/present/recheck success branches all call this helper.
+	cancel()
+	if finishRuntimeFreshGuestPreflight(ctx) == nil || finishRuntimeFreshGuestPreflight(context.Background()) == nil || finishRuntimeFreshGuestPreflight(nil) == nil {
+		t.Fatal("terminal boundary admitted expired or unbounded completion")
+	}
+}
+
+func TestRuntimeFreshGuestPreflightUnbornCannotReachProvider(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	o := &FreshSetupOwner{}
+	o.self = o
+	n := &nativeRuntimeStorage{}
+	n.captureSelf = n
+	o.storage = n
+	r := &nativeFreshRecoveryOwner{owner: o}
+	r.self = r
+	n.freshRecovery = r
+	if r.captureGuestPreflight(ctx) == nil || r.guestPreflight != nil || len(o.keys) != 0 || len(n.resources) != 0 {
+		t.Fatal("unregistered/incomplete recovery queried registration or guest files")
+	}
+	c := &Created{}
+	o.created = c
+	if o.RecheckRecoveryGuestBeforeControllers(ctx, c) == nil {
+		t.Fatal("unborn preflight enabled controller effects")
+	}
+	o.mu.Lock()
+	e := o.requireFreshNoGuestLocked(ctx)
+	o.mu.Unlock()
+	if e == nil || len(o.keys) != 0 || len(n.resources) != 0 {
+		t.Fatal("unborn absence query reached native providers")
+	}
+}
+
+func TestRuntimeFreshGuestPreflightUnknownPrecedesTemporaryKeyClose(t *testing.T) {
+	n := &nativeRuntimeStorage{unknown: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n}
+	o.self = o
+	r := &nativeFreshRecoveryOwner{owner: o}
+	g := &nativeFreshGuestPreflight{recovery: r}
+	r.guestPreflight = g
+	key := &freshRegistryResource{handle: 42}
+	o.keys = []*freshRegistryResource{key}
+	n.mu.Lock()
+	e := g.closeTemporaryKeyLocked(key)
+	n.mu.Unlock()
+	if e == nil || key.attempted || key.handle != 42 || len(o.keys) != 1 {
+		t.Fatal("borrowed unknown consumed own original registry resource")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_intent.go b/rdd/pkg/managementconfig/runtime_fresh_intent.go
new file mode 100644
index 0000000000000000000000000000000000000000..58c96e5d6f09b67a734b3ccf372cf8c631c26f77
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_intent.go
@@ -0,0 +1,90 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// A fresh intent is immutable crash evidence, never a ready/publication grant.
+// There is deliberately no committed Boolean or upgrade journal conversion.
+const runtimeFreshFenceName = "authority.fresh"
+
+// Match the existing product's ASCII-insensitive WSL owned-name selection.
+// This is a denial predicate only; no name proves native guest ownership.
+func runtimeFreshOwnedRegistrationName(name string) bool {
+	const owned = "lima-orbwin"
+	if len(name) != len(owned) {
+		return false
+	}
+	for i := range owned {
+		b := name[i]
+		if b >= 'A' && b <= 'Z' {
+			b += 'a' - 'A'
+		}
+		if b != owned[i] {
+			return false
+		}
+	}
+	return true
+}
+
+type runtimeFreshIntent struct {
+	Schema        int                  `json:"schema"`
+	Transaction   string               `json:"transaction"`
+	Image         string               `json:"image"`
+	Commit        string               `json:"commit"`
+	PrivateParent [3]uint32            `json:"privateParent"`
+	PublicParent  [3]uint32            `json:"publicParent"`
+	Seed          runtimeFreshSeedFact `json:"seed"`
+}
+
+// Preserve the complete schema-1 wire representation unchanged.
+func (v runtimeFreshIntent) MarshalJSON() ([]byte, error) {
+	type plain runtimeFreshIntent
+	w := struct {
+		plain
+		Seed *runtimeFreshSeedFact `json:"seed,omitempty"`
+	}{plain: plain(v)}
+	if v.Seed != (runtimeFreshSeedFact{}) {
+		w.Seed = &v.Seed
+	}
+	return json.Marshal(w)
+}
+
+func (v runtimeFreshIntent) valid() bool {
+	decode := func(s string, n int) bool {
+		b, e := hex.DecodeString(s)
+		return e == nil && len(b) == n && hex.EncodeToString(b) == s && !bytes.Equal(b, make([]byte, n))
+	}
+	version := (v.Schema == 1 && v.Seed == (runtimeFreshSeedFact{})) || (v.Schema == 2 && v.Seed.valid() && v.Seed.Object.Volume == v.PrivateParent[0])
+	return version && decode(v.Transaction, 16) && decode(v.Image, 32) && decode(v.Commit, 20) && v.PrivateParent != [3]uint32{} && v.PublicParent != [3]uint32{}
+}
+
+func encodeRuntimeFreshIntent(v runtimeFreshIntent) ([]byte, error) {
+	if !v.valid() {
+		return nil, ErrUpgrade
+	}
+	b, e := json.Marshal(v)
+	if e != nil || len(b) > 1024 {
+		return nil, ErrUpgrade
+	}
+	return append(b, '\n'), nil
+}
+
+func parseRuntimeFreshIntent(b []byte) (runtimeFreshIntent, error) {
+	var v runtimeFreshIntent
+	if len(b) == 0 || len(b) > 1024 {
+		return v, ErrUpgrade
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if d.Decode(&v) != nil {
+		return runtimeFreshIntent{}, ErrUpgrade
+	}
+	canonical, e := encodeRuntimeFreshIntent(v)
+	if e != nil || !bytes.Equal(b, canonical) {
+		return runtimeFreshIntent{}, ErrUpgrade
+	}
+	return v, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_intent_test.go b/rdd/pkg/managementconfig/runtime_fresh_intent_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..97dd3561c75838ec53d0d0c7f39438da7c2fead3
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_intent_test.go
@@ -0,0 +1,58 @@
+package managementconfig
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRuntimeFreshOwnedRegistrationDeniesActualProductCaseVariants(t *testing.T) {
+	for _, name := range []string{"lima-orbwin", "LIMA-ORBWIN", "Lima-OrbWin", "lImA-oRbWiN"} {
+		if !runtimeFreshOwnedRegistrationName(name) {
+			t.Fatalf("owned product name ignored: %s", name)
+		}
+	}
+	for _, name := range []string{"", "lima-rancher-desktop", "lima-orbwin-data", "lima-orbwin ", "foreign-lima-orbwin"} {
+		if runtimeFreshOwnedRegistrationName(name) {
+			t.Fatalf("foreign name selected: %s", name)
+		}
+	}
+}
+
+func TestRuntimeFreshIntentClosedCanonicalCrashEvidence(t *testing.T) {
+	v := runtimeFreshIntent{Schema: 1, Transaction: strings.Repeat("a", 32), Image: strings.Repeat("b", 64), Commit: strings.Repeat("c", 40), PrivateParent: [3]uint32{1, 2, 3}, PublicParent: [3]uint32{1, 4, 5}}
+	body, e := encodeRuntimeFreshIntent(v)
+	if e != nil {
+		t.Fatal(e)
+	}
+	got, e := parseRuntimeFreshIntent(body)
+	if e != nil || got != v {
+		t.Fatal("canonical intent did not round trip")
+	}
+	for name, b := range map[string][]byte{
+		"empty": nil, "oversized": bytes.Repeat([]byte("x"), 1025), "truncated": body[:len(body)-2],
+		"extra newline": append(append([]byte{}, body...), '\n'), "second object": append(append([]byte{}, body...), body...),
+		"unknown grant": bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"ready":true`), 1),
+		"duplicate":     bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1),
+		"uppercase":     bytes.Replace(body, []byte(v.Image), []byte(strings.ToUpper(v.Image)), 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, e := parseRuntimeFreshIntent(b); e == nil {
+				t.Fatal("accepted noncanonical crash evidence")
+			}
+		})
+	}
+	for name, change := range map[string]func(*runtimeFreshIntent){
+		"schema": func(v *runtimeFreshIntent) { v.Schema = 2 }, "zero nonce": func(v *runtimeFreshIntent) { v.Transaction = strings.Repeat("0", 32) },
+		"zero image": func(v *runtimeFreshIntent) { v.Image = strings.Repeat("0", 64) }, "short commit": func(v *runtimeFreshIntent) { v.Commit = "abcd" },
+		"missing private": func(v *runtimeFreshIntent) { v.PrivateParent = [3]uint32{} }, "missing public": func(v *runtimeFreshIntent) { v.PublicParent = [3]uint32{} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := v
+			change(&bad)
+			if _, e := encodeRuntimeFreshIntent(bad); e == nil {
+				t.Fatal("accepted incomplete intent")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_legacy_denial.go b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial.go
new file mode 100644
index 0000000000000000000000000000000000000000..e9348a6a69f11849ef25572fddef3ce0fa695e6b
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial.go
@@ -0,0 +1,90 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+const runtimeFreshLegacyDenialName = "denial.json"
+const runtimeFreshLegacyDenialBudget = 4096
+const runtimeFreshLegacyDirectoryCount = 5
+
+// Fixed ordinary old-rdd path below the selected public runtime parent. None
+// of these names is selected by a caller, receipt, environment or directory scan.
+func runtimeFreshLegacyDirectoryName(role int) (string, error) {
+	switch role {
+	case 0:
+		return "home", nil
+	case 1:
+		return "AppData", nil
+	case 2:
+		return "Local", nil
+	case 3:
+		return "rancher-desktop-orbwin", nil
+	case 4:
+		return "rdd.pid", nil
+	default:
+		return "", ErrUpgrade
+	}
+}
+
+type runtimeFreshLegacyDirectoryFact struct {
+	Object     UpgradeObject `json:"object"`
+	Descriptor [32]byte      `json:"descriptor"`
+}
+
+// Canonical crash evidence only. Decoding this record never authorizes a create,
+// ordinary activation, HOME, retirement or a native handle. The independent
+// actual receipt file witness is the fresh publisher's durable binding field.
+type runtimeFreshLegacyDenialRecord struct {
+	Schema      int                                                               `json:"schema"`
+	Transaction string                                                            `json:"transaction"`
+	Intent      runtimePublicationFileWitness                                     `json:"intent"`
+	Parent      runtimeFreshLegacyDirectoryFact                                   `json:"parent"`
+	Directories [runtimeFreshLegacyDirectoryCount]runtimeFreshLegacyDirectoryFact `json:"directories"`
+}
+
+func (r runtimeFreshLegacyDenialRecord) valid() bool {
+	if r.Schema != 1 || !upgradeHex(r.Transaction, 32) || !r.Intent.valid() || !r.Parent.Object.valid() || r.Parent.Descriptor == [32]byte{} {
+		return false
+	}
+	seen := map[UpgradeObject]bool{r.Parent.Object: true, r.Intent.Object: true}
+	if r.Parent.Object == r.Intent.Object {
+		return false
+	}
+	for _, directory := range r.Directories {
+		if !directory.Object.valid() || directory.Object.Volume != r.Parent.Object.Volume || directory.Descriptor == [32]byte{} || seen[directory.Object] {
+			return false
+		}
+		seen[directory.Object] = true
+	}
+	return true
+}
+
+func encodeRuntimeFreshLegacyDenial(r runtimeFreshLegacyDenialRecord) ([]byte, error) {
+	if !r.valid() {
+		return nil, ErrUpgrade
+	}
+	b, e := json.Marshal(r)
+	if e != nil || len(b)+1 > runtimeFreshLegacyDenialBudget {
+		return nil, ErrUpgrade
+	}
+	return append(b, '\n'), nil
+}
+
+func parseRuntimeFreshLegacyDenial(body []byte) (runtimeFreshLegacyDenialRecord, error) {
+	var record runtimeFreshLegacyDenialRecord
+	if len(body) == 0 || len(body) > runtimeFreshLegacyDenialBudget || !runtimeIdentityUnicode(body) {
+		return record, ErrUpgrade
+	}
+	d := json.NewDecoder(bytes.NewReader(body))
+	d.DisallowUnknownFields()
+	if d.Decode(&record) != nil {
+		return runtimeFreshLegacyDenialRecord{}, ErrUpgrade
+	}
+	canonical, e := encodeRuntimeFreshLegacyDenial(record)
+	if e != nil || !bytes.Equal(body, canonical) {
+		return runtimeFreshLegacyDenialRecord{}, ErrUpgrade
+	}
+	return record, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_test.go b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..40f7b586b6af3c4ef39e3a5494b3a0e948ef9f26
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_test.go
@@ -0,0 +1,82 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func runtimeFreshLegacyRecordFixture() runtimeFreshLegacyDenialRecord {
+	r := runtimeFreshLegacyDenialRecord{Schema: 1, Transaction: strings.Repeat("1", 32), Intent: runtimePublicationFileWitness{Object: UpgradeObject{1, 1, 1}, Descriptor: [32]byte{1}, Body: [32]byte{2}, Size: 200}, Parent: runtimeFreshLegacyDirectoryFact{UpgradeObject{2, 1, 1}, [32]byte{3}}}
+	for i := range r.Directories {
+		r.Directories[i] = runtimeFreshLegacyDirectoryFact{UpgradeObject{2, 1, uint32(i + 2)}, [32]byte{byte(i + 4)}}
+	}
+	return r
+}
+
+func TestRuntimeFreshLegacyDenialFixedRoles(t *testing.T) {
+	want := []string{"home", "AppData", "Local", "rancher-desktop-orbwin", "rdd.pid"}
+	for i, name := range want {
+		got, e := runtimeFreshLegacyDirectoryName(i)
+		if e != nil || got != name {
+			t.Fatal("ordinary old PID directory route changed", i, got, e)
+		}
+	}
+	for _, role := range []int{-1, runtimeFreshLegacyDirectoryCount, 100} {
+		if _, e := runtimeFreshLegacyDirectoryName(role); e == nil {
+			t.Fatal("unbounded native role accepted")
+		}
+	}
+	if runtimeFreshLegacyDenialName != "denial.json" {
+		t.Fatal("persistent nonempty PID directory receipt changed")
+	}
+}
+
+func TestRuntimeFreshLegacyDenialCanonicalRecord(t *testing.T) {
+	base := runtimeFreshLegacyRecordFixture()
+	body, e := encodeRuntimeFreshLegacyDenial(base)
+	if e != nil || len(body) == 0 || len(body) > runtimeFreshLegacyDenialBudget {
+		t.Fatal("bounded record failed", e)
+	}
+	if got, e := parseRuntimeFreshLegacyDenial(body); e != nil || got != base {
+		t.Fatal("canonical native-object evidence changed", e)
+	}
+	for name, change := range map[string]func(*runtimeFreshLegacyDenialRecord){
+		"schema":          func(r *runtimeFreshLegacyDenialRecord) { r.Schema++ },
+		"transaction":     func(r *runtimeFreshLegacyDenialRecord) { r.Transaction = "../foreign" },
+		"intent":          func(r *runtimeFreshLegacyDenialRecord) { r.Intent = runtimePublicationFileWitness{} },
+		"parent":          func(r *runtimeFreshLegacyDenialRecord) { r.Parent.Object = UpgradeObject{} },
+		"descriptor":      func(r *runtimeFreshLegacyDenialRecord) { r.Directories[2].Descriptor = [32]byte{} },
+		"duplicate":       func(r *runtimeFreshLegacyDenialRecord) { r.Directories[3].Object = r.Directories[0].Object },
+		"borrowed parent": func(r *runtimeFreshLegacyDenialRecord) { r.Directories[0].Object = r.Parent.Object },
+		"different disk":  func(r *runtimeFreshLegacyDenialRecord) { r.Directories[4].Object.Volume++ },
+	} {
+		t.Run(name, func(t *testing.T) {
+			r := base
+			change(&r)
+			if _, e := encodeRuntimeFreshLegacyDenial(r); e == nil {
+				t.Fatal("invalid native-object evidence encoded")
+			}
+		})
+	}
+	for name, bad := range map[string][]byte{
+		"empty":           nil,
+		"oversized":       bytes.Repeat([]byte{' '}, runtimeFreshLegacyDenialBudget+1),
+		"trailing record": append(append([]byte(nil), body...), []byte("{}")...),
+		"unknown field":   bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"ready":true`), 1),
+		"duplicate":       bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1),
+		"case folded":     bytes.Replace(body, []byte(`"schema":1`), []byte(`"Schema":1`), 1),
+		"alternate bytes": append([]byte{' '}, body...),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, e := parseRuntimeFreshLegacyDenial(bad); e == nil {
+				t.Fatal("noncanonical record accepted")
+			}
+		})
+	}
+	var wire map[string]any
+	if json.Unmarshal(body, &wire) != nil || len(wire) != 5 {
+		t.Fatal("receipt acquired unrelated publication/retirement fields")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows.go b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..4ee5fe9569ccd2535d8ec916ef9e107f889b9867
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows.go
@@ -0,0 +1,465 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// The SAME FreshOwner/storage owns every handle, including the output of a
+// failed native call. This object has no independent Close or release callback.
+// owner.mu -> storage.mu protects it. Neither a record nor a completed flag
+// substitutes for checkLegacyStartDenialLocked's actual object/edge checks.
+type runtimeFreshLegacyDenial struct {
+	durable        []nativeFreshDenialDurableFile
+	prefix         *nativeFreshDenialPrefix         // exact original unpublished denial producer
+	existing       *nativeFreshExistingLegacyDenial // actual recovery capture, no fabricated writer
+	owner          *FreshSetupOwner
+	boundary       *runtimeStorageObject // exact-object write/flush lease, not a new parent grant
+	directories    [runtimeFreshLegacyDirectoryCount]*runtimeStorageObject
+	writer         *runtimeStorageResource
+	receipt        *runtimeStorageObject
+	completion     *runtimeStorageObject
+	completionBody []byte
+	record         runtimeFreshLegacyDenialRecord
+	body           []byte
+	completed      bool
+	failed         bool
+	failure        error
+}
+
+func (d *runtimeFreshLegacyDenial) fenceLocked() {
+	d.failed, d.failure = true, ErrUpgrade
+	d.owner.unknown = true
+	d.owner.storage.fence() // storage.mu is already held; never owner.fence here
+}
+
+func (d *runtimeFreshLegacyDenial) knownLocked() bool {
+	if d != nil && d.prefix != nil {
+		return d.prefix.admittedProducerLocked(d)
+	}
+	return d != nil && d.owner != nil && d.owner.self == d.owner && d.owner.legacyDenial == d && !d.failed && d.owner.captureComplete && d.owner.fenceObject != nil && d.owner.nativeOutputsAdmittedLocked()
+}
+
+// PrepareLegacyStartDenial is one create attempt after the actual durable
+// fresh intent, before upstream environment/options or service creation. A
+// repeated known failure never retries. A repeated success only rechecks the
+// original held native graph. No directory/receipt is removed on any path.
+func (o *FreshSetupOwner) PrepareLegacyStartDenial(ctx context.Context) (failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown {
+		return ErrUpgrade
+	}
+	if !o.captureComplete || o.storage == nil || o.storage.captureSelf != o.storage || o.origin == nil || o.image == nil || o.fenceObject == nil {
+		return ErrUpgrade
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered {
+		return ErrUpgrade
+	}
+	if d := o.legacyDenial; d != nil {
+		if d.owner != o || d.failed || !d.completed || d.failure != nil {
+			return ErrUpgrade
+		}
+		return func() error {
+			o.storage.mu.Lock()
+			defer o.storage.mu.Unlock()
+			runtime.LockOSThread()
+			defer runtime.UnlockOSThread()
+			return o.checkLegacyStartDenialLocked(ctx)
+		}()
+	}
+	// Keep the shared prerequisite unchanged: ProjectUpstreamEnvironment uses
+	// it too. Only actual CreateServiceAuthority separately requires this denial.
+	if !o.createdAdmissionLocked(ctx) {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	admitted := o.nativeOutputsAdmittedLocked() && n.publicRoute != nil && n.parent != nil && n.predecessor == nil
+	if admitted {
+		o.legacyDenial = &runtimeFreshLegacyDenial{owner: o, failure: ErrUpgrade}
+	}
+	n.mu.Unlock()
+	if !admitted {
+		return ErrUpgrade
+	}
+	d := o.legacyDenial // actual strong slot precedes the first native recheck
+	defer func() { d.settleAttempt(&failure, recover() != nil) }()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	return func() error {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		if !d.knownLocked() || n.checkPrevious() != nil || d.checkIntentLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		return d.createLocked(ctx)
+	}()
+}
+
+// Actual method settlement, after the nested storage critical section unwinds.
+// A panic retains this exact partial before any outer caller can Close it.
+func (d *runtimeFreshLegacyDenial) settleAttempt(failure *error, panicked bool) {
+	if panicked {
+		d.owner.fence()
+		*failure = ErrUpgrade
+	}
+	if *failure != nil {
+		d.failed, d.failure = true, ErrUpgrade
+	} else {
+		d.completed, d.failure = true, nil
+	}
+}
+
+// Pure pre-native refusal only; actual authority creation also performs the
+// complete native object/receipt recheck below while both real mutexes are held.
+func (o *FreshSetupOwner) legacyDenialReadyLocked() bool {
+	return o != nil && o.self == o && o.legacyDenial != nil && o.legacyDenial.owner == o && o.legacyDenial.completed && !o.legacyDenial.failed && o.legacyDenial.failure == nil
+}
+
+// Fixed names are supplied only by the role methods below. Slots are published
+// BEFORE NtCreateFile; exact known no-output errors retain their native status.
+func (d *runtimeFreshLegacyDenial) openLocked(ctx context.Context, parent windows.Handle, name string, directory bool, disposition, access, share uint32, sd *windows.SECURITY_DESCRIPTOR) (*runtimeStorageResource, error) {
+	if !freshBoundedContext(ctx) || !d.knownLocked() {
+		return nil, ErrUpgrade
+	}
+	n := d.owner.storage
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	r := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, share, disposition, options, 0, 0)
+	runtime.KeepAlive(sd)
+	if e = d.outputLocked(r, e); e != nil {
+		return nil, e
+	}
+	return r, nil
+}
+
+// Exact retained output classification only; no native inspection/close. Tests
+// exercise this same production helper with inert output slots.
+func (d *runtimeFreshLegacyDenial) outputLocked(r *runtimeStorageResource, callErr error) error {
+	if d == nil || d.owner == nil || d.owner.legacyDenial != d {
+		return ErrUpgrade
+	}
+	if d.prefix != nil {
+		n := d.owner.storage
+		if !d.prefix.admittedProducerLocked(d) || r == nil || len(n.resources) == 0 || n.resources[len(n.resources)-1] != r {
+			return ErrUpgrade
+		}
+		e := runtimeStorageOpenReply(callErr, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, n.fence)
+		if n.unknown {
+			d.fenceLocked()
+			return ErrUpgrade
+		}
+		if e != nil {
+			n.resources = n.resources[:len(n.resources)-1]
+		}
+		return e
+	}
+	e := d.owner.fileOutputLocked(r, callErr)
+	if d.owner.storage.unknown {
+		d.fenceLocked()
+	}
+	return e
+}
+
+func (d *runtimeFreshLegacyDenial) closeTemporaryLocked(r *runtimeStorageResource) error {
+	n := d.owner.storage
+	if n.closeTemporary(r) != nil {
+		d.fenceLocked()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (d *runtimeFreshLegacyDenial) checkIntentLocked(ctx context.Context) error {
+	o, n := d.owner, d.owner.storage
+	if !freshBoundedContext(ctx) || !d.knownLocked() || n.check() != nil || n.checkObject(o.fenceObject) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(o.fenceObject, false)
+	defer clear(body)
+	if e != nil {
+		return ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(body)
+	if e != nil || intent != o.intent || !intent.valid() {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func freshLegacyDirectoryFact(object *runtimeStorageObject) runtimeFreshLegacyDirectoryFact {
+	return runtimeFreshLegacyDirectoryFact{runtimeStorageObjectData(object), object.identity.descriptor}
+}
+
+func (d *runtimeFreshLegacyDenial) createLocked(ctx context.Context) error {
+	o, n := d.owner, d.owner.storage
+	// Capture's pre-fence absence is not replaced by a record. Recheck actual
+	// HOME absence after that same intent; CREATE still refuses a racing creator.
+	if _, e := d.openLocked(ctx, n.parent.resource.handle, "home", true, windows.FILE_OPEN, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil); e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrUpgrade
+	}
+	route := n.publicRoute
+	if route == nil || route.boundary != n.parent || len(route.nodes) < 2 || route.nodes[len(route.nodes)-1].name != "OrbWinData" {
+		return ErrUpgrade
+	}
+	// Existing route handles have no write access. Reopen the SAME boundary
+	// relative to its original held parent; never broaden its descriptor policy.
+	parent := route.nodes[len(route.nodes)-2].resource
+	if parent == nil || parent.attempted || parent.handle == 0 {
+		return ErrUpgrade
+	}
+	r, e := d.openLocked(ctx, parent.handle, "OrbWinData", true, windows.FILE_OPEN, windows.GENERIC_WRITE|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil)
+	if e != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, true, n.parent.private, n.parent.traversal)
+	if e != nil || id != n.parent.identity {
+		return ErrUpgrade
+	}
+	d.boundary = &runtimeStorageObject{resource: r, identity: id, directory: true, private: n.parent.private, traversal: n.parent.traversal}
+	for role := 0; role < runtimeFreshLegacyDirectoryCount; role++ {
+		name, e := runtimeFreshLegacyDirectoryName(role)
+		if e != nil {
+			return ErrUpgrade
+		}
+		parent := d.boundary
+		if role > 0 {
+			parent = d.directories[role-1]
+		}
+		if n.checkObject(parent) != nil || !freshBoundedContext(ctx) {
+			return ErrUpgrade
+		}
+		sd, e := privateDescriptor(n.sid, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		r, e := d.openLocked(ctx, parent.resource.handle, name, true, windows.FILE_CREATE, windows.GENERIC_READ|windows.GENERIC_WRITE|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, sd)
+		if e != nil {
+			return ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(r.handle, n.sid, true, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		d.directories[role] = &runtimeStorageObject{resource: r, identity: id, directory: true, private: true}
+	}
+	intentBody, e := n.read(o.fenceObject, false)
+	defer clear(intentBody)
+	if e != nil {
+		return ErrUpgrade
+	}
+	d.record = runtimeFreshLegacyDenialRecord{Schema: 1, Transaction: o.intent.Transaction, Intent: runtimeStorageFileData(o.fenceObject, intentBody), Parent: freshLegacyDirectoryFact(d.boundary)}
+	for i, directory := range d.directories {
+		d.record.Directories[i] = freshLegacyDirectoryFact(directory)
+	}
+	d.body, e = encodeRuntimeFreshLegacyDenial(d.record)
+	if e != nil || d.writeReceiptLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	// Flush from nonempty PID directory through the exact public boundary. All
+	// are actual separately owned write-capable handles. Support/durability is
+	// still a native qualification gate; a refusal never becomes completion.
+	for i := runtimeFreshLegacyDirectoryCount - 1; i >= -1; i-- {
+		object := d.boundary
+		if i >= 0 {
+			object = d.directories[i]
+		}
+		if !freshBoundedContext(ctx) || n.checkObject(object) != nil || windows.FlushFileBuffers(object.resource.handle) != nil {
+			return ErrUpgrade
+		}
+	}
+	if d.completeDenialLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return d.checkObjectsLocked(ctx)
+}
+
+func (d *runtimeFreshLegacyDenial) writeReceiptLocked(ctx context.Context) error {
+	n := d.owner.storage
+	parent := d.directories[runtimeFreshLegacyDirectoryCount-1]
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	d.writer, e = d.openLocked(ctx, parent.resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_CREATE, windows.GENERIC_READ|windows.GENERIC_WRITE, 0, sd)
+	if e != nil {
+		return ErrUpgrade
+	}
+	for at := 0; at < len(d.body); {
+		if !freshBoundedContext(ctx) {
+			return ErrUpgrade
+		}
+		count, e := nativeWrite(d.writer.handle, d.body[at:])
+		if e != nil || count < 1 || count > len(d.body)-at {
+			return ErrUpgrade
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(d.writer.handle) != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(d.writer.handle, n.sid, false, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	object := &runtimeStorageObject{resource: d.writer, identity: id, private: true}
+	body, e := n.read(object, false)
+	if e != nil || !bytes.Equal(body, d.body) || d.closeTemporaryLocked(d.writer) != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	r, e := d.openLocked(ctx, parent.resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_OPEN, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil)
+	if e != nil {
+		return ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil || !runtimeStorageCreatedSame(actual, id) {
+		return ErrUpgrade
+	}
+	d.receipt = &runtimeStorageObject{resource: r, identity: actual, private: true}
+	body, e = n.read(d.receipt, false)
+	if e != nil || !bytes.Equal(body, d.body) || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Caller holds owner.mu AND storage.mu, with OS-thread affinity. All opens here
+// are observations of our existing fixed names; they never create/adopt/repair.
+func (d *runtimeFreshLegacyDenial) checkObjectsLocked(ctx context.Context) error {
+	if d.existing != nil {
+		if d.owner == nil || d.owner.storage != d.existing.storage || d.receipt != d.existing.receipt || d.record != d.existing.record || d.completion != d.existing.completion || !bytes.Equal(d.completionBody, d.existing.completionBody) || !bytes.Equal(d.body, d.existing.body) {
+			return ErrUpgrade
+		}
+		return d.existing.checkLocked(ctx)
+	}
+	o, n := d.owner, d.owner.storage
+	if d.checkIntentLocked(ctx) != nil || d.boundary == nil || d.receipt == nil || d.writer == nil || !runtimeArgsSlotClosed(d.writer) || n.checkObject(d.boundary) != nil || d.boundary.identity != n.parent.identity || !d.record.valid() || d.record.Transaction != o.intent.Transaction || freshLegacyDirectoryFact(d.boundary) != d.record.Parent {
+		return ErrUpgrade
+	}
+	intentBody, e := n.read(o.fenceObject, false)
+	defer clear(intentBody)
+	if e != nil || runtimeStorageFileData(o.fenceObject, intentBody) != d.record.Intent {
+		return ErrUpgrade
+	}
+	for role, object := range d.directories {
+		if object == nil || n.checkObject(object) != nil || freshLegacyDirectoryFact(object) != d.record.Directories[role] {
+			return ErrUpgrade
+		}
+		parent := d.boundary
+		if role > 0 {
+			parent = d.directories[role-1]
+		}
+		name, _ := runtimeFreshLegacyDirectoryName(role)
+		r, e := d.openLocked(ctx, parent.resource.handle, name, true, windows.FILE_OPEN, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil)
+		if e != nil {
+			return ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(r.handle, n.sid, true, true, false)
+		if d.closeTemporaryLocked(r) != nil || e != nil || id != object.identity {
+			return ErrUpgrade
+		}
+	}
+	if n.checkObject(d.receipt) != nil || d.checkCompletionLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(d.receipt, false)
+	if e != nil || !bytes.Equal(body, d.body) {
+		return ErrUpgrade
+	}
+	record, e := parseRuntimeFreshLegacyDenial(body)
+	if e != nil || record != d.record || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	// Recheck the exact receipt literal, not just the already held FILE_OBJECT.
+	r, e := d.openLocked(ctx, d.directories[runtimeFreshLegacyDirectoryCount-1].resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_OPEN, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil)
+	if e != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if d.closeTemporaryLocked(r) != nil || e != nil || id != d.receipt.identity {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Private integration API: caller already holds original owner.mu/storage.mu
+// and native thread affinity. No record-only or caller-supplied denial is used.
+func (o *FreshSetupOwner) checkLegacyStartDenialLocked(ctx context.Context) (failure error) {
+	if o == nil || o.self != o || o.legacyDenial == nil {
+		return ErrUpgrade
+	}
+	d := o.legacyDenial
+	if d.owner != o || !d.completed || d.failed || d.failure != nil || !d.knownLocked() {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			d.fenceLocked()
+			failure = ErrUpgrade
+		}
+	}()
+	return d.checkObjectsLocked(ctx)
+}
+
+// The fresh admission needs only this actual nonempty receipt file witness.
+// Its canonical record binds intent and every fixed directory ID/descriptor;
+// ordinary startup must independently FILE_OPEN/revalidate those actual names.
+func (o *FreshSetupOwner) legacyStartDenialDataLocked(ctx context.Context) (runtimePublicationFileWitness, error) {
+	if o.checkLegacyStartDenialLocked(ctx) != nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	d := o.legacyDenial
+	return runtimeStorageFileData(d.receipt, d.body), nil
+}
+
+// Borrowed actual HOME object only; it stays in SAME storage and is not a Close
+// or guest lifecycle grant. The observer must retain the original owner lifetime.
+func (o *FreshSetupOwner) legacyGuestHomeLocked(ctx context.Context) (*runtimeStorageObject, error) {
+	if o.checkLegacyStartDenialLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	return o.legacyDenial.directories[0], nil
+}
+
+func (o *FreshSetupOwner) legacyStartDenialCompletionDataLocked(ctx context.Context) (runtimePublicationFileWitness, error) {
+	if o == nil || o.checkLegacyStartDenialLocked(ctx) != nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	d := o.legacyDenial
+	if o.intent.Schema == 1 && o.intent.Seed == (runtimeFreshSeedFact{}) {
+		if d.completion != nil {
+			return runtimePublicationFileWitness{}, ErrUpgrade
+		}
+		return runtimePublicationFileWitness{}, nil
+	}
+	if o.intent.Schema != 2 || !o.intent.Seed.valid() || d.completion == nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	return runtimeStorageFileData(d.completion, d.completionBody), nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows_test.go b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..83c86ebf8d127db2cc4e936f2ace1d03e58dc074
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_legacy_denial_windows_test.go
@@ -0,0 +1,170 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// Inert registered pointer states, never a positive native constructor. All
+// handles below are sentinel DATA; these tests never query or close them.
+func freshLegacyOutputFixture(t *testing.T) (*FreshSetupOwner, *runtimeFreshLegacyDenial) {
+	t.Helper()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true, captureKind: runtimeStorageFreshCapture}
+	n.captureSelf = n
+	runtimeStorageDomain.Lock()
+	oldFailed := runtimeStorageDomain.failed
+	runtimeStorageDomain.failed = false
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	t.Cleanup(func() {
+		runtimeStorageDomain.Lock()
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.failed = oldFailed
+		runtimeStorageDomain.Unlock()
+	})
+	o := &FreshSetupOwner{storage: n, captureComplete: true, fenceObject: &runtimeStorageObject{}, origin: &nativeRuntimeBuildOrigin{}, image: &ServingImageLease{}}
+	o.self = o
+	freshTestRegister(t, o)
+	d := &runtimeFreshLegacyDenial{owner: o, failure: ErrUpgrade}
+	o.legacyDenial = d
+	return o, d
+}
+
+func TestRuntimeFreshLegacyDenialEntryRefusesBeforeNative(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, owner := range []*FreshSetupOwner{nil, {}, {self: &FreshSetupOwner{}}} {
+		if owner.PrepareLegacyStartDenial(ctx) != ErrUpgrade {
+			t.Fatal("nil/zero/copied owner reached fresh native eligibility")
+		}
+	}
+	o := &FreshSetupOwner{}
+	o.self = o
+	freshTestRegister(t, o)
+	if o.PrepareLegacyStartDenial(ctx) != ErrUpgrade || o.legacyDenial != nil {
+		t.Fatal("incomplete actual owner created a denial graph")
+	}
+	for _, bad := range []context.Context{nil, context.Background()} {
+		if o.PrepareLegacyStartDenial(bad) != ErrUpgrade {
+			t.Fatal("unbounded context reached native eligibility")
+		}
+	}
+	stopped, stop := context.WithCancel(ctx)
+	stop()
+	if o.PrepareLegacyStartDenial(stopped) != ErrUpgrade {
+		t.Fatal("canceled entry reached native eligibility")
+	}
+	// The new CreateServiceAuthority pre-native refusal is separate from the
+	// shared predicate used by ProjectUpstreamEnvironment; no circular gate.
+	full, _ := freshLegacyOutputFixture(t)
+	full.legacyDenial = nil
+	if !full.createdAdmissionLocked(ctx) || full.legacyDenialReadyLocked() {
+		t.Fatal("shared environment gate acquired a denial prerequisite")
+	}
+	if _, e := full.CreateServiceAuthority(ctx, []byte("[]")); e == nil || full.created != nil || len(full.storage.resources) != 0 {
+		t.Fatal("authority without actual denial passed pre-native refusal")
+	}
+}
+
+func TestRuntimeFreshLegacyDenialActualOutputRetention(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		handle  windows.Handle
+		err     error
+		unknown bool
+		absent  bool
+	}{
+		{"precise absence", 0, windows.STATUS_OBJECT_NAME_NOT_FOUND, false, true},
+		{"error-valid absence", 42, windows.STATUS_OBJECT_NAME_NOT_FOUND, true, false},
+		{"missing success", 0, nil, true, false},
+		{"known denied", 0, windows.ERROR_ACCESS_DENIED, false, false},
+		{"inert positive slot", 42, nil, false, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			o, d := freshLegacyOutputFixture(t)
+			n := o.storage
+			n.mu.Lock()
+			defer n.mu.Unlock()
+			r := n.keep(test.handle)
+			got := d.outputLocked(r, test.err)
+			if (got == windows.STATUS_OBJECT_NAME_NOT_FOUND) != test.absent || n.unknown != test.unknown || o.unknown != test.unknown || r.attempted || o.legacyDenial != d {
+				t.Fatal("actual output classifier lost exact custody/refusal", got)
+			}
+			if test.unknown {
+				if len(n.resources) != 1 || n.resources[0] != r || !d.failed || d.failure != ErrUpgrade {
+					t.Fatal("partial output disappeared or remained reusable")
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+				defer cancel()
+				if _, e := d.openLocked(ctx, 0, "not-a-role", false, 0, 0, 0, nil); e != ErrUpgrade {
+					t.Fatal("unknown graph reached another native call")
+				}
+			} else if test.err != nil && len(n.resources) != 0 {
+				t.Fatal("known no-output failure retained a fictitious handle")
+			}
+		})
+	}
+}
+
+func TestRuntimeFreshLegacyDenialFailureAndPanicAreCached(t *testing.T) {
+	for _, panicked := range []bool{false, true} {
+		o, d := freshLegacyOutputFixture(t)
+		r := o.storage.keep(42)
+		failure := errors.New("synthetic known create refusal")
+		if panicked {
+			failure = nil
+		}
+		o.mu.Lock()
+		d.settleAttempt(&failure, panicked)
+		o.mu.Unlock()
+		if failure == nil || !d.failed || d.completed || d.failure != ErrUpgrade || o.legacyDenial != d || len(o.storage.resources) != 1 || o.storage.resources[0] != r || r.attempted {
+			t.Fatal("settlement released partial namespace or looked complete")
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		for i := 0; i < 2; i++ {
+			if o.PrepareLegacyStartDenial(ctx) != ErrUpgrade || r.attempted {
+				t.Fatal("failed create was retried or its slot closed")
+			}
+		}
+		cancel()
+		if panicked {
+			if !o.unknown || !o.storage.unknown || o.Close() != ErrUpgrade || r.attempted || o.origin.closeAttempt.attempted || o.image.closed {
+				t.Fatal("panic released the original graph/controller suffix")
+			}
+		}
+	}
+}
+
+func TestRuntimeFreshLegacyDenialIncompleteNeverIssuesBorrow(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	o, d := freshLegacyOutputFixture(t)
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.storage.mu.Lock()
+	defer o.storage.mu.Unlock()
+	for _, state := range []string{"pending", "failed", "foreign owner"} {
+		d.failed = state == "failed"
+		d.completed = state == "foreign owner"
+		d.failure = ErrUpgrade
+		if state == "foreign owner" {
+			d.owner = &FreshSetupOwner{}
+			d.failure = nil
+		}
+		if o.checkLegacyStartDenialLocked(ctx) != ErrUpgrade {
+			t.Fatal("incomplete owner admitted native checks", state)
+		}
+		if fact, e := o.legacyStartDenialDataLocked(ctx); e != ErrUpgrade || fact != (runtimePublicationFileWitness{}) {
+			t.Fatal("partial owner exported a durable publication witness", state)
+		}
+		if home, e := o.legacyGuestHomeLocked(ctx); e != ErrUpgrade || home != nil {
+			t.Fatal("partial owner exported an actual HOME borrow", state)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_legacy_existing_windows.go b/rdd/pkg/managementconfig/runtime_fresh_legacy_existing_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ed70452f963ada99c842377919783ef97166a180
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_legacy_existing_windows.go
@@ -0,0 +1,209 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual FILE_OPEN-only graph for committed startup and interrupted recovery.
+// SAME storage owns every resource; this has no independent Close and never
+// constructs a FreshSetupOwner from a decoded denial receipt.
+type nativeFreshExistingLegacyDenial struct {
+	history        []nativeFreshDenialDurableFile
+	storage        *nativeRuntimeStorage
+	intent         *runtimeStorageObject
+	intentBody     []byte
+	directories    [runtimeFreshLegacyDirectoryCount]*runtimeStorageObject
+	receipt        *runtimeStorageObject
+	completion     *runtimeStorageObject
+	completionBody []byte
+	body           []byte
+	record         runtimeFreshLegacyDenialRecord
+}
+
+// Caller holds actual storage.mu and OS-thread affinity. Output enters SAME
+// native graph before acquisition; no failed/partial open becomes absence.
+func (n *nativeRuntimeStorage) openFreshExistingTracked(ctx context.Context, parent windows.Handle, name string, directory bool, access, share uint32, private, traversal bool) (*runtimeStorageObject, error) {
+	if !freshBoundedContext(ctx) || !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil {
+		return nil, ErrUpgrade
+	}
+	owned := false
+	for _, r := range n.resources {
+		if r != nil && !r.attempted && r.handle != 0 && r.handle == parent {
+			owned = true
+			break
+		}
+	}
+	if !owned {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	r := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, share, windows.FILE_OPEN, options, 0, 0)
+	if reply := runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, n.fence); reply != nil {
+		if !n.unknown {
+			n.resources = n.resources[:len(n.resources)-1]
+		}
+		return nil, reply
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, directory, private, traversal)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: r, identity: id, directory: directory, private: private, traversal: traversal}, nil
+}
+
+func (n *nativeRuntimeStorage) captureFreshLegacyDenialStorage(ctx context.Context, intent runtimeFreshIntent, expected runtimePublicationFileWitness) (d *nativeFreshExistingLegacyDenial, failure error) {
+	if n == nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			n.fence()
+			d = nil
+			failure = ErrUpgrade
+		}
+	}()
+	if !runtimeMappedSelfStorageKnownLocked(n) || len(n.ancestry) == 0 || n.parent == nil || n.check() != nil {
+		return nil, ErrUpgrade
+	}
+	d = &nativeFreshExistingLegacyDenial{storage: n}
+	var e error
+	d.intent, e = n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, runtimeFreshFenceName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	d.intentBody, e = n.read(d.intent, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	actual, e := parseRuntimeFreshIntent(d.intentBody)
+	if e != nil || actual != intent {
+		return nil, ErrUpgrade
+	}
+	parent := n.parent
+	for i := range d.directories {
+		name, _ := runtimeFreshLegacyDirectoryName(i)
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		d.directories[i] = object
+		parent = object
+	}
+	d.receipt, e = n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	d.body, e = n.read(d.receipt, false)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	d.record, e = parseRuntimeFreshLegacyDenial(d.body)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	if expected != (runtimePublicationFileWitness{}) && runtimeStorageFileData(d.receipt, d.body) != expected {
+		return nil, ErrUpgrade
+	}
+	if d.captureCompletionLocked(ctx, actual) != nil || d.checkLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	return d, nil
+}
+
+// Caller owns storage.mu/thread. Fixed relative edges are checked against the
+// actual held original objects, then exact receipt bytes are revalidated.
+func (d *nativeFreshExistingLegacyDenial) checkLocked(ctx context.Context) error {
+	if d == nil || d.storage == nil {
+		return ErrUpgrade
+	}
+	n := d.storage
+	if !freshBoundedContext(ctx) || !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil || !d.record.valid() || d.intent == nil || d.receipt == nil || n.checkObject(d.intent) != nil || d.record.Parent != freshLegacyDirectoryFact(n.parent) {
+		return ErrUpgrade
+	}
+	ib, e := n.read(d.intent, false)
+	if e != nil || !bytes.Equal(ib, d.intentBody) || runtimeStorageFileData(d.intent, ib) != d.record.Intent {
+		return ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(ib)
+	if e != nil || intent.Transaction != d.record.Transaction || d.checkCompletionLocked(ctx, intent) != nil {
+		return ErrUpgrade
+	}
+	parent := n.parent
+	for i, object := range d.directories {
+		if object == nil || n.checkObject(object) != nil || freshLegacyDirectoryFact(object) != d.record.Directories[i] {
+			return ErrUpgrade
+		}
+		name, _ := runtimeFreshLegacyDirectoryName(i)
+		temporary, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, true, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		same := temporary.identity == object.identity
+		if n.closeTemporary(temporary.resource) != nil || !same {
+			return ErrUpgrade
+		}
+		parent = object
+	}
+	if n.checkObject(d.receipt) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(d.receipt, false)
+	if e != nil || !bytes.Equal(body, d.body) {
+		return ErrUpgrade
+	}
+	record, e := parseRuntimeFreshLegacyDenial(body)
+	if e != nil || record != d.record {
+		return ErrUpgrade
+	}
+	temporary, e := n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshLegacyDenialName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	same := temporary.identity == d.receipt.identity
+	if n.closeTemporary(temporary.resource) != nil || !same || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (d *nativeFreshExistingLegacyDenial) completionDataLocked(ctx context.Context) (runtimePublicationFileWitness, error) {
+	if d == nil || d.checkLocked(ctx) != nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	intent, e := parseRuntimeFreshIntent(d.intentBody)
+	if e != nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	if intent.Schema == 1 && intent.Seed == (runtimeFreshSeedFact{}) {
+		if d.completion != nil {
+			return runtimePublicationFileWitness{}, ErrUpgrade
+		}
+		return runtimePublicationFileWitness{}, nil
+	}
+	if intent.Schema != 2 || !intent.Seed.valid() || d.completion == nil {
+		return runtimePublicationFileWitness{}, ErrUpgrade
+	}
+	return runtimeStorageFileData(d.completion, d.completionBody), nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_missing_control_windows.go b/rdd/pkg/managementconfig/runtime_fresh_missing_control_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..e459629e083a814f58d914ed915f8e3315a23cc7
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_missing_control_windows.go
@@ -0,0 +1,146 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+// A concrete source-boundary capability for intent+denial, before the original
+// authority root CREATE. No existing authority/default/DB is adopted or reset.
+// The SAME actual recovery/controller owns it; it has no independent closer.
+type nativeFreshMissingControl struct {
+	self     *nativeFreshMissingControl
+	recovery *nativeFreshRecoveryOwner
+	parent   *runtimeStorageObject
+}
+
+func (r *nativeFreshRecoveryOwner) captureExistingOrMissingControl(ctx context.Context) error {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := r.owner.storage
+	missing, e := func() (bool, error) {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		if found, e := r.captureRecordedControlLocked(ctx); e != nil {
+			return false, ErrUpgrade
+		} else if found {
+			return true, nil
+		}
+		if r.admission != nil || r.stage != nil || r.target != nil {
+			return false, nil
+		}
+		if !r.admitted(n) || r.missingControl != nil || !runtimeMappedSelfStorageKnownLocked(n) || len(n.ancestry) == 0 || r.checkLayoutLocked(ctx) != nil {
+			return false, ErrUpgrade
+		}
+		parent := n.ancestry[len(n.ancestry)-1]
+		// The first structural probe owns DELETE and permits DELETE sharing:
+		// reusing the old readonly probe would self-block retained-root rename.
+		object, e := n.openFreshExistingTracked(ctx, parent.resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE|windows.DELETE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.guestPreflight.checkLocked(ctx) != nil || !freshBoundedContext(ctx) {
+				return false, ErrUpgrade
+			}
+			proof := &nativeFreshMissingControl{recovery: r, parent: parent}
+			proof.self = proof
+			r.missingControl = proof
+			return true, nil
+		}
+		if e != nil {
+			return false, ErrUpgrade
+		}
+		if r.guestPreflight != nil && r.guestPreflight.shape == runtimeFreshGuestAbsent {
+			if found, e := r.captureTupleRecoveryLocked(ctx, object); e != nil {
+				return false, ErrUpgrade
+			} else if found {
+				return true, nil
+			}
+		}
+		if r.guestPreflight != nil && r.guestPreflight.shape == runtimeFreshGuestAbsent {
+			if prefix, e := r.captureStructuralControlLocked(ctx, object); e != nil {
+				return false, ErrUpgrade
+			} else if prefix != nil {
+				return true, nil
+			}
+		}
+		// An existing root goes only to the unchanged initialized reader. A
+		// generic initialization failure can never select missing/CREATE mode.
+		if n.closeTemporary(object.resource) != nil || !freshBoundedContext(ctx) {
+			return false, ErrUpgrade
+		}
+		return false, nil
+	}()
+	if e != nil {
+		return ErrUpgrade
+	}
+	if missing {
+		return nil
+	}
+	return r.captureInitializedAuthority(ctx)
+}
+
+// Caller holds original owner.mu/storage.mu/thread. Actual absence is re-read
+// at issuance, not reconstructed from a receipt or a prior boolean choice.
+func (proof *nativeFreshMissingControl) checkLocked(ctx context.Context) error {
+	if proof == nil || proof.self != proof || proof.recovery == nil {
+		return ErrUpgrade
+	}
+	r := proof.recovery
+	if r.owner == nil || r.owner.storage == nil {
+		return ErrUpgrade
+	}
+	n := r.owner.storage
+	if !r.admitted(n) || !r.complete || r.missingControl != proof || r.admission != nil || r.stage != nil || r.target != nil || len(n.ancestry) == 0 || proof.parent != n.ancestry[len(n.ancestry)-1] || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.checkLayoutLocked(ctx) != nil || r.guestPreflight.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	object, e := n.openFreshExistingTracked(ctx, proof.parent.resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND || object != nil || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (o *FreshSetupOwner) createMissingControlAuthority(ctx context.Context, args []byte) (result *Created, failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	initialization, e := initializationBytes(args)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n := o.storage
+	if n == nil || n.freshRecovery == nil || o.closed || o.unknown || !o.captureComplete || o.created != nil {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	if r.owner != o || !r.admitted(n) || !r.complete || r.missingControl == nil || o.origin == nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			n.fence()
+			result = nil
+			failure = ErrUpgrade
+		}
+	}()
+	if !o.nativeOutputsAdmittedLocked() || r.missingControl.checkLocked(ctx) != nil || o.checkLegacyStartDenialLocked(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	// This distinct recovery entry invokes only the actual shared native
+	// producer after exact source-boundary proof. Public normal admission and
+	// CREATE lineage are never forged or retrofitted from decoded metadata.
+	return o.createFreshServiceAuthorityNativeLocked(ctx, args, initialization)
+}
