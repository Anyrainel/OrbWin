+func (g *DatastoreGeneration) frameOriginal(f *datastoreCleanupFrame) bool {
+	if !g.exactCleanup() || f == nil || f.owner != g || f.output == nil || f.parent == nil {
+		return false
+	}
+	found := false
+	for _, v := range g.frames {
+		if v == f {
+			found = true
+		}
+	}
+	if !found {
+		return false
+	}
+	switch f.role {
+	case "file-read", "file-delete":
+		names := datastoreNames()
+		all := append([]string{"owner.json"}, names[:]...)
+		return f.index >= 0 && f.index < 6 && f.name == all[f.index] && f.parent == &g.directory && (f.role == "file-delete" && f.output == &f.handle || f.role == "file-read" && len(g.files) == 6 && f.output == &g.files[f.index])
+	case "history-read":
+		return g.issuer != nil && f.parent == g.rootCell() && f.parent != nil && f.name == g.reapName && f.output == &g.directory
+	case "root-duplicate":
+		return g.issuer != nil && f.parent == &g.issuer.root && f.output == &g.root && f.name == ""
+	case "directory-delete":
+		return f.parent == g.rootCell() && f.parent != nil && f.name == g.record.Generation && f.output == &f.handle
+	}
+	return g.captureFrameOriginal(f)
+}
+func (g *DatastoreGeneration) newCleanupFrame(role string, index int) *datastoreCleanupFrame {
+	if !g.exactCleanup() || len(g.frames) >= 32 {
+		return nil
+	}
+	f := &datastoreCleanupFrame{owner: g, role: role, index: index}
+	f.output = &f.handle
+	switch role {
+	case "file-read", "file-delete":
+		names := datastoreNames()
+		all := append([]string{"owner.json"}, names[:]...)
+		if index < 0 || index >= 6 || len(g.files) != 6 {
+			return nil
+		}
+		f.name = all[index]
+		f.parent = &g.directory
+		if role == "file-read" {
+			f.output = &g.files[index]
+		}
+	case "history-read":
+		if g.issuer == nil {
+			return nil
+		}
+		f.name = g.reapName
+		f.parent = g.rootCell()
+		f.output = &g.directory
+	case "root-duplicate":
+		if g.issuer == nil {
+			return nil
+		}
+		f.parent = &g.issuer.root
+		f.output = &g.root
+	case "directory-delete":
+		f.name = g.record.Generation
+		f.parent = g.rootCell()
+	default:
+		if !g.configureCaptureFrame(f) {
+			return nil
+		}
+	}
+	g.frames = append(g.frames, f)
+	return f
+}
+func (f *datastoreCleanupFrame) open() (result error) {
