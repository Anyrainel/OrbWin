+)
+
+type nativeFreshIntentHistory struct {
+	next       uint32
+	last       *runtimeFreshIntentRepair
+	lastObject *runtimeStorageObject
+	lastBody   []byte
+	unarchived bool
+}
+
+func (n *nativeRuntimeStorage) freshIntentRecipeLocked(intent runtimeFreshIntent, ordinal uint32, previous runtimePublicationFileWitness, old *runtimeStorageObject, body []byte) (runtimeFreshIntentRepair, error) {
+	var r runtimeFreshIntentRepair
+	if n == nil || !runtimeMappedSelfStorageKnownLocked(n) || len(n.ancestry) == 0 || n.parent == nil || n.controller == nil {
+		return r, ErrUpgrade
+	}
+	wanted, e := encodeRuntimeFreshIntent(intent)
+	if e != nil || old == nil || len(body) >= len(wanted) || !runtimeFreshControlPrefixBytes(body, wanted) {
+		return r, ErrUpgrade
+	}
+	p := n.ancestry[len(n.ancestry)-1]
+	r = runtimeFreshIntentRepair{Schema: 1, Transaction: intent.Transaction, Ordinal: ordinal, Seed: intent.Seed, PrivateParent: runtimeStorageObjectData(p), PublicParent: runtimeStorageObjectData(n.parent), Controller: runtimeStorageObjectData(n.controller), PrivateDescriptor: p.identity.descriptor, PublicDescriptor: n.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor, Previous: previous, Old: runtimeStorageFileData(old, body), DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+	if !r.valid() {
+		return runtimeFreshIntentRepair{}, ErrUpgrade
+	}
+	return r, nil
+}
+
+// FILE_OPEN-only bounded history reader. It returns descriptive state only;
+// effect methods below independently require original concrete seed context.
+func (n *nativeRuntimeStorage) readFreshIntentHistoryLocked(ctx context.Context, intent runtimeFreshIntent, canonical *runtimeStorageObject, canonicalBody []byte) (nativeFreshIntentHistory, error) {
+	h := nativeFreshIntentHistory{next: runtimeFreshIntentRepairSlots}
+	if !intent.valid() || intent.Schema != 2 || !runtimeMappedSelfStorageKnownLocked(n) || len(n.ancestry) == 0 || n.check() != nil {
+		return h, ErrUpgrade
+	}
+	wanted, e := encodeRuntimeFreshIntent(intent)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	open := func(name string) (*runtimeStorageObject, error) {
+		return n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	}
+	type partial struct {
+		ordinal uint32
+		body    []byte
+	}
+	var pending []partial
+	gap := false
+	previous := runtimePublicationFileWitness{}
+	seenOld := map[UpgradeObject]bool{}
+	for ordinal := uint32(0); ordinal < runtimeFreshIntentRepairSlots; ordinal++ {
+		name, _ := runtimeFreshIntentRepairName(ordinal)
+		object, e := open(name)
+		archiveName, _ := runtimeFreshIntentArchiveName(ordinal)
+		archive, ae := open(archiveName)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if ae != windows.STATUS_OBJECT_NAME_NOT_FOUND || archive != nil {
+				return h, ErrUpgrade
+			}
+			if !gap {
+				h.next = ordinal
+			}
+			gap = true
+			continue
+		}
+		if e != nil || gap || h.unarchived || (ae != nil && ae != windows.STATUS_OBJECT_NAME_NOT_FOUND) {
+			return h, ErrUpgrade
+		}
+		body, e := n.read(object, true)
+		if e != nil {
+			return h, ErrUpgrade
+		}
+		var r runtimeFreshIntentRepair
+		if parseRuntimeFreshRecord(body, &r) != nil || !r.valid() {
+			if archive != nil {
+				return h, ErrUpgrade
+			}
+			pending = append(pending, partial{ordinal, body})
+			continue
+		}
+		if r.Ordinal != ordinal || r.Previous != previous || seenOld[r.Old.Object] {
+			return h, ErrUpgrade
+		}
+		seenOld[r.Old.Object] = true
