+
+func TestRuntimeUpgradeCredentialsKnownPositiveCleanupAndStorageCache(t *testing.T) {
+	for _, state := range []string{"args-closed", "inventory-closed", "storage-closed"} {
+		t.Run(state, func(t *testing.T) {
