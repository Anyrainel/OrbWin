+		return nil, ErrUpgrade
+	}
+	w = o.observation
+	if !w.exactLocked(o, c, p) || w.appAdmission == nil || !w.appAdmission.complete || w.complete {
+		return w, ErrFreshAppReconcile
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if w.observeStarted {
+		return w, ErrFreshAppReconcile
+	}
+	w.observeStarted = true
+	defer func() {
+		if x := recover(); x != nil {
+			w.fenceLocked()
+			clear(w.credentials.admin)
+			clear(w.credentials.user)
+			clear(w.credentials.ca)
+			panic(x)
+		}
+		if result != nil && !w.createAttempted {
+			clear(w.credentials.admin)
+			clear(w.credentials.user)
+			clear(w.credentials.ca)
+		}
+		if result != nil && w.appAdmission != nil && w.appAdmission.attempted {
+			result = ErrFreshAppReconcile
