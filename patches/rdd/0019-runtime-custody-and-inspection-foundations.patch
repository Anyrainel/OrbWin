+func (s *inspectionFreshRecords) checkIntentHistory(ctx context.Context) error {
+	wanted, e := encodeRuntimeFreshIntent(s.intent)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if s.intent.Schema == 1 {
+		for i := uint32(0); i < runtimeFreshIntentRepairSlots; i++ {
+			r, _ := runtimeFreshIntentRepairName(i)
+			a, _ := runtimeFreshIntentArchiveName(i)
+			if inspectionNamesContain(s.privateNames, r) || inspectionNamesContain(s.privateNames, a) {
+				return ErrUpgrade
+			}
+		}
+		if !bytes.Equal(wanted, s.intentBody) {
+			return ErrUpgrade
+		}
+		return nil
+	}
+	type partial struct {
+		ordinal uint32
+		body    []byte
+	}
+	var pending []partial
+	previous := runtimePublicationFileWitness{}
+	seen := map[UpgradeObject]bool{}
+	gap, unarchived := false, false
+	recipe := func(ordinal uint32, old *inspectionNativeObject, b []byte) runtimeFreshIntentRepair {
+		if old == nil {
+			return runtimeFreshIntentRepair{}
+		}
+		return runtimeFreshIntentRepair{Schema: 1, Transaction: s.intent.Transaction, Ordinal: ordinal, Seed: s.intent.Seed, PrivateParent: inspectionObjectWitness(s.private), PublicParent: inspectionObjectWitness(s.public), Controller: inspectionObjectWitness(s.controller), PrivateDescriptor: s.private.legacy.descriptor, PublicDescriptor: s.public.legacy.descriptor, ControllerDescriptor: s.controller.legacy.descriptor, Previous: previous, Old: inspectionFileWitness(old, b), DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+	}
+	for i := uint32(0); i < runtimeFreshIntentRepairSlots; i++ {
+		rn, _ := runtimeFreshIntentRepairName(i)
+		an, _ := runtimeFreshIntentArchiveName(i)
+		r, rb, e := s.o.inspectionFragment(ctx, s.private, rn, runtimeFreshRecordBudget)
+		if e != nil {
+			return ErrUpgrade
+		}
+		a, ab, e := s.o.inspectionFragment(ctx, s.private, an, 1024)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if r == nil {
+			if a != nil {
+				return ErrUpgrade
+			}
+			gap = true
+			continue
+		}
+		if gap || unarchived {
+			return ErrUpgrade
+		}
+		var v runtimeFreshIntentRepair
+		if parseRuntimeFreshRecord(rb, &v) != nil || !v.valid() {
+			if a != nil {
+				return ErrUpgrade
+			}
+			pending = append(pending, partial{i, rb})
+			continue
+		}
+		if v.Ordinal != i || v.Previous != previous || seen[v.Old.Object] {
+			return ErrUpgrade
+		}
+		for _, p := range pending {
+			x := v
+			x.Ordinal = p.ordinal
+			b, e := runtimeFreshRecordBytes(x)
+			if e != nil || !runtimeFreshControlPrefixBytes(p.body, b) {
+				return ErrUpgrade
+			}
+		}
+		pending = nil
+		old, body := a, ab
+		if old == nil {
+			old, body = s.intentObject, s.intentBody
+			unarchived = true
+		}
+		expected := recipe(i, old, body)
+		if !expected.valid() || v != expected || len(body) >= len(wanted) || !runtimeFreshControlPrefixBytes(body, wanted) {
+			return ErrUpgrade
+		}
+		canonicalID, archiveID := UpgradeObject{}, UpgradeObject{}
+		if s.intentObject != nil {
+			canonicalID = inspectionObjectWitness(s.intentObject)
+		}
+		if a != nil {
+			archiveID = inspectionObjectWitness(a)
+		}
+		if classifyRuntimeFreshRoleCut(v.Old.Object, canonicalID, archiveID, bytes.Equal(s.intentBody, wanted), runtimeFreshControlPrefixBytes(s.intentBody, wanted)) == runtimeFreshRoleInvalid {
+			return ErrUpgrade
+		}
+		seen[v.Old.Object] = true
+		previous = inspectionFileWitness(r, rb)
+	}
+	if s.intentObject != nil {
+		if !runtimeFreshControlPrefixBytes(s.intentBody, wanted) || seen[inspectionObjectWitness(s.intentObject)] && !unarchived {
+			return ErrUpgrade
+		}
+		if bytes.Equal(s.intentBody, wanted) && (len(pending) > 0 || unarchived || seen[inspectionObjectWitness(s.intentObject)]) {
+			return ErrUpgrade
+		}
+	} else if len(pending) > 0 || unarchived {
+		return ErrUpgrade
+	}
+	for _, p := range pending {
+		v := recipe(p.ordinal, s.intentObject, s.intentBody)
+		b, e := runtimeFreshRecordBytes(v)
+		if e != nil || !v.valid() || !runtimeFreshControlPrefixBytes(p.body, b) {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
