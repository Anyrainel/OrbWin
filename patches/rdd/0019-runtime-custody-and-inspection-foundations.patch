+	return nil
+}
+
+func (o *nativeRuntimeUpgradeManagementObservation) recheckLocked(ctx context.Context, connection *runtimeUpgradeManagementConnection) error {
+	if ctx.Err() != nil || o.admitLocked() != runtimeBorrowedLive {
+		return ErrUpgrade
+	}
+	if runtimeUpgradeManagementActualPort(o.listener, o.credentials) != nil {
+		return ErrUpgrade
+	}
+	if o.listener.checkLocked(ctx) != nil {
+		o.admitLocked()
+		return ErrUpgrade
+	}
+	if _, e := o.credentials.digestLocked(ctx); e != nil {
+		o.admitLocked()
+		return ErrUpgrade
+	}
+	// The held private file was just re-read. Its actual endpoint must still
+	// select the same native listener before any dial or bearer transmission.
+	if runtimeUpgradeManagementActualPort(o.listener, o.credentials) != nil {
+		return ErrUpgrade
+	}
+	if connection == nil {
+		return nil
+	}
+	local, remote, e := runtimeUpgradeManagementSocketEndpoints(connection.raw)
+	if e != nil || local.Addr() != netip.MustParseAddr("127.0.0.1") || remote.Addr() != netip.MustParseAddr("127.0.0.1") || remote.Port() != o.listener.port {
+		return ErrUpgrade
+	}
+	rows, e := observeUpgradeTCPTable(ctx, 4)
+	if e != nil || runtimeUpgradeManagementTCPPeerPID(rows, local, remote, o.listener.generation.PID) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func runtimeUpgradeManagementSocketEndpoints(connection *net.TCPConn) (local, remote netip.AddrPort, failure error) {
+	if connection == nil {
+		return local, remote, ErrUpgrade
+	}
+	raw, e := connection.SyscallConn()
+	if e != nil {
+		return local, remote, ErrUpgrade
+	}
+	failure = ErrUpgrade
+	e = raw.Control(func(fd uintptr) {
+		left, a := windows.Getsockname(windows.Handle(fd))
+		right, b := windows.Getpeername(windows.Handle(fd))
+		l, lok := left.(*windows.SockaddrInet4)
+		r, rok := right.(*windows.SockaddrInet4)
+		if a != nil || b != nil || !lok || !rok || l.Port <= 0 || l.Port > 65535 || r.Port <= 0 || r.Port > 65535 {
+			return
+		}
+		local = netip.AddrPortFrom(netip.AddrFrom4(l.Addr), uint16(l.Port))
+		remote = netip.AddrPortFrom(netip.AddrFrom4(r.Addr), uint16(r.Port))
+		failure = nil
+	})
+	if e != nil {
+		failure = ErrUpgrade
+	}
+	return local, remote, failure
+}
+
+// Retain the actual returned value before distinguishing success/partial/error.
+// Production supplies the single fixed Dial result; inert tests exercise only
+// failed/invalid results, without a replaceable dialer or native acquisition.
+func (o *nativeRuntimeUpgradeManagementObservation) retainDialLocked(c *runtimeUpgradeManagementConnection, returned net.Conn, failure error) error {
+	c.returned = returned
+	if returned != nil {
+		c.raw, _ = returned.(*net.TCPConn)
+	}
+	if failure != nil || c.raw == nil {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Covers every settlement effect, including a panic after request return values
+// were evaluated but before the caller received body. Production supplies only
+// that exact returned TCPConn.Close method; tests supply inert socket methods.
+// No stored callback or IPC-selected cleanup policy is introduced.
+func (o *nativeRuntimeUpgradeManagementObservation) settleRequestUsing(c *runtimeUpgradeManagementConnection, body *[]byte, failure *error, panicked bool, closeRaw func() error) {
+	defer func() {
+		if recover() != nil {
+			o.fenceLocked()
+			*failure = ErrUpgrade
+		}
+		if *failure != nil {
+			clear(*body)
+			*body = nil
+		}
+	}()
+	settledIO := c.join()
+	if panicked {
+		o.fenceLocked()
+		*failure = ErrUpgrade
+		return
+	}
+	if o.unknown {
+		*failure = ErrUpgrade
+		return // an uncertain acquisition is never retried/closed here
+	}
+	if closeRaw != nil && c.closeRawUsing(closeRaw) != nil {
+		o.fenceLocked()
+		*failure = ErrUpgrade
+		return
+	}
+	if !settledIO {
+		*failure = ErrUpgrade
+	}
+}
+
+func (o *nativeRuntimeUpgradeManagementObservation) requestLocked(ctx context.Context, index int, path string) (body []byte, failure error) {
+	c := &runtimeUpgradeManagementConnection{}
+	o.connections[index] = c // strongly retained before the acquisition effect
+	defer func() {
+		panicked := recover() != nil
+		var closeRaw func() error
+		if c.raw != nil {
+			closeRaw = c.raw.Close
+		}
+		o.settleRequestUsing(c, &body, &failure, panicked, closeRaw)
+	}()
+	if o.recheckLocked(ctx, nil) != nil {
+		return nil, ErrUpgrade
+	}
+	endpoint, e := url.Parse(o.credentials.data.endpoint)
+	if e != nil || endpoint.Scheme != "https" || endpoint.Hostname() != "127.0.0.1" || endpoint.Port() == "" {
+		return nil, ErrUpgrade
+	}
+	dialer := net.Dialer{KeepAlive: -1}
+	returned, e := dialer.DialContext(ctx, "tcp4", endpoint.Host)
+	if o.retainDialLocked(c, returned, e) != nil {
+		// Go's failed Dial hides its internal native close result. This is
+		// acquisition unknown, never a no-start/release or native proof.
+		return nil, ErrUpgrade
+	}
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		return nil, ErrUpgrade
+	}
+	c.guard = newRuntimeUpgradeManagementAbortConn(c.raw, deadline)
+	if c.guard.SetDeadline(deadline) != nil {
+		return nil, ErrUpgrade
+	}
+	c.watch(ctx)
