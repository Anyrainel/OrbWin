index 0000000000000000000000000000000000000000..771b663e07da0e8a79ba0169f5a2536c4fc08d8b
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_app_stage_windows.go
@@ -0,0 +1,224 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"golang.org/x/sys/windows"
+	"runtime"
+)
+
+const runtimeFreshAppStageName = "authority.fresh.app-create.stage"
+
+func freshAppStageArchiveName(g UpgradeProcess, id runtimeStorageIdentity) string {
+	return fmt.Sprintf("authority.fresh.app-create.stage.previous-%08x-%016x-%08x-%08x-%08x", g.PID, g.Creation, id.volume, id.high, id.low)
+}
+
+// Same actual prefix/storage, tracked before syscall. Only precise no-output
+// NFO selects a missing role. Stage needs WRITE_DATA for FlushFileBuffers.
+func (a *nativeFreshAppAdmission) readRoleLocked(ctx context.Context, name string, stage bool) (*runtimeStorageObject, []byte, error) {
+	o, n := a.w.owner, a.w.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() || n.check() != nil || len(n.ancestry) == 0 {
+		return nil, nil, ErrUpgrade
+	}
+	access := uint32(windows.FILE_READ_DATA)
+	if stage {
+		access |= windows.FILE_WRITE_DATA | windows.DELETE
+	}
+	r, e := o.openFixed(n.ancestry[len(n.ancestry)-1].resource.handle, name, false, windows.FILE_OPEN, access, nil)
+	if e != nil {
+		return nil, nil, e
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil || id.size > runtimeFreshRecordBudget {
+		return nil, nil, ErrUpgrade
+	}
+	object := &runtimeStorageObject{resource: r, identity: id, private: true}
+	b, e := n.read(object, stage)
+	if e != nil || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	return object, b, nil
+}
+
+// Rename never replaces. Checked native identity/bytes and close precede the
+// final read lease. Actual directory-entry power-loss durability is unqualified.
+func (a *nativeFreshAppAdmission) renameRoleLocked(ctx context.Context, object *runtimeStorageObject, body []byte, to string) (*runtimeStorageObject, error) {
+	o, n := a.w.owner, a.w.owner.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() || n.check() != nil || object == nil || n.checkObject(object) != nil || len(n.ancestry) == 0 {
+		return nil, ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1].resource.handle
+	if renameUpgradeChild(object.resource.handle, parent, to) != nil || windows.FlushFileBuffers(object.resource.handle) != nil || n.checkObject(object) != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	id := object.identity
+	if n.closeTemporary(object.resource) != nil {
+		return nil, ErrUpgrade
+	}
+	r, e := o.openFixed(parent, to, false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil || actual != id {
+		return nil, ErrUpgrade
+	}
+	result := &runtimeStorageObject{resource: r, identity: actual, private: true}
+	b, e := n.read(result, true)
+	if e != nil || !bytes.Equal(b, body) || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return result, nil
+}
+
+// Stage CREATE is the only multiwrite. Canonical publication is rename-only,
+// so a crash cannot leave a partially written canonical admission.
+func (a *nativeFreshAppAdmission) writeStagedRecordLocked(ctx context.Context) error {
+	o, n := a.w.owner, a.w.owner.storage
+	if a.w.gate == nil || a.w.gate.phase.Load() != freshAppGatePending || !a.record.valid() || len(a.body) == 0 || len(a.body) > runtimeFreshRecordBudget {
+		return ErrUpgrade
+	}
+	var stage *runtimeStorageObject
+	e := func() error {
+		n.mu.Lock()
+		defer n.mu.Unlock()
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		if !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() || n.check() != nil || len(n.ancestry) == 0 {
+			return ErrUpgrade
+		}
+		sd, e := privateDescriptor(n.sid, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		r, e := o.openFixed(n.ancestry[len(n.ancestry)-1].resource.handle, runtimeFreshAppStageName, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.DELETE, sd)
+		if e != nil {
+			return ErrUpgrade
+		}
+		for at := 0; at < len(a.body); {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			count, e := nativeWrite(r.handle, a.body[at:])
+			if e != nil || count < 1 || count > len(a.body)-at {
+				return ErrUpgrade
+			}
+			at += count
+		}
+		if windows.FlushFileBuffers(r.handle) != nil {
+			return ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+		if e != nil {
+			return ErrUpgrade
+		}
+		stage = &runtimeStorageObject{resource: r, identity: id, private: true}
+		b, e := n.read(stage, false)
+		if e != nil || !bytes.Equal(b, a.body) || ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		return n.closeTemporary(r)
+	}()
+	if e != nil {
+		return ErrUpgrade
+	}
+	// Check-close and actual same-object reopen before native publication.
+	actual, body, e := a.readRoleLocked(ctx, runtimeFreshAppStageName, true)
+	if e != nil || actual.identity != stage.identity || !bytes.Equal(body, a.body) {
+		return ErrUpgrade
+	}
+	a.object, e = a.renameRoleLocked(ctx, actual, a.body, runtimeFreshAppAdmissionName)
+	if e != nil {
+		return ErrUpgrade
+	}
+	a.loaded = true
+	return a.checkBindingLocked(ctx)
+}
+
+func (a *nativeFreshAppAdmission) loadAppRecordLocked(ctx context.Context) error {
+	object, body, e := a.readRoleLocked(ctx, runtimeFreshAppAdmissionName, false)
+	if e == nil {
+		a.object, a.body = object, body
+		if parseRuntimeFreshRecord(body, &a.record) != nil || !a.record.valid() {
+			return ErrUpgrade
+		}
+		if _, _, other := a.readRoleLocked(ctx, runtimeFreshAppStageName, true); other != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return ErrUpgrade
+		}
+		a.loaded = true
+		return a.checkBindingLocked(ctx)
+	}
+	if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return ErrUpgrade
+	}
+	stage, b, e := a.readRoleLocked(ctx, runtimeFreshAppStageName, true)
+	if e != nil {
+		return e
+	}
+	if a.w.gate == nil || a.w.gate.phase.Load() != freshAppGatePending {
+		return ErrUpgrade
+	}
+	record, canonical, shape := classifyFreshAppStage(b)
+	if shape == freshAppStageComplete {
+		a.object, a.body, a.record, a.loaded = stage, b, record, true
+		if a.checkBindingLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		a.object, e = a.renameRoleLocked(ctx, stage, b, runtimeFreshAppAdmissionName)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if a.checkBindingLocked(ctx) != nil || a.inventoryLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		a.readyToServe = true
+		return nil
+	}
+	if shape == freshAppStageInvalid {
+		return ErrUpgrade
+	}
+	if shape == freshAppStageNeedsNewline {
+		current, e := a.currentBindingLocked(ctx)
+		if e != nil || !freshAppBindingMatches(current, record) {
+			return ErrUpgrade
+		}
+	}
+	// Canonical is actually absent, manager never started under this pending
+	// gate, and this recipe cannot POST from partial stage bytes. Preserve them.
+	if a.inventoryLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	archived, e := a.renameRoleLocked(ctx, stage, b, freshAppStageArchiveName(a.w.owner.origin.generation, stage.identity))
+	if e != nil {
+		return ErrUpgrade
+	}
+	n := a.w.owner.storage
+	n.mu.Lock()
+	e = n.closeTemporary(archived.resource)
+	n.mu.Unlock()
+	if e != nil {
+		return ErrUpgrade
+	}
+	if shape == freshAppStageNeedsNewline {
+		// Preserve the complete original template/nonce, and preserve the exact
+		// interrupted bytes in archive before completing a fresh stage role.
+		a.record, a.body = record, canonical
+		if a.writeStagedRecordLocked(ctx) != nil || a.inventoryLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+		a.readyToServe = true
+		return nil
+	}
+	return windows.STATUS_OBJECT_NAME_NOT_FOUND
+}
