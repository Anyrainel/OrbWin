+//go:build windows
+
+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"time"
+)
+
+// Called at the original actual readiness/manager-start boundary. Management
+// readiness alone issues nothing: the owner creates/observes the real App,
+// authenticated daemon, native owned namespace/peer and durable native commit.
+func publishFreshServiceRuntime(ctx context.Context, authority privateAuthority) error {
+	w, ok := authority.(*windowsPrivateAuthority)
+	if !ok || w == nil || w.freshOwner == nil {
+		return nil
+	}
+	bounded, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+	// The SAME manager's actual serving-ready producer has already completed.
+	// Complete issues the sole POST; an uncertain response is reconciled only
+	// by the exact original annotated GET, never a repeated POST/new manager.
+	for {
+		e := w.freshOwner.CompleteFreshRuntimeApp(bounded, w.created, w.publisher)
+		if e == nil {
+			break
+		}
+		if !errors.Is(e, managementconfig.ErrFreshAppReconcile) || bounded.Err() != nil {
+			return retainFreshServiceAfterAdmissionError(ctx, authority, freshSetupFailure{stage: freshStageObservation})
+		}
+		timer := time.NewTimer(time.Second)
+		select {
+		case <-timer.C:
+		case <-bounded.Done():
+			timer.Stop()
+			return retainFreshServiceAfterAdmissionError(ctx, authority, freshSetupFailure{stage: freshStageObservation})
+		}
+	}
+	observed, e := w.freshOwner.ObserveFreshRuntime(bounded, w.created, w.publisher)
+	if e != nil || observed == nil {
+		return retainFreshServiceAfterAdmissionError(ctx, authority, freshSetupFailure{stage: freshStageObservation})
+	}
+	if w.freshOwner.PublishFreshRuntime(bounded) != nil {
+		return retainFreshServiceAfterAdmissionError(ctx, authority, freshSetupFailure{stage: freshStagePublication})
+	}
+	// DATA only, AFTER actual checked durable receipt and controller seal.
+	w.freshObserver.published()
+	return nil
+}
+
+// Pending control-only failures settle their actual actors. After native
+// Begin the original service persists through API/protocol/publication errors;
+// this path cannot cancel a healthy manager on lost UI/POST response.
+func signalFreshServiceFailure(authority privateAuthority, cancel context.CancelFunc) {
+	w, ok := authority.(*windowsPrivateAuthority)
+	if ok && w != nil && w.freshOwner != nil && cancel != nil && prepareFreshPendingRetirement(authority) {
+		cancel()
+	}
+}
