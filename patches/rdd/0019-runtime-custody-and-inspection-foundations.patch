+package managementconfig
+
+type runtimeFreshGuestShape uint8
+
+const (
+	runtimeFreshGuestUnknown runtimeFreshGuestShape = iota
+	runtimeFreshGuestAbsent
+	runtimeFreshGuestRegistered
+)
+
+// DATA refusal only. Native capture must independently prove each presence or
+// precise absence, retain exact objects and revalidate before controller work.
+func classifyRuntimeFreshGuest(registration, directory, disk bool) runtimeFreshGuestShape {
+	if !registration && !directory && !disk {
+		return runtimeFreshGuestAbsent
+	}
+	if registration && directory && disk {
+		return runtimeFreshGuestRegistered
+	}
+	return runtimeFreshGuestUnknown
+}
+
+func runtimeFreshGuestRegistrationMatches(name, base, home string, version uint32) bool {
+	return runtimeFreshOwnedRegistrationName(name) && freshRuntimeRegistrationBase(base, home) && version == 2
+}
