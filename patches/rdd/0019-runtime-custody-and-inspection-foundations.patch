+
+func TestRuntimeFreshRecoveryFixedRoleCrashCuts(t *testing.T) {
+	old, newFile, foreign := UpgradeObject{1, 1, 1}, UpgradeObject{1, 1, 2}, UpgradeObject{1, 1, 3}
+	zero := UpgradeObject{}
+	for _, row := range []struct {
+		name               string
+		canonical, archive UpgradeObject
+		full, prefix       bool
+		want               runtimeFreshRoleCut
+	}{
+		{"recipe before archive", old, zero, false, true, runtimeFreshRoleBeforeArchive},
+		{"archive before create", zero, old, false, false, runtimeFreshRoleBeforeCreate},
+		{"new partial write", newFile, old, false, true, runtimeFreshRoleNewPrefix},
+		{"new complete write", newFile, old, true, true, runtimeFreshRoleComplete},
+		{"old both names", old, old, false, true, runtimeFreshRoleInvalid},
+		{"foreign archive", newFile, foreign, true, true, runtimeFreshRoleInvalid},
+		{"nonprefix new bytes", newFile, old, false, false, runtimeFreshRoleInvalid},
+		{"changed old bytes", old, zero, true, true, runtimeFreshRoleInvalid},
+	} {
+		t.Run(row.name, func(t *testing.T) {
+			if classifyRuntimeFreshRoleCut(old, row.canonical, row.archive, row.full, row.prefix) != row.want {
+				t.Fatal("unsafe fixed-role cut classification")
+			}
+		})
+	}
+}
+
+func TestRuntimeFreshRecoveryFixedRoleRecipesBoundProtectedPlanAndEmptyWrite(t *testing.T) {
+	a := freshPublicationFixture()
+	old := a.Args
+	old.Size = 0
+	old.Body = sha256.Sum256(nil)
+	r := runtimeFreshRoleRetention{Schema: 1, Transaction: a.Transaction, Role: runtimeFreshRoleArgs, Parent: a.Authority, Controller: a.Controller, ParentDescriptor: [32]byte{1}, ControllerDescriptor: a.ControllerDescriptor, Plan: a.Intent, SourcePlan: a.Initialization, Old: old, DesiredSize: 32, Desired: sha256.Sum256([]byte("actual original intended args"))}
