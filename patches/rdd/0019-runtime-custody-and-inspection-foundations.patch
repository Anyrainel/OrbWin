+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+func TestServingImageActualOutputCustodyNeverLosesUnknown(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		h       windows.Handle
+		err     error
+		unknown bool
+	}{{"precise absent", 0, windows.STATUS_OBJECT_NAME_NOT_FOUND, false}, {"error-valid absent", 42, windows.STATUS_OBJECT_NAME_NOT_FOUND, true}, {"success missing", 0, nil, true}, {"positive", 42, nil, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			l := &ServingImageLease{}
