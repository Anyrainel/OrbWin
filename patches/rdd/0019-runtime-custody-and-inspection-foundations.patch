+//go:build windows
+
+package controllers
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+)
+
+func requireUnheldLifecyclePolicy() error {
+	return productUnheldLifecyclePolicy(instance.Suffix())
+}
+
+// Refusal only: PID files, event names and registration names cannot authorize
+// forced termination, unregister/reimport, or destructive stale-state cleanup.
+func productUnheldLifecyclePolicy(scope string) error {
+	if strings.EqualFold(scope, "orbwin") {
+		return reconcile.TerminalError(errors.New("OrbWin retains existing state: forced lifecycle recovery requires held native process and registration authority"))
+	}
+	return nil
+}
