+	for _, rawBool := range []uintptr{1, 2, uintptr(1)<<32 | 1} {
+		for _, h := range []uintptr{1, 42, uintptr(1)<<32 | 42} {
+			for _, stale := range []uint32{0, 5, 996, 997, 1008} {
+				if runtimeStorageClassifyTokenOpen(rawBool, h, stale, false) != runtimeStorageNativeOpenSuccess {
+					t.Fatal("positive token BOOL or wide output lost", rawBool, h, stale)
+				}
+			}
+		}
+	}
+	if runtimeStorageClassifyTokenOpen(uintptr(1)<<32, 0, 1008, true) != runtimeStorageNativeOpenFailure {
+		t.Fatal("high register garbage became BOOL success")
