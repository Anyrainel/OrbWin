+func TestUpgradeTCPTableRetainsRemoteIPv4AndIPv6(t *testing.T) {
+	// Fixed MIB_TCPROW_OWNER_PID / MIB_TCP6ROW_OWNER_PID wire vectors:
+	// server :6443, remote client :54001, ESTABLISHED, PID 123.
