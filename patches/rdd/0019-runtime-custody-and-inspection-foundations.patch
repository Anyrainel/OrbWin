+package managementconfig
+
+// PUBLIC-only build inputs, independently supplied by the trusted operator.
+// Empty/unconfigured builds refuse. Never read candidate/renderer/environment
+// keys, LAN self-described keys or private signing material here.
+var modernCandidateVerifierPublicKeyHex string
+var modernCandidateVerifierTrustScope string
+
+func compiledModernCandidateVerifier() (modernCandidateVerifier, error) {
+	return parseModernCandidateVerifier(modernCandidateVerifierPublicKeyHex, modernCandidateVerifierTrustScope)
+}
+
+// The future actual old-native issuer must call this no-config binding below
+// its original owner/file/buffer guards. Returned signed DATA grants no native
+// image, old-process, launch, write, retirement or admission capability.
+func verifyCompiledModernCandidateStatement(raw, signature []byte) (modernCandidateStatementData, error) {
+	v, e := compiledModernCandidateVerifier()
+	if e != nil {
+		return modernCandidateStatementData{}, e
+	}
+	return v.verify(raw, signature)
+}
