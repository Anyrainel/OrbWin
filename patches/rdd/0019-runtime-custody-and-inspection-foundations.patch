+		return errFreshRuntimePending
+	}
+	if response.StatusCode < 200 || response.StatusCode > 299 || json.Unmarshal(data, output) != nil {
+		return ErrUpgrade
+	}
+	if ctx.Err() != nil || w.unknown {
+		return ErrUpgrade
+	}
+	return nil
+}
