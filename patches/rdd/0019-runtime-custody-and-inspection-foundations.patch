@@ -0,0 +1,101 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshTupleUnbornAndCopiedCreatedCannotReachProvider(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	o := &FreshSetupOwner{captureComplete: true}
+	o.self = o
+	n := &nativeRuntimeStorage{}
+	n.captureSelf = n
+	o.storage = n
+	c := &Created{servingLease: true}
+	o.created = c
+	s := &nativeFreshAuthorityTupleState{owner: o, created: c}
+	s.self = s
+	c.freshAuthority = s
+	if _, _, _, e := c.LoadOrResumeDefaultAuthority(ctx); e == nil || len(n.resources) != 0 {
+		t.Fatal("unregistered tuple state reached native queries")
+	}
+	if object, e := s.selectTupleLocked(ctx, nil); e == nil || object != nil || len(n.resources) != 0 {
+		t.Fatal("unborn tuple slots reached filesystem")
+	}
+	copy := &Created{freshAuthority: s, servingLease: true}
+	if _, _, _, e := copy.LoadOrResumeDefaultAuthority(ctx); e == nil || len(n.resources) != 0 {
+		t.Fatal("copied Created borrowed original tuple")
+	}
+	c.closed = true
+	c.closeErr = ErrCreate
+	if _, _, _, e := c.LoadOrResumeDefaultAuthority(ctx); e == nil || len(n.resources) != 0 {
+		t.Fatal("borrowed unknown reached native tuple")
+	}
+}
+
+func TestRuntimeFreshTupleBorrowedUnknownAndLiveChildPrecedeCreatedClose(t *testing.T) {
+	for _, state := range []string{"storage unknown", "image unknown", "live child"} {
+		t.Run(state, func(t *testing.T) {
+			n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+			n.captureSelf = n
+			o := &FreshSetupOwner{storage: n, captureComplete: true}
+			o.self = o
+			c := &Created{anchor: 42, servingLease: true, authorityHandles: []windows.Handle{43}}
+			o.created = c
+			s := &nativeFreshAuthorityTupleState{owner: o, created: c}
+			s.self = s
+			c.freshAuthority = s
+			image := &ServingImageLease{captureComplete: true}
+			image.captureSelf = image
+			o.image = image
+			freshSetupOwners.Lock()
+			freshSetupOwners.owners[o] = true
+			freshSetupOwners.Unlock()
+			runtimeStorageDomain.Lock()
+			oldFailed := runtimeStorageDomain.failed
+			runtimeStorageDomain.failed = false
+			runtimeStorageDomain.owners[n] = true
+			runtimeStorageDomain.Unlock()
+			t.Cleanup(func() {
+				freshSetupOwners.Lock()
+				delete(freshSetupOwners.owners, o)
+				freshSetupOwners.Unlock()
+				runtimeStorageDomain.Lock()
+				delete(runtimeStorageDomain.owners, n)
+				runtimeStorageDomain.failed = oldFailed
+				runtimeStorageDomain.Unlock()
+			})
+			switch state {
+			case "storage unknown":
+				n.unknown = true
+			case "image unknown":
+				image.err = ErrCreate
+			case "live child":
+				birth := &ManagedHostagentBirth{parent: image}
+				birth.self = birth
+				image.managedBirths = []*ManagedHostagentBirth{birth}
+			}
+			if c.Close() == nil || c.closed || c.closeErr != nil || c.anchor != 42 || len(c.authorityHandles) != 1 || c.authorityHandles[0] != 43 {
+				t.Fatal("borrowed unknown/live child consumed original Created close or handles")
+			}
+			if state != "live child" && (!o.unknown || !n.unknown) {
+				t.Fatal("borrowed uncertainty did not fence original outer/storage")
+			}
+			copy := &Created{freshAuthority: s, anchor: 44}
+			if copy.Close() == nil || copy.closed || copy.anchor != 44 {
+				t.Fatal("copied Created closed original tuple owner")
+			}
+			c.closed = true
+			c.closeErr = ErrCreate
+			if c.Close() != ErrCreate {
+				t.Fatal("cached failure was retried or lost")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_boundary.go b/rdd/pkg/managementconfig/runtime_fresh_boundary.go
new file mode 100644
index 0000000000000000000000000000000000000000..82a3797ef5acfd6646adcf1e55ad51131dd70f1e
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_boundary.go
@@ -0,0 +1,54 @@
+package managementconfig
+
+// Closed native constructor roles, assigned only by the actual allocator. The
+// existing route never acquires fresh child-creation semantics from a flag.
+type runtimeStorageCaptureKind uint8
+
+const (
+	runtimeStorageExistingCapture runtimeStorageCaptureKind = iota
+	runtimeStorageFreshCapture
+)
+
+// DATA ordering only. No callback can return or construct a native directory,
+// root/storage owner, fresh-state assertion or publication authority.
+type runtimeFreshBoundaryProbe uint8
+
+const (
+	runtimeFreshBoundaryUnknown runtimeFreshBoundaryProbe = iota
+	runtimeFreshBoundaryExisting
+	runtimeFreshBoundaryMissing
+)
+
+func runtimeStorageFreshPrefixSequence(count int, inspect func(int) error, edge func(int) error) error {
+	if count < 2 || count > 255 || inspect == nil || edge == nil {
+		return ErrUpgrade
+	}
+	for i := 0; i < count; i++ {
+		if e := inspect(i); e != nil {
+			return e
+		}
+		if i > 0 {
+			if e := edge(i); e != nil {
+				return e
+			}
+		}
+	}
+	return nil
+}
+
+// A create collision/error never reaches admission or an existing-object
+// adoption callback. The actual native caller owns every slot before effects.
+func runtimeStorageFreshBoundarySequence(kind runtimeFreshBoundaryProbe, checkPrefix, create, admit func() error) error {
+	if kind != runtimeFreshBoundaryExisting && kind != runtimeFreshBoundaryMissing || checkPrefix == nil || create == nil || admit == nil {
+		return ErrUpgrade
+	}
+	if e := checkPrefix(); e != nil {
+		return e
+	}
+	if kind == runtimeFreshBoundaryMissing {
+		if e := create(); e != nil {
+			return e
+		}
+	}
+	return admit()
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_boundary_test.go b/rdd/pkg/managementconfig/runtime_fresh_boundary_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e0cff67a6c9bf63172cdb4cb7150d8d993d4af06
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_boundary_test.go
@@ -0,0 +1,115 @@
+package managementconfig
+
+import "testing"
+
+func TestRuntimeFreshPrefixAllInspectionsAndEdgesBeforeBoundary(t *testing.T) {
+	for fail := 0; fail < 7; fail++ {
+		seen := []int{}
+		effects := 0
+		inspect := func(i int) error {
+			seen = append(seen, 2*i)
+			if len(seen)-1 == fail {
+				return ErrUpgrade
+			}
+			return nil
+		}
+		edge := func(i int) error {
+			seen = append(seen, 2*i-1)
+			if len(seen)-1 == fail {
+				return ErrUpgrade
+			}
+			return nil
+		}
+		e := runtimeStorageFreshBoundarySequence(runtimeFreshBoundaryMissing, func() error { return runtimeStorageFreshPrefixSequence(4, inspect, edge) }, func() error { effects++; return nil }, func() error { effects++; return nil })
+		if e == nil || effects != 0 || len(seen) != fail+1 {
+			t.Fatal("boundary effect crossed failed prefix observation", fail, seen)
+		}
+	}
+	for _, count := range []int{0, 1, 256} {
+		calls := 0
+		if runtimeStorageFreshPrefixSequence(count, func(int) error { calls++; return nil }, func(int) error { calls++; return nil }) == nil || calls != 0 {
+			t.Fatal("invalid prefix reached observations")
+		}
+	}
+}
+
+func TestRuntimeFreshBoundaryCreateCollisionNeverAdoptsOrRetries(t *testing.T) {
+	for _, kind := range []runtimeFreshBoundaryProbe{runtimeFreshBoundaryUnknown, runtimeFreshBoundaryExisting, runtimeFreshBoundaryMissing} {
+		for _, fail := range []string{"none", "prefix", "create", "admit"} {
+			prefix, create, admit := 0, 0, 0
+			e := runtimeStorageFreshBoundarySequence(kind, func() error {
+				prefix++
+				if fail == "prefix" {
+					return ErrUpgrade
+				}
+				return nil
+			}, func() error {
+				create++
+				if fail == "create" {
+					return ErrUpgrade
+				}
+				return nil
+			}, func() error {
+				admit++
+				if fail == "admit" {
+					return ErrUpgrade
+				}
+				return nil
+			})
+			if kind == runtimeFreshBoundaryUnknown {
+				if e == nil || prefix+create+admit != 0 {
+					t.Fatal("unknown probe reached effect")
+				}
+				continue
+			}
+			if prefix != 1 || create > 1 || admit > 1 {
+				t.Fatal("replayed boundary effects")
+			}
+			if fail == "prefix" {
+				if e == nil || create+admit != 0 {
+					t.Fatal("continued after prefix loss")
+				}
+				continue
+			}
+			if kind == runtimeFreshBoundaryExisting && create != 0 {
+				t.Fatal("existing strict boundary rewritten")
+			}
+			if kind == runtimeFreshBoundaryMissing && fail == "create" {
+				if e == nil || create != 1 || admit != 0 {
+					t.Fatal("collision/error auto-adopted or retried")
+				}
+				continue
+			}
+			if admit != 1 {
+				t.Fatal("missing final native route admission")
+			}
+		}
+	}
+}
+
+func TestRuntimeFreshPrefixDoesNotWeakenExistingBoundaryPolicy(t *testing.T) {
+	// Prefix inspection is DATA only. Even after a fresh creator completes, the
+	// original full route must independently admit the strict final boundary.
+	if runtimeStorageFreshPrefixSequence(2, func(int) error { return nil }, func(int) error { return nil }) != nil {
+		t.Fatal("bounded prefix DATA ordering failed")
+	}
+	for _, final := range []runtimeStorageRouteFacts{{}, {strict: true}, {protected: true}} {
+		e := runtimeStorageRouteSequence(3, func(i int) (runtimeStorageRouteFacts, error) {
+			if i == 2 {
+				return final, nil
+			}
+			return runtimeStorageRouteFacts{}, nil
+		}, func(int) error { return nil })
+		if e == nil {
+			t.Fatal("conditional unsafe prefix bypassed original protected+strict boundary")
+		}
+	}
+	if runtimeStorageRouteSequence(3, func(i int) (runtimeStorageRouteFacts, error) {
+		if i == 2 {
+			return runtimeStorageRouteFacts{strict: true, protected: true}, nil
+		}
+		return runtimeStorageRouteFacts{}, nil
+	}, func(int) error { return nil }) != nil {
+		t.Fatal("unchanged protected+strict DATA predicate refused")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_boundary_windows.go b/rdd/pkg/managementconfig/runtime_fresh_boundary_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b393b453536ab8c1613856897845c04253a0a9ab
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_boundary_windows.go
@@ -0,0 +1,231 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+)
+
+// Fixed separate allocator. The existing constructor cannot enable creation
+// via caller metadata or an absent-path flag. Actual selection/root admission
+// and the one-use registered storage graph are unchanged.
+func allocateNativeFreshRuntimeStorageCapture(ctx context.Context, root *InstanceRoot) (*nativeRuntimeStorage, error) {
+	n, e := allocateNativeRuntimeStorageCapture(ctx, root)
+	if e != nil {
+		return nil, e
+	}
+	n.mu.Lock()
+	n.captureKind = runtimeStorageFreshCapture
+	n.mu.Unlock()
+	return n, nil
+}
+func (n *nativeRuntimeStorage) captureNativeFresh(ctx context.Context) error {
+	if n == nil || n.captureKind != runtimeStorageFreshCapture {
+		return ErrUpgrade
+	}
+	return n.captureNativeCore(ctx)
+}
+
+// Pure exact-birth/phase check, never a directory grant or native observation.
+func (n *nativeRuntimeStorage) beginFreshPublicRoute(ctx context.Context) bool {
+	if n == nil || n.captureSelf != n || ctx == nil || ctx.Err() != nil {
+		return false
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return false
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtimeStorageDomain.Lock()
+	defer runtimeStorageDomain.Unlock()
+	if n.captureKind != runtimeStorageFreshCapture || !n.captureStarted || n.captureComplete || n.freshRouteStarted || n.closeAttempted || n.unknown || n.root == nil || n.root.selection == nil || !runtimeStorageDomain.owners[n] || runtimeStorageDomain.failed {
+		return false
+	}
+	n.freshRouteStarted = true
+	return true
+}
+func (n *nativeRuntimeStorage) checkFreshPrivatePrefix(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	if n.captureSelf != n || n.captureKind != runtimeStorageFreshCapture || !n.captureStarted || n.captureComplete || !n.freshRouteStarted || n.closeAttempted || n.unknown || n.root == nil || n.root.selection == nil {
+		return ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known || len(n.ancestry) < 2 || n.checkToken() != nil {
+		return ErrUpgrade
+	}
+	for _, o := range n.ancestry {
+		if n.checkObject(o) != nil {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+func (n *nativeRuntimeStorage) freshRouteOpen(ctx context.Context, parent windows.Handle, name string, disposition uint32, sd *windows.SECURITY_DESCRIPTOR) (*runtimeStorageResource, error) {
+	if n == nil || n.captureSelf != n || ctx == nil || ctx.Err() != nil || n.captureKind != runtimeStorageFreshCapture || !n.captureStarted || !n.freshRouteStarted || n.captureComplete || n.closeAttempted || n.unknown {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	if disposition != windows.FILE_OPEN && disposition != windows.FILE_CREATE || disposition == windows.FILE_CREATE && (name != "OrbWinData" || sd == nil) || disposition == windows.FILE_OPEN && sd != nil {
+		return nil, ErrUpgrade
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known {
+		return nil, ErrUpgrade
+	}
+	parentOwned := false
+	for _, r := range n.resources {
+		if r != nil && r.handle == parent && parent != 0 && parent != windows.InvalidHandle && !r.attempted {
+			parentOwned = true
+			break
+		}
+	}
+	if !parentOwned {
+		return nil, ErrUpgrade
+	}
+	_, parts, e := readerComponents(`C:\` + name)
+	if e != nil || len(parts) != 1 {
+		return nil, ErrUpgrade
+	}
+	// The fixed Fresh role gates above select this exact traversal/create;
+	// generic native custody supplies original HANDLE/IOSB/text/OA/SD retention.
+	h, e := n.open(parent, name, true, disposition, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, sd)
+	if e != nil {
+		return nil, e
+	}
+	r := n.keep(h) // Attach the exact preregistered success output, never a clone.
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return r, nil
+}
+
+func (r *nativeRuntimePublicRoute) checkFreshPrefix(n *nativeRuntimeStorage, ctx context.Context) error {
+	if r == nil || n.checkFreshPrivatePrefix(ctx) != nil {
+		return ErrUpgrade
+	}
+	return runtimeStorageFreshPrefixSequence(len(r.nodes), func(i int) error {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		_, e := r.inspectNode(n, i)
+		return e
+	}, func(i int) error { return r.verifyEdge(n, i) })
+}
+
+// Concrete fresh route, before the SAME setup.lock acquisition. Existing
+// strict boundary policy is unchanged. Only a precise no-output name-not-found
+// for final fixed OrbWinData permits one protected CREATE_NEW. A racing creator
+// collision refuses without retry, adoption, ACL repair or speculative delete.
+func (n *nativeRuntimeStorage) captureFreshPublicRoute(ctx context.Context) (out *nativeRuntimePublicRoute, result error) {
+	if !n.beginFreshPublicRoute(ctx) {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			panic(p)
+		}
+	}()
+	if n.checkFreshPrivatePrefix(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	volume, parts, e := readerComponents(n.local)
+	if e != nil || len(parts) == 0 || len(parts) > 253 {
+		return nil, ErrUpgrade
+	}
+	root, e := n.freshVolumeRoot(ctx, volume)
+	if e != nil {
+		return nil, e
+	}
+	r := &nativeRuntimePublicRoute{}
+	node, e := n.captureOwnedRouteNode(root, "")
+	if e != nil {
+		return nil, e
+	}
+	r.nodes = append(r.nodes, node)
+	for _, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		slot, e := n.freshRouteOpen(ctx, node.resource.handle, part, windows.FILE_OPEN, nil)
+		if e != nil {
+			return nil, e
+		}
+		node, e = n.captureOwnedRouteNode(slot, part)
+		if e != nil {
+			return nil, e
+		}
+		r.nodes = append(r.nodes, node)
+	}
+	if r.checkFreshPrefix(n, ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	// LocalAppData prefix remains a held pending routing observation. It is NOT
+	// admitted as an ordinary public destination by the prefix-only check.
+	parent := node.resource.handle
+	slot, e := n.freshRouteOpen(ctx, parent, "OrbWinData", windows.FILE_OPEN, nil)
+	kind := runtimeFreshBoundaryUnknown
+	if e == nil {
+		kind = runtimeFreshBoundaryExisting
+	} else if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		kind = runtimeFreshBoundaryMissing
+	} else {
+		return nil, e
+	}
+	if e = runtimeStorageFreshBoundarySequence(kind, func() error { return r.checkFreshPrefix(n, ctx) }, func() error {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		sd, e := privateDescriptor(n.sid, true)
+		if e != nil {
+			return e
+		}
+		slot, e = n.freshRouteOpen(ctx, parent, "OrbWinData", windows.FILE_CREATE, sd)
+		if e != nil {
+			return e
+		}
+		// Inspect the actual newly created object; the requested SD is not evidence.
+		if verifyPrivate(slot.handle, n.sid, true) != nil {
+			return ErrUpgrade
+		}
+		return nil
+	}, func() error {
+		if slot == nil || ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		leaf, e := n.captureOwnedRouteNode(slot, "OrbWinData")
+		if e != nil {
+			return e
+		}
+		if kind == runtimeFreshBoundaryMissing && (!leaf.facts.strict || !leaf.facts.protected) {
+			return ErrUpgrade
+		}
+		r.nodes = append(r.nodes, leaf)
+		if r.check(n) != nil {
+			return ErrUpgrade
+		}
+		// SAME actual creator/open output and measured descriptor; no by-name leaf
+		// substitution occurs before the existing controller admission below.
+		r.boundary = &runtimeStorageObject{resource: leaf.resource, identity: leaf.identity, directory: true}
+		return nil
+	}); e != nil {
+		return nil, e
+	}
+	return r, nil
+}
