+		return zero, ErrUpgrade
+	}
+	// The validator permits partial completion predecessors, and exactly one
+	// complete final record. Its actual file witness, not decoded DATA, is linked.
+	for _, v := range completions {
+		var c runtimeFreshDenialCompletion
+		if parseRuntimeFreshRecord(v.Body, &c) == nil && c == *complete {
+			return v.File, nil
+		}
+	}
+	return zero, ErrUpgrade
+}
