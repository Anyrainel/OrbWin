+// owner.mu/witness.mu/publisher.mu are held. Do not carry storage/Created
+// mutexes into network waits. Only the same actual native backend is admitted.
+func (w *FreshRuntimeObservation) checkParentsLocked(ctx context.Context) error {
+	o, c, p := w.owner, w.created, w.publisher
+	if o == nil || c == nil || p == nil {
+		return ErrUpgrade
+	}
+	if p.closeErr != nil || p.pending != nil {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
