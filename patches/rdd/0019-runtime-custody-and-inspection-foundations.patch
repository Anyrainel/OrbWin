@@ -0,0 +1,154 @@
+//go:build windows
+
+package controllers
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	app "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/app/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/apis/lima/v1alpha1"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/networkproxy"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/util/lifecyclefailure"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+)
+
+type managedHostagent struct {
+	authority *managementconfig.ManagedRuntimeAuthority
+	birth     *managementconfig.ManagedHostagentBirth
+	retired   atomic.Bool
+}
+
+func managedWatcherRetired(state *instanceState) bool {
+	return state != nil && state.managed != nil && state.managed.retired.Load()
+}
+
+func (r *LimaVMReconciler) shutdownManagedHostagent(ctx context.Context, name string) (handled bool, result error) {
+	if !productManagedHostagent() {
+		return false, nil
+	}
+	defer func() {
+		if result != nil {
+			lifecyclefailure.Record(ctx)
+		}
+	}()
+	r.instanceStatesMu.RLock()
+	state := r.instanceStates[name]
+	r.instanceStatesMu.RUnlock()
+	if state == nil || state.managed == nil || state.managed.authority == nil || state.managed.birth == nil || state.cmd == nil || state.cmd.Process == nil {
+		return true, reconcile.TerminalError(errors.New("original owned hostagent retirement unavailable"))
+	}
+	m := state.managed
+	if m.retired.Load() {
+		return true, nil
+	}
+	// The manager cancellation initiates this real cleanup; it must not cancel
+	// the original child's chance to run driver.Stop. This one bounded owner
+	// still relies on the watcher's sole Wait and native namespace evidence.
+	bounded, cancel := context.WithTimeout(context.Background(), gracefulShutdownTimeout)
+	defer cancel()
+	select {
+	case <-state.procExited:
+	default:
+		if m.authority.PrepareHostagentStop(bounded, m.birth) != nil || m.authority.SignalHostagentStop(bounded, m.birth) != nil {
+			return true, reconcile.TerminalError(errors.New("owned hostagent graceful signal unavailable"))
+		}
+	}
+	if m.authority.RetireHostagent(bounded, m.birth) != nil {
+		return true, reconcile.TerminalError(errors.New("owned hostagent retirement unknown"))
+	}
+	m.retired.Store(true)
+	return true, nil
+}
+
+func (m *managedHostagent) recordWait(e error) {
+	if m != nil && m.birth != nil {
+		_ = m.birth.RecordOriginalWait(e)
+	}
+}
+
+func productManagedHostagent() bool { return strings.EqualFold(instance.Suffix(), "orbwin") }
+
+func (r *LimaVMReconciler) startManagedHostagentWithProxy(ctx context.Context, cmd *exec.Cmd, vm *v1alpha1.LimaVM) (*v1alpha1.NetworkProxyLaunchObservation, bool, error) {
+	if !productManagedHostagent() {
+		return nil, false, nil
+	}
+	if ctx == nil || ctx.Err() != nil || r.ManagedRuntime == nil {
+		return nil, true, errors.New("owned original hostagent launch unavailable")
+	}
+	probe, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	launch, e := r.ManagedRuntime.PrepareHostagentLaunch(probe, cmd)
+	if e != nil {
+		return nil, true, e
+	}
+	var owner app.App
+	var selected *app.App
+	if r.ProxyServing != nil && r.Client != nil && r.Get(probe, types.NamespacedName{Name: "app"}, &owner) == nil {
+		selected = &owner
+	}
+	home, e := os.UserHomeDir()
+	if e != nil {
+		_ = launch.Close() // no Start/child occurred; checked failure fences parent
+		return nil, true, e
+	}
+	observed, e := networkproxy.StartManagedHostagentObserved(probe, cmd, r.ProxyServing, selected, vm, networkproxy.ManagementInstanceRoot{Home: home, Suffix: "orbwin"}, launch)
+	if e != nil && cmd.Process == nil {
+		if launch.Close() != nil {
+			return nil, true, errors.New("owned launch settlement unknown")
+		}
+	}
+	return observed, true, e
+}
+
+func (r *LimaVMReconciler) requireManagedHostagent(ctx context.Context, vm *v1alpha1.LimaVM) error {
+	if !productManagedHostagent() {
+		return nil
+	}
+	if ctx == nil || ctx.Err() != nil || vm == nil || vm.Name != "orbwin" || vm.Namespace != "rancher-desktop" || r.ManagedRuntime == nil {
+		return reconcile.TerminalError(errors.New("owned native hostagent lifetime unavailable"))
+	}
+	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	if r.ManagedRuntime.RequireHostagentLaunch(bounded) != nil {
+		return reconcile.TerminalError(errors.New("owned native hostagent lifetime unavailable"))
+	}
+	return nil
+}
+
+func managedHostagentCommand(ctx context.Context, path string, args ...string) *exec.Cmd {
+	if !productManagedHostagent() {
+		return exec.CommandContext(ctx, path, args...)
+	}
+	// Its ORIGINAL service owns explicit graceful retirement. Manager context
+	// cancellation must not Kill the child before its actual driver.Stop runs.
+	return exec.Command(path, args...)
+}
+
+func (r *LimaVMReconciler) captureManagedHostagent(ctx context.Context, cmd *exec.Cmd) (*managedHostagent, error) {
+	if !productManagedHostagent() {
+		return nil, nil
+	}
+	m := &managedHostagent{authority: r.ManagedRuntime}
+	if cmd == nil || cmd.Process == nil || m.authority == nil {
+		return m, reconcile.TerminalError(errors.New("original hostagent birth unavailable"))
+	}
+	// Start already returned a real original child. Cancellation cannot skip
+	// its custody/reaping; use an independent bounded settlement context.
+	bounded, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var e error
+	m.birth, e = m.authority.CaptureHostagent(bounded, cmd.Process)
+	if e != nil {
+		return m, reconcile.TerminalError(errors.New("original hostagent birth capture unavailable"))
+	}
+	return m, nil
+}
