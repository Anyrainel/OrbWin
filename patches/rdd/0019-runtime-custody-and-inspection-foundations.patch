@@ -0,0 +1,397 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"io"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual fixed legacy args observation, not prepared-intent/old-process authority.
+// Lock order: observation.mu -> storage.mu -> inventory.mu. All native file
+// ownership is registered in the SAME storage graph before inspection. Its Close
+// therefore retires this cap before setup.lock, even if this observation survives.
+type nativeRuntimeUpgradeArgs struct {
+	mu              sync.Mutex
+	self            *nativeRuntimeUpgradeArgs
+	storage         *nativeRuntimeStorage
+	inventory       *upgradeLegacyInventory
+	resource        *runtimeStorageResource
+	identity        runtimeStorageIdentity
+	body            []byte
+	hash            [32]byte
+	closed, unknown bool
+}
+
+var runtimeUpgradeArgsCustody = struct {
+	sync.Mutex
+	owners map[*nativeRuntimeUpgradeArgs]bool
+}{owners: map[*nativeRuntimeUpgradeArgs]bool{}}
+
+// Pure admission before OS-thread/native work. Constructor identity is immutable;
+// completion and mutable close state are published/checked under the SAME birth
+// mutexes. A value copy can never select an independent mutex/resources slice.
+func runtimeUpgradeArgsOwnersKnown(n *nativeRuntimeStorage, l *upgradeLegacyInventory) bool {
+	if n == nil || l == nil || n.captureSelf != n || l.captureSelf != l {
+		return false
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return runtimeUpgradeArgsOwnersKnownLocked(n, l)
+}
+
+// Caller holds actual storage.mu -> inventory.mu. No native calls.
+func runtimeUpgradeArgsOwnersKnownLocked(n *nativeRuntimeStorage, l *upgradeLegacyInventory) bool {
+	if n == nil || l == nil || n.captureSelf != n || l.captureSelf != l || !n.captureStarted || !n.captureComplete || n.closeAttempted || n.unknown || !l.captureComplete || l.closed || l.closeErr != nil {
+		return false
+	}
+	runtimeStorageDomain.Lock()
+	defer runtimeStorageDomain.Unlock()
+	return runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+}
+
+func (o *nativeRuntimeUpgradeArgs) fenceLocked() {
+	o.unknown = true
+	o.storage.fence() // storage.mu held; retains the actual controller graph.
+}
+
+// storage.mu + inventory.mu held. A selected pathname is only a rejection
+// predicate: actual parent and args FILE_OBJECT identities supply the binding.
+func (o *nativeRuntimeUpgradeArgs) checkParentsLocked() (UpgradeObject, error) {
+	n, l := o.storage, o.inventory
+	if !runtimeUpgradeArgsOwnersKnownLocked(n, l) || n.root == nil || n.root.selection == nil || l.parents == nil || l.parents.sid != n.sid || len(l.parents.chain) == 0 || n.checkPrevious() != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	parent := l.parents.leaf()
+	id, e := upgradeObjectID(parent)
+	if e != nil || id != l.root || objectKind(parent, true) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	var name [4096]uint16
+	count, e := windows.GetFinalPathNameByHandle(parent, &name[0], uint32(len(name)), 0)
+	if e != nil || count == 0 || count >= uint32(len(name)) || !strings.EqualFold(windows.UTF16ToString(name[:count]), `\\?\`+n.root.selection.LegacyDirectory()) {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	var want UpgradeObject
+	for _, entry := range l.entries {
+		if entry.Role == "args" {
+			if want.valid() || entry.Fact.Parent != "root" || entry.Fact.Name != "args.json" || entry.Fact.Directory || entry.Fact.Reparse || entry.Fact.Links != 1 {
+				return UpgradeObject{}, ErrUpgrade
+			}
+			want = entry.Fact.Object
+		}
+	}
+	if !want.valid() || want.Volume != id.Volume {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	return want, nil
+}
+
+// Does not classify the historical descriptor as credential authority. Sharing
+// denial pins bytes and name; descriptor equality is checked as an observation.
+func runtimeUpgradeArgsIdentity(h windows.Handle) (runtimeStorageIdentity, error) {
+	var id runtimeStorageIdentity
+	var info windows.ByHandleFileInformation
+	if h == 0 || h == windows.InvalidHandle || objectKind(h, false) != nil || windows.GetFileInformationByHandle(h, &info) != nil || info.NumberOfLinks != 1 || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > runtimeUpgradeArgsBudget {
+		return id, ErrUpgrade
+	}
+	id, e := runtimeStorageMeasureIdentity(h, false)
+	if e != nil || id.links != 1 || id.attributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 || id.size == 0 || id.size > runtimeUpgradeArgsBudget {
+		return runtimeStorageIdentity{}, ErrUpgrade
+	}
+	return id, nil
+}
+
+func (o *nativeRuntimeUpgradeArgs) readLocked(ctx context.Context) ([]byte, error) {
+	h := o.resource.handle
+	return readRuntimeUpgradeArgs(ctx, o.identity.size, func() error { _, e := windows.Seek(h, 0, 0); return e }, func(b []byte) (uint32, error) {
+		var count uint32
+		e := windows.ReadFile(h, b, &count, nil)
+		if e == windows.ERROR_HANDLE_EOF {
+			e = io.EOF
+		}
+		return count, e
+	})
+}
+
+// Real native constructor only. No args bytes/path/identity input, journal, DTO,
+// native opener callback or public positive constructor exists.
+func captureRuntimeUpgradeArgs(ctx context.Context, n *nativeRuntimeStorage, l *upgradeLegacyInventory) (out *nativeRuntimeUpgradeArgs, result error) {
+	if ctx == nil || ctx.Err() != nil || n == nil || l == nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	if !runtimeUpgradeArgsOwnersKnown(n, l) {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	o := &nativeRuntimeUpgradeArgs{storage: n, inventory: l}
+	o.self = o
+	runtimeUpgradeArgsCustody.Lock()
+	if len(runtimeUpgradeArgsCustody.owners) >= 16 {
+		runtimeUpgradeArgsCustody.Unlock()
+		return nil, ErrUpgrade
+	}
+	runtimeUpgradeArgsCustody.owners[o] = true
+	runtimeUpgradeArgsCustody.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLocked()
+			panic(p)
+		}
+		if result != nil {
+			if !o.unknown && o.resource != nil && n.closeOne(o.resource) != nil {
+				o.fenceLocked()
+				out = o
+			}
+			clear(o.body)
+			if o.unknown {
+				out = o
+			} else {
+				runtimeUpgradeArgsCustody.Lock()
+				delete(runtimeUpgradeArgsCustody.owners, o)
+				runtimeUpgradeArgsCustody.Unlock()
+			}
+		}
+	}()
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	want, e := o.checkParentsLocked()
+	if e != nil {
+		return nil, e
+	}
+	text, e := windows.NewNTUnicodeString("args.json")
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: l.parents.leaf(), ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	o.resource = n.keep(0) // publish the exact output slot before the syscall
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&o.resource.handle, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	// The actual output slot already belongs to the storage graph. A native
+	// error with a valid partial output fences without querying/closing it.
+	h := o.resource.handle
+	valid := h != 0 && h != windows.InvalidHandle
+	if runtimeStorageOpenReply(e, valid, func() {}, o.fenceLocked) != nil {
+		if !o.unknown {
+			if len(n.resources) == 0 || n.resources[len(n.resources)-1] != o.resource {
+				o.fenceLocked()
+			} else {
+				n.resources = n.resources[:len(n.resources)-1]
+				o.resource = nil
+			}
+		}
+		return nil, ErrUpgrade
+	}
+	o.identity, e = runtimeUpgradeArgsIdentity(h)
+	if e != nil || runtimeStorageObjectData(&runtimeStorageObject{identity: o.identity}) != want {
+		return nil, ErrUpgrade
+	}
+	o.body, e = o.readLocked(ctx)
+	if e != nil {
+		return nil, e
+	}
+	o.hash, e = parseRuntimeUpgradeArgs(o.body)
+	if e != nil {
+		return nil, e
+	}
+	again, e := runtimeUpgradeArgsIdentity(h)
+	if e != nil || again != o.identity || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return o, nil
+}
+
+// Emits compatibility DATA only after actual retained cap and parent checks.
+func (o *nativeRuntimeUpgradeArgs) digest(ctx context.Context) ([32]byte, error) {
+	if o == nil || o.self != o || ctx == nil || ctx.Err() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return [32]byte{}, ErrUpgrade
+	}
+	if !runtimeUpgradeArgsOwnersKnown(o.storage, o.inventory) {
+		return [32]byte{}, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n, l := o.storage, o.inventory
+	if n == nil || l == nil || o.closed || o.unknown || o.resource == nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return o.digestLocked(ctx)
+}
+
+// Actual composed observer holds args.mu -> storage.mu -> inventory.mu and
+// OS-thread affinity. No new owner or positive observation is constructed here.
+func (o *nativeRuntimeUpgradeArgs) digestLocked(ctx context.Context) ([32]byte, error) {
+	if o == nil || o.self != o || ctx == nil || o.closed || o.unknown || o.resource == nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return [32]byte{}, ErrUpgrade
+	}
+	runtimeUpgradeArgsCustody.Lock()
+	known := runtimeUpgradeArgsCustody.owners[o]
+	runtimeUpgradeArgsCustody.Unlock()
+	if !known {
+		return [32]byte{}, ErrUpgrade
+	}
+	if ctx.Err() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	if o.resource.attempted || o.resource.handle == 0 {
+		return [32]byte{}, ErrUpgrade
+	}
+	want, e := o.checkParentsLocked()
+	if e != nil {
+		return [32]byte{}, e
+	}
+	id, e := runtimeUpgradeArgsIdentity(o.resource.handle)
+	if e != nil || id != o.identity || runtimeStorageObjectData(&runtimeStorageObject{identity: id}) != want {
+		return [32]byte{}, ErrUpgrade
+	}
+	body, e := o.readLocked(ctx)
+	defer clear(body)
+	after, f := runtimeUpgradeArgsIdentity(o.resource.handle)
+	if e != nil || f != nil || after != id || !bytes.Equal(body, o.body) || sha256.Sum256(body) != o.hash {
+		return [32]byte{}, ErrUpgrade
+	}
+	return o.hash, nil
+}
+
+// Closes only this actual storage-registered slot. Never closes borrowed
+// inventory/root/storage or releases setup.lock. Unknown close retains them.
+func (o *nativeRuntimeUpgradeArgs) Close() error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		return ErrUpgrade
+	}
+	if o.closed {
+		return nil
+	}
+	n := o.storage
+	if n == nil || n.captureSelf != n {
+		return ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLocked()
+			panic(p)
+		}
+	}()
+	if n.unknown || !runtimeStorageDomainKnown() {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	if o.resource != nil && n.closeOne(o.resource) != nil {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	clear(o.body)
+	o.body = nil
+	o.closed = true
+	runtimeUpgradeArgsCustody.Lock()
+	delete(runtimeUpgradeArgsCustody.owners, o)
+	runtimeUpgradeArgsCustody.Unlock()
+	return nil
+}
+
+// Immutable birth only. Mutable borrowed close/unknown state must be examined
+// together under observer -> args -> storage -> inventory, never rejected early.
+func runtimeUpgradeArgsBorrowedBirth(a *nativeRuntimeUpgradeArgs) bool {
+	return a != nil && a.self == a && a.storage != nil && a.storage.captureSelf == a.storage && a.inventory != nil && a.inventory.captureSelf == a.inventory
+}
+
+// These are phase DATA, not native authority. Caller holds its actual outer
+// mutex -> args.mu -> storage.mu -> inventory.mu, supplies only its own actual
+// storage-registered slots, and MUST fence both actual outer and storage owners
+// immediately on Unknown before querying or closing any of its own resources.
+type runtimeArgsBorrowedState uint8
+
+const (
+	runtimeBorrowedUnknown runtimeArgsBorrowedState = iota
+	runtimeBorrowedLive
+	runtimeBorrowedClosed
+	runtimeBorrowedStorageClosed
+)
+
+func runtimeArgsSlotClosed(r *runtimeStorageResource) bool {
+	return r != nil && r.attempted && r.closeErr == nil && r.handle == 0
+}
+func (a *nativeRuntimeUpgradeArgs) borrowedStateLocked(own []*runtimeStorageResource) runtimeArgsBorrowedState {
+	if !runtimeUpgradeArgsBorrowedBirth(a) {
+		return runtimeBorrowedUnknown
+	}
+	n, l := a.storage, a.inventory
+	runtimeStorageDomain.Lock()
+	member, failed := runtimeStorageDomain.owners[n], runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if n.unknown || n.closeErr != nil || failed || a.unknown || l.closeErr != nil || !n.captureStarted || !n.captureComplete || !l.captureComplete {
+		return runtimeBorrowedUnknown
+	}
+	if n.closeAttempted {
+		if member || !runtimeArgsSlotClosed(a.resource) {
+			return runtimeBorrowedUnknown
+		}
+		for _, r := range own {
+			if !runtimeArgsSlotClosed(r) {
+				return runtimeBorrowedUnknown
+			}
+		}
+		return runtimeBorrowedStorageClosed
+	}
+	if !member {
+		return runtimeBorrowedUnknown
+	}
+	if a.closed {
+		if !runtimeArgsSlotClosed(a.resource) {
+			return runtimeBorrowedUnknown
+		}
+		return runtimeBorrowedClosed
+	}
+	runtimeUpgradeArgsCustody.Lock()
+	known := runtimeUpgradeArgsCustody.owners[a]
+	runtimeUpgradeArgsCustody.Unlock()
+	if !known || a.resource == nil || a.resource.attempted || a.resource.handle == 0 || a.resource.handle == windows.InvalidHandle {
+		return runtimeBorrowedUnknown
+	}
+	if l.closed {
+		return runtimeBorrowedClosed
+	}
+	return runtimeBorrowedLive
+}
diff --git a/rdd/pkg/managementconfig/runtime_upgrade_operation_args_windows_test.go b/rdd/pkg/managementconfig/runtime_upgrade_operation_args_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..93c4f270a93521b5bfaf82b4e61902be3f258c22
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_upgrade_operation_args_windows_test.go
@@ -0,0 +1,116 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// Every path below refuses before native IO. No model creates a positive cap.
+func TestRuntimeUpgradeArgsNativeAuthorityNegatives(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if _, e := captureRuntimeUpgradeArgs(ctx, nil, nil); e == nil {
+		t.Fatal("missing actual owners")
+	}
+	for _, o := range []*nativeRuntimeUpgradeArgs{nil, {}, {self: &nativeRuntimeUpgradeArgs{}}} {
+		if _, e := o.digest(ctx); e == nil {
+			t.Fatal("DTO/copy issued digest")
+		}
+		if o.Close() == nil {
+			t.Fatal("DTO/copy closed authority")
+		}
+	}
+	cancel()
+	if _, e := captureRuntimeUpgradeArgs(ctx, &nativeRuntimeStorage{}, &upgradeLegacyInventory{}); e == nil {
+		t.Fatal("cancelled capture reached native IO")
+	}
+}
+
+func TestRuntimeUpgradeArgsExactBirthBeforeNativeIO(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	slot := &runtimeStorageResource{} // shared pointer only, never a native cap
+	n.resources = []*runtimeStorageResource{slot}
+	l := &upgradeLegacyInventory{captureComplete: true}
+	l.captureSelf = l
+	// These wrappers deliberately retain the original self pointers but have
+	// different mutexes/slice headers. No native handles or positive cap exists.
+	copiedStorage := &nativeRuntimeStorage{captureSelf: n, captureStarted: true, captureComplete: true, resources: n.resources, root: n.root}
+	copiedInventory := &upgradeLegacyInventory{captureSelf: l, captureComplete: true, parents: l.parents, children: l.children, entries: l.entries}
+	if copiedStorage.Close() == nil || copiedInventory.Close() == nil {
+		t.Fatal("copied close owner admitted")
+	}
+	forgedStorage := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	forgedStorage.captureSelf = forgedStorage // no actual registered storage birth
+	forgedInventory := &upgradeLegacyInventory{captureComplete: true}
+	forgedInventory.captureSelf = l
+	for _, pair := range []struct {
+		n *nativeRuntimeStorage
+		l *upgradeLegacyInventory
+	}{
+		{copiedStorage, l}, {n, copiedInventory}, {forgedStorage, l}, {n, forgedInventory}, {n, l},
+	} {
+		if runtimeUpgradeArgsOwnersKnown(pair.n, pair.l) {
+			t.Fatal("copy/unregistered owner admitted")
+		}
+		if o, e := captureRuntimeUpgradeArgs(ctx, pair.n, pair.l); e == nil || o != nil {
+			t.Fatal("copy/unregistered owner reached capture")
+		}
+		o := &nativeRuntimeUpgradeArgs{storage: pair.n, inventory: pair.l}
+		o.self = o
+		if _, e := o.digest(ctx); e == nil {
+			t.Fatal("copy/unregistered owner reached native digest")
+		}
+	}
+	// An actual map entry alone is insufficient. All these refusals happen
+	// before thread affinity, token/file queries, or allocation of an args slot.
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	defer func() {
+		runtimeStorageDomain.Lock()
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.Unlock()
+	}()
+	for _, which := range []string{"unstarted", "incomplete-storage", "incomplete-inventory", "closed-inventory", "copied-inventory", "closed-storage", "unknown-storage"} {
+		n.captureStarted, n.captureComplete = true, true
+		n.closeAttempted, n.unknown = false, false
+		l.captureComplete, l.closed = true, false
+		selected := l
+		switch which {
+		case "unstarted":
+			n.captureStarted = false
+		case "incomplete-storage":
+			n.captureComplete = false
+		case "incomplete-inventory":
+			l.captureComplete = false
+		case "closed-inventory":
+			l.closed = true
+		case "copied-inventory":
+			selected = copiedInventory
+		case "closed-storage":
+			n.closeAttempted = true
+		case "unknown-storage":
+			n.unknown = true
+		}
+		if runtimeUpgradeArgsOwnersKnown(n, selected) {
+			t.Fatal("incomplete/copy birth admitted", which)
+		}
+		if o, e := captureRuntimeUpgradeArgs(ctx, n, selected); e == nil || o != nil {
+			t.Fatal("incomplete/copy birth reached capture", which)
+		}
+		o := &nativeRuntimeUpgradeArgs{storage: n, inventory: selected}
+		o.self = o
+		if _, e := o.digest(ctx); e == nil {
+			t.Fatal("incomplete/copy birth reached digest", which)
+		}
+		if len(n.resources) != 1 || n.resources[0] != slot || slot.attempted {
+			t.Fatal("refusal appended an args slot", which)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_upgrade_operation_credentials.go b/rdd/pkg/managementconfig/runtime_upgrade_operation_credentials.go
new file mode 100644
index 0000000000000000000000000000000000000000..c11591b3a12e3d5146dd3695a17c28c68448f175
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_upgrade_operation_credentials.go
@@ -0,0 +1,367 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"io"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"go.yaml.in/yaml/v3"
+)
+
+const runtimeUpgradeCredentialsBudget = 64 << 10
+
+// Secret DATA only. Neither parsing nor holding this value authenticates an old
+// service or grants Stop/upgrade authority. It never configures clientcmd loaders.
+type runtimeUpgradeCredentialData struct {
+	endpoint string
+	// ca is the held trust anchor only; certificate pins the first/peer leaf.
+	// The original complete publication remains in the native owner's body.
+	ca, admin, user []byte
+	certificate     [32]byte
+}
+
+// The selected default generator publishes leaf then its self-signed CA. Keep
+// that narrow two-certificate envelope and the historical one-certificate
+// envelope separate from the global authority policy. Parsing does not perform
+// TLS peer/time/IP verification or issue management/native authority.
+func runtimeUpgradeCredentialChain(bundle []byte) ([]byte, [32]byte, error) {
+	if len(bundle) == 0 || len(bundle) > runtimeUpgradeCredentialsBudget {
+		return nil, [32]byte{}, ErrUpgrade
+	}
+	var certificates []*x509.Certificate
+	for remaining := bundle; len(remaining) > 0; {
+		if len(certificates) == 2 || !bytes.HasPrefix(remaining, []byte("-----BEGIN CERTIFICATE-----")) {
+			return nil, [32]byte{}, ErrUpgrade
+		}
+		block, rest := pem.Decode(remaining)
+		if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 || bytes.Count(remaining[:len(remaining)-len(rest)], []byte("-----BEGIN ")) != 1 {
+			return nil, [32]byte{}, ErrUpgrade
+		}
+		certificate, err := x509.ParseCertificate(block.Bytes)
+		if err != nil {
+			return nil, [32]byte{}, ErrUpgrade
+		}
+		certificates = append(certificates, certificate)
+		remaining = rest
+	}
+	leaf, anchor := certificates[0], certificates[len(certificates)-1]
+	if len(certificates) == 2 && (leaf.IsCA || !anchor.BasicConstraintsValid || !anchor.IsCA || bytes.Equal(leaf.Raw, anchor.Raw) || !bytes.Equal(leaf.RawIssuer, anchor.RawSubject) || !bytes.Equal(anchor.RawIssuer, anchor.RawSubject) || leaf.CheckSignatureFrom(anchor) != nil || anchor.CheckSignatureFrom(anchor) != nil) {
+		return nil, [32]byte{}, ErrUpgrade
+	}
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: anchor.Raw}), sha256.Sum256(leaf.Raw), nil
+}
+
+func (runtimeUpgradeCredentialData) String() string {
+	return "private legacy management credential data"
+}
+func (runtimeUpgradeCredentialData) GoString() string {
+	return "private legacy management credential data"
+}
+func (d *runtimeUpgradeCredentialData) clear() {
+	clear(d.ca)
+	clear(d.admin)
+	clear(d.user)
+	d.ca, d.admin, d.user = nil, nil, nil
+	d.endpoint = ""
+	d.certificate = [32]byte{}
+}
+
+// Terminal ownership guard, including panic before a named error is assigned.
+func (d *runtimeUpgradeCredentialData) clearUnlessComplete(complete *bool) {
+	if !*complete {
+		d.clear()
+	}
+}
+
+func runtimeUpgradeToken(value string) bool {
+	if len(value) != 36 || value[14] != '4' || !bytes.ContainsRune([]byte("89ab"), rune(value[19])) {
+		return false
+	}
+	for i, c := range []byte(value) {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if c != '-' {
+				return false
+			}
+			continue
+		}
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// Node inspection rejects YAML aliases/anchors/merge keys/explicit tags before
+// any conversion/expansion. Maps below use exact decoded keys, including JSON
+// duplicate and case-variant refusal. Byte/depth/node budgets are independent.
+func runtimeUpgradeCredentialNodes(node *yaml.Node, depth int, count *int) bool {
+	*count++
+	if node == nil || depth > 16 || *count > 160 || node.Kind == yaml.AliasNode || node.Alias != nil || node.Anchor != "" || node.Style&yaml.TaggedStyle != 0 || len(node.Value) > runtimeUpgradeCredentialsBudget || !utf8.ValidString(node.Value) {
+		return false
+	}
+	for _, child := range node.Content {
+		if !runtimeUpgradeCredentialNodes(child, depth+1, count) {
+			return false
+		}
+	}
+	return true
+}
+func runtimeUpgradeCredentialMap(node *yaml.Node, keys ...string) map[string]*yaml.Node {
+	if node == nil || node.Kind != yaml.MappingNode || node.Tag != "!!map" || len(node.Content) != 2*len(keys) {
+		return nil
+	}
+	allowed := map[string]bool{}
+	for _, key := range keys {
+		allowed[key] = true
+	}
+	out := map[string]*yaml.Node{}
+	for i := 0; i < len(node.Content); i += 2 {
+		key := node.Content[i]
+		if key.Kind != yaml.ScalarNode || key.Tag != "!!str" || !allowed[key.Value] || out[key.Value] != nil {
+			return nil
+		}
+		out[key.Value] = node.Content[i+1]
+	}
+	return out
+}
+func runtimeUpgradeCredentialString(node *yaml.Node) (string, bool) {
+	if node == nil || node.Kind != yaml.ScalarNode || node.Tag != "!!str" {
+		return "", false
+	}
+	return node.Value, true
+}
+func runtimeUpgradeCredentialSequence(node *yaml.Node, size int) bool {
+	return node != nil && node.Kind == yaml.SequenceNode && node.Tag == "!!seq" && len(node.Content) == size
+}
+
+// Exact selected producer: service.go's CreateKubeConfig + clientcmd.Write,
+// inline CA, two volatile UUIDv4 bearer users, root/user contexts. This parses
+// bytes only: no filenames, plugins, auth-provider, TLS override or network path.
+func parseRuntimeUpgradeCredentials(body, argsBody []byte) (runtimeUpgradeCredentialData, error) {
+	// Saved args constrain the supported invocation independently of the actual
+	// bound endpoint. The selected producer may fall back from its requested port.
+	if _, e := parseRuntimeUpgradeArgs(argsBody); e != nil {
+		return runtimeUpgradeCredentialData{}, ErrUpgrade
+	}
+	return parseRuntimeCredentialPublicationBody(body)
+}
+
+// Exact endpoint DATA only: reject rather than normalize every spelling outside
+// canonical HTTPS IPv4 loopback and decimal port 1..65535. In particular paths,
+// userinfo, empty query/fragment markers and alternate port spellings refuse.
+func runtimeCredentialEndpointPort(endpoint string) (uint16, error) {
+	port, ok := strings.CutPrefix(endpoint, "https://127.0.0.1:")
+	if !ok || len(port) == 0 || len(port) > 5 {
+		return 0, ErrUpgrade
+	}
+	value, err := strconv.ParseUint(port, 10, 16)
+	if err != nil || value == 0 || port != strconv.FormatUint(value, 10) {
+		return 0, ErrUpgrade
+	}
+	return uint16(value), nil
+}
+
+// Producer DATA only. Fresh startup derives wantEndpoint exclusively from its
+// SAME native-bound ConfigPublisher after actual secure-port selection. The
+// expected endpoint remains mandatory here; legacy's saved args are separate.
+func parseRuntimeCredentialPublication(body []byte, wantEndpoint string) (result runtimeUpgradeCredentialData, err error) {
+	// Keep the owned result separate from the named return: returning an empty
+	// value on mismatch must not discard the only buffers before deferred clear.
+	var owned runtimeUpgradeCredentialData
+	complete := false
+	defer owned.clearUnlessComplete(&complete)
+	if _, e := runtimeCredentialEndpointPort(wantEndpoint); e != nil {
+		return result, ErrUpgrade
+	}
+	owned, err = parseRuntimeCredentialPublicationBody(body)
+	if err != nil || owned.endpoint != wantEndpoint {
+		return result, ErrUpgrade
+	}
+	complete = true
+	return owned, nil
+}
+
+// Closed shared producer envelope. This parses the actual publication only;
+// neither endpoint acceptance nor saved-args acceptance issues native authority.
+func parseRuntimeCredentialPublicationBody(body []byte) (result runtimeUpgradeCredentialData, err error) {
+	complete := false
+	defer result.clearUnlessComplete(&complete)
+	if len(body) == 0 || len(body) > runtimeUpgradeCredentialsBudget || !utf8.Valid(body) {
+		return result, ErrUpgrade
+	}
+	decoder := yaml.NewDecoder(bytes.NewReader(body))
+	var document, extra yaml.Node
+	if decoder.Decode(&document) != nil || decoder.Decode(&extra) != io.EOF || document.Kind != yaml.DocumentNode || len(document.Content) != 1 {
+		return result, ErrUpgrade
+	}
+	count := 0
+	if !runtimeUpgradeCredentialNodes(&document, 0, &count) {
+		return result, ErrUpgrade
+	}
+	defer func() {
+		var scrub func(*yaml.Node)
+		scrub = func(n *yaml.Node) {
+			n.Value = ""
+			for _, c := range n.Content {
+				scrub(c)
+			}
+		}
+		scrub(&document)
+	}()
+	root := runtimeUpgradeCredentialMap(document.Content[0], "apiVersion", "kind", "clusters", "users", "contexts", "current-context")
+	if root == nil {
+		return result, ErrUpgrade
+	}
+	for key, want := range map[string]string{"apiVersion": "v1", "kind": "Config", "current-context": "root"} {
+		if value, ok := runtimeUpgradeCredentialString(root[key]); !ok || value != want {
+			return result, ErrUpgrade
+		}
+	}
+	if !runtimeUpgradeCredentialSequence(root["clusters"], 1) || !runtimeUpgradeCredentialSequence(root["users"], 2) || !runtimeUpgradeCredentialSequence(root["contexts"], 2) {
+		return result, ErrUpgrade
+	}
+	cluster := runtimeUpgradeCredentialMap(root["clusters"].Content[0], "name", "cluster")
+	if cluster == nil {
+		return result, ErrUpgrade
+	}
+	if name, ok := runtimeUpgradeCredentialString(cluster["name"]); !ok || name != "root" {
+		return result, ErrUpgrade
+	}
+	connection := runtimeUpgradeCredentialMap(cluster["cluster"], "server", "certificate-authority-data")
+	if connection == nil {
+		return result, ErrUpgrade
+	}
+	endpoint, ok := runtimeUpgradeCredentialString(connection["server"])
+	if !ok {
+		return result, ErrUpgrade
+	}
+	if _, e := runtimeCredentialEndpointPort(endpoint); e != nil {
+		return result, ErrUpgrade
+	}
+	encoded, ok := runtimeUpgradeCredentialString(connection["certificate-authority-data"])
+	if !ok {
+		return result, ErrUpgrade
+	}
+	bundle, err := base64.StdEncoding.DecodeString(encoded)
+	defer clear(bundle)
+	if err != nil || base64.StdEncoding.EncodeToString(bundle) != encoded {
+		return result, ErrUpgrade
+	}
+	result.ca, result.certificate, err = runtimeUpgradeCredentialChain(bundle)
+	if err != nil {
+		return result, ErrUpgrade
+	}
+	seen := map[string]bool{}
+	for _, node := range root["users"].Content {
+		user := runtimeUpgradeCredentialMap(node, "name", "user")
+		if user == nil {
+			return result, ErrUpgrade
+		}
+		name, ok := runtimeUpgradeCredentialString(user["name"])
+		if !ok || seen[name] || name != "system-admin" && name != "user" {
+			return result, ErrUpgrade
+		}
+		credential := runtimeUpgradeCredentialMap(user["user"], "token")
+		if credential == nil {
+			return result, ErrUpgrade
+		}
+		token, ok := runtimeUpgradeCredentialString(credential["token"])
+		if !ok || !runtimeUpgradeToken(token) {
+			return result, ErrUpgrade
+		}
+		if name == "system-admin" {
+			result.admin = []byte(token)
+		} else {
+			result.user = []byte(token)
+		}
+		seen[name] = true
+	}
+	if bytes.Equal(result.admin, result.user) {
+		return result, ErrUpgrade
+	}
+	seen = map[string]bool{}
+	for _, node := range root["contexts"].Content {
+		context := runtimeUpgradeCredentialMap(node, "name", "context")
+		if context == nil {
+			return result, ErrUpgrade
+		}
+		name, ok := runtimeUpgradeCredentialString(context["name"])
+		if !ok || seen[name] || name != "root" && name != "user" {
+			return result, ErrUpgrade
+		}
+		binding := runtimeUpgradeCredentialMap(context["context"], "cluster", "user")
+		if binding == nil {
+			return result, ErrUpgrade
+		}
+		cluster, ok := runtimeUpgradeCredentialString(binding["cluster"])
+		if !ok || cluster != "root" {
+			return result, ErrUpgrade
+		}
+		user, ok := runtimeUpgradeCredentialString(binding["user"])
+		want := "user"
+		if name == "root" {
+			want = "system-admin"
+		}
+		if !ok || user != want {
+			return result, ErrUpgrade
+		}
+		seen[name] = true
+	}
+	result.endpoint = endpoint
+	complete = true
+	return result, nil
+}
+
+// Same-handle byte reader. This helper returns DATA, never a credential owner.
+func readRuntimeUpgradeCredentials(ctx context.Context, size uint64, seek func() error, read func([]byte) (uint32, error)) ([]byte, error) {
+	if ctx == nil || ctx.Err() != nil || size == 0 || size > runtimeUpgradeCredentialsBudget || seek == nil || read == nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	if seek() != nil {
+		return nil, ErrUpgrade
+	}
+	body := make([]byte, int(size))
+	complete := false
+	defer func() {
+		if !complete {
+			clear(body)
+		}
+	}()
+	fail := func() ([]byte, error) { clear(body); return nil, ErrUpgrade }
+	for at := 0; at < len(body); {
+		if ctx.Err() != nil {
+			return fail()
+		}
+		count, err := read(body[at:])
+		if count == 0 || uint64(count) > uint64(len(body)-at) || err != nil && err != io.EOF {
+			return fail()
+		}
+		at += int(count)
+		if err == io.EOF && at != len(body) {
+			return fail()
+		}
+	}
+	if ctx.Err() != nil {
+		return fail()
+	}
+	var extra [1]byte
+	defer clear(extra[:])
+	count, err := read(extra[:])
+	if count != 0 || err != nil && err != io.EOF || ctx.Err() != nil {
+		return fail()
+	}
+	complete = true
+	return body, nil
+}
+
+func runtimeUpgradeCredentialHash(body []byte) [32]byte { return sha256.Sum256(body) }
