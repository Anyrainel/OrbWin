+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+	"strings"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+// Descriptive shape refusal only, never native selection or directory authority.
+func selectionOwnerRootFactsValid(profile, home, parent, owner string) bool {
+	if owner == "" || len(owner) > 184 || strings.ContainsRune(owner, 0) {
+		return false
+	}
+	for _, path := range []string{profile, home, parent} {
+		if _, _, e := readerComponents(path); e != nil {
+			return false
+		}
+	}
+	const suffix = `\OrbWinData\home`
+	return len(home) > len(suffix) && strings.EqualFold(home[len(home)-len(suffix):], suffix) && strings.EqualFold(parent, profile+`\.orbwin-private`)
+}
+
+// Caller pins its OS thread through the dependent factory. The selector owns
+// its real token; these two fixed pseudo inputs never create/own/close tokens.
+func selectionOwnerForCapture(ctx context.Context, owner *authoritypath.ProductSelectionOwner) (*authoritypath.Selection, error) {
+	if !freshBoundedContext(ctx) || owner == nil || owner.KnownForReadOnlyInspection() != nil {
+		return nil, ErrCreate
+	}
+	selected, e := owner.Selection(ctx)
+	if e != nil || selected == nil || !selectionOwnerRootFactsValid(selected.Profile(), selected.GuestHome(), selected.Parent(), selected.Owner()) {
+		return nil, ErrCreate
+	}
+	// Same no-impersonation policy as currentOwner, without OpenThreadToken's
+	// owned output/unchecked close. Every non-precise absence is refusal.
+	if _, e = windows.GetCurrentThreadToken().GetTokenUser(); e != windows.ERROR_NO_TOKEN {
+		return nil, ErrCreate
+	}
+	token := windows.GetCurrentProcessToken() // Borrowed QUERY pseudo, never closed.
+	user, e := token.GetTokenUser()
+	if e != nil || user == nil || user.User.Sid == nil || !user.User.Sid.IsValid() || user.User.Sid.String() != selected.Owner() {
+		return nil, ErrCreate
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 || ctx.Err() != nil || owner.KnownForReadOnlyInspection() != nil {
+		return nil, ErrCreate
+	}
+	if ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	runtime.KeepAlive(owner)
+	return selected, nil
+}
+
+// ResolveOrbWinRootFromSelectionOwner accepts only the original native selector.
+// Result owns immutable metadata, not selector handles or a directory receipt.
+func ResolveOrbWinRootFromSelectionOwner(ctx context.Context, owner *authoritypath.ProductSelectionOwner) (*InstanceRoot, error) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer runtime.KeepAlive(owner)
+	selected, e := selectionOwnerForCapture(ctx, owner)
+	if e != nil {
+		return nil, ErrCreate
+	}
+	return &InstanceRoot{home: selected.GuestHome(), sid: selected.Owner(), selection: selected}, nil
+}
+
+// HoldServingImageFromSelectionOwner opens its OWN serving file graph. The
+// original selector remains checked/alive through capture; no token is loaned.
+func HoldServingImageFromSelectionOwner(ctx context.Context, owner *authoritypath.ProductSelectionOwner) (*ServingImageLease, error) {
+	return holdServingFileFromSelectionOwner(ctx, owner, nil)
+}
+func HoldServingForwarderFromSelectionOwner(ctx context.Context, owner *authoritypath.ProductSelectionOwner, expected [32]byte) (*ServingImageLease, error) {
+	if expected == ([32]byte{}) {
+		return nil, ErrCreate
+	}
+	return holdServingFileFromSelectionOwner(ctx, owner, &expected)
+}
+func holdServingFileFromSelectionOwner(ctx context.Context, owner *authoritypath.ProductSelectionOwner, forwarder *[32]byte) (*ServingImageLease, error) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer runtime.KeepAlive(owner)
+	selected, e := selectionOwnerForCapture(ctx, owner)
+	if e != nil {
+		return nil, ErrCreate
+	}
+	return holdServingFileSelected(ctx, selected, selected.Owner(), forwarder, owner)
+}
