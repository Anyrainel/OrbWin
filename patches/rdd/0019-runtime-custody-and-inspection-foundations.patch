@@ -0,0 +1,63 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"io"
+)
+
+const runtimeUpgradeArgsBudget = 65536
+
+// DATA only: this parser cannot construct the native observation below.
+func parseRuntimeUpgradeArgs(body []byte) ([32]byte, error) {
+	if len(body) == 0 || len(body) > runtimeUpgradeArgsBudget || !runtimeIdentityUnicode(body) || !privateStartupArguments(body) {
+		return [32]byte{}, ErrUpgrade
+	}
+	var args []string
+	if json.Unmarshal(body, &args) != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(body), nil
+}
+
+// Actual native reader uses this bounded loop. Callbacks return DATA only;
+// neither this helper nor a successful parse issues a native observation.
+func readRuntimeUpgradeArgs(ctx context.Context, size uint64, seek func() error, read func([]byte) (uint32, error)) ([]byte, error) {
+	if ctx == nil || ctx.Err() != nil || size == 0 || size > runtimeUpgradeArgsBudget || seek == nil || read == nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	if seek() != nil {
+		return nil, ErrUpgrade
+	}
+	body := make([]byte, int(size))
+	fail := func() ([]byte, error) { clear(body); return nil, ErrUpgrade }
+	for at := 0; at < len(body); {
+		if ctx.Err() != nil {
+			return fail()
+		}
+		count, err := read(body[at:])
+		if count == 0 || uint64(count) > uint64(len(body)-at) || err != nil && err != io.EOF {
+			return fail()
+		}
+		at += int(count)
+		if err == io.EOF && at != len(body) {
+			return fail()
+		}
+	}
+	if ctx.Err() != nil {
+		return fail()
+	}
+	var extra [1]byte
+	count, err := read(extra[:])
+	if count != 0 || err != nil && err != io.EOF || ctx.Err() != nil {
+		return fail()
+	}
+	if _, err = parseRuntimeUpgradeArgs(body); err != nil {
+		return fail()
+	}
+	return body, nil
+}
