index 0000000000000000000000000000000000000000..e3607e3933a8fc1e5219de792ad112dea98d7f2d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_service_windows.go
@@ -0,0 +1,205 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// Refusal-only check against the captured native root. Existing OnceValue
+// caches may not redirect fixed-role upstream output into an earlier HOME.
+func (o *FreshSetupOwner) VerifyUpstreamDirectories(ctx context.Context, suffix, home, authority, lima, bin string) error {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.createdAdmissionLocked(ctx) || o.storage.root == nil || o.storage.root.selection == nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	if suffix != "orbwin" || !strings.EqualFold(home, n.home) || !strings.EqualFold(authority, n.root.selection.Directory()) || !strings.EqualFold(lima, filepath.Join(n.home, ".rdorbwin", "lima")) || !strings.EqualFold(bin, filepath.Join(n.home, ".rdorbwin", "bin")) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// The existing service's actual joined-resource close scope invokes this
+// BEFORE closing borrowed publisher/Created/image. No Boolean reports native
+// ownership or publication; this closes only the SAME owner's held witness.
+func (o *FreshSetupOwner) CloseFreshObservationForService(c *Created, p *ConfigPublisher) error {
+	if o == nil || o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || o.unknown || o.closed || c == nil || c != o.created {
+		return ErrUpgrade
+	}
+	// Borrowed uncertainty retains our graph even before a witness exists.
+	// Positive cached closure needs no native recheck and permits cleanup.
+	c.mu.Lock()
+	createdUnknown := c.closeErr != nil
+	c.mu.Unlock()
+	if createdUnknown {
+		o.fence()
+		return ErrUpgrade
+	}
+	if !o.knownStorageCloseLocked() {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.image != nil {
+		o.image.mu.Lock()
+		bad := o.image.err != nil
+		o.image.mu.Unlock()
+		if bad {
+			o.fence()
+			return ErrUpgrade
+		}
+	}
+	if o.forwarder != nil {
+		o.forwarder.mu.Lock()
+		bad := o.forwarder.err != nil || o.forwarder.unknown
+		o.forwarder.mu.Unlock()
+		if bad {
+			o.fence()
+			return ErrUpgrade
+		}
+	}
+	if p != nil {
+		p.mu.Lock()
+		backend, ok := p.backend.(*nativeAuthority)
+		same := ok && backend.created == c
+		unknown := p.closeErr != nil || p.pending != nil
+		p.mu.Unlock()
+		if !same || unknown {
+			o.fence()
+			return ErrUpgrade
+		}
+	}
+	if closeFreshRuntimeObservationLocked(o) != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.closeServingForwarderLocked() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// WriteServingPID uses the captured mapped SAME process generation, not a
+// caller PID or by-path writer. It remains diagnostics DATA, never a stop grant.
+func (o *FreshSetupOwner) WriteServingPID(ctx context.Context, c *Created) (result error) {
+	if _, e := o.ServingImageForAuthority(ctx, c); e != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !o.nativeOutputsAdmittedLocked() || c != o.created || ctx.Err() != nil || o.pidWriteStarted || c.closed || c.closeErr != nil || !c.servingLease || c.anchor == 0 || len(c.authorityHandles) == 0 {
+		return ErrUpgrade
+	}
+	o.pidWriteStarted = true
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			o.unknown = true
+			n.fence()
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	return o.writeServingPIDLocked(ctx, c)
+}
+
+// ProjectUpstreamEnvironment derives upstream's environment from this exact
+// native selection AFTER the durable fence. Inherited HOME/USERPROFILE are
+// never selectors. Call before constructing any Cobra/options/instance caches
+// or starting upstream resources in this fixed standalone process. Protocol
+// workers handle DATA only and never inspect upstream environment/instance state.
+func (o *FreshSetupOwner) ProjectUpstreamEnvironment(ctx context.Context) error {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.createdAdmissionLocked(ctx) || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || n.checkPrevious() != nil || n.checkObject(o.fenceObject) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	for _, entry := range os.Environ() {
+		if i := strings.IndexByte(entry, '='); i > 0 && runtimeFreshEnvironmentSelector(entry[:i]) {
+			if os.Unsetenv(entry[:i]) != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	for _, entry := range runtimeFreshFixedEnvironment(n.home) {
+		if os.Setenv(entry[0], entry[1]) != nil {
+			return ErrUpgrade
+		}
+	}
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// ServingImageForAuthority returns ONLY the original retained image pointer
+// for the SAME actual Created object. No hash/PID/DTO constructs this lease.
+func (o *FreshSetupOwner) ServingImageForAuthority(ctx context.Context, c *Created) (*ServingImageLease, error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered || !o.captureComplete || o.unknown || o.closed || c == nil || c != o.created || o.origin == nil || o.image == nil {
+		return nil, ErrUpgrade
+	}
+	if o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed || !c.servingLease || c.anchor == 0 {
+		return nil, ErrUpgrade
+	}
+	return o.image, nil
+}
+
+// Cached actual closure is necessary for fresh owner release. The existing
+// service callee must first join its real resources and close its SAME Created;
+// this method takes no caller readiness/retirement Boolean.
+func (o *FreshSetupOwner) createdRetiredLocked() bool {
+	if o.created == nil {
+		return true
+	}
+	c := o.created
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closed && c.closeErr == nil && !c.datastoreActive.Load()
+}
