@@ -0,0 +1,117 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestDatastoreAcquisitionCancellationAfterLockWait(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	var mu sync.Mutex
+	mu.Lock()
+	entered := make(chan struct{})
+	done := make(chan bool)
+	go func() { close(entered); mu.Lock(); defer mu.Unlock(); done <- datastoreGenerationAdmit(ctx) }()
+	<-entered
+	cancel()
+	mu.Unlock()
+	if <-done {
+		t.Fatal("pre-lock context admitted post-wait effect")
+	}
+	if datastoreGenerationAdmit(nil) {
+		t.Fatal("nil context")
+	}
+	if !datastoreGenerationAdmit(context.Background()) {
+		t.Fatal("known live context refused")
+	}
+}
+func TestDatastoreAcquisitionSecretInputIsOriginalCopy(t *testing.T) {
+	original := []byte("synthetic-secret")
+	copy, ok := datastoreCloneSecret(original, 64<<10)
+	if !ok {
+		t.Fatal("input refused")
+	}
+	clear(original)
+	if !bytes.Equal(copy, []byte("synthetic-secret")) {
+		t.Fatal("native input aliases caller clear")
+	}
+	for _, v := range [][]byte{nil, make([]byte, 65537)} {
+		if _, ok := datastoreCloneSecret(v, 64<<10); ok {
+			t.Fatal("input bound")
+		}
+	}
+}
+func TestDatastoreCreateBranchNeedsExactCompletedMissing(t *testing.T) {
+	for _, c := range []struct {
+		raw, io uint32
+		output  bool
+		want    bool
+	}{
+		{0xc0000034, 0, false, true}, {0x103, 0, false, false}, {0xc0000034, 0x103, false, false},
+		{0xc0000034, 0, true, false}, {0xc0000022, 0, false, false}, {0, 0, false, false},
+	} {
+		s := runtimeStorageNativeOpenState{entered: true}
+		s.reply(runtimeStorageClassifyNativeOpen(c.raw, c.io, 0, 1, c.output, c.output))
+		if datastoreGenerationMissingTail(&s, c.raw) != c.want {
+			t.Fatal("missing->CREATE cut")
+		}
+		s.unknown = true
+		if datastoreGenerationMissingTail(&s, c.raw) {
+			t.Fatal("late repaired unknown")
+		}
+	}
+}
+func TestDatastoreWriteProgressCannotConsumeUnknownCount(t *testing.T) {
+	for _, c := range []struct {
+		n      uint32
+		remain int
+		want   bool
+	}{{0, 8, false}, {9, 8, false}, {1, 8, true}, {8, 8, true}, {1, 0, false}} {
+		if datastoreGenerationWriteCount(c.n, c.remain) != c.want {
+			t.Fatal("bounded short write progress")
+		}
+	}
+	remaining := 8
+	for _, n := range []uint32{1, 3, 4} {
+		if !datastoreGenerationWriteCount(n, remaining) {
+			t.Fatal("legal progress")
+		}
+		remaining -= int(n)
+	}
+	if remaining != 0 {
+		t.Fatal("partial progress lost")
+	}
+}
+func TestDatastoreHistoricalQueryStatesDoNotInferDeadFromFalse(t *testing.T) {
+	for _, c := range []struct {
+		h     uintptr
+		e     uint32
+		query bool
+		d     datastoreOwnerDisposition
+	}{
+		{0, 87, false, datastoreOwnerAbsent}, {0, 5, false, datastoreOwnerUnavailable}, {0, 997, false, datastoreOwnerUnknown},
+		{0, 0, false, datastoreOwnerUnknown}, {^uintptr(0), 5, false, datastoreOwnerUnknown},
+		{uintptr(1) << 40, 997, true, datastoreOwnerUnknown},
+	} {
+		q, d := datastoreProcessOpenReply(c.h, c.e)
+		if q != c.query || d != c.d {
+			t.Fatal("query/absence/unknown boundary")
+		}
+	}
+	for _, c := range []struct {
+		same bool
+		wait uint32
+		d    datastoreOwnerDisposition
+		ok   bool
+	}{
+		{true, 0, datastoreOwnerDead, true}, {true, 258, datastoreOwnerLive, true},
+		{true, 0xffffffff, datastoreOwnerUnknown, false}, {false, 258, datastoreOwnerRecycled, true},
+	} {
+		d, ok := datastoreProcessWaitReply(c.same, c.wait)
+		if d != c.d || ok != c.ok {
+			t.Fatal("terminal/live/recycled boundary")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/datastore_generation_capture_windows.go b/rdd/pkg/managementconfig/datastore_generation_capture_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..4042b6995e87af894f6e8532f465dc83e841c07a
--- /dev/null
+++ b/rdd/pkg/managementconfig/datastore_generation_capture_windows.go
@@ -0,0 +1,613 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"golang.org/x/sys/windows"
+	"io"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+	"unsafe"
+)
+
+type datastoreGenerationCell struct {
+	owner  *DatastoreGeneration
+	handle windows.Handle
+	close  datastoreCleanupOnce
+	frame  *datastoreCleanupFrame
+}
+type datastoreGenerationWriter struct {
+	datastoreGenerationCell
+	owner     *DatastoreGeneration
+	index     int
+	input     []byte
+	offset    int
+	count     uint32
+	raw       uintptr
+	lastError error
+	writing   bool
+	flush     datastoreCleanupOnce
+}
+type datastoreGenerationEnumeration struct {
+	owner     *DatastoreGeneration
+	source    *windows.Handle
+	backing   []uint64
+	buffer    []byte
+	names     []string
+	class     uint32
+	raw       uintptr
+	lastError error
+	complete  bool
+}
+type datastoreGenerationProcess struct {
+	owner                         *DatastoreGeneration
+	handle                        windows.Handle
+	raw                           uintptr
+	lastError                     error
+	entered, complete             bool
+	pid, session, wait            uint32
+	created, exited, kernel, user windows.Filetime
+	close                         datastoreCleanupOnce
+}
+type datastoreGenerationCapture struct {
+	owner                         *DatastoreGeneration
+	sid                           string
+	rootCreate, directoryCreate   datastoreGenerationCell
+	writers                       [6]*datastoreGenerationWriter
+	enumerations                  []*datastoreGenerationEnumeration
+	process                       *datastoreGenerationProcess
+	ownerPID, ownerSession        uint32
+	nonce                         [16]byte
+	created, exited, kernel, user windows.Filetime
+	path                          [1024]uint16
+	pathLength                    uint32
+}
+
+type datastoreGenerationOpenSpec struct{ access, share, options, disposition uint32 }
+
+func datastoreBorrowRootSettled(p *DatastoreGeneration) bool {
+	if p == nil || p.issuance != datastoreCleanupCreated || !p.exactCleanup() || p.capture == nil || p.capture.owner != p || p.rootClose.attempted {
+		return false
+	}
+	for _, f := range p.frames {
+		if f.output == &p.root {
+			return f.role == "kine-read" && p.frameOriginal(f) && f.state.usable() && p.root != 0 && p.root != windows.InvalidHandle
+		}
+	}
+	return false
+}
+func (g *DatastoreGeneration) rootCell() *windows.Handle {
+	if !g.exactCleanup() {
+		return nil
+	}
+	if g.issuer != nil {
+		if !datastoreBorrowRootSettled(g.issuer) {
+			return nil
+		}
+		return &g.issuer.root
+	}
+	if !datastoreBorrowRootSettled(g) {
+		return nil
+	}
+	return &g.root
+}
+func (g *DatastoreGeneration) captureFrameOriginal(f *datastoreCleanupFrame) bool {
+	c := g.capture
+	if c == nil || c.owner != g || f == nil || g.owner == nil || g.owner.datastoreGeneration != g || !g.owner.datastoreActive.Load() {
+		return false
+	}
+	switch f.role {
+	case "db-read":
+		return f.parent == &g.owner.anchor && f.name == "db" && f.output == &g.db && f.sd == nil
+	case "kine-read":
+		return f.parent == &g.db && f.name == "kine" && f.output == &g.root && f.sd == nil
+	case "kine-create":
+		return f.parent == &g.db && f.name == "kine" && f.output == &c.rootCreate.handle && c.rootCreate.owner == g && c.rootCreate.frame == f && f.sd != nil
+	case "generation-create":
+		return f.parent == g.rootCell() && f.parent != nil && f.name == g.record.Generation && f.output == &c.directoryCreate.handle && c.directoryCreate.owner == g && c.directoryCreate.frame == f && f.sd != nil
+	case "generation-read":
+		return f.parent == g.rootCell() && f.parent != nil && f.name == g.record.Generation && f.output == &g.directory && f.sd == nil
+	case "credential-create":
+		if f.index < 0 || f.index >= 6 {
+			return false
+		}
+		w := c.writers[f.index]
+		names := datastoreNames()
+		all := append([]string{"owner.json"}, names[:]...)
+		return w != nil && w.owner == g && w.index == f.index && w.frame == f && f.parent == &c.directoryCreate.handle && f.name == all[f.index] && f.output == &w.handle && f.sd != nil
+	}
+	return false
+}
+func (g *DatastoreGeneration) configureCaptureFrame(f *datastoreCleanupFrame) bool {
+	c := g.capture
+	if c == nil || c.owner != g || g.owner == nil {
+		return false
+	}
+	switch f.role {
+	case "db-read":
+		f.parent = &g.owner.anchor
+		f.name = "db"
+		f.output = &g.db
+	case "kine-read":
+		f.parent = &g.db
+		f.name = "kine"
+		f.output = &g.root
+	case "kine-create":
+		if c.rootCreate.frame != nil {
+			return false
+		}
+		f.parent = &g.db
+		f.name = "kine"
+		f.output = &c.rootCreate.handle
+		c.rootCreate.owner = g
+		c.rootCreate.frame = f
+	case "generation-create":
+		if c.directoryCreate.frame != nil {
+			return false
+		}
+		f.parent = g.rootCell()
+		f.name = g.record.Generation
+		f.output = &c.directoryCreate.handle
+		c.directoryCreate.owner = g
+		c.directoryCreate.frame = f
+	case "generation-read":
+		f.parent = g.rootCell()
+		f.name = g.record.Generation
+		f.output = &g.directory
+	case "credential-create":
+		if f.index < 0 || f.index >= 6 {
+			return false
+		}
+		w := c.writers[f.index]
+		if w == nil || w.owner != g || w.frame != nil {
+			return false
+		}
+		names := datastoreNames()
+		all := append([]string{"owner.json"}, names[:]...)
+		f.parent = &c.directoryCreate.handle
+		f.name = all[f.index]
+		f.output = &w.handle
+		w.frame = f
+		w.datastoreGenerationCell.owner = g
+	default:
+		return false
+	}
+	for _, older := range g.frames {
+		if older.output == f.output {
+			return false
+		}
+	}
+	return f.parent != nil
+}
+func (g *DatastoreGeneration) captureOpenSpec(f *datastoreCleanupFrame) (datastoreGenerationOpenSpec, bool) {
+	s := datastoreGenerationOpenSpec{access: windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE, share: windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE, options: windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_DIRECTORY_FILE, disposition: windows.FILE_OPEN}
+	switch f.role {
+	case "db-read", "kine-read", "generation-read":
+		s.access |= windows.FILE_LIST_DIRECTORY
+	case "kine-create", "generation-create":
+		s.access |= windows.FILE_LIST_DIRECTORY
+		s.disposition = windows.FILE_CREATE
+		s.share = 0
+	case "credential-create":
+		s.access |= windows.GENERIC_WRITE
+		s.disposition = windows.FILE_CREATE
+		s.share = 0
+		s.options = windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE
+	default:
+		return s, false
+	}
+	return s, true
+}
+func (g *DatastoreGeneration) openGenerationRoleLocked(ctx context.Context, role string, index int) (*datastoreCleanupFrame, error) {
+	if ctx == nil || ctx.Err() != nil || g.capture == nil || g.constructionComplete || g.cleanupAttempted {
+		return nil, ErrPublication
+	}
+	f := g.newCleanupFrame(role, index)
+	if f == nil {
+		return nil, ErrPublication
+	}
+	f.ctx = ctx
+	if role == "kine-create" || role == "generation-create" || role == "credential-create" {
+		directory := role != "credential-create"
+		var e error
+		f.sd, e = privateDescriptor(g.capture.sid, directory)
+		if e != nil {
+			return f, e
+		}
+	}
+	return f, f.open()
+}
+func (g *DatastoreGeneration) captureCloseCellOriginal(slot *windows.Handle, memo *datastoreCleanupOnce) bool {
+	c := g.capture
+	if c == nil || c.owner != g {
+		return false
+	}
+	for _, cell := range []*datastoreGenerationCell{&c.rootCreate, &c.directoryCreate} {
+		if slot == &cell.handle {
+			return cell.owner == g && memo == &cell.close && cell.frame != nil && g.frameOriginal(cell.frame)
+		}
+	}
+	for _, w := range c.writers {
+		if w != nil && slot == &w.handle {
+			return w.owner == g && memo == &w.close && w.frame != nil && g.frameOriginal(w.frame) && !w.writing
+		}
+	}
+	return c.process != nil && c.process.owner == g && slot == &c.process.handle && memo == &c.process.close && c.process.complete
+}
+func (g *DatastoreGeneration) captureCellAttempted(slot *windows.Handle) bool {
+	c := g.capture
+	if c == nil {
+		return false
+	}
+	for _, cell := range []*datastoreGenerationCell{&c.rootCreate, &c.directoryCreate} {
+		if slot == &cell.handle {
+			return cell.close.attempted
+		}
+	}
+	for _, w := range c.writers {
+		if w != nil && slot == &w.handle {
+			return w.close.attempted || w.writing
+		}
+	}
+	return false
+}
+func (g *DatastoreGeneration) closeCaptureCells() error {
+	c := g.capture
+	if c == nil {
+		return nil
+	}
+	if c.process != nil && c.process.handle != 0 {
+		if g.closeCleanupCell(&c.process.handle, &c.process.close) != nil {
+			return ErrPublication
+		}
+	}
+	for n := len(c.writers) - 1; n >= 0; n-- {
+		w := c.writers[n]
+		if w != nil && w.frame != nil {
+			if !w.frame.state.entered && w.handle == 0 {
+				continue
+			}
+			if g.closeCleanupCell(&w.handle, &w.close) != nil {
+				return ErrPublication
+			}
+		}
+	}
+	for _, cell := range []*datastoreGenerationCell{&c.directoryCreate, &c.rootCreate} {
+		if cell.frame != nil {
+			if !cell.frame.state.entered && cell.handle == 0 {
+				continue
+			}
+			if g.closeCleanupCell(&cell.handle, &cell.close) != nil {
+				return ErrPublication
+			}
+		}
+	}
+	return nil
+}
+func (g *DatastoreGeneration) abortConstructionKnownLocked() error {
+	if !g.exactCleanup() || g.constructionComplete || !g.childrenReleased() {
+		return ErrPublication
+	}
+	if g.closeHandles() != nil {
+		return g.failCleanup()
+	}
+	for _, w := range g.capture.writers {
+		if w != nil {
+			clear(w.input)
+		}
+	}
+	g.owner.datastoreActive.Store(false)
+	g.releaseCleanup()
+	return nil
+}
+
+func (g *DatastoreGeneration) captureGenerationLocked(ctx context.Context, m DatastoreMaterial, hashes [5]string, expires time.Time) error {
+	c := g.capture
+	if !datastoreGenerationAdmit(ctx) {
+		return ErrPublication
+	}
+	sid, e := datastoreCleanupCaller()
+	if e != nil || g.owner.parents == nil || sid != g.owner.parents.sid || verifyPrivate(g.owner.anchor, sid, true) != nil {
+		return g.failCleanup()
+	}
+	c.sid = sid
+	for n, v := range m.values() {
+		copy, ok := datastoreCloneSecret(v, 64<<10)
+		if !ok {
+			return ErrPublication
+		}
+		if hash := sha256.Sum256(copy); hex.EncodeToString(hash[:]) != hashes[n] {
+			clear(copy)
+			return ErrPublication
+		}
+		c.writers[n+1].input = copy
+	}
+	if _, e = g.openGenerationRoleLocked(ctx, "db-read", 0); e != nil {
+		return e
+	}
+	if verifyPrivate(g.db, sid, true) != nil {
+		return g.failCleanup()
+	}
+	f, e := g.openGenerationRoleLocked(ctx, "kine-read", 0)
+	if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		if f == nil || !datastoreGenerationMissingTail(&f.state, uint32(f.raw)) || g.frames[len(g.frames)-1] != f {
+			return g.failCleanup()
+		}
+		g.frames = g.frames[:len(g.frames)-1] // exact terminal no-output tail only
+		if _, e = g.openGenerationRoleLocked(ctx, "kine-create", 0); e != nil {
+			return e
+		}
+		if verifyPrivate(c.rootCreate.handle, sid, true) != nil {
+			return g.failCleanup()
+		}
+		want, e := g.cleanupIdentity(&c.rootCreate.handle)
+		if e != nil {
+			return e
+		}
+		if g.closeCleanupCell(&c.rootCreate.handle, &c.rootCreate.close) != nil {
+			return ErrPublication
+		}
+		if _, e = g.openGenerationRoleLocked(ctx, "kine-read", 0); e != nil {
+			return e
+		}
+		got, e := g.cleanupIdentity(&g.root)
+		if e != nil || got != want {
+			return g.failCleanup()
+		}
+	} else if e != nil {
+		return e
+	}
+	if verifyPrivate(g.root, sid, true) != nil {
+		return g.failCleanup()
+	}
+	names, e := g.enumerateGenerationLocked(ctx, &g.root)
+	if e != nil {
+		return e
+	}
+	for _, name := range names {
+		if ctx.Err() != nil {
+			return ErrPublication
+		}
+		reaped, e := g.reapDatastoreGeneration(ctx, sid, name)
+		if e != nil {
+			return e
+		}
+		if !reaped {
+			g.retained++
+		}
+	}
+	if g.retained >= maxDatastoreGenerations {
+		return ErrPublication
+	}
+	if _, e = io.ReadFull(rand.Reader, c.nonce[:]); e != nil {
+		return e
+	}
+	c.ownerPID = windows.GetCurrentProcessId()
+	if windows.GetProcessTimes(windows.CurrentProcess(), &c.created, &c.exited, &c.kernel, &c.user) != nil || windows.ProcessIdToSessionId(c.ownerPID, &c.ownerSession) != nil || c.ownerPID == 0 || c.ownerSession == 0 {
+		return g.failCleanup()
+	}
+	owner := datastoreOwner{c.ownerPID, uint64(c.created.HighDateTime)<<32 | uint64(c.created.LowDateTime), c.ownerSession}
+	g.record = datastoreRecord{1, hex.EncodeToString(c.nonce[:]), owner, expires, hashes}
+	record, e := datastoreRecordBytes(g.record)
+	if e != nil {
+		return e
+	}
+	var copied bool
+	c.writers[0].input, copied = datastoreCloneSecret(record, 2048)
+	if !copied {
+		return ErrPublication
+	}
+	if _, e = g.openGenerationRoleLocked(ctx, "generation-create", 0); e != nil {
+		return e
+	}
+	if verifyPrivate(c.directoryCreate.handle, sid, true) != nil {
+		return g.failCleanup()
+	}
+	for n := 0; n < 6; n++ {
+		if g.writeGenerationRoleLocked(ctx, n) != nil {
+			return ErrPublication
+		}
+	}
+	want, e := g.cleanupIdentity(&c.directoryCreate.handle)
+	if e != nil {
+		return e
+	}
+	if g.closeCleanupCell(&c.directoryCreate.handle, &c.directoryCreate.close) != nil {
+		return ErrPublication
+	}
+	if _, e = g.openGenerationRoleLocked(ctx, "generation-read", 0); e != nil {
+		return e
+	}
+	got, e := g.cleanupIdentity(&g.directory)
+	if e != nil || got != want || verifyPrivate(g.directory, sid, true) != nil {
+		return g.failCleanup()
+	}
+	for n := 0; n < 6; n++ {
+		f := g.newCleanupFrame("file-read", n)
+		if f == nil {
+			return ErrPublication
+		}
+		f.ctx = ctx
+		if f.open() != nil {
+			return ErrPublication
+		}
+		if verifyPrivate(g.files[n], sid, false) != nil {
+			return g.failCleanup()
+		}
+		body, v, e := g.readCleanupCell(&g.files[n], 64<<10)
+		if e != nil {
+			return e
+		}
+		want := sha256.Sum256(record)
+		matches := v.Hash == want
+		if n != 0 {
+			matches = hex.EncodeToString(v.Hash[:]) == g.record.Files[n-1]
+		}
+		clear(body)
+		if !matches {
+			return ErrPublication
+		}
+	}
+	c.pathLength, e = windows.GetFinalPathNameByHandle(g.directory, &c.path[0], uint32(len(c.path)), 0)
+	if e != nil || c.pathLength == 0 || c.pathLength >= uint32(len(c.path)) || ctx.Err() != nil {
+		return ErrPublication
+	}
+	base := windows.UTF16ToString(c.path[:c.pathLength])
+	roles := datastoreNames()
+	g.paths = DatastorePaths{filepath.Join(base, roles[0]), filepath.Join(base, roles[1]), filepath.Join(base, roles[2]), filepath.Join(base, roles[3]), filepath.Join(base, roles[4])}
+	return nil
+}
+
+var datastoreCaptureWrite = cleanupKernel.NewProc("WriteFile")
+var datastoreCaptureFlush = cleanupKernel.NewProc("FlushFileBuffers")
+
+func (g *DatastoreGeneration) writeGenerationRoleLocked(ctx context.Context, index int) error {
+	if index < 0 || index >= 6 || g.capture == nil || ctx.Err() != nil {
+		return ErrPublication
+	}
+	w := g.capture.writers[index]
+	if w == nil || w.owner != g || len(w.input) == 0 || len(w.input) > 64<<10 || w.frame != nil {
+		return ErrPublication
+	}
+	if _, e := g.openGenerationRoleLocked(ctx, "credential-create", index); e != nil {
+		return e
+	}
+	if verifyPrivate(w.handle, g.capture.sid, false) != nil {
+		return g.failCleanup()
+	}
+	for w.offset < len(w.input) {
+		if ctx.Err() != nil {
+			return ErrPublication
+		}
+		w.count = 0
+		w.writing = true
+		w.raw, _, w.lastError = datastoreCaptureWrite.Call(uintptr(w.handle), uintptr(unsafe.Pointer(&w.input[w.offset])), uintptr(len(w.input)-w.offset), uintptr(unsafe.Pointer(&w.count)), 0)
+		if uint32(w.raw) == 0 {
+			return g.failCleanup()
+		}
+		w.writing = false
+		if !datastoreGenerationWriteCount(w.count, len(w.input)-w.offset) {
+			return g.failCleanup()
+		}
+		w.offset += int(w.count)
+	}
+	if ctx.Err() != nil {
+		return ErrPublication
+	}
+	if !w.flush.begin() {
+		return g.failCleanup()
+	}
+	w.flush.raw, _, w.flush.lastError = datastoreCaptureFlush.Call(uintptr(w.handle))
+	if uint32(w.flush.raw) == 0 || !w.flush.finish(true) {
+		return g.failCleanup()
+	}
+	if g.closeCleanupCell(&w.handle, &w.close) != nil {
+		return ErrPublication
+	}
+	clear(w.input)
+	return nil
+}
+
+var datastoreCaptureDirectory = cleanupKernel.NewProc("GetFileInformationByHandleEx")
+
+func (g *DatastoreGeneration) enumerateGenerationLocked(ctx context.Context, slot *windows.Handle) ([]string, error) {
+	if !g.cellKnown(slot) || ctx == nil || ctx.Err() != nil || g.capture == nil || len(g.capture.enumerations) >= 2 {
+		return nil, ErrPublication
+	}
+	q := &datastoreGenerationEnumeration{owner: g, source: slot, class: uint32(windows.FileIdBothDirectoryRestartInfo)}
+	g.capture.enumerations = append(g.capture.enumerations, q)
+	var e error
+	q.backing, q.buffer, e = managementDirectoryBuffer(64 << 10)
+	if e != nil {
+		return nil, e
+	}
+	seen := map[string]bool{}
+	for page := 0; page < 4; page++ {
+		if ctx.Err() != nil {
+			return nil, ErrPublication
+		}
+		q.raw, _, q.lastError = datastoreCaptureDirectory.Call(uintptr(*slot), uintptr(q.class), uintptr(unsafe.Pointer(&q.buffer[0])), uintptr(len(q.buffer)))
+		runtime.KeepAlive(q)
+		if uint32(q.raw) == 0 {
+			if nativeCleanupError(q.lastError) == windows.ERROR_NO_MORE_FILES {
+				q.complete = true
+				return q.names, nil
+			}
+			return nil, g.failCleanup()
+		}
+		batch, e := datastoreDirectoryBatch(q.buffer)
+		if e != nil || len(q.names)+len(batch) > maxDatastoreGenerations {
+			return nil, g.failCleanup()
+		}
+		for _, name := range batch {
+			fold := strings.ToLower(name)
+			if seen[fold] {
+				return nil, g.failCleanup()
+			}
+			seen[fold] = true
+			q.names = append(q.names, name)
+		}
+		clear(q.buffer)
+		q.class = uint32(windows.FileIdBothDirectoryInfo)
+	}
+	return nil, g.failCleanup()
+}
+
+var datastoreCaptureOpenProcess = cleanupKernel.NewProc("OpenProcess")
+
+func (g *DatastoreGeneration) observeHistoricalOwnerLocked(ctx context.Context) (datastoreOwnerDisposition, error) {
+	if !g.exactCleanup() || g.capture == nil || g.capture.process != nil || ctx.Err() != nil {
+		return datastoreOwnerUnknown, ErrPublication
+	}
+	want := g.record.Owner
+	if want.PID == 0 || want.Creation == 0 || want.Session == 0 {
+		return datastoreOwnerUnknown, ErrPublication
+	}
+	q := &datastoreGenerationProcess{owner: g}
+	g.capture.process = q // original before output
+	if !datastoreGenerationAdmit(ctx) {
+		return datastoreOwnerUnknown, ErrPublication
+	}
+	q.entered = true
+	q.raw, _, q.lastError = datastoreCaptureOpenProcess.Call(uintptr(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE), 0, uintptr(want.PID))
+	q.handle = windows.Handle(q.raw)
+	query, outcome := datastoreProcessOpenReply(q.raw, uint32(nativeCleanupError(q.lastError)))
+	if !query {
+		if outcome == datastoreOwnerUnknown {
+			return outcome, g.failCleanup()
+		}
+		q.complete = true
+		return outcome, nil
+	}
+	var e error
+	q.pid, e = windows.GetProcessId(q.handle)
+	if e != nil || q.pid != want.PID || windows.GetProcessTimes(q.handle, &q.created, &q.exited, &q.kernel, &q.user) != nil {
+		return datastoreOwnerUnknown, g.failCleanup()
+	}
+	same := uint64(q.created.HighDateTime)<<32|uint64(q.created.LowDateTime) == want.Creation
+	if same {
+		q.wait, e = windows.WaitForSingleObject(q.handle, 0)
+		if e != nil {
+			return datastoreOwnerUnknown, g.failCleanup()
+		}
+	}
+	var known bool
+	outcome, known = datastoreProcessWaitReply(same, q.wait)
+	if !known {
+		return datastoreOwnerUnknown, g.failCleanup()
+	}
+	q.complete = true
+	if g.closeCleanupCell(&q.handle, &q.close) != nil {
+		return datastoreOwnerUnknown, ErrPublication
+	}
+	if ctx.Err() != nil {
+		return datastoreOwnerUnknown, ErrPublication
+	}
+	return outcome, nil
+}
