+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshRecoveryUnadmittedStageDataCannotMintNativeCapability(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	a := freshPublicationFixture()
+	body, e := encodeRuntimeIdentity(a.Runtime, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	n := &nativeRuntimeStorage{home: a.Runtime.Home, captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n, intent: runtimeFreshIntent{Image: a.Runtime.BinarySHA, Commit: a.Runtime.SourceCommit}}
+	o.self = o
+	r := &nativeFreshRecoveryOwner{owner: o, complete: true, stageBody: body}
+	r.self = r
+	n.freshRecovery = r
+	r.stage = &runtimeStorageObject{resource: &runtimeStorageResource{handle: 42}}
+	if p, e := n.resumeUnadmittedPreparedStorage(ctx, a.Runtime); e == nil || p != nil || n.prepared || n.stage != nil || n.attempt.used || r.stage.resource.attempted {
+		t.Fatal("decoded stage and completion flags manufactured original native birth")
+	}
+	copy := &nativeRuntimeStorage{captureSelf: n, freshRecovery: r}
+	if p, e := copy.resumeUnadmittedPreparedStorage(ctx, a.Runtime); e == nil || p != nil {
+		t.Fatal("copied storage issued stage capability")
+	}
+	if p, e := n.resumeUnadmittedPreparedStorage(context.Background(), a.Runtime); e == nil || p != nil {
+		t.Fatal("unbounded recovery reached provider")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_owner_windows.go b/rdd/pkg/managementconfig/runtime_fresh_owner_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..e9b171695f53b3d2eeaa8a338e52050e1d74194b
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_owner_windows.go
@@ -0,0 +1,515 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+// FreshSetupOwner retains the actual selection, SAME setup.lock storage graph,
+// mapped current image and immutable fresh intent. It cannot authorize legacy
+// migration, ordinary startup, management readiness or runtime publication.
+// Construction returns partial custody before reporting failure. Call Close;
+// an unknown result retains the whole graph and the controller.
+type FreshSetupOwner struct {
+	self             *FreshSetupOwner
+	mu               sync.Mutex
+	selection        *authoritypath.ProductSelectionOwner
+	storage          *nativeRuntimeStorage
+	image            *ServingImageLease
+	forwarder        *ServingImageLease
+	forwarderStarted bool
+	pidWriteStarted  bool
+	origin           *nativeRuntimeBuildOrigin
+	keys             []*freshRegistryResource
+	intent           runtimeFreshIntent
+	seed             *nativeFreshSeedCapture
+	fenceObject      *runtimeStorageObject
+	created          *Created
+	legacyDenial     *runtimeFreshLegacyDenial
+	observation      *FreshRuntimeObservation
+	publication      *nativeFreshRuntimePublisher
+	sealed           *nativeFreshCommittedReceipt
+	captureComplete  bool
+	unknown, closed  bool
+	closeErr         error
+}
+type freshRegistryResource struct {
+	handle windows.Handle
+	runtimeStorageCloseAttempt
+}
+
+var freshSetupOwners = struct {
+	sync.Mutex
+	owners map[*FreshSetupOwner]bool
+}{owners: make(map[*FreshSetupOwner]bool)}
+
+func (*FreshSetupOwner) String() string   { return "retained fresh setup owner" }
+func (*FreshSetupOwner) GoString() string { return "retained fresh setup owner" }
+func (o *FreshSetupOwner) fence() {
+	o.unknown = true
+	if o.storage != nil {
+		o.storage.mu.Lock()
+		o.storage.fence()
+		o.storage.mu.Unlock()
+	}
+}
+func freshBoundedContext(ctx context.Context) bool {
+	if ctx == nil || ctx.Err() != nil {
+		return false
+	}
+	_, ok := ctx.Deadline()
+	return ok
+}
+
+// CaptureFreshSetupOwner has no caller path, PID, image/hash or Boolean grant.
+// The process gate is FIRST. Empty bounded public namespace creation is the
+// only effect before the durable fence, alongside the existing setup.lock role.
+func CaptureFreshSetupOwner(ctx context.Context) (o *FreshSetupOwner, result error) {
+	if requireFreshPersistentProcess(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	o = &FreshSetupOwner{}
+	o.self = o
+	freshSetupOwners.Lock()
+	if len(freshSetupOwners.owners) >= 16 {
+		freshSetupOwners.Unlock()
+		return nil, ErrUpgrade
+	}
+	freshSetupOwners.owners[o] = true
+	freshSetupOwners.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fence()
+			panic(p)
+		}
+	}()
+	var e error
+	o.selection, e = authoritypath.CaptureCurrentProduct(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	s, e := o.selection.Selection(ctx)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	root := &InstanceRoot{home: s.GuestHome(), sid: s.Owner(), selection: s}
+	o.storage, e = allocateNativeFreshRuntimeStorageCapture(ctx, root)
+	if e != nil {
+		return o, ErrUpgrade
+	}
+	if o.storage.captureNativeFresh(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if o.checkFreshAbsence(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	if o.captureInitialSeed(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	if o.checkFreshAbsence(ctx) != nil || o.writeIntent(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	o.mu.Lock()
+	o.captureComplete = true
+	o.mu.Unlock()
+	return o, nil
+}
+
+// Only fixed names and actual held parents reach NtCreateFile. Output enters
+// the SAME storage graph before the call, including error-valid output. Caller
+// holds n.mu; an uncertain output fences all resources before any query/close.
+func (o *FreshSetupOwner) openFixed(parent windows.Handle, name string, directory bool, disposition, access uint32, sd *windows.SECURITY_DESCRIPTOR) (*runtimeStorageResource, error) {
+	if !o.nativeOutputsAdmittedLocked() {
+		return nil, ErrUpgrade
+	}
+	n := o.storage
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE)
+	if directory {
+		options = windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_DIRECTORY_FILE
+	}
+	r := n.keep(0)
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ, disposition, options, 0, 0)
+	runtime.KeepAlive(sd)
+	if e = o.fileOutputLocked(r, e); e != nil {
+		return nil, e
+	}
+	return r, nil
+}
+
+// Actual constructor phase/custody only; no native query and no positive file
+// grant. Callers hold storage.mu. Never continue native work after uncertainty.
+func (o *FreshSetupOwner) nativeOutputsAdmittedLocked() bool {
+	if o == nil || o.self != o || o.unknown || o.closed || o.storage == nil {
+		return false
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered {
+		return false
+	}
+	n := o.storage
+	if r := n.freshRecovery; r != nil {
+		if r.owner != o || !r.admitted(n) || !r.complete {
+			return false
+		}
+	}
+	if n.captureSelf != n || !n.captureStarted || !n.captureComplete || n.captureKind != runtimeStorageFreshCapture || n.closeAttempted || n.unknown {
+		return false
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	return known
+}
+
+// This exact actual helper consumes the syscall's pre-registered output slot.
+// Only a confirmed no-output error preserves its precise absence status.
+func (o *FreshSetupOwner) fileOutputLocked(r *runtimeStorageResource, callErr error) error {
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || r == nil || len(n.resources) == 0 || n.resources[len(n.resources)-1] != r {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	valid := r.handle != 0 && r.handle != windows.InvalidHandle
+	e := runtimeStorageOpenReply(callErr, valid, func() {}, n.fence)
+	if e == nil {
+		return nil
+	}
+	if n.unknown {
+		o.unknown = true
+		return ErrUpgrade
+	}
+	n.resources = n.resources[:len(n.resources)-1]
+	return e
+}
+func (o *FreshSetupOwner) checkFreshAbsence(ctx context.Context) error {
+	if o == nil || o.self != o || o.storage == nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() || n.captureSelf != n || !n.captureComplete || n.captureKind != runtimeStorageFreshCapture || n.predecessor != nil || n.checkPrevious() != nil || len(n.ancestry) == 0 {
+		return ErrUpgrade
+	}
+	expectedSeed := ""
+	if o.seed != nil {
+		var e error
+		expectedSeed, e = o.seed.name.name()
+		if e != nil || o.seed.checkLocked(ctx) != nil {
+			return ErrUpgrade
+		}
+	}
+	if n.checkSeedNamespaceLocked(ctx, expectedSeed) != nil {
+		return ErrUpgrade
+	}
+	for _, v := range []struct {
+		parent    windows.Handle
+		name      string
+		directory bool
+	}{
+		{n.parent.resource.handle, "home", true},
+		{n.ancestry[len(n.ancestry)-1].resource.handle, anchorName, true},
+		{n.ancestry[len(n.ancestry)-1].resource.handle, runtimeFreshFenceName, false},
+		{n.ancestry[len(n.ancestry)-1].resource.handle, upgradeFenceName, false},
+	} {
+		_, e := o.openFixed(v.parent, v.name, v.directory, windows.FILE_OPEN, windows.FILE_READ_ATTRIBUTES, nil)
+		if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return ErrUpgrade
+		}
+	}
+	return o.requireNoOwnedRegistration(ctx)
+}
+
+// Registry handles use RegCloseKey, not CloseHandle. Each output is retained
+// before RegOpenKeyEx; no missing-value/error is treated as unregistered.
+func (o *FreshSetupOwner) openKey(parent windows.Handle, name string) (*freshRegistryResource, error) {
+	if !o.nativeOutputsAdmittedLocked() {
+		return nil, ErrUpgrade
+	}
+	p, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	r := &freshRegistryResource{}
+	o.keys = append(o.keys, r)
+	e = windows.RegOpenKeyEx(parent, p, 0, windows.KEY_READ, &r.handle)
+	if e = o.keyOutputLocked(r, e); e != nil {
+		return nil, e
+	}
+	return r, nil
+}
+func (o *FreshSetupOwner) keyOutputLocked(r *freshRegistryResource, callErr error) error {
+	n := o.storage
+	if !o.nativeOutputsAdmittedLocked() || r == nil || len(o.keys) == 0 || o.keys[len(o.keys)-1] != r {
+		o.unknown = true
+		n.fence()
+		return ErrUpgrade
+	}
+	valid := r.handle != 0 && r.handle != windows.InvalidHandle
+	e := runtimeStorageOpenReply(callErr, valid, func() {}, n.fence)
+	if e == nil {
+		return nil
+	}
+	if n.unknown {
+		o.unknown = true
+		return ErrUpgrade
+	}
+	o.keys = o.keys[:len(o.keys)-1]
+	return e
+}
+func (o *FreshSetupOwner) requireNoOwnedRegistration(ctx context.Context) error {
+	r, e := o.openKey(windows.HKEY_CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`)
+	if e == windows.ERROR_FILE_NOT_FOUND {
+		return nil
+	}
+	if e != nil {
+		return ErrUpgrade
+	}
+	for i := uint32(0); i <= 512; i++ {
+		if !freshBoundedContext(ctx) || !o.nativeOutputsAdmittedLocked() {
+			return ErrUpgrade
+		}
+		var name [64]uint16
+		count := uint32(len(name))
+		e := windows.RegEnumKeyEx(r.handle, i, &name[0], &count, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			return nil
+		}
+		if e != nil || i == 512 || count == 0 || count >= uint32(len(name)) {
+			return ErrUpgrade
+		}
+		child, e := o.openKey(r.handle, windows.UTF16ToString(name[:count]))
+		if e != nil {
+			return ErrUpgrade
+		}
+		value, _ := windows.UTF16PtrFromString("DistributionName")
+		var data [512]byte
+		size := uint32(len(data))
+		var kind uint32
+		if !o.nativeOutputsAdmittedLocked() {
+			return ErrUpgrade
+		}
+		if windows.RegQueryValueEx(child.handle, value, nil, &kind, &data[0], &size) != nil || kind != windows.REG_SZ || size < 2 || size > 512 || size%2 != 0 {
+			return ErrUpgrade
+		}
+		units := make([]uint16, size/2)
+		for j := range units {
+			units[j] = uint16(data[2*j]) | uint16(data[2*j+1])<<8
+		}
+		if units[len(units)-1] != 0 {
+			return ErrUpgrade
+		}
+		for _, u := range units[:len(units)-1] {
+			if u == 0 {
+				return ErrUpgrade
+			}
+		}
+		if runtimeFreshOwnedRegistrationName(windows.UTF16ToString(units)) {
+			return ErrUpgrade
+		}
+	}
+	return ErrUpgrade
+}
+
+func (o *FreshSetupOwner) writeIntent(ctx context.Context) error {
+	if !freshBoundedContext(ctx) || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return ErrUpgrade
+	}
+	body, e := encodeRuntimeFreshIntent(o.intent)
+	if e != nil {
+		return ErrUpgrade
+	}
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.checkPrevious() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if o.seed == nil || o.seed.checkLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	sd, e := privateDescriptor(n.sid, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r, e := o.openFixed(n.ancestry[len(n.ancestry)-1].resource.handle, runtimeFreshFenceName, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, sd)
+	if e != nil {
+		return ErrUpgrade
+	}
+	// After CREATE even a known cancellation leaves a durable refusal fence.
+	for at := 0; at < len(body); {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		count, e := nativeWrite(r.handle, body[at:])
+		if e != nil || count < 1 || count > len(body)-at {
+			return ErrUpgrade
+		}
+		at += count
+	}
+	if windows.FlushFileBuffers(r.handle) != nil {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	object := &runtimeStorageObject{resource: r, identity: id, private: true}
+	read, e := n.read(object, false)
+	if e != nil || !bytes.Equal(body, read) {
+		return ErrUpgrade
+	}
+	if n.closeTemporary(r) != nil {
+		return ErrUpgrade
+	}
+	r, e = o.openFixed(n.ancestry[len(n.ancestry)-1].resource.handle, runtimeFreshFenceName, false, windows.FILE_OPEN, windows.FILE_READ_DATA, nil)
+	if e != nil {
+		return ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(r.handle, n.sid, false, true, false)
+	if e != nil || !runtimeStorageCreatedSame(actual, id) {
+		return ErrUpgrade
+	}
+	o.fenceObject = &runtimeStorageObject{resource: r, identity: actual, private: true}
+	read, e = n.read(o.fenceObject, false)
+	if e != nil || !bytes.Equal(body, read) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if n.checkFreshSeedIntentLocked(ctx, o.intent, runtimeStorageFileData(o.fenceObject, read)) != nil || o.flushFreshSeedParentLocked(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (o *FreshSetupOwner) Close() error {
+	if o == nil {
+		return nil
+	}
+	if o.self != o {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.closed {
+		return o.closeErr
+	}
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	if !registered {
+		return ErrUpgrade
+	}
+	// Borrowed storage uncertainty must fence BEFORE our image/origin/registry
+	// suffix can be queried or closed. Incomplete actual birth may still clean up.
+	if !o.knownStorageCloseLocked() {
+		o.fence()
+		return ErrUpgrade
+	}
+	// The existing actual service owner joins resources before closing SAME
+	// Created. Unknown/active closure retains this controller, without a bool.
+	if !o.createdRetiredLocked() {
+		return ErrUpgrade
+	}
+	if closeFreshRuntimePublicationLocked(o) != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	if closeFreshRuntimeObservationLocked(o) != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.closeServingForwarderLocked() != nil {
+		return ErrUpgrade
+	}
+	o.closed = true
+	o.closeErr = ErrUpgrade
+	defer func() {
+		if p := recover(); p != nil {
+			o.fence()
+			panic(p)
+		}
+	}()
+	if o.origin != nil && o.origin.Close() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.image != nil && o.image.Close() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	for i := len(o.keys) - 1; i >= 0; i-- {
+		r := o.keys[i]
+		if r.run(func() error {
+			if windows.RegCloseKey(r.handle) != nil {
+				return ErrUpgrade
+			}
+			r.handle = 0
+			return nil
+		}, o.fence) != nil {
+			return ErrUpgrade
+		}
+	}
+	if o.selection != nil && o.selection.Close() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	if o.storage != nil && o.storage.Close() != nil {
+		o.fence()
+		return ErrUpgrade
+	}
+	o.closeErr = nil
+	forgetFreshRecoveryLocked(o)
+	freshSetupOwners.Lock()
+	delete(freshSetupOwners.owners, o)
+	freshSetupOwners.Unlock()
+	return nil
+}
+
+// Pure actual cached-close classification (caller holds owner.mu). A completed
+// n.Close is legal ONLY through this SAME concrete checked committed seal.
+// Unknown always fences before any remaining service/native suffix can close.
+func (o *FreshSetupOwner) knownStorageCloseLocked() bool {
+	n := o.storage
+	if n == nil {
+		return true
+	}
+	if n.captureSelf != n {
+		return false
+	}
+	sealed := o.sealed != nil && o.sealed.sealedStateLocked(o)
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtimeStorageDomain.Lock()
+	defer runtimeStorageDomain.Unlock()
+	if n.unknown || n.closeErr != nil || runtimeStorageDomain.failed {
+		return false
+	}
+	if n.closeAttempted {
+		return sealed && !runtimeStorageDomain.owners[n]
+	}
+	return runtimeStorageDomain.owners[n]
+}
