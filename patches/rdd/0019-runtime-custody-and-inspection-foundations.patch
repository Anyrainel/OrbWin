+
+func TestRuntimeStorageCloseRetainsActiveManagementChild(t *testing.T) {
+	n := &nativeRuntimeStorage{}
+	n.captureSelf = n
+	// A denial-only fixture: neither fake handle may reach a native closer.
+	resource := &runtimeStorageResource{handle: 42}
+	n.resources = []*runtimeStorageResource{resource}
+	child := &nativeRuntimeUpgradeManagementObservation{storage: n}
+	child.self = child
+	n.management = child
+	if err := n.Close(); err == nil {
+		t.Fatal("storage closed while its exact management child was retained")
+	}
+	if n.closeAttempted || resource.attempted || resource.handle != 42 || n.management != child {
+		t.Fatal("refused parent close consumed child or native custody")
+	}
+	if err := n.Close(); err == nil || n.closeAttempted || resource.attempted {
+		t.Fatal("repeated refusal attempted ancestor release")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_storage_prepare_admission.go b/rdd/pkg/managementconfig/runtime_storage_prepare_admission.go
