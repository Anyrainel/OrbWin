+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type inspectionContractBadWriter struct{}
+
+func (inspectionContractBadWriter) Write([]byte) (int, error) { return 0, errors.New("closed output") }
+func TestInspectionEntryValidatesWholeFrameBeforeCapture(t *testing.T) {
+	calls := 0
+	capture := func(context.Context) (runtimeInspectionResult, error) {
+		calls++
+		return inspectionUnknown("observation-unknown"), nil
+	}
+	for _, input := range [][]byte{nil, inspectionFrame(`{"schema":1,"operation":"inspect"}`), append(inspectionFrame(runtimeInspectionRequest), 0), inspectionFrame(`{"schema":2,"operation":"inspect","pid":1}`)} {
+		if runRuntimeInspectionEntry(context.Background(), bytes.NewReader(input), &bytes.Buffer{}, capture) == nil || calls != 0 {
+			t.Fatal("unvalidated input reached capture")
+		}
+	}
+	var output bytes.Buffer
+	if runRuntimeInspectionEntry(context.Background(), bytes.NewReader(inspectionFrame(runtimeInspectionRequest)), &output, capture) != nil || calls != 1 {
+		t.Fatal("valid capture")
+	}
+	if _, e := parseRuntimeInspectionResult(output.Bytes()); e != nil {
+		t.Fatal("noncanonical output")
+	}
+}
+func TestInspectionEntryNativeAndOutputFailuresNeverEmitSuccess(t *testing.T) {
+	input := func() *bytes.Reader { return bytes.NewReader(inspectionFrame(runtimeInspectionRequest)) }
+	var output bytes.Buffer
+	capture := func(context.Context) (runtimeInspectionResult, error) {
+		return runtimeInspectionResult{}, errors.New("native unknown")
+	}
+	if runRuntimeInspectionEntry(context.Background(), input(), &output, capture) == nil || output.Len() != 0 {
+		t.Fatal("native failure emitted success")
+	}
+	capture = func(context.Context) (runtimeInspectionResult, error) {
+		return inspectionUnknown("observation-unknown"), nil
+	}
+	if runRuntimeInspectionEntry(context.Background(), input(), inspectionContractBadWriter{}, capture) == nil {
+		t.Fatal("output failure")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if runRuntimeInspectionEntry(ctx, input(), &output, capture) == nil {
+		t.Fatal("canceled parent")
+	}
+	ctx, cancel = context.WithTimeout(context.Background(), time.Millisecond)
+	defer cancel()
+	capture = func(ctx context.Context) (runtimeInspectionResult, error) {
+		<-ctx.Done()
+		return inspectionUnknown("observation-unknown"), nil
+	}
+	output.Reset()
+	if runRuntimeInspectionEntry(ctx, input(), &output, capture) == nil || output.Len() != 0 {
+		t.Fatal("expired capture emitted output")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_image_windows.go b/rdd/pkg/managementconfig/runtime_inspection_image_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..7afe932425573cf681df25c38f53b4a91e0a35de
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_image_windows.go
@@ -0,0 +1,111 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"strings"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/version"
+	"golang.org/x/sys/windows"
+)
+
+var inspectionQueryProcess = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryInformationProcess")
+
+type inspectionImageFrame struct {
+	argument windows.Handle
+	length   uint32
+	path     [1024]uint16
+	words    [8192]uint64
+	count    uint32
+}
+
+func (o *inspectionNativeOwner) imageBinding(ctx context.Context, image *inspectionNativeObject) error {
+	if !o.known(ctx) || !o.ownsObject(image) || image.directory {
+		return errRuntimeInspection
+	}
+	frame := &inspectionImageFrame{argument: image.slot.handle}
+	o.imageFrame = frame
+	// Existing qualified class44 primitive: same executing process and actual
+	// original FILE_OBJECT input. No section extraction, PID or new process cap.
+	status, _, _ := inspectionQueryProcess.Call(uintptr(windows.CurrentProcess()), 44, uintptr(unsafe.Pointer(&frame.argument)), unsafe.Sizeof(frame.argument), uintptr(unsafe.Pointer(&frame.length)))
+	if !inspectionNTSuccess(status) || frame.argument != image.slot.handle {
+		return errRuntimeInspection
+	}
+	o.imageFrame = nil
+	return nil
+}
+func (o *inspectionNativeOwner) captureImage(ctx context.Context) error {
+	if !o.known(ctx) || o.selected == nil {
+		return errRuntimeInspection
+	}
+	frame := &inspectionImageFrame{count: 1024}
+	o.imageFrame = frame
+	if windows.QueryFullProcessImageName(windows.CurrentProcess(), 0, &frame.path[0], &frame.count) != nil || frame.count == 0 || frame.count >= 1024 {
+		return errRuntimeInspection
+	}
+	imagePath := windows.UTF16ToString(frame.path[:frame.count])
+	expected, e := servingImageDigest(o.selected.Profile(), imagePath)
+	if e != nil {
+		return errRuntimeInspection
+	}
+	at := strings.LastIndex(imagePath, `\`)
+	if at < 0 || !strings.EqualFold(imagePath[at+1:], "rdd.exe") {
+		return errRuntimeInspection
+	}
+	parent, e := o.walk(ctx, imagePath[:at], true)
+	if e != nil {
+		return errRuntimeInspection
+	}
+	image, e := o.open(ctx, parent, "rdd.exe", false, true, false, windows.FILE_READ_DATA|windows.FILE_EXECUTE)
+	if e != nil || image.legacy.size == 0 || image.legacy.size > 512<<20 {
+		return errRuntimeInspection
+	}
+	if o.imageBinding(ctx, image) != nil {
+		return errRuntimeInspection
+	}
+	frame = &inspectionImageFrame{}
+	o.imageFrame = frame
+	digest := sha256.New()
+	var total uint64
+	buffer := unsafe.Slice((*byte)(unsafe.Pointer(&frame.words[0])), 65536)
+	for {
+		if !o.known(ctx) {
+			return errRuntimeInspection
+		}
+		frame.count = 0
+		e = windows.ReadFile(image.slot.handle, buffer, &frame.count, nil)
+		if frame.count > uint32(len(buffer)) || e != nil && e != windows.ERROR_HANDLE_EOF {
+			return errRuntimeInspection
+		}
+		total += uint64(frame.count)
+		if total > 512<<20 {
+			return errRuntimeInspection
+		}
+		if frame.count > 0 {
+			_, _ = digest.Write(buffer[:frame.count])
+		}
+		if e == windows.ERROR_HANDLE_EOF || frame.count == 0 {
+			break
+		}
+	}
+	var actual [32]byte
+	copy(actual[:], digest.Sum(nil))
+	if actual != expected || total != image.legacy.size || o.checkObject(ctx, image) != nil || o.imageBinding(ctx, image) != nil || !upgradeHex(version.GitCommit, 40) {
+		return errRuntimeInspection
+	}
+	o.selfImage, o.selfHash, o.selfCommit = image, actual, version.GitCommit
+	o.imageFrame = nil
+	return nil
+}
+func (o *inspectionNativeOwner) recheckImage(ctx context.Context) error {
+	if o.selfImage == nil {
+		return nil
+	}
+	if !upgradeHex(o.selfCommit, 40) || version.GitCommit != o.selfCommit || o.checkObject(ctx, o.selfImage) != nil || o.imageBinding(ctx, o.selfImage) != nil {
+		return errRuntimeInspection
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_model.go b/rdd/pkg/managementconfig/runtime_inspection_model.go
new file mode 100644
index 0000000000000000000000000000000000000000..56bc72f30142ab9cb1d996a15ebb810f51b30341
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_model.go
@@ -0,0 +1,191 @@
+package managementconfig
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"sort"
+	"strings"
+	"unicode/utf16"
+)
+
+const inspectionSecurityLimit = 65536
+const inspectionDirectoryEntryLimit = 512
+
+// Win32 BOOL and native NTSTATUS returns are 32-bit even on AMD64. The
+// uintptr return register is retained by the caller; only interpretation is
+// narrowed here. Never use these helpers to narrow HANDLE or SIZE_T values.
+func inspectionWinBOOL(raw uintptr) bool   { return uint32(raw) != 0 }
+func inspectionNTSuccess(raw uintptr) bool { return uint32(raw) == 0 }
+
+// DATA close/output states; these never construct a native owner or capability.
+type inspectionResourceState struct {
+	pending, attempted bool
+	err                error
+}
+
+func (s *inspectionResourceState) reply(call error, output, valid bool) (discard, unknown bool, result error) {
+	if s == nil || !s.pending || s.attempted {
+		return false, true, errRuntimeInspection
+	}
+	if valid && !output {
+		return false, true, errRuntimeInspection
+	}
+	if call != nil && !output {
+		s.pending = false
+		return true, false, call
+	}
+	if call != nil || !valid {
+		return false, true, errRuntimeInspection
+	}
+	s.pending = false
+	return false, false, nil
+}
+func (s *inspectionResourceState) beginClose() (bool, error) {
+	if s == nil || s.pending {
+		return false, errRuntimeInspection
+	}
+	if s.attempted {
+		return false, s.err
+	}
+	s.attempted = true
+	s.err = errRuntimeInspection
+	return true, nil
+}
+func inspectionProbeSize(ok bool, code, needed uint32) error {
+	// ERROR_INSUFFICIENT_BUFFER, not an arbitrary error carrying a size echo.
+	if ok || code != 122 || needed < 20 || needed > inspectionSecurityLimit {
+		return errRuntimeInspection
+	}
+	return nil
+}
+func inspectionFetchSize(ok bool, needed, capacity uint32) error {
+	if !ok || needed < 20 || needed > capacity || capacity > inspectionSecurityLimit {
+		return errRuntimeInspection
+	}
+	return nil
+}
+
+// FILE_FULL_DIR_INFO, caller buffer from a positively completed native query.
+// Only finite ASCII fixed-role names are supported; unexpected names refuse.
+func inspectionDirectoryPage(raw []byte) ([]string, error) {
+	var names []string
+	at := 0
+	for len(names) <= inspectionDirectoryEntryLimit {
+		if at < 0 || at%8 != 0 || len(raw)-at < 68 {
+			return nil, errRuntimeInspection
+		}
+		next := binary.LittleEndian.Uint32(raw[at:])
+		n := binary.LittleEndian.Uint32(raw[at+60:])
+		if n == 0 || n > 512 || n%2 != 0 || uint64(at)+68+uint64(n) > uint64(len(raw)) {
+			return nil, errRuntimeInspection
+		}
+		name := make([]byte, n/2)
+		for i := range name {
+			u := binary.LittleEndian.Uint16(raw[at+68+2*i:])
+			if u > 127 || !(u >= 'a' && u <= 'z' || u >= 'A' && u <= 'Z' || u >= '0' && u <= '9' || u == '.' || u == '_' || u == '-') {
+				return nil, errRuntimeInspection
+			}
+			name[i] = byte(u)
+		}
+		text := string(name)
+		if text != "." && text != ".." {
+			if strings.HasSuffix(text, ".") {
+				return nil, errRuntimeInspection
+			}
+			names = append(names, text)
+		}
+		if next == 0 {
+			return names, nil
+		}
+		if next%8 != 0 || next < 68+n || uint64(at)+uint64(next) >= uint64(len(raw)) {
+			return nil, errRuntimeInspection
+		}
+		at += int(next)
+	}
+	return nil, errRuntimeInspection
+}
+func inspectionClosedNames(names []string) ([]string, error) {
+	if len(names) > inspectionDirectoryEntryLimit {
+		return nil, errRuntimeInspection
+	}
+	out := append([]string(nil), names...)
+	sort.Strings(out)
+	seen := map[string]bool{}
+	for _, n := range out {
+		k := strings.ToLower(n)
+		if n == "" || seen[k] {
+			return nil, errRuntimeInspection
+		}
+		seen[k] = true
+	}
+	return out, nil
+}
+func inspectionFreshPrivateNames(names []string) bool {
+	for _, n := range names {
+		if n != "runtime" && n != "setup-logs" {
+			return false
+		}
+	}
+	return true
+}
+
+func inspectionRegistryString(raw []byte) (string, error) {
+	if len(raw) < 2 || len(raw) > 2048 || len(raw)%2 != 0 {
+		return "", errRuntimeInspection
+	}
+	units := make([]uint16, len(raw)/2)
+	for i := range units {
+		units[i] = binary.LittleEndian.Uint16(raw[2*i:])
+	}
+	if units[len(units)-1] != 0 {
+		return "", errRuntimeInspection
+	}
+	units = units[:len(units)-1]
+	if len(units) == 0 {
+		return "", errRuntimeInspection
+	}
+	for i := 0; i < len(units); i++ {
+		u := units[i]
+		if u == 0 || u < 32 {
+			return "", errRuntimeInspection
+		}
+		if u >= 0xd800 && u <= 0xdbff {
+			if i+1 >= len(units) || units[i+1] < 0xdc00 || units[i+1] > 0xdfff {
+				return "", errRuntimeInspection
+			}
+			i++
+		} else if u >= 0xdc00 && u <= 0xdfff {
+			return "", errRuntimeInspection
+		}
+	}
+	return string(utf16.Decode(units)), nil
+}
+func inspectionFullIDKnown(raw [24]byte) bool {
+	if binary.LittleEndian.Uint64(raw[:8]) == 0 {
+		return false
+	}
+	for _, b := range raw[8:] {
+		if b != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// Extra future/seed fields cannot silently widen this frozen legacy subset.
+// Actual canonical package validators still run before this negative guard.
+func inspectionClosedFields(body []byte, names ...string) bool {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(body, &fields) != nil || len(fields) != len(names) {
+		return false
+	}
+	for _, name := range names {
+		if _, ok := fields[name]; !ok {
+			return false
+		}
+	}
+	return true
+}
+func inspectionLegacyAdmissionShape(body []byte) bool {
+	return inspectionClosedFields(body, "schema", "transaction", "intent", "legacyDenial", "Parent", "Controller", "Authority", "AuthorityLock", "ParentDescriptor", "ControllerDescriptor", "AuthorityLockDescriptor", "Args", "Initialization", "Candidate", "Stage", "Runtime")
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_model_test.go b/rdd/pkg/managementconfig/runtime_inspection_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a7906c03061d99b5ee64a66fc4a81bfa95ebbc53
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_model_test.go
@@ -0,0 +1,214 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+)
+
+func inspectionTestSD(t *testing.T, directory bool, foreignMask *uint32) ([]byte, []byte) {
+	t.Helper()
+	user, e := inspectionParseSID("S-1-5-21-7-8-9-1001")
+	if e != nil {
+		t.Fatal(e)
+	}
+	system, _ := inspectionParseSID("S-1-5-18")
+	admins, _ := inspectionParseSID("S-1-5-32-544")
+	principals := [][]byte{user, system, admins}
+	if foreignMask != nil {
+		world, _ := inspectionParseSID("S-1-1-0")
+		principals = append(principals, world)
+	}
+	acl := make([]byte, 8)
+	acl[0] = 2
+	binary.LittleEndian.PutUint16(acl[4:], uint16(len(principals)))
+	for i, s := range principals {
+		a := make([]byte, 8+len(s))
+		if directory {
+			a[1] = 3
+		}
+		binary.LittleEndian.PutUint16(a[2:], uint16(len(a)))
+		mask := uint32(0x1f01ff)
+		if i == 3 {
+			mask = *foreignMask
+		}
+		binary.LittleEndian.PutUint32(a[4:], mask)
+		copy(a[8:], s)
+		acl = append(acl, a...)
+	}
+	binary.LittleEndian.PutUint16(acl[2:], uint16(len(acl)))
+	raw := make([]byte, 20)
+	raw[0] = 1
+	binary.LittleEndian.PutUint16(raw[2:], 0x9004)
+	binary.LittleEndian.PutUint32(raw[4:], 20)
+	binary.LittleEndian.PutUint32(raw[16:], uint32(20+len(user)))
+	raw = append(raw, user...)
+	raw = append(raw, acl...)
+	return raw, user
+}
+func TestInspectionExactProductSecurityAndBoundedLayouts(t *testing.T) {
+	for _, directory := range []bool{false, true} {
+		raw, user := inspectionTestSD(t, directory, nil)
+		if f, e := inspectionSecurity(raw, user, directory, true, false); e != nil || f.descriptor == [32]byte{} || !f.protected {
+			t.Fatal("actual product3ACE shape refused")
+		}
+		for i := 0; i < len(raw); i++ {
+			if _, e := inspectionSecurity(raw[:i], user, directory, true, false); e == nil {
+				t.Fatal("truncation accepted", i)
+			}
+		}
+		for _, mutate := range []func([]byte){func(b []byte) { b[0] = 2 }, func(b []byte) { b[1] = 1 }, func(b []byte) { b[3] &^= 0x10 }, func(b []byte) { binary.LittleEndian.PutUint32(b[4:], 21) }, func(b []byte) { binary.LittleEndian.PutUint32(b[16:], 20) }, func(b []byte) { b[20] = 0 }, func(b []byte) { b[21] = 255 }, func(b []byte) { off := int(binary.LittleEndian.Uint32(b[16:])); b[off+8] = 2 }, func(b []byte) { off := int(binary.LittleEndian.Uint32(b[16:])); b[off+9] ^= 8 }, func(b []byte) {
+			off := int(binary.LittleEndian.Uint32(b[16:]))
+			binary.LittleEndian.PutUint32(b[off+12:], 0x120089)
+		}} {
+			bad := append([]byte(nil), raw...)
+			mutate(bad)
+			if _, e := inspectionSecurity(bad, user, directory, true, false); e == nil {
+				t.Fatal("unsupported private shape accepted")
+			}
+		}
+		other, _ := inspectionParseSID("S-1-5-21-7-8-9-1002")
+		if _, e := inspectionSecurity(raw, other, directory, true, false); e == nil {
+			t.Fatal("other native user accepted")
+		}
+	}
+	raw, user := inspectionTestSD(t, true, nil)
+	if _, e := inspectionSecurity(append(raw, make([]byte, 65537)...), user, true, true, false); e == nil {
+		t.Fatal("oversize accepted")
+	}
+}
+func TestInspectionPublicTraversalKeepsExactForeignMutationBoundary(t *testing.T) {
+	for _, mask := range []uint32{2, 4, 2 | 4} {
+		raw, user := inspectionTestSD(t, true, &mask)
+		if _, e := inspectionSecurity(raw, user, true, false, true); e != nil {
+			t.Fatal("existing ancestor childcreation policy narrowed unexpectedly")
+		}
+		if _, e := inspectionSecurity(raw, user, true, false, false); e == nil {
+			t.Fatal("strict boundary accepted foreign create")
+		}
+		if _, e := inspectionSecurity(raw, user, true, true, false); e == nil {
+			t.Fatal("private3ACE relaxed")
+		}
+	}
+	for _, mask := range []uint32{0x10000, 0x40000, 0x80000, 0x10, 0x100, 0x40, 0x40000000, 0x10000000} {
+		raw, user := inspectionTestSD(t, true, &mask)
+		if _, e := inspectionSecurity(raw, user, true, false, true); e == nil {
+			t.Fatal("foreign ancestor mutation accepted", mask)
+		}
+	}
+	for _, sid := range []string{"", "s-1-5-18", "S-2-5-18", "S-1-05-18", "S-1-5-018", "S-1-5--1", "S-1-5-4294967296"} {
+		if _, e := inspectionParseSID(sid); e == nil {
+			t.Fatal("SID alias accepted")
+		}
+	}
+}
+func TestInspectionMetadataRefusalDoesNotBecomeValidBuffer(t *testing.T) {
+	if inspectionProbeSize(false, 122, 20) != nil || inspectionFetchSize(true, 20, 20) != nil {
+		t.Fatal("bounded query DATA refused")
+	}
+	for _, v := range []struct {
+		ok      bool
+		code, n uint32
+	}{{true, 0, 20}, {false, 5, 20}, {false, 122, 19}, {false, 122, 65537}, {false, 122, 0}} {
+		if inspectionProbeSize(v.ok, v.code, v.n) == nil {
+			t.Fatal("failed probe parsed")
+		}
+	}
+	for _, v := range []struct {
+		ok   bool
+		n, c uint32
+	}{{false, 20, 20}, {true, 0, 20}, {true, 19, 20}, {true, 21, 20}, {true, 20, 65537}} {
+		if inspectionFetchSize(v.ok, v.n, v.c) == nil {
+			t.Fatal("partial fetch parsed")
+		}
+	}
+}
+func TestInspectionOutputAndCachedCloseData(t *testing.T) {
+	for _, v := range []struct {
+		e                               error
+		output, valid, discard, unknown bool
+	}{{nil, true, true, false, false}, {errRuntimeInspection, false, false, true, false}, {nil, false, false, false, true}, {errRuntimeInspection, true, true, false, true}, {errRuntimeInspection, true, false, false, true}, {nil, true, false, false, true}, {nil, false, true, false, true}} {
+		s := &inspectionResourceState{pending: true}
+		discard, unknown, e := s.reply(v.e, v.output, v.valid)
+		if discard != v.discard || unknown != v.unknown || (!unknown && !discard && e != nil) {
+			t.Fatal("output DATA classification")
+		}
+		if unknown {
+			if ok, _ := s.beginClose(); ok {
+				t.Fatal("pending close crossed unknown")
+			}
+		} else if !discard {
+			if ok, e := s.beginClose(); !ok || e != nil {
+				t.Fatal("close start")
+			}
+			if ok, e := s.beginClose(); ok || e == nil {
+				t.Fatal("unknown close replay")
+			}
+			s.err = nil
+			if ok, e := s.beginClose(); ok || e != nil {
+				t.Fatal("positive cached close replay")
+			}
+		}
+	}
+}
+func inspectionTestDirectory(name string) []byte {
+	b := make([]byte, 68+2*len(name))
+	binary.LittleEndian.PutUint32(b[60:], uint32(2*len(name)))
+	for i, c := range []byte(name) {
+		binary.LittleEndian.PutUint16(b[68+i*2:], uint16(c))
+	}
+	return b
+}
+func TestInspectionDirectoryPagesAndFreshCatalogAreBoundedData(t *testing.T) {
+	a := inspectionTestDirectory("runtime")
+	n := (len(a) + 7) &^ 7
+	b := append(append(a, make([]byte, n-len(a))...), inspectionTestDirectory("setup-logs")...)
+	binary.LittleEndian.PutUint32(b, uint32(n))
+	names, e := inspectionDirectoryPage(b)
+	if e != nil || !inspectionFreshPrivateNames(names) {
+		t.Fatal("fixed unrelated siblings refused", e)
+	}
+	for _, name := range []string{"authority", "authority.fresh", "authority.fresh.seed", "authority.fresh.app-create.stage", "clients", "setup.lock"} {
+		if inspectionFreshPrivateNames([]string{name}) {
+			t.Fatal("transaction state ignored", name)
+		}
+	}
+	for _, raw := range [][]byte{nil, bytes.Repeat([]byte{0}, 68), inspectionTestDirectory("../escape"), inspectionTestDirectory("hidden."), func() []byte { v := append([]byte(nil), b...); binary.LittleEndian.PutUint32(v, 1); return v }(), func() []byte {
+		v := inspectionTestDirectory("runtime")
+		binary.LittleEndian.PutUint32(v[60:], 0xffffffff)
+		return v
+	}()} {
+		if _, e := inspectionDirectoryPage(raw); e == nil {
+			t.Fatal("invalid directory frame accepted")
+		}
+	}
+	if _, e := inspectionClosedNames([]string{"runtime", "RUNTIME"}); e == nil {
+		t.Fatal("casefold duplicate ignored")
+	}
+	if _, e := inspectionClosedNames(make([]string, 513)); e == nil {
+		t.Fatal("directory bound ignored")
+	}
+}
+
+func TestInspectionNativeIdentityAndRegistryTextAreClosedData(t *testing.T) {
+	var id [24]byte
+	if inspectionFullIDKnown(id) {
+		t.Fatal("empty ID accepted")
+	}
+	id[0] = 1
+	if inspectionFullIDKnown(id) {
+		t.Fatal("missing128bit fileID accepted")
+	}
+	id[8] = 1
+	if !inspectionFullIDKnown(id) {
+		t.Fatal("full native ID DATA refused")
+	}
+	for _, raw := range [][]byte{nil, {0}, {1, 0}, {0, 0, 0, 0}, {0, 0xd8, 0, 0}, {0, 0xdc, 0, 0}, {'a', 0, 0, 0, 'b', 0, 0, 0}} {
+		if _, e := inspectionRegistryString(raw); e == nil {
+			t.Fatal("partial/alias registry data accepted")
+		}
+	}
+	if value, e := inspectionRegistryString([]byte{'a', 0, 'b', 0, 0, 0}); e != nil || value != "ab" {
+		t.Fatal("bounded UTF16 data refused")
+	}
+}
