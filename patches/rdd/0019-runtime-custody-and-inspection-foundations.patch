+package managementconfig
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestRuntimeFreshAppStageCrashPrefixesPreserveCompleteNonce(t *testing.T) {
+	r := freshAppRecordFixture(t)
+	body, e := runtimeFreshRecordBytes(r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for cut := 0; cut < len(body); cut++ {
+		got, canonical, shape := classifyFreshAppStage(body[:cut])
+		if cut == len(body)-1 {
+			if shape != freshAppStageNeedsNewline || got.Nonce != r.Nonce || !bytes.Equal(got.Template, r.Template) || !bytes.Equal(canonical, body) {
+				t.Fatal("complete record lost template/nonce at final newline cut")
+			}
+		} else if shape != freshAppStagePartial {
+			t.Fatalf("actual write prefix at %d not recoverable partial: %d", cut, shape)
+		}
+	}
+	got, canonical, shape := classifyFreshAppStage(body)
+	if shape != freshAppStageComplete || got.Nonce != r.Nonce || !bytes.Equal(canonical, body) {
+		t.Fatal("complete stage changed")
+	}
+	for _, bad := range [][]byte{[]byte(`{}`), append(body, body...), []byte("not-json"), bytes.Repeat([]byte{'x'}, runtimeFreshRecordBudget+1)} {
+		if _, _, shape := classifyFreshAppStage(bad); shape != freshAppStageInvalid {
+			t.Fatal("unknown stage treated as interrupted source write")
+		}
+	}
+}
+
+func TestRuntimeFreshAppBindingKeepsOriginalFactsAcrossNewProducer(t *testing.T) {
+	original := freshAppRecordFixture(t)
+	current := original
+	current.Producer.PID++
+	current.Producer.Creation++
+	if !freshAppBindingMatches(current, original) {
+		t.Fatal("same source native generation renewal refused")
+	}
+	for _, change := range []func(*runtimeFreshAppRecord){func(r *runtimeFreshAppRecord) { r.Parent.Low++ }, func(r *runtimeFreshAppRecord) { r.Controller.Low++ }, func(r *runtimeFreshAppRecord) { r.ParentDescriptor[0]++ }, func(r *runtimeFreshAppRecord) { r.ControllerDescriptor[0]++ }, func(r *runtimeFreshAppRecord) { r.Authority.Low++ }, func(r *runtimeFreshAppRecord) { r.AuthorityLock.Low++ }, func(r *runtimeFreshAppRecord) { r.LockDescriptor[0]++ }, func(r *runtimeFreshAppRecord) { r.Args.Body[0]++ }, func(r *runtimeFreshAppRecord) { r.Producer.Image[0]++ }} {
+		bad := current
+		change(&bad)
+		if freshAppBindingMatches(bad, original) {
+			t.Fatal("different native original binding admitted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_app_stage_windows.go b/rdd/pkg/managementconfig/runtime_fresh_app_stage_windows.go
