+		n := &nativeManagedNamespace{activated: true, unknown: unknown, resources: []*runtimeStorageResource{r}}
+		if n.close() == nil || n.closeAttempt.attempted || r.attempted || r.handle != 42 {
+			t.Fatal("unretired/unknown namespace touched an owned native slot")
+		}
+	}
+}
