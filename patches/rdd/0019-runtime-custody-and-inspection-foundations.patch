+		return nil, ErrUpgrade
+	}
+	port, e := o.credentialPortLocked(ctx)
+	if e != nil || port != o.port || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return o, nil
+}
+
+// Emits observed generation/hash DATA, never OldService/home/Stop authority.
+func (o *nativeUpgradeOldListenerObservation) observed(ctx context.Context) (UpgradeProcess, error) {
+	if !runtimeUpgradeOldListenerKnown(o) || ctx == nil || !runtimeUpgradeArgsBorrowedBirth(o.args) || o.storage != o.args.storage {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	a := o.args
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n, l := o.storage, a.inventory
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLocked()
+			panic(p)
+		}
+	}()
+	if o.admitBorrowedLocked() != runtimeBorrowedLive {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok || ctx.Err() != nil {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if o.checkLocked(ctx) != nil {
+		o.admitBorrowedLocked()
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	return o.generation, nil
+}
+func (o *nativeUpgradeOldListenerObservation) Close() error {
+	if o == nil || o.self != o || o.storage == nil || o.storage.captureSelf != o.storage {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		return ErrUpgrade
+	}
+	if o.closed {
+		return nil
+	}
+	if !runtimeUpgradeOldListenerKnown(o) || !runtimeUpgradeArgsBorrowedBirth(o.args) || o.storage != o.args.storage {
+		return ErrUpgrade
+	}
+	a := o.args
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n, l := o.storage, a.inventory
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLocked()
+			panic(p)
+		}
+	}()
+	state := o.admitBorrowedLocked()
+	if state == runtimeBorrowedUnknown {
+		return ErrUpgrade
+	}
+	// Completed storage Close already consumed every registered own slot. The
+	// pure admission verified the exact cached successes; issue no new closes.
+	if state != runtimeBorrowedStorageClosed && closeRuntimeUpgradeOldListener(len(o.resources), func(i int) error { return n.closeOne(o.resources[i]) }) != nil {
+		o.fenceLocked()
+		return ErrUpgrade
+	}
+	o.closed = true
+	runtimeUpgradeOldListeners.Lock()
+	delete(runtimeUpgradeOldListeners.owners, o)
+	runtimeUpgradeOldListeners.Unlock()
+	return nil
+}
