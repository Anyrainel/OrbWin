+// Compile-only. Synthetic fields exercise exact private guards; no native call.
+func TestDatastoreReaperBorrowsExactSettledParentRoot(t *testing.T) {
+	c := &Created{}
+	p := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c, root: windows.Handle(17)}
+	p.self = p
+	c.datastoreGeneration = p
+	c.datastoreActive.Store(true)
+	p.capture = &datastoreGenerationCapture{owner: p}
+	if !holdDatastoreCleanup(p) {
+		t.Fatal("typed parent")
+	}
+	defer p.releaseCleanup()
+	root := p.newCleanupFrame("kine-read", 0)
+	if root == nil {
+		t.Fatal("root role")
+	}
+	root.state = runtimeStorageNativeOpenState{entered: true, returned: true, admitted: true, attached: true}
+	g := &DatastoreGeneration{issuance: datastoreCleanupReaped, issuer: p, reapName: "00000000000000000000000000000000"}
+	g.self = g
+	g.capture = &datastoreGenerationCapture{owner: g}
+	p.children = append(p.children, g)
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed child")
+	}
+	defer g.releaseCleanup()
+	g.record.Generation = g.reapName
+	f := g.newCleanupFrame("directory-delete", 0)
+	if f == nil || f.parent != &p.root || g.root != 0 || !g.frameOriginal(f) {
+		t.Fatal("directory-delete lost borrowed root")
+	}
+	if g.closeCellOriginal(&p.root, &p.rootClose) {
+		t.Fatal("child admitted borrowed parent closer")
+	}
+	p.rootClose.attempted = true
+	if g.rootCell() != nil || g.frameOriginal(f) {
+		t.Fatal("unsettled/closed original root admitted")
+	}
+}
+func TestDatastoreCaptureCancelAndDerivativeBeforeEffects(t *testing.T) {
+	c := &Created{}
+	g := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c}
+	g.self = g
+	c.datastoreGeneration = g
+	c.datastoreActive.Store(true)
+	g.capture = &datastoreGenerationCapture{owner: g}
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed admission")
+	}
+	defer g.releaseCleanup()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if f, e := g.openGenerationRoleLocked(ctx, "db-read", 0); f != nil || e == nil || len(g.frames) != 0 {
+		t.Fatal("cancelled entry allocated/effected")
+	}
+	child := &DatastoreGeneration{}
+	g.children = append(g.children, child)
+	if g.abortConstructionKnownLocked() == nil || !c.datastoreActive.Load() {
+		t.Fatal("abort released unresolved derivative")
+	}
+	if g.parents != nil {
+		t.Fatal("borrow was copied into owned ParentLease")
+	}
+}
+
+func TestDatastoreCaptureCompletedOwnerCannotReenter(t *testing.T) {
+	c := &Created{}
+	g := &DatastoreGeneration{issuance: datastoreCleanupCreated, owner: c, constructionComplete: true}
+	g.self = g
+	c.datastoreGeneration = g
+	c.datastoreActive.Store(true)
+	g.capture = &datastoreGenerationCapture{owner: g}
+	if !holdDatastoreCleanup(g) {
+		t.Fatal("typed admission")
+	}
+	defer g.releaseCleanup()
+	if f, e := g.openGenerationRoleLocked(context.Background(), "generation-create", 0); f != nil || e == nil || len(g.frames) != 0 {
+		t.Fatal("completed constructor reentered")
+	}
+}
