diff --git a/rdd/pkg/authoritypath/product_token_output_windows_test.go b/rdd/pkg/authoritypath/product_token_output_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4d3475877aa87a7623fc07484f8dad50fc5fc835
--- /dev/null
+++ b/rdd/pkg/authoritypath/product_token_output_windows_test.go
@@ -0,0 +1,144 @@
+//go:build windows
+
+package authoritypath
+
+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+// DATA-only construction of private nodes to exercise actual slot helpers.
+// No fake token is ever passed to a native API or accepted as a native owner.
+func tokenTestOwner(t *testing.T) *ProductSelectionOwner {
+	t.Helper()
+	productSelectionDomain.Lock()
+	oldFailed, oldOwners := productSelectionDomain.failed, productSelectionDomain.owners
+	productSelectionDomain.failed = false
+	productSelectionDomain.owners = make(map[*ProductSelectionOwner]bool)
+	o := &ProductSelectionOwner{}
+	o.self = o
+	productSelectionDomain.owners[o] = true
+	productSelectionDomain.Unlock()
+	t.Cleanup(func() {
+		productSelectionDomain.Lock()
+		productSelectionDomain.failed, productSelectionDomain.owners = oldFailed, oldOwners
+		productSelectionDomain.Unlock()
+	})
+	return o
+}
+func TestProductTokenSlotRegistersExactOutputBeforeCompletion(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		token            windows.Token
+		call             error
+		discard, unknown bool
+	}{
+		{"known absence", 0, windows.ERROR_NO_TOKEN, true, false},
+		{"other known error", 0, windows.ERROR_ACCESS_DENIED, true, false},
+		{"successful output", windows.Token(1), nil, false, false},
+		{"success no output", 0, nil, false, true},
+		{"error valid output", windows.Token(1), windows.ERROR_ACCESS_DENIED, false, true},
+		{"error invalid sentinel", windows.Token(windows.InvalidHandle), windows.ERROR_NO_TOKEN, false, true},
+		{"success invalid sentinel", windows.Token(windows.InvalidHandle), nil, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := tokenTestOwner(t)
+			r, e := o.tokenOutput()
+			if e != nil || r == nil || len(o.resources) != 1 || o.resources[0] != r || !r.pending {
+				t.Fatal("output not preregistered")
+			}
+			// Same memory location as &r.token in the two actual native call sites.
+			destination := &r.token
+			*destination = tc.token
+			e = o.tokenReply(r, tc.call)
+			if o.unknown != tc.unknown {
+				t.Fatal("unknown classification")
+			}
+			if tc.discard {
+				if e != tc.call || len(o.resources) != 0 || r.pending {
+					t.Fatal("known empty output not removed exactly")
+				}
+			} else {
+				if len(o.resources) != 1 || o.resources[0] != r || r.token != tc.token {
+					t.Fatal("original output lost")
+				}
+				if tc.unknown {
+					if e != ErrSelection || !r.pending || o.Close() != ErrSelection || len(o.resources) != 1 {
+						t.Fatal("unknown graph released")
+					}
+				} else if e != nil || r.pending {
+					t.Fatal("positive DATA output did not complete")
+				}
+			}
+		})
+	}
+}
+func TestProductTokenSlotActualConstructorPanicGuardRetainsWrittenAndPending(t *testing.T) {
+	for _, output := range []windows.Token{0, 1} {
+		t.Run(map[bool]string{true: "written", false: "empty pending"}[output != 0], func(t *testing.T) {
+			o := tokenTestOwner(t)
+			var out *ProductSelectionOwner
+			var result error
+			var r *productTokenResource
+			func() {
+				defer func() {
+					if recover() == nil {
+						t.Fatal("panic swallowed")
+					}
+				}()
+				defer o.captureCompletion(&out, &result)
+				var e error
+				r, e = o.tokenOutput()
+				if e != nil {
+					t.Fatal(e)
+				}
+				r.token = output
+				panic("inert output interval")
+			}()
+			if !o.unknown || !r.pending || len(o.resources) != 1 || o.resources[0] != r || r.token != output || !productSelectionDomain.owners[o] || o.Close() != ErrSelection {
+				t.Fatal("panic dropped or released original graph")
+			}
+		})
+	}
+}
+func TestProductTokenSlotRejectsCopiesReplayAndCrossOwnerCompletion(t *testing.T) {
+	t.Run("copied wrapper", func(t *testing.T) {
+		o := tokenTestOwner(t)
+		copy := &ProductSelectionOwner{self: o}
+		if r, e := copy.tokenOutput(); r != nil || e == nil {
+			t.Fatal("copy reached output")
+		}
+		if len(o.resources) != 0 || o.unknown {
+			t.Fatal("copy changed original")
+		}
+	})
+	t.Run("pending prevents another API", func(t *testing.T) {
+		o := tokenTestOwner(t)
+		r, _ := o.tokenOutput()
+		if next, e := o.tokenOutput(); next != nil || e == nil || len(o.resources) != 1 || o.resources[0] != r {
+			t.Fatal("crossed pending output")
+		}
+		if o.Close() != ErrSelection || !o.unknown || len(o.resources) != 1 {
+			t.Fatal("pending close did not retain")
+		}
+	})
+	t.Run("foreign slot", func(t *testing.T) {
+		o := tokenTestOwner(t)
+		r, _ := o.tokenOutput()
+		r.token = 1
+		if o.tokenReply(&productTokenResource{pending: true}, nil) != ErrSelection || !o.unknown || o.resources[0] != r {
+			t.Fatal("foreign slot settled original")
+		}
+	})
+	t.Run("completion replay", func(t *testing.T) {
+		o := tokenTestOwner(t)
+		r, _ := o.tokenOutput()
+		r.token = 1
+		if o.tokenReply(r, nil) != nil {
+			t.Fatal("DATA completion")
+		}
+		if o.tokenReply(r, nil) != ErrSelection || !o.unknown || o.resources[0] != r {
+			t.Fatal("replay accepted")
+		}
+	})
+}
