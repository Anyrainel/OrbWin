+// Constructor-only: the caller holds credentials -> listener -> args -> storage
+// -> inventory and OS-thread affinity. The same actual credential cap is reread;
+// its parsed endpoint is never an independently supplied port or native grant.
+func (o *nativeUpgradeOldListenerObservation) credentialPortLocked(ctx context.Context) (uint16, error) {
+	c := o.credentials
+	if !runtimeUpgradeCredentialsKnown(c) || c.closed || c.unknown || c.args != o.args || c.storage != o.storage || c.admitBorrowedLocked() != runtimeBorrowedLive {
+		return 0, ErrUpgrade
+	}
+	_, e := c.digestLocked(ctx)
+	// A failed native args recheck may itself fence storage. Propagate that
+	// exact result and clear private buffers before any own-suffix cleanup.
+	state := c.admitBorrowedLocked()
+	if e != nil || state != runtimeBorrowedLive {
+		return 0, ErrUpgrade
+	}
+	return runtimeCredentialEndpointPort(c.data.endpoint)
+}
+
+// This concrete settlement owns only this listener's suffix. Production passes
+// the fixed shared storage close sequence; inert tests supply only fake close
+// effects. Nothing is stored, exported, or selected by a request. The terminal
+// guard covers cleanup itself panicking, not just the constructor body.
+func (o *nativeUpgradeOldListenerObservation) settleCredentialCaptureLocked(out **nativeUpgradeOldListenerObservation, result *error, panicked bool, closeOwn func() error) {
+	refuse := func() {
+		o.credentials.fenceLocked()
+		o.fenceLocked()
+		*out, *result = o, ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			refuse() // original panic values may contain private credential data
+		}
+	}()
+	if panicked {
+		refuse()
+		return
+	}
+	credentialState := o.credentials.admitBorrowedLocked()
+	state := o.admitBorrowedLocked()
+	if credentialState == runtimeBorrowedUnknown || state == runtimeBorrowedUnknown {
+		refuse()
+		return
+	}
+	if *result == nil && (credentialState != runtimeBorrowedLive || state != runtimeBorrowedLive || o.credentials.closed || !runtimeUpgradeCredentialsKnown(o.credentials)) {
+		*result = ErrUpgrade
+	}
+	if *result == nil {
+		return
+	}
+	if state != runtimeBorrowedStorageClosed && (closeOwn == nil || closeOwn() != nil) {
+		refuse()
+		return
+	}
+	runtimeUpgradeOldListeners.Lock()
+	delete(runtimeUpgradeOldListeners.owners, o)
+	runtimeUpgradeOldListeners.Unlock()
+	*out = nil
+}
+
+// No socket is connected and no management request, event, SCM operation,
+// service/process mutation or PID-file read is performed by this constructor.
+func captureRuntimeUpgradeOldListener(ctx context.Context, c *nativeRuntimeUpgradeCredentials) (out *nativeUpgradeOldListenerObservation, result error) {
+	if ctx == nil || ctx.Err() != nil || !runtimeUpgradeCredentialsKnown(c) || !runtimeUpgradeOldArgsBirthKnown(c.args) || c.storage != c.args.storage {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	a := c.args
+	o := &nativeUpgradeOldListenerObservation{credentials: c, args: a, storage: a.storage}
+	o.self = o
+	runtimeUpgradeOldListeners.Lock()
+	if len(runtimeUpgradeOldListeners.owners) >= 16 {
+		runtimeUpgradeOldListeners.Unlock()
+		return nil, ErrUpgrade
+	}
+	runtimeUpgradeOldListeners.owners[o] = true
+	runtimeUpgradeOldListeners.Unlock()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	n, l := a.storage, a.inventory
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	defer func() {
+		panicked := recover() != nil
+		o.settleCredentialCaptureLocked(&out, &result, panicked, func() error {
+			return closeRuntimeUpgradeOldListener(len(o.resources), func(i int) error { return n.closeOne(o.resources[i]) })
+		})
+	}()
+	if o.admitBorrowedLocked() != runtimeBorrowedLive {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if _, e := a.digestLocked(ctx); e != nil {
+		return nil, e
+	}
+	// Requested args remain an independent closed command-line policy. Never
+	// substitute or rewrite them to match Complete's actual fallback endpoint.
+	if _, e := runtimeUpgradeOldRequestedPort(a.body); e != nil {
+		return nil, e
+	}
+	var e error
+	o.port, e = o.credentialPortLocked(ctx)
+	if e != nil {
+		return nil, e
+	}
+	pid, e := o.currentListener(ctx)
+	if e != nil || pid == windows.GetCurrentProcessId() || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	o.process = o.slot()
+	o.process.handle, e = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if o.output(o.process, e) != nil {
+		return nil, ErrUpgrade
+	}
+	var made, exit, kernel, user windows.Filetime
+	var session, callerSession uint32
+	if windows.GetProcessTimes(o.process.handle, &made, &exit, &kernel, &user) != nil || windows.ProcessIdToSessionId(pid, &session) != nil || windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &callerSession) != nil || session == 0 || session != callerSession {
+		return nil, ErrUpgrade
+	}
+	o.generation = UpgradeProcess{PID: pid, Creation: uint64(made.HighDateTime)<<32 | uint64(made.LowDateTime), Session: session}
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	o.token = o.slot()
+	e = windows.OpenProcessToken(o.process.handle, windows.TOKEN_QUERY, (*windows.Token)(&o.token.handle))
+	if o.output(o.token, e) != nil {
+		return nil, ErrUpgrade
+	}
+	o.tokenID, e = legacySDKTokenID(windows.Token(o.token.handle))
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	o.path, e = upgradeProcessPath(o.process.handle)
+	if e != nil {
+		return nil, e
+	}
+	volume, parts, e := readerComponents(o.path)
+	if e != nil || len(parts) == 0 || !strings.EqualFold(parts[len(parts)-1], "rdd.exe") {
+		return nil, ErrUpgrade
+	}
+	o.command, e = legacySDKCommandLine(o.process.handle)
+	if e != nil {
+		return nil, e
+	}
+	args, e := windows.DecomposeCommandLine(o.command)
+	if e != nil || !runtimeUpgradeOldCommandMatches(args, o.path, a.body) || o.checkProcess(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	pointer, e := windows.UTF16PtrFromString(volume)
+	if e != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	parent := o.slot()
+	parent.handle, e = windows.CreateFile(pointer, windows.FILE_TRAVERSE|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if o.output(parent, e) != nil || objectKind(parent.handle, true) != nil {
+		return nil, ErrUpgrade
+	}
+	for i, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		child, e := o.open(parent.handle, part, i < len(parts)-1)
+		if e != nil {
+			return nil, e
+		}
+		parent = child
