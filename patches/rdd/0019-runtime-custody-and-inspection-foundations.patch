+)
+
+func configureManagedRuntime(ctx context.Context, mgr *controllers.SharedControllerManager, authority privateAuthority) error {
+	if authority == nil {
+		return nil
+	}
+	w, ok := authority.(*windowsPrivateAuthority)
+	if !ok || w == nil || w.created == nil || w.publisher == nil || w.image == nil || mgr == nil {
+		return errPrivateAuthority
+	}
+	image, ok := w.image.(*managementconfig.ServingImageLease)
+	if !ok {
+		return errPrivateAuthority
+	}
+	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	a, e := image.ManagedHostagentAuthority(bounded, w.created, w.publisher)
+	w.managedAuthority = a // partial original derivative retained BEFORE status
+	if e != nil {
+		return errPrivateAuthority
+	}
+	home, e := os.UserHomeDir()
+	if e != nil || a.VerifyControllerDirectories(bounded, home, instance.LimaHome(), instance.Dir()) != nil {
+		return errPrivateAuthority
+	}
+	if mgr.SetManagedRuntimeAuthority(a) != nil {
+		return errPrivateAuthority
+	}
+	return nil
+}
