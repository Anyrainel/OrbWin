@@ -0,0 +1,43 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// Compile-only owner refusal tests. No fake native HANDLE reaches an API.
+func TestModernIncomingMissingAndCopiedOriginalRefuses(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, a := range []*ManagedRuntimeAuthority{nil, {}} {
+		if image, e := a.CaptureModernIncomingSelfImage(ctx, nil); image != nil || e == nil {
+			t.Fatal("missing authority admitted")
+		}
+	}
+	var missing *ModernIncomingImage
+	if missing.Close() == nil {
+		t.Fatal("missing image")
+	}
+	original := &ModernIncomingImage{}
+	native := &nativeModernIncomingImage{self: original}
+	original.native = native
+	copy := &ModernIncomingImage{native: native}
+	if copy.Close() == nil || copy.closedForAuthority(nil) {
+		t.Fatal("copied image")
+	}
+	n := &nativeManagedRuntimeAuthority{}
+	old := &ModernSelfProcessLease{}
+	s := &nativeModernSelfProcessLease{self: old, authority: n}
+	old.native = s
+	n.modernSelfLease = old
+	if modernIncomingSelfHeld(n, old) {
+		t.Fatal("uncaptured self")
+	}
+	copied := &ModernSelfProcessLease{native: s}
+	if modernIncomingSelfHeld(n, copied) {
+		t.Fatal("copied old self")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_self.go b/rdd/pkg/managementconfig/runtime_modern_self.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a9c7d7f9eda75bf09e12df0c3650bc028099507
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_modern_self.go
@@ -0,0 +1,144 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+var errModernSelfData = errors.New("modern self-process observation unavailable")
+
+// Private sequencing DATA, not a native lease or a mutation permission.
+type modernSelfLeaseState struct {
+	entered, pending, captured      bool
+	closeAttempted, closed, unknown bool
+}
+
+func (s *modernSelfLeaseState) begin() bool {
+	if s == nil || s.entered || s.pending || s.captured || s.closeAttempted || s.closed || s.unknown {
+		return false
+	}
+	s.entered, s.pending = true, true
+	return true
+}
+func (s *modernSelfLeaseState) fail() {
+	if s != nil {
+		s.unknown = true
+	}
+}
+func (s *modernSelfLeaseState) reply(success, valid bool) bool {
+	if s == nil || !s.entered || !s.pending || s.unknown || s.closeAttempted {
+		if s != nil {
+			s.fail()
+		}
+		return false
+	}
+	s.pending = false
+	if !success || !valid {
+		s.fail()
+		return false
+	}
+	s.captured = true
+	return true
+}
+func (s *modernSelfLeaseState) beginClose() (bool, error) {
+	if s == nil || s.unknown || s.pending || !s.captured {
+		return false, errModernSelfData
+	}
+	if s.closed {
+		return false, nil
+	}
+	if s.closeAttempted {
+		return false, errModernSelfData
+	}
+	s.closeAttempted = true
+	return true, nil
+}
+func (s *modernSelfLeaseState) finishClose(success bool) error {
+	if s == nil || s.unknown || !s.closeAttempted || s.closed || s.pending || !s.captured {
+		return errModernSelfData
+	}
+	if !success {
+		s.fail()
+		return errModernSelfData
+	}
+	s.closed = true
+	return nil
+}
+func (s *modernSelfLeaseState) closedKnown() bool {
+	return s != nil && s.entered && !s.pending && s.captured && s.closeAttempted && s.closed && !s.unknown
+}
+
+const modernSelfFrameLimit = 1024
+
+// Future inherited-role correlation DATA only. No production caller emits this
+// component yet; parsing cannot construct ModernSelfProcessLease or a receiver.
+type modernSelfProcessData struct {
+	Schema   int    `json:"schema"`
+	Role     string `json:"role"`
+	Nonce    string `json:"nonce"`
+	Process  string `json:"process"`
+	PID      uint32 `json:"pid"`
+	Creation string `json:"creation"`
+	Session  uint32 `json:"session"`
+	Image    string `json:"image"`
+	Commit   string `json:"commit"`
+}
+
+func modernSelfHex(text string, digits int, prefix bool) bool {
+	if prefix {
+		if len(text) < 2 || text[:2] != "0x" {
+			return false
+		}
+		text = text[2:]
+	}
+	if len(text) != digits {
+		return false
+	}
+	nonzero := false
+	for _, c := range text {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+		nonzero = nonzero || c != '0'
+	}
+	return nonzero
+}
+func (d modernSelfProcessData) valid() bool {
+	return d.Schema == 1 && d.Role == "old-self-process" && modernSelfHex(d.Nonce, 32, false) && modernSelfHex(d.Process, 16, true) && d.Process != "0xffffffffffffffff" && d.PID != 0 && modernSelfHex(d.Creation, 16, true) && d.Session != 0 && modernSelfHex(d.Image, 64, false) && modernSelfHex(d.Commit, 40, false)
+}
+func modernSelfDataFrame(d modernSelfProcessData) ([]byte, error) {
+	if !d.valid() {
+		return nil, errModernSelfData
+	}
+	b, e := json.Marshal(d)
+	if e != nil || len(b) == 0 || len(b) > modernSelfFrameLimit {
+		return nil, errModernSelfData
+	}
+	frame := make([]byte, 4+len(b))
+	binary.LittleEndian.PutUint32(frame, uint32(len(b)))
+	copy(frame[4:], b)
+	return frame, nil
+}
+func parseModernSelfDataFrame(frame []byte) (modernSelfProcessData, error) {
+	var d modernSelfProcessData
+	if len(frame) < 5 || len(frame) > 4+modernSelfFrameLimit || int(binary.LittleEndian.Uint32(frame)) != len(frame)-4 {
+		return d, errModernSelfData
+	}
+	decoder := json.NewDecoder(bytes.NewReader(frame[4:]))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&d) != nil {
+		return modernSelfProcessData{}, errModernSelfData
+	}
+	var extra any
+	if decoder.Decode(&extra) != io.EOF {
+		return modernSelfProcessData{}, errModernSelfData
+	}
+	canonical, e := modernSelfDataFrame(d)
+	if e != nil || !bytes.Equal(frame, canonical) {
+		return modernSelfProcessData{}, errModernSelfData
+	}
+	return d, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_self_test.go b/rdd/pkg/managementconfig/runtime_modern_self_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6d75889c7152288767b86b7a6361f266d7ea9c30
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_modern_self_test.go
@@ -0,0 +1,96 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func TestModernSelfProtocolPreservesWideWordsAndRejectsSubstitution(t *testing.T) {
+	d := modernSelfProcessData{1, "old-self-process", strings.Repeat("a", 32), "0x0020000000000001", 42, "0xfedcba9876543210", 1, strings.Repeat("b", 64), strings.Repeat("c", 40)}
+	frame, e := modernSelfDataFrame(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	got, e := parseModernSelfDataFrame(frame)
+	if e != nil || got != d {
+		t.Fatal("wide handle/time roundtrip")
+	}
+	for _, mutate := range []func(*modernSelfProcessData){func(d *modernSelfProcessData) { d.Schema = 2 }, func(d *modernSelfProcessData) { d.Role = "write-admitted" }, func(d *modernSelfProcessData) { d.Process = "0xffffffffffffffff" }, func(d *modernSelfProcessData) { d.Process = "0x0000000000000000" }, func(d *modernSelfProcessData) { d.PID = 0 }, func(d *modernSelfProcessData) { d.Session = 0 }, func(d *modernSelfProcessData) { d.Nonce = strings.Repeat("0", 32) }, func(d *modernSelfProcessData) { d.Commit = strings.Repeat("C", 40) }} {
+		bad := d
+		mutate(&bad)
+		if _, e := modernSelfDataFrame(bad); e == nil {
+			t.Fatal("unsupported role/correlation accepted")
+		}
+	}
+	body := frame[4:]
+	for _, bad := range [][]byte{bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1), bytes.Replace(body, []byte(`"schema"`), []byte(`"Schema"`), 1), bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"path":"C:\\other"`), 1), append(append([]byte(nil), body...), ' ')} {
+		f := make([]byte, 4+len(bad))
+		binary.LittleEndian.PutUint32(f, uint32(len(bad)))
+		copy(f[4:], bad)
+		if _, e := parseModernSelfDataFrame(f); e == nil {
+			t.Fatal("noncanonical/duplicate/alias accepted")
+		}
+	}
+	for _, bad := range [][]byte{nil, frame[:3], frame[:len(frame)-1], append(append([]byte(nil), frame...), 0), make([]byte, modernSelfFrameLimit+5)} {
+		if _, e := parseModernSelfDataFrame(bad); e == nil {
+			t.Fatal("framing boundary accepted")
+		}
+	}
+}
+func TestModernSelfStateRetainsUnknownAndCachesPositiveClose(t *testing.T) {
+	for _, success := range []bool{false, true} {
+		for _, valid := range []bool{false, true} {
+			s := modernSelfLeaseState{}
+			if !s.begin() || s.begin() {
+				t.Fatal("duplicate prearm")
+			}
+			if s.reply(success, valid) != (success && valid) {
+				t.Fatal("reply classification")
+			}
+			if !success || !valid {
+				if !s.unknown {
+					t.Fatal("failed entered acquisition not fenced")
+				}
+				if run, _ := s.beginClose(); run {
+					t.Fatal("unknown close")
+				}
+				if s.reply(true, true) {
+					t.Fatal("late completion reused")
+				}
+				continue
+			}
+			run, e := s.beginClose()
+			if e != nil || !run || !s.closeAttempted {
+				t.Fatal("close not prearmed")
+			}
+			if s.finishClose(true) != nil || !s.closedKnown() {
+				t.Fatal("known close")
+			}
+			run, e = s.beginClose()
+			if run || e != nil {
+				t.Fatal("positive replay not cached")
+			}
+		}
+	}
+	s := modernSelfLeaseState{}
+	s.begin()
+	if run, _ := s.beginClose(); run {
+		t.Fatal("pending close")
+	}
+	s.fail()
+	if s.reply(true, true) {
+		t.Fatal("panic fence cleared")
+	}
+	s = modernSelfLeaseState{}
+	s.begin()
+	s.reply(true, true)
+	s.beginClose()
+	if s.finishClose(false) == nil || !s.unknown {
+		t.Fatal("failed close")
+	}
+	if run, _ := s.beginClose(); run {
+		t.Fatal("failed close replay")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_modern_self_windows.go b/rdd/pkg/managementconfig/runtime_modern_self_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a3129303b0262cabb3658b74a6482802eb50e3f5
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_modern_self_windows.go
@@ -0,0 +1,165 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"runtime"
+
+	"golang.org/x/sys/windows"
+)
+
+// An opaque derivative of the actual serving authority. It is not whole-service
+// retirement, committed-head proof, an incoming permit or an inherited receiver.
+// There is deliberately no HANDLE getter, launch or transfer method.
+type ModernSelfProcessLease struct{ native *nativeModernSelfProcessLease }
+type nativeModernSelfProcessLease struct {
+	self      *ModernSelfProcessLease
+	authority *nativeManagedRuntimeAuthority
+	process   windows.Handle
+	state     modernSelfLeaseState
+	complete  bool
+	query     struct {
+		pid, session, wait          uint32
+		created, exit, kernel, user windows.Filetime
+	}
+}
+
+func (*ModernSelfProcessLease) String() string   { return "original service self-process lease" }
+func (*ModernSelfProcessLease) GoString() string { return "original service self-process lease" }
+func (s *nativeModernSelfProcessLease) fence()   { s.state.fail(); s.authority.fence() }
+
+// Same publication -> Created -> managed authority locks, with no lock held
+// across a foreign callback. The only process source is CurrentProcess itself.
+// A partial derivative is retained by original n BEFORE every new native output.
+func (a *ManagedRuntimeAuthority) PrepareModernSelfProcessLease(ctx context.Context) (out *ModernSelfProcessLease, result error) {
+	n, e := a.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	var retained *nativeModernSelfProcessLease
+	defer func() {
+		if recover() != nil {
+			if retained != nil {
+				retained.state.fail()
+			}
+			n.fence()
+			result = ErrUpgrade
+		}
+		runtime.KeepAlive(out)
+	}()
+	if !n.admitted() || !n.controllersStarted || n.modernSelfLease != nil || !n.main.captured || n.main.process != windows.CurrentProcess() {
+		return nil, ErrUpgrade
+	}
+	if n.main.same() != nil {
+		n.fence()
+		return nil, ErrUpgrade
+	}
+	if !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	lease := &ModernSelfProcessLease{}
+	s := &nativeModernSelfProcessLease{self: lease, authority: n}
+	lease.native = s
+	n.modernSelfLease = lease
+	out = lease
+	retained = s
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !s.state.begin() {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	e = windows.DuplicateHandle(windows.CurrentProcess(), windows.CurrentProcess(), windows.CurrentProcess(), &s.process, windows.SYNCHRONIZE|windows.PROCESS_QUERY_LIMITED_INFORMATION, false, 0)
+	if !s.state.reply(e == nil, s.process != 0 && s.process != windows.InvalidHandle) {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	s.query.pid, e = windows.GetProcessId(s.process)
+	if e != nil || s.query.pid != windows.GetCurrentProcessId() || s.query.pid != n.publisher.serving.PID {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	if windows.GetProcessTimes(s.process, &s.query.created, &s.query.exit, &s.query.kernel, &s.query.user) != nil || uint64(s.query.created.HighDateTime)<<32|uint64(s.query.created.LowDateTime) != n.main.creation {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	if windows.ProcessIdToSessionId(s.query.pid, &s.query.session) != nil || s.query.session == 0 || s.query.session != n.publisher.serving.Session {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	s.query.wait, e = windows.WaitForSingleObject(s.process, 0)
+	if e != nil || s.query.wait != uint32(windows.WAIT_TIMEOUT) || n.main.same() != nil {
+		s.fence()
+		return lease, ErrUpgrade
+	}
+	s.complete = true
+	if ctx.Err() != nil {
+		return lease, ErrUpgrade
+	} // known complete output still requires explicit checked Close
+	return lease, nil
+}
+
+// Called only while the original authority mutex is held; cached facts only.
+func (l *ModernSelfProcessLease) closedForAuthority(a *nativeManagedRuntimeAuthority) bool {
+	if l == nil || l.native == nil || a == nil {
+		return false
+	}
+	s := l.native
+	return s.self == l && s.authority == a && a.modernSelfLease == l && s.complete && s.process == 0 && s.state.closedKnown()
+}
+func (l *ModernSelfProcessLease) Close() (result error) {
+	if l == nil || l.native == nil {
+		return ErrUpgrade
+	}
+	s := l.native
+	n := s.authority
+	if s.self != l || n == nil || n.publisher == nil || n.created == nil {
+		return ErrUpgrade
+	}
+	n.publisher.mu.Lock()
+	defer n.publisher.mu.Unlock()
+	n.created.mu.Lock()
+	defer n.created.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.modernSelfLease != l {
+		return ErrUpgrade
+	}
+	if n.modernIncomingImage != nil && !n.modernIncomingImage.closedForAuthority(n) {
+		return ErrUpgrade
+	}
+	if l.closedForAuthority(n) {
+		return nil
+	}
+	if !n.admitted() || !s.complete || s.state.unknown || s.process == 0 || s.process == windows.InvalidHandle {
+		return ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			s.fence()
+			result = ErrUpgrade
+		}
+	}()
+	run, e := s.state.beginClose()
+	if e != nil || !run {
+		return ErrUpgrade
+	}
+	if windows.CloseHandle(s.process) != nil {
+		s.state.finishClose(false)
+		s.fence()
+		return ErrUpgrade
+	}
+	s.process = 0
+	if s.state.finishClose(true) != nil {
+		s.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
