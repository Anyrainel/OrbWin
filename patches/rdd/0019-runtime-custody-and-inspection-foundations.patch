+		return unknown
+	}
+	for _, name := range []string{"apiserver.crt", "apiserver.key", "sa.key"} {
+		v, e := s.o.open(ctx, tls, name, false, true, false, 0)
+		if e != nil || v.legacy.size == 0 || v.legacy.size > 65536 {
+			return inspectionUnknown("tuple-cut-unsupported")
