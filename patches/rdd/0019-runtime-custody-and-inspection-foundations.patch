+//go:build windows
+
+package managementconfig
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Inert net.Conn methods only: no listener, Dial, native handle or provider.
+type freshTransportFake struct {
+	mu                  sync.Mutex
+	started, wake       chan struct{}
+	startOnce, wakeOnce sync.Once
+	blockWrite          bool
+	closes, deadlines   int
+	lastDeadline        time.Time
+	closeErr            error
+	closePanic          bool
+}
+
+func newFreshTransportFake() *freshTransportFake {
+	return &freshTransportFake{started: make(chan struct{}), wake: make(chan struct{})}
+}
+func (c *freshTransportFake) Read([]byte) (int, error) {
+	c.startOnce.Do(func() { close(c.started) })
+	<-c.wake
+	return 0, io.EOF
+}
+func (c *freshTransportFake) Write(b []byte) (int, error) {
+	if c.blockWrite {
+		c.startOnce.Do(func() { close(c.started) })
+		<-c.wake
+		return 0, ErrUpgrade
+	}
+	return len(b), nil
+}
+func (c *freshTransportFake) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.closes++
+	if c.closePanic {
+		panic("inert private close panic")
+	}
+	return c.closeErr
+}
+func (c *freshTransportFake) LocalAddr() net.Addr  { return &net.TCPAddr{} }
+func (c *freshTransportFake) RemoteAddr() net.Addr { return &net.TCPAddr{} }
+func (c *freshTransportFake) SetDeadline(t time.Time) error {
+	c.mu.Lock()
+	c.deadlines++
+	c.lastDeadline = t
+	c.mu.Unlock()
+	if !t.After(time.Now()) {
+		c.wakeOnce.Do(func() { close(c.wake) })
+	}
+	return nil
+}
+func (c *freshTransportFake) SetReadDeadline(t time.Time) error  { return c.SetDeadline(t) }
+func (c *freshTransportFake) SetWriteDeadline(t time.Time) error { return c.SetDeadline(t) }
+func freshTransportAwait(t *testing.T, c <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-c:
+	case <-time.After(2 * time.Second):
+		t.Fatal("owned inert I/O did not join")
+	}
+}
+
+func freshTransportOwnerFixture(t *testing.T) (*FreshRuntimeObservation, [][]byte) {
+	t.Helper()
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n, image: &ServingImageLease{}}
+	o.self = o
+	w := &FreshRuntimeObservation{owner: o, created: &Created{}, credentials: runtimeUpgradeCredentialData{admin: []byte("private admin"), user: []byte("private user"), ca: []byte("private ca")}}
+	w.self = w
+	o.observation = w
+	aliases := [][]byte{w.credentials.admin, w.credentials.user, w.credentials.ca}
+	runtimeStorageDomain.Lock()
+	old := runtimeStorageDomain.failed
+	runtimeStorageDomain.failed = false
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+	t.Cleanup(func() {
+		runtimeStorageDomain.Lock()
+		delete(runtimeStorageDomain.owners, n)
+		runtimeStorageDomain.failed = old
+		runtimeStorageDomain.Unlock()
+	})
+	return w, aliases
+}
+func freshTransportAssertCleared(t *testing.T, buffers [][]byte) {
+	t.Helper()
+	for _, b := range buffers {
+		for _, v := range b {
+			if v != 0 {
+				t.Fatal("owned secret bytes retained after terminal unknown")
+			}
+		}
+	}
+}
+
+func TestRuntimeFreshTransportEveryFailedDialRetainsAndClears(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		w, aliases := freshTransportOwnerFixture(t)
+		raw := newFreshTransportFake()
+		c := &freshObservationConnection{}
+		w.connections = append(w.connections, c)
+		var returned net.Conn
+		if partial {
+			returned = raw
+		}
+		if w.retainTransportDialLocked(c, returned, errors.New("inert dial failure")) != ErrUpgrade || c.conn != returned || !w.unknown || !w.owner.unknown {
+			t.Fatal("failed Dial became known no-output cleanup")
+		}
+		if w.settleTransportLocked(c, false) != ErrUpgrade || c.attempted || raw.closes != 0 {
+			t.Fatal("uncertain Dial output was closed or released")
+		}
+		freshTransportAssertCleared(t, aliases)
+	}
+}
+
+func TestRuntimeFreshTransportBorrowedStorageFencePrecedesRawClose(t *testing.T) {
+	w, aliases := freshTransportOwnerFixture(t)
+	raw := newFreshTransportFake()
+	c := &freshObservationConnection{conn: raw}
+	w.connections = append(w.connections, c)
+	// The actual closeTemporary error path calls this concrete storage fence.
+	n := w.owner.storage
+	n.mu.Lock()
+	n.fence()
+	n.mu.Unlock()
+	if w.settleTransportLocked(c, false) != ErrUpgrade || !w.unknown || c.attempted || raw.closes != 0 {
+		t.Fatal("borrowed native unknown allowed own connection Close")
+	}
+	freshTransportAssertCleared(t, aliases)
+}
+
+func TestRuntimeFreshTransportCancellationWakesDirectHTTPIOBeforeRawClose(t *testing.T) {
+	for _, write := range []bool{false, true} {
+		w, _ := freshTransportOwnerFixture(t)
+		raw := newFreshTransportFake()
+		raw.blockWrite = write
+		c := &freshObservationConnection{conn: raw}
+		w.connections = append(w.connections, c)
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		if c.prepareIO(ctx) != nil {
+			t.Fatal("inert connection preparation")
+		}
+		request, _ := http.NewRequestWithContext(ctx, http.MethodGet, "http://127.0.0.1/info", nil)
+		done := make(chan struct{})
+		var ioErr error
+		go func() {
+			defer close(done)
+			if write {
+				ioErr = request.Write(c.guard)
+			} else {
+				_, ioErr = http.ReadResponse(bufio.NewReader(c.guard), request)
+			}
+		}()
+		freshTransportAwait(t, raw.started)
+		cancel()
+		freshTransportAwait(t, done)
+		if ioErr == nil {
+			t.Fatal("canceled direct HTTP I/O succeeded")
+		}
+		if w.settleTransportUsing(c, false, func() error {
+			if c.stop != nil {
+				t.Fatal("cancel watcher not joined before raw Close")
+			}
+			c.guard.mu.Lock()
+			joined := c.guard.sealed && c.guard.active == 0
+			c.guard.mu.Unlock()
+			if !joined {
+				t.Fatal("I/O not joined before raw Close")
+			}
+			return raw.Close()
+		}) != nil || w.settleTransportLocked(c, false) != nil || raw.closes != 1 {
+			t.Fatal("joined raw connection was not closed exactly once")
+		}
+	}
+}
+
+func TestRuntimeFreshTransportTLSCannotCloseRawOrExtendCancellationDeadline(t *testing.T) {
+	raw := newFreshTransportFake()
+	guard := newFreshObservationAbortConn(raw, time.Now().Add(time.Minute))
+	now := time.Now()
+	if guard.SetDeadline(now) != nil || guard.SetWriteDeadline(time.Now().Add(time.Hour)) != nil {
+		t.Fatal("deadline clamp refused")
+	}
+	raw.mu.Lock()
+	last := raw.lastDeadline
+	raw.mu.Unlock()
+	if last.After(now) {
+		t.Fatal("later TLS activity extended cancellation deadline")
+	}
+	if guard.Close() != ErrUpgrade || raw.closes != 0 || guard.SetDeadline(time.Time{}) != ErrUpgrade || guard.SetWriteDeadline(time.Now().Add(time.Hour)) != ErrUpgrade {
+		t.Fatal("logical TLS Close released/revived raw socket")
+	}
+	c := &freshObservationConnection{conn: raw, guard: guard}
+	if c.join() {
+		t.Fatal("logical abort reported usable I/O")
+	}
+	if c.closeRawUsing(raw.Close) != nil || c.closeRawUsing(raw.Close) != nil || raw.closes != 1 {
+		t.Fatal("actor did not own sole raw close")
+	}
+}
+
+func TestRuntimeFreshTransportRawCloseErrorPanicAndRequestPanicAreTerminal(t *testing.T) {
+	for _, fault := range []string{"error", "panic", "request panic"} {
+		w, aliases := freshTransportOwnerFixture(t)
+		raw := newFreshTransportFake()
+		raw.closeErr = ErrUpgrade
+		raw.closePanic = fault == "panic"
+		c := &freshObservationConnection{conn: raw}
+		w.connections = append(w.connections, c)
+		if w.settleTransportLocked(c, fault == "request panic") != ErrUpgrade || !w.unknown {
+			t.Fatal("terminal close/request panic became positive")
+		}
+		expected := 1
+		if fault == "request panic" {
+			expected = 0
+		}
+		if w.settleTransportLocked(c, false) != ErrUpgrade || raw.closes != expected {
+			t.Fatal("unknown raw close was retried")
+		}
+		freshTransportAssertCleared(t, aliases)
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_tuple_recovery_windows.go b/rdd/pkg/managementconfig/runtime_fresh_tuple_recovery_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..cc87a17edb272720dbf1ec7bd4006b2197bab888
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_tuple_recovery_windows.go
@@ -0,0 +1,241 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+)
+
+// Actual pre-datastore tuple producer capture, distinct from initialized and
+// retained-control provenance. It never treats partial defaults as initialized.
+type nativeFreshTupleRecovery struct {
+	self                                      *nativeFreshTupleRecovery
+	recovery                                  *nativeFreshRecoveryOwner
+	root, tls, db, lock, args, initialization *runtimeStorageObject
+	argsBody, initializationBody              []byte
+	binding                                   runtimeFreshTupleBinding
+	complete                                  bool
+}
+
+// Caller holds original owner/n/thread. Probe has DELETE/shareDELETE; this
+// converts it through checked close/reopen into an actual serving READ lease.
+func (r *nativeFreshRecoveryOwner) captureTupleRecoveryLocked(ctx context.Context, probe *runtimeStorageObject) (found bool, failure error) {
+	if r == nil || r.owner == nil || r.owner.storage == nil {
+		return false, ErrUpgrade
+	}
+	o := r.owner
+	n := o.storage
+	if !r.admitted(n) || r.tupleRecovery != nil || r.admission != nil || r.stage != nil || r.target != nil || probe == nil || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.checkLayoutLocked(ctx) != nil || r.guestPreflight.checkLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	names, e := upgradeStoreNames(probe.resource.handle)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	allowed := map[string]bool{"tls": true, "db": true, "args.json": true, "authority.init": true, "authority.owner.lock": true}
+	present := map[string]bool{}
+	tuplePresent := false
+	for ordinal := uint32(0); ordinal < runtimeFreshTupleSlots; ordinal++ {
+		name, _ := runtimeFreshTupleFileName(ordinal)
+		allowed[name] = true
+	}
+	for _, name := range names {
+		if !allowed[name] || present[name] {
+			return false, nil
+		}
+		present[name] = true
+		if len(name) > 21 && name[:21] == "authority.fresh.keys." {
+			tuplePresent = true
+		}
+	}
+	if !tuplePresent {
+		return false, nil
+	}
+	for _, name := range []string{"tls", "db", "args.json", "authority.init", "authority.owner.lock"} {
+		if !present[name] {
+			return false, ErrUpgrade
+		}
+	}
+	h := &nativeFreshTupleRecovery{recovery: r}
+	h.self = h
+	r.tupleRecovery = h
+	start := len(n.resources)
+	var owned []byte
+	defer func() {
+		clear(owned)
+		if recover() != nil {
+			o.unknown = true
+			n.fence()
+			found = false
+			failure = ErrUpgrade
+			return
+		}
+		if !found && failure == nil {
+			if n.unknown || o.unknown || !runtimeStorageDomainKnown() {
+				failure = ErrUpgrade
+				return
+			}
+			for len(n.resources) > start {
+				if n.closeTemporary(n.resources[len(n.resources)-1]) != nil {
+					failure = ErrUpgrade
+					return
+				}
+			}
+			r.tupleRecovery = nil
+		}
+	}()
+	h.tls, e = n.openFreshExistingTracked(ctx, probe.resource.handle, "tls", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	h.db, e = n.openFreshExistingTracked(ctx, probe.resource.handle, "db", true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	database, e := upgradeStoreNames(h.db.resource.handle)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	if len(database) != 0 {
+		return false, nil
+	}
+	leaves, e := upgradeStoreNames(h.tls.resource.handle)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	tlsAllowed := map[string]bool{"apiserver.crt": true, "apiserver.key": true, "sa.key": true}
+	for _, role := range []runtimeFreshFixedRole{runtimeFreshRoleCert, runtimeFreshRoleKey, runtimeFreshRoleAccount} {
+		for ordinal := uint32(0); ordinal < runtimeFreshRoleSlots; ordinal++ {
+			name, _ := runtimeFreshRoleArchiveName(role, ordinal)
+			tlsAllowed[name] = true
+		}
+	}
+	for _, name := range leaves {
+		if !tlsAllowed[name] {
+			return false, ErrUpgrade
+		}
+	}
+	h.lock, e = n.openFreshExistingTracked(ctx, probe.resource.handle, "authority.owner.lock", false, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, 0, true, false)
+	if e != nil || h.lock.identity.size != 0 {
+		return false, ErrUpgrade
+	}
+	h.args, e = n.openFreshExistingTracked(ctx, probe.resource.handle, "args.json", false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	h.argsBody, e = n.read(h.args, false)
+	if e != nil || parseFreshRuntimeSavedArguments(h.argsBody) != nil {
+		return false, ErrUpgrade
+	}
+	h.initialization, e = n.openFreshExistingTracked(ctx, probe.resource.handle, "authority.init", false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return false, ErrUpgrade
+	}
+	h.initializationBody, e = n.read(h.initialization, false)
+	if e != nil || validateInitialization(h.initializationBody, h.argsBody) != nil {
+		return false, ErrUpgrade
+	}
+	intent, e := n.read(o.fenceObject, false)
+	if e != nil || r.denial == nil || r.denial.checkLocked(ctx) != nil {
+		return false, ErrUpgrade
+	}
+	h.binding = runtimeFreshTupleBinding{Schema: 1, Transaction: o.intent.Transaction, Intent: runtimeStorageFileData(o.fenceObject, intent), Denial: runtimeStorageFileData(r.denial.receipt, r.denial.body), Controller: runtimeStorageObjectData(n.controller), Authority: runtimeStorageObjectData(probe), TLS: runtimeStorageObjectData(h.tls), ControllerDescriptor: n.controller.identity.descriptor, AuthorityDescriptor: probe.identity.descriptor, TLSDescriptor: h.tls.identity.descriptor}
+	complete, gap := false, false
+	for ordinal := uint32(0); ordinal < runtimeFreshTupleSlots; ordinal++ {
+		name, _ := runtimeFreshTupleFileName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, probe.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap || complete {
+			return false, ErrUpgrade
+		}
+		body, e := freshFixedRoleBodyLocked(ctx, n, object)
+		if e != nil {
+			return false, ErrUpgrade
+		}
+		owned = body
+		binding := h.binding
+		binding.Ordinal = ordinal
+		material, e := parseRuntimeFreshAuthorityTuple(body, binding)
+		if e == nil {
+			complete = true
+			material.clear()
+		} else if !runtimeFreshTupleIncomplete(body, binding) {
+			clear(body)
+			return false, ErrUpgrade
+		}
+		clear(body)
+		owned = nil
+	}
+	if !complete && len(leaves) != 0 {
+		return false, ErrUpgrade
+	}
+	expected := probe.identity
+	if n.unknown || o.unknown || !runtimeStorageDomainKnown() || n.closeTemporary(probe.resource) != nil {
+		return false, ErrUpgrade
+	}
+	h.root, e = n.openFreshExistingTracked(ctx, n.ancestry[len(n.ancestry)-1].resource.handle, anchorName, true, windows.FILE_LIST_DIRECTORY|windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, true, false)
+	if e != nil || h.root.identity != expected || !freshBoundedContext(ctx) {
+		return false, ErrUpgrade
+	}
+	h.complete = true
+	return true, nil
+}
+
+func (o *FreshSetupOwner) openTupleRecoveryAuthority(ctx context.Context, args []byte) (result *Created, failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n := o.storage
+	if n == nil || n.freshRecovery == nil || o.created != nil || o.closed || o.unknown {
+		return nil, ErrUpgrade
+	}
+	r := n.freshRecovery
+	h := r.tupleRecovery
+	if r.owner != o || !r.admitted(n) || !r.complete || h == nil || h.self != h || h.recovery != r || !h.complete || !bytes.Equal(args, h.argsBody) {
+		return nil, ErrUpgrade
+	}
+	defer func() {
+		if recover() != nil {
+			o.unknown = true
+			n.mu.Lock()
+			n.fence()
+			n.mu.Unlock()
+			result = nil
+			failure = ErrUpgrade
+		}
+	}()
+	if o.origin == nil || o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		return nil, ErrUpgrade
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || r.checkLayoutLocked(ctx) != nil || r.guestPreflight == nil || r.guestPreflight.shape != runtimeFreshGuestAbsent || r.guestPreflight.checkLocked(ctx) != nil || n.checkObject(h.root) != nil || n.checkObject(h.lock) != nil || n.checkObject(h.args) != nil || n.checkObject(h.initialization) != nil {
+		return nil, ErrUpgrade
+	}
+	body, e := n.read(h.args, false)
+	if e != nil || !bytes.Equal(body, h.argsBody) {
+		return nil, ErrUpgrade
+	}
+	body, e = n.read(h.initialization, false)
+	if e != nil || !bytes.Equal(body, h.initializationBody) {
+		return nil, ErrUpgrade
+	}
+	c, e := o.duplicateCapturedAuthorityNativeLocked(ctx, h.root, h.lock)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	if o.bindFreshAuthorityTupleStateLocked(ctx, c) != nil || !freshBoundedContext(ctx) {
+		return nil, ErrUpgrade
+	}
+	return c, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_tuple_slots_windows.go b/rdd/pkg/managementconfig/runtime_fresh_tuple_slots_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..65a766cac354e7286aaa1da806af621aaba3d7f6
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_tuple_slots_windows.go
@@ -0,0 +1,83 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Original concrete state only. Preserve failed immutable files; only one
+// complete tuple authorizes leaves. Otherwise native absence of all leaves,
+// DB data and guest permits the NEXT bounded unserved tuple, never overwrite.
+func (s *nativeFreshAuthorityTupleState) selectTupleLocked(ctx context.Context, generated *runtimeFreshTupleMaterial) (*runtimeStorageObject, error) {
+	if s == nil || !s.knownLocked(ctx) {
+		return nil, ErrPublication
+	}
+	n := s.owner.storage
+	var chosen *runtimeStorageObject
+	var ordinalChosen uint32
+	var failed [][]byte
+	defer func() {
+		for _, body := range failed {
+			clear(body)
+		}
+	}()
+	gap := false
+	next := uint32(runtimeFreshTupleSlots)
+	for ordinal := uint32(0); ordinal < runtimeFreshTupleSlots; ordinal++ {
+		name, _ := runtimeFreshTupleFileName(ordinal)
+		object, e := n.openFreshExistingTracked(ctx, s.root.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			if next == runtimeFreshTupleSlots {
+				next = ordinal
+			}
+			gap = true
+			continue
+		}
+		if e != nil || gap || chosen != nil {
+			return nil, ErrPublication
+		}
+		body, e := freshFixedRoleBodyLocked(ctx, n, object)
+		if e != nil {
+			return nil, ErrPublication
+		}
+		expected := s.binding
+		expected.Ordinal = ordinal
+		material, e := parseRuntimeFreshAuthorityTuple(body, expected)
+		if e == nil {
+			material.clear()
+			clear(body)
+			chosen, ordinalChosen = object, ordinal
+			continue
+		}
+		if !runtimeFreshTupleIncomplete(body, expected) {
+			clear(body)
+			return nil, ErrPublication
+		}
+		failed = append(failed, body)
+	}
+	if chosen != nil {
+		s.binding.Ordinal = ordinalChosen
+		return chosen, nil
+	}
+	names, e := upgradeStoreNames(s.tls.resource.handle)
+	if e != nil || len(names) != 0 {
+		return nil, ErrPublication
+	}
+	database, e := upgradeStoreNames(s.db.resource.handle)
+	if e != nil || len(database) != 0 || next >= runtimeFreshTupleSlots || !freshBoundedContext(ctx) {
+		return nil, ErrPublication
+	}
+	s.binding.Ordinal = next
+	if generated == nil {
+		return nil, ErrDefaultsAbsent
+	}
+	body, e := encodeRuntimeFreshAuthorityTuple(s.binding, generated.cert, generated.key, generated.account)
+	if e != nil {
+		return nil, ErrPublication
+	}
+	defer clear(body)
+	name, _ := runtimeFreshTupleFileName(next)
+	return s.writeImmutableLocked(ctx, s.root, name, body)
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_volume_open.go b/rdd/pkg/managementconfig/runtime_fresh_volume_open.go
