index 0000000000000000000000000000000000000000..442d4d72068ecb2f167ae588f9d7d7db83bd183a
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_publication_test.go
@@ -0,0 +1,37 @@
+package managementconfig
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRuntimeFreshControlNamespaceCannotHideRetainedGraph(t *testing.T) {
+	tx := strings.Repeat("a", 32)
+	retained, _ := runtimeFreshControlRetainedName(tx)
+	record, _ := runtimeFreshControlRecordName(0)
+	birth, _ := runtimeFreshControlBirthName(0)
+	if !runtimeFreshControlNamespaceNamesValid([]string{"authority.fresh", "control"}, tx, false) {
+		t.Fatal("ordinary namespace refused")
+	}
+	if !runtimeFreshControlNamespaceNamesValid([]string{retained, record, birth}, tx, true) {
+		t.Fatal("fixed C namespace refused")
+	}
+	for _, name := range []string{retained, record, birth, "authority.fresh.control.0016", "authority.fresh.control-unrecognized", "authority.retained." + strings.Repeat("b", 32), strings.ToUpper(record)} {
+		if runtimeFreshControlNamespaceNamesValid([]string{name}, tx, false) {
+			t.Fatalf("C namespace bypassed ordinary admission: %s", name)
+		}
+		if name != retained && name != record && name != birth && runtimeFreshControlNamespaceNamesValid([]string{name}, tx, true) {
+			t.Fatalf("unknown C entry admitted: %s", name)
+		}
+	}
+	if runtimeFreshControlNamespaceNamesValid([]string{record, record}, tx, true) || runtimeFreshControlNamespaceNamesValid([]string{record, strings.ToUpper(record)}, tx, true) || runtimeFreshControlNamespaceNamesValid(nil, "../foreign", true) {
+		t.Fatal("duplicate/foreign namespace accepted")
+	}
+	for ordinal := uint32(0); ordinal < runtimeFreshControlSlots; ordinal++ {
+		r, _ := runtimeFreshControlRecordName(ordinal)
+		b, _ := runtimeFreshControlBirthName(ordinal)
+		if !runtimeFreshControlNamespaceNamesValid([]string{r, b}, tx, true) {
+			t.Fatal("bounded original slots refused")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_control_publication_windows.go b/rdd/pkg/managementconfig/runtime_fresh_control_publication_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..48add8e7da17d7eeede16858b4d8bbe7055e5c0f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_control_publication_windows.go
@@ -0,0 +1,42 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+// Caller owns original owner -> storage and OS thread. Actual retained source
+// objects and durable birth, never admission field presence, establish C.
+// checkHeld invokes this before stage effects and again before commit/seal.
+func (p *nativeFreshRuntimePublisher) controlWitnessesNativeLocked(ctx context.Context) (runtimePublicationFileWitness, runtimePublicationFileWitness, error) {
+	zero := runtimePublicationFileWitness{}
+	if p == nil || p.owner == nil || p.owner.storage == nil || p.owner.created == nil {
+		return zero, zero, ErrUpgrade
+	}
+	o, n := p.owner, p.owner.storage
+	r := n.freshRecovery
+	if r == nil || r.controlRetention == nil {
+		if r != nil && r.admission != nil && r.admission.ControlRetention != zero {
+			return zero, zero, ErrUpgrade
+		}
+		if n.controlNamespaceLocked(ctx, o.intent.Transaction, false) != nil {
+			return zero, zero, ErrUpgrade
+		}
+		return zero, zero, nil
+	}
+	s := r.controlRetention
+	if n.controlNamespaceLocked(ctx, o.intent.Transaction, true) != nil {
+		return zero, zero, ErrUpgrade
+	}
+	if !r.admitted(n) || s.self != s || s.recovery != r || s.retainedObject == nil || s.newRoot == nil || s.newCreated != o.created || s.checkBirthForRootLocked(ctx, s.newRoot) != nil {
+		return zero, zero, ErrUpgrade
+	}
+	actual, e := runtimeStorageIdentityOf(o.created.anchor, n.sid, true, true, false)
+	if e != nil || actual != s.newRoot.identity {
+		return zero, zero, ErrUpgrade
+	}
+	retention, birth := runtimeStorageFileData(s.recordObject, s.recordBody), runtimeStorageFileData(s.birthObject, s.birthBody)
+	if r.admission != nil && (r.admission.ControlRetention != retention || r.admission.ControlBirth != birth) {
+		return zero, zero, ErrUpgrade
+	}
+	return retention, birth, nil
+}
