+			}
+			return ErrUpgrade
+		}
+		id, e := runtimeStorageIdentityOf(r.handle, n.sid, true, false, true)
+		if e != nil {
+			return ErrUpgrade
+		}
+		object := &runtimeStorageObject{resource: r, identity: id, directory: true, traversal: true}
+		w.directories = append(w.directories, object)
+		parent = r.handle
+	}
