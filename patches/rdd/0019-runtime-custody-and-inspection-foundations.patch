+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func inspectionFrame(body string) []byte {
+	b := make([]byte, 4)
+	binary.LittleEndian.PutUint32(b, uint32(len(body)))
+	return append(b, body...)
+}
+
+func TestInspectionRequestClosedBeforeNativeEntry(t *testing.T) {
+	good := inspectionFrame(runtimeInspectionRequest)
+	if readRuntimeInspectionRequest(bytes.NewReader(good)) != nil {
+		t.Fatal("closed request refused")
+	}
+	for _, bad := range [][]byte{nil, good[:3], good[:len(good)-1], append(append([]byte{}, good...), 0), append(append([]byte{}, good...), good...), inspectionFrame(`{"schema":2,"operation":"setup"}`), inspectionFrame(`{"schema":2,"operation":"inspect","path":"C:\\other"}`), inspectionFrame(`{"schema":2,"schema":2,"operation":"inspect"}`), inspectionFrame(strings.Repeat("x", 129))} {
+		if readRuntimeInspectionRequest(bytes.NewReader(bad)) == nil {
+			t.Fatal("noncanonical/trailing/mutating request accepted", string(bad))
+		}
+	}
+}
+
+func TestInspectionResultKeepsUncertaintyAndDisabledRoutes(t *testing.T) {
+	for _, test := range []struct{ phase, reason, runtime, image string }{
+		{"fresh", "initial-absence-observed", "absent", "unknown"},
+		{"interrupted", "initialized-uncommitted", "uncommitted", "same"},
+		{"interrupted", "renamed-not-committed", "uncommitted", "same"},
+		{"committed", "committed-receipt", "committed", "same"},
+		{"unsupported-version", "different-image", "committed", "different"},
+		{"conflict", "namespace-conflict", "unknown", "unknown"},
+		{"busy", "owner-busy", "unknown", "unknown"},
+		{"unknown", "observation-changed", "unknown", "unknown"},
+	} {
+		r := inspectionUnknown(test.reason)
+		r.Phase, r.Runtime, r.Image, r.Reason = test.phase, test.runtime, test.image, test.reason
+		body, err := runtimeInspectionBytes(r)
+		if err != nil {
+			t.Fatal(test, err)
+		}
+		t.Logf("wire=%s", bytes.TrimSuffix(body, []byte{'\n'}))
+		got, err := parseRuntimeInspectionResult(body)
+		if err != nil || got.Phase != test.phase || got.Runtime != test.runtime {
+			t.Fatal("observation changed", test, got, err)
+		}
+		for _, action := range got.Actions {
+			if action.State != "unsupported" {
+				t.Fatal("DATA enabled unqualified route")
+			}
+		}
+	}
+}
+
+func TestInspectionUnknownNeverPromotesAReasonIntoAbsence(t *testing.T) {
+	for _, reason := range []string{"initial-absence-observed", "committed-receipt", "owner-busy", "arbitrary", "malformed-record", "proof-scope"} {
+		r := inspectionUnknown(reason)
+		if !r.valid() || r.Phase != "unknown" || r.Runtime != "unknown" || r.Image != "unknown" {
+			t.Fatal("unknown factory produced invalid or stronger state", reason, r)
+		}
+	}
+}
+
+func TestInspectionDecoderRefusesContradictionsAndAliases(t *testing.T) {
+	base := inspectionUnknown("observation-unknown")
+	body, _ := runtimeInspectionBytes(base)
+	for _, bad := range [][]byte{append(append([]byte{}, body...), body...), bytes.Replace(body, []byte(`"schema":2`), []byte(`"schema":2,"schema":2`), 1), bytes.Replace(body, []byte(`"schema":2`), []byte(`"Schema":1`), 1), bytes.Replace(body, []byte(`"phase":"unknown"`), []byte(`"phase":"fresh"`), 1), bytes.Replace(body, []byte(`"not-checked"`), []byte(`"online"`), 1), bytes.Replace(body, []byte(`"unsupported"`), []byte(`"available"`), 1), append([]byte{' '}, body...), []byte(strings.Repeat("x", runtimeInspectionResultLimit+1))} {
+		if _, err := parseRuntimeInspectionResult(bad); err == nil {
+			t.Fatal("invalid classification accepted", string(bad[:min(len(bad), 180)]))
+		}
+	}
+	for _, mutate := range []func(*runtimeInspectionResult){
+		func(r *runtimeInspectionResult) { r.Actions[0], r.Actions[1] = r.Actions[1], r.Actions[0] },
+		func(r *runtimeInspectionResult) { r.Actions[1] = r.Actions[0] },
+		func(r *runtimeInspectionResult) { r.Scope = "historical-debug-proof" },
+		func(r *runtimeInspectionResult) { r.Clients = "ready" },
+		func(r *runtimeInspectionResult) {
+			r.Phase, r.Runtime, r.Image, r.Reason = "committed", "uncommitted", "same", "committed-receipt"
+		},
+	} {
+		r := inspectionUnknown("observation-unknown")
+		mutate(&r)
+		if _, err := runtimeInspectionBytes(r); err == nil {
+			t.Fatal("contradictory/duplicate action classification accepted", r)
+		}
+	}
+}
+
+func TestInspectionSchema2RequiresBoundedEvidence(t *testing.T) {
+	if readRuntimeInspectionRequest(bytes.NewReader(inspectionFrame(`{"schema":1,"operation":"inspect"}`))) == nil {
+		t.Fatal("schema1 request")
+	}
+	body, _ := runtimeInspectionBytes(inspectionUnknown("observation-unknown"))
+	for _, bad := range [][]byte{
+		bytes.Replace(body, []byte(`"schema":2`), []byte(`"schema":1`), 1),
+		bytes.Replace(body, []byte(`"schema":2`), []byte(`"schema":3`), 1),
+		bytes.Replace(body, []byte(`"evidence":"bounded-observation",`), nil, 1),
+		bytes.Replace(body, []byte(`"evidence":"bounded-observation"`), []byte(`"Evidence":"bounded-observation"`), 1),
+		bytes.Replace(body, []byte(`"evidence":"bounded-observation"`), []byte(`"evidence":"bounded-observation","evidence":"bounded-observation"`), 1),
+	} {
+		if _, e := parseRuntimeInspectionResult(bad); e == nil {
+			t.Fatal("invalid schema/evidence accepted", string(bad))
+		}
+	}
+	for _, evidence := range []string{"", "atomic-snapshot", "readiness", "mutation-authority", "unique-key"} {
+		r := inspectionUnknown("observation-unknown")
+		r.Evidence = evidence
+		if _, e := runtimeInspectionBytes(r); e == nil {
+			t.Fatal("stronger/missing evidence", evidence)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_registry_observation.go b/rdd/pkg/managementconfig/runtime_inspection_registry_observation.go
new file mode 100644
index 0000000000000000000000000000000000000000..dfd5debbdbc47da8939680b9df7e7f983e1cc069
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_registry_observation.go
@@ -0,0 +1,84 @@
+package managementconfig
+
+// Notification state is bounded observation DATA, never a native key identity
+// or permit. An unsignaled event cannot prove an atomic registry snapshot.
+const inspectionRegistryWatchLimit = 7                    // user root + five descendants + one GUID child
+const inspectionRegistryNotifyFilter = uint32(0x1000000f) // thread agnostic + name/attributes/value/security
+
+type inspectionRegistryWatchState struct {
+	createPending, created, armPending, armed bool
+	waitPending, changed, keyClosed, retired  bool
+	closeAttempted, closed                    bool
+}
+
+func (s *inspectionRegistryWatchState) createdReply(valid bool) error {
+	if s == nil || !s.createPending || s.created || !valid {
+		return errRuntimeInspection
+	}
+	s.createPending = false
+	s.created = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) beginArm() error {
+	if s == nil || !s.created || s.createPending || s.armPending || s.armed || s.keyClosed || s.closeAttempted {
+		return errRuntimeInspection
+	}
+	s.armPending = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) armReply(status uint32) error {
+	if s == nil || !s.armPending || s.armed || status != 0 {
+		return errRuntimeInspection
+	}
+	s.armPending = false
+	s.armed = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) beginWait() error {
+	if s == nil || !s.armed || s.armPending || s.waitPending || s.retired || s.closeAttempted {
+		return errRuntimeInspection
+	}
+	s.waitPending = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) waitReply(status uint32) error {
+	if s == nil || !s.waitPending {
+		return errRuntimeInspection
+	}
+	// WAIT_OBJECT_0 and WAIT_TIMEOUT are the only interpretable outcomes.
+	if status != 0 && status != 258 {
+		return errRuntimeInspection
+	}
+	s.waitPending = false
+	if s.keyClosed {
+		// Do not assume key close synchronously delivers its documented signal.
+		if status != 0 {
+			return errRuntimeInspection
+		}
+		s.retired = true
+	} else if status == 0 {
+		s.changed = true
+	}
+	return nil
+}
+func (s *inspectionRegistryWatchState) positiveKeyClose() error {
+	if s == nil || !s.armed || s.armPending || s.waitPending || s.keyClosed || s.closeAttempted {
+		return errRuntimeInspection
+	}
+	s.keyClosed = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) beginEventClose() error {
+	if s == nil || !s.keyClosed || !s.retired || s.waitPending || s.closeAttempted {
+		return errRuntimeInspection
+	}
+	s.closeAttempted = true
+	return nil
+}
+func (s *inspectionRegistryWatchState) eventCloseReply(known bool) error {
+	if s == nil || !s.closeAttempted || s.closed || !known {
+		return errRuntimeInspection
+	}
+	s.closed = true
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_registry_observation_test.go b/rdd/pkg/managementconfig/runtime_inspection_registry_observation_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..de62728b9f9a7a7b73193a2c114b305ffadd66f8
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_registry_observation_test.go
@@ -0,0 +1,117 @@
+package managementconfig
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func inspectionTestArmedWatch(t *testing.T) inspectionRegistryWatchState {
+	t.Helper()
+	s := inspectionRegistryWatchState{createPending: true}
+	if s.createdReply(true) != nil || s.beginArm() != nil || s.armReply(0) != nil {
+		t.Fatal("arm")
+	}
+	return s
+}
+func TestInspectionRegistryWatchOneShotAndCloseOrder(t *testing.T) {
+	s := inspectionTestArmedWatch(t)
+	if s.beginEventClose() == nil || s.beginArm() == nil {
+		t.Fatal("early close/rearm")
+	}
+	if s.beginWait() != nil || s.waitReply(258) != nil || s.changed {
+		t.Fatal("timeout observation")
+	}
+	if s.beginWait() != nil || s.waitReply(0) != nil || !s.changed {
+		t.Fatal("signal lost")
+	}
+	if s.beginWait() != nil || s.waitReply(258) != nil || !s.changed {
+		t.Fatal("signal reset")
+	}
+	if s.positiveKeyClose() != nil || s.beginEventClose() == nil {
+		t.Fatal("key close alone is not retirement")
+	}
+	if s.beginWait() != nil || s.waitReply(0) != nil || !s.retired || !s.changed {
+		t.Fatal("retirement erased change")
+	}
+	if s.beginEventClose() != nil || s.beginEventClose() == nil || s.eventCloseReply(true) != nil || !s.closed || s.eventCloseReply(true) == nil {
+		t.Fatal("event once")
+	}
+}
+func TestInspectionRegistryWatchUnknownsKeepOriginalState(t *testing.T) {
+	s := inspectionRegistryWatchState{createPending: true}
+	if s.createdReply(false) == nil || !s.createPending || s.beginArm() == nil {
+		t.Fatal("unknown create")
+	}
+	s = inspectionRegistryWatchState{createPending: true}
+	if s.createdReply(true) != nil || s.beginArm() != nil {
+		t.Fatal("setup")
+	}
+	if s.armReply(997) == nil || !s.armPending || s.positiveKeyClose() == nil || s.beginEventClose() == nil {
+		t.Fatal("unknown registration")
+	}
+	s = inspectionTestArmedWatch(t)
+	if s.beginWait() != nil || s.waitReply(0xffffffff) == nil || !s.waitPending || s.positiveKeyClose() == nil || s.beginEventClose() == nil {
+		t.Fatal("unknown wait")
+	}
+	s = inspectionTestArmedWatch(t)
+	if s.positiveKeyClose() != nil || s.beginWait() != nil || s.waitReply(258) == nil || s.retired || s.beginEventClose() == nil {
+		t.Fatal("guessed synchronous close signal")
+	}
+	s = inspectionTestArmedWatch(t)
+	if s.positiveKeyClose() != nil || s.beginWait() != nil || s.waitReply(0) != nil || s.beginEventClose() != nil {
+		t.Fatal("close setup")
+	}
+	if s.eventCloseReply(false) == nil || !s.closeAttempted || s.closed || s.beginEventClose() == nil {
+		t.Fatal("unknown close retry")
+	}
+	if inspectionRegistryWatchLimit != 7 || inspectionRegistryNotifyFilter != 0x1000000f {
+		t.Fatal("finite profile drift")
+	}
+}
+func inspectionTestRegistrySD(t *testing.T, mask *uint32) ([]byte, []byte) {
+	t.Helper()
+	raw, user := inspectionTestSD(t, false, mask)
+	off := int(binary.LittleEndian.Uint32(raw[16:])) + 8
+	for i := 0; i < 3; i++ {
+		binary.LittleEndian.PutUint32(raw[off+4:], 0xf003f)
+		off += int(binary.LittleEndian.Uint16(raw[off+2:]))
+	}
+	return raw, user
+}
+func TestInspectionRegistrySecurityUsesKeyRightsAndClosedTrust(t *testing.T) {
+	for _, mask := range []uint32{0x20019, 0x10, 1, 8, 0x80000000} {
+		raw, user := inspectionTestRegistrySD(t, &mask)
+		if _, e := inspectionRegistrySecurity(raw, user); e != nil {
+			t.Fatal("registry read incorrectly treated as file write", mask)
+		}
+	}
+	for _, mask := range []uint32{2, 4, 0x20, 0x10000, 0x40000, 0x80000, 0x40000000, 0x10000000} {
+		raw, user := inspectionTestRegistrySD(t, &mask)
+		if _, e := inspectionRegistrySecurity(raw, user); e == nil {
+			t.Fatal("foreign registry mutation accepted", mask)
+		}
+	}
+	raw, user := inspectionTestRegistrySD(t, nil)
+	if h, e := inspectionRegistrySecurity(raw, user); e != nil || h == [32]byte{} {
+		t.Fatal("selected user")
+	}
+	for i := 0; i < len(raw); i++ {
+		if _, e := inspectionRegistrySecurity(raw[:i], user); e == nil {
+			t.Fatal("truncated SD", i)
+		}
+	}
+	// File policy's TrustedInstaller exemption is intentionally not inherited.
+	ti, _ := inspectionParseSID("S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464")
+	bad := append([]byte(nil), raw...)
+	off := len(bad)
+	bad = append(bad, ti...)
+	binary.LittleEndian.PutUint32(bad[4:], uint32(off))
+	if _, e := inspectionRegistrySecurity(bad, user); e == nil {
+		t.Fatal("unapproved owner exemption")
+	}
+	bad = append([]byte(nil), raw...)
+	binary.LittleEndian.PutUint32(bad[16:], 0)
+	if _, e := inspectionRegistrySecurity(bad, user); e == nil {
+		t.Fatal("null DACL")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_registry_observation_windows.go b/rdd/pkg/managementconfig/runtime_inspection_registry_observation_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..cd6ac3d70bc2fdb96986b7496528c2d881e6a5d3
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_registry_observation_windows.go
@@ -0,0 +1,157 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"unsafe"
+)
+
+var inspectionRegistryDLL = windows.NewLazySystemDLL("advapi32.dll")
+var inspectionOpenCurrentUser = inspectionRegistryDLL.NewProc("RegOpenCurrentUser")
+var inspectionNotifyKey = inspectionRegistryDLL.NewProc("RegNotifyChangeKeyValue")
+var inspectionGetKeySecurity = inspectionRegistryDLL.NewProc("RegGetKeySecurity")
+var inspectionCloseWatchEvent = windows.NewLazySystemDLL("kernel32.dll").NewProc("CloseHandle")
+var inspectionCreateWatchEvent = windows.NewLazySystemDLL("kernel32.dll").NewProc("CreateEventW")
+
+type inspectionRegistryWatch struct {
+	owner                       *inspectionNativeOwner
+	key                         *inspectionNativeKey
+	state                       inspectionRegistryWatchState
+	handle                      windows.Handle
+	createRaw, armRaw, closeRaw uintptr
+	createError                 error
+	waitRaw                     uint32
+}
+type inspectionRegistrySecurityFrame struct {
+	words  []uint64
+	needed uint32
+	status uintptr
+}
+
+func (o *inspectionNativeOwner) ownsRegistryWatch(w *inspectionRegistryWatch) bool {
+	if o == nil || o.self != o || w == nil || w.owner != o || w.key == nil || w.key.watch != w {
+		return false
+	}
+	for _, key := range o.keys {
+		if key == w.key && key.owner == o && key.slot != nil && key.slot.owner == o {
+			return true
+		}
+	}
+	return false
+}
+func (o *inspectionNativeOwner) armRegistryWatch(ctx context.Context, key *inspectionNativeKey) error {
+	if !o.known(ctx) || !o.ownsKey(key) || key.watch != nil || len(o.keys) > inspectionRegistryWatchLimit {
+		return errRuntimeInspection
+	}
+	w := &inspectionRegistryWatch{owner: o, key: key, state: inspectionRegistryWatchState{createPending: true}}
+	key.watch = w // Original create-output and state storage before native entry.
+	w.createRaw, _, w.createError = inspectionCreateWatchEvent.Call(0, 1, 0, 0)
+	w.handle = windows.Handle(w.createRaw)
+	if w.state.createdReply(w.handle != 0 && w.handle != windows.InvalidHandle) != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) || w.state.beginArm() != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	w.armRaw, _, _ = inspectionNotifyKey.Call(uintptr(key.slot.handle), 0, uintptr(inspectionRegistryNotifyFilter), uintptr(w.handle), 1)
+	if w.state.armReply(uint32(w.armRaw)) != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	return o.pollRegistryWatches()
+}
+func (o *inspectionNativeOwner) pollRegistryWatch(w *inspectionRegistryWatch) error {
+	if !o.ownsRegistryWatch(w) || w.handle == 0 || w.handle == windows.InvalidHandle || w.state.beginWait() != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	var e error
+	w.waitRaw, e = windows.WaitForSingleObject(w.handle, 0)
+	if e != nil || w.state.waitReply(w.waitRaw) != nil {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if w.state.changed {
+		o.registryChanged = true
+	}
+	return nil
+}
+func (o *inspectionNativeOwner) pollRegistryWatches() error {
+	if o == nil || o.self != o || o.unknown {
+		return errRuntimeInspection
+	}
+	for _, key := range o.keys {
+		if key.watch == nil || o.pollRegistryWatch(key.watch) != nil {
+			return errRuntimeInspection
+		}
+	}
+	if o.registryChanged {
+		return errRuntimeInspection
+	}
+	return nil
+}
+
+// Called only after the original RegCloseKey has positively returned, with
+// original key/watch still attached. No guessed cancellation, reset or retry.
+func (o *inspectionNativeOwner) closeRegistryWatch(slot *inspectionNativeSlot) error {
+	for _, key := range o.keys {
+		if key.slot != slot {
+			continue
+		}
+		w := key.watch
+		if w == nil {
+			return nil
+		} // No notification entered before this key's failure.
+		if !o.ownsRegistryWatch(w) || slot.handle != 0 || !slot.state.attempted || slot.state.err != nil || w.state.positiveKeyClose() != nil {
+			o.fence()
+			return errRuntimeInspection
+		}
+		if o.pollRegistryWatch(w) != nil || w.state.beginEventClose() != nil {
+			o.fence()
+			return errRuntimeInspection
+		}
+		w.closeRaw, _, _ = inspectionCloseWatchEvent.Call(uintptr(w.handle))
+		if !inspectionWinBOOL(w.closeRaw) {
+			o.fence()
+			return errRuntimeInspection
+		}
+		if w.state.eventCloseReply(true) != nil {
+			o.fence()
+			return errRuntimeInspection
+		}
+		w.handle = 0
+		return nil
+	}
+	return nil
+}
+func (o *inspectionNativeOwner) registrySecurity(ctx context.Context, key *inspectionNativeKey) ([32]byte, error) {
+	var zero [32]byte
+	if !o.known(ctx) || !o.ownsKey(key) {
+		return zero, errRuntimeInspection
+	}
+	f := &inspectionRegistrySecurityFrame{}
+	o.registrySecurityFrame = f // Size and descriptor output retain original custody.
+	f.status, _, _ = inspectionGetKeySecurity.Call(uintptr(key.slot.handle), 7, 0, uintptr(unsafe.Pointer(&f.needed)))
+	if inspectionProbeSize(false, uint32(f.status), f.needed) != nil {
+		return zero, errRuntimeInspection
+	}
+	capacity := f.needed
+	f.words = make([]uint64, (capacity+7)/8)
+	if !o.known(ctx) {
+		return zero, errRuntimeInspection
+	}
+	f.status, _, _ = inspectionGetKeySecurity.Call(uintptr(key.slot.handle), 7, uintptr(unsafe.Pointer(&f.words[0])), uintptr(unsafe.Pointer(&f.needed)))
+	if inspectionFetchSize(uint32(f.status) == 0, f.needed, capacity) != nil {
+		return zero, errRuntimeInspection
+	}
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), int(f.needed))
+	value, e := inspectionRegistrySecurity(raw, o.user)
+	if e == nil {
+		o.registrySecurityFrame = nil
+	}
+	return value, e
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_registry_security.go b/rdd/pkg/managementconfig/runtime_inspection_registry_security.go
new file mode 100644
index 0000000000000000000000000000000000000000..998ec5c920ed671d4ea4e67ce070aefd383122b9
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_registry_security.go
@@ -0,0 +1,53 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+)
+
+// Current-user hive and descendants only. No file/traversal rights, no
+// TrustedInstaller exemption, no mutable private-product-key role is inferred.
+func inspectionRegistrySecurity(raw, user []byte) ([32]byte, error) {
+	var zero [32]byte
+	if !inspectionValidExactSID(user) || len(raw) < 20 || len(raw) > inspectionSecurityLimit || raw[0] != 1 || raw[1] != 0 {
+		return zero, errRuntimeInspection
+	}
+	control := binary.LittleEndian.Uint16(raw[2:4])
+	if control&0x8004 != 0x8004 || control&0x10 != 0 || binary.LittleEndian.Uint32(raw[12:16]) != 0 {
+		return zero, errRuntimeInspection
+	}
+	var regions []inspectionSdRegion
+	owner, e := inspectionDescriptorSID(raw, binary.LittleEndian.Uint32(raw[4:8]), false, &regions)
+	if e != nil {
+		return zero, errRuntimeInspection
+	}
+	if _, e = inspectionDescriptorSID(raw, binary.LittleEndian.Uint32(raw[8:12]), true, &regions); e != nil {
+		return zero, errRuntimeInspection
+	}
+	aces, e := inspectionDescriptorACL(raw, binary.LittleEndian.Uint32(raw[16:20]), &regions)
+	if e != nil {
+		return zero, errRuntimeInspection
+	}
+	trusted := func(sid []byte) bool {
+		return bytes.Equal(sid, user) || inspectionSidParts(sid, 5, 18) || inspectionSidParts(sid, 5, 32, 544)
+	}
+	if !trusted(owner) {
+		return zero, errRuntimeInspection
+	}
+	// Standard mutation + KEY_SET_VALUE/CREATE_SUB_KEY/CREATE_LINK + generic writes.
+	const mutation = uint32(0x10000 | 0x40000 | 0x80000 | 2 | 4 | 0x20 | 0x40000000 | 0x10000000)
+	for _, ace := range aces {
+		// Registry keys do not support SYNCHRONIZE; refuse unknown rights.
+		if ace.mask&^uint32(0xf00f003f) != 0 {
+			return zero, errRuntimeInspection
+		}
+		if ace.kind == 1 || ace.flags&8 != 0 {
+			continue
+		}
+		if !trusted(ace.sid) && ace.mask&mutation != 0 {
+			return zero, errRuntimeInspection
+		}
+	}
+	return sha256.Sum256(raw), nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_registry_windows.go b/rdd/pkg/managementconfig/runtime_inspection_registry_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..1a2bdd7869cfc722c9ded4ecada6b5f623450763
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_registry_windows.go
@@ -0,0 +1,261 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/binary"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type inspectionNativeKey struct {
+	owner          *inspectionNativeOwner
+	slot           *inspectionNativeSlot
+	parent         *inspectionNativeKey
+	name, expected string
+	watch          *inspectionRegistryWatch
+	security       [32]byte
+	securityKnown  bool
+	openRaw        uintptr
+}
+type inspectionMissingKey struct {
+	parent *inspectionNativeKey
+	name   string
+}
+type inspectionRegistryFrame struct {
+	words               [512]uint64
+	raw                 [512]byte
+	name                [64]uint16
+	needed, kind, count uint32
+}
+
+var inspectionQueryKey = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryKey")
+
+func (o *inspectionNativeOwner) ownsKey(key *inspectionNativeKey) bool {
+	if key == nil || key.owner != o || key.slot == nil || key.slot.owner != o || !key.slot.key || key.slot.state.pending || key.slot.state.attempted {
+		return false
+	}
+	for _, original := range o.keys {
+		if original == key {
+			return true
+		}
+	}
+	return false
+}
+func (o *inspectionNativeOwner) openKey(ctx context.Context, parent *inspectionNativeKey, name string) (*inspectionNativeKey, error) {
+	if !o.known(ctx) || o.pollRegistryWatches() != nil || strings.ContainsAny(name, `\/`) {
+		return nil, errRuntimeInspection
+	}
+	if name == "" || parent != nil && !o.ownsKey(parent) || parent == nil && (o.selected == nil || name != o.selected.Owner()) {
+		return nil, errRuntimeInspection
+	}
+	text, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return nil, errRuntimeInspection
+	}
+	base := windows.Handle(0)
+	expected := `\REGISTRY\USER\` + name
+	if parent != nil {
+		base = parent.slot.handle
+		expected = parent.expected + `\` + name
+	}
+	r, e := o.newSlot(ctx, true)
+	if e != nil {
+		return nil, e
+	}
+	// OPEN_LINK opens the source key itself; never follow an unreviewed link.
+	if parent == nil {
+		// Actual thread-token root; selected SID is a required name match, not
+		// caller authority or an independently reopened HKU parent edge.
+		r.registryStatus, _, _ = inspectionOpenCurrentUser.Call(windows.KEY_READ, uintptr(unsafe.Pointer(&r.handle)))
+		if uint32(r.registryStatus) != 0 {
+			e = windows.Errno(uint32(r.registryStatus))
+		}
+	} else {
+		e = windows.RegOpenKeyEx(base, text, 8, windows.KEY_READ, &r.handle)
+	}
+	if e = o.reply(r, e); e != nil {
+		return nil, e
+	}
+	key := &inspectionNativeKey{owner: o, slot: r, parent: parent, name: name, expected: expected, openRaw: r.registryStatus}
+	o.keys = append(o.keys, key)
+	if o.armRegistryWatch(ctx, key) != nil || o.checkKey(ctx, key) != nil {
+		return nil, errRuntimeInspection
+	}
+	return key, nil
+}
+func (o *inspectionNativeOwner) checkKey(ctx context.Context, key *inspectionNativeKey) error {
+	if !o.known(ctx) || !o.ownsKey(key) || o.pollRegistryWatches() != nil {
+		return errRuntimeInspection
+	}
+	f := &inspectionRegistryFrame{}
+	o.registryFrame = f
+	status, _, _ := inspectionQueryKey.Call(uintptr(key.slot.handle), 3, uintptr(unsafe.Pointer(&f.words[0])), unsafe.Sizeof(f.words), uintptr(unsafe.Pointer(&f.needed)))
+	if !inspectionNTSuccess(status) || f.needed < 6 || f.needed > uint32(unsafe.Sizeof(f.words)) {
+		return errRuntimeInspection
+	}
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), int(f.needed))
+	n := binary.LittleEndian.Uint32(raw)
+	if n == 0 || n%2 != 0 || n+4 != f.needed {
+		return errRuntimeInspection
+	}
+	name, e := inspectionRegistryString(append(append([]byte(nil), raw[4:]...), 0, 0))
+	if e != nil || !strings.EqualFold(name, key.expected) {
+		return errRuntimeInspection
+	}
+	if !o.known(ctx) {
+		return errRuntimeInspection
+	}
+	value, _ := windows.UTF16PtrFromString("SymbolicLinkValue")
+	f.count = uint32(len(f.raw))
+	e = windows.RegQueryValueEx(key.slot.handle, value, nil, &f.kind, &f.raw[0], &f.count)
+	if e != windows.ERROR_FILE_NOT_FOUND {
+		return errRuntimeInspection
+	}
+	valueSD, e := o.registrySecurity(ctx, key)
+	if e != nil || key.securityKnown && key.security != valueSD {
+		return errRuntimeInspection
+	}
+	key.security, key.securityKnown = valueSD, true
+	if o.pollRegistryWatches() != nil {
+		return errRuntimeInspection
+	}
+	o.registryFrame = nil
+	return nil
+}
+func (o *inspectionNativeOwner) dropKey(key *inspectionNativeKey) error {
+	if o == nil || o.self != o {
+		return errRuntimeInspection
+	}
+	if !o.ownsKey(key) || len(o.keys) == 0 || o.keys[len(o.keys)-1] != key || len(o.slots) == 0 || o.slots[len(o.slots)-1] != key.slot {
+		o.fence()
+		return errRuntimeInspection
+	}
+	if o.closeSlot(key.slot) != nil {
+		return errRuntimeInspection
+	}
+	o.keys = o.keys[:len(o.keys)-1]
+	o.slots = o.slots[:len(o.slots)-1]
+	return nil
+}
+func (o *inspectionNativeOwner) registryRows(ctx context.Context, key *inspectionNativeKey) ([]string, bool, error) {
+	if o.checkKey(ctx, key) != nil {
+		return nil, false, errRuntimeInspection
+	}
+	var rows []string
+	seen := map[string]bool{}
+	for i := uint32(0); i <= 512; i++ {
+		if !o.known(ctx) {
+			return nil, false, errRuntimeInspection
+		}
+		f := &inspectionRegistryFrame{}
+		o.registryFrame = f
+		f.count = uint32(len(f.name))
+		e := windows.RegEnumKeyEx(key.slot.handle, i, &f.name[0], &f.count, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			sorted, e := inspectionClosedNames(rows)
+			return sorted, false, e
+		}
+		if e != nil || i == 512 || f.count == 0 || f.count >= uint32(len(f.name)) {
+			return nil, false, errRuntimeInspection
+		}
+		text := make([]byte, (int(f.count)+1)*2)
+		for j, u := range f.name[:f.count] {
+			binary.LittleEndian.PutUint16(text[2*j:], u)
+		}
+		name, e := inspectionRegistryString(text)
+		if e != nil || !freshRuntimeGUID(strings.ToLower(name)) {
+			return nil, false, errRuntimeInspection
+		}
+		folded := strings.ToLower(name)
+		if seen[folded] {
+			return nil, false, errRuntimeInspection
+		}
+		seen[folded] = true
+		child, e := o.openKey(ctx, key, name)
+		if e != nil {
+			return nil, false, errRuntimeInspection
+		}
+		value, _ := windows.UTF16PtrFromString("DistributionName")
+		f = &inspectionRegistryFrame{}
+		o.registryFrame = f
+		f.count = uint32(len(f.raw))
+		if !o.known(ctx) {
+			return nil, false, errRuntimeInspection
+		}
+		e = windows.RegQueryValueEx(child.slot.handle, value, nil, &f.kind, &f.raw[0], &f.count)
+		if e != nil || f.kind != windows.REG_SZ || f.count < 2 || f.count > uint32(len(f.raw)) {
+			return nil, false, errRuntimeInspection
+		}
+		distro, e := inspectionRegistryString(f.raw[:f.count])
+		if e != nil || o.checkKey(ctx, child) != nil {
+			return nil, false, errRuntimeInspection
+		}
+		owned := runtimeFreshOwnedRegistrationName(distro)
+		if o.dropKey(child) != nil {
+			return nil, false, errRuntimeInspection
+		}
+		if owned {
+			return nil, true, nil
+		}
+		rows = append(rows, name+"="+distro)
+	}
+	return nil, false, errRuntimeInspection
+}
+func (o *inspectionNativeOwner) captureRegistry(ctx context.Context) (bool, error) {
+	key, e := o.openKey(ctx, nil, o.selected.Owner())
+	if e != nil {
+		return false, errRuntimeInspection
+	}
+	for _, name := range []string{"Software", "Microsoft", "Windows", "CurrentVersion", "Lxss"} {
+		parent := key
+		key, e = o.openKey(ctx, parent, name)
+		if e == windows.ERROR_FILE_NOT_FOUND {
+			o.keyMissing = &inspectionMissingKey{parent, name}
+			return false, nil
+		}
+		if e != nil {
+			return false, errRuntimeInspection
+		}
+	}
+	o.lxss = key
+	rows, owned, e := o.registryRows(ctx, key)
+	if e == nil {
+		o.registryNames = rows
+	}
+	return owned, e
+}
+func (o *inspectionNativeOwner) recheckRegistry(ctx context.Context) error {
+	originals := append([]*inspectionNativeKey(nil), o.keys...)
+	for _, key := range originals {
+		if o.checkKey(ctx, key) != nil {
+			return errRuntimeInspection
+		}
+		// Retain original native HKEY custody. Reopening the name and comparing
+		// kernel objects is not logical registry-key equivalence. These are
+		// bounded DATA observations under one-shot invalidation only.
+
+	}
+	if o.keyMissing != nil {
+		key, e := o.openKey(ctx, o.keyMissing.parent, o.keyMissing.name)
+		if e != windows.ERROR_FILE_NOT_FOUND {
+			_ = key
+			return errRuntimeInspection
+		}
+	}
+	if o.lxss != nil {
+		rows, owned, e := o.registryRows(ctx, o.lxss)
+		if e != nil || owned || len(rows) != len(o.registryNames) {
+			return errRuntimeInspection
+		}
+		for i, name := range rows {
+			if name != o.registryNames[i] {
+				return errRuntimeInspection
+			}
+		}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_security.go b/rdd/pkg/managementconfig/runtime_inspection_security.go
new file mode 100644
index 0000000000000000000000000000000000000000..e19a40219eb36b6bf30442c2d2b88dc15757e854
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_security.go
@@ -0,0 +1,234 @@
+// Bounded parser adapted from the separately reviewed C diagnostic security.go.
+// Bounds are reused; diagnostic destination policy is deliberately excluded.
+// Pure, bounded parsing of self-relative Windows security bytes. No native SID
+// conversion/allocation or token/descriptor API is called here. Refusal means
+// unsupported diagnostic input, not a claim that Windows rejects that layout.
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"strconv"
+	"strings"
+)
+
+func inspectionSidLength(raw []byte) (int, error) {
+	if len(raw) < 8 || raw[0] != 1 || raw[1] > 15 {
+		return 0, errors.New("unsupported SID layout")
+	}
+	n := 8 + 4*int(raw[1])
+	if n > len(raw) {
+		return 0, errors.New("truncated SID")
+	}
+	return n, nil
+}
+
+func inspectionValidExactSID(raw []byte) bool {
+	n, err := inspectionSidLength(raw)
+	return err == nil && n == len(raw)
+}
+
+func inspectionSidParts(raw []byte, authority uint64, sub ...uint32) bool {
+	if !inspectionValidExactSID(raw) || int(raw[1]) != len(sub) {
+		return false
+	}
+	var actual uint64
+	for _, value := range raw[2:8] {
+		actual = actual<<8 | uint64(value)
+	}
+	if actual != authority {
+		return false
+	}
+	for index, value := range sub {
+		if binary.LittleEndian.Uint32(raw[8+4*index:]) != value {
+			return false
+		}
+	}
+	return true
+}
+
+func inspectionTrustedSID(raw, user []byte) bool {
+	return bytes.Equal(raw, user) || inspectionSidParts(raw, 5, 18) || inspectionSidParts(raw, 5, 32, 544) || inspectionSidParts(raw, 5, 80, 956008885, 3418522649, 1831038044, 1853292631, 2271478464)
+}
+
+type inspectionSdRegion struct{ start, end int }
+type inspectionParsedACE struct {
+	kind, flags byte
+	mask        uint32
+	sid         []byte
+}
+
+// Exact SID-region sharing (owner/group) is supported. Other overlap is outside
+// this finite diagnostic's supported format, including a SID inside an ACL.
+func inspectionAddSDRegion(regions *[]inspectionSdRegion, start, end int) error {
+	for _, region := range *regions {
+		if start == region.start && end == region.end {
+			return nil
+		}
+		if start < region.end && region.start < end {
+			return errors.New("overlapping descriptor regions unsupported")
+		}
+	}
+	*regions = append(*regions, inspectionSdRegion{start, end})
+	return nil
+}
+
+func inspectionDescriptorSID(raw []byte, offset uint32, optional bool, regions *[]inspectionSdRegion) ([]byte, error) {
+	if offset == 0 && optional {
+		return nil, nil
+	}
+	if offset < 20 || offset%4 != 0 || uint64(offset)+8 > uint64(len(raw)) {
+		return nil, errors.New("descriptor SID offset refused")
+	}
+	start := int(offset)
+	n, err := inspectionSidLength(raw[start:])
+	if err != nil {
+		return nil, err
+	}
+	if err := inspectionAddSDRegion(regions, start, start+n); err != nil {
+		return nil, err
+	}
+	return raw[start : start+n], nil
+}
+
+func inspectionDescriptorACL(raw []byte, offset uint32, regions *[]inspectionSdRegion) ([]inspectionParsedACE, error) {
+	if offset < 20 || offset%4 != 0 || uint64(offset)+8 > uint64(len(raw)) {
+		return nil, errors.New("DACL offset refused")
+	}
+	start := int(offset)
+	acl := raw[start:]
+	if (acl[0] != 2 && acl[0] != 4) || acl[1] != 0 || binary.LittleEndian.Uint16(acl[6:8]) != 0 {
+		return nil, errors.New("unsupported ACL header")
+	}
+	size := int(binary.LittleEndian.Uint16(acl[2:4]))
+	count := int(binary.LittleEndian.Uint16(acl[4:6]))
+	if size < 8 || size%4 != 0 || size > len(acl) || count > 256 {
+		return nil, errors.New("ACL size/count refused")
+	}
+	if err := inspectionAddSDRegion(regions, start, start+size); err != nil {
+		return nil, err
+	}
+	acl = acl[:size]
+	aces := make([]inspectionParsedACE, 0, count)
+	pos := 8
+	for index := 0; index < count; index++ {
+		if pos+8 > len(acl) {
+			return nil, errors.New("truncated ACE")
+		}
+		kind, flags := acl[pos], acl[pos+1]
+		n := int(binary.LittleEndian.Uint16(acl[pos+2 : pos+4]))
+		if kind > 1 || flags&^byte(0x1f) != 0 || n < 16 || n%4 != 0 || n > len(acl)-pos {
+			return nil, errors.New("unsupported ACE layout")
+		}
+		principal := acl[pos+8 : pos+n]
+		if !inspectionValidExactSID(principal) {
+			return nil, errors.New("ACE SID bounds refused")
+		}
+		aces = append(aces, inspectionParsedACE{kind, flags, binary.LittleEndian.Uint32(acl[pos+4 : pos+8]), principal})
+		pos += n
+	}
+	// Free ACL bytes carry no ACE. Refuse nonzero opaque trailing material rather
+	// than treating it as a grant or interpreting an unsupported ACE format.
+	for _, value := range acl[pos:] {
+		if value != 0 {
+			return nil, errors.New("nonzero unused ACL bytes unsupported")
+		}
+	}
+	return aces, nil
+}
+
+// This parser receives only the original native selector's SID string in the
+// actual owner. Parsing these bytes alone issues no native authority.
+func inspectionParseSID(text string) ([]byte, error) {
+	parts := strings.Split(text, "-")
+	if len(parts) < 4 || len(parts) > 18 || parts[0] != "S" || parts[1] != "1" {
+		return nil, errRuntimeInspection
+	}
+	a, e := strconv.ParseUint(parts[2], 10, 48)
+	if e != nil || strconv.FormatUint(a, 10) != parts[2] {
+		return nil, errRuntimeInspection
+	}
+	b := make([]byte, 8+4*(len(parts)-3))
+	b[0], b[1] = 1, byte(len(parts)-3)
+	for i := 7; i >= 2; i-- {
+		b[i] = byte(a)
+		a >>= 8
+	}
+	for i, p := range parts[3:] {
+		v, e := strconv.ParseUint(p, 10, 32)
+		if e != nil || strconv.FormatUint(v, 10) != p {
+			return nil, errRuntimeInspection
+		}
+		binary.LittleEndian.PutUint32(b[8+i*4:], uint32(v))
+	}
+	return b, nil
+}
+
+type inspectionSecurityFacts struct {
+	descriptor [32]byte
+	protected  bool
+}
+
+// Exact existing product policy, applied only below the actual owner's native
+// buffer checks. Diagnostic selected-parent policy is not reused.
+func inspectionSecurity(raw, user []byte, directory, private, traversal bool) (inspectionSecurityFacts, error) {
+	var out inspectionSecurityFacts
+	if !inspectionValidExactSID(user) || len(raw) < 20 || len(raw) > 65536 || raw[0] != 1 || raw[1] != 0 || traversal && !directory {
+		return out, errRuntimeInspection
+	}
+	control := binary.LittleEndian.Uint16(raw[2:4])
+	if control&0x8004 != 0x8004 || control&0x10 != 0 || binary.LittleEndian.Uint32(raw[12:16]) != 0 {
+		return out, errRuntimeInspection
+	}
+	var regions []inspectionSdRegion
+	owner, e := inspectionDescriptorSID(raw, binary.LittleEndian.Uint32(raw[4:8]), false, &regions)
+	if e != nil {
+		return out, errRuntimeInspection
+	}
+	if _, e = inspectionDescriptorSID(raw, binary.LittleEndian.Uint32(raw[8:12]), true, &regions); e != nil {
+		return out, errRuntimeInspection
+	}
+	aces, e := inspectionDescriptorACL(raw, binary.LittleEndian.Uint32(raw[16:20]), &regions)
+	if e != nil {
+		return out, errRuntimeInspection
+	}
+	out.protected = control&0x1000 != 0
+	if private {
+		if !bytes.Equal(owner, user) || !out.protected || len(aces) != 3 {
+			return out, errRuntimeInspection
+		}
+		flags := byte(0)
+		if directory {
+			flags = 3
+		}
+		seen := map[string]bool{}
+		for _, ace := range aces {
+			key := string(ace.sid)
+			if ace.kind != 0 || ace.flags != flags || ace.mask != 0x1f01ff || seen[key] || !(bytes.Equal(ace.sid, user) || inspectionSidParts(ace.sid, 5, 18) || inspectionSidParts(ace.sid, 5, 32, 544)) {
+				return out, errRuntimeInspection
+			}
+			seen[key] = true
+		}
+	} else {
+		if !inspectionTrustedSID(owner, user) {
+			return out, errRuntimeInspection
+		}
+		const foreignWrite = uint32(0x10000 | 0x40000 | 0x80000 | 2 | 4 | 0x10 | 0x100 | 0x40 | 0x40000000 | 0x10000000)
+		mask := foreignWrite
+		if traversal {
+			mask &^= 2 | 4
+		}
+		for _, ace := range aces {
+			if ace.kind == 1 || ace.flags&8 != 0 {
+				continue
+			}
+			if !inspectionTrustedSID(ace.sid, user) && ace.mask&mask != 0 {
+				return out, errRuntimeInspection
+			}
+		}
+	}
+	out.descriptor = sha256.Sum256(raw)
+	return out, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_seeded.go b/rdd/pkg/managementconfig/runtime_inspection_seeded.go
new file mode 100644
index 0000000000000000000000000000000000000000..67b739d8917a49991e78fa4a5b585c1ed363f64c
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_seeded.go
@@ -0,0 +1,23 @@
+package managementconfig
+
+// DATA only. This accepts both canonical producer wire shapes without the old
+// schema1-only field whitelist. Actual readers separately bind native objects,
+// histories, completion, control graph and the final original-owner recheck.
+func inspectionParseFreshAdmission(body []byte, intent runtimeFreshIntent, witness runtimePublicationFileWitness, home string) (runtimeFreshAdmission, error) {
+	var a runtimeFreshAdmission
+	if !intent.valid() || !witness.valid() || parseRuntimeFreshRecord(body, &a) != nil || !a.valid() || a.Transaction != intent.Transaction || a.Intent != witness || a.Runtime.BinarySHA != intent.Image || a.Runtime.SourceCommit != intent.Commit || !a.Runtime.valid(home) || a.Seed != intent.Seed || !runtimeFreshDenialCompletionMatchesIntent(intent, a.DenialCompletion) {
+		return runtimeFreshAdmission{}, ErrUpgrade
+	}
+	return a, nil
+}
+
+func inspectionPublicationCutReason(layout runtimeFreshRecoveryLayout) string {
+	switch layout {
+	case runtimeFreshRecoveryPrepared:
+		return "prepared-not-renamed"
+	case runtimeFreshRecoveryRenamed:
+		return "renamed-not-committed"
+	default:
+		return ""
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_seeded_test.go b/rdd/pkg/managementconfig/runtime_inspection_seeded_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f32c9809194b5c063036e3bdcb700041f3d0a386
--- /dev/null
