@@ -0,0 +1,38 @@
+package managementconfig
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestInspectionCLIClosedArguments(t *testing.T) {
+	for _, c := range []struct {
+		args            []string
+		selected, valid bool
+	}{
+		{nil, false, false}, {[]string{"version"}, false, false},
+		{[]string{runtimeInspectionCLIFlag}, true, true},
+		{[]string{runtimeInspectionCLIFlag, "C:\\target"}, true, false},
+		{[]string{"--instance=other", runtimeInspectionCLIFlag}, true, false},
+		{[]string{runtimeInspectionCLIFlag, runtimeInspectionCLIFlag}, true, false},
+		{[]string{runtimeInspectionCLIFlag + "=1"}, true, false},
+		{[]string{runtimeInspectionCLIFlag + "-other"}, true, false},
+		{[]string{"service", runtimeInspectionCLIFlag, "--help"}, true, false},
+	} {
+		s, v := runtimeInspectionCLIArguments(c.args)
+		if s != c.selected || v != c.valid {
+			t.Fatal(c, s, v)
+		}
+	}
+}
+func TestInspectionCLIUnknownDomainCannotExitForAnyResult(t *testing.T) {
+	for _, e := range []error{nil, errors.New("parse/output/native failure")} {
+		if _, terminal := runtimeInspectionCLIExit(false, e); terminal {
+			t.Fatal("unknown domain permits exit")
+		}
+		code, terminal := runtimeInspectionCLIExit(true, e)
+		if !terminal || e == nil && code != 0 || e != nil && code != 2 {
+			t.Fatal(code, terminal, e)
+		}
+	}
+}
