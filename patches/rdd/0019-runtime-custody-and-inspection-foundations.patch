+package managementconfig
+
+import "encoding/hex"
+
+// DATA only; production original native owner controls all output cells.
+type datastoreCleanupOnce struct {
+	attempted, returned, complete bool
+	raw                           uintptr
+	lastError                     error
+}
+
+func (s *datastoreCleanupOnce) begin() bool {
+	if s == nil || s.attempted {
+		return false
+	}
+	s.attempted = true
+	return true
+}
+func (s *datastoreCleanupOnce) finish(positive bool) bool {
+	if s == nil || !s.attempted || s.returned {
+		return false
+	}
+	s.returned = true
+	s.complete = positive
+	return positive
+}
+func datastoreCleanupDeleteOrder() [6]int { return [6]int{1, 2, 3, 4, 5, 0} }
+
+// Only fixed canonical generation labels are candidates; unrelated entries are
+// counted/preserved by the real parent, never deletion/error authority.
+func datastoreCanonicalGenerationName(name string) bool {
+	decoded, e := hex.DecodeString(name)
+	return e == nil && len(decoded) == 16 && hex.EncodeToString(decoded) == name
+}
