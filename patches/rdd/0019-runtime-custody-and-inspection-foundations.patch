+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshServiceProjectionRequiresActualOwnerBeforeEnvironment(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	before := []string{os.Getenv("HOME"), os.Getenv("USERPROFILE"), os.Getenv("RDD_INSTANCE")}
+	for _, o := range []*FreshSetupOwner{nil, {}, {captureComplete: true}} {
+		if o != nil {
+			o.self = o
+		}
+		if o.ProjectUpstreamEnvironment(ctx) == nil {
+			t.Fatal("unregistered/incomplete owner projected environment")
+		}
+		if _, e := o.ServingImageForAuthority(ctx, &Created{}); e == nil {
+			t.Fatal("foreign Created obtained image")
+		}
+		if o.WriteServingPID(ctx, &Created{}) == nil {
+			t.Fatal("foreign Created reached PID writer")
+		}
+	}
+	after := []string{os.Getenv("HOME"), os.Getenv("USERPROFILE"), os.Getenv("RDD_INSTANCE")}
+	for i := range before {
+		if before[i] != after[i] {
+			t.Fatal("negative admission mutated process environment")
+		}
+	}
+}
+
+func TestRuntimeFreshCreatedRetirementUsesActualCachedClose(t *testing.T) {
+	o := &FreshSetupOwner{created: &Created{}}
+	if o.createdRetiredLocked() {
+		t.Fatal("live Created accepted")
+	}
+	o.created.closed = true
+	o.created.closeErr = ErrCreate
+	if o.createdRetiredLocked() {
+		t.Fatal("unknown cached close accepted")
+	}
+	o.created.closeErr = nil
+	o.created.datastoreActive.Store(true)
+	if o.createdRetiredLocked() {
+		t.Fatal("active datastore accepted")
+	}
+	o.created.datastoreActive.Store(false)
+	if !o.createdRetiredLocked() {
+		t.Fatal("actual positive cached close refused")
+	}
+}
