+func runtimeUpgradeManagementPointers(listener *nativeUpgradeOldListenerObservation, credentials *nativeRuntimeUpgradeCredentials) bool {
+	return listener != nil && listener.self == listener && credentials != nil && credentials.self == credentials && listener.credentials == credentials && runtimeUpgradeArgsBorrowedBirth(listener.args) && listener.args == credentials.args && listener.storage == credentials.storage && listener.storage == listener.args.storage
+}
+func runtimeUpgradeManagementBirth(listener *nativeUpgradeOldListenerObservation, credentials *nativeRuntimeUpgradeCredentials) bool {
+	return runtimeUpgradeManagementPointers(listener, credentials) && runtimeUpgradeOldListenerKnown(listener) && runtimeUpgradeCredentialsKnown(credentials)
+}
+func (o *nativeRuntimeUpgradeManagementObservation) fenceLocked() {
+	o.unknown = true
+	o.closeErr = ErrUpgrade
+	o.state.clear()
+	o.credentials.fenceLocked() // also clears private credential buffers
+	o.listener.fenceLocked()
+	o.storage.fence()
+}
+func (o *nativeRuntimeUpgradeManagementObservation) admitLocked() runtimeArgsBorrowedState {
+	if o.storage.management != o || !runtimeUpgradeManagementPointers(o.listener, o.credentials) || o.args != o.listener.args || o.storage != o.args.storage {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	// Independently completed lower-owner Close removes its own custody entry.
+	// Permit only its real cached positive suffix for terminal cleanup, never
+	// a new observation or another native close.
+	if !runtimeUpgradeCredentialsKnown(o.credentials) && (!o.credentials.closed || o.credentials.unknown || !runtimeArgsSlotClosed(o.credentials.resource)) {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	listenerKnown := runtimeUpgradeOldListenerKnown(o.listener)
+	if !listenerKnown {
+		if !o.listener.closed || o.listener.unknown {
+			o.fenceLocked()
+			return runtimeBorrowedUnknown
+		}
+		for _, resource := range o.listener.resources {
+			if !runtimeArgsSlotClosed(resource) {
+				o.fenceLocked()
+				return runtimeBorrowedUnknown
+			}
+		}
+	}
+	left := o.credentials.admitBorrowedLocked()
+	var right runtimeArgsBorrowedState
+	if listenerKnown {
+		right = o.listener.admitBorrowedLocked()
+	} else {
+		// Its positively closed own suffix was checked above. The listener's
+		// live-custody accessor intentionally refuses that terminal state.
+		right = o.args.borrowedStateLocked(o.listener.resources)
+	}
+	if o.unknown || left == runtimeBorrowedUnknown || right == runtimeBorrowedUnknown || left != right {
+		o.fenceLocked()
+		return runtimeBorrowedUnknown
+	}
+	if left == runtimeBorrowedLive && (o.credentials.closed || o.listener.closed) {
+		return runtimeBorrowedClosed
+	}
+	return left
+}
+
+// Immutable owner pointers are checked before taking these actual mutexes.
+// Short custody locks are never held while acquiring any owner mutex.
+func (o *nativeRuntimeUpgradeManagementObservation) lockBorrowed() func() {
+	o.credentials.mu.Lock()
+	o.listener.mu.Lock()
+	o.args.mu.Lock()
+	o.storage.mu.Lock()
+	o.args.inventory.mu.Lock()
+	return func() {
+		o.args.inventory.mu.Unlock()
+		o.storage.mu.Unlock()
+		o.args.mu.Unlock()
+		o.listener.mu.Unlock()
+		o.credentials.mu.Unlock()
+	}
+}
+
+// Called only in a live full-chain operation. Terminal cleanup deliberately
+// checks immutable owner pointers without reading already-cleared secrets.
+func runtimeUpgradeManagementActualPort(listener *nativeUpgradeOldListenerObservation, credentials *nativeRuntimeUpgradeCredentials) error {
+	if !runtimeUpgradeManagementPointers(listener, credentials) {
+		return ErrUpgrade
+	}
+	port, e := runtimeCredentialEndpointPort(credentials.data.endpoint)
+	if e != nil || port != listener.port {
+		return ErrUpgrade
