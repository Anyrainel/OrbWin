+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+)
+
+func (n *nativeRuntimeStorage) freshVolumeRoot(ctx context.Context, volume string) (*runtimeStorageResource, error) {
+	if n == nil || n.captureSelf != n || !freshBoundedContext(ctx) || n.captureKind != runtimeStorageFreshCapture || !n.captureStarted || !n.freshRouteStarted || n.captureComplete || n.closeAttempted || n.unknown || n.root == nil || n.root.selection == nil {
+		return nil, ErrUpgrade
+	}
+	expected, parts, e := readerComponents(n.local)
+	if e != nil || len(parts) == 0 || expected != volume {
+		return nil, ErrUpgrade
+	}
+	h, e := n.openWin32(runtimeStoragePublicVolume)
+	if e != nil {
+		return nil, e
+	}
+	r := n.keep(h) // Exact original shared Win32 frame/resource; no new alias.
+	if ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	return r, nil
+}
