+		var recipe runtimeFreshIntentRepair
+		var recipeObject *runtimeStorageObject
+		var recipeBody []byte
+		if h.unarchived {
+			recipe = *h.last
+			recipeObject = h.lastObject
+			recipeBody = h.lastBody
+		} else {
+			if h.next >= runtimeFreshIntentRepairSlots {
+				return ErrUpgrade
+			}
+			previous := runtimePublicationFileWitness{}
+			if h.lastObject != nil {
+				previous = runtimeStorageFileData(h.lastObject, h.lastBody)
+			}
+			recipe, e = n.freshIntentRecipeLocked(o.intent, h.next, previous, s.canonical, s.canonicalBody)
+			if e != nil {
+				return ErrUpgrade
+			}
+			recipeBody, e = runtimeFreshRecordBytes(recipe)
+			if e != nil {
+				return ErrUpgrade
+			}
+			name, _ := runtimeFreshIntentRepairName(h.next)
+			recipeObject, e = o.writeFreshRecordNativeLocked(ctx, name, recipeBody)
+			if e != nil {
+				return ErrUpgrade
+			}
