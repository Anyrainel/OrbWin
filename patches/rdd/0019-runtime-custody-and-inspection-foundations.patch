--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_storage_open_model_test.go
@@ -0,0 +1,96 @@
+package managementconfig
+
+import "testing"
+
+func TestRuntimeStorageNativeOpenStatusAndDisposition(t *testing.T) {
+	for _, d := range []uint32{1, 2, 3} {
+		for _, info := range []uintptr{0, 1, 2, 3, ^uintptr(0), uintptr(1)<<32 | 1} {
+			want := runtimeStorageNativeOpenUnknown
+			if info == 1 && (d == 1 || d == 3) || info == 2 && (d == 2 || d == 3) {
+				want = runtimeStorageNativeOpenSuccess
+			}
+			if got := runtimeStorageClassifyNativeOpen(0, 0, info, d, true, true); got != want {
+				t.Fatal(d, info, got, want)
+			}
+		}
+	}
+	for _, d := range []uint32{0, 4, 5, 0xffffffff} {
+		if runtimeStorageClassifyNativeOpen(0, 0, 1, d, true, true) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("unsupported disposition", d)
+		}
+	}
+	for _, status := range []uint32{0xc0000034, 0xc000003a, 0xc0000022, 0x80000005} {
+		if runtimeStorageClassifyNativeOpen(status, 0, 0, 1, false, false) != runtimeStorageNativeOpenFailure {
+			t.Fatal("terminal exact status", status)
+		}
+	}
+	for _, status := range []uint32{1, 0x104, 0x40000000} {
+		if runtimeStorageClassifyNativeOpen(status, 0, 0, 1, false, false) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("informational became absence", status)
+		}
+	}
+}
+func TestRuntimeStorageNativeOpenPendingAndPartialAreSticky(t *testing.T) {
+	for _, output := range []bool{false, true} {
+		for _, valid := range []bool{false, true} {
+			for _, pair := range [][2]uint32{{0x103, 0}, {0, 0x103}, {0xc0000034, 0x103}, {0x103, 0x103}} {
+				kind := runtimeStorageClassifyNativeOpen(pair[0], pair[1], 1, 1, output, valid)
+				s := runtimeStorageNativeOpenState{entered: true}
+				if kind != runtimeStorageNativeOpenUnknown || s.reply(kind) || !s.unknown || s.attach() || s.usable() || s.reply(runtimeStorageNativeOpenSuccess) {
+					t.Fatal("pending discarded or reused", pair, output, valid, s)
+				}
+			}
+		}
+	}
+	for _, tc := range []struct {
+		status, iosb  uint32
+		output, valid bool
+	}{{0xc0000022, 0, true, true}, {0xc0000022, 0, true, false}, {0, 0, false, false}, {0, 0, true, false}, {0, 0, false, true}, {0, 0xc0000022, true, true}} {
+		if runtimeStorageClassifyNativeOpen(tc.status, tc.iosb, 1, 1, tc.output, tc.valid) != runtimeStorageNativeOpenUnknown {
+			t.Fatal("partial contradiction", tc)
+		}
+	}
+}
+func TestRuntimeStorageNativeOpenAttachmentFaultCuts(t *testing.T) {
+	for _, cut := range []string{"before-return", "unknown-return", "terminal-refusal", "success-unattached", "success-attached"} {
+		s := runtimeStorageNativeOpenState{entered: true}
+		switch cut {
+		case "unknown-return":
+			s.reply(runtimeStorageNativeOpenUnknown)
+		case "terminal-refusal":
+			s.reply(runtimeStorageNativeOpenFailure)
+		case "success-unattached":
+			s.reply(runtimeStorageNativeOpenSuccess)
+		case "success-attached":
+			s.reply(runtimeStorageNativeOpenSuccess)
+			s.attach()
+		}
+		if s.usable() != (cut == "success-attached") {
+			t.Fatal("unowned output usable", cut, s)
+		}
+		if cut != "success-unattached" && s.attach() {
+			t.Fatal("invalid or duplicate attach", cut, s)
+		}
+	}
+	// Panics at every pre-attachment cut must retain the original frame and
+	// fence it. This models ordering/fault semantics, never a native resource.
+	for _, afterReturn := range []bool{false, true} {
+		original := &runtimeStorageNativeOpenState{entered: true}
+		retained := original
+		fenced := false
+		func() {
+			defer func() {
+				if recover() != nil {
+					fenced = true
+				}
+			}()
+			if afterReturn {
+				original.reply(runtimeStorageNativeOpenSuccess)
+			}
+			panic("fault")
+		}()
+		if retained != original || !fenced || original.attached || original.usable() {
+			t.Fatal("panic lost original", afterReturn)
+		}
+	}
+}
