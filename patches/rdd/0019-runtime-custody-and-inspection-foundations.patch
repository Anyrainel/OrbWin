@@ -0,0 +1,41 @@
+//go:build windows
+
+package service
+
+import (
+	"errors"
+	"testing"
+)
+
+// Pure denial/forwarding behavior only. No native process API is invoked.
+func TestWindowsServicePIDFallbackNeverKillsProduct(t *testing.T) {
+	for _, suffix := range []string{"orbwin", "OrbWin", "ORBWIN"} {
+		for _, pid := range []int{0, 1, 12345} {
+			calls := 0
+			err := windowsServicePIDFallback(suffix, pid, func(int) error {
+				calls++
+				return nil
+			})
+			if !errors.Is(err, errProductPIDFallback) || calls != 0 {
+				t.Fatal("product fallback attempted termination or implied success")
+			}
+		}
+	}
+}
+
+func TestWindowsServicePIDFallbackPreservesOtherUpstreamBehavior(t *testing.T) {
+	for _, suffix := range []string{"orbwin-proof", "rancher-desktop", "custom"} {
+		want := errors.New("legacy termination failure")
+		calls := 0
+		err := windowsServicePIDFallback(suffix, 12345, func(pid int) error {
+			calls++
+			if pid != 12345 {
+				t.Fatal("legacy target changed")
+			}
+			return want
+		})
+		if err != want || calls != 1 {
+			t.Fatal("legacy error/once-only behavior changed")
+		}
+	}
+}
