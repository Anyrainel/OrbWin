+}
+
+// Returns the already captured authenticated DATA after actual held-owner
+// rechecks; it performs no second network run or current/atomic-state claim.
+func (o *nativeRuntimeUpgradeManagementObservation) observed(ctx context.Context) (runtimeUpgradeManagementState, error) {
+	if o == nil || o.self != o || ctx == nil || ctx.Err() != nil || !runtimeUpgradeManagementBirth(o.listener, o.credentials) {
+		return runtimeUpgradeManagementState{}, ErrUpgrade
