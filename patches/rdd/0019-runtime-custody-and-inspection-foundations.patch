+package managementconfig
+
+// ManagedRuntimeNamespace is issued only from the actual original committed
+// startup or successful fresh observation, with SAME native serving authority.
+type ManagedRuntimeNamespace struct{ native any }
+
+func (*ManagedRuntimeNamespace) String() string   { return "retained native managed namespace" }
+func (*ManagedRuntimeNamespace) GoString() string { return "retained native managed namespace" }
diff --git a/rdd/pkg/managementconfig/runtime_managed_namespace_windows.go b/rdd/pkg/managementconfig/runtime_managed_namespace_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..fdb1f9ca1817eb02281ed55588a8c1e06ef49bd2
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_namespace_windows.go
@@ -0,0 +1,641 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/binary"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type nativeManagedNamespace struct {
+	self                                  *ManagedRuntimeNamespace
+	mu                                    sync.Mutex
+	created                               *Created
+	authority                             *nativeManagedRuntimeAuthority
+	sid, home, guid, name, base           string
+	resources                             []*runtimeStorageResource
+	keys                                  []*freshRegistryResource
+	directories                           []*runtimeStorageObject
+	disk, exclusive                       *runtimeStorageObject
+	root, selected                        *freshRegistryResource
+	peer                                  *ManagedHostagentBirth
+	selfToken                             *runtimeStorageResource
+	session                               uint32
+	shape                                 runtimeFreshGuestShape
+	complete, activated, retired, unknown bool
+	closeAttempt                          runtimeStorageCloseAttempt
+}
+
+func (n *nativeManagedNamespace) fence() {
+	n.unknown = true
+	if n.authority != nil && n.authority.image != nil {
+		n.authority.image.managedUnknown.Store(true)
+	}
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.Unlock()
+}
+func (n *nativeManagedNamespace) slot() *runtimeStorageResource {
+	r := &runtimeStorageResource{}
+	n.resources = append(n.resources, r)
+	return r
+}
+func (n *nativeManagedNamespace) reply(r *runtimeStorageResource, e error) error {
+	result := runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, n.fence)
+	if result != nil && !n.unknown && len(n.resources) > 0 && n.resources[len(n.resources)-1] == r {
+		// A confirmed error with no output owns no native object. Do not
+		// manufacture a Close attempt for a zero/INVALID_HANDLE_VALUE slot.
+		n.resources = n.resources[:len(n.resources)-1]
+	}
+	return result
+}
+func (n *nativeManagedNamespace) known(ctx context.Context) bool {
+	return n != nil && n.self != nil && n.self.native == n && n.created != nil && n.created.managedNamespace == n.self && !n.unknown && !n.closeAttempt.attempted && runtimeStorageDomainKnown() && freshBoundedContext(ctx)
+}
+func managedSameDisk(a, b runtimeStorageIdentity) bool {
+	a.size, b.size = 0, 0
+	a.written, b.written = windows.Filetime{}, windows.Filetime{}
+	return a == b
+}
+func (n *nativeManagedNamespace) checkObject(o *runtimeStorageObject) error {
+	if o == nil || o.resource == nil || o.resource.handle == 0 || o.resource.attempted {
+		return ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(o.resource.handle, n.sid, o.directory, o.private, o.traversal)
+	if e != nil {
+		return ErrUpgrade
+	}
+	if o == n.disk || o == n.exclusive {
+		if !managedSameDisk(id, o.identity) {
+			return ErrUpgrade
+		}
+	} else if id != o.identity {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (n *nativeManagedNamespace) duplicateObject(o *runtimeStorageObject) (*runtimeStorageObject, error) {
+	if o == nil || o.resource == nil || o.resource.handle == 0 || o.resource.attempted {
+		return nil, ErrUpgrade
+	}
+	r := n.slot()
+	e := windows.DuplicateHandle(windows.CurrentProcess(), o.resource.handle, windows.CurrentProcess(), &r.handle, 0, false, windows.DUPLICATE_SAME_ACCESS)
+	if n.reply(r, e) != nil {
+		return nil, ErrUpgrade
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, o.directory, o.private, o.traversal)
+	if e != nil || id != o.identity {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: r, identity: id, directory: o.directory, private: o.private, traversal: o.traversal}, nil
+}
+
+// All children are fixed producer roles under actual retained parent handles;
+// this never creates, repairs, deletes, renames or accepts a caller path.
+func (n *nativeManagedNamespace) openChild(ctx context.Context, parent windows.Handle, name string, directory bool, access, share uint32) (*runtimeStorageObject, error) {
+	if !n.known(ctx) {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	r := n.slot()
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&r.handle, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, share, windows.FILE_OPEN, options, 0, 0)
+	if e = n.reply(r, e); e != nil {
+		if n.unknown {
+			return nil, ErrUpgrade
+		}
+		return nil, e
+	}
+	id, e := runtimeStorageIdentityOf(r.handle, n.sid, directory, false, directory)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	return &runtimeStorageObject{resource: r, identity: id, directory: directory, traversal: directory}, nil
+}
+func (n *nativeManagedNamespace) openKey(ctx context.Context, parent windows.Handle, name string) (*freshRegistryResource, error) {
+	if !n.known(ctx) {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	r := &freshRegistryResource{}
+	n.keys = append(n.keys, r)
+	e = windows.RegOpenKeyEx(parent, text, 0, windows.KEY_READ, &r.handle)
+	e = runtimeStorageOpenReply(e, r.handle != 0 && r.handle != windows.InvalidHandle, func() {}, n.fence)
+	if e != nil {
+		if n.unknown {
+			return nil, ErrUpgrade
+		}
+		n.keys = n.keys[:len(n.keys)-1]
+		return nil, e
+	}
+	return r, nil
+}
+func (n *nativeManagedNamespace) closeKey(r *freshRegistryResource) error {
+	return r.run(func() error {
+		if windows.RegCloseKey(r.handle) != nil {
+			return ErrUpgrade
+		}
+		r.handle = 0
+		return nil
+	}, n.fence)
+}
+func (n *nativeManagedNamespace) closeFile(r *runtimeStorageResource) error {
+	return r.run(func() error {
+		if windows.CloseHandle(r.handle) != nil {
+			return ErrUpgrade
+		}
+		r.handle = 0
+		return nil
+	}, n.fence)
+}
+func (n *nativeManagedNamespace) registrationValues(key windows.Handle) (string, string, error) {
+	name, e := freshRuntimeRegistryValue(key, "DistributionName")
+	if e != nil {
+		return "", "", ErrUpgrade
+	}
+	base, e := freshRuntimeRegistryValue(key, "BasePath")
+	if e != nil {
+		return "", "", ErrUpgrade
+	}
+	var body [4]byte
+	size, kind := uint32(4), uint32(0)
+	value, _ := windows.UTF16PtrFromString("Version")
+	if windows.RegQueryValueEx(key, value, nil, &kind, &body[0], &size) != nil || kind != windows.REG_DWORD || size != 4 || !runtimeFreshGuestRegistrationMatches(name, base, n.home, binary.LittleEndian.Uint32(body[:])) {
+		return "", "", ErrUpgrade
+	}
+	return name, base, nil
+}
