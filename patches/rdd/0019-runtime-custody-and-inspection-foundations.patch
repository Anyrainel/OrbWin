@@ -0,0 +1,75 @@
+package service
+
+import (
+	"errors"
+	"testing"
+)
+
+type resultTestCloser struct {
+	calls      int
+	failure    error
+	panicValue any
+}
+
+func (c *resultTestCloser) Close() error {
+	c.calls++
+	if c.panicValue != nil {
+		panic(c.panicValue)
+	}
+	return c.failure
+}
+
+type resultTestPrimary struct{ label string }
+
+func (e *resultTestPrimary) Error() string { return e.label }
+
+func TestPrivateCloseResultPreservesPrimaryAndRejectsFalseSuccess(t *testing.T) {
+	primary := &resultTestPrimary{"primary service failure"}
+	closeFailure := errors.New("checked close unknown")
+	for _, p := range []error{nil, primary} {
+		for _, c := range []error{nil, closeFailure} {
+			owner := &resultTestCloser{failure: c}
+			got := settlePrivateAuthorityClose(owner, p)
+			if owner.calls != 1 {
+				t.Fatal("owner not closed exactly once")
+			}
+			if c == nil {
+				if got != p {
+					t.Fatal("positive close changed primary identity")
+				}
+				continue
+			}
+			if got == nil || !errors.Is(got, c) {
+				t.Fatal("close failure became success")
+			}
+			if p != nil {
+				var typed *resultTestPrimary
+				if !errors.Is(got, p) || !errors.As(got, &typed) || typed != primary {
+					t.Fatal("lost primary cause/type/identity")
+				}
+			}
+		}
+	}
+}
+func TestPrivateCloseResultNilOwnerKeepsPrimary(t *testing.T) {
+	p := errors.New("original failure")
+	if settlePrivateAuthorityClose(nil, p) != p || settlePrivateAuthorityClose(nil, nil) != nil {
+		t.Fatal("nil owner changed result")
+	}
+}
+func TestPrivateCloseResultDoesNotSwallowPanicOrRetry(t *testing.T) {
+	owner := &resultTestCloser{panicValue: "unknown native close"}
+	primary := errors.New("earlier error")
+	func() {
+		defer func() {
+			if recover() != owner.panicValue {
+				t.Fatal("close panic was lost")
+			}
+		}()
+		_ = settlePrivateAuthorityClose(owner, primary)
+		t.Fatal("panic became ordinary success")
+	}()
+	if owner.calls != 1 {
+		t.Fatal("close repeated after panic")
+	}
+}
