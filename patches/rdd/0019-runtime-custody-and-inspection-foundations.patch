@@ -0,0 +1,91 @@
+package managementconfig
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestInspectionSeededAdmissionUsesActualIntentSchema(t *testing.T) {
+	a := freshPublicationFixture()
+	intent := runtimeFreshIntent{Schema: 1, Transaction: a.Transaction, Image: a.Runtime.BinarySHA, Commit: a.Runtime.SourceCommit, PrivateParent: [3]uint32{1, 0, 60}, PublicParent: [3]uint32{2, 0, 1}}
+	actualWitness := a.Intent
+	check := func(a runtimeFreshAdmission, i runtimeFreshIntent) error {
+		b, e := runtimeFreshRecordBytes(a)
+		if e != nil {
+			return e
+		}
+		_, e = inspectionParseFreshAdmission(b, i, actualWitness, a.Runtime.Home)
+		return e
+	}
+	if check(a, intent) != nil {
+		t.Fatal("historical canonical producer refused")
+	}
+	intent.Schema = 2
+	intent.Seed = runtimeFreshSeedFact{Object: UpgradeObject{1, 0, 61}, Descriptor: [32]byte{1}, Written: 1, Binding: strings.Repeat("a", 64)}
+	a.Seed = intent.Seed
+	a.DenialCompletion = a.LegacyDenial
+	a.DenialCompletion.Object.Low = 62
+	if check(a, intent) != nil {
+		t.Fatal("seeded producer with completion refused")
+	}
+	a.ControlRetention = a.Intent
+	a.ControlRetention.Object.Low = 63
+	a.ControlBirth = a.Intent
+	a.ControlBirth.Object.Low = 64
+	if check(a, intent) != nil {
+		t.Fatal("seeded retained-control producer refused")
+	}
+	for name, change := range map[string]func(*runtimeFreshAdmission){
+		"completion missing":    func(v *runtimeFreshAdmission) { v.DenialCompletion = runtimePublicationFileWitness{} },
+		"seed stripped":         func(v *runtimeFreshAdmission) { v.Seed = runtimeFreshSeedFact{} },
+		"seed substituted":      func(v *runtimeFreshAdmission) { v.Seed.Object.Low++ },
+		"split control":         func(v *runtimeFreshAdmission) { v.ControlBirth = runtimePublicationFileWitness{} },
+		"wrong intent":          func(v *runtimeFreshAdmission) { v.Intent.Body[0]++ },
+		"different transaction": func(v *runtimeFreshAdmission) { v.Transaction = strings.Repeat("b", 32) },
+		"different image":       func(v *runtimeFreshAdmission) { v.Runtime.BinarySHA = strings.Repeat("b", 64) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			v := a
+			change(&v)
+			if check(v, intent) == nil {
+				t.Fatal("contradictory producer admitted")
+			}
+		})
+	}
+	b, _ := runtimeFreshRecordBytes(a)
+	for _, bad := range [][]byte{append(append([]byte{}, b...), '\n'), bytes.Replace(b, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1), bytes.Replace(b, []byte(`"schema":1`), []byte(`"schema":1,"ready":true`), 1)} {
+		if _, e := inspectionParseFreshAdmission(bad, intent, a.Intent, a.Runtime.Home); e == nil {
+			t.Fatal("noncanonical/authority-looking extension admitted")
+		}
+	}
+}
+
+func TestInspectionSeededPublicationCutsRemainUnsupported(t *testing.T) {
+	a := freshPublicationFixture()
+	zero := runtimePublicationFileWitness{}
+	for _, v := range []struct {
+		stage, target runtimePublicationFileWitness
+		reason        string
+	}{{a.Stage, zero, "prepared-not-renamed"}, {zero, a.Stage, "renamed-not-committed"}, {a.Stage, a.Stage, ""}, {zero, zero, ""}} {
+		got := inspectionPublicationCutReason(classifyRuntimeFreshRecovery(&a, nil, v.stage, v.target))
+		if got != v.reason {
+			t.Fatal("wrong or contradictory publication cut")
+		}
+		if got != "" {
+			r := runtimeInspectionResult{Schema: 2, Evidence: "bounded-observation", Scope: "product", Phase: "interrupted", Reason: got, Runtime: "uncommitted", Image: "same", Connection: "not-checked", Clients: "not-checked", Actions: inspectionUnsupportedActions()}
+			b, e := runtimeInspectionBytes(r)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if bytes.Contains(b, []byte(`"supported":true`)) {
+				t.Fatal("passive cut granted an action")
+			}
+		}
+	}
+	for _, layout := range []runtimeFreshRecoveryLayout{runtimeFreshRecoveryInvalid, runtimeFreshRecoveryCommitted, runtimeFreshRecoveryInitialized, runtimeFreshRecoveryUnadmittedStage, 255} {
+		if inspectionPublicationCutReason(layout) != "" {
+			t.Fatal("unproved layout promoted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_seeded_windows.go b/rdd/pkg/managementconfig/runtime_inspection_seeded_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..454c5c7f28d83f9bebfff794319a27fc66da66f9
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_seeded_windows.go
@@ -0,0 +1,686 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+
+	"golang.org/x/sys/windows"
+)
+
+// A read-only observation, not a native producer or an admission capability.
+// All objects remain in the original inspection owner's final recheck graph.
+type inspectionFreshRecords struct {
+	o                           *inspectionNativeOwner
+	private, public, controller *inspectionNativeObject
+	privateNames                []string
+	intent                      runtimeFreshIntent
+	intentObject                *inspectionNativeObject
+	intentBody                  []byte
+	denialWitness               runtimePublicationFileWitness
+}
+
+func inspectionNamesContain(names []string, wanted string) bool {
+	for _, name := range names {
+		if name == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+// Empty producer fragments are measured metadata, not o.read's nonempty body
+// contract. The original object is still remeasured during final recheck.
+func (o *inspectionNativeOwner) inspectionFragment(ctx context.Context, parent *inspectionNativeObject, name string, budget uint64) (*inspectionNativeObject, []byte, error) {
+	v, e := o.optional(ctx, parent, name, false, true, false, windows.FILE_READ_DATA)
+	if e != nil || v == nil {
+		return v, nil, e
+	}
+	if v.legacy.size == 0 {
+		if o.checkObject(ctx, v) != nil {
+			return v, nil, ErrUpgrade
+		}
