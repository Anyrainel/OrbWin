@@ -0,0 +1,48 @@
+package managementconfig_test
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"encoding/pem"
+	"testing"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/service/cmd/options"
+	"k8s.io/client-go/tools/clientcmd"
+	certutil "k8s.io/client-go/util/cert"
+)
+
+// Actual selected generator/serializer stays in memory. The native fresh
+// caller derives the expected endpoint from its SAME actual ConfigPublisher.
+// No native authority, listener, network or real credential is involved here.
+func TestRuntimeFreshCredentialActualBoundPortPreservesLegacyWrapper(t *testing.T) {
+	cert, key, e := certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(key)
+	doc := options.CreateKubeConfig("00000000-0000-4000-8000-000000000001", "00000000-0000-4000-8000-000000000002", "https://127.0.0.1:6550", "", cert)
+	body, e := clientcmd.Write(*doc)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer clear(body)
+	args, _ := json.Marshal([]string{"--secure-port", "6443"})
+	legacyCA, legacyPin, e := managementconfig.RuntimeUpgradeCredentialProjectionForTest(body, args)
+	defer clear(legacyCA)
+	leaf, _ := pem.Decode(cert)
+	if e != nil || leaf == nil || legacyPin != sha256.Sum256(leaf.Bytes) {
+		t.Fatal("real legacy fallback endpoint rejected", e)
+	}
+	ca, pin, e := managementconfig.FreshRuntimeCredentialProjectionForTest(body, "https://127.0.0.1:6550")
+	defer clear(ca)
+	if e != nil || leaf == nil || pin != sha256.Sum256(leaf.Bytes) {
+		t.Fatal("actual default/fallback port or leaf identity rejected", e)
+	}
+	for _, endpoint := range []string{"https://127.0.0.1:6551", "http://127.0.0.1:6550", "https://other:6550", "https://127.0.0.1:06550", "https://127.0.0.1:6550/"} {
+		if ca, _, e := managementconfig.FreshRuntimeCredentialProjectionForTest(body, endpoint); e == nil {
+			clear(ca)
+			t.Fatal("noncanonical endpoint accepted")
+		}
+	}
+}
