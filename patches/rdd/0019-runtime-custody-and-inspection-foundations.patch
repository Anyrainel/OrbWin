+func inspectionFreshNamespace(names []string) bool {
+	if len(names) > 512 {
+		return false
+	}
+	seenNames := map[string]bool{}
+	allowed := map[string]bool{"runtime": true, "setup-logs": true, anchorName: true, runtimeFreshFenceName: true, runtimeFreshAdmissionName: true, runtimeFreshCommittedName: true, runtimeFreshAppAdmissionName: true}
+	families := []struct {
+		limit uint32
+		name  func(uint32) (string, error)
+	}{
+		{runtimeFreshIntentRepairSlots, runtimeFreshIntentRepairName}, {runtimeFreshIntentRepairSlots, runtimeFreshIntentArchiveName},
+		{runtimeFreshDenialSlots, runtimeFreshDenialDirectoryName}, {runtimeFreshControlSlots, runtimeFreshControlRecordName}, {runtimeFreshControlSlots, runtimeFreshControlBirthName},
+	}
+	for _, family := range families {
+		for i := uint32(0); i < family.limit; i++ {
+			n, _ := family.name(i)
+			allowed[n] = true
+		}
+	}
+	for i := uint32(1); i <= runtimeFreshRecoveryLimit; i++ {
+		n, _ := runtimeFreshRecoveryRecordName(i)
+		allowed[n] = true
+	}
+	seeds, retained := 0, 0
+	for _, name := range names {
+		if seenNames[name] {
+			return false
+		}
+		seenNames[name] = true
+		if allowed[name] {
+			continue
+		}
+		if _, e := parseRuntimeFreshSeedName(name); e == nil {
+			seeds++
+			continue
+		}
+		if strings.HasPrefix(name, "authority.retained.") {
+			tx := strings.TrimPrefix(name, "authority.retained.")
+			n, e := runtimeFreshControlRetainedName(tx)
+			if e == nil && n == name {
+				retained++
+				continue
+			}
+		}
+		return false
+	}
+	return seeds <= 1 && retained <= 1
+}
