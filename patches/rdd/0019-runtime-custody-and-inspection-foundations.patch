@@ -0,0 +1,147 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/base64"
+	"golang.org/x/sys/windows"
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+)
+
+func TestManagedLaunchCodecCarriesOnlyCanonicalData(t *testing.T) {
+	d := managedLifetimeData{Schema: 1, Parent: 2, Creation: 3, Session: 4, Anchor: 5, Lock: 6, Interrupt: 10, AnchorID: AnchorIdentity{Volume: 7, IndexLow: 8}, LockID: AnchorIdentity{Volume: 7, IndexLow: 9}}
+	encoded, e := encodeManagedLifetimeData(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	decoded, e := decodeManagedLifetimeData(encoded)
+	if e != nil || decoded != d {
+		t.Fatal("canonical DATA did not round trip")
+	}
+	body, _ := base64.RawURLEncoding.DecodeString(encoded)
+	for _, bad := range []string{"", encoded + "=", base64.RawURLEncoding.EncodeToString(append([]byte(" "), body...)), base64.RawURLEncoding.EncodeToString(append(body[:len(body)-1], []byte(`,"extra":true}`)...))} {
+		if _, e := decodeManagedLifetimeData(bad); e == nil {
+			t.Fatal("noncanonical/unknown DATA accepted")
+		}
+	}
+	for _, bad := range []managedLifetimeData{{}, {Schema: 1, Parent: 2, Creation: 3, Session: 4, Anchor: 5, Lock: 5, AnchorID: d.AnchorID, LockID: d.LockID}} {
+		if _, e := encodeManagedLifetimeData(bad); e == nil {
+			t.Fatal("invalid inherited DATA accepted")
+		}
+	}
+}
+
+func TestManagedLaunchCopiesAndUnboundedContextsCannotStart(t *testing.T) {
+	original := &ManagedHostagentLaunch{}
+	original.self = original
+	copy := &ManagedHostagentLaunch{self: original, complete: true, cmd: &exec.Cmd{}}
+	for _, ctx := range []context.Context{nil, context.Background()} {
+		if copy.Start(ctx, nil) == nil || copy.started || copy.cmd.Process != nil {
+			t.Fatal("copied/unbounded starter reached actual Start")
+		}
+		if ConsumeManagedHostagentLifetime(ctx, "invalid") == nil {
+			t.Fatal("invalid unbounded entry consumed inherited caps")
+		}
+	}
+	if copy.Close() == nil || copy.closeAttempt.attempted {
+		t.Fatal("copied starter touched cleanup")
+	}
+}
+
+func TestManagedLaunchBornCommandRetainsParentDuplicates(t *testing.T) {
+	r := &runtimeStorageResource{handle: 42}
+	l := &ManagedHostagentLaunch{cmd: &exec.Cmd{}, resources: []*runtimeStorageResource{r}}
+	l.self = l
+	// This is an inert os.Process wrapper, never an actual process query.
+	l.cmd.Process = &os.Process{}
+	if l.Close() == nil || l.closeAttempt.attempted || r.attempted || r.handle != 42 {
+		t.Fatal("born command released its parent source capabilities before actual retirement")
+	}
+}
+
+func TestManagedLaunchUnresolvedOriginalGraphRejectsSecondBirth(t *testing.T) {
+	image := &ServingImageLease{}
+	a := &nativeManagedRuntimeAuthority{image: image}
+	r := &runtimeStorageResource{handle: 42}
+	launch := &ManagedHostagentLaunch{owner: a, cmd: &exec.Cmd{}, resources: []*runtimeStorageResource{r}, complete: true}
+	launch.self = launch
+	a.launches = []*ManagedHostagentLaunch{launch}
+	if a.launchAvailableLocked() || launch.started || r.attempted {
+		t.Fatal("prepared unresolved original launch admitted a second birth")
+	}
+	launch.cmd.Process = &os.Process{}
+	if a.launchAvailableLocked() || r.attempted {
+		t.Fatal("born but not captured original child admitted a second birth")
+	}
+	a.launches = nil
+	b := &ManagedHostagentBirth{parent: image, complete: true, process: r}
+	b.self = b
+	a.originals = []*os.Process{launch.cmd.Process}
+	a.births = []*ManagedHostagentBirth{b}
+	if a.launchAvailableLocked() || r.attempted {
+		t.Fatal("unretired original birth admitted a second birth")
+	}
+	a.births = nil
+	if a.launchAvailableLocked() {
+		t.Fatal("partially captured original child admitted a second birth")
+	}
+}
+
+func TestManagedLaunchBorrowedUnknownRefusesBeforeOwnStart(t *testing.T) {
+	for _, fault := range []string{"publisher-close", "publisher-pending", "created-close"} {
+		t.Run(fault, func(t *testing.T) {
+			c := &Created{anchor: 42, servingLease: true, authorityHandles: []windows.Handle{42}}
+			p := &ConfigPublisher{backend: &nativeAuthority{created: c}}
+			a := &nativeManagedRuntimeAuthority{created: c, publisher: p, image: &ServingImageLease{}}
+			cap := &ManagedRuntimeAuthority{native: a}
+			a.self = cap
+			c.managedAuthority = cap
+			r := &runtimeStorageResource{handle: 42}
+			l := &ManagedHostagentLaunch{owner: a, complete: true, cmd: &exec.Cmd{}, resources: []*runtimeStorageResource{r}}
+			l.self = l
+			a.launches = []*ManagedHostagentLaunch{l}
+			switch fault {
+			case "publisher-close":
+				p.closeErr = ErrUpgrade
+			case "publisher-pending":
+				p.pending = &PublicationReceipt{}
+			case "created-close":
+				c.closeErr = ErrUpgrade
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			if l.Start(ctx, nil) == nil || l.started || l.cmd.Process != nil || r.attempted {
+				t.Fatal("borrowed parent uncertainty reached own start/cleanup")
+			}
+		})
+	}
+}
+
+func TestManagedLaunchMetadataDerivativesCarryNoMutationRights(t *testing.T) {
+	mutation := uint32(windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA | windows.FILE_WRITE_EA | windows.FILE_WRITE_ATTRIBUTES | windows.DELETE | windows.WRITE_DAC | windows.WRITE_OWNER)
+	if managedAnchorRights&mutation != 0 || managedLockRights&mutation != 0 {
+		t.Fatal("metadata lifetime derivative acquired mutation rights")
+	}
+	if managedInterruptRights&windows.EVENT_MODIFY_STATE == 0 || managedInterruptRights&windows.SYNCHRONIZE == 0 || managedInterruptRights&^(windows.EVENT_MODIFY_STATE|windows.SYNCHRONIZE) != 0 {
+		t.Fatal("surviving unnamed event lost qualified signal/wait or gained excess rights")
+	}
+}
+
+func TestManagedLaunchClosedBirthKeepsImmutableOriginalAssociation(t *testing.T) {
+	image := &ServingImageLease{}
+	a := &nativeManagedRuntimeAuthority{image: image}
+	original := &os.Process{}
+	closed := &runtimeStorageResource{runtimeStorageCloseAttempt: runtimeStorageCloseAttempt{attempted: true}}
+	b := &ManagedHostagentBirth{parent: image, resources: []*runtimeStorageResource{closed}, complete: true, closeAttempt: runtimeStorageCloseAttempt{attempted: true}}
+	b.self = b // The actual post-Close cache has original=nil and all slots closed.
+	r := &runtimeStorageResource{handle: 42}
+	l := &ManagedHostagentLaunch{owner: a, cmd: &exec.Cmd{Process: original}, birth: b, boundOriginal: original, resources: []*runtimeStorageResource{r}}
+	l.self = l
+	if !l.readyForAuthorityClose(a) || l.blocksNextLaunch(a) || r.attempted || b.original != nil {
+		t.Fatal("successful birth cache lost its actual immutable launch association or preflight touched a slot")
+	}
+}
