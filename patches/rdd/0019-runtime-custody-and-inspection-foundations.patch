+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+
+	"golang.org/x/sys/windows"
+)
+
+// Actual n/controller reader shared by completed recovery, original publisher
+// and ordinary startup. A seedless wire record never ignores a live seed.
+// Read-only handles stay in original n through its existing handoff/close.
+func (n *nativeRuntimeStorage) checkFreshSeedIntentLocked(ctx context.Context, intent runtimeFreshIntent, expected runtimePublicationFileWitness) error {
+	if n == nil || !intent.valid() || !runtimeMappedSelfStorageKnownLocked(n) || n.check() != nil || !freshBoundedContext(ctx) || len(n.ancestry) == 0 {
+		return ErrUpgrade
+	}
+	if intent.Schema == 1 {
+		return n.checkSeedNamespaceLocked(ctx, "")
+	}
+	if intent.Schema != 2 || intent.Seed.Binding != n.freshSeedBindingLocked() {
+		return ErrUpgrade
+	}
+	private := runtimeStorageObjectData(n.ancestry[len(n.ancestry)-1])
+	public := runtimeStorageObjectData(n.parent)
+	if intent.PrivateParent != ([3]uint32{private.Volume, private.High, private.Low}) || intent.PublicParent != ([3]uint32{public.Volume, public.High, public.Low}) {
+		return ErrUpgrade
+	}
+	name, e := (runtimeFreshSeedName{intent.Transaction, intent.Image, intent.Commit, intent.Seed.Binding}).name()
+	if e != nil || n.checkSeedNamespaceLocked(ctx, name) != nil {
+		return ErrUpgrade
+	}
+	parent := n.ancestry[len(n.ancestry)-1]
+	seed, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil || seed.identity.size != 0 || runtimeFreshSeedObjectFact(seed, intent.Seed.Binding) != intent.Seed {
+		return ErrUpgrade
+	}
+	canonical, e := n.openFreshExistingTracked(ctx, parent.resource.handle, runtimeFreshFenceName, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(canonical, false)
+	wanted, we := encodeRuntimeFreshIntent(intent)
+	if e != nil || we != nil || !bytes.Equal(body, wanted) || runtimeStorageFileData(canonical, body) != expected {
+		return ErrUpgrade
+	}
+	if _, e = n.readFreshIntentHistoryLocked(ctx, intent, canonical, body); e != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
