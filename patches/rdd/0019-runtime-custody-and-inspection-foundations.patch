new file mode 100644
index 0000000000000000000000000000000000000000..300319afabc8656a4b8d22e517ee07bc04e548c8
--- /dev/null
+++ b/rdd/pkg/controllers/base/owned_snapshot_test.go
@@ -0,0 +1,52 @@
+package base
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+	"sigs.k8s.io/controller-runtime/pkg/client/interceptor"
+	"testing"
+)
+
+func TestOwnedSnapshotConflictNeverFallsThroughToDelete(t *testing.T) {
+	for _, fail := range []bool{true, false} {
+		item := &metav1.PartialObjectMetadata{ObjectMeta: metav1.ObjectMeta{Name: "child", UID: "original-child", ResourceVersion: "7", OwnerReferences: []metav1.OwnerReference{{UID: "original-app"}}, Finalizers: []string{OwnedFinalizerFor("App"), CleanupFinalizerName}}}
+		deletes := 0
+		c := fake.NewClientBuilder().WithInterceptorFuncs(interceptor.Funcs{Patch: func(_ context.Context, _ client.WithWatch, obj client.Object, p client.Patch, opts ...client.PatchOption) error {
+			b, e := p.Data(obj)
+			if e != nil {
+				t.Fatal(e)
+			}
+			var ops []map[string]any
+			if json.Unmarshal(b, &ops) != nil || len(ops) != 3 || ops[0]["op"] != "test" || ops[0]["value"] != "original-child" || ops[1]["op"] != "test" || ops[1]["value"] != "7" {
+				t.Fatal("finalizer patch lacks identity/version tests")
+			}
+			if fail {
+				return errors.New("replacement conflict")
+			}
+			obj.SetResourceVersion("8")
+			return nil
+		}, Delete: func(_ context.Context, _ client.WithWatch, obj client.Object, opts ...client.DeleteOption) error {
+			deletes++
+			options := &client.DeleteOptions{}
+			for _, o := range opts {
+				o.ApplyToDelete(options)
+			}
+			if options.Preconditions == nil || options.Preconditions.UID == nil || *options.Preconditions.UID != types.UID("original-child") || options.Preconditions.ResourceVersion == nil || *options.Preconditions.ResourceVersion != "8" {
+				t.Fatal("delete not tied to patched original")
+			}
+			return nil
+		}}).Build()
+		e := deleteOwnedResourceSnapshot(context.Background(), c, item, "original-app")
+		if fail && (e == nil || deletes != 0) {
+			t.Fatal("failed patch fell through to delete")
+		}
+		if !fail && (e != nil || deletes != 1 || len(item.Finalizers) != 1 || item.Finalizers[0] != CleanupFinalizerName) {
+			t.Fatal("owned cleanup did not preserve own cleanup finalizer")
+		}
+	}
+}
