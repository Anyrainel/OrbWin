+func TestRuntimeUpgradeCredentialsCertificateChainRefusals(t *testing.T) {
+	bundle, key, e := certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+	defer clear(key)
+	if e != nil {
+		t.Fatal("actual in-memory generator refused")
