+//go:build windows
+
+package service
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/util/process"
+)
+
+var errProductPIDFallback = errors.New("the OrbWin service did not confirm shutdown; no forced termination was sent; inspect diagnostics before retrying")
+
+func serviceKillFallback(pid int) error {
+	return windowsServicePIDFallback(instance.Suffix(), pid, process.Kill)
+}
+
+// This is a denial policy, not process ownership. The production callee is the
+// fixed legacy process.Kill above; it cannot run for any product case variant.
+// Neither the PID file nor the named event grants forced-generation authority.
+func windowsServicePIDFallback(suffix string, pid int, legacyKill func(int) error) error {
+	if strings.EqualFold(suffix, "orbwin") {
+		return errProductPIDFallback
+	}
+	return legacyKill(pid)
+}
