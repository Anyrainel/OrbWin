+//go:build windows
+
+package managementconfig
+
+// No owner/handle/permit escapes this management-private predicate. Native
+// completion is never inferred from error, deadline, DTO or output success.
+func inspectionNativeExitKnown() bool {
+	inspectionNativeDomain.Lock()
+	defer inspectionNativeDomain.Unlock()
+	return !inspectionNativeDomain.failed && len(inspectionNativeDomain.owners) == 0
+}
