@@ -0,0 +1,13 @@
+package managementconfig
+
+import "context"
+
+// Sequencing DATA only. Caller holds its original storage mutex and separately
+// proves owner/resource admission. No native authority is issued by this helper.
+func runtimeStoragePrepareAdmission(ctx context.Context, prepared *bool) bool {
+	if ctx == nil || prepared == nil || ctx.Err() != nil || *prepared {
+		return false
+	}
+	*prepared = true
+	return true
+}
diff --git a/rdd/pkg/managementconfig/runtime_storage_prepare_admission_test.go b/rdd/pkg/managementconfig/runtime_storage_prepare_admission_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f5d2ec134279d2ba7ff10c7808a7e98f25589137
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_storage_prepare_admission_test.go
@@ -0,0 +1,115 @@
+package managementconfig
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+type observedPrepareContext struct {
+	context.Context
+	first chan struct{}
+	calls atomic.Int32
+}
+
+func (c *observedPrepareContext) Err() error {
+	e := c.Context.Err()
+	if c.calls.Add(1) == 1 {
+		close(c.first)
+	}
+	return e
+}
+
+type prepareAdmissionResult struct {
+	prepared bool
+	effects  int
+}
+
+func TestStoragePrepareCancellationWhileWaitingForLock(t *testing.T) {
+	base, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ctx := &observedPrepareContext{Context: base, first: make(chan struct{})}
+	var mu sync.Mutex
+	mu.Lock()
+	done := make(chan prepareAdmissionResult, 1)
+	go func() {
+		prepared, effects := false, 0
+		if ctx.Err() != nil {
+			done <- prepareAdmissionResult{}
+			return
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		if runtimeStoragePrepareAdmission(ctx, &prepared) {
+			effects++
+		}
+		done <- prepareAdmissionResult{prepared, effects}
+	}()
+	<-ctx.first
+	cancel()
+	mu.Unlock()
+	r := <-done
+	if r.prepared || r.effects != 0 || ctx.calls.Load() < 2 {
+		t.Fatal("lock-wait cancellation consumed or staged", r)
+	}
+}
+func TestStoragePrepareCancellationDuringPreAdmissionWork(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	entered, release := make(chan struct{}), make(chan struct{})
+	done := make(chan prepareAdmissionResult, 1)
+	go func() {
+		prepared, effects := false, 0
+		var mu sync.Mutex
+		mu.Lock()
+		defer mu.Unlock()
+		if ctx.Err() != nil {
+			done <- prepareAdmissionResult{}
+			return
+		}
+		close(entered)
+		<-release
+		if runtimeStoragePrepareAdmission(ctx, &prepared) {
+			effects++
+		}
+		done <- prepareAdmissionResult{prepared, effects}
+	}()
+	<-entered
+	cancel()
+	close(release)
+	r := <-done
+	if r.prepared || r.effects != 0 {
+		t.Fatal("canceled predecessor/encode/SD interval staged", r)
+	}
+}
+func TestStoragePreparePostAdmissionCancellationKeepsOneUse(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	prepared := false
+	effects := 0
+	if !runtimeStoragePrepareAdmission(ctx, &prepared) {
+		t.Fatal("first admission")
+	}
+	cancel()
+	// Once admitted the original operation settles or retains; cancellation is
+	// never an undo, native-completion witness, or second-create permission.
+	effects++
+	if !prepared || ctx.Err() == nil || runtimeStoragePrepareAdmission(context.Background(), &prepared) || effects != 1 {
+		t.Fatal("post-admission replay/undo")
+	}
+}
+func TestStoragePrepareAdmissionInvalidAndFreshState(t *testing.T) {
+	prepared := false
+	if runtimeStoragePrepareAdmission(nil, &prepared) || prepared || runtimeStoragePrepareAdmission(context.Background(), nil) {
+		t.Fatal("invalid admission")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if runtimeStoragePrepareAdmission(ctx, &prepared) || prepared {
+		t.Fatal("canceled consumed")
+	}
+	if !runtimeStoragePrepareAdmission(context.Background(), &prepared) || !prepared {
+		t.Fatal("pre-admission cancel incorrectly consumed fresh state")
+	}
+}
