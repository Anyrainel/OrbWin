+//go:build windows
+
+package controllers
+
+import (
+	"errors"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+	"testing"
+)
+
+func TestProductUnheldLifecyclePolicyRefusesProductScope(t *testing.T) {
+	for _, scope := range []string{"orbwin", "OrbWin", "ORBWIN"} {
+		if err := productUnheldLifecyclePolicy(scope); err == nil || !errors.Is(err, reconcile.TerminalError(nil)) {
+			t.Fatal("product PID/name metadata admitted forced recovery")
+		}
+	}
+	for _, scope := range []string{"", "rancher-desktop", "orbwin-proof"} {
+		if productUnheldLifecyclePolicy(scope) != nil {
+			t.Fatal("nonproduct upstream policy changed")
+		}
+	}
+}
