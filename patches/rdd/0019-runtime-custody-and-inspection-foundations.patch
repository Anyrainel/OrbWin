@@ -0,0 +1,244 @@
+package managementconfig
+
+import (
+	"crypto/sha256"
+	"testing"
+)
+
+func denialPublicObservation(body []byte, id uint32) runtimeFreshDenialRecipeObservation {
+	v := denialObservation(body, id)
+	v.File.Object.Volume = 2
+	return v
+}
+func denialReceiptFixture() (runtimeFreshDenialPlan, []byte) {
+	plan := denialDirectoryFixture().Plan
+	rec := runtimeFreshLegacyRecordFixture()
+	rec.Transaction = plan.Transaction
+	rec.Intent = plan.Intent
+	rec.Parent = runtimeFreshLegacyDirectoryFact{plan.PublicParent, plan.PublicDescriptor}
+	b, _ := encodeRuntimeFreshLegacyDenial(rec)
+	return plan, b
+}
+func TestRuntimeFreshDenialAllDirectoryCutsAndBytePrefixes(t *testing.T) {
+	current := denialDirectoryFixture()
+	for count := uint32(0); count <= runtimeFreshLegacyDirectoryCount; count++ {
+		current.Count = count
+		if count > 0 {
+			current.Prefix[count-1] = runtimeFreshLegacyDirectoryFact{Object: UpgradeObject{2, 0, 80 + count}, Descriptor: [32]byte{byte(count)}}
+		}
+		if validateRuntimeFreshDenialDirectoryHistory(nil, current) != nil {
+			t.Fatalf("raw original prefix %d", count)
+		}
+		if count == 5 {
+			continue
+		}
+		complete := current
+		complete.Ordinal = 1
+		b, e := runtimeFreshRecordBytes(complete)
+		if e != nil {
+			t.Fatal(e)
+		}
+		old := complete
+		old.Ordinal = 0
+		partial, _ := runtimeFreshRecordBytes(old)
+		for cut := 0; cut < len(partial); cut++ {
+			slots := []runtimeFreshDenialRecipeObservation{denialObservation(partial[:cut], 200), denialObservation(b, 201)}
+			advanced := current
+			advanced.Count++
+			advanced.Prefix[count] = runtimeFreshLegacyDirectoryFact{Object: UpgradeObject{2, 0, 100 + count}, Descriptor: [32]byte{8}}
+			advanced.Previous = slots[1].File
+			if validateRuntimeFreshDenialDirectoryHistory(slots, advanced) != nil {
+				t.Fatalf("count%d byte%d original partial rejected", count, cut)
+			}
+		}
+	}
+}
+func TestRuntimeFreshDenialReceiptAllByteCutsAndCrashStates(t *testing.T) {
+	plan, wanted := denialReceiptFixture()
+	archives := make([]*runtimeFreshDenialRecipeObservation, runtimeFreshDenialSlots)
+	check := func(c runtimeFreshDenialRecipeObservation, present bool, recipes []runtimeFreshDenialRecipeObservation, ar []*runtimeFreshDenialRecipeObservation, completion []runtimeFreshDenialRecipeObservation) error {
+		_, _, _, _, e := validateRuntimeFreshDenialReceiptHistory(plan, wanted, c, present, recipes, ar, completion, runtimePublicationFileWitness{})
+		return e
+	}
+	for cut := 0; cut < len(wanted); cut++ {
+		old := denialPublicObservation(wanted[:cut], 300)
+		r := runtimeFreshDenialRepair{Schema: 1, Plan: plan, Old: old.File, DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+		b, _ := runtimeFreshRecordBytes(r)
+		recipe := denialPublicObservation(b, 301)
+		if check(old, true, nil, archives, nil) != nil || check(old, true, []runtimeFreshDenialRecipeObservation{recipe}, archives, nil) != nil {
+			t.Fatalf("unarchived byte%d", cut)
+		}
+		ar := append([]*runtimeFreshDenialRecipeObservation(nil), archives...)
+		ar[0] = &old
+		if check(runtimeFreshDenialRecipeObservation{}, false, []runtimeFreshDenialRecipeObservation{recipe}, ar, nil) != nil {
+			t.Fatalf("archived absent byte%d", cut)
+		}
+		if check(denialPublicObservation(wanted, 302), true, []runtimeFreshDenialRecipeObservation{recipe}, ar, nil) != nil {
+			t.Fatalf("archived complete byte%d", cut)
+		}
+		if check(denialPublicObservation(wanted[:cut], 302), true, []runtimeFreshDenialRecipeObservation{recipe}, ar, nil) != nil {
+			t.Fatalf("archived new partial byte%d", cut)
+		}
+		if check(old, true, []runtimeFreshDenialRecipeObservation{recipe}, ar, nil) == nil {
+			t.Fatalf("reused old canonical byte%d", cut)
+		}
+	}
+	old := denialPublicObservation(wanted[:len(wanted)/2], 300)
+	rec := runtimeFreshDenialRepair{Schema: 1, Ordinal: 1, Plan: plan, Old: old.File, DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+	b, _ := runtimeFreshRecordBytes(rec)
+	partialRec := rec
+	partialRec.Ordinal = 0
+	partial, _ := runtimeFreshRecordBytes(partialRec)
+	for cut := 0; cut < len(partial); cut++ {
+		slots := []runtimeFreshDenialRecipeObservation{denialPublicObservation(partial[:cut], 400), denialPublicObservation(b, 401)}
+		if check(old, true, slots, archives, nil) != nil {
+			t.Fatalf("repair original byte%d", cut)
+		}
+	}
+	full := denialPublicObservation(wanted, 500)
+	completion := runtimeFreshDenialCompletion{Schema: 1, Ordinal: 1, Plan: plan, Denial: full.File}
+	cb, _ := runtimeFreshRecordBytes(completion)
+	completion.Ordinal = 0
+	prefix, _ := runtimeFreshRecordBytes(completion)
+	for cut := 0; cut < len(prefix); cut++ {
+		slots := []runtimeFreshDenialRecipeObservation{denialPublicObservation(prefix[:cut], 501), denialPublicObservation(cb, 502)}
+		if check(full, true, nil, archives, slots) != nil {
+			t.Fatalf("completion byte%d", cut)
+		}
+	}
+}
+func TestRuntimeFreshDenialHistoryContradictionsPreserveRefuse(t *testing.T) {
+	plan, wanted := denialReceiptFixture()
+	full := denialPublicObservation(wanted, 600)
+	old := denialPublicObservation(wanted[:8], 601)
+	r := runtimeFreshDenialRepair{Schema: 1, Plan: plan, Old: old.File, DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+	b, _ := runtimeFreshRecordBytes(r)
+	recipe := denialPublicObservation(b, 602)
+	archives := make([]*runtimeFreshDenialRecipeObservation, 16)
+	archives[0] = &old
+	comp := runtimeFreshDenialCompletion{Schema: 1, Plan: plan, Denial: full.File, RepairHead: recipe.File}
+	cb, _ := runtimeFreshRecordBytes(comp)
+	complete := denialPublicObservation(cb, 603)
+	check := func(p runtimeFreshDenialPlan, c runtimeFreshDenialRecipeObservation, recipes []runtimeFreshDenialRecipeObservation, ar []*runtimeFreshDenialRecipeObservation, completions []runtimeFreshDenialRecipeObservation) error {
+		_, _, _, _, e := validateRuntimeFreshDenialReceiptHistory(p, wanted, c, true, recipes, ar, completions, runtimePublicationFileWitness{})
+		return e
+	}
+	if check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, archives, []runtimeFreshDenialRecipeObservation{complete}) != nil {
+		t.Fatal("fixture")
+	}
+	badPlan := plan
+	badPlan.Seed.Binding = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
+	orphan := append([]*runtimeFreshDenialRecipeObservation(nil), archives...)
+	orphan[2] = &old
+	wrongOld := old
+	wrongOld.File.Descriptor[0]++
+	wrongArchive := append([]*runtimeFreshDenialRecipeObservation(nil), archives...)
+	wrongArchive[0] = &wrongOld
+	wrongHead := comp
+	wrongHead.RepairHead = runtimePublicationFileWitness{}
+	wh, _ := runtimeFreshRecordBytes(wrongHead)
+	foreign := denialPublicObservation([]byte("foreign"), 604)
+	for name, e := range map[string]error{
+		"seed substitution":        check(badPlan, full, []runtimeFreshDenialRecipeObservation{recipe}, archives, nil),
+		"orphan archive":           check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, orphan, nil),
+		"changed archive":          check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, wrongArchive, nil),
+		"completion drops history": check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, archives, []runtimeFreshDenialRecipeObservation{denialPublicObservation(wh, 603)}),
+		"post complete slot":       check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, archives, []runtimeFreshDenialRecipeObservation{complete, foreign}),
+		"partial without source":   check(plan, full, []runtimeFreshDenialRecipeObservation{foreign}, make([]*runtimeFreshDenialRecipeObservation, 16), nil),
+	} {
+		if e == nil {
+			t.Fatalf("%s accepted", name)
+		}
+	}
+	exhausted := make([]runtimeFreshDenialRecipeObservation, 16)
+	for i := range exhausted {
+		comp.Ordinal = uint32(i)
+		v, _ := runtimeFreshRecordBytes(comp)
+		exhausted[i] = denialPublicObservation(v[:len(v)-1], uint32(700+i))
+	}
+	_, _, _, completed, e := validateRuntimeFreshDenialReceiptHistory(plan, wanted, full, true, []runtimeFreshDenialRecipeObservation{recipe}, archives, exhausted, runtimePublicationFileWitness{})
+	if e != nil || completed != nil {
+		t.Fatal("bounded preserved partial slots cannot supply completion")
+	}
+	exhausted = append(exhausted, foreign)
+	if check(plan, full, []runtimeFreshDenialRecipeObservation{recipe}, archives, exhausted) == nil {
+		t.Fatal("17 slots")
+	}
+}
+
+func TestRuntimeFreshDenialNamespacesRejectDowngradeHolesAndUnknowns(t *testing.T) {
+	for _, private := range []bool{false, true} {
+		for _, seeded := range []bool{false, true} {
+			if !runtimeFreshDenialNamespaceValid(nil, seeded, private) {
+				t.Fatal("empty family")
+			}
+		}
+	}
+	for _, v := range []struct {
+		names           []string
+		seeded, private bool
+	}{
+		{[]string{"authority.fresh.denial-directory.9999"}, false, true},
+		{[]string{"authority.fresh.denial-directory.0000"}, false, true},
+		{[]string{".denial-complete.9999"}, false, false},
+		{[]string{".denial-repair.bad"}, false, false},
+		{[]string{".Denial-Complete.0000"}, false, false},
+		{[]string{".Denial-complete.0000"}, true, false},
+		{[]string{".denial-complete.0001"}, true, false},
+		{[]string{"authority.fresh.denial-directory.0001"}, true, true},
+		{[]string{"denial.json", "foreign"}, true, false},
+		{[]string{"denial.json", "denial.json"}, true, false},
+	} {
+		if runtimeFreshDenialNamespaceValid(v.names, v.seeded, v.private) {
+			t.Fatalf("accepted%v", v.names)
+		}
+	}
+	if !runtimeFreshDenialNamespaceValid([]string{"denial.json", ".denial-repair.0000", ".denial-fragment.0000", ".denial-complete.0000"}, true, false) {
+		t.Fatal("recognized namespace")
+	}
+	names := make([]string, 50)
+	if runtimeFreshDenialNamespaceValid(names, true, false) {
+		t.Fatal("public budget")
+	}
+	names = make([]string, 513)
+	if runtimeFreshDenialNamespaceValid(names, true, true) {
+		t.Fatal("private budget")
+	}
+}
+
+func TestRuntimeFreshDenialRepairPartialsKeepOriginalOldFile(t *testing.T) {
+	plan, wanted := denialReceiptFixture()
+	a := denialPublicObservation(wanted[:20], 800)
+	b := denialPublicObservation(wanted[:30], 801)
+	first := runtimeFreshDenialRepair{Schema: 1, Ordinal: 1, Plan: plan, Old: a.File, DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+	f, _ := runtimeFreshRecordBytes(first)
+	p := first
+	p.Ordinal = 0
+	fp, _ := runtimeFreshRecordBytes(p)
+	slots := []runtimeFreshDenialRecipeObservation{denialPublicObservation(fp[:len(fp)-3], 802), denialPublicObservation(f, 803)}
+	second := first
+	second.Ordinal = 3
+	second.Previous = slots[1].File
+	second.Old = b.File
+	sb, _ := runtimeFreshRecordBytes(second)
+	sp := second
+	sp.Ordinal = 2
+	spb, _ := runtimeFreshRecordBytes(sp)
+	slots = append(slots, denialPublicObservation(spb[:len(spb)-3], 804), denialPublicObservation(sb, 805))
+	archives := make([]*runtimeFreshDenialRecipeObservation, 16)
+	archives[1] = &a
+	archives[3] = &b
+	full := denialPublicObservation(wanted, 806)
+	_, _, _, _, e := validateRuntimeFreshDenialReceiptHistory(plan, wanted, full, true, slots, archives, nil, runtimePublicationFileWitness{})
+	if e != nil {
+		t.Fatal("original old-file predecessor prefixes rejected")
+	}
+	wrong := second
+	wrong.Ordinal = 0
+	wb, _ := runtimeFreshRecordBytes(wrong)
+	slots[0] = denialPublicObservation(wb[:len(wb)-3], 802)
+	_, _, _, _, e = validateRuntimeFreshDenialReceiptHistory(plan, wanted, full, true, slots, archives, nil, runtimePublicationFileWitness{})
+	if e == nil {
+		t.Fatal("later old-file recipe blessed earlier partial")
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_history_windows.go b/rdd/pkg/managementconfig/runtime_fresh_denial_history_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..5f6b929dd72fb17290151eb49df4ceca4ea3ea5c
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_denial_history_windows.go
@@ -0,0 +1,168 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+type nativeFreshDenialHistory struct {
+	directories               []runtimeFreshDenialRecipeObservation
+	repairs                   []runtimeFreshDenialRecipeObservation
+	archives                  []*runtimeFreshDenialRecipeObservation
+	completions               []runtimeFreshDenialRecipeObservation
+	directoryHead, repairHead runtimePublicationFileWitness
+	directoryLast             *runtimeFreshDenialDirectoryRecipe
+	repairLast                *runtimeFreshDenialRepair
+	unarchived                bool
+	completion                *runtimeFreshDenialCompletion
+}
+
+func (n *nativeRuntimeStorage) denialPlanLocked(intent runtimeFreshIntent, witness runtimePublicationFileWitness) (runtimeFreshDenialPlan, error) {
+	var p runtimeFreshDenialPlan
+	if !runtimeMappedSelfStorageKnownLocked(n) || !intent.valid() || intent.Schema != 2 || len(n.ancestry) == 0 || n.parent == nil || n.controller == nil {
+		return p, ErrUpgrade
+	}
+	private := n.ancestry[len(n.ancestry)-1]
+	p = runtimeFreshDenialPlan{Transaction: intent.Transaction, Seed: intent.Seed, Intent: witness, PrivateParent: runtimeStorageObjectData(private), PublicParent: runtimeStorageObjectData(n.parent), Controller: runtimeStorageObjectData(n.controller), PrivateDescriptor: private.identity.descriptor, PublicDescriptor: n.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor}
+	if !p.valid() {
+		return runtimeFreshDenialPlan{}, ErrUpgrade
+	}
+	return p, nil
+}
+
+// Temporary FILE_OPEN-only observations. Every successful probe closes once;
+// retained completion/canonical witnesses are supplied by their actual owners.
+func (n *nativeRuntimeStorage) denialObservationLocked(ctx context.Context, parent *runtimeStorageObject, name string) (*runtimeFreshDenialRecipeObservation, error) {
+	o, e := n.openFreshExistingTracked(ctx, parent.resource.handle, name, false, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, true, false)
+	if e != nil {
+		return nil, e
+	}
+	if o.identity.size > runtimeFreshRecordBudget {
+		return nil, ErrUpgrade
+	}
+	b, e := n.read(o, true)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	v := &runtimeFreshDenialRecipeObservation{b, runtimeStorageFileData(o, b)}
+	if n.closeTemporary(o.resource) != nil {
+		return nil, ErrUpgrade
+	}
+	return v, nil
+}
+
+func (n *nativeRuntimeStorage) readDenialFamilyLocked(ctx context.Context, parent *runtimeStorageObject, name func(uint32) (string, error)) ([]runtimeFreshDenialRecipeObservation, error) {
+	var result []runtimeFreshDenialRecipeObservation
+	gap := false
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		key, _ := name(i)
+		v, e := n.denialObservationLocked(ctx, parent, key)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			gap = true
+			continue
+		}
+		if e != nil || gap {
+			return nil, ErrUpgrade
+		}
+		result = append(result, *v)
+	}
+	return result, nil
+}
+
+// All histories are bounded, contiguous and original-plan bound. No newest
+// record selection and no decoded object is an issuer. canonical may be a
+// precise absent receipt only during the original pending early cut.
+func (n *nativeRuntimeStorage) readDenialHistoryLocked(ctx context.Context, plan runtimeFreshDenialPlan, dirs [runtimeFreshLegacyDirectoryCount]*runtimeStorageObject, count uint32, canonical *runtimeStorageObject, body []byte) (nativeFreshDenialHistory, error) {
+	var h nativeFreshDenialHistory
+	if !plan.valid() || !freshBoundedContext(ctx) || count > runtimeFreshLegacyDirectoryCount || len(n.ancestry) == 0 {
+		return h, ErrUpgrade
+	}
+	private := n.ancestry[len(n.ancestry)-1]
+	var e error
+	h.directories, e = n.readDenialFamilyLocked(ctx, private, runtimeFreshDenialDirectoryName)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+	current := runtimeFreshDenialDirectoryRecipe{Schema: 1, Plan: plan, Count: count}
+	for i := uint32(0); i < count; i++ {
+		if dirs[i] == nil || n.checkObject(dirs[i]) != nil {
+			return h, ErrUpgrade
+		}
+		current.Prefix[i] = freshLegacyDirectoryFact(dirs[i])
+	}
+	for _, v := range h.directories {
+		var r runtimeFreshDenialDirectoryRecipe
+		if parseRuntimeFreshRecord(v.Body, &r) == nil && r.valid() {
+			copy := r
+			h.directoryLast = &copy
+			h.directoryHead = v.File
+		}
+	}
+	current.Previous = h.directoryHead
+	if validateRuntimeFreshDenialDirectoryHistory(h.directories, current) != nil {
+		return h, ErrUpgrade
+	}
+	if h.directoryLast != nil && (h.directoryLast.Count > count || h.directoryLast.Count+1 < count) {
+		return h, ErrUpgrade
+	}
+	// Unknown private authority metadata cannot be silently ignored at this
+	// early stage. General control/recovery records remain owned by their readers.
+	names, e := n.freshPrivateDirectoryNamesLocked(ctx)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+	if !runtimeFreshDenialNamespaceValid(names, true, true) {
+		return h, ErrUpgrade
+	}
+
+	if count < runtimeFreshLegacyDirectoryCount {
+		return h, nil
+	}
+	pid := dirs[runtimeFreshLegacyDirectoryCount-1]
+	names, e = n.freshDenialDirectoryNamesLocked(ctx, dirs)
+	if e != nil || len(names) > 49 {
+		return h, ErrUpgrade
+	}
+	if !runtimeFreshDenialNamespaceValid(names, true, false) {
+		return h, ErrUpgrade
+	}
+
+	h.repairs, e = n.readDenialFamilyLocked(ctx, pid, runtimeFreshDenialRepairName)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+	var wanted []byte
+	rec := runtimeFreshLegacyDenialRecord{Schema: 1, Transaction: plan.Transaction, Intent: plan.Intent, Parent: freshLegacyDirectoryFact(n.parent)}
+	for i, o := range dirs {
+		rec.Directories[i] = freshLegacyDirectoryFact(o)
+	}
+	wanted, e = encodeRuntimeFreshLegacyDenial(rec)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		name, _ := runtimeFreshDenialArchiveName(i)
+		archive, ae := n.denialObservationLocked(ctx, pid, name)
+		if ae != nil && ae != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return h, ErrUpgrade
+		}
+		h.archives = append(h.archives, archive)
+	}
+	h.completions, e = n.readDenialFamilyLocked(ctx, pid, runtimeFreshDenialCompletionName)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+	canonicalData := runtimeFreshDenialRecipeObservation{}
+	if canonical != nil {
+		canonicalData = runtimeFreshDenialRecipeObservation{body, runtimeStorageFileData(canonical, body)}
+	}
+	h.repairHead, h.repairLast, h.unarchived, h.completion, e = validateRuntimeFreshDenialReceiptHistory(plan, wanted, canonicalData, canonical != nil, h.repairs, h.archives, h.completions, h.directoryHead)
+	if e != nil {
+		return h, ErrUpgrade
+	}
+
+	return h, nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_prefix.go b/rdd/pkg/managementconfig/runtime_fresh_denial_prefix.go
new file mode 100644
index 0000000000000000000000000000000000000000..6f24061beefa8eb5779d5a7bb8bd44659745b89f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_denial_prefix.go
@@ -0,0 +1,391 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"strings"
+)
+
+const runtimeFreshDenialSlots = 16
+
+// A receipt repair describes immutable old bytes. The desired canonical
+// denial stays independent of repair/completion hashes, avoiding a cycle.
+type runtimeFreshDenialRepair struct {
+	Schema        int
+	Ordinal       uint32
+	Plan          runtimeFreshDenialPlan
+	Previous, Old runtimePublicationFileWitness
+	DesiredSize   uint64
+	Desired       [32]byte
+}
+
+func (r runtimeFreshDenialRepair) valid() bool {
+	return r.Schema == 1 && r.Ordinal < runtimeFreshDenialSlots && r.Plan.valid() &&
+		(r.Previous == (runtimePublicationFileWitness{}) || r.Previous.valid()) &&
+		freshRoleWitnessValid(r.Old, true) && r.Old.Object.Volume == r.Plan.PublicParent.Volume &&
+		r.DesiredSize > r.Old.Size && r.DesiredSize <= runtimeFreshLegacyDenialBudget && r.Desired != ([32]byte{})
+}
+
+func runtimeFreshDenialDirectoryName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshDenialSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.denial-directory.%04d", ordinal), nil
+}
+func runtimeFreshDenialRepairName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshDenialSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf(".denial-repair.%04d", ordinal), nil
+}
+func runtimeFreshDenialArchiveName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshDenialSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf(".denial-fragment.%04d", ordinal), nil
+}
+func runtimeFreshDenialCompletionName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshDenialSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf(".denial-complete.%04d", ordinal), nil
+}
+
+// DATA only. This common record is not an issuer and is deliberately separate
+// from the actual pending d/r/o/n producer attachment in the native module.
+type runtimeFreshDenialPlan struct {
+	Transaction                                               string
+	Seed                                                      runtimeFreshSeedFact
+	Intent                                                    runtimePublicationFileWitness
+	PrivateParent, PublicParent, Controller                   UpgradeObject
+	PrivateDescriptor, PublicDescriptor, ControllerDescriptor [32]byte
+}
+
+func (p runtimeFreshDenialPlan) valid() bool {
+	return upgradeHex(p.Transaction, 32) && p.Seed.valid() && p.Intent.valid() && p.PrivateParent.valid() && p.PublicParent.valid() && p.Controller.valid() && p.PrivateDescriptor != ([32]byte{}) && p.PublicDescriptor != ([32]byte{}) && p.ControllerDescriptor != ([32]byte{}) && p.Intent.Object.Volume == p.PrivateParent.Volume && p.Seed.Object.Volume == p.PrivateParent.Volume && p.Controller.Volume == p.PublicParent.Volume && p.PrivateParent != p.Intent.Object && p.PrivateParent != p.Seed.Object && p.Intent.Object != p.Seed.Object && p.Controller != p.PublicParent
+}
+
+type runtimeFreshDenialDirectoryRecipe struct {
+	Schema   int
+	Ordinal  uint32
+	Plan     runtimeFreshDenialPlan
+	Previous runtimePublicationFileWitness
+	Count    uint32 // fixed next role, not an externally supplied name
+	Prefix   [runtimeFreshLegacyDirectoryCount]runtimeFreshLegacyDirectoryFact
+}
+
+func (r runtimeFreshDenialDirectoryRecipe) valid() bool {
+	if r.Schema != 1 || r.Ordinal >= runtimeFreshDenialSlots || !r.Plan.valid() || r.Count >= runtimeFreshLegacyDirectoryCount || (r.Previous != (runtimePublicationFileWitness{}) && !r.Previous.valid()) {
+		return false
+	}
+	seen := map[UpgradeObject]bool{r.Plan.PublicParent: true, r.Plan.Controller: true}
+	for i, fact := range r.Prefix {
+		if uint32(i) >= r.Count {
+			if fact != (runtimeFreshLegacyDirectoryFact{}) {
+				return false
+			}
+			continue
+		}
+		if !fact.Object.valid() || fact.Object.Volume != r.Plan.PublicParent.Volume || fact.Descriptor == ([32]byte{}) || seen[fact.Object] {
+			return false
+		}
+		seen[fact.Object] = true
+	}
+	return true
+}
+
+type runtimeFreshDenialRecipeObservation struct {
+	Body []byte
+	File runtimePublicationFileWitness
+}
+
+// Negative history validation only. Earlier partial slots use the NEXT full
+// step's ORIGINAL plan, never today's expanded prefix. Native code must still
+// prove each File witness and original actual producer before any effect.
+func validateRuntimeFreshDenialDirectoryHistory(slots []runtimeFreshDenialRecipeObservation, current runtimeFreshDenialDirectoryRecipe) error {
+	currentValid := current.valid()
+	if current.Count == runtimeFreshLegacyDirectoryCount {
+		prior := current
+		prior.Count--
+		prior.Prefix[4] = runtimeFreshLegacyDirectoryFact{}
+		currentValid = prior.valid() && current.Prefix[4].Object.valid() && current.Prefix[4].Object.Volume == current.Plan.PublicParent.Volume && current.Prefix[4].Descriptor != ([32]byte{})
+		for i := 0; i < 4; i++ {
+			if current.Prefix[i].Object == current.Prefix[4].Object {
+				currentValid = false
+			}
+		}
+		if current.Prefix[4].Object == current.Plan.PublicParent || current.Prefix[4].Object == current.Plan.Controller {
+			currentValid = false
+		}
+	}
+	if len(slots) > runtimeFreshDenialSlots || !currentValid {
+		return ErrUpgrade
+	}
+	var pending []uint32
+	previous := runtimePublicationFileWitness{}
+	var last *runtimeFreshDenialDirectoryRecipe
+	seen := map[UpgradeObject]bool{}
+	for ordinal, slot := range slots {
+		if !freshRoleWitnessValid(slot.File, true) || len(slot.Body) > runtimeFreshRecordBudget || slot.File.Object.Volume != current.Plan.PrivateParent.Volume || seen[slot.File.Object] || slot.File.Size != uint64(len(slot.Body)) || slot.File.Body != sha256.Sum256(slot.Body) {
+			return ErrUpgrade
+		}
+		seen[slot.File.Object] = true
+		var record runtimeFreshDenialDirectoryRecipe
+		if parseRuntimeFreshRecord(slot.Body, &record) != nil || !record.valid() {
+			pending = append(pending, uint32(ordinal))
+			continue
+		}
+		if record.Ordinal != uint32(ordinal) || record.Previous != previous || record.Plan != current.Plan {
+			return ErrUpgrade
+		}
+		if last != nil && (record.Count != last.Count+1) {
+			return ErrUpgrade
+		}
+		if record.Count > current.Count {
+			return ErrUpgrade
+		}
+		for i := uint32(0); i < record.Count; i++ {
+			if record.Prefix[i] != current.Prefix[i] {
+				return ErrUpgrade
+			}
+		}
+		for _, partial := range pending {
+			expected := record
+			expected.Ordinal = partial
+			body, e := runtimeFreshRecordBytes(expected)
+			if e != nil || !runtimeFreshControlPrefixBytes(slots[partial].Body, body) {
+				return ErrUpgrade
+			}
+		}
+		pending = nil
+		copy := record
+		last = &copy
+		previous = slot.File
+	}
+	if len(pending) > 0 {
+		if current.Count == runtimeFreshLegacyDirectoryCount {
+			return ErrUpgrade
+		}
+		if current.Previous != previous {
+			return ErrUpgrade
+		}
+		if last != nil && current.Count != last.Count+1 {
+			return ErrUpgrade
+		}
+		for _, partial := range pending {
+			expected := current
+			expected.Ordinal = partial
+			body, e := runtimeFreshRecordBytes(expected)
+			if e != nil || !runtimeFreshControlPrefixBytes(slots[partial].Body, body) {
+				return ErrUpgrade
+			}
+		}
+	}
+	if current.Previous != previous || last != nil && last.Count+1 < current.Count {
+		return ErrUpgrade
+	}
+
+	return nil
+}
+
+type runtimeFreshDenialCompletion struct {
+	Schema                            int
+	Ordinal                           uint32
+	Plan                              runtimeFreshDenialPlan
+	Denial, DirectoryHead, RepairHead runtimePublicationFileWitness
+}
+
+func (c runtimeFreshDenialCompletion) valid() bool {
+	if c.Schema != 1 || c.Ordinal >= runtimeFreshDenialSlots || !c.Plan.valid() || !c.Denial.valid() || c.Denial.Object.Volume != c.Plan.PublicParent.Volume {
+		return false
+	}
+	if c.DirectoryHead != (runtimePublicationFileWitness{}) && (!c.DirectoryHead.valid() || c.DirectoryHead.Object.Volume != c.Plan.PrivateParent.Volume) {
+		return false
+	}
+	if c.RepairHead != (runtimePublicationFileWitness{}) && (!c.RepairHead.valid() || c.RepairHead.Object.Volume != c.Plan.PublicParent.Volume) {
+		return false
+	}
+	if c.DirectoryHead != (runtimePublicationFileWitness{}) && c.DirectoryHead.Object == c.Plan.Intent.Object {
+		return false
+	}
+	return c.RepairHead == (runtimePublicationFileWitness{}) || c.RepairHead.Object != c.Denial.Object
+}
+
+// Negative receipt/history classifier; native callers independently capture
+// every fixed name, exact object and precise absence before invoking it.
+func validateRuntimeFreshDenialReceiptHistory(plan runtimeFreshDenialPlan, wanted []byte, canonical runtimeFreshDenialRecipeObservation, present bool, repairs []runtimeFreshDenialRecipeObservation, archives []*runtimeFreshDenialRecipeObservation, completions []runtimeFreshDenialRecipeObservation, directoryHead runtimePublicationFileWitness) (repairHead runtimePublicationFileWitness, last *runtimeFreshDenialRepair, unarchived bool, completion *runtimeFreshDenialCompletion, failure error) {
+	fail := func() (runtimePublicationFileWitness, *runtimeFreshDenialRepair, bool, *runtimeFreshDenialCompletion, error) {
+		return runtimePublicationFileWitness{}, nil, false, nil, ErrUpgrade
+	}
+	if !plan.valid() || len(wanted) == 0 || len(wanted) > runtimeFreshLegacyDenialBudget || len(repairs) > runtimeFreshDenialSlots || len(archives) != runtimeFreshDenialSlots || len(completions) > runtimeFreshDenialSlots {
+		return fail()
+	}
+	seenFiles := map[UpgradeObject]bool{}
+	check := func(v runtimeFreshDenialRecipeObservation) bool {
+		if len(v.Body) > runtimeFreshRecordBudget || !freshRoleWitnessValid(v.File, true) || v.File.Object.Volume != plan.PublicParent.Volume || v.File.Size != uint64(len(v.Body)) || v.File.Body != sha256.Sum256(v.Body) || seenFiles[v.File.Object] {
+			return false
+		}
+		seenFiles[v.File.Object] = true
+		return true
+	}
+	if present {
+		if !check(canonical) || !runtimeFreshControlPrefixBytes(canonical.Body, wanted) {
+			return fail()
+		}
+	} else if canonical.File != (runtimePublicationFileWitness{}) || len(canonical.Body) != 0 {
+		return fail()
+	}
+	type partial struct {
+		ordinal uint32
+		body    []byte
+	}
+	var pending []partial
+	seenOld := map[UpgradeObject]bool{}
+	for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+		archive := archives[i]
+		if int(i) >= len(repairs) {
+			if archive != nil {
+				return fail()
+			}
+			continue
+		}
+		v := repairs[i]
+		if unarchived || !check(v) {
+			return fail()
+		}
+		var r runtimeFreshDenialRepair
+		if parseRuntimeFreshRecord(v.Body, &r) != nil || !r.valid() {
+			if archive != nil {
+				return fail()
+			}
+			pending = append(pending, partial{i, v.Body})
+			continue
+		}
+		if r.Ordinal != i || r.Plan != plan || r.Previous != repairHead || r.DesiredSize != uint64(len(wanted)) || r.Desired != sha256.Sum256(wanted) || seenOld[r.Old.Object] {
+			return fail()
+		}
+		old := archive
+		if old == nil {
+			if !present {
+				return fail()
+			}
+			old = &canonical
+			unarchived = true
+		} else if !check(*old) {
+			return fail()
+		}
+		if old.File != r.Old || !runtimeFreshControlPrefixBytes(old.Body, wanted) || len(old.Body) >= len(wanted) {
+			return fail()
+		}
+		for _, p := range pending {
+			original := r
+			original.Ordinal = p.ordinal
+			b, e := runtimeFreshRecordBytes(original)
+			if e != nil || !runtimeFreshControlPrefixBytes(p.body, b) {
+				return fail()
+			}
+		}
+		pending = nil
+		seenOld[r.Old.Object] = true
+		copy := r
+		last = &copy
+		repairHead = v.File
+	}
+	if present && seenOld[canonical.File.Object] && !unarchived {
+		return fail()
+	}
+	if len(pending) > 0 {
+		if !present || bytes.Equal(canonical.Body, wanted) {
+			return fail()
+		}
+		r := runtimeFreshDenialRepair{Schema: 1, Plan: plan, Previous: repairHead, Old: canonical.File, DesiredSize: uint64(len(wanted)), Desired: sha256.Sum256(wanted)}
+		for _, p := range pending {
+			r.Ordinal = p.ordinal
+			b, e := runtimeFreshRecordBytes(r)
+			if e != nil || !r.valid() || !runtimeFreshControlPrefixBytes(p.body, b) {
+				return fail()
+			}
+		}
+	}
+	if len(completions) > 0 && (!present || !bytes.Equal(canonical.Body, wanted) || unarchived || len(pending) > 0) {
+		return fail()
+	}
+	for i, v := range completions {
+		if completion != nil || !check(v) {
+			return fail()
+		}
+		expected := runtimeFreshDenialCompletion{Schema: 1, Ordinal: uint32(i), Plan: plan, Denial: canonical.File, DirectoryHead: directoryHead, RepairHead: repairHead}
+		b, e := runtimeFreshRecordBytes(expected)
+		if e != nil || !expected.valid() {
+			return fail()
+		}
+		if bytes.Equal(v.Body, b) {
+			copy := expected
+			completion = &copy
+		} else if !runtimeFreshControlPrefixBytes(v.Body, b) {
+			return fail()
+		}
+	}
+	return repairHead, last, unarchived, completion, nil
+}
+
+func runtimeFreshDenialNamespaceValid(names []string, seeded, private bool) bool {
+	budget := 49
+	if private {
+		budget = 512
+	}
+	if len(names) > budget {
+		return false
+	}
+	allowed := map[string]bool{runtimeFreshLegacyDenialName: !private}
+	families := []func(uint32) (string, error){runtimeFreshDenialRepairName, runtimeFreshDenialArchiveName, runtimeFreshDenialCompletionName}
+	if private {
+		families = []func(uint32) (string, error){runtimeFreshDenialDirectoryName}
+	}
+	for _, f := range families {
+		for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+			name, _ := f(i)
+			allowed[name] = true
+		}
+	}
+	occupied := map[string]bool{}
+	for _, name := range names {
+		if occupied[name] {
+			return false
+		}
+		occupied[name] = true
+		lower := strings.ToLower(name)
+		reserved := strings.HasPrefix(lower, ".denial-")
+		if private {
+			reserved = strings.HasPrefix(lower, "authority.fresh.denial-")
+		}
+		if !seeded && reserved {
+			return false
+		}
+		if seeded && ((private && reserved) || !private) && !allowed[name] {
+			return false
+		}
+	}
+	if seeded {
+		for _, family := range families {
+			if !private {
+				archive, _ := runtimeFreshDenialArchiveName(0)
+				name, _ := family(0)
+				if name == archive {
+					continue
+				}
+			}
+			gap := false
+			for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+				name, _ := family(i)
+				if !occupied[name] {
+					gap = true
+				} else if gap {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_denial_prefix_test.go b/rdd/pkg/managementconfig/runtime_fresh_denial_prefix_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f55b9c6f53fd3076447310d96f2c6147f766e7c5
--- /dev/null
