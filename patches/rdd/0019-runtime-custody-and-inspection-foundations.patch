+	raw.mu.Lock()
+	if raw.closes != 0 || raw.writes != 0 || raw.deadlines != 1 {
+		t.Fatal("TLS wrapper released raw socket or reset aborted deadline")
+	}
+	raw.mu.Unlock()
+	c := &runtimeUpgradeManagementConnection{guard: guard}
+	if c.closeRawUsing(raw.Close) != nil || c.closeRawUsing(raw.Close) != nil || raw.closes != 1 {
+		t.Fatal("actor raw settlement was not exact-once")
