@@ -0,0 +1,131 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+// Only pre-authority prefixes are described. A failed complete reader is
+// never converted to initialized state or permission to resume its producer.
+func (s *inspectionFreshRecords) denialPrefix(ctx context.Context) runtimeInspectionResult {
+	unknown := inspectionUnknown("partial-record-unsupported")
+	if s.intent.Schema != 2 {
+		return unknown
+	}
+	allowed := map[string]bool{"runtime": true, "setup-logs": true, runtimeFreshFenceName: true}
+	for _, f := range []func(uint32) (string, error){runtimeFreshIntentRepairName, runtimeFreshIntentArchiveName, runtimeFreshDenialDirectoryName} {
+		for i := uint32(0); i < 16; i++ {
+			n, _ := f(i)
+			allowed[n] = true
+		}
+	}
+	for _, n := range s.privateNames {
+		if allowed[n] {
+			continue
+		}
+		if _, e := parseRuntimeFreshSeedName(n); e != nil {
+			return unknown
+		}
+	}
+	publicNames, e := s.o.snapshotDirectory(ctx, s.public)
+	if e != nil {
+		return unknown
+	}
+	for _, n := range publicNames {
+		if n != "setup.lock" && n != "home" {
+			return unknown
+		}
+	}
+	plan := runtimeFreshDenialPlan{Transaction: s.intent.Transaction, Seed: s.intent.Seed, Intent: inspectionFileWitness(s.intentObject, s.intentBody), PrivateParent: inspectionObjectWitness(s.private), PublicParent: inspectionObjectWitness(s.public), Controller: inspectionObjectWitness(s.controller), PrivateDescriptor: s.private.legacy.descriptor, PublicDescriptor: s.public.legacy.descriptor, ControllerDescriptor: s.controller.legacy.descriptor}
+	if !plan.valid() {
+		return unknown
+	}
+	current := runtimeFreshDenialDirectoryRecipe{Schema: 1, Plan: plan}
+	parent := s.public
+	for i := 0; i < runtimeFreshLegacyDirectoryCount; i++ {
+		name, _ := runtimeFreshLegacyDirectoryName(i)
+		v, e := s.o.optional(ctx, parent, name, true, true, false, 0)
+		if e != nil {
+			return unknown
+		}
+		if v == nil {
+			break
+		}
+		current.Prefix[i] = runtimeFreshLegacyDirectoryFact{Object: inspectionObjectWitness(v), Descriptor: v.legacy.descriptor}
+		current.Count++
+		children, e := s.o.snapshotDirectory(ctx, v)
+		if e != nil {
+			return unknown
+		}
+		if i+1 < runtimeFreshLegacyDirectoryCount {
+			next, _ := runtimeFreshLegacyDirectoryName(i + 1)
+			for _, n := range children {
+				if n != next {
+					return unknown
+				}
+			}
+		}
+		parent = v
+	}
+	directory, e := s.family(ctx, s.private, runtimeFreshDenialDirectoryName)
+	if e != nil {
+		return unknown
+	}
+	for _, v := range directory {
+		var r runtimeFreshDenialDirectoryRecipe
+		if parseRuntimeFreshRecord(v.Body, &r) == nil && r.valid() {
+			current.Previous = v.File
+		}
+	}
+	if validateRuntimeFreshDenialDirectoryHistory(directory, current) != nil {
+		return unknown
+	}
+	if current.Count == runtimeFreshLegacyDirectoryCount {
+		names, e := s.o.snapshotDirectory(ctx, parent)
+		if e != nil || !runtimeFreshDenialNamespaceValid(names, true, false) {
+			return unknown
+		}
+		canonical, b, e := s.o.inspectionFragment(ctx, parent, runtimeFreshLegacyDenialName, runtimeFreshLegacyDenialBudget)
+		if e != nil {
+			return unknown
+		}
+		record := runtimeFreshLegacyDenialRecord{Schema: 1, Transaction: s.intent.Transaction, Intent: plan.Intent, Parent: runtimeFreshLegacyDirectoryFact{Object: plan.PublicParent, Descriptor: plan.PublicDescriptor}, Directories: current.Prefix}
+		wanted, e := encodeRuntimeFreshLegacyDenial(record)
+		if e != nil {
+			return unknown
+		}
+		repairs, e := s.family(ctx, parent, runtimeFreshDenialRepairName)
+		if e != nil {
+			return unknown
+		}
+		archives := make([]*runtimeFreshDenialRecipeObservation, runtimeFreshDenialSlots)
+		for i := uint32(0); i < runtimeFreshDenialSlots; i++ {
+			n, _ := runtimeFreshDenialArchiveName(i)
+			v, b, e := s.o.inspectionFragment(ctx, parent, n, runtimeFreshRecordBudget)
+			if e != nil {
+				return unknown
+			}
+			if v != nil {
+				archives[i] = &runtimeFreshDenialRecipeObservation{Body: b, File: inspectionFileWitness(v, b)}
+			}
+		}
+		complete, e := s.family(ctx, parent, runtimeFreshDenialCompletionName)
+		if e != nil {
+			return unknown
+		}
+		obs := runtimeFreshDenialRecipeObservation{}
+		if canonical != nil {
+			obs = runtimeFreshDenialRecipeObservation{Body: b, File: inspectionFileWitness(canonical, b)}
+		}
+		if _, _, _, _, e = validateRuntimeFreshDenialReceiptHistory(plan, wanted, obs, canonical != nil, repairs, archives, complete, current.Previous); e != nil {
+			return unknown
+		}
+	}
+	owned, e := s.o.captureRegistry(ctx)
+	if e != nil {
+		return unknown
+	}
+	if owned {
+		return inspectionObserved("conflict", "namespace-conflict", "unknown", "unknown")
+	}
+	return s.imageResult(ctx, "interrupted-same-image", "uncommitted")
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_entry.go b/rdd/pkg/managementconfig/runtime_inspection_entry.go
new file mode 100644
index 0000000000000000000000000000000000000000..5671366b5451ce6c5bfbd3d23294566dbe6d6a1f
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_inspection_entry.go
@@ -0,0 +1,69 @@
+package managementconfig
+
+import (
+	"context"
+	"io"
+	"time"
+)
+
+// Private DATA sequencing seam. Production always binds the actual native
+// capture through RunNativeRuntimeInspection; no public callback is accepted.
+func runRuntimeInspectionEntry(parent context.Context, input io.Reader, output io.Writer, inspect func(context.Context) (runtimeInspectionResult, error)) error {
+	if parent == nil || parent.Err() != nil || input == nil || output == nil || inspect == nil {
+		return errRuntimeInspection
+	}
+	ctx, cancel := context.WithTimeout(parent, 30*time.Second)
+	defer cancel()
+	request := make(chan error, 1)
+	go func() {
+		request <- func() (err error) {
+			defer func() {
+				if recover() != nil {
+					err = errRuntimeInspection
+				}
+			}()
+			return readRuntimeInspectionRequest(input)
+		}()
+	}()
+	select {
+	case e := <-request:
+		if e != nil {
+			return errRuntimeInspection
+		}
+	case <-ctx.Done():
+		return errRuntimeInspection
+	}
+	result, e := inspect(ctx)
+	if e != nil || ctx.Err() != nil {
+		return errRuntimeInspection
+	}
+	body, e := runtimeInspectionBytes(result)
+	if e != nil {
+		return errRuntimeInspection
+	}
+	// Only immutable DATA survives capture/checked close into this IO task.
+	written := make(chan error, 1)
+	go func() {
+		written <- func() (err error) {
+			defer func() {
+				if recover() != nil {
+					err = errRuntimeInspection
+				}
+			}()
+			n, e := output.Write(body)
+			if e != nil || n != len(body) {
+				return errRuntimeInspection
+			}
+			return nil
+		}()
+	}()
+	select {
+	case e := <-written:
+		if e != nil || ctx.Err() != nil {
+			return errRuntimeInspection
+		}
+		return nil
+	case <-ctx.Done():
+		return errRuntimeInspection
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_entry_contract_test.go b/rdd/pkg/managementconfig/runtime_inspection_entry_contract_test.go
