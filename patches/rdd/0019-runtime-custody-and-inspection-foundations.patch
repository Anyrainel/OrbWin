+func (s *inspectionFreshRecords) imageResult(ctx context.Context, reason, state string) runtimeInspectionResult {
+	if s.o.captureImage(ctx) != nil {
+		return inspectionUnknown("observation-unknown")
+	}
+	if hex.EncodeToString(s.o.selfHash[:]) != s.intent.Image {
+		return inspectionObserved("unsupported-version", "different-image", state, "different")
+	}
+	if s.o.selfCommit != s.intent.Commit {
+		return inspectionObserved("unsupported-version", "different-source", state, "different")
+	}
+	return inspectionObserved("interrupted", reason, state, "same")
+}
