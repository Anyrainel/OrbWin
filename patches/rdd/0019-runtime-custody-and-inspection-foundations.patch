+	}
+	name, _ := runtimeFreshControlRetainedName(a.Transaction)
+	old, e := s.o.open(ctx, s.private, name, true, true, false, 0)
+	if e != nil || inspectionObjectWitness(old) != r.OldAuthority || old.legacy.descriptor != r.OldDescriptor {
+		return ErrUpgrade
+	}
+	if s.checkControlInventory(ctx, r, old) != nil {
+		return ErrUpgrade
+	}
+
+	gap = false
+	found := false
+	for i := uint32(0); i < runtimeFreshControlSlots; i++ {
+		n, _ := runtimeFreshControlBirthName(i)
+		v, b, e := s.o.inspectionFragment(ctx, s.private, n, runtimeFreshRecordBudget)
+		if e != nil {
+			return ErrUpgrade
+		}
+		if v == nil {
+			gap = true
+			continue
+		}
+		if gap || found {
+			return ErrUpgrade
+		}
+		birth := runtimeFreshControlBirth{Schema: 1, Transaction: a.Transaction, Ordinal: i, Retention: inspectionFileWitness(record, recordBody), Authority: a.Authority, Descriptor: current.legacy.descriptor}
+		wanted, e := runtimeFreshRecordBytes(birth)
+		if e != nil || !runtimeFreshControlPrefixBytes(b, wanted) {
+			return ErrUpgrade
+		}
+		if bytes.Equal(b, wanted) {
+			if !birth.matches(r, a.ControlRetention, inspectionObjectWitness(current), current.legacy.descriptor) || inspectionFileWitness(v, b) != a.ControlBirth {
+				return ErrUpgrade
+			}
+			found = true
+		}
+	}
+	if !found {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *inspectionFreshRecords) checkControlInventory(ctx context.Context, r runtimeFreshControlRetention, old *inspectionNativeObject) error {
+	init, e := initializationBytes(r.Args)
+	if e != nil {
+		return ErrUpgrade
+	}
+	lock, e := s.o.open(ctx, old, "authority.owner.lock", false, true, false, 0)
+	if e != nil || inspectionObjectWitness(lock) != r.OldOwnerLock || lock.legacy.descriptor != r.OwnerDescriptor || lock.legacy.size != 0 {
+		return ErrUpgrade
+	}
+	children, e := s.o.snapshotDirectory(ctx, old)
+	if e != nil || len(children) != len(r.Inventory)+1 {
+		return ErrUpgrade
+	}
+	expected := map[string]bool{"authority.owner.lock": true}
+	roles := map[string]string{"tls": "tls", "db": "db", "args": "args.json", "init": "authority.init"}
+	for _, f := range r.Inventory {
+		n := roles[f.Role]
+		expected[n] = true
+		access := uint32(windows.FILE_READ_DATA)
+		if f.Directory {
+			access = 0
+		}
+		v, e := s.o.open(ctx, old, n, f.Directory, true, false, access)
+		if e != nil || inspectionObjectWitness(v) != f.Object || v.legacy.descriptor != f.Descriptor || v.legacy.size != f.Size {
+			return ErrUpgrade
+		}
+		if f.Directory {
+			ns, e := s.o.snapshotDirectory(ctx, v)
+			if e != nil || len(ns) != 0 {
+				return ErrUpgrade
+			}
+		} else {
+			var b []byte
+			if v.legacy.size == 0 {
+				if s.o.checkObject(ctx, v) != nil {
+					return ErrUpgrade
+				}
+			} else {
+				b, e = s.o.read(ctx, v, runtimeFreshRecordBudget)
+			}
+			wanted := r.Args
+			if f.Role == "init" {
+				wanted = init
+			}
+			if e != nil || sha256.Sum256(b) != f.Body || !runtimeFreshControlPrefixBytes(b, wanted) {
+				return ErrUpgrade
+			}
+		}
+	}
+	for _, n := range children {
+		if !expected[n] {
+			return ErrUpgrade
+		}
+		delete(expected, n)
+	}
+	if len(expected) != 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/runtime_inspection_seeded_windows_test.go b/rdd/pkg/managementconfig/runtime_inspection_seeded_windows_test.go
