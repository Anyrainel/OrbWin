+}
+
+func TestRuntimeUpgradeManagementTCPPeerPID(t *testing.T) {
+	for _, family := range []uint8{4, 6} {
+		t.Run(strconv.Itoa(int(family)), func(t *testing.T) {
+			local := netip.MustParseAddrPort("127.0.0.2:54001")
+			remote := netip.MustParseAddrPort("127.0.0.1:6443")
+			base := upgradeTCPRow{family: family, address: [16]byte{127, 0, 0, 1}, port: 6443, remoteAddress: [16]byte{127, 0, 0, 2}, remotePort: 54001, pid: 123, state: 5}
+			if family == 6 {
+				local = netip.MustParseAddrPort("[fe80::2%11]:54001")
+				remote = netip.MustParseAddrPort("[fe80::1%7]:6443")
+				base.address, base.scope = remote.Addr().As16(), 7
+				base.remoteAddress, base.remoteScope = local.Addr().As16(), 11
+			}
+			if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{base}, local, remote, 123); err != nil {
+				t.Fatal("exact native peer refused", err)
+			}
+			for name, change := range map[string]func(*upgradeTCPRow){
+				"foreign PID":    func(row *upgradeTCPRow) { row.pid++ },
+				"listener":       func(row *upgradeTCPRow) { row.state = 2 },
+				"closing":        func(row *upgradeTCPRow) { row.state = 8 },
+				"family":         func(row *upgradeTCPRow) { row.family = 10 },
+				"server address": func(row *upgradeTCPRow) { row.address[0] ^= 1 },
+				"client address": func(row *upgradeTCPRow) { row.remoteAddress[0] ^= 1 },
+				"server scope":   func(row *upgradeTCPRow) { row.scope++ },
+				"client scope":   func(row *upgradeTCPRow) { row.remoteScope++ },
+				"server port":    func(row *upgradeTCPRow) { row.port++ },
+				"client port":    func(row *upgradeTCPRow) { row.remotePort++ },
+			} {
+				t.Run(name, func(t *testing.T) {
+					row := base
+					change(&row)
+					if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{row}, local, remote, 123); err == nil {
+						t.Fatal("changed native peer accepted")
+					}
+				})
+			}
+			for name, rows := range map[string][]upgradeTCPRow{
+				"absent":          nil,
+				"duplicate":       {base, base},
+				"competing owner": {base, func() upgradeTCPRow { row := base; row.pid++; return row }()},
+			} {
+				t.Run(name, func(t *testing.T) {
+					if err := runtimeUpgradeManagementTCPPeerPID(rows, local, remote, 123); err == nil {
+						t.Fatal("absent or ambiguous peer accepted")
+					}
+				})
+			}
+			unrelated := base
+			unrelated.remotePort++
+			listener := base
+			listener.state = 2
+			if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{unrelated, listener, base}, local, remote, 123); err != nil {
+				t.Fatal("unrelated rows prevented exact peer match", err)
+			}
+			if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{base}, remote, local, 123); err == nil {
+				t.Fatal("non-reversed client row accepted")
+			}
+			for _, invalid := range []netip.AddrPort{{}, netip.AddrPortFrom(local.Addr(), 0), netip.MustParseAddrPort("[fe80::2%interface-name]:54001")} {
+				if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{base}, invalid, remote, 123); err == nil {
+					t.Fatal("invalid native endpoint accepted")
+				}
+			}
+			if err := runtimeUpgradeManagementTCPPeerPID([]upgradeTCPRow{base}, local, remote, 0); err == nil {
+				t.Fatal("absent held PID accepted")
+			}
+		})
+	}
+}
