+)
+
+const (
+	runtimeUpgradeManagementAppPath    = "/apis/app.rancherdesktop.io/v1alpha1/apps/app"
+	runtimeUpgradeManagementVMPrefix   = "/apis/lima.rancherdesktop.io/v1alpha1/namespaces/"
+	runtimeUpgradeManagementVMSuffix   = "/limavms/orbwin"
+	runtimeUpgradeManagementBodyBudget = 512 << 10
+	runtimeUpgradeManagementWireBudget = 1 << 20
+)
+
+// These private projections are authenticated response DATA only. They contain
+// no HOME, Stop, retirement or native authority. A cross-resource read is not an
+// atomic/current snapshot; both App resource versions are retained separately.
+type runtimeUpgradeManagementApp struct {
+	uid, resourceVersion, namespace string
+	generation                      int64
+	running                         bool
+	spec, status                    []byte
+}
+type runtimeUpgradeManagementVM struct {
+	uid, resourceVersion, namespace, appUID string
+	generation                              int64
+	running                                 bool
+	spec, status                            []byte
+}
+type runtimeUpgradeManagementState struct {
+	appUID, appResourceVersion, appResourceVersionAfter, namespace string
+	vmUID, vmResourceVersion                                       string
+	appGeneration, vmGeneration                                    int64
+	desiredRunning, vmDesiredRunning                               bool
+	appSpec, appStatus, vmSpec, vmStatus                           []byte
+}
+
+// Each successful parse/clone transfers its encoded byte buffers to its caller.
+// Clear applies to those owned buffers, not parser maps/immutable Go strings.
+func (a *runtimeUpgradeManagementApp) clear() {
+	clear(a.spec)
+	clear(a.status)
+	*a = runtimeUpgradeManagementApp{}
+}
+func (a runtimeUpgradeManagementApp) clone() (out runtimeUpgradeManagementApp) {
+	out = a
+	out.spec, out.status = nil, nil
+	complete := false
+	defer func() {
+		if !complete {
+			out.clear()
+		}
+	}()
+	out.spec = bytes.Clone(a.spec)
+	out.status = bytes.Clone(a.status)
+	complete = true
+	return out
+}
+func (v *runtimeUpgradeManagementVM) clear() {
+	clear(v.spec)
+	clear(v.status)
+	*v = runtimeUpgradeManagementVM{}
+}
+func (v runtimeUpgradeManagementVM) clone() (out runtimeUpgradeManagementVM) {
+	out = v
+	out.spec, out.status = nil, nil
+	complete := false
+	defer func() {
+		if !complete {
+			out.clear()
+		}
+	}()
+	out.spec = bytes.Clone(v.spec)
+	out.status = bytes.Clone(v.status)
+	complete = true
+	return out
+}
+func (s *runtimeUpgradeManagementState) clear() {
+	clear(s.appSpec)
+	clear(s.appStatus)
+	clear(s.vmSpec)
+	clear(s.vmStatus)
+	*s = runtimeUpgradeManagementState{}
+}
+func (s runtimeUpgradeManagementState) clone() (out runtimeUpgradeManagementState) {
+	out = s
+	out.appSpec, out.appStatus, out.vmSpec, out.vmStatus = nil, nil, nil, nil
+	complete := false
+	defer func() {
+		if !complete {
+			out.clear()
+		}
+	}()
+	out.appSpec = bytes.Clone(s.appSpec)
+	out.appStatus = bytes.Clone(s.appStatus)
+	out.vmSpec = bytes.Clone(s.vmSpec)
+	out.vmStatus = bytes.Clone(s.vmStatus)
+	complete = true
+	return out
+}
+
+func (runtimeUpgradeManagementApp) String() string   { return "private management App DATA" }
+func (runtimeUpgradeManagementApp) GoString() string { return "private management App DATA" }
+func (runtimeUpgradeManagementVM) String() string    { return "private management VM DATA" }
+func (runtimeUpgradeManagementVM) GoString() string  { return "private management VM DATA" }
+func (runtimeUpgradeManagementState) String() string { return "private authenticated management DATA" }
+func (runtimeUpgradeManagementState) GoString() string {
+	return "private authenticated management DATA"
+}
+
+func runtimeUpgradeManagementNamespace(s string) bool {
+	if len(s) == 0 || len(s) > 63 || s[0] == '-' || s[len(s)-1] == '-' {
+		return false
+	}
+	for _, c := range []byte(s) {
+		if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+// Inspect decoded keys before extracting fields: ordinary struct decoding would
+// accept duplicate/case-folded keys. Unrelated bounded upstream fields survive.
+func runtimeUpgradeManagementJSON(body []byte) (map[string]any, error) {
+	if len(body) == 0 || len(body) > runtimeUpgradeManagementBodyBudget || !runtimeIdentityUnicode(body) {
+		return nil, ErrUpgrade
+	}
+	d := json.NewDecoder(bytes.NewReader(body))
+	d.UseNumber()
+	nodes := 0
+	var read func(int) (any, error)
+	read = func(depth int) (any, error) {
+		nodes++
+		if depth > 32 || nodes > 8192 {
+			return nil, ErrUpgrade
+		}
+		token, err := d.Token()
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		switch token {
+		case json.Delim('{'):
+			m := map[string]any{}
+			for d.More() {
+				key, e := d.Token()
+				name, ok := key.(string)
+				if e != nil || !ok || len(name) > 1024 {
+					return nil, ErrUpgrade
+				}
+				if _, exists := m[name]; exists {
+					return nil, ErrUpgrade
+				}
+				value, e := read(depth + 1)
+				if e != nil {
+					return nil, e
+				}
+				m[name] = value
+			}
+			if end, e := d.Token(); e != nil || end != json.Delim('}') {
+				return nil, ErrUpgrade
+			}
+			return m, nil
+		case json.Delim('['):
+			list := []any{}
+			for d.More() {
+				value, e := read(depth + 1)
+				if e != nil {
+					return nil, e
+				}
+				list = append(list, value)
+			}
+			if end, e := d.Token(); e != nil || end != json.Delim(']') {
+				return nil, ErrUpgrade
+			}
+			return list, nil
+		default:
+			switch token.(type) {
+			case nil, string, bool, json.Number:
+				return token, nil
+			default:
+				return nil, ErrUpgrade
+			}
+		}
+	}
+	value, err := read(0)
+	root, ok := value.(map[string]any)
+	if err != nil || !ok {
+		return nil, ErrUpgrade
+	}
+	if _, e := d.Token(); e != io.EOF {
+		return nil, ErrUpgrade
+	}
+	return root, nil
+}
+
+func runtimeUpgradeManagementFields(m map[string]any, consumed ...string) bool {
+	for key := range m {
+		for _, want := range consumed {
+			if key != want && strings.EqualFold(key, want) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func runtimeUpgradeManagementMetadata(root map[string]any, api, kind, name, namespace string) (map[string]any, string, string, int64, error) {
+	if !runtimeUpgradeManagementFields(root, "apiVersion", "kind", "metadata", "spec", "status") || root["apiVersion"] != api || root["kind"] != kind {
+		return nil, "", "", 0, ErrUpgrade
+	}
+	m, ok := root["metadata"].(map[string]any)
+	if !ok || !runtimeUpgradeManagementFields(m, "name", "namespace", "uid", "resourceVersion", "generation", "deletionTimestamp", "ownerReferences") || m["name"] != name {
+		return nil, "", "", 0, ErrUpgrade
+	}
+	if value, present := m["namespace"]; present {
+		if value != namespace {
+			return nil, "", "", 0, ErrUpgrade
+		}
+	} else if namespace != "" {
+		return nil, "", "", 0, ErrUpgrade
+	}
+	if value, present := m["deletionTimestamp"]; present && value != nil {
+		return nil, "", "", 0, ErrUpgrade
+	}
+	uid, uidOK := m["uid"].(string)
+	rv, rvOK := m["resourceVersion"].(string)
+	g, genOK := m["generation"].(json.Number)
+	generation, err := strconv.ParseInt(string(g), 10, 64)
+	if !uidOK || !rvOK || !genOK || !upgradeASCII(uid, 128) || !upgradeASCII(rv, 128) || err != nil || generation < 1 {
+		return nil, "", "", 0, ErrUpgrade
+	}
+	return m, uid, rv, generation, nil
+}
+
+func runtimeUpgradeManagementSpecStatus(root map[string]any) (map[string]any, []byte, []byte, error) {
+	spec, ok := root["spec"].(map[string]any)
+	if !ok {
+		return nil, nil, nil, ErrUpgrade
+	}
+	var encoded, status []byte
+	complete := false
+	defer func() {
+		if !complete {
+			clear(encoded)
+			clear(status)
+		}
+	}()
+	encoded, err := json.Marshal(spec)
+	if err != nil {
+		return nil, nil, nil, ErrUpgrade
+	}
+	if value, present := root["status"]; present {
+		m, ok := value.(map[string]any)
+		if !ok {
+			return nil, nil, nil, ErrUpgrade
+		}
+		status, err = json.Marshal(m)
+		if err != nil {
+			return nil, nil, nil, ErrUpgrade
+		}
+	}
+	complete = true
+	return spec, encoded, status, nil
+}
+
+func parseRuntimeUpgradeManagementApp(body []byte) (runtimeUpgradeManagementApp, error) {
+	root, err := runtimeUpgradeManagementJSON(body)
+	if err != nil {
+		return runtimeUpgradeManagementApp{}, err
+	}
+	_, uid, rv, generation, err := runtimeUpgradeManagementMetadata(root, "app.rancherdesktop.io/v1alpha1", "App", "app", "")
+	if err != nil {
+		return runtimeUpgradeManagementApp{}, err
+	}
+	spec, encoded, status, err := runtimeUpgradeManagementSpecStatus(root)
+	complete := false
+	defer func() {
+		if !complete {
+			clear(encoded)
+			clear(status)
+		}
+	}()
+	if err != nil || !runtimeUpgradeManagementFields(spec, "running", "namespace") {
+		return runtimeUpgradeManagementApp{}, ErrUpgrade
+	}
+	running, ok := spec["running"].(bool)
+	if !ok {
+		return runtimeUpgradeManagementApp{}, ErrUpgrade
+	}
+	namespace := "default"
+	if value, present := spec["namespace"]; present {
+		text, ok := value.(string)
+		if !ok {
+			return runtimeUpgradeManagementApp{}, ErrUpgrade
+		}
+		if text != "" {
+			namespace = text
+		}
+	}
+	if !runtimeUpgradeManagementNamespace(namespace) {
+		return runtimeUpgradeManagementApp{}, ErrUpgrade
+	}
+	complete = true
+	return runtimeUpgradeManagementApp{uid: uid, resourceVersion: rv, generation: generation, namespace: namespace, running: running, spec: encoded, status: status}, nil
+}
+
+func runtimeUpgradeManagementVMPath(app runtimeUpgradeManagementApp) (string, error) {
+	if !upgradeASCII(app.uid, 128) || !runtimeUpgradeManagementNamespace(app.namespace) {
+		return "", ErrUpgrade
+	}
+	return runtimeUpgradeManagementVMPrefix + app.namespace + runtimeUpgradeManagementVMSuffix, nil
+}
+
+func parseRuntimeUpgradeManagementVM(body []byte, app runtimeUpgradeManagementApp) (runtimeUpgradeManagementVM, error) {
+	if _, err := runtimeUpgradeManagementVMPath(app); err != nil {
+		return runtimeUpgradeManagementVM{}, err
+	}
+	root, err := runtimeUpgradeManagementJSON(body)
+	if err != nil {
+		return runtimeUpgradeManagementVM{}, err
+	}
+	metadata, uid, rv, generation, err := runtimeUpgradeManagementMetadata(root, "lima.rancherdesktop.io/v1alpha1", "LimaVM", "orbwin", app.namespace)
+	if err != nil {
+		return runtimeUpgradeManagementVM{}, err
+	}
+	owners, ok := metadata["ownerReferences"].([]any)
+	if !ok || len(owners) == 0 || len(owners) > 16 {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	controllers := 0
+	for _, value := range owners {
+		owner, ok := value.(map[string]any)
+		if !ok || !runtimeUpgradeManagementFields(owner, "apiVersion", "kind", "name", "uid", "controller") {
+			return runtimeUpgradeManagementVM{}, ErrUpgrade
+		}
+		controller := false
+		if value, present := owner["controller"]; present {
+			controller, ok = value.(bool)
+			if !ok {
+				return runtimeUpgradeManagementVM{}, ErrUpgrade
+			}
+		}
+		if controller {
+			controllers++
+			if owner["apiVersion"] != "app.rancherdesktop.io/v1alpha1" || owner["kind"] != "App" || owner["name"] != "app" || owner["uid"] != app.uid {
+				return runtimeUpgradeManagementVM{}, ErrUpgrade
+			}
+		}
+	}
+	if controllers != 1 {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	spec, encoded, status, err := runtimeUpgradeManagementSpecStatus(root)
+	complete := false
+	defer func() {
+		if !complete {
+			clear(encoded)
+			clear(status)
+		}
+	}()
+	if err != nil || !runtimeUpgradeManagementFields(spec, "running", "templateRef") {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	running, ok := spec["running"].(bool)
+	if !ok {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	template, ok := spec["templateRef"].(map[string]any)
+	if !ok || !runtimeUpgradeManagementFields(template, "name", "namespace") || template["name"] != "rd" {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	if value, present := template["namespace"]; present && value != "" && value != app.namespace {
+		return runtimeUpgradeManagementVM{}, ErrUpgrade
+	}
+	complete = true
+	return runtimeUpgradeManagementVM{uid: uid, resourceVersion: rv, generation: generation, namespace: app.namespace, appUID: app.uid, running: running, spec: encoded, status: status}, nil
+}
+
+func composeRuntimeUpgradeManagementState(before, after runtimeUpgradeManagementApp, vm runtimeUpgradeManagementVM) (runtimeUpgradeManagementState, error) {
+	if !upgradeASCII(before.uid, 128) || before.uid != after.uid || before.generation != after.generation || before.running != after.running || before.namespace != after.namespace || !bytes.Equal(before.spec, after.spec) || vm.appUID != before.uid || vm.namespace != before.namespace || !upgradeASCII(vm.uid, 128) || !upgradeASCII(before.resourceVersion, 128) || !upgradeASCII(after.resourceVersion, 128) || !upgradeASCII(vm.resourceVersion, 128) {
+		return runtimeUpgradeManagementState{}, ErrUpgrade
+	}
+	borrowed := runtimeUpgradeManagementState{appUID: before.uid, appGeneration: before.generation, appResourceVersion: before.resourceVersion, appResourceVersionAfter: after.resourceVersion, namespace: before.namespace, vmUID: vm.uid, vmGeneration: vm.generation, vmResourceVersion: vm.resourceVersion, desiredRunning: before.running, vmDesiredRunning: vm.running, appSpec: before.spec, appStatus: after.status, vmSpec: vm.spec, vmStatus: vm.status}
+	return borrowed.clone(), nil
+}
+
+type runtimeUpgradeManagementBudgetReader struct {
+	source    io.Reader
+	remaining int
+}
+
+func (r *runtimeUpgradeManagementBudgetReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if r.remaining == 0 {
+		return 0, ErrUpgrade
+	}
+	if len(p) > r.remaining {
+		p = p[:r.remaining]
+	}
+	n, err := r.source.Read(p)
+	if n < 0 || n > len(p) {
+		return 0, ErrUpgrade
+	}
+	r.remaining -= n
+	return n, err
+}
+
+// One fixed HTTP/1.1 exchange on an already-owned, verified TLS connection.
+// The native caller owns deadlines, cancellation/join, peer/tuple rechecks and
+// the sole checked raw Close. This helper never dials, retries or closes it.
+// Library header/string temporaries are not claimed to be perfectly zeroized.
+func runtimeUpgradeManagementExchange(connection io.ReadWriter, endpoint string, token []byte, path string) (result []byte, failure error) {
+	if connection == nil || !runtimeUpgradeToken(string(token)) {
+		return nil, ErrUpgrade
+	}
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "https" || u.Hostname() != "127.0.0.1" || u.User != nil || u.Path != "" || u.RawPath != "" || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.RawFragment != "" || u.Opaque != "" {
+		return nil, ErrUpgrade
+	}
+	port, err := strconv.ParseUint(u.Port(), 10, 16)
+	if err != nil || port == 0 || u.Host != "127.0.0.1:"+strconv.FormatUint(port, 10) || endpoint != "https://"+u.Host {
+		return nil, ErrUpgrade
+	}
+	if path != runtimeUpgradeManagementAppPath {
+		if !strings.HasPrefix(path, runtimeUpgradeManagementVMPrefix) || !strings.HasSuffix(path, runtimeUpgradeManagementVMSuffix) {
+			return nil, ErrUpgrade
+		}
+		namespace := strings.TrimSuffix(strings.TrimPrefix(path, runtimeUpgradeManagementVMPrefix), runtimeUpgradeManagementVMSuffix)
+		if !runtimeUpgradeManagementNamespace(namespace) {
+			return nil, ErrUpgrade
+		}
+	}
+	u.Path = path
+	request := &http.Request{Method: http.MethodGet, URL: u, Host: u.Host, Proto: "HTTP/1.1", ProtoMajor: 1, ProtoMinor: 1, Header: http.Header{"Authorization": {"Bearer " + string(token)}, "Accept": {"application/json"}, "Accept-Encoding": {"identity"}, "Connection": {"keep-alive"}}}
+	var outgoing bytes.Buffer
+	defer func() { clear(outgoing.Bytes()) }()
+	if request.Write(&outgoing) != nil || outgoing.Len() > 8<<10 {
+		return nil, ErrUpgrade
+	}
+	if n, err := connection.Write(outgoing.Bytes()); err != nil || n != outgoing.Len() {
+		return nil, ErrUpgrade
+	}
+	reader := bufio.NewReaderSize(&runtimeUpgradeManagementBudgetReader{source: connection, remaining: runtimeUpgradeManagementWireBudget}, 4096)
+	response, err := http.ReadResponse(reader, request)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	// On refusal the native caller settles the sole raw socket. Body.Close
+	// could drain rejected data; it is checked only after framed EOF below.
+	contentTypes := response.Header.Values("Content-Type")
+	encodings := response.Header.Values("Content-Encoding")
+	if response.ProtoMajor != 1 || response.ProtoMinor != 1 || response.StatusCode != http.StatusOK || response.Close || response.Uncompressed || len(contentTypes) != 1 || len(encodings) > 1 || len(encodings) == 1 && encodings[0] != "" && encodings[0] != "identity" {
+		return nil, ErrUpgrade
+	}
+	contentType, _, err := mime.ParseMediaType(contentTypes[0])
+	if err != nil || contentType != "application/json" || response.ContentLength > runtimeUpgradeManagementBodyBudget || response.ContentLength < 0 && (len(response.TransferEncoding) != 1 || response.TransferEncoding[0] != "chunked") {
+		return nil, ErrUpgrade
+	}
+	body := make([]byte, runtimeUpgradeManagementBodyBudget+1)
+	complete := false
+	defer func() {
+		if !complete {
+			clear(body)
+			result = nil
+		}
+	}()
+	at := 0
+	for {
+		n, err := response.Body.Read(body[at:])
+		if n < 0 || n > len(body)-at {
+			return nil, ErrUpgrade
+		}
+		at += n
+		if at > runtimeUpgradeManagementBodyBudget || err != nil && err != io.EOF || n == 0 && err == nil {
+			return nil, ErrUpgrade
+		}
+		if err == io.EOF {
+			break
+		}
+	}
+	if response.Body.Close() != nil || reader.Buffered() != 0 {
+		return nil, ErrUpgrade
+	}
+	complete = true
+	return body[:at], nil
+}
