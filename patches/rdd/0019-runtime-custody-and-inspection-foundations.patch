--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_volume_open.go
@@ -0,0 +1,14 @@
+package managementconfig
+
+// Synchronous Win32 CreateFile's HANDLE is the success discriminator. The
+// successful call's LastError is undefined DATA and must never veto success.
+// INVALID_HANDLE_VALUE is the documented failure sentinel; zero is unexpected.
+func runtimeFreshClassifyVolumeOpen(raw uintptr, code uint32, errorKnown bool) runtimeStorageNativeOpenReply {
+	if runtimeStorageRealWin32Output(raw) {
+		return runtimeStorageNativeOpenSuccess
+	}
+	if raw == ^uintptr(0) && errorKnown && code != 0 && code != 997 && code != 996 {
+		return runtimeStorageNativeOpenFailure
+	}
+	return runtimeStorageNativeOpenUnknown
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_volume_open_test.go b/rdd/pkg/managementconfig/runtime_fresh_volume_open_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cad4d17e8af67646293b4f86a44c26a68573c3aa
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_volume_open_test.go
@@ -0,0 +1,49 @@
+package managementconfig
+
+import "testing"
+
+func TestRuntimeFreshVolumeWin32SentinelAndPending(t *testing.T) {
+	invalid := ^uintptr(0)
+	for _, code := range []uint32{0, 2, 3, 5, 996, 997, 0xffffffff} {
+		for _, known := range []bool{false, true} {
+			if runtimeFreshClassifyVolumeOpen(0, code, known) != runtimeStorageNativeOpenUnknown {
+				t.Fatal("zero Win32 output became absence", code, known)
+			}
+			want := runtimeStorageNativeOpenUnknown
+			if known && code != 0 && code != 997 && code != 996 {
+				want = runtimeStorageNativeOpenFailure
+			}
+			if runtimeFreshClassifyVolumeOpen(invalid, code, known) != want {
+				t.Fatal("failure sentinel", code, known)
+			}
+		}
+	}
+	for _, raw := range []uintptr{1, 42, uintptr(1)<<32 | 42} {
+		for _, stale := range []uint32{0, 5, 997, 0xffffffff} {
+			if runtimeFreshClassifyVolumeOpen(raw, stale, false) != runtimeStorageNativeOpenSuccess {
+				t.Fatal("successful LastError interpreted", raw, stale)
+			}
+		}
+	}
+}
+func TestRuntimeFreshVolumeUnknownNeverEnablesDependentCreate(t *testing.T) {
+	for _, tc := range []struct {
+		raw   uintptr
+		code  uint32
+		known bool
+	}{{0, 2, true}, {^uintptr(0), 997, true}, {^uintptr(0), 0, true}, {^uintptr(0), 5, false}} {
+		state := runtimeStorageNativeOpenState{entered: true}
+		kind := runtimeFreshClassifyVolumeOpen(tc.raw, tc.code, tc.known)
+		if kind != runtimeStorageNativeOpenUnknown || state.reply(kind) || !state.unknown || state.attach() || state.usable() {
+			t.Fatal("pending/partial reached dependent effect", tc, state)
+		}
+	}
+	// Native failure status must retain its original interpretation before the
+	// existing fixed final-boundary absence sequence can choose any CREATE.
+	if runtimeStorageClassifyNativeOpen(0x103, 0, 0, 1, false, false) != runtimeStorageNativeOpenUnknown || runtimeStorageClassifyNativeOpen(0xc0000034, 0x103, 0, 1, false, false) != runtimeStorageNativeOpenUnknown {
+		t.Fatal("NT pending became absence")
+	}
+	if runtimeStorageClassifyNativeOpen(0, 0, 1, 2, true, true) != runtimeStorageNativeOpenUnknown || runtimeStorageClassifyNativeOpen(0, 0, 2, 1, true, true) != runtimeStorageNativeOpenUnknown {
+		t.Fatal("wrong NT create/open disposition")
+	}
+}
