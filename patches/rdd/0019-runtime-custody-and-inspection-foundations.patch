+// Called only by the original fresh publisher before its live witness closes.
+// The observer's registry children were closed; acquire independent actual
+// selected-key and disk capabilities instead of copying its observations.
+func (o *FreshSetupOwner) captureManagedNamespaceBeforeSealLocked(ctx context.Context) (result error) {
+	w := o.observation
+	if w == nil || o.created == nil || o.storage == nil || o.image == nil {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	p := w.publisher
+	if p == nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !w.complete || w.closed || w.unknown || !w.exactLocked(o, o.created, p) || w.checkParentsLocked(ctx) != nil || w.peerProcess == nil || len(w.directories) != 4 {
+		return ErrUpgrade
+	}
+	c := o.created
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	a, e := c.managedAuthority.exact()
+	if e != nil || a.image != o.image || a.publisher != p || a.created != c {
+		return ErrUpgrade
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if !a.admitted() || !a.controllersStarted || a.capturing != 0 || c.managedNamespace != nil {
+		return ErrUpgrade
+	}
+	cap := &ManagedRuntimeNamespace{}
+	n := &nativeManagedNamespace{self: cap, created: c, authority: a, sid: o.storage.sid, home: o.storage.home, activated: true}
+	cap.native = n
+	c.managedNamespace = cap
+	defer func() {
+		if recover() != nil {
+			result = ErrUpgrade
+		}
+		if result != nil {
+			n.fence()
+		}
+	}()
+	o.storage.mu.Lock()
+	defer o.storage.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if !o.nativeOutputsAdmittedLocked() || o.storage.checkToken() != nil || n.capture(ctx, w.directories[0], o.storage.token) != nil || n.shape != runtimeFreshGuestRegistered || n.guid != w.guid || n.recheckRegistered(ctx) != nil {
+		return ErrUpgrade
+	}
+	for i, d := range w.directories {
+		if d == nil || d.identity != n.directories[i].identity {
+			return ErrUpgrade
+		}
+	}
+	for _, b := range a.births {
+		if b == nil || b.self != b {
+			return ErrUpgrade
+		}
+		b.mu.Lock()
+		match := b.complete && !b.unknown && !b.closeAttempt.attempted && b.parent == o.image && b.pid == w.api.HostPID && b.creation == w.api.HostCreation && b.session == w.api.HostSession && b.process != nil && b.process.handle != 0
+		if match {
+			match = b.binding.same() == nil && w.peerBinding.same() == nil
+		}
+		b.mu.Unlock()
+		if match {
+			if n.peer != nil {
+				return ErrUpgrade
+			}
+			n.peer = b
+		}
+	}
+	if n.peer == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
