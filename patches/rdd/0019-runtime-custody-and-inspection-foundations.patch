+			v := r
+			v.Ordinal = partial.ordinal
+			b, e := runtimeFreshRecordBytes(v)
+			if e != nil || !runtimeFreshControlPrefixBytes(partial.body, b) {
+				return h, ErrUpgrade
+			}
+		}
+		pending = nil
+		old := archive
+		oldBody := []byte(nil)
