+// Actual typed lifetime only, never an authority lookup or output-frame cache.
+const datastoreCleanupOwnerLimit = 32
+
+type datastoreCleanupIssuance uint8
+
+const (
+	datastoreCleanupCreated datastoreCleanupIssuance = iota + 1
+	datastoreCleanupReaped
+)
+
+var datastoreCleanupOwners = struct {
+	sync.Mutex
+	owners map[*DatastoreGeneration]struct{}
+}{owners: map[*DatastoreGeneration]struct{}{}}
+
+func holdDatastoreCleanup(g *DatastoreGeneration) bool {
+	if g == nil || g.self != g {
+		return false
+	}
+	datastoreCleanupOwners.Lock()
+	defer datastoreCleanupOwners.Unlock()
+	if _, present := datastoreCleanupOwners.owners[g]; present {
+		return true
+	}
+	if len(datastoreCleanupOwners.owners) >= datastoreCleanupOwnerLimit {
+		return false
+	}
+	datastoreCleanupOwners.owners[g] = struct{}{}
+	return true
+}
+func (g *DatastoreGeneration) exactCleanup() bool {
+	if g == nil || g.self != g || g.unknown || g.released.Load() {
+		return false
+	}
+	if g.owner != nil {
+		if g.issuance != datastoreCleanupCreated || g.issuer != nil || g.owner.datastoreGeneration != g {
+			return false
+		}
+	} else {
+		if g.issuance != datastoreCleanupReaped || g.issuer == nil || g.issuer.self != g.issuer || g.reapName == "" {
+			return false
+		}
+		present := false
+		for _, c := range g.issuer.children {
+			if c == g {
+				present = true
+			}
+		}
+		if !present {
+			return false
+		}
+	}
+	datastoreCleanupOwners.Lock()
+	_, present := datastoreCleanupOwners.owners[g]
+	datastoreCleanupOwners.Unlock()
+	return present
+}
+func (g *DatastoreGeneration) failCleanup() error {
+	g.unknown = true
+	g.cleanupError = ErrPublication
+	if g.owner != nil {
+		g.owner.datastoreActive.Store(true)
+	}
+	if g.issuer != nil {
+		g.issuer.unknown = true
+	}
+	return ErrPublication
+}
+func (g *DatastoreGeneration) releaseCleanup() {
+	g.released.Store(true)
+	datastoreCleanupOwners.Lock()
+	delete(datastoreCleanupOwners.owners, g)
+	datastoreCleanupOwners.Unlock()
+}
+func (g *DatastoreGeneration) childrenReleased() bool {
+	for _, c := range g.children {
+		if c == nil || !c.released.Load() {
+			return false
+		}
+	}
+	return true
+}
+func datastoreCleanupCaller() (string, error) {
+	if _, e := windows.GetCurrentThreadToken().GetTokenUser(); e != windows.ERROR_NO_TOKEN {
+		return "", ErrPublication
+	}
+	token := windows.GetCurrentProcessToken()
+	user, e := token.GetTokenUser()
+	if e != nil || user == nil || user.User.Sid == nil || !user.User.Sid.IsValid() {
+		return "", ErrPublication
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 {
+		return "", ErrPublication
+	}
+	return user.User.Sid.String(), nil
+}
