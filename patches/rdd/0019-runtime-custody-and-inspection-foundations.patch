+func TestManagedNamespaceRejectsCopiedWrapperAndUnboundedEntry(t *testing.T) {
+	c := &Created{}
+	original := &ManagedRuntimeNamespace{}
+	n := &nativeManagedNamespace{self: original, created: c}
+	original.native, c.managedNamespace = n, original
+	copy := &ManagedRuntimeNamespace{native: n}
+	if _, e := copy.exact(); e == nil || copy.closedForParent(c) {
+		t.Fatal("copied opaque wrapper acquired native eligibility")
+	}
+	for _, ctx := range []context.Context{nil, context.Background()} {
+		if n.recheckRegistered(ctx) == nil || n.bindLivePeer(ctx, nil) == nil || n.proveOffline(ctx, nil) == nil || len(n.resources) != 0 || len(n.keys) != 0 {
+			t.Fatal("incomplete/unbounded native entry acquired an output slot")
