+
+func TestRuntimeFreshActualOutputHelpersNeverConvertUnknownToAbsence(t *testing.T) {
+	for _, kind := range []string{"file", "registry"} {
+		for _, tc := range []struct {
+			name            string
+			handle          windows.Handle
+			err             error
+			unknown, absent bool
+		}{
+			{"precise absence", 0, windows.STATUS_OBJECT_NAME_NOT_FOUND, false, true},
+			{"error valid absence", 42, windows.STATUS_OBJECT_NAME_NOT_FOUND, true, false},
+			{"missing success", 0, nil, true, false},
+			{"positive output", 42, nil, false, false},
+			{"access denied", 0, windows.ERROR_ACCESS_DENIED, false, false},
+		} {
+			t.Run(kind+"/"+tc.name, func(t *testing.T) {
+				runtimeStorageDomain.Lock()
+				oldFailed := runtimeStorageDomain.failed
+				runtimeStorageDomain.failed = false
+				runtimeStorageDomain.Unlock()
+				n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true, captureKind: runtimeStorageFreshCapture}
+				n.captureSelf = n
+				runtimeStorageDomain.Lock()
+				runtimeStorageDomain.owners[n] = true
+				runtimeStorageDomain.Unlock()
+				t.Cleanup(func() {
+					runtimeStorageDomain.Lock()
+					delete(runtimeStorageDomain.owners, n)
+					runtimeStorageDomain.failed = oldFailed
+					runtimeStorageDomain.Unlock()
+				})
+				o := &FreshSetupOwner{storage: n}
+				o.self = o
+				freshTestRegister(t, o)
+				callErr := tc.err
+				absence := error(windows.STATUS_OBJECT_NAME_NOT_FOUND)
+				if kind == "registry" {
+					absence = windows.ERROR_FILE_NOT_FOUND
+					if callErr == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+						callErr = absence
+					}
+				}
+				n.mu.Lock()
+				defer n.mu.Unlock()
+				var got error
+				var retained bool
+				if kind == "file" {
+					r := n.keep(tc.handle)
+					got = o.fileOutputLocked(r, callErr)
+					retained = len(n.resources) == 1 && n.resources[0] == r
+					if r.attempted {
+						t.Fatal("result classifier closed output")
+					}
+				} else {
+					r := &freshRegistryResource{handle: tc.handle}
+					o.keys = append(o.keys, r)
+					got = o.keyOutputLocked(r, callErr)
+					retained = len(o.keys) == 1 && o.keys[0] == r
+					if r.attempted {
+						t.Fatal("result classifier closed registry output")
+					}
+				}
+				if (got == absence) != tc.absent || n.unknown != tc.unknown || o.unknown != tc.unknown {
+					t.Fatalf("result %v unknown %v/%v", got, n.unknown, o.unknown)
+				}
+				if tc.unknown {
+					if got != ErrUpgrade || !retained {
+						t.Fatal("unknown output lost or exposed absence")
+					}
+					if o.nativeOutputsAdmittedLocked() {
+						t.Fatal("unknown graph can continue native work")
+					}
+					if _, e := o.openFixed(0, "not-a-role", false, 0, 0, nil); e != ErrUpgrade {
+						t.Fatal("next file call reached native eligibility")
+					}
+					if _, e := o.openKey(0, "not-a-role"); e != ErrUpgrade {
+						t.Fatal("next registry call reached native eligibility")
+					}
+				}
+			})
+		}
+	}
+}
