+// Caller holds the namespace mutex on a locked OS thread. Reject impersonation
+// before registry reads; preserve every unexpected native output for cleanup.
+func (n *nativeManagedNamespace) checkCurrentToken() error {
+	if n.selfToken == nil || n.selfToken.attempted || n.selfToken.handle == 0 || legacySDKOrdinaryToken(windows.Token(n.selfToken.handle), n.sid, n.session) != nil {
+		return ErrUpgrade
+	}
+	thread := n.slot()
+	e := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, (*windows.Token)(unsafe.Pointer(&thread.handle)))
+	if n.reply(thread, e) != windows.ERROR_NO_TOKEN {
+		return ErrUpgrade
+	}
+	current := n.slot()
+	e = windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&current.handle)))
+	if n.reply(current, e) != nil || legacySDKOrdinaryToken(windows.Token(current.handle), n.sid, n.session) != nil {
+		return ErrUpgrade
+	}
+	retainedID, retainedAuth, e := managedPrimaryTokenIdentity(windows.Token(n.selfToken.handle))
+	currentID, currentAuth, currentErr := managedPrimaryTokenIdentity(windows.Token(current.handle))
+	if e != nil || currentErr != nil || retainedID != currentID || retainedAuth != currentAuth {
+		return ErrUpgrade
+	}
+	if n.closeFile(current) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func managedPrimaryTokenIdentity(token windows.Token) (windows.LUID, windows.LUID, error) {
+	var stats struct {
+		TokenID, AuthenticationID                                                 windows.LUID
+		Expiration                                                                int64
+		Type, Level, DynamicCharged, DynamicAvailable, GroupCount, PrivilegeCount uint32
+		Modified                                                                  windows.LUID
+	}
+	var size uint32
+	if token == 0 || windows.GetTokenInformation(token, windows.TokenStatistics, (*byte)(unsafe.Pointer(&stats)), uint32(unsafe.Sizeof(stats)), &size) != nil || size != uint32(unsafe.Sizeof(stats)) || stats.Type != 1 {
+		return windows.LUID{}, windows.LUID{}, ErrUpgrade
+	}
+	return stats.TokenID, stats.AuthenticationID, nil
+}
+
+// All callers hold the actual namespace mutex on one OS thread. The selected
+// key is retained, and the current parent enumeration must still select it.
+func (n *nativeManagedNamespace) recheckRegistered(ctx context.Context) error {
+	if !n.known(ctx) || !n.complete || n.shape != runtimeFreshGuestRegistered || n.selected == nil || n.root == nil || len(n.directories) != 4 || n.disk == nil {
+		return ErrUpgrade
+	}
+	// Discard only already cached-positive temporary closes. Repeated checks
+	// cannot grow the custody graph without bound; failed/live slots remain.
+	resources := n.resources[:0]
+	for _, r := range n.resources {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			resources = append(resources, r)
+		}
+	}
+	n.resources = resources
+	keys := n.keys[:0]
+	for _, r := range n.keys {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			keys = append(keys, r)
+		}
+	}
+	n.keys = keys
+	if len(n.resources) > 32 || len(n.keys) > 2 || n.checkCurrentToken() != nil {
+		return ErrUpgrade
+	}
+	for _, d := range n.directories {
+		if n.checkObject(d) != nil {
+			return ErrUpgrade
+		}
+	}
+	if n.checkObject(n.disk) != nil {
+		return ErrUpgrade
+	}
+	name, base, e := n.registrationValues(n.selected.handle)
+	if e != nil || name != n.name || base != n.base {
+		return ErrUpgrade
+	}
+	found := ""
+	for i := uint32(0); i <= 512; i++ {
+		if !n.known(ctx) {
+			return ErrUpgrade
+		}
+		var text [64]uint16
+		size := uint32(len(text))
+		e := windows.RegEnumKeyEx(n.root.handle, i, &text[0], &size, nil, nil, nil, nil)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			if found != n.guid {
+				return ErrUpgrade
+			}
+			name, base, e := n.registrationValues(n.selected.handle)
+			if e != nil || name != n.name || base != n.base || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			return nil
+		}
+		if e != nil || i == 512 || size == 0 || size >= uint32(len(text)) {
+			return ErrUpgrade
+		}
+		guid := strings.ToLower(windows.UTF16ToString(text[:size]))
+		if !freshRuntimeGUID(guid) {
+			return ErrUpgrade
+		}
+		key, e := n.openKey(ctx, n.root.handle, guid)
+		if e != nil {
+			return ErrUpgrade
+		}
+		value, e := freshRuntimeRegistryValue(key.handle, "DistributionName")
+		if e != nil {
+			return ErrUpgrade
+		}
+		if runtimeFreshOwnedRegistrationName(value) {
+			if found != "" || guid != n.guid {
+				return ErrUpgrade
+			}
+			found = guid
+			name, base, e := n.registrationValues(key.handle)
+			if e != nil || name != n.name || base != n.base {
+				return ErrUpgrade
+			}
+		}
+		if n.closeKey(key) != nil {
+			return ErrUpgrade
+		}
+	}
+	return ErrUpgrade
+}
+
+// The connected fixed product pipe is a locator. Authority comes from equality
+// with the independently retained ORIGINAL launch process and native image.
+// No request/response PID or named marker is accepted as that authority.
+func (n *nativeManagedNamespace) bindLivePeer(ctx context.Context, b *ManagedHostagentBirth) error {
+	if !n.known(ctx) || b == nil || b.self != b || n.authority == nil || b.parent != n.authority.image || n.recheckRegistered(ctx) != nil {
+		return ErrUpgrade
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if !b.complete || b.unknown || b.closeAttempt.attempted || b.process == nil || b.process.handle == 0 || b.token == nil || b.sid != n.sid || b.session != n.session || n.peer != nil && n.peer != b {
+		return ErrUpgrade
+	}
+	path, e := windows.UTF16PtrFromString(freshDockerPipe)
+	if e != nil {
+		return ErrUpgrade
+	}
+	r := n.slot()
+	r.handle, e = windows.CreateFile(path, windows.GENERIC_READ|windows.GENERIC_WRITE, 0, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OVERLAPPED|windows.SECURITY_SQOS_PRESENT|windows.SECURITY_ANONYMOUS, 0)
+	if n.reply(r, e) != nil {
+		return ErrUpgrade
+	}
+	var pid uint32
+	if windows.GetNamedPipeServerProcessId(r.handle, &pid) != nil || pid != b.pid || b.binding.same() != nil {
+		return ErrUpgrade
+	}
+	attached := n.slot()
+	e = windows.OpenProcessToken(b.process.handle, windows.TOKEN_QUERY, (*windows.Token)(unsafe.Pointer(&attached.handle)))
+	if n.reply(attached, e) != nil || legacySDKOrdinaryToken(windows.Token(attached.handle), n.sid, n.session) != nil {
+		return ErrUpgrade
+	}
+	heldID, heldAuth, heldErr := managedPrimaryTokenIdentity(windows.Token(b.token.handle))
+	attachedID, attachedAuth, attachedErr := managedPrimaryTokenIdentity(windows.Token(attached.handle))
+	if heldErr != nil || attachedErr != nil || heldID != attachedID || heldAuth != attachedAuth || n.closeFile(attached) != nil {
+		return ErrUpgrade
+	}
+	state, e := windows.WaitForSingleObject(b.process.handle, 0)
+	if e != nil || state != uint32(windows.WAIT_TIMEOUT) || n.closeFile(r) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	n.peer = b
+	return nil
+}
+
+// Sole Wait success and native exit0 are required separately by the original
+// caller. The actual same-disk exclusive open proves no outstanding writer can
+// share this disk at this boundary. It is not an unregister/delete capability.
+func (n *nativeManagedNamespace) proveOffline(ctx context.Context, b *ManagedHostagentBirth) error {
+	if !n.known(ctx) || !n.activated || n.retired || n.peer != b || b == nil || n.recheckRegistered(ctx) != nil || b.CheckExited(ctx) != nil {
+		return ErrUpgrade
+	}
+	disk, e := n.openChild(ctx, n.directories[3].resource.handle, "ext4.vhdx", false, windows.GENERIC_READ, 0)
+	if e != nil || !managedSameDisk(disk.identity, n.disk.identity) || n.recheckRegistered(ctx) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	n.exclusive = disk // retained until next qualified launch or final close
+	n.retired = true
+	return nil
+}
+
+func (n *ManagedRuntimeNamespace) exact() (*nativeManagedNamespace, error) {
+	if n == nil {
+		return nil, ErrUpgrade
+	}
+	p, ok := n.native.(*nativeManagedNamespace)
+	if !ok || p == nil || p.self != n || p.created == nil || p.created.managedNamespace != n {
+		return nil, ErrUpgrade
+	}
+	return p, nil
+}
+func (n *ManagedRuntimeNamespace) closedForParent(c *Created) bool {
+	p, e := n.exact()
+	if e != nil || p.created != c {
+		return false
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || !p.closeAttempt.attempted || p.closeAttempt.closeErr != nil {
+		return false
+	}
+	for _, r := range p.resources {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			return false
+		}
+	}
+	for _, r := range p.keys {
+		if r == nil || !r.attempted || r.closeErr != nil || r.handle != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// No driver/WSL action: only independently owned query capabilities. An
+// activated namespace requires the separate actual kernel/disk retirement.
+func (n *nativeManagedNamespace) close() error {
+	if n.unknown {
+		return ErrUpgrade
+	}
+	if n.closeAttempt.attempted {
+		return n.closeAttempt.closeErr
+	}
+	if n.activated && !n.retired {
+		return ErrUpgrade
+	}
+	return n.closeAttempt.run(func() error {
+		for i := len(n.keys) - 1; i >= 0; i-- {
+			if n.closeKey(n.keys[i]) != nil {
+				return ErrUpgrade
+			}
+		}
+		for i := len(n.resources) - 1; i >= 0; i-- {
+			if n.closeFile(n.resources[i]) != nil {
+				return ErrUpgrade
+			}
+		}
+		return nil
+	}, n.fence)
+}
