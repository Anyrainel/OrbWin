+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"testing"
+	"time"
+)
+
+func TestRuntimeFreshDirectoryActualCustodyRefusesBeforeNative(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, n := range []*nativeRuntimeStorage{nil, {}, {captureSelf: &nativeRuntimeStorage{}}} {
+		if _, e := n.freshPrivateDirectoryNamesLocked(ctx); e == nil {
+			t.Fatal("forged private enumeration")
+		}
+		if _, e := n.freshDirectoryNamesLocked(ctx, nil, nil, runtimeFreshDenialDirectory); e == nil {
+			t.Fatal("forged public enumeration")
+		}
+	}
+	// Sentinel pointer graph exercises only the SAME production pure admission
+	// predicate. Native entry is invoked only with a pre-existing active frame,
+	// which must refuse before token, ACL or file-ID queries.
+	o, _ := freshLegacyOutputFixture(t)
+	n := o.storage
+	parent := &runtimeStorageObject{directory: true, resource: &runtimeStorageResource{handle: 101}}
+	source := &runtimeStorageObject{directory: true, private: true, resource: &runtimeStorageResource{handle: 102}}
+	n.ancestry = []*runtimeStorageObject{parent, source}
+	n.resources = []*runtimeStorageResource{parent.resource, source.resource}
+	if !n.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("actual original private pointers")
+	}
+	copyN := &nativeRuntimeStorage{captureSelf: n, captureStarted: n.captureStarted, captureComplete: n.captureComplete, captureKind: n.captureKind, ancestry: n.ancestry, resources: n.resources}
+	if copyN.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("copied n")
+	}
+	copySource := *source
+	if n.freshDirectoryCustodyKnownLocked(&copySource, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("copied original private object")
+	}
+	if n.freshDirectoryCustodyKnownLocked(source, parent, 0) {
+		t.Fatal("arbitrary budget")
+	}
+	frame := &nativeFreshDirectoryQuery{source: source, parent: parent, role: runtimeFreshPrivateDirectory}
+	n.freshDirectoryQuery = frame
+	if _, e := n.freshPrivateDirectoryNamesLocked(ctx); e == nil || n.freshDirectoryQuery != frame || parent.resource.attempted || source.resource.attempted {
+		t.Fatal("active frame replaced or native sentinel touched")
+	}
+	n.freshDirectoryQuery = nil
+	n.captureComplete = false
+	o.captureComplete = false
+	if n.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("precontroller without original choice")
+	}
+	s := &nativeFreshSetupChoice{owner: o}
+	s.self = s
+	n.freshChoice = s
+	if !n.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("actual precontroller choice")
+	}
+	scopy := *s
+	n.freshChoice = &scopy
+	if n.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("copied original selector")
+	}
+	n.freshChoice = s
+	source.resource.attempted = true
+	if n.freshDirectoryCustodyKnownLocked(source, parent, runtimeFreshPrivateDirectory) {
+		t.Fatal("closed original object")
+	}
+}
+
+// Execute the actual production output classifier with inert slots only. No
+// sentinel handle/IOSB is passed to a syscall, queried or closed by these tests.
+func TestRuntimeFreshDirectoryActualOpenReplyRetainsPendingAndIOSB(t *testing.T) {
+	cases := []struct {
+		name    string
+		callErr error
+		handle  windows.Handle
+		status  windows.NTStatus
+		info    uintptr
+		kind    int
+	}{
+		{"pending zero handle", windows.STATUS_PENDING, 0, 0, 0, 1},
+		{"pending nonzero handle", windows.STATUS_PENDING, 121, 0, 0, 1},
+		{"pending invalid handle", windows.STATUS_PENDING, windows.InvalidHandle, 0, 0, 1},
+		{"pending IOSB even nil return", nil, 121, windows.STATUS_PENDING, 1, 1},
+		{"pending IOSB despite other error", windows.STATUS_ACCESS_DENIED, 0, windows.STATUS_PENDING, 0, 1},
+		{"success settled OPENED", nil, 121, 0, 1, 0},
+		{"success bad IOSB status", nil, 121, windows.STATUS_ACCESS_DENIED, 1, 1},
+		{"success uninitialized information", nil, 121, 0, 0, 1},
+		{"success contradictory created information", nil, 121, 0, 2, 1},
+		{"success missing handle", nil, 0, 0, 1, 1},
+		{"success invalid handle", nil, windows.InvalidHandle, 0, 1, 1},
+		{"known failed zero output", windows.STATUS_OBJECT_NAME_NOT_FOUND, 0, windows.STATUS_OBJECT_NAME_NOT_FOUND, 0, 2},
+		{"error with positive output", windows.STATUS_ACCESS_DENIED, 121, windows.STATUS_ACCESS_DENIED, 0, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			n, f := freshDirectoryReplyFixture(t)
+			slot := f.resource
+			slot.handle = tc.handle
+			f.status.Status = tc.status
+			f.status.Information = tc.info
+			status := f.status
+			backing := &f.backing[0]
+			e := n.freshDirectoryOpenReplyLocked(f, tc.callErr)
+			if n.freshDirectoryQuery != f || &f.backing[0] != backing || f.status != status || slot.attempted || slot.closeErr != nil || f.lease != nil {
+				t.Fatal("classifier lost native frame/custody or issued a lease/close")
+			}
+			switch tc.kind {
+			case 0:
+				if e != nil || n.unknown || f.resource != slot || len(n.resources) != 3 {
+					t.Fatal("settled OPENED not classified exactly")
+				}
+			case 1:
+				if e == nil || !n.unknown || f.resource != slot || len(n.resources) != 3 || n.resources[2] != slot {
+					t.Fatal("pending/unknown output was popped or admitted")
+				}
+				// A later native write to the retained IOSB cannot create a retry grant.
+				f.status.Status = 0
+				f.status.Information = 1
+				slot.handle = 121
+				if n.freshDirectoryOpenReplyLocked(f, nil) == nil || n.freshDirectoryQuery != f || f.resource != slot || len(n.resources) != 3 {
+					t.Fatal("late completion bypassed original fence")
+				}
+			case 2:
+				if e == nil || n.unknown || f.resource != nil || len(n.resources) != 2 {
+					t.Fatal("known completed no-output refusal")
+				}
+			}
+		})
+	}
+	t.Run("wrong frame refuses without replacement", func(t *testing.T) {
+		n, f := freshDirectoryReplyFixture(t)
+		copyFrame := *f
+		if n.freshDirectoryOpenReplyLocked(&copyFrame, windows.STATUS_PENDING) == nil || n.freshDirectoryQuery != f || len(n.resources) != 3 {
+			t.Fatal("copied frame took native custody")
+		}
+	})
+	t.Run("nonlatest original slot fences", func(t *testing.T) {
+		n, f := freshDirectoryReplyFixture(t)
+		n.resources = append(n.resources, &runtimeStorageResource{handle: 122})
+		if n.freshDirectoryOpenReplyLocked(f, nil) == nil || !n.unknown || n.freshDirectoryQuery != f || f.resource == nil || len(n.resources) != 4 {
+			t.Fatal("unknown original slot was dropped")
+		}
+	})
+}
+func freshDirectoryReplyFixture(t *testing.T) (*nativeRuntimeStorage, *nativeFreshDirectoryQuery) {
+	t.Helper()
+	o, _ := freshLegacyOutputFixture(t)
+	n := o.storage
+	parent := &runtimeStorageObject{directory: true, resource: &runtimeStorageResource{handle: 101}}
+	source := &runtimeStorageObject{directory: true, private: true, resource: &runtimeStorageResource{handle: 102}}
+	slot := &runtimeStorageResource{}
+	n.ancestry = []*runtimeStorageObject{parent, source}
+	n.resources = []*runtimeStorageResource{parent.resource, source.resource, slot}
+	backing := make([]uint64, 8)
+	f := &nativeFreshDirectoryQuery{source: source, parent: parent, role: runtimeFreshPrivateDirectory, resource: slot, backing: backing, state: runtimeFreshDirectoryState{role: runtimeFreshPrivateDirectory}}
+	n.freshDirectoryQuery = f
+	return n, f
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_environment.go b/rdd/pkg/managementconfig/runtime_fresh_environment.go
