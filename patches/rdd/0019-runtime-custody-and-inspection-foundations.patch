@@ -0,0 +1,47 @@
+package base
+
+import (
+	"fmt"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func soleControllerReference(object metav1.Object) (*metav1.OwnerReference, error) {
+	var result *metav1.OwnerReference
+	for _, ref := range object.GetOwnerReferences() {
+		if ref.Controller != nil && *ref.Controller {
+			if result != nil {
+				return nil, fmt.Errorf("multiple controller references")
+			}
+			copy := ref
+			result = &copy
+		}
+	}
+	return result, nil
+}
+
+// The App's name-only input reference must not let its VM consume a raced
+// unowned/foreign ConfigMap. This is desired-resource ownership, not native
+// process/root authority. Standalone explicit-template VMs remain supported.
+func RequireAppTemplateController(vm, source metav1.Object) error {
+	if vm == nil || source == nil {
+		return fmt.Errorf("missing template owner")
+	}
+	owner, e := soleControllerReference(vm)
+	if e != nil {
+		return e
+	}
+	if owner == nil {
+		return nil
+	}
+	if owner.Kind != "App" && owner.APIVersion != "app.rancherdesktop.io/v1alpha1" {
+		return nil
+	}
+	if owner.Kind != "App" || owner.APIVersion != "app.rancherdesktop.io/v1alpha1" || owner.Name != "app" || owner.UID == "" {
+		return fmt.Errorf("invalid App controller")
+	}
+	actual, e := soleControllerReference(source)
+	if e != nil || actual == nil || actual.APIVersion != owner.APIVersion || actual.Kind != owner.Kind || actual.Name != owner.Name || actual.UID != owner.UID {
+		return fmt.Errorf("template belongs to another App")
+	}
+	return nil
+}
