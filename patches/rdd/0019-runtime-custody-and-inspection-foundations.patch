+// Caller owns owner.mu and witness.mu. The short domain fence is sufficient to
+// forbid every storage admission without recursively acquiring storage.mu.
+func (w *FreshRuntimeObservation) fenceLocked() {
+	w.unknown = true
+	w.credentials.clear()
+	if w.owner == nil {
+		return
+	}
+	w.owner.unknown = true
+	n := w.owner.storage
+	if n != nil {
+		runtimeStorageDomain.Lock()
+		runtimeStorageDomain.failed = true
+		runtimeStorageDomain.owners[n] = true
+		runtimeStorageDomain.Unlock()
+	}
+}
