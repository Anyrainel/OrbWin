diff --git a/rdd/pkg/managementconfig/runtime_storage_io_model.go b/rdd/pkg/managementconfig/runtime_storage_io_model.go
new file mode 100644
index 0000000000000000000000000000000000000000..9356dead2d80c0fcf21c27572f93cb77a65d16c9
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_storage_io_model.go
@@ -0,0 +1,44 @@
+package managementconfig
+
+// Win32 synchronous transfer interpretation DATA, never a native owner/permit.
+func runtimeStorageIOReply(success bool, code, count, limit uint32, mutating bool) (known, complete bool) {
+	if success {
+		if count > limit || mutating && limit > 0 && count == 0 {
+			return false, false
+		}
+		return true, true
+	}
+	if code == 0 || code == 997 || mutating || count != 0 {
+		return false, false
+	}
+	return true, false
+}
+func runtimeStorageRenameReply(status, iosb uint32) bool { return status == 0 && iosb == 0 }
+
+type runtimeStorageIOState struct{ entered, returned, complete, unknown bool }
+
+func (s *runtimeStorageIOState) begin() (run, allowed bool) {
+	if s == nil || s.unknown {
+		return false, false
+	}
+	if s.entered {
+		return false, s.returned && s.complete
+	}
+	if s.returned || s.complete {
+		return false, false
+	}
+	s.entered = true
+	return true, true
+}
+func (s *runtimeStorageIOState) reply(known, complete bool) bool {
+	if s == nil || !s.entered || s.returned || s.unknown {
+		return false
+	}
+	s.returned = true
+	s.unknown = !known
+	s.complete = known && complete
+	return known
+}
+func (s *runtimeStorageIOState) settled() bool {
+	return s != nil && s.entered && s.returned && !s.unknown
+}
diff --git a/rdd/pkg/managementconfig/runtime_storage_io_model_test.go b/rdd/pkg/managementconfig/runtime_storage_io_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8b7f0434ad11ec0e807e2a2afd45fd65756a80a9
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_storage_io_model_test.go
@@ -0,0 +1,104 @@
+package managementconfig
+
+import "testing"
+
+func TestStorageIOReadWriteAndFlushCompletion(t *testing.T) {
+	for _, code := range []uint32{0, 5, 997, 0xffffffff} {
+		for _, mutate := range []bool{false, true} {
+			for _, count := range []uint32{1, 3, 8} {
+				k, c := runtimeStorageIOReply(true, code, count, 8, mutate)
+				if !k || !c {
+					t.Fatal("true BOOL borrowed stale lastError", code, count, mutate)
+				}
+			}
+		}
+	}
+	for _, mutate := range []bool{false, true} {
+		if k, _ := runtimeStorageIOReply(true, 0, 9, 8, mutate); k {
+			t.Fatal("count overflow")
+		}
+	}
+	if k, c := runtimeStorageIOReply(true, 997, 0, 0, true); !k || !c {
+		t.Fatal("flush success")
+	}
+	if k, _ := runtimeStorageIOReply(true, 0, 0, 8, true); k {
+		t.Fatal("zero progress write")
+	}
+	if k, c := runtimeStorageIOReply(true, 0, 0, 1, false); !k || !c {
+		t.Fatal("read EOF true")
+	}
+	for _, code := range []uint32{5, 38, 995} {
+		if k, c := runtimeStorageIOReply(false, code, 0, 8, false); !k || c {
+			t.Fatal("terminal read/EOF not known refusal", code)
+		}
+		if k, _ := runtimeStorageIOReply(false, code, 1, 8, false); k {
+			t.Fatal("partial error read accepted")
+		}
+		if k, _ := runtimeStorageIOReply(false, code, 0, 8, true); k {
+			t.Fatal("write error promoted to no effect")
+		}
+	}
+	for _, code := range []uint32{0, 997} {
+		for _, mutate := range []bool{false, true} {
+			if k, _ := runtimeStorageIOReply(false, code, 0, 8, mutate); k {
+				t.Fatal("pending/zeroerror discarded")
+			}
+		}
+	}
+}
+func TestStorageIORenameRequiresCompletedStatus(t *testing.T) {
+	if !runtimeStorageRenameReply(0, 0) {
+		t.Fatal("zero completion")
+	}
+	for _, pair := range [][2]uint32{{0x103, 0}, {0, 0x103}, {0x103, 0x103}, {0xc0000022, 0}, {0, 0xc0000022}, {1, 0}, {0x40000000, 0}, {0x80000005, 0}} {
+		if runtimeStorageRenameReply(pair[0], pair[1]) {
+			t.Fatal("rename suffix admitted", pair)
+		}
+	}
+}
+func TestStorageIOOnceCompletionCachingAndRefusal(t *testing.T) {
+	for _, p := range [][2]bool{{true, true}, {true, false}, {false, false}} {
+		s := runtimeStorageIOState{}
+		if run, ok := s.begin(); !run || !ok {
+			t.Fatal("first entry")
+		}
+		if s.reply(p[0], p[1]) != p[0] || s.settled() != p[0] {
+			t.Fatal("completion state", p, s)
+		}
+		run, ok := s.begin()
+		if run || ok != (p[0] && p[1]) {
+			t.Fatal("second native effect or wrong cache", p, s)
+		}
+		if s.reply(true, true) {
+			t.Fatal("late reply reused")
+		}
+	}
+}
+func TestStorageIOFaultRetainsOriginalAndPreventsSuffix(t *testing.T) {
+	for _, cut := range []string{"entered", "pending-zero", "partial-write", "rename-error", "positive"} {
+		f := &runtimeStorageIOState{}
+		original := f
+		f.begin()
+		suffix := 0
+		switch cut {
+		case "pending-zero", "partial-write", "rename-error":
+			f.reply(false, false)
+		case "positive":
+			f.reply(true, true)
+		}
+		func() {
+			defer func() {
+				if recover() != nil {
+					original.unknown = true
+				}
+			}()
+			panic("lost native completion")
+		}()
+		if run, ok := original.begin(); run || ok {
+			suffix++
+		}
+		if f != original || !f.unknown || f.settled() || suffix != 0 {
+			t.Fatal("fault freed owner or advanced suffix", cut)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_storage_io_windows.go b/rdd/pkg/managementconfig/runtime_storage_io_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..691f52a09c6913ec6d98d62f959dfa1c6cef7972
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_storage_io_windows.go
@@ -0,0 +1,205 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"runtime"
+	"unsafe"
+)
+
+type runtimeStorageIOKind uint8
+
+const (
+	storageIORead runtimeStorageIOKind = iota + 1
+	storageIOWrite
+	storageIOFlush
+)
+
+type runtimeStorageIOFrame struct {
+	owner     *nativeRuntimeStorage
+	resource  *runtimeStorageResource
+	kind      runtimeStorageIOKind
+	data      []byte
+	count     uint32
+	raw       uintptr
+	lastError error
+	state     runtimeStorageIOState
+}
+type runtimeStorageRenameFrame struct {
+	owner         *nativeRuntimeStorage
+	parent, stage *runtimeStorageObject
+	name          []uint16
+	words         []uint64
+	size          uint32
+	io            windows.IO_STATUS_BLOCK
+	raw           uintptr
+	state         runtimeStorageIOState
+}
+
+var storageIOKernel = windows.NewLazySystemDLL("kernel32.dll")
+var storageIOReadFile = storageIOKernel.NewProc("ReadFile")
+var storageIOWriteFile = storageIOKernel.NewProc("WriteFile")
+var storageIOFlushFile = storageIOKernel.NewProc("FlushFileBuffers")
+var storageIORenameFile = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtSetInformationFile")
+
+func (n *nativeRuntimeStorage) storageIOResourceKnown(r *runtimeStorageResource) bool {
+	if n == nil || n.captureSelf != n || !n.captureStarted || n.unknown || n.closeAttempted || n.nativeOpen != nil || n.win32Open != nil || r == nil || r.attempted || r.handle == 0 || r.handle == windows.InvalidHandle {
+		return false
+	}
+	runtimeStorageDomain.Lock()
+	known := runtimeStorageDomain.owners[n] && !runtimeStorageDomain.failed
+	runtimeStorageDomain.Unlock()
+	if !known || !n.nativeOpenResourceKnown(r) {
+		return false
+	}
+	count := 0
+	for _, v := range n.resources {
+		if v == r {
+			count++
+		}
+	}
+	return count == 1
+}
+func (n *nativeRuntimeStorage) storageIOUnsettled() bool {
+	return n.ioFrame != nil || n.renameFrame != nil && !n.renameFrame.state.settled()
+}
+func (n *nativeRuntimeStorage) beginStorageIO(r *runtimeStorageResource, kind runtimeStorageIOKind, data []byte) (*runtimeStorageIOFrame, error) {
+	if !n.storageIOResourceKnown(r) || n.storageIOUnsettled() || len(data) > runtimeIdentityBudget || (kind != storageIORead && kind != storageIOWrite && kind != storageIOFlush) || (kind != storageIOFlush && len(data) == 0) || (kind == storageIOFlush && len(data) != 0) {
+		return nil, ErrUpgrade
+	}
+	f := &runtimeStorageIOFrame{owner: n, resource: r, kind: kind, data: data}
+	n.ioFrame = f
+	return f, nil
+}
+func (f *runtimeStorageIOFrame) original() bool {
+	return f != nil && f.owner != nil && f.owner.ioFrame == f && f.owner.storageIOResourceKnown(f.resource)
+}
+func (f *runtimeStorageIOFrame) fail() { f.state.unknown = true; f.owner.fence() }
+func (f *runtimeStorageIOFrame) call() (count uint32, failure error) {
+	if !f.original() {
+		return 0, ErrUpgrade
+	}
+	run, allowed := f.state.begin()
+	if !allowed || !run {
+		return 0, ErrUpgrade
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			f.fail()
+			panic(p)
+		}
+		runtime.KeepAlive(f)
+	}()
+	switch f.kind {
+	case storageIORead:
+		f.raw, _, f.lastError = storageIOReadFile.Call(uintptr(f.resource.handle), uintptr(unsafe.Pointer(&f.data[0])), uintptr(len(f.data)), uintptr(unsafe.Pointer(&f.count)), 0)
+	case storageIOWrite:
+		f.raw, _, f.lastError = storageIOWriteFile.Call(uintptr(f.resource.handle), uintptr(unsafe.Pointer(&f.data[0])), uintptr(len(f.data)), uintptr(unsafe.Pointer(&f.count)), 0)
+	case storageIOFlush:
+		f.raw, _, f.lastError = storageIOFlushFile.Call(uintptr(f.resource.handle))
+	default:
+		f.fail()
+		return 0, ErrUpgrade
+	}
+	if !f.original() {
+		f.fail()
+		return 0, ErrUpgrade
+	}
+	success := uint32(f.raw) != 0
+	code := windows.Errno(0)
+	if !success {
+		var ok bool
+		code, ok = f.lastError.(windows.Errno)
+		// Do not touch kernel-pending buffer/count output after pending return.
+		if !ok || uint32(code) == 997 {
+			f.state.reply(false, false)
+			f.fail()
+			return 0, ErrUpgrade
+		}
+	}
+	known, complete := runtimeStorageIOReply(success, uint32(code), f.count, uint32(len(f.data)), f.kind != storageIORead)
+	if !f.state.reply(known, complete) {
+		f.fail()
+		return 0, ErrUpgrade
+	}
+	f.owner.ioFrame = nil // Same completed original frame only; no native references remain.
+	if !complete {
+		return f.count, code
+	}
+	return f.count, nil
+}
+func (n *nativeRuntimeStorage) transferStorage(r *runtimeStorageResource, data []byte, write bool) (uint32, error) {
+	kind := storageIORead
+	if write {
+		kind = storageIOWrite
+	}
+	f, e := n.beginStorageIO(r, kind, data)
+	if e != nil {
+		return 0, e
+	}
+	return f.call()
+}
+func (n *nativeRuntimeStorage) flushStorage(r *runtimeStorageResource) error {
+	f, e := n.beginStorageIO(r, storageIOFlush, nil)
+	if e != nil {
+		return e
+	}
+	_, e = f.call()
+	return e
+}
+func (n *nativeRuntimeStorage) renameStorageStage() (result error) {
+	if unsafe.Sizeof(windows.Handle(0)) != 8 || n == nil || n.captureSelf != n || !n.captureComplete || !n.prepared || !n.attempt.used || !n.attempt.armed || n.attempt.complete || n.stage == nil || n.parent == nil || n.stage.directory || !n.parent.directory || n.ioFrame != nil || !n.storageIOResourceKnown(n.stage.resource) || !n.storageIOResourceKnown(n.parent.resource) {
+		return ErrUpgrade
+	}
+	if n.renameFrame != nil {
+		f := n.renameFrame
+		if f.owner != n || f.stage != n.stage || f.parent != n.parent {
+			return ErrUpgrade
+		}
+		_, allowed := f.state.begin()
+		if allowed && f.state.complete {
+			return nil
+		}
+		n.fence()
+		return ErrUpgrade
+	}
+	f := &runtimeStorageRenameFrame{owner: n, parent: n.parent, stage: n.stage}
+	var e error
+	f.name, e = windows.UTF16FromString("runtime.json")
+	if e != nil {
+		return ErrUpgrade
+	}
+	f.name = f.name[:len(f.name)-1]
+	f.size = uint32(20 + 2*len(f.name))
+	f.words = make([]uint64, (int(f.size)+7)/8)
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), len(f.words)*8)
+	raw[0] = 1
+	*(*windows.Handle)(unsafe.Pointer(&raw[8])) = f.parent.resource.handle
+	*(*uint32)(unsafe.Pointer(&raw[16])) = uint32(2 * len(f.name))
+	for i, v := range f.name {
+		*(*uint16)(unsafe.Pointer(&raw[20+2*i])) = v
+	}
+	n.renameFrame = f // Parent/stage, name, aligned native buffer and IOSB BEFORE effect.
+	defer func() {
+		if p := recover(); p != nil {
+			f.state.unknown = true
+			n.fence()
+			panic(p)
+		}
+		runtime.KeepAlive(f)
+	}()
+	run, allowed := f.state.begin()
+	if !run || !allowed {
+		n.fence()
+		return ErrUpgrade
+	}
+	f.raw, _, _ = storageIORenameFile.Call(uintptr(f.stage.resource.handle), uintptr(unsafe.Pointer(&f.io)), uintptr(unsafe.Pointer(&f.words[0])), uintptr(f.size), 10)
+	// Information is request-dependent bytes-set DATA; not FILE_OPEN disposition.
+	success := uint32(f.raw) == 0 && runtimeStorageRenameReply(0, uint32(f.io.Status))
+	if !f.state.reply(success, success) {
+		n.fence()
+		return ErrUpgrade
+	}
+	return nil
+}
