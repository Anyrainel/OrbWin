+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestRuntimeFreshRecoveryDecodedLayoutCannotMintNativePreparedState(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	a := freshPublicationFixture()
+	body, e := encodeRuntimeIdentity(a.Runtime, a.Runtime.Home)
+	if e != nil {
+		t.Fatal(e)
+	}
+	a.Stage.Size = uint64(len(body))
+	a.Stage.Body = sha256.Sum256(body)
+	n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+	n.captureSelf = n
+	o := &FreshSetupOwner{storage: n}
+	o.self = o
+	r := &nativeFreshRecoveryOwner{owner: o, complete: true, admission: &a, stageBody: body}
+	r.self = r
+	n.freshRecovery = r
+	r.stage = &runtimeStorageObject{resource: &runtimeStorageResource{handle: 42}, identity: runtimeStorageIdentity{volume: a.Stage.Object.Volume, high: a.Stage.Object.High, low: a.Stage.Object.Low, size: a.Stage.Size, written: windows.Filetime{LowDateTime: 2}, descriptor: a.Stage.Descriptor}, private: true}
+	freshSetupOwners.Lock()
+	freshSetupOwners.owners[o] = true
+	freshSetupOwners.Unlock()
+	nativeFreshRecoveries.Lock()
+	nativeFreshRecoveries.owners[r] = true
+	nativeFreshRecoveries.Unlock()
+	t.Cleanup(func() {
+		freshSetupOwners.Lock()
+		delete(freshSetupOwners.owners, o)
+		freshSetupOwners.Unlock()
+		nativeFreshRecoveries.Lock()
+		delete(nativeFreshRecoveries.owners, r)
+		nativeFreshRecoveries.Unlock()
+	})
+	// Deliberately no actual storage-domain birth. Even fully formed record
+	// bytes and phase flags cannot reach a native query or lower capability.
+	if got, e := n.resumePreparedStorage(ctx); e == nil || got != nil || n.prepared || n.attempt.used || r.stage.resource.attempted {
+		t.Fatal("metadata manufactured prepared lineage")
+	}
+	r.target, r.targetBody = r.stage, r.stageBody
+	r.stage, r.stageBody = nil, nil
+	if got, e := n.resumeRenamedStorageReceipt(ctx); e == nil || got != nil || n.attempt.used || n.attempt.complete {
+		t.Fatal("metadata manufactured completed rename")
+	}
+	copy := &nativeRuntimeStorage{captureSelf: n, freshRecovery: r}
+	if got, e := copy.resumeRenamedStorageReceipt(ctx); e == nil || got != nil {
+		t.Fatal("copied storage minted recovery receipt")
+	}
+	if got, e := ResumeFreshSetupOwner(context.Background()); e == nil || got != nil {
+		t.Fatal("unbounded resume reached native provider")
+	}
+}
+
+func TestRuntimeFreshRecoveryChangedAdmittedStorageStopsActualCapabilities(t *testing.T) {
+	for _, field := range []string{"parent", "controller", "parent descriptor", "controller descriptor"} {
+		t.Run(field, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			a := freshPublicationFixture()
+			body, e := encodeRuntimeIdentity(a.Runtime, a.Runtime.Home)
+			if e != nil {
+				t.Fatal(e)
+			}
+			a.Stage.Size = uint64(len(body))
+			a.Stage.Body = sha256.Sum256(body)
+			n := &nativeRuntimeStorage{captureStarted: true, captureComplete: true}
+			n.captureSelf = n
+			object := func(id UpgradeObject, descriptor [32]byte, handle windows.Handle) *runtimeStorageObject {
+				return &runtimeStorageObject{resource: &runtimeStorageResource{handle: handle}, identity: runtimeStorageIdentity{volume: id.Volume, high: id.High, low: id.Low, descriptor: descriptor}}
+			}
+			n.parent = object(a.Parent, a.ParentDescriptor, 42)
+			n.controller = object(a.Controller, a.ControllerDescriptor, 43)
+			n.ancestry = []*runtimeStorageObject{object(UpgradeObject{1, 0, 9}, [32]byte{1}, 44)}
+			o := &FreshSetupOwner{storage: n}
+			o.self = o
+			r := &nativeFreshRecoveryOwner{owner: o, complete: true, admission: &a, stageBody: body}
+			r.self = r
+			n.freshRecovery = r
+			r.stage = object(a.Stage.Object, a.Stage.Descriptor, 45)
+			r.stage.identity.size = a.Stage.Size
+			r.stage.identity.written = windows.Filetime{LowDateTime: 2}
+			n.resources = []*runtimeStorageResource{n.parent.resource, n.controller.resource, r.stage.resource}
+			freshSetupOwners.Lock()
+			freshSetupOwners.owners[o] = true
+			freshSetupOwners.Unlock()
+			nativeFreshRecoveries.Lock()
+			nativeFreshRecoveries.owners[r] = true
+			nativeFreshRecoveries.Unlock()
+			runtimeStorageDomain.Lock()
+			oldFailed := runtimeStorageDomain.failed
+			runtimeStorageDomain.failed = false
+			runtimeStorageDomain.owners[n] = true
+			runtimeStorageDomain.Unlock()
+			t.Cleanup(func() {
+				freshSetupOwners.Lock()
+				delete(freshSetupOwners.owners, o)
+				freshSetupOwners.Unlock()
+				nativeFreshRecoveries.Lock()
+				delete(nativeFreshRecoveries.owners, r)
+				nativeFreshRecoveries.Unlock()
+				runtimeStorageDomain.Lock()
+				delete(runtimeStorageDomain.owners, n)
+				runtimeStorageDomain.failed = oldFailed
+				runtimeStorageDomain.Unlock()
+			})
+			switch field {
+			case "parent":
+				n.parent.identity.low++
+			case "controller":
+				n.controller.identity.low++
+			case "parent descriptor":
+				n.parent.identity.descriptor[0]++
+			case "controller descriptor":
+				n.controller.identity.descriptor[0]++
+			}
+			if p, e := n.resumePreparedStorage(ctx); e == nil || p != nil || n.prepared || n.attempt.used {
+				t.Fatal("changed original graph minted prepared capability")
+			}
+			if r.captureInitializedAuthority(ctx) == nil || r.control != nil || r.ownerLock != nil || o.created != nil {
+				t.Fatal("changed original graph opened service authority")
+			}
+			publisher := &nativeFreshRuntimePublisher{owner: o}
+			o.publication = publisher
+			if publisher.publishRecoveryHeld(ctx) == nil || publisher.prepared != nil || publisher.receipt != nil {
+				t.Fatal("changed original graph entered publication")
+			}
+			r.target, r.targetBody = r.stage, r.stageBody
+			r.stage, r.stageBody = nil, nil
+			if receipt, e := n.resumeRenamedStorageReceipt(ctx); e == nil || receipt != nil || n.attempt.complete || n.target != nil {
+				t.Fatal("changed original graph minted renamed receipt")
+			}
+			for _, slot := range n.resources {
+				if slot.attempted {
+					t.Fatal("stale admitted storage performed own native close")
+				}
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/runtime_fresh_seed.go b/rdd/pkg/managementconfig/runtime_fresh_seed.go
new file mode 100644
index 0000000000000000000000000000000000000000..8b811f390baf8bbe122e009be0abe5d00d5bd0f6
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_fresh_seed.go
@@ -0,0 +1,99 @@
+package managementconfig
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"strings"
+)
+
+const runtimeFreshSeedPrefix = "authority.fresh.seed.v2."
+const runtimeFreshIntentRepairSlots = 16
+
+// Comparable DATA for an empty native seed. Nonempty-record witnesses are
+// deliberately not weakened to admit zero-sized bodies.
+type runtimeFreshSeedFact struct {
+	Object     UpgradeObject `json:"object"`
+	Descriptor [32]byte      `json:"descriptor"`
+	Written    uint64        `json:"written"`
+	Binding    string        `json:"binding"`
+}
+
+func (s runtimeFreshSeedFact) valid() bool {
+	return s.Object.valid() && s.Descriptor != ([32]byte{}) && s.Written != 0 && upgradeHex(s.Binding, 64)
+}
+
+type runtimeFreshSeedName struct{ Transaction, Image, Commit, Binding string }
+
+func (s runtimeFreshSeedName) name() (string, error) {
+	if !upgradeHex(s.Transaction, 32) || !upgradeHex(s.Image, 64) || !upgradeHex(s.Commit, 40) || !upgradeHex(s.Binding, 64) {
+		return "", ErrUpgrade
+	}
+	return runtimeFreshSeedPrefix + s.Transaction + "." + s.Image + "." + s.Commit + "." + s.Binding, nil
+}
+func parseRuntimeFreshSeedName(name string) (runtimeFreshSeedName, error) {
+	var s runtimeFreshSeedName
+	if len(name) != 227 || !strings.HasPrefix(name, runtimeFreshSeedPrefix) {
+		return s, ErrUpgrade
+	}
+	fields := strings.Split(strings.TrimPrefix(name, runtimeFreshSeedPrefix), ".")
+	if len(fields) != 4 {
+		return s, ErrUpgrade
+	}
+	s = runtimeFreshSeedName{fields[0], fields[1], fields[2], fields[3]}
+	canonical, e := s.name()
+	if e != nil || canonical != name {
+		return runtimeFreshSeedName{}, ErrUpgrade
+	}
+	return s, nil
+}
+
+// Fixed version tag + three fixed-size, explicitly big-endian native identity
+// records. Digest is expected DATA only, never a native producer capability.
+func runtimeFreshSeedBinding(private, public, controller UpgradeObject, privateSD, publicSD, controllerSD [32]byte) string {
+	if !private.valid() || !public.valid() || !controller.valid() || privateSD == ([32]byte{}) || publicSD == ([32]byte{}) || controllerSD == ([32]byte{}) {
+		return ""
+	}
+	body := []byte("OrbWin/fresh-seed/v2\x00")
+	for i, id := range []UpgradeObject{private, public, controller} {
+		var fixed [12]byte
+		binary.BigEndian.PutUint32(fixed[0:4], id.Volume)
+		binary.BigEndian.PutUint32(fixed[4:8], id.High)
+		binary.BigEndian.PutUint32(fixed[8:12], id.Low)
+		body = append(body, fixed[:]...)
+		sd := [][32]byte{privateSD, publicSD, controllerSD}[i]
+		body = append(body, sd[:]...)
+	}
+	digest := sha256.Sum256(body)
+	return hex.EncodeToString(digest[:])
+}
+func runtimeFreshIntentRepairName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshIntentRepairSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.intent-repair.%04d", ordinal), nil
+}
+func runtimeFreshIntentArchiveName(ordinal uint32) (string, error) {
+	if ordinal >= runtimeFreshIntentRepairSlots {
+		return "", ErrUpgrade
+	}
+	return fmt.Sprintf("authority.fresh.intent-fragment.%04d", ordinal), nil
+}
+
+type runtimeFreshIntentRepair struct {
+	Schema                                                    int
+	Transaction                                               string
+	Ordinal                                                   uint32
+	Seed                                                      runtimeFreshSeedFact
+	PrivateParent, PublicParent, Controller                   UpgradeObject
+	PrivateDescriptor, PublicDescriptor, ControllerDescriptor [32]byte
+	Previous                                                  runtimePublicationFileWitness
+	Old                                                       runtimePublicationFileWitness
+	DesiredSize                                               uint64
+	Desired                                                   [32]byte
+}
+
+func (r runtimeFreshIntentRepair) valid() bool {
+	return r.Schema == 1 && upgradeHex(r.Transaction, 32) && r.Ordinal < runtimeFreshIntentRepairSlots && r.Seed.valid() && r.PrivateParent.valid() && r.PublicParent.valid() && r.Controller.valid() && r.PrivateDescriptor != ([32]byte{}) && r.PublicDescriptor != ([32]byte{}) && r.ControllerDescriptor != ([32]byte{}) && (r.Previous == (runtimePublicationFileWitness{}) || r.Previous.valid()) && freshRoleWitnessValid(r.Old, true) && r.Old.Object.Volume == r.PrivateParent.Volume && r.Old.Object != r.PrivateParent && r.Old.Object != r.Seed.Object && r.Old.Size < r.DesiredSize && r.DesiredSize <= 1024 && r.Desired != ([32]byte{})
+}
