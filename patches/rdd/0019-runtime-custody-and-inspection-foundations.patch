+			remotePortOffset, stateOffset := 16, 0
+			if test.family == 6 {
+				remotePortOffset, stateOffset = 44, 48
+			}
+			for _, upperByte := range []int{2, 3} {
+				unusedUpper := append([]byte(nil), data...)
+				unusedUpper[4+remotePortOffset+upperByte] = 0xa5
+				rows, err := parseUpgradeTCPTable(unusedUpper, test.family)
+				if err != nil || len(rows) != 1 || rows[0].remotePort != test.remote.Port() || runtimeUpgradeManagementTCPPeerPID(rows, test.remote, test.local, 123) != nil {
+					t.Fatal("unused remote port upper word changed documented 16-bit value", err)
