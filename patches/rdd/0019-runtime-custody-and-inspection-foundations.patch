@@ -0,0 +1,9 @@
+package managementconfig
+
+// ManagedRuntimeAuthority is an opaque original serving-lifetime capability.
+// The Windows producer binds actual Created/publisher/mapped-image owners.
+// A zero or copied wrapper cannot supply native authority.
+type ManagedRuntimeAuthority struct{ native any }
+
+func (*ManagedRuntimeAuthority) String() string   { return "original managed runtime lifetime" }
+func (*ManagedRuntimeAuthority) GoString() string { return "original managed runtime lifetime" }
