+func TestRuntimeUpgradeOldListenerSelection(t *testing.T) {
+	base := upgradeTCPRow{family: 4, address: [16]byte{127, 0, 0, 1}, port: 6443, pid: 23, state: 2}
+	if got, e := runtimeUpgradeOldListenerPID([]upgradeTCPRow{base}, nil, 6443); e != nil || got != 23 {
+		t.Fatal("actual listener row selection failed")
+	}
+	unrelated := base
+	unrelated.port = 6444
+	unrelated.pid = 42
+	established := base
+	established.state = 5
+	established.pid = 44
+	if got, e := runtimeUpgradeOldListenerPID([]upgradeTCPRow{base, unrelated, established}, nil, 6443); e != nil || got != 23 {
+		t.Fatal("unrelated clients/listeners interfered")
+	}
+	for _, kind := range []string{"missing", "wildcard", "other-loopback", "v6", "duplicate", "foreign-conflict", "zero-pid", "not-listening", "zero-port"} {
+		row := base
+		rows := []upgradeTCPRow{row}
+		port := uint16(6443)
+		switch kind {
+		case "missing":
+			rows = nil
+		case "wildcard":
+			rows[0].address = [16]byte{}
+		case "other-loopback":
+			rows[0].address[3] = 2
+		case "v6":
+			rows[0].family = 6
+		case "duplicate":
+			rows = append(rows, row)
+		case "foreign-conflict":
+			row.pid = 24
+			rows = append(rows, row)
+		case "zero-pid":
+			rows[0].pid = 0
+		case "not-listening":
+			rows[0].state = 5
+		case "zero-port":
+			port = 0
+		}
+		if _, e := runtimeUpgradeOldListenerPID(rows, nil, port); e == nil {
+			t.Fatal("ambiguous/unsupported row selected", kind)
+		}
+	}
+	if _, e := runtimeUpgradeOldListenerPID(make([]upgradeTCPRow, maxUpgradeTCPRows+1), nil, 6443); e == nil {
+		t.Fatal("unbounded table accepted")
+	}
+	if port, e := runtimeUpgradeOldRequestedPort([]byte(`["--secure-port","6443"]`)); e != nil || port != 6443 {
+		t.Fatal("held saved port parsing failed")
+	}
+	for _, body := range []string{`["--secure-port","0"]`, `["--secure-port","6443","--home=foreign"]`, `["--secure-port","65536"]`} {
+		if _, e := runtimeUpgradeOldRequestedPort([]byte(body)); e == nil {
+			t.Fatal("unsupported saved args selected port")
+		}
+	}
+}
