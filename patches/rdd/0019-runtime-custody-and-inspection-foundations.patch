+func (w *FreshRuntimeObservation) openRegistryLocked(parent windows.Handle, name string) (*freshRegistryResource, error) {
+	n := w.owner.storage
+	if !w.owner.nativeOutputsAdmittedLocked() || len(w.keys) >= 4096 {
+		return nil, ErrUpgrade
+	}
+	text, e := windows.UTF16PtrFromString(name)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	r := &freshRegistryResource{}
+	w.keys = append(w.keys, r)
+	e = windows.RegOpenKeyEx(parent, text, 0, windows.KEY_READ, &r.handle)
+	valid := r.handle != 0 && r.handle != windows.InvalidHandle
+	classified := runtimeStorageOpenReply(e, valid, func() {}, n.fence)
+	if classified != nil {
+		if n.unknown {
+			w.fenceLocked()
+			return nil, ErrUpgrade
+		}
+		w.keys = w.keys[:len(w.keys)-1]
+		return nil, classified
+	}
+	return r, nil
+}
