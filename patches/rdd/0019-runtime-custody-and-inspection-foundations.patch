+		return ErrUpgrade
+	}
+	if len(w.connections) >= 4096 {
+		return ErrUpgrade
+	}
+	u, e := url.Parse(w.credentials.endpoint)
+	if e != nil || u.Scheme != "https" || u.Hostname() != "127.0.0.1" {
+		return ErrUpgrade
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(w.credentials.ca) {
+		return ErrUpgrade
+	}
+	r := &freshObservationConnection{}
+	w.connections = append(w.connections, r)
+	defer func() {
+		panicked := recover() != nil
+		if w.settleTransportLocked(r, panicked) != nil || ctx.Err() != nil {
+			failure = ErrUpgrade
+		}
+	}()
+	returned, e := (&net.Dialer{Timeout: 5 * time.Second, KeepAlive: -1}).DialContext(ctx, "tcp4", u.Host)
+	if w.retainTransportDialLocked(r, returned, e) != nil {
+		return ErrUpgrade
+	}
+	if _, ok := r.conn.(*net.TCPConn); !ok {
+		w.fenceLocked()
+		return ErrUpgrade
+	}
+	if r.prepareIO(ctx) != nil {
+		return ErrUpgrade
+	}
+	t := tls.Client(r.guard, &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: pool, ServerName: "127.0.0.1", NextProtos: []string{"http/1.1"}, VerifyConnection: func(s tls.ConnectionState) error {
+		if len(s.PeerCertificates) == 0 || len(s.VerifiedChains) == 0 || s.NegotiatedProtocol != "" && s.NegotiatedProtocol != "http/1.1" || sha256.Sum256(s.PeerCertificates[0].Raw) != w.credentials.certificate {
+			return ErrUpgrade
+		}
+		return nil
+	}})
