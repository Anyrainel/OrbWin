+//go:build windows
+
+package service
+
+import (
+	"flag"
+	"fmt"
+	"github.com/sirupsen/logrus"
+	"k8s.io/klog/v2"
+	"k8s.io/kube-openapi/pkg/validation/validate"
+	"os"
+)
+
+// Fixed protocol role only, before any API/schema/CRD work. This selected
+// dependency caches the ORIGINAL stdout in a private logger during init;
+// redirecting os.Stdout cannot change that logger. No ordinary serve/debug
+// behavior is changed because ordinary entry never invokes this function.
+func enforceFreshProtocolLogging() error {
+	validate.Debug = false
+	logrus.SetLevel(logrus.WarnLevel)
+	logrus.SetOutput(os.Stderr)
+	// Fixed role never runs the ordinary Cobra logging preamble. Configure
+	// the real klog globals through its own flags before actors are created.
+	fs := flag.NewFlagSet("private-setup-logging", flag.ContinueOnError)
+	fs.SetOutput(os.Stderr)
+	klog.InitFlags(fs)
+	for _, setting := range [][2]string{{"v", "0"}, {"vmodule", ""}, {"logtostderr", "true"}} {
+		if fs.Set(setting[0], setting[1]) != nil {
+			return fmt.Errorf("private setup logging unavailable")
+		}
+	}
+	return nil
+}
