+// HostPort must consume only this inert Addr. There is no socket or serving
+// backend, and attempting either lifecycle method is a regression failure.
+type inertRuntimeCredentialListener struct {
+	port      int
+	addrCalls int
+}
+
+func (*inertRuntimeCredentialListener) Accept() (net.Conn, error) {
+	panic("inert credential producer listener cannot accept")
+}
+func (*inertRuntimeCredentialListener) Close() error {
+	panic("inert credential producer listener cannot close")
+}
+func (l *inertRuntimeCredentialListener) Addr() net.Addr {
+	l.addrCalls++
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: l.port}
+}
+
+func TestRuntimeUpgradeCredentialsRealDefaultProducerChain(t *testing.T) {
+	// Actual selected generator and producer, entirely in memory. Do not call
+	// fixture/file APIs, options.NewOptions/Complete/ResolvePort, a loader or the
+	// serving backend. A different Addr port models the producer's fallback output,
+	// not an execution or qualification of its native bind/fallback branch.
+	bundle, key, err := certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+	defer clear(key)
+	if err != nil {
+		t.Fatal("actual default certificate generator refused")
+	}
+	leaf, rest := pem.Decode(bundle)
+	anchor, trailing := pem.Decode(rest)
+	if leaf == nil || anchor == nil || len(trailing) != 0 {
+		t.Fatal("actual default generator did not emit leaf then CA")
+	}
+	requestedArgs := []byte(`["--secure-port","6443"]`)
+	beforeArgs := append([]byte(nil), requestedArgs...)
+	for _, actualPort := range []int{6443, 6550} {
+		t.Run(fmt.Sprintf("actual-%d", actualPort), func(t *testing.T) {
+			listener := &inertRuntimeCredentialListener{port: actualPort}
+			serving := &genericapiserver.SecureServingInfo{Listener: listener}
+			_, port, err := serving.HostPort()
+			if err != nil || port != actualPort || listener.addrCalls != 1 {
+				t.Fatal("actual SecureServingInfo.HostPort refused inert address")
+			}
+			endpoint := fmt.Sprintf("https://127.0.0.1:%d", port)
+			config := options.CreateKubeConfig(
+				"11111111-1111-4111-8111-111111111111",
+				"22222222-2222-4222-9222-222222222222",
+				endpoint, "", bundle,
+			)
+			body, err := clientcmd.Write(*config)
+			defer clear(body)
+			if err != nil {
+				t.Fatal("actual kubeconfig serializer refused")
+			}
+			encoded, err := yaml.YAMLToJSONStrict(body)
+			defer clear(encoded)
+			if err != nil {
+				t.Fatal("actual producer JSON conversion refused")
+			}
+			for _, input := range [][]byte{body, encoded} {
+				ca, fingerprint, err := managementconfig.RuntimeUpgradeCredentialProjectionForTest(input, requestedArgs)
+				if err != nil || !bytes.Equal(ca, pem.EncodeToMemory(anchor)) || fingerprint != sha256.Sum256(leaf.Bytes) {
+					clear(ca)
+					t.Fatal("actual HostPort -> generator -> CreateKubeConfig -> Write -> legacy parser refused or mixed anchor/leaf")
+				}
+				clear(ca)
+				ca, fingerprint, err = managementconfig.RuntimeCredentialPublicationProjectionForTest(input, endpoint)
+				if err != nil || !bytes.Equal(ca, pem.EncodeToMemory(anchor)) || fingerprint != sha256.Sum256(leaf.Bytes) {
+					clear(ca)
+					t.Fatal("fresh actual publisher endpoint refused")
+				}
+				clear(ca)
+				mismatch := "https://127.0.0.1:6443"
+				if actualPort == 6443 {
+					mismatch = "https://127.0.0.1:6550"
+				}
+				ca, fingerprint, err = managementconfig.RuntimeCredentialPublicationProjectionForTest(input, mismatch)
+				if err == nil || ca != nil || fingerprint != [32]byte{} {
+					clear(ca)
+					t.Fatal("fresh mismatch accepted or retained terminal public projection")
+				}
+			}
+		})
+	}
+	if !bytes.Equal(requestedArgs, beforeArgs) {
+		t.Fatal("producer regression rewrote saved requested args")
+	}
+}
