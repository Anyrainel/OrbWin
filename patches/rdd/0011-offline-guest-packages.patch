+func TestGuestPackageStagingSeparatesAssetsAndRejectsUnknownPaths(t *testing.T) {
+	dir := t.TempDir()
+	first, _, err := stageGuestAssetAt(dir, "socat.rpm", []byte("signed fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, _, err := stageGuestAssetAt(dir, "libwrap.rpm", []byte("signed fixture"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("different assets share a staged pathname")
+	}
+	again, _, err := stageGuestAssetAt(dir, "socat.rpm", []byte("signed fixture"))
+	if err != nil || first != again {
+		t.Fatal("repeat staging is not idempotent")
+	}
+	if _, _, err := stageGuestAssetAt(dir, "../outside", []byte("bad")); err == nil {
+		t.Fatal("unknown asset pathname accepted")
+	}
+	if err := os.WriteFile(filepath.Join(dir, filepath.Base(first)), []byte("modified"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := stageGuestAssetAt(dir, "socat.rpm", []byte("signed fixture")); err == nil {
+		t.Fatal("modified staged package accepted")
+	}
+}
