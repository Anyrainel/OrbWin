+func stageGuestPackages() (map[string]stagedGuestPackage, error) {
+	result := map[string]stagedGuestPackage{}
+	if goruntime.GOOS != "windows" || (instance.Suffix() != "orbwin" && instance.Suffix() != "orbwin-proof") || len(embedded.GuestPackages) == 0 {
+		return result, nil
+	}
+	for _, name := range []string{"socat.rpm", "libwrap.rpm"} {
+		payload := embedded.GuestPackages[name]
+		if len(payload) == 0 {
+			return nil, fmt.Errorf("bundled guest package is missing: %s", name)
+		}
+		path, digest, err := stageGuestAssetAt(filepath.Join(instance.ShortDir(), "guest-code"), name, payload)
+		if err != nil {
+			return nil, err
+		}
+		result[name] = stagedGuestPackage{Path: path, SHA256: digest}
+	}
+	return result, nil
+}
