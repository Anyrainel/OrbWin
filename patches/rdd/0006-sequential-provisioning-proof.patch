diff --git a/rdd/pkg/controllers/app/app/controllers/orbwin_proof_test.go b/rdd/pkg/controllers/app/app/controllers/orbwin_proof_test.go
new file mode 100644
index 000000000..fa4e5b79f
--- /dev/null
+++ b/rdd/pkg/controllers/app/app/controllers/orbwin_proof_test.go
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: Apache-2.0
+package controllers
+
+import "testing"
+
+func TestOrbWinGuestNameBoundary(t *testing.T) {
+	for _, instance := range []string{"", "orbwin", "2", "foreign"} {
+		t.Setenv("RDD_INSTANCE", instance)
+		if limaVMNameForInstance() != "orbwin" {
+			t.Fatalf("unexpected product guest for %q", instance)
+		}
+	}
+	t.Setenv("RDD_INSTANCE", "orbwin-proof")
+	if limaVMNameForInstance() != "orbwin-proof" {
+		t.Fatal("proof guest would collide with retained product data")
+	}
+}
