+	}
+	m.returned = true
+	if m.mapping != file {
+		m.fail()
+		return ErrUpgrade
+	}
+	if first {
+		b.process, b.file, b.id, b.creation, b.captured = process, file, id, creation, true
+	}
+	return nil
+}
+func (b *managedObservationImageBinding) capture(process, file windows.Handle) error {
+	return b.query(process, file, true)
+}
+func (b *managedObservationImageBinding) same() error { return b.query(b.process, b.file, false) }
