@@ -0,0 +1,62 @@
+package managementconfig
+
+// Pure sequencing DATA. Native origin additionally requires the actual
+// authority/launch/cmd.Process pointer guards, never these booleans alone.
+type managedBirthLineageState struct{ reserved, attached, unknown bool }
+
+func (s *managedBirthLineageState) reserve(unique, started, complete, poisoned, existing bool) bool {
+	if s == nil || s.reserved || s.attached || s.unknown || !unique || !started || !complete || poisoned || existing {
+		return false
+	}
+	s.reserved = true
+	return true
+}
+func (s *managedBirthLineageState) attach(exact bool) bool {
+	if s == nil || !s.reserved || s.attached || s.unknown || !exact {
+		if s != nil {
+			s.unknown = true
+		}
+		return false
+	}
+	s.attached = true
+	return true
+}
+
+// Borrow sequencing only. Release is called by the actual witness after its
+// original resource Close loop positively completes, never decoded from DATA.
+type managedBirthBorrowState struct{ released, unknown bool }
+
+func (s *managedBirthBorrowState) release(exact, closed bool) bool {
+	if s == nil || s.released || s.unknown || !exact || !closed {
+		if s != nil {
+			s.unknown = true
+		}
+		return false
+	}
+	s.released = true
+	return true
+}
+func (s *managedBirthBorrowState) closedKnown() bool { return s != nil && s.released && !s.unknown }
+
+// Negative barrier for an original-source query window, NOT native retirement.
+// Birth.mu covers the window; native Wait/exit/offline proofs remain separate.
+type managedObservationWindowState struct{ active, unknown bool }
+
+func (s *managedObservationWindowState) begin() bool {
+	if s == nil || s.active || s.unknown {
+		return false
+	}
+	s.active = true
+	return true
+}
+func (s *managedObservationWindowState) settle(known bool) bool {
+	if s == nil || !s.active || s.unknown || !known {
+		if s != nil {
+			s.unknown = true
+		}
+		return false
+	}
+	s.active = false
+	return true
+}
+func (s *managedObservationWindowState) idleKnown() bool { return s != nil && !s.active && !s.unknown }
