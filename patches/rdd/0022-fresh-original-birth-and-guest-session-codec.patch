index 0000000000000000000000000000000000000000..ee59d454994fd11b2c8ce17b5bc1bdedd310009d
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_managed_observation_frame_test.go
@@ -0,0 +1,124 @@
+package managementconfig
+
+import "testing"
+
+func TestManagedObservationPendingAndPartialCuts(t *testing.T) {
+	for _, c := range []struct {
+		status, iosb uint32
+		info         uintptr
+		out, valid   bool
+		want         runtimeStorageNativeOpenReply
+	}{
+		{0, 0, 1, true, true, runtimeStorageNativeOpenSuccess},
+		{0x103, 0, 0, false, false, runtimeStorageNativeOpenUnknown},
+		{0, 0x103, 1, true, true, runtimeStorageNativeOpenUnknown},
+		{0, 0, 2, true, true, runtimeStorageNativeOpenUnknown},
+		{0xc0000034, 0, 0, false, false, runtimeStorageNativeOpenFailure},
+		{0xc0000034, 0, 0, true, true, runtimeStorageNativeOpenUnknown},
+		{1, 0, 0, false, false, runtimeStorageNativeOpenUnknown},
+	} {
+		kind := runtimeStorageClassifyNativeOpen(c.status, c.iosb, c.info, 1, c.out, c.valid)
+		if kind != c.want {
+			t.Fatal(c)
+		}
+		s := runtimeStorageNativeOpenState{entered: true}
+		settled := s.reply(kind)
+		if settled != (kind != runtimeStorageNativeOpenUnknown) || s.attach() != (kind == runtimeStorageNativeOpenSuccess) {
+			t.Fatal("pending/partial admission", c)
+		}
+		if s.reply(runtimeStorageNativeOpenSuccess) {
+			t.Fatal("late native reply accepted")
+		}
+	}
+}
+func TestManagedObservationWin32WidthAndUnknown(t *testing.T) {
+	for _, c := range []struct {
+		raw, out uintptr
+		code     uint32
+		known    bool
+		want     runtimeStorageNativeOpenReply
+	}{
+		{1, 19, 997, false, runtimeStorageNativeOpenSuccess},
+		{uintptr(1) << 32, 0, 997, true, runtimeStorageNativeOpenUnknown},
+		{0, 0, 996, true, runtimeStorageNativeOpenUnknown},
+		{0, 0, 5, true, runtimeStorageNativeOpenFailure},
+		{0, 19, 5, true, runtimeStorageNativeOpenUnknown},
+		{0, 0, 0, true, runtimeStorageNativeOpenUnknown},
+		{1, ^uintptr(0), 0, true, runtimeStorageNativeOpenUnknown},
+	} {
+		if runtimeStorageClassifyTokenOpen(c.raw, c.out, c.code, c.known) != c.want {
+			t.Fatal(c)
+		}
+	}
+}
+func TestManagedObservationBorrowCloseFailureCuts(t *testing.T) {
+	for cut := 0; cut < 5; cut++ {
+		s := managedBirthBorrowState{}
+		allClosed := false
+		func() {
+			defer func() {
+				if recover() != nil {
+					s.release(true, false)
+				}
+			}()
+			for n := 0; n < 5; n++ {
+				if n == cut {
+					panic("checked close cut")
+				}
+			}
+			allClosed = true
+		}()
+		if allClosed || s.closedKnown() || s.release(true, true) {
+			t.Fatal("panic released original parent", cut)
+		}
+	}
+	for _, c := range []struct{ exact, closed bool }{{false, true}, {true, false}, {false, false}} {
+		s := managedBirthBorrowState{}
+		if s.release(c.exact, c.closed) || s.closedKnown() || s.release(true, true) {
+			t.Fatal("bad edge/failed resource close replay")
+		}
+	}
+	s := managedBirthBorrowState{}
+	if !s.release(true, true) || !s.closedKnown() {
+		t.Fatal("complete checked release")
+	}
+}
+
+func TestManagedObservationRetirementOrderWithIndependentCopies(t *testing.T) {
+	source := managedObservationWindowState{}
+	copies := managedBirthBorrowState{}
+	if !source.begin() || source.idleKnown() {
+		t.Fatal("native source window not held")
+	}
+	if !source.settle(true) || !source.idleKnown() || copies.closedKnown() {
+		t.Fatal("settled source still depends on later copy Close")
+	}
+	// In production, birth.Close still needs original Wait/exit/offline evidence.
+	// This negative source barrier no longer waits for private w.Close, which is
+	// called only AFTER RetireHostagent in the real retirement order.
+	if !copies.release(true, true) || !source.idleKnown() {
+		t.Fatal("later independent checked Close")
+	}
+	for _, known := range []bool{false, true} {
+		s := managedObservationWindowState{}
+		s.begin()
+		if !known {
+			s.settle(false)
+		} // pending/contradictory source completion
+		if known {
+			func() {
+				defer func() {
+					if recover() != nil {
+						s.settle(false)
+					}
+				}()
+				panic("unreturned native window")
+			}()
+		}
+		c := managedBirthBorrowState{}
+		c.release(true, true)
+		if s.idleKnown() || s.begin() || s.settle(true) {
+			t.Fatal("copy close unlocked unknown source")
+		}
+	}
+}
