+func TestProvisionOrderAndStreamBudgets(t *testing.T) {
+	s := session(t, 1)
+	ready := func(r Role) error {
+		h, p, k := pair(t, s, r, 1)
+		exchange(t, h, p)
+		defer dispose(h, p, k)
+		return s.ObserveReady(h)
+	}
+	if ready(SSHBinding) == nil || ready(Docker) == nil || s.ObserveProvisionJoin() == nil {
+		t.Fatal("early gates")
+	}
+	for _, r := range []Role{NetworkControl, NetworkData, SSHBinding} {
+		if ready(r) != nil {
+			t.Fatal("SSH cycle")
+		}
+	}
+	if s.ObserveProvisionJoin() != nil {
+		t.Fatal("provision")
+	}
+	for _, r := range []Role{Docker, Containerd, Guestagent} {
+		if ready(r) != nil {
+			t.Fatal("final role")
+		}
+	}
+	if s.Ordered(Bootstrap, 1, false) == nil {
+		t.Fatal("gap")
+	}
+	for i := uint64(0); i < 16; i++ {
+		if s.Ordered(Bootstrap, i, false) != nil {
+			t.Fatal("startup")
+		}
+	}
+	if s.Ordered(Bootstrap, 16, false) == nil {
+		t.Fatal("startup bound")
+	}
+	for i := uint64(0); i < 8; i++ {
+		if s.Ordered(Bootstrap, i, true) != nil {
+			t.Fatal("drain")
+		}
+	}
+	if s.Ordered(Bootstrap, 8, true) == nil {
+		t.Fatal("drain bound")
+	}
+	if _, e := s.Host(Docker, [32]byte{1}); e == nil {
+		t.Fatal("drain new host")
+	}
+}
+func TestSecretRedactionAndClose(t *testing.T) {
+	s := session(t, 77)
+	h, p, k := pair(t, s, Docker, 1)
+	for _, obj := range []any{s, *s, h, *h, k, secret{77}} {
+		for _, verb := range []string{"%v", "%+v", "%#v", "%s", "%q", "%x", "%X", "%d"} {
+			if !bytes.Contains([]byte(fmt.Sprintf(verb, obj)), []byte("REDACTED")) {
+				t.Fatal("secret format", verb)
+			}
+		}
+		if _, e := json.Marshal(obj); e == nil {
+			t.Fatal("secret JSON")
+		}
+	}
+	hello, _ := h.EncodeNext()
+	s.Close()
+	if p.Accept(hello) != nil {
+		t.Fatal("derived peer depends on master owner")
+	}
+	challenge, e := p.EncodeNext()
+	if e != nil || h.Accept(challenge) == nil {
+		t.Fatal("independent peer/master lifetime")
+	}
+	if s.state.master != (secret{}) {
+		t.Fatal("master erasure")
+	}
+	if _, e := h.EncodeNext(); e == nil {
+		t.Fatal("closed master host")
+	}
+	k.Close()
+	if k.state.key != (secret{}) {
+		t.Fatal("role erasure")
+	}
+	if p.Accept(nil) == nil {
+		t.Fatal("closed peer")
+	}
+	h.Close()
+	p.Close()
+}
