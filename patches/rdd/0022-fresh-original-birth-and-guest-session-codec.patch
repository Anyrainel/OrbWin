+var managedRegQuery = windows.NewLazySystemDLL("advapi32.dll").NewProc("RegQueryValueExW")
+var managedGetTokenInfo = windows.NewLazySystemDLL("advapi32.dll").NewProc("GetTokenInformation")
+var managedGetPID = imageOutputKernel.NewProc("GetProcessId")
+var managedGetTimes = imageOutputKernel.NewProc("GetProcessTimes")
+var managedGetSession = imageOutputKernel.NewProc("ProcessIdToSessionId")
+var managedWait = imageOutputKernel.NewProc("WaitForSingleObject")
+var managedGetExit = imageOutputKernel.NewProc("GetExitCodeProcess")
+var managedGetPipePID = imageOutputKernel.NewProc("GetNamedPipeServerProcessId")
+var managedGetFileInfo = imageOutputKernel.NewProc("GetFileInformationByHandle")
+
+// Closed lifetime/provenance roots, populated only by the two actual native
+// namespace constructors after their original parent admission. Not a lookup
+// authority for caller handles, or a generic frame/actor registry.
+var managedObservationNamespaces = struct {
+	sync.Mutex
+	owners map[*nativeManagedNamespace]bool
+}{owners: make(map[*nativeManagedNamespace]bool)}
+
+func newManagedObservationFrame(owner any) *managedObservationFrame {
+	if !runtimeStorageDomainKnown() {
+		return nil
+	}
+	f := &managedObservationFrame{owner: owner}
+	switch o := owner.(type) {
+	case *ManagedHostagentBirth:
+		if o == nil || o.unknown {
+			return nil
+		}
+		o.nativeFrames = trimManagedObservationFrames(o.nativeFrames)
+		if len(o.nativeFrames) >= 8192 {
+			return nil
+		}
+		o.nativeFrames = append(o.nativeFrames, f)
+	case *FreshRuntimeObservation:
+		if o == nil || o.unknown || o.owner == nil || o.owner.unknown {
+			return nil
+		}
+		o.nativeFrames = trimManagedObservationFrames(o.nativeFrames)
+		o.keys = trimManagedObservationKeys(o.keys)
+		if len(o.nativeFrames) >= 8192 {
+			return nil
+		}
+		o.nativeFrames = append(o.nativeFrames, f)
+	case *nativeManagedNamespace:
+		if o == nil || o.unknown {
+			return nil
+		}
+		o.nativeFrames = trimManagedObservationFrames(o.nativeFrames)
+		o.keys = trimManagedObservationKeys(o.keys)
+		if len(o.nativeFrames) >= 8192 {
+			return nil
+		}
+		o.nativeFrames = append(o.nativeFrames, f)
+	default:
+		return nil
+	}
+	return f
+}
+
+// Only completed synchronous scratch queries or positively closed open outputs
+// may leave custody. Live outputs and every unreturned/pending/unknown frame
+// remain. Actual identity/admission DATA is stored by its owner, not this scratch
+// list. This prevents normal namespace rechecks exhausting a lifetime counter.
+func trimManagedObservationFrames(frames []*managedObservationFrame) []*managedObservationFrame {
+	kept := frames[:0]
+	for _, f := range frames {
+		if f == nil {
+			continue
+		}
+		safe := f.returned && !f.unknown && !f.state.unknown
+		if f.resource != nil {
+			safe = safe && f.resource.attempted && f.resource.closeErr == nil && f.resource.handle == 0
+		}
+		if f.key != nil {
+			safe = safe && f.key.attempted && f.key.closeErr == nil && f.key.handle == 0
+		}
+		if !safe {
+			kept = append(kept, f)
+		}
+	}
+	clear(frames[len(kept):])
+	return kept
+}
+func trimManagedObservationKeys(keys []*freshRegistryResource) []*freshRegistryResource {
+	kept := keys[:0]
+	for _, k := range keys {
+		if k == nil || !k.attempted || k.closeErr != nil || k.handle != 0 {
+			kept = append(kept, k)
+		}
+	}
+	clear(keys[len(kept):])
+	return kept
+}
