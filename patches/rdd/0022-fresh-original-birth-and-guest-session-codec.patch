+
+// A frame is rooted only by one of these three actual concrete native owners.
+// No callback/provider/DTO can register an owner or supply an output cell.
+type managedObservationFrame struct {
+	owner                         any
+	resource                      *runtimeStorageResource
+	key                           *freshRegistryResource
