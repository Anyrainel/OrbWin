+package managementconfig
+
+import "testing"
+
+func TestManagedBirthLineageOnceAndSubstitution(t *testing.T) {
+	s := managedBirthLineageState{}
+	if !s.reserve(true, true, true, false, false) || s.reserve(true, true, true, false, false) || !s.attach(true) || s.attach(true) {
+		t.Fatal("one original source/attachment")
+	}
+	for n := 0; n < 5; n++ {
+		s := managedBirthLineageState{}
+		if s.reserve(n != 0, n != 1, n != 2, n == 3, n == 4) {
+			t.Fatal("invalid source", n)
+		}
+	}
+	s = managedBirthLineageState{}
+	s.reserve(true, true, true, false, false)
+	if s.attach(false) || !s.unknown || s.attach(true) {
+		t.Fatal("changed original replay")
+	}
+}
