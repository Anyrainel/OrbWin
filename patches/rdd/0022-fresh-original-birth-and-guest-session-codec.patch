+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+)
+
+// Correlation DATA bound by the actual proxy-launch producer before its real
+// Start. This is NOT guest authentication or a substitute for native lineage.
+type managedPipeRoleData struct {
+	appUID, vmUID, epoch        string
+	appGeneration, vmGeneration int64
+}
+
+func (l *ManagedHostagentLaunch) BindProxyLaunchGeneration(ctx context.Context, appUID, vmUID, epoch string, appGeneration, vmGeneration int64) error {
+	if l == nil || l.self != l || !freshBoundedContext(ctx) {
+		return ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.owner == nil || l.cmd == nil || !l.complete || l.started || l.unknown || l.closeAttempt.attempted || l.pipeRole != nil || appUID == "" || vmUID == "" || len(appUID) > 128 || len(vmUID) > 128 || len(epoch) != 32 || appGeneration < 1 || vmGeneration < 1 {
+		return ErrUpgrade
+	}
+	for _, v := range []string{appUID, vmUID, epoch} {
+		for _, c := range v {
+			if c < 0x21 || c > 0x7e {
+				return ErrUpgrade
+			}
+		}
+	}
+	l.pipeRole = &managedPipeRoleData{appUID: appUID, vmUID: vmUID, epoch: epoch, appGeneration: appGeneration, vmGeneration: vmGeneration}
+	return nil
+}
+func managedActualHostagentCommand(l *ManagedHostagentLaunch) bool {
+	if l == nil || l.owner == nil || l.owner.image == nil || l.cmd == nil {
+		return false
+	}
+	image := l.owner.image
+	if len(image.captureParts) < 5 {
+		return false
+	}
+	path := filepath.Join(append([]string{image.captureVolume}, image.captureParts...)...)
