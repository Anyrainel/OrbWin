new file mode 100644
index 0000000000000000000000000000000000000000..28ebea31a6e23fde4c1daee6a6449fadfebeb55b
--- /dev/null
+++ b/rdd/pkg/guestsession/session.go
@@ -0,0 +1,359 @@
+// Package guestsession models authentication DATA, never native authority.
+package guestsession
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"sync"
+)
+
+var ErrProtocol = errors.New("guest session protocol refused")
+var ErrSecretJSON = errors.New("guest session secret cannot be JSON encoded")
+
+type Role byte
+
+const (
+	Bootstrap Role = iota + 1
+	NetworkControl
+	NetworkData
+	Docker
+	Containerd
+	Guestagent
+	SSHBinding
+)
+
+func valid(r Role) bool { return r >= Bootstrap && r <= SSHBinding }
+
+type secret [32]byte
+
+func (secret) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED]")) }
+func (secret) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+
+type Session struct{ state *sessionState }
+type sessionState struct {
+	mu               sync.Mutex
+	master           secret
+	id               [16]byte
+	digest           [32]byte
+	closed, draining bool
+	next             uint64
+	live             uint16
+	startup, drain   uint64
+	ready            [8]bool
+	provisioned      bool
+}
+
+func (Session) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED guest session]")) }
+func (Session) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+func New(master [32]byte, id [16]byte, record []byte) (*Session, error) {
+	if master == ([32]byte{}) || id == ([16]byte{}) || len(record) == 0 || len(record) > 4096 {
+		return nil, ErrProtocol
+	}
+	return &Session{state: &sessionState{master: secret(master), id: id, digest: sha256.Sum256(record)}}, nil
+}
+func (s *Session) Close() {
+	if s == nil || s.state == nil {
+		return
+	}
+	o := s.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.closed = true
+	o.master = secret{}
+}
+func (s *Session) Ordered(role Role, seq uint64, drain bool) error {
+	if s == nil || s.state == nil {
+		return ErrProtocol
+	}
+	o := s.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || !valid(role) {
+		return ErrProtocol
+	}
+	if drain {
+		if seq != o.drain || o.drain >= 8 {
+			return ErrProtocol
+		}
+		o.draining = true
+		o.drain++
+		return nil
+	}
+	if o.draining || seq != o.startup || o.startup >= 16 {
+		return ErrProtocol
+	}
+	o.startup++
+	return nil
+}
+
+// RoleKey holds ONLY a derived role key. Independent peer delivery is future IO.
+type RoleKey struct{ state *roleState }
+type roleState struct {
+	mu     sync.Mutex
+	key    secret
+	id     [16]byte
+	digest [32]byte
+	role   Role
+	closed bool
+	live   uint16
+}
+
+func (RoleKey) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED role key]")) }
+func (RoleKey) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+func derive(master secret, id [16]byte, r Role) secret {
+	m := hmac.New(sha256.New, master[:])
+	m.Write([]byte("orbwin-selected-guest-session-v2\x00"))
+	m.Write([]byte{byte(r)})
+	m.Write(id[:])
+	var out secret
+	m.Sum(out[:0])
+	return out
+}
+func (s *Session) DeriveRole(r Role) (RoleKey, error) {
+	if s == nil || s.state == nil {
+		return RoleKey{}, ErrProtocol
+	}
+	o := s.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.draining || !valid(r) {
+		return RoleKey{}, ErrProtocol
+	}
+	return RoleKey{state: &roleState{key: derive(o.master, o.id, r), id: o.id, digest: o.digest, role: r}}, nil
+}
+func (k RoleKey) Close() {
+	if k.state == nil {
+		return
+	}
+	o := k.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.closed = true
+	o.key = secret{}
+}
+
+type Connection struct{ state *connectionState }
+type connectionState struct {
+	mu             sync.Mutex
+	host           *sessionState
+	peer           *roleState
+	role           Role
+	sid            [16]byte
+	digest         [32]byte
+	hn, gn         [32]byte
+	id             uint64
+	phase          byte
+	failed, closed bool
+}
+
+func (Connection) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED guest connection]")) }
+func (Connection) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+func (s *Session) Host(r Role, nonce [32]byte) (*Connection, error) {
+	if s == nil || s.state == nil {
+		return nil, ErrProtocol
+	}
+	o := s.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.draining || !valid(r) || nonce == ([32]byte{}) || o.next == ^uint64(0) || o.live >= 256 {
+		return nil, ErrProtocol
+	}
+	o.next++
+	o.live++
+	return &Connection{state: &connectionState{host: o, role: r, sid: o.id, digest: o.digest, hn: nonce, id: o.next}}, nil
+}
+func NewPeer(k RoleKey, nonce [32]byte) (*Connection, error) {
+	if k.state == nil {
+		return nil, ErrProtocol
+	}
+	o := k.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || nonce == ([32]byte{}) || o.live >= 256 {
+		return nil, ErrProtocol
+	}
+	o.live++
+	return &Connection{state: &connectionState{peer: o, role: o.role, sid: o.id, digest: o.digest, gn: nonce}}, nil
+}
+
+const MessageSize = 155
+
+var tags = [4]string{"host-hello", "guest-challenge", "host-finish", "guest-accepted"}
+
+// lockOwner is called only with original connection.mu held. No owner operation
+// locks a connection except readiness, which follows the same connection→owner order.
+func (c *connectionState) lockOwner() (secret, bool, func()) {
+	if c.host != nil {
+		o := c.host
+		o.mu.Lock()
+		return derive(o.master, o.id, c.role), !o.closed && !o.draining, o.mu.Unlock
+	}
+	o := c.peer
+	o.mu.Lock()
+	return o.key, !o.closed, o.mu.Unlock
+}
+func wire(c *connectionState, phase byte, hn, gn [32]byte, id uint64, key secret) []byte {
+	b := make([]byte, MessageSize)
+	b[0] = 2
+	b[1] = phase
+	b[2] = byte(c.role)
+	copy(b[3:19], c.sid[:])
+	copy(b[19:51], c.digest[:])
+	copy(b[51:83], hn[:])
+	copy(b[83:115], gn[:])
+	binary.LittleEndian.PutUint64(b[115:123], id)
+	m := hmac.New(sha256.New, key[:])
+	m.Write([]byte(tags[phase]))
+	m.Write([]byte{0})
+	m.Write(b[:123])
+	copy(b[123:], m.Sum(nil))
+	return b
+}
+func (c *Connection) EncodeNext() ([]byte, error) {
+	if c == nil || c.state == nil {
+		return nil, ErrProtocol
+	}
+	o := c.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	key, known, unlock := o.lockOwner()
+	defer unlock()
+	defer clear(key[:])
+	allowed := o.host != nil && (o.phase == 0 || o.phase == 2) || o.peer != nil && (o.phase == 1 || o.phase == 3)
+	if o.closed || o.failed || !known || !allowed {
+		o.failed = true
+		return nil, ErrProtocol
+	}
+	gn := o.gn
+	if o.phase == 0 {
+		gn = [32]byte{}
+	}
+	b := wire(o, o.phase, o.hn, gn, o.id, key)
+	o.phase++
+	return b, nil
+}
+func (c *Connection) Accept(b []byte) error {
+	if c == nil || c.state == nil {
+		return ErrProtocol
+	}
+	o := c.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	key, known, unlock := o.lockOwner()
+	defer unlock()
+	defer clear(key[:])
+	allowed := o.host != nil && (o.phase == 1 || o.phase == 3) || o.peer != nil && (o.phase == 0 || o.phase == 2)
+	if o.closed || o.failed || !known || !allowed || len(b) != MessageSize {
+		o.failed = true
+		return ErrProtocol
+	}
+	hn, gn, id := o.hn, o.gn, o.id
+	if o.phase == 0 {
+		copy(hn[:], b[51:83])
+		id = binary.LittleEndian.Uint64(b[115:123])
+		gn = [32]byte{}
+		if hn == ([32]byte{}) || id == 0 {
+			o.failed = true
+			return ErrProtocol
+		}
+	}
+	if o.phase == 1 {
+		copy(gn[:], b[83:115])
+		if gn == ([32]byte{}) {
+			o.failed = true
+			return ErrProtocol
+		}
+	}
+	if !hmac.Equal(b, wire(o, o.phase, hn, gn, id, key)) {
+		o.failed = true
+		return ErrProtocol
+	}
+	// Publish peer nonce/source fields ONLY after authenticating the full message.
+	if o.phase == 0 {
+		o.hn = hn
+		o.id = id
+	}
+	if o.phase == 1 {
+		o.gn = gn
+	}
+	o.phase++
+	return nil
+}
+
+// Complete means host has accepted an authentic peer ACK, not IO/native readiness.
+func (c *Connection) Complete() bool {
+	if c == nil || c.state == nil {
+		return false
+	}
+	o := c.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	key, known, unlock := o.lockOwner()
+	defer unlock()
+	clear(key[:])
+	return o.host != nil && !o.closed && !o.failed && known && o.phase == 4
+}
+
+// Close disposes only a pure parser slot, never an actual native resource.
+func (c *Connection) Close() {
+	if c == nil || c.state == nil {
+		return
+	}
+	o := c.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed {
+		return
+	}
+	o.closed = true
+	if o.host != nil {
+		o.host.mu.Lock()
+		o.host.live--
+		o.host.mu.Unlock()
+	} else {
+		o.peer.mu.Lock()
+		o.peer.live--
+		o.peer.mu.Unlock()
+	}
+}
+func (s *Session) ObserveReady(c *Connection) error {
+	if s == nil || s.state == nil || c == nil || c.state == nil {
+		return ErrProtocol
+	}
+	o := c.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	a := s.state
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if o.host != a || o.failed || o.closed || o.phase != 4 || a.closed || a.draining || a.ready[o.role] {
+		return ErrProtocol
+	}
+	r := o.role
+	if r == SSHBinding && (!a.ready[NetworkControl] || !a.ready[NetworkData]) {
+		return ErrProtocol
+	}
+	if (r == Docker || r == Containerd || r == Guestagent) && !a.provisioned {
+		return ErrProtocol
+	}
+	a.ready[r] = true
+	return nil
+}
+
+// ObserveProvisionJoin is only a DATA transition; no actual process join is issued.
+func (s *Session) ObserveProvisionJoin() error {
+	if s == nil || s.state == nil {
+		return ErrProtocol
+	}
+	o := s.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.draining || o.provisioned || !o.ready[SSHBinding] {
+		return ErrProtocol
+	}
+	o.provisioned = true
+	return nil
+}
diff --git a/rdd/pkg/guestsession/session_test.go b/rdd/pkg/guestsession/session_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e29f8f5fd1d2440dbba41cdb91cfb30d6e7d8463
--- /dev/null
+++ b/rdd/pkg/guestsession/session_test.go
@@ -0,0 +1,412 @@
+package guestsession
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func session(t *testing.T, n byte) *Session {
+	t.Helper()
+	s, e := New([32]byte{n}, [16]byte{n}, []byte("canonical profile"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	return s
+}
+func pair(t *testing.T, s *Session, r Role, n byte) (*Connection, *Connection, RoleKey) {
+	t.Helper()
+	h, e := s.Host(r, [32]byte{n})
+	if e != nil {
+		t.Fatal(e)
+	}
+	k, e := s.DeriveRole(r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	p, e := NewPeer(k, [32]byte{n, 1})
+	if e != nil {
+		t.Fatal(e)
+	}
+	return h, p, k
+}
+func send(t *testing.T, from, to *Connection) []byte {
+	t.Helper()
+	b, e := from.EncodeNext()
+	if e != nil {
+		t.Fatal(e)
+	}
+	if len(b) != 155 {
+		t.Fatal("wire bound")
+	}
+	if e = to.Accept(b); e != nil {
+		t.Fatal(e)
+	}
+	return b
+}
+func exchange(t *testing.T, h, p *Connection) {
+	t.Helper()
+	send(t, h, p)
+	send(t, p, h)
+	send(t, h, p)
+	if h.Complete() {
+		t.Fatal("early ACK")
+	}
+	send(t, p, h)
+	if !h.Complete() || p.Complete() {
+		t.Fatal("directional completion")
+	}
+}
+func dispose(h, p *Connection, k RoleKey) { h.Close(); p.Close(); k.Close() }
+func TestIndependentOwnersAndWire(t *testing.T) {
+	s := session(t, 1)
+	h, p, k := pair(t, s, Docker, 7)
+	defer dispose(h, p, k)
+	hello, e := h.EncodeNext()
+	if e != nil {
+		t.Fatal(e)
+	}
+	want := make([]byte, 155)
+	want[0] = 2
+	want[2] = byte(Docker)
+	want[3] = 1
+	d := sha256.Sum256([]byte("canonical profile"))
+	copy(want[19:51], d[:])
+	want[51] = 7
+	binary.LittleEndian.PutUint64(want[115:123], 1)
+	master := make([]byte, 32)
+	master[0] = 1
+	deriveMAC := hmac.New(sha256.New, master)
+	deriveMAC.Write([]byte("orbwin-selected-guest-session-v2\x00"))
+	deriveMAC.Write([]byte{byte(Docker)})
+	deriveMAC.Write(want[3:19])
+	mac := hmac.New(sha256.New, deriveMAC.Sum(nil))
+	mac.Write([]byte("host-hello\x00"))
+	mac.Write(want[:123])
+	copy(want[123:], mac.Sum(nil))
+	if !bytes.Equal(hello, want) {
+		t.Fatal("independent wire/MAC")
+	}
+	if h.state.gn != ([32]byte{}) || p.state.id != 0 {
+		t.Fatal("pre-adopted context")
+	}
+	if p.Accept(hello) != nil || p.state.id != h.state.id {
+		t.Fatal("peer ID adoption")
+	}
+	send(t, p, h)
+	send(t, h, p)
+	if h.Complete() {
+		t.Fatal("before ack")
+	}
+	send(t, p, h)
+	if !h.Complete() || p.Complete() {
+		t.Fatal("direction")
+	}
+}
+func TestDirectionReplayAndMACBeforePublish(t *testing.T) {
+	s := session(t, 1)
+	h, p, k := pair(t, s, Docker, 1)
+	hello, _ := h.EncodeNext()
+	if h.Accept(hello) == nil || h.Complete() {
+		t.Fatal("host self-feed")
+	}
+	dispose(h, p, k)
+	h, p, k = pair(t, s, Docker, 2)
+	if _, e := p.EncodeNext(); e == nil {
+		t.Fatal("peer originates hello")
+	}
+	dispose(h, p, k)
+	h, p, k = pair(t, s, Docker, 3)
+	send(t, h, p)
+	challenge, _ := p.EncodeNext()
+	challenge[154] ^= 1
+	if h.Accept(challenge) == nil || h.state.gn != ([32]byte{}) {
+		t.Fatal("unauth nonce published")
+	}
+	dispose(h, p, k)
+	h, p, k = pair(t, s, Docker, 4)
+	hello, _ = h.EncodeNext()
+	hello[154] ^= 1
+	if p.Accept(hello) == nil || p.state.id != 0 || p.state.hn != ([32]byte{}) {
+		t.Fatal("unauth peer context")
+	}
+	dispose(h, p, k)
+	h, p, k = pair(t, s, Docker, 5)
+	old := send(t, h, p)
+	if p.Accept(old) == nil {
+		t.Fatal("duplicate hello")
+	}
+	dispose(h, p, k)
+	oldH, oldP, oldK := pair(t, s, Docker, 6)
+	send(t, oldH, oldP)
+	oldChallenge, _ := oldP.EncodeNext()
+	dispose(oldH, oldP, oldK)
+	h, p, k = pair(t, s, Docker, 6)
+	h.EncodeNext()
+	if h.Accept(oldChallenge) == nil {
+		t.Fatal("attempt ID replay")
+	}
+	dispose(h, p, k)
+}
+func TestWrongContextAndPartialACKLocalOnly(t *testing.T) {
+	for _, what := range []string{"key", "role", "session", "profile", "direction"} {
+		t.Run(what, func(t *testing.T) {
+			s := session(t, 1)
+			h, e := s.Host(Docker, [32]byte{1})
+			if e != nil {
+				t.Fatal(e)
+			}
+			other := session(t, 1)
+			r := Docker
+			switch what {
+			case "key":
+				other.state.master[1] = 2
+			case "role":
+				r = Containerd
+			case "session":
+				other.state.id[1] = 2
+			case "profile":
+				other.state.digest[1] = 2
+			}
+			k, _ := other.DeriveRole(r)
+			p, _ := NewPeer(k, [32]byte{2})
+			b, _ := h.EncodeNext()
+			if what == "direction" {
+				b[1] = 2
+			}
+			if p.Accept(b) == nil {
+				t.Fatal("foreign input")
+			}
+			dispose(h, p, k)
+			a, bp, bk := pair(t, s, Docker, 3)
+			exchange(t, a, bp)
+			dispose(a, bp, bk)
+		})
+	}
+	for _, cut := range []int{0, 1, 122, 123, 154, 155} {
+		t.Run(fmt.Sprint(cut), func(t *testing.T) {
+			s := session(t, 1)
+			h, p, k := pair(t, s, Docker, 1)
+			send(t, h, p)
+			send(t, p, h)
+			send(t, h, p)
+			ack, _ := p.EncodeNext()
+			bad := append([]byte(nil), ack...)
+			if cut == 155 {
+				bad[154] ^= 1
+			} else {
+				bad = bad[:cut]
+			}
+			if h.Accept(bad) == nil || h.Complete() || h.Accept(ack) == nil {
+				t.Fatal("ACK retry/forgery")
+			}
+			dispose(h, p, k)
+		})
+	}
+}
+func TestWrapperRebindZeroAndAliasAccounting(t *testing.T) {
+	original := session(t, 1)
+	alias := *original
+	other := session(t, 2)
+	h, p, k := pair(t, original, Docker, 1)
+	*original = *other
+	exchange(t, h, p)
+	if original.ObserveReady(h) == nil {
+		t.Fatal("wrong original ready")
+	}
+	if alias.ObserveReady(h) != ErrProtocol {
+		t.Fatal("Docker before provision")
+	}
+	h.Close()
+	if alias.state.live != 0 || other.state.live != 0 {
+		t.Fatal("wrong close accounting")
+	}
+	p.Close()
+	k.Close()
+	h, p, k = pair(t, &alias, Docker, 2)
+	*original = Session{}
+	exchange(t, h, p)
+	dispose(h, p, k)
+	h, p, k = pair(t, &alias, NetworkControl, 3)
+	exchange(t, h, p)
+	copyAlias := alias
+	if copyAlias.ObserveReady(h) != nil {
+		t.Fatal("same original alias ready")
+	}
+	alias.Close()
+	*original = *other
+	if h.Complete() {
+		t.Fatal("revived after wrapper overwrite")
+	}
+	if _, e := h.EncodeNext(); e == nil {
+		t.Fatal("revived encode")
+	}
+	dispose(h, p, k)
+	s := session(t, 4)
+	h, p, k = pair(t, s, Docker, 1)
+	send(t, h, p)
+	old := k
+	replacement, _ := other.DeriveRole(Docker)
+	k = replacement
+	old.Close()
+	if _, e := p.EncodeNext(); e == nil {
+		t.Fatal("retargeted peer key")
+	}
+	h.Close()
+	p.Close()
+	k.Close()
+	var zero Session
+	var conn Connection
+	if zero.ObserveReady(&conn) == nil || conn.Accept(nil) == nil || conn.Complete() {
+		t.Fatal("zero values")
+	}
+	zero.Close()
+	conn.Close()
+}
+func TestParallelOutOfOrderTwoEnginesAndLiveBudgets(t *testing.T) {
+	a, b := session(t, 1), session(t, 2)
+	var wg sync.WaitGroup
+	for _, s := range []*Session{a, b} {
+		hs := make([]*Connection, 128)
+		ps := make([]*Connection, 128)
+		ks := make([]RoleKey, 128)
+		for i := range hs {
+			hs[i], ps[i], ks[i] = pair(t, s, Docker, byte(i+1))
+		}
+		for i := 127; i >= 0; i-- {
+			h, p, k := hs[i], ps[i], ks[i]
+			wg.Add(1)
+			go func() { defer wg.Done(); exchange(t, h, p); dispose(h, p, k) }()
+		}
+	}
+	wg.Wait()
+	for i := 0; i < 5000; i++ {
+		h, p, k := pair(t, a, Docker, 1)
+		exchange(t, h, p)
+		dispose(h, p, k)
+	}
+	if a.state.live != 0 {
+		t.Fatal("lifetime exhaustion/leak")
+	}
+	a.state.next = ^uint64(0)
+	if _, e := a.Host(Docker, [32]byte{1}); e == nil {
+		t.Fatal("overflow")
+	}
+	s := session(t, 3)
+	var hs []*Connection
+	for i := 0; i < 256; i++ {
