+		return false
+	}
+	p := 6
+	if p < len(a) && a[p] == "--debug" {
+		p++
+	}
+	if p >= len(a) || a[p] != "orbwin" {
+		return false
+	}
+	p++
+	seen := map[string]bool{}
+	for p < len(a) {
+		if p+1 >= len(a) || (a[p] != "--orbwin-proxy-binding" && a[p] != "--orbwin-native-lifetime") || seen[a[p]] || a[p+1] == "" || len(a[p+1]) > 2048 {
+			return false
+		}
+		seen[a[p]] = true
+		p += 2
+	}
+	return true
+}
