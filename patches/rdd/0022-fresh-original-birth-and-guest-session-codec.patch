+//go:build windows
+
+package managementconfig
+
+import "testing"
+
+// Compile-only native guard tests. No fabricated native owner reaches a syscall.
+func TestManagedObservationOriginalOwnerRefusals(t *testing.T) {
+	for _, owner := range []any{nil, (*ManagedHostagentBirth)(nil), (*FreshRuntimeObservation)(nil), (*nativeManagedNamespace)(nil), &ManagedHostagentBirth{}, &FreshRuntimeObservation{}, &nativeManagedNamespace{}} {
+		f := newManagedObservationFrame(owner)
+		if f != nil && (f.original() || f.begin()) {
+			t.Fatal("unborn owner accepted")
+		}
+	}
+	b := &ManagedHostagentBirth{}
+	b.self = b
+	f := newManagedObservationFrame(b)
+	if f.original() || f.begin() {
+		t.Fatal("self pointer is not actual launch origin")
+	}
+	n := &nativeManagedNamespace{}
+	n.self = &ManagedRuntimeNamespace{native: n}
+	n.created = &Created{managedNamespace: n.self}
+	f = newManagedObservationFrame(n)
+	if f.original() || f.begin() {
+		t.Fatal("unregistered namespace accepted")
+	}
+	copyBirth := &ManagedHostagentBirth{self: b}
+	f = newManagedObservationFrame(copyBirth)
+	if f.original() || f.begin() {
+		t.Fatal("copied native owner accepted")
+	}
+}
