+	case *ManagedHostagentBirth:
+		o.fence()
+	case *FreshRuntimeObservation:
+		if edge := o.birthBorrow; edge != nil && edge.witness == o && edge.birth != nil {
+			edge.birth.observationUnknown.Store(true)
+			if edge.birth.parent != nil {
+				edge.birth.parent.managedUnknown.Store(true)
