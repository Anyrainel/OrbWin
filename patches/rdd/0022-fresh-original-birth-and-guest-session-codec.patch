+	w := newManagedObservationFrame(b.owner)
+	if w == nil || !w.begin() {
+		return ErrUpgrade
+	}
+	defer w.preservePanic()
+	w.input = process
+	w.err = w.processWait(process)
+	if w.finish(w.err) != nil {
