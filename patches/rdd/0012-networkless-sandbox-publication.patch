+func TestNetworklessSandboxDoesNotWaitForPublicationBeforeCNIAttachment(t *testing.T) {
+	body := []byte(`{"HostConfig":{"NetworkMode":"none","PortBindings":{"80/tcp":[{"HostPort":""}]}},"Future":9007199254740993}`)
+	changed, err := rewriteCreatePorts(context.Background(), nil, "", body, func(string) (string, error) {
+		t.Fatal("network-less sandbox reserved a Windows port")
+		return "", nil
+	})
+	if err != nil || !bytes.Equal(changed, body) {
+		t.Fatalf("changed network-less request: %s %v", changed, err)
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	_, port, _ := net.SplitHostPort(listener.Addr().String())
+	for _, mode := range []string{"none", "bridge"} {
+		for _, outcome := range []int{204, 500} {
+			mutations := 0
+			transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "POST" {
+					mutations++
+					if r.URL.Path != "/containers/"+strings.Repeat("a", 64)+"/start" {
+						t.Error("mutable target")
+					}
+					w.WriteHeader(outcome)
+					return
+				}
+				fmt.Fprintf(w, `{"Id":%q,"HostConfig":{"NetworkMode":%q,"PortBindings":{"80/tcp":[{"HostPort":%q}]}},"State":{"Running":false}}`, strings.Repeat("a", 64), mode, port)
+			}))
+			response := httptest.NewRecorder()
+			dockerHandlerPorts(transport, func(string, string) bool { return false }).ServeHTTP(response, httptest.NewRequest("POST", "/containers/sandbox/start", nil))
+			if mode == "none" {
+				if response.Code != outcome || mutations != 1 {
+					t.Fatalf("sandbox blocked or backend error hidden: %d %d", response.Code, mutations)
+				}
+			} else if response.Code != 409 || mutations != 0 {
+				t.Fatal("bridge port conflict bypassed")
+			}
+		}
+	}
+}
