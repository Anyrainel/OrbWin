+//go:build !windows
+
+// SPDX-License-Identifier: Apache-2.0
+package process
+
+import "fmt"
+
+type DiagnosticIdentity struct {
+	Executable string `json:"executable"`
+	Created    uint64 `json:"created"`
+}
+
+func RegisterDiagnosticIdentity(string) (DiagnosticIdentity, func(), error) {
+	return DiagnosticIdentity{}, nil, fmt.Errorf("diagnostic process generations unsupported on this platform")
+}
+func ProbeDiagnosticIdentity(string, int, DiagnosticIdentity) (string, string) {
+	return "unknown", "unsupportedPlatform"
+}
diff --git a/rdd/pkg/util/process/service_identity_windows.go b/rdd/pkg/util/process/service_identity_windows.go
new file mode 100644
index 000000000..2c0eb5d94
--- /dev/null
+++ b/rdd/pkg/util/process/service_identity_windows.go
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: Apache-2.0
+package process
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/windows"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// DiagnosticIdentity is process-generation evidence, not lifecycle state.
+type DiagnosticIdentity struct {
+	Executable string `json:"executable"`
+	Created    uint64 `json:"created"`
+}
+
+func diagnosticProcess(pid int) (DiagnosticIdentity, bool, error) {
+	var identity DiagnosticIdentity
+	if pid <= 0 || uint64(pid) > uint64(^uint32(0)) {
+		return identity, false, fmt.Errorf("invalid process ID")
+	}
+	handle, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, uint32(pid))
+	if errors.Is(err, windows.ERROR_INVALID_PARAMETER) {
+		return identity, false, nil
+	}
+	if err != nil {
+		return identity, false, err
+	}
+	defer windows.CloseHandle(handle)
+	wait, err := windows.WaitForSingleObject(handle, 0)
+	if err != nil {
+		return identity, false, err
+	}
+	if wait != windows.WAIT_OBJECT_0 && wait != uint32(windows.WAIT_TIMEOUT) {
+		return identity, false, fmt.Errorf("unexpected process wait result")
+	}
+	var creation, exit, kernel, user windows.Filetime
+	if err = windows.GetProcessTimes(handle, &creation, &exit, &kernel, &user); err != nil {
+		return identity, false, err
+	}
+	buffer := make([]uint16, 32768)
+	size := uint32(len(buffer))
+	if err = windows.QueryFullProcessImageName(handle, 0, &buffer[0], &size); err != nil {
+		return identity, false, err
+	}
+	image, err := filepath.EvalSymlinks(windows.UTF16ToString(buffer[:size]))
+	if err != nil {
+		return identity, false, err
+	}
+	identity = DiagnosticIdentity{Executable: image, Created: uint64(creation.HighDateTime)<<32 | uint64(creation.LowDateTime)}
+	return identity, wait == uint32(windows.WAIT_TIMEOUT), nil
+}
+
+func diagnosticKey(directory string, identity DiagnosticIdentity) (string, error) {
+	directory, err := filepath.EvalSymlinks(directory)
+	if err != nil {
+		return "", err
+	}
+	// Windows identity names are case insensitive; paths cannot contain NUL.
+	sum := sha256.Sum256([]byte(strings.ToLower(directory) + "\x00" + strings.ToLower(identity.Executable) + fmt.Sprintf("\x00%d", identity.Created)))
+	return fmt.Sprintf("diagnostic-v1-%x", sum), nil
+}
+
+// RegisterDiagnosticIdentity holds a nonsignalled, generation-scoped named event.
+// Only the serve process calls this; no state file is consulted to run a service.
+func RegisterDiagnosticIdentity(directory string) (DiagnosticIdentity, func(), error) {
+	identity, live, err := diagnosticProcess(os.Getpid())
+	if err != nil {
+		return identity, nil, err
+	}
+	if !live {
+		return identity, nil, fmt.Errorf("current process exited")
+	}
+	key, err := diagnosticKey(directory, identity)
+	if err != nil {
+		return identity, nil, err
+	}
+	name, err := windows.UTF16PtrFromString(interruptEventName(key, os.Getpid()))
+	if err != nil {
+		return identity, nil, err
+	}
+	handle, err := windows.CreateEvent(nil, 1, 0, name)
+	if err != nil {
+		if handle != 0 {
+			windows.CloseHandle(handle)
+		}
+		return identity, nil, err
+	}
+	return identity, func() { windows.CloseHandle(handle) }, nil
+}
+
+// ProbeDiagnosticIdentity never signals an event or changes a PID file. Errors,
+// foreign/recycled PIDs and absent ownership markers are all unknown, not stopped.
+func ProbeDiagnosticIdentity(directory string, pid int, want DiagnosticIdentity) (string, string) {
+	actual, live, err := diagnosticProcess(pid)
+	if err != nil {
+		return "unknown", "processInspectionFailed"
+	}
+	if actual.Created != 0 && (!strings.EqualFold(actual.Executable, want.Executable) || actual.Created != want.Created) {
+		return "unknown", "processIdentityMismatch"
+	}
+	if !live {
+		return "stopped", "processExited"
+	}
+	key, err := diagnosticKey(directory, want)
+	if err != nil {
+		return "unknown", "homeInspectionFailed"
+	}
+	name, err := windows.UTF16PtrFromString(interruptEventName(key, pid))
+	if err != nil {
+		return "unknown", "identityNameFailed"
+	}
+	handle, err := windows.OpenEvent(windows.SYNCHRONIZE, false, name)
+	if err != nil {
+		return "unknown", "ownershipMarkerUnavailable"
+	}
+	defer windows.CloseHandle(handle)
+	// Check process generation again after opening the marker, so a process that
+	// exited/recycled during observation cannot be reported as confirmed running.
+	after, live, err := diagnosticProcess(pid)
+	if err != nil || !live || after != actual {
+		return "unknown", "processChangedDuringProbe"
+	}
+	return "running", "identityVerified"
+}
