@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: Apache-2.0
+package process
+
+import (
+	"os"
+	"testing"
+)
+
+// These checks inspect only the test process and hold nonsignalled diagnostic
+// events. They never launch, signal, kill or inspect an engine/service process.
+func TestDiagnosticIdentityMarkerAndGeneration(t *testing.T) {
+	directory := t.TempDir()
+	identity, release, err := RegisterDiagnosticIdentity(directory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, duplicateRelease, err := RegisterDiagnosticIdentity(directory); err == nil {
+		duplicateRelease()
+		release()
+		t.Fatal("duplicate marker registration accepted")
+	}
+	state, reason := ProbeDiagnosticIdentity(directory, os.Getpid(), identity)
+	if state != "running" {
+		release()
+		t.Fatal(state, reason)
+	}
+	foreign := identity
+	foreign.Created++
+	if state, _ := ProbeDiagnosticIdentity(directory, os.Getpid(), foreign); state != "unknown" {
+		release()
+		t.Fatal(state)
+	}
+	if state, _ := ProbeDiagnosticIdentity(t.TempDir(), os.Getpid(), identity); state != "unknown" {
+		release()
+		t.Fatal(state)
+	}
+	release()
+	if state, _ := ProbeDiagnosticIdentity(directory, os.Getpid(), identity); state != "unknown" {
+		t.Fatal(state)
+	}
+}
