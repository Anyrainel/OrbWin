@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin adaptation regression coverage.
+//go:build windows
+
+package instance
+
+import (
+	"fmt"
+	"path/filepath"
+	"testing"
+
+	"github.com/Microsoft/go-winio"
+	"gotest.tools/v3/assert"
+)
+
+func TestDockerInstanceIsolation(t *testing.T) {
+	for _, suffix := range []string{"orbwin", "2", "qualification"} {
+		t.Run(suffix, func(t *testing.T) {
+			runTestProcess(t, func(t *testing.T) {
+				want := `\\.\pipe\docker-rancher-desktop-` + suffix
+				assert.Equal(t, want, DockerSocket())
+				assert.Equal(t, "npipe:////./pipe/docker-rancher-desktop-"+suffix, DockerEndpoint())
+			}, "RDD_INSTANCE="+suffix)
+		})
+	}
+}
+
+func TestIndependentPipeListeners(t *testing.T) {
+	// Real Windows listener allocation, with unique names; never bind a user's
+	// actual engine endpoint. Both listeners must coexist and reject takeover.
+	for _, suffix := range []string{"orbwin", "rancher"} {
+		// Use the test's temporary directory base as a per-run identity.
+		name := fmt.Sprintf(`\\.\pipe\orbwin-test-%s-%s`, filepath.Base(t.TempDir()), suffix)
+		ln, err := winio.ListenPipe(name, nil)
+		assert.NilError(t, err)
+		t.Cleanup(func() { ln.Close() })
+		duplicate, err := winio.ListenPipe(name, nil)
+		if err == nil {
+			duplicate.Close()
+			t.Fatalf("occupied pipe accepted a second listener: %s", name)
+		}
+	}
+}
