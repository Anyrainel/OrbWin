diff --git a/rdd/pkg/socketbridge/host_identity_windows_test.go b/rdd/pkg/socketbridge/host_identity_windows_test.go
new file mode 100644
index 000000000..8cbdb89fc
--- /dev/null
+++ b/rdd/pkg/socketbridge/host_identity_windows_test.go
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin adaptation: the bridge and endpoint discovery must share one identity.
+//go:build windows
+
+package socketbridge
+
+import (
+	"testing"
+
+	"github.com/go-logr/logr"
+	"github.com/linuxkit/virtsock/pkg/hvsock"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+)
+
+func TestDockerBridgeUsesAdvertisedInstanceSocket(t *testing.T) {
+	b := NewDockerHostBridge(hvsock.GUID{}, logr.Discard())
+	if b.pipeName != instance.DockerSocket() {
+		t.Fatalf("bridge %q differs from advertised socket %q", b.pipeName, instance.DockerSocket())
+	}
+	if b.pipeName == `\\.\pipe\docker_engine` || b.pipeName == `\\.\pipe\dockerDesktopLinuxEngine` {
+		t.Fatalf("bridge selected a foreign pipe: %q", b.pipeName)
+	}
+}
