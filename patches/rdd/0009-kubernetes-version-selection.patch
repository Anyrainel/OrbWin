+func (v *AppValidator) ValidateUpdate(_ context.Context, oldObj, newObj *v1alpha1.App) (ctrlwebhookadmission.Warnings, error) {
+	if warnings, err := v.validate(newObj); err != nil {
+		return warnings, err
