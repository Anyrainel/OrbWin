index 0000000000000000000000000000000000000000..8327fae505ed71ac7cc4f64d8fd1dd5e539e0ee9
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_build_origin_test.go
@@ -0,0 +1,90 @@
+package managementconfig
+
+import "testing"
+
+func TestRuntimeBuildOriginDistinguishesKnownSourceCloseFromUnknown(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		for _, unknown := range []bool{false, true} {
+			var closeErr error
+			if unknown {
+				closeErr = ErrUpgrade
+			}
+			fences := 0
+			err := runtimeBuildSourceLeaseState(closed, closeErr, func() { fences++ })
+			if (err != nil) != (closed || unknown) || fences != map[bool]int{true: 1, false: 0}[unknown] {
+				t.Fatal("source closure confused with actual uncertainty", closed, unknown, fences, err)
+			}
+		}
+	}
+}
+
+func TestRuntimeBuildOriginCannotAttachCommitBeforeMappedIncomingSelf(t *testing.T) {
+	for fail := runtimeBuildDuplicateLease; fail <= runtimeBuildVerify; fail++ {
+		var order []runtimeBuildOriginStep
+		if runtimeBuildOriginSequence(func(step runtimeBuildOriginStep) error {
+			order = append(order, step)
+			if step == fail {
+				return ErrUpgrade
+			}
+			return nil
+		}) == nil || len(order) != int(fail)+1 {
+			t.Fatal("construction advanced after an unbound native prerequisite", fail, order)
+		}
+		for _, step := range order {
+			if fail < runtimeBuildCaptureMapping && step == runtimeBuildCaptureCommit {
+				t.Fatal("commit attached to unproven image")
+			}
+		}
+	}
+	var order []runtimeBuildOriginStep
+	if runtimeBuildOriginSequence(func(step runtimeBuildOriginStep) error { order = append(order, step); return nil }) != nil || len(order) != 6 || order[3] != runtimeBuildCaptureMapping || order[4] != runtimeBuildCaptureCommit {
+		t.Fatal("native mapping/provenance order", order)
+	}
+}
+
+func TestRuntimeBuildOriginActualReleaseStopsFirstAndCachesUnknown(t *testing.T) {
+	for fail := -1; fail < 5; fail++ {
+		attempt := new(runtimeStorageCloseAttempt)
+		var order []int
+		fences := 0
+		err := runtimeBuildOriginRelease(attempt, 5, func(index int) error {
+			order = append(order, index)
+			if index == fail {
+				return ErrUpgrade
+			}
+			return nil
+		}, func() { fences++ })
+		if (err != nil) != (fail >= 0) || fences != map[bool]int{true: 1, false: 0}[fail >= 0] {
+			t.Fatal("release outcome", fail, order, fences)
+		}
+		expected := 5
+		if fail >= 0 {
+			expected = 5 - fail
+		}
+		if len(order) != expected {
+			t.Fatal("closed after uncertain first result", fail, order)
+		}
+		for at, index := range order {
+			if index != 4-at {
+				t.Fatal("resource release order", order)
+			}
+		}
+		second := runtimeBuildOriginRelease(attempt, 5, func(int) error { t.Fatal("repeated native graph close"); return nil }, func() { t.Fatal("fence repeated by model") })
+		if (second != nil) != (err != nil) {
+			t.Fatal("cached graph reply changed")
+		}
+	}
+	attempt := new(runtimeStorageCloseAttempt)
+	fences := 0
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("panic swallowed")
+			}
+		}()
+		_ = runtimeBuildOriginRelease(attempt, 5, func(int) error { panic("native close reply lost") }, func() { fences++ })
+	}()
+	if fences != 1 || runtimeBuildOriginRelease(attempt, 5, func(int) error { t.Fatal("retry after panic"); return nil }, func() {}) == nil {
+		t.Fatal("panic release not cached/quarantined")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_build_origin_windows.go b/rdd/pkg/managementconfig/upgrade_runtime_build_origin_windows.go
