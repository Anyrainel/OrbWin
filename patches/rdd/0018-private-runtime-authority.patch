+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeOperationNativeCaptureSourceGuards(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	before := func() int {
+		runtimeStorageDomain.Lock()
+		defer runtimeStorageDomain.Unlock()
+		return len(runtimeStorageDomain.owners)
+	}()
+	for _, root := range []*InstanceRoot{nil, {}, {home: "C:\\caller", sid: "caller"}} {
+		if n, e := allocateNativeRuntimeStorageCapture(ctx, root); e == nil || n != nil {
+			t.Fatal("caller data allocated capture owner")
+		}
+	}
+	if n, e := allocateNativeRuntimeStorageCapture(context.Background(), &InstanceRoot{}); e == nil || n != nil {
+		t.Fatal("unbounded allocator")
+	}
+	if n, e := allocateNativeRuntimeStorageCapture(ctx, nil); e == nil || n != nil {
+		t.Fatal("nil root")
+	}
+	actual := &nativeRuntimeStorage{}
+	actual.captureSelf = actual
+	foreign := &nativeRuntimeStorage{captureSelf: actual}
+	for _, n := range []*nativeRuntimeStorage{nil, {}, foreign, actual} {
+		if n.captureNative(ctx) == nil {
+			t.Fatal("zero/copied/unregistered native source reached effect core")
+		}
+	}
+	after := func() int {
+		runtimeStorageDomain.Lock()
+		defer runtimeStorageDomain.Unlock()
+		return len(runtimeStorageDomain.owners)
+	}()
+	if before != after {
+		t.Fatal("invalid source left registered owner")
+	}
+}
