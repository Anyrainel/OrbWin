diff --git a/rdd/pkg/managementconfig/upgrade_sqlite.go b/rdd/pkg/managementconfig/upgrade_sqlite.go
new file mode 100644
index 0000000000000000000000000000000000000000..97cd22f7149bab03b8d4f8759babcfc0600ca94b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sqlite.go
@@ -0,0 +1,219 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/binary"
+	"encoding/json"
+	"hash"
+	"strconv"
+	"strings"
+	"sync"
+	"unicode/utf8"
+)
+
+// Only native fixed-role copy preparation may mint this pin, after positively
+// retired writers, a sealed checkpoint and private-at-CREATE working files.
+// Neither the original checkpoint nor any caller-selected path is an input.
+type upgradeDatabasePin struct {
+	mu             sync.Mutex
+	transaction    string
+	workingRoot    UpgradeObject
+	active, closed bool
+	uncertain      bool
+	retained       []any
+}
+type upgradeSQLiteFile struct {
+	path   string
+	role   string
+	pin    *upgradeDatabasePin
+	object UpgradeObject
+}
+
+func (f *upgradeSQLiteFile) valid(role string) bool {
+	if f == nil || f.pin == nil {
+		return false
+	}
+	f.pin.mu.Lock()
+	defer f.pin.mu.Unlock()
+	return !f.pin.closed && !f.pin.uncertain && upgradeHex(f.pin.transaction, 32) && f.pin.workingRoot.valid() && f.path != "" && f.role == role && f.object.valid() && f.object.Volume == f.pin.workingRoot.Volume
+}
+
+func (p *upgradeDatabasePin) begin() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.active || p.uncertain {
+		return false
+	}
+	p.active = true
+	return true
+}
+func (p *upgradeDatabasePin) end() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.uncertain {
+		p.active = false
+	}
+}
+func (p *upgradeDatabasePin) unknown(resources ...any) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.uncertain = true
+	p.active = true
+	p.retained = append(p.retained, resources...)
+}
+
+const maxUpgradeValueBytes = 16 << 20
+
+// Exact structural whitelist for the selected kine v1.14.2 SQLite schema.
+// Source: pkg/drivers/sqlite/sqlite.go in that pinned module; no controllers or
+// kine startup/migrations execute while validating a cold private working copy.
+var upgradeSchema = map[string]string{
+	"table/kine":                           "CREATE TABLE kine (id INTEGER PRIMARY KEY AUTOINCREMENT,name INTEGER,created INTEGER,deleted INTEGER,create_revision INTEGER,prev_revision INTEGER,lease INTEGER,value BLOB,old_value BLOB)",
+	"table/sqlite_sequence":                "CREATE TABLE sqlite_sequence(name,seq)",
+	"index/kine_name_index":                "CREATE INDEX kine_name_index ON kine (name)",
+	"index/kine_name_id_index":             "CREATE INDEX kine_name_id_index ON kine (name,id)",
+	"index/kine_id_deleted_index":          "CREATE INDEX kine_id_deleted_index ON kine (id,deleted)",
+	"index/kine_prev_revision_index":       "CREATE INDEX kine_prev_revision_index ON kine (prev_revision)",
+	"index/kine_name_prev_revision_uindex": "CREATE UNIQUE INDEX kine_name_prev_revision_uindex ON kine (name,prev_revision)",
+}
+
+func upgradeNormalizedSQL(value string) string {
+	fields := strings.Fields(strings.ToLower(value))
+	var result strings.Builder
+	for i := 0; i < len(fields); i++ {
+		if fields[i] == "if" && i+2 < len(fields) && fields[i+1] == "not" && fields[i+2] == "exists" {
+			i += 2
+			continue
+		}
+		result.WriteString(fields[i])
+	}
+	return result.String()
+}
+
+func validateUpgradeSchema(ctx context.Context, conn *sql.Conn) error {
+	var invalid int64
+	if conn.QueryRowContext(ctx, `SELECT count(*) FROM sqlite_master WHERE typeof(type)!='text' OR typeof(name)!='text' OR typeof(tbl_name)!='text' OR typeof(sql)!='text' OR length(CAST(type AS BLOB))>16 OR length(CAST(name AS BLOB))>128 OR length(CAST(tbl_name AS BLOB))>128 OR length(CAST(sql AS BLOB))>4096`).Scan(&invalid) != nil || invalid != 0 {
+		return ErrUpgrade
+	}
+	rows, err := conn.QueryContext(ctx, `SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY type,name`)
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer rows.Close()
+	seen := map[string]bool{}
+	for rows.Next() {
+		var kind, name, table, statement string
+		if rows.Scan(&kind, &name, &table, &statement) != nil {
+			return ErrUpgrade
+		}
+		key := kind + "/" + name
+		want, ok := upgradeSchema[key]
+		if !ok || seen[key] || len(seen) >= len(upgradeSchema) || len(statement) > 4096 || upgradeNormalizedSQL(statement) != upgradeNormalizedSQL(want) || (table != "kine" && table != "sqlite_sequence") {
+			return ErrUpgrade
+		}
+		seen[key] = true
+	}
+	if rows.Err() != nil || len(seen) != len(upgradeSchema) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func upgradeKeyAllowed(value string) bool {
+	if !utf8.ValidString(value) || len(value) < 1 || len(value) > 8192 || strings.IndexFunc(value, func(r rune) bool { return r < 32 || r == 127 }) >= 0 {
+		return false
+	}
+	if strings.HasPrefix(value, "/registry/") {
+		return true
+	}
+	if value == "compact_rev_key" || value == "compact_rev_key_apiserver" {
+		return true
+	}
+	if suffix, ok := strings.CutPrefix(value, "gap-"); ok {
+		n, e := strconv.ParseUint(suffix, 10, 63)
+		return e == nil && n > 0 && strconv.FormatUint(n, 10) == suffix
+	}
+	return false
+}
+func upgradeHashPart(h hash.Hash, value []byte) {
+	var length [8]byte
+	binary.BigEndian.PutUint64(length[:], uint64(len(value)))
+	_, _ = h.Write(length[:])
+	_, _ = h.Write(value)
+}
+
+// Logical hash preserves every row, revision, tombstone, opaque value/old_value
+// (including application credentials) and SQLite's next-ID sequence. Values
+// never enter a result, diagnostic, journal, URL or generic export interface.
+func snapshotUpgradeDatabase(ctx context.Context, conn *sql.Conn) (UpgradeSnapshot, error) {
+	var result UpgradeSnapshot
+	if validateUpgradeSchema(ctx, conn) != nil {
+		return result, ErrUpgrade
+	}
+	var integrity string
+	if conn.QueryRowContext(ctx, `PRAGMA integrity_check`).Scan(&integrity) != nil || integrity != "ok" {
+		return result, ErrUpgrade
+	}
+	// Evaluate storage classes and byte lengths inside SQLite BEFORE the driver
+	// materializes any row payload into Go. TEXT length() counts characters and
+	// cannot bound C.GoStringN allocation; values must be blob/null in this schema.
+	var invalidRows int64
+	if conn.QueryRowContext(ctx, `SELECT count(*) FROM kine WHERE typeof(id)!='integer' OR typeof(name)!='text' OR typeof(created)!='integer' OR typeof(deleted)!='integer' OR typeof(create_revision)!='integer' OR typeof(prev_revision)!='integer' OR typeof(lease)!='integer' OR typeof(value) NOT IN ('blob','null') OR typeof(old_value) NOT IN ('blob','null') OR length(CAST(name AS BLOB))>8192 OR length(CAST(value AS BLOB))>16777216 OR length(CAST(old_value AS BLOB))>16777216`).Scan(&invalidRows) != nil || invalidRows != 0 {
+		return result, ErrUpgrade
+	}
+	rows, err := conn.QueryContext(ctx, `SELECT id,name,created,deleted,create_revision,prev_revision,lease,value,old_value FROM kine ORDER BY id`)
+	if err != nil {
+		return result, ErrUpgrade
+	}
+	defer rows.Close()
+	h := sha256.New()
+	for rows.Next() {
+		if ctx.Err() != nil {
+			return UpgradeSnapshot{}, ErrUpgrade
+		}
+		var id int64
+		var name string
+		var created, deleted, createRev, previous, lease sql.NullInt64
+		var value, old []byte
+		if rows.Scan(&id, &name, &created, &deleted, &createRev, &previous, &lease, &value, &old) != nil {
+			return UpgradeSnapshot{}, ErrUpgrade
+		}
+		if id < 1 || uint64(id) <= result.LastRevision || !upgradeKeyAllowed(name) || !created.Valid || created.Int64 < 0 || created.Int64 > 1 || !deleted.Valid || deleted.Int64 < 0 || deleted.Int64 > 1 || !createRev.Valid || !previous.Valid || !lease.Valid || len(value) > maxUpgradeValueBytes || len(old) > maxUpgradeValueBytes {
+			clear(value)
+			clear(old)
+			return UpgradeSnapshot{}, ErrUpgrade
+		}
+		metadata, _ := json.Marshal(struct {
+			ID                                        int64
+			Created, Deleted, Create, Previous, Lease sql.NullInt64
+			ValueNull, OldNull                        bool
+		}{id, created, deleted, createRev, previous, lease, value == nil, old == nil})
+		upgradeHashPart(h, metadata)
+		upgradeHashPart(h, []byte(name)) // raw length-delimited key bytes, never JSON replacement
+		upgradeHashPart(h, value)
+		upgradeHashPart(h, old)
+		clear(value)
+		clear(old)
+		result.Rows++
+		result.LastRevision = uint64(id)
+	}
+	if rows.Err() != nil || rows.Close() != nil || result.Rows == 0 {
+		return UpgradeSnapshot{}, ErrUpgrade
+	}
+	var sequenceRows, invalidSequences int64
+	if conn.QueryRowContext(ctx, `SELECT count(*),coalesce(sum(CASE WHEN typeof(name)!='text' OR name!='kine' OR typeof(seq)!='integer' THEN 1 ELSE 0 END),0) FROM sqlite_sequence`).Scan(&sequenceRows, &invalidSequences) != nil || sequenceRows != 1 || invalidSequences != 0 {
+		return UpgradeSnapshot{}, ErrUpgrade
+	}
+	var sequence int64
+	if conn.QueryRowContext(ctx, `SELECT seq FROM sqlite_sequence WHERE name='kine'`).Scan(&sequence) != nil || sequence < 0 || uint64(sequence) < result.LastRevision {
+		return UpgradeSnapshot{}, ErrUpgrade
+	}
+	result.Sequence = uint64(sequence)
+	var encoded [8]byte
+	binary.BigEndian.PutUint64(encoded[:], result.Sequence)
+	upgradeHashPart(h, encoded[:])
+	copy(result.LogicalHash[:], h.Sum(nil))
+	return result, nil
+}
