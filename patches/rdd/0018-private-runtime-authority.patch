@@ -0,0 +1,43 @@
+package managementconfig
+
+import "testing"
+
+func upgradeInventoryFixture() []upgradeInventoryObject {
+	return []upgradeInventoryObject{
+		{"root", "args.json", UpgradeObject{1, 0, 2}, false, 1, false},
+		{"root", "tls", UpgradeObject{1, 0, 3}, true, 1, false},
+		{"root", "db", UpgradeObject{1, 0, 4}, true, 1, false},
+		{"db", "state.db", UpgradeObject{1, 0, 5}, false, 1, false},
+		{"db", "state.db-wal", UpgradeObject{1, 0, 6}, false, 1, false},
+		{"db", "state.db-shm", UpgradeObject{1, 0, 7}, false, 1, false},
+	}
+}
+func TestUpgradeInventoryPreservesSQLiteSidecars(t *testing.T) {
+	plan, err := planUpgradeInventory(UpgradeObject{1, 0, 1}, upgradeInventoryFixture())
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	for _, entry := range plan {
+		seen[entry.Role] = true
+	}
+	if !seen["main"] || !seen["wal"] || !seen["shm"] {
+		t.Fatal("cold checkpoint omitted sidecar")
+	}
+}
+func TestUpgradeInventoryRefusesUnknownAliasOrUnownedObject(t *testing.T) {
+	for _, mutate := range []func([]upgradeInventoryObject) []upgradeInventoryObject{
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[0].Name = "unrecognized.secret"; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[0].Name = "ARGS.JSON"; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[3].Links = 2; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[1].Reparse = true; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[3].Object = f[0].Object; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[3].Object.Volume = 2; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { f[3].Parent = "tls"; return f },
+		func(f []upgradeInventoryObject) []upgradeInventoryObject { return f[1:] },
+	} {
+		if _, err := planUpgradeInventory(UpgradeObject{1, 0, 1}, mutate(upgradeInventoryFixture())); err == nil {
+			t.Fatal("unsafe backup plan accepted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_inventory_windows.go b/rdd/pkg/managementconfig/upgrade_inventory_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..96874aa4d73fe7499b8127d035681fc7966fd2a6
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_inventory_windows.go
@@ -0,0 +1,194 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// Read-only preparation owns the exact legacy namespace without treating its
+// historical DACL as credential authority. It never reads credential/DB bytes.
+// The separate post-retirement exclusive/sealing step must reobserve these IDs.
+type upgradeLegacyInventory struct {
+	mu       sync.Mutex
+	parents  *ParentLease
+	children []windows.Handle
+	root     UpgradeObject
+	entries  []upgradeInventoryEntry
+	closed   bool
+	closeErr error
+}
+
+func (l *upgradeLegacyInventory) Close() error {
+	if l == nil {
+		return nil
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return l.closeErr
+	}
+	if l.closeErr != nil {
+		return l.closeErr
+	}
+	l.closed = true
+	for i := len(l.children) - 1; i >= 0; i-- {
+		if windows.CloseHandle(l.children[i]) != nil {
+			l.closeErr = ErrUpgrade
+			return l.closeErr
+		}
+	}
+	if l.parents != nil && l.parents.Close() != nil {
+		l.closeErr = ErrUpgrade
+	}
+	return l.closeErr
+}
+func upgradeObjectID(h windows.Handle) (UpgradeObject, error) {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	id := UpgradeObject{info.VolumeSerialNumber, info.FileIndexHigh, info.FileIndexLow}
+	if !id.valid() {
+		return id, ErrUpgrade
+	}
+	return id, nil
+}
+func openLegacyMetadata(parent windows.Handle, name string, directory bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE)
+	if directory {
+		access |= windows.FILE_LIST_DIRECTORY
+		options = windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_DIRECTORY_FILE
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, options, 0, 0)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+func observeLegacyInventory(ctx context.Context, root *InstanceRoot) (lease *upgradeLegacyInventory, result error) {
+	if ctx == nil || ctx.Err() != nil || root == nil || root.selection == nil {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	owner, err := currentOwner()
+	if err != nil || owner != root.sid {
+		return nil, ErrUpgrade
+	}
+	verified, err := ResolveOrbWinRoot(root.home, "orbwin")
+	if err != nil || !verified.selection.Same(root.selection) {
+		return nil, ErrUpgrade
+	}
+	volume, parts, err := readerComponents(root.selection.LegacyDirectory())
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	l := &upgradeLegacyInventory{parents: &ParentLease{chain: []windows.Handle{h}, sid: owner}}
+	ok := false
+	defer func() {
+		if !ok {
+			if l.Close() != nil {
+				lease = l
+			}
+			result = ErrUpgrade
+		}
+	}()
+	if objectKind(h, true) != nil {
+		return nil, ErrUpgrade
+	}
+	for _, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		next, e := openLegacyMetadata(l.parents.leaf(), part, true)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		l.parents.chain = append(l.parents.chain, next)
+		if objectKind(next, true) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	l.root, err = upgradeObjectID(l.parents.leaf())
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	type folder struct {
+		role   string
+		handle windows.Handle
+	}
+	folders := []folder{{"root", l.parents.leaf()}}
+	var facts []upgradeInventoryObject
+	for index := 0; index < len(folders); index++ {
+		if len(folders) > 3 || ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		current := folders[index]
+		names, e := upgradeStoreNames(current.handle)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		for _, name := range names {
+			role := ""
+			var spec upgradeInventoryRole
+			for candidate, allowed := range upgradeInventoryRoles {
+				if allowed.parent == current.role && allowed.name == name {
+					role = candidate
+					spec = allowed
+					break
+				}
+			}
+			if role == "" {
+				return nil, ErrUpgrade
+			}
+			child, e := openLegacyMetadata(current.handle, name, spec.directory)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			l.children = append(l.children, child)
+			if objectKind(child, spec.directory) != nil {
+				return nil, ErrUpgrade
+			}
+			var info windows.ByHandleFileInformation
+			if windows.GetFileInformationByHandle(child, &info) != nil {
+				return nil, ErrUpgrade
+			}
+			id, e := upgradeObjectID(child)
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			facts = append(facts, upgradeInventoryObject{current.role, name, id, spec.directory, info.NumberOfLinks, false})
+			if spec.directory {
+				folders = append(folders, folder{role, child})
+			}
+		}
+	}
+	l.entries, err = planUpgradeInventory(l.root, facts)
+	if err != nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	ok = true
+	return l, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_legacy_selector_windows.go b/rdd/pkg/managementconfig/upgrade_legacy_selector_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..761a620f3f04a369d895e83ad5c23b02df65bcab
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_legacy_selector_windows.go
@@ -0,0 +1,157 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/registry"
+	"runtime"
+)
+
+// This presence observation is data classification only. It never constructs a
+// credential reader, accepts the legacy ancestry as authority, reads config/key
+// bytes, changes ACLs or creates a legacy marker. Every component is opened
+// relative/no-reparse so ambiguous historical namespace is not called fresh.
+func legacyManagementPresent(ctx context.Context, root *InstanceRoot) (present bool, result error) {
+	return historicalDirectoryPresent(ctx, root, false)
+}
+
+func historicalDirectoryPresent(ctx context.Context, root *InstanceRoot, guest bool) (present bool, result error) {
+	if ctx == nil || ctx.Err() != nil || root == nil || root.selection == nil {
+		return false, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if owner, err := currentOwner(); err != nil || owner != root.sid {
+		return false, ErrUpgrade
+	}
+	path := root.selection.LegacyDirectory()
+	if guest {
+		path = root.selection.GuestHome() + `\.rdorbwin\lima\orbwin`
+	}
+	volume, parts, err := readerComponents(path)
+	if err != nil {
+		return false, ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return false, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return false, ErrUpgrade
+	}
+	lease := &ParentLease{chain: []windows.Handle{h}, sid: root.sid}
+	defer func() {
+		if lease.Close() != nil {
+			present = false
+			result = ErrUpgrade
+		}
+	}()
+	if objectKind(h, true) != nil {
+		return false, ErrUpgrade
+	}
+	for _, part := range parts {
+		if ctx.Err() != nil {
+			return false, ErrUpgrade
+		}
+		next, e := openRelative(lease.leaf(), part, true, nil, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			return false, nil
+		}
+		if e != nil {
+			return false, ErrUpgrade
+		}
+		lease.chain = append(lease.chain, next)
+		if objectKind(next, true) != nil {
+			return false, ErrUpgrade
+		}
+	}
+	return true, nil
+}
+
+func classifyMissingPrivateAuthority(ctx context.Context, root *InstanceRoot) AuthorityPreflight {
+	present, err := legacyManagementPresent(ctx, root)
+	if err != nil {
+		return missingAuthorityState(false, false, false, true)
+	}
+	if present {
+		return missingAuthorityState(true, false, false, false)
+	}
+	guest, err := historicalDirectoryPresent(ctx, root, true)
+	if err != nil {
+		return missingAuthorityState(false, false, false, true)
+	}
+	registered, err := ownedLegacyRegistrationPresent(ctx)
+	return missingAuthorityState(false, guest, registered, err != nil)
+}
+
+// Fixed-name registry presence is a refusal fence, never an ownership grant or
+// proof that the guest stopped. It invokes no wsl.exe process or guest command.
+func ownedLegacyRegistrationPresent(ctx context.Context) (present bool, result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return false, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if _, err := currentOwner(); err != nil {
+		return false, ErrUpgrade
+	}
+	key, err := registry.OpenKey(registry.CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`, registry.ENUMERATE_SUB_KEYS|registry.QUERY_VALUE)
+	if err == windows.ERROR_FILE_NOT_FOUND {
+		return false, nil
+	}
+	if err != nil {
+		return false, ErrUpgrade
+	}
+	defer func() {
+		if key.Close() != nil {
+			present = false
+			result = ErrUpgrade
+		}
+	}()
+	for index := uint32(0); index <= 512; index++ {
+		if ctx.Err() != nil {
+			return false, ErrUpgrade
+		}
+		var name [64]uint16
+		length := uint32(len(name))
+		err := windows.RegEnumKeyEx(windows.Handle(key), index, &name[0], &length, nil, nil, nil, nil)
+		if err == windows.ERROR_NO_MORE_ITEMS {
+			return false, nil
+		}
+		if err != nil || index == 512 || length < 1 || length >= uint32(len(name)) {
+			return false, ErrUpgrade
+		}
+		child, err := registry.OpenKey(key, windows.UTF16ToString(name[:length]), registry.QUERY_VALUE)
+		if err != nil {
+			return false, ErrUpgrade
+		}
+		value, _ := windows.UTF16PtrFromString("DistributionName")
+		var data [512]byte
+		size := uint32(len(data))
+		var kind uint32
+		err = windows.RegQueryValueEx(windows.Handle(child), value, nil, &kind, &data[0], &size)
+		closeErr := child.Close()
+		if err != nil || closeErr != nil || kind != windows.REG_SZ || size < 2 || size > uint32(len(data)) || size%2 != 0 {
+			return false, ErrUpgrade
+		}
+		units := make([]uint16, size/2)
+		for i := range units {
+			units[i] = uint16(data[2*i]) | uint16(data[2*i+1])<<8
+		}
+		if units[len(units)-1] != 0 {
+			return false, ErrUpgrade
+		}
+		for _, unit := range units[:len(units)-1] {
+			if unit == 0 {
+				return false, ErrUpgrade
+			}
+		}
+		if windows.UTF16ToString(units) == "lima-orbwin" {
+			return true, nil
+		}
+	}
+	return false, ErrUpgrade
+}
diff --git a/rdd/pkg/managementconfig/upgrade_permit_windows.go b/rdd/pkg/managementconfig/upgrade_permit_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..94a275f1143d5f825852c196101aea3c864cddc2
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_permit_windows.go
@@ -0,0 +1,396 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+const upgradePermitEnv = upgradePermitEnvironmentName
+const upgradePermitName = "authority.migration.launch"
+
+func currentUpgradeGeneration(image [32]byte) (UpgradeProcess, error) {
+	pid := windows.GetCurrentProcessId()
+	var session uint32
+	var created, exit, kernel, user windows.Filetime
+	if image == [32]byte{} || windows.ProcessIdToSessionId(pid, &session) != nil || session == 0 || windows.GetProcessTimes(windows.CurrentProcess(), &created, &exit, &kernel, &user) != nil {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	p := UpgradeProcess{pid, uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), session, image}
+	if !p.valid() {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	return p, nil
+}
+
+type upgradeServingTransfer struct {
+	recorder        *upgradeRecorder
+	mu              sync.Mutex
+	file, inherited windows.Handle
+	record          upgradeServingRecord
+	started         bool
+	sdk             *nativeUpgradeSDKCandidateTransfer
+}
+
+func (t *upgradeServingTransfer) startUpgradeCandidate(start func(uintptr) error) error {
+	// A management-only handle allowlist would drop the live SDK's job/control
+	// ownership. Only the actual SDK envelope below can enter the native seam.
+	return ErrUpgrade
+}
+
+func (t *upgradeServingTransfer) startManagementCandidate(start func(uintptr) error) error {
+	if t == nil || start == nil {
+		return ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.started || t.sdk == nil || !t.sdk.started || !t.sdk.unknown || t.inherited == 0 || !t.record.valid() {
+		return ErrUpgrade
+	}
+	t.recorder.mu.Lock()
+	latest := t.recorder.last
+	uncertain := t.recorder.uncertain
+	t.recorder.mu.Unlock()
+	want, err := upgradeRecordBytes(t.record.Record)
+	current, currentErr := upgradeRecordBytes(latest)
+	if uncertain || err != nil || currentErr != nil || !bytes.Equal(want, current) {
+		return ErrUpgrade
+	}
+	actual, err := currentUpgradeGeneration(t.record.Fence.Incoming)
+	if err != nil || actual != t.record.Fence.Owner {
+		return ErrUpgrade
+	}
+	t.started = true
+	// The sole launcher sets ONLY this handle in AdditionalInheritedHandles and
+	// its canonical decimal value in upgradePermitEnv, then calls Cmd.Start once.
+	// No path, ordinary flag or public receipt can manufacture this FILE_OBJECT
+	// while the live migration owner holds the CREATE_NEW file exclusively.
+	return start(uintptr(t.inherited))
+}
+func (o *upgradeAuthorityOwner) candidateUpgradeTransfer() upgradeCandidateTransfer {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.released || o.unknown {
+		return nil
+	}
+	if o.transfer == nil || o.transfer.sdk == nil {
+		return nil
+	}
+	return o.transfer.sdk
+}
+func (o *upgradeAuthorityOwner) prepareUpgradeTransfer(ctx context.Context, j upgradeJournal) error {
+	// o.mu is held by releaseUpgradeAuthority. The only allowed nesting here is
+	// authority -> SDK preparation -> management transfer -> recorder/store.
+	if o.sdk == nil {
+		return ErrUpgrade
+	}
+	o.recorder.mu.Lock()
+	record := o.recorder.last
+	o.recorder.mu.Unlock()
+	receipt := upgradeServingRecord{1, o.fence, j.Fence, record}
+	data, err := upgradeServingBytes(receipt)
+	if err != nil {
+		return ErrUpgrade
+	}
+	h, err := createUpgradeWorkingFile(o.created.parents.leaf(), upgradePermitName, o.cold.sid)
+	if err != nil {
+		return ErrUpgrade
+	}
+	t := &upgradeServingTransfer{file: h, record: receipt, recorder: o.recorder}
+	o.transfer = t
+	for remaining := data; len(remaining) > 0; {
+		n, err := nativeWrite(h, remaining)
+		if err != nil || n < 1 || n > len(remaining) {
+			return ErrUpgrade
+		}
+		remaining = remaining[n:]
+	}
+	if verifyPrivate(h, o.cold.sid, false) != nil || windows.FlushFileBuffers(h) != nil || verifyUpgradeWritten(ctx, h, data) != nil {
+		return ErrUpgrade
+	}
+	if windows.DuplicateHandle(windows.CurrentProcess(), h, windows.CurrentProcess(), &t.inherited, windows.FILE_READ_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, true, 0) != nil {
+		return ErrUpgrade
+	}
+	if _, err := o.sdk.bindUpgradeSDKCandidate(ctx, t); err != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+type upgradeServingPermit struct {
+	mu                sync.Mutex
+	closed            bool
+	closeErr          error
+	handle            windows.Handle
+	record            upgradeServingRecord
+	root              *InstanceRoot
+	parent            *upgradeProcessLease
+	image             *ServingImageLease
+	candidate         UpgradeProcess
+	used              bool
+	sdk               *nativeUpgradeSDKServingOwner
+	sdkCloseAttempted bool
+	sdkCloseErr       error
+}
+
+// Created.Close calls this BEFORE closing any management authority object. The
+// SDK holder may not release a live SDK or an unknown descendant/IO retirement.
+// Lock order is permit -> SDK holder; SDK retirement must not call back into
+// the permit. A failed/unknown native close is retained and never silently
+// retried; a readiness refusal performs no native close and remains inspectable.
+func (p *upgradeServingPermit) prepareClose() error {
+	if p == nil {
+		return nil
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.prepareCloseLocked()
+}
+
+func (p *upgradeServingPermit) prepareCloseLocked() error {
+	if p.sdk == nil {
+		return nil
+	}
+	if !p.sdkCloseAttempted {
+		if p.sdk.readyToClose() != nil {
+			return ErrUpgrade
+		}
+		p.sdkCloseAttempted = true
+		p.sdkCloseErr = p.sdk.close()
+	}
+	return p.sdkCloseErr
+}
+
+func (p *upgradeServingPermit) close() error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return p.closeErr
+	}
+	if p.prepareCloseLocked() != nil {
+		return ErrUpgrade
+	}
+	p.closed = true
+	if p.handle != 0 && windows.CloseHandle(p.handle) != nil {
+		p.closeErr = ErrUpgrade
+		return p.closeErr
+	}
+	p.handle = 0
+	if p.parent != nil && p.parent.Close() != nil {
+		p.closeErr = ErrUpgrade
+		return p.closeErr
+	}
+	if p.image != nil && p.image.Close() != nil {
+		p.closeErr = ErrUpgrade
+		return p.closeErr
+	}
+	return nil
+}
+func consumeUpgradeServingPermit(ctx context.Context, root *InstanceRoot) (permit *upgradeServingPermit, result error) {
+	if ctx == nil || ctx.Err() != nil || root == nil {
+		return nil, ErrUpgrade
+	}
+	text, present := os.LookupEnv(upgradePermitEnv)
+	if !present {
+		return nil, nil
+	}
+	if os.Unsetenv(upgradePermitEnv) != nil {
+		return nil, ErrUpgrade
+	}
+	value, err := strconv.ParseUint(text, 10, strconv.IntSize)
+	if err != nil || value == 0 || strconv.FormatUint(value, 10) != text || uintptr(value) == ^uintptr(0) {
+		return nil, ErrUpgrade
+	}
+	p := &upgradeServingPermit{handle: windows.Handle(value), root: root}
+	ok := false
+	defer func() {
+		if !ok {
+			if p.close() != nil {
+				permit = p
+			}
+			result = ErrUpgrade
+		}
+	}()
+	var flags uint32
+	status, _, _ := anchorGetHandleInformation.Call(uintptr(p.handle), uintptr(unsafe.Pointer(&flags)))
+	if status == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 || windows.SetHandleInformation(p.handle, windows.HANDLE_FLAG_INHERIT, 0) != nil || verifyPrivate(p.handle, root.sid, false) != nil {
+		return nil, ErrUpgrade
+	}
+	path, err := upgradeWorkingPath(p.handle)
+	if err != nil || !strings.EqualFold(path, filepath.Join(root.selection.Parent(), upgradePermitName)) {
+		return nil, ErrUpgrade
+	}
+	if _, err = windows.Seek(p.handle, 0, io.SeekStart); err != nil {
+		return nil, ErrUpgrade
+	}
+	data, err := authorityRead(p.handle, 64<<10)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	p.record, err = parseUpgradeServing(data)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	p.image, err = HoldServingImage(ctx, root.home, "orbwin")
+	if err != nil || p.image == nil || p.image.Image().Hash != p.record.Fence.Incoming {
+		return nil, ErrUpgrade
+	}
+	p.candidate, err = currentUpgradeGeneration(p.record.Fence.Incoming)
+	if err != nil || p.candidate.Session != p.record.Fence.Owner.Session || p.candidate.PID == p.record.Fence.Owner.PID {
+		return nil, ErrUpgrade
+	}
+	parentPID, err := upgradeCurrentParent(ctx)
+	if err != nil || parentPID != p.record.Fence.Owner.PID {
+		return nil, ErrUpgrade
+	}
+	p.parent, err = holdUpgradeProcess(ctx, p.record.Fence.Owner)
+	if err != nil || p.parent == nil {
+		return nil, ErrUpgrade
+	}
+	p.sdk, err = consumeUpgradeSDKServingOwner(ctx, p)
+	if err != nil || p.sdk == nil {
+		return p, ErrUpgrade
+	}
+	ok = true
+	return p, nil
+}
+func upgradeCurrentParent(ctx context.Context) (parent uint32, result error) {
+	h, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(h) != nil {
+			parent = 0
+			result = ErrUpgrade
+		}
+	}()
+	entry := windows.ProcessEntry32{Size: uint32(unsafe.Sizeof(windows.ProcessEntry32{}))}
+	err = windows.Process32First(h, &entry)
+	for count := 0; err == nil && count < 16384; count++ {
+		if ctx.Err() != nil {
+			return 0, ErrUpgrade
+		}
+		if entry.ProcessID == windows.GetCurrentProcessId() {
+			return entry.ParentProcessID, nil
+		}
+		err = windows.Process32Next(h, &entry)
+	}
+	return 0, ErrUpgrade
+}
+func (p *upgradeServingPermit) check(ctx context.Context, c *Created) error {
+	if p == nil || p.used || ctx == nil || ctx.Err() != nil || !p.record.valid() {
+		return ErrUpgrade
+	}
+	p.used = true
+	actual, err := currentUpgradeGeneration(p.record.Fence.Incoming)
+	if err != nil || actual != p.candidate {
+		return ErrUpgrade
+	}
+	retired, err := p.parent.exited(ctx)
+	if err != nil || retired {
+		return ErrUpgrade
+	}
+	j := p.record.Record.Journal
+	id, err := upgradeObjectID(c.anchor)
+	if err != nil || id != j.PrivateRoot {
+		return ErrUpgrade
+	}
+	parents := c.parents.chain
+	if len(parents) < 2 {
+		return ErrUpgrade
+	}
+	if observeUpgradeAdmittedRecord(ctx, parents[len(parents)-2], p.root.sid, p.record.Record) != nil {
+		return ErrUpgrade
+	}
+	h, err := openRelative(parents[len(parents)-2], upgradeFenceName, false, nil, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	data, readErr := authorityRead(h, 2048)
+	fenceID, idErr := upgradeObjectID(h)
+	privateErr := verifyPrivate(h, p.root.sid, false)
+	closeErr := windows.CloseHandle(h)
+	fence, parseErr := parseUpgradeFence(data)
+	if readErr != nil || idErr != nil || privateErr != nil || closeErr != nil || parseErr != nil || fence != p.record.Fence || fenceID != j.Fence {
+		return ErrUpgrade
+	}
+	db, err := openRelative(c.anchor, "db", true, nil, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	c.authorityHandles = append(c.authorityHandles, db)
+	file, err := openRelative(db, "state.db", false, nil, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	id, idErr = upgradeObjectID(file)
+	privateErr = verifyPrivate(file, p.root.sid, false)
+	copyErr := copyUpgradeCold(ctx, upgradeHandleReader{file}, io.Discard, j.Imported)
+	closeErr = windows.CloseHandle(file)
+	if idErr != nil || id != j.Imported.Object || privateErr != nil || copyErr != nil || closeErr != nil {
+		return ErrUpgrade
+	}
+	if !p.record.allows(upgradePermitFacts{Inherited: true, Candidate: p.candidate, Parent: p.parent.expected, Root: j.PrivateRoot, Database: id}) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Read the fixed immutable record prefix through a metadata-only directory
+// observation while the parent owns its exclusive directory FILE_OBJECT. No
+// pathname-selected file, mutable status snapshot or caller boolean is a grant.
+// A new recovery/unknown/forward record after the issued permit fences startup.
+func observeUpgradeAdmittedRecord(ctx context.Context, parent windows.Handle, sid string, want upgradeRecord) (result error) {
+	dir, err := openUpgradeDirectoryObservation(parent, "migration")
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(dir) != nil {
+			result = ErrUpgrade
+		}
+	}()
+	if verifyPrivate(dir, sid, true) != nil {
+		return ErrUpgrade
+	}
+	var records [][]byte
+	for sequence := uint32(1); sequence <= maxUpgradeRecords; sequence++ {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		h, err := openRelative(dir, upgradeRecordName(sequence), false, nil, false)
+		if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			break
+		}
+		if err != nil {
+			return ErrUpgrade
+		}
+		data, readErr := readUpgradeRecordHandle(h)
+		privateErr := verifyPrivate(h, sid, false)
+		closeErr := windows.CloseHandle(h)
+		if readErr != nil || privateErr != nil || closeErr != nil {
+			return ErrUpgrade
+		}
+		records = append(records, data)
+	}
+	r, err := newUpgradeRecorder(upgradeReadOnlyJournal{}, records)
+	if err != nil {
+		return ErrUpgrade
+	}
+	expected, err := upgradeRecordBytes(want)
+	got, other := upgradeRecordBytes(r.last)
+	if err != nil || other != nil || !bytes.Equal(expected, got) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_pid_denial_windows.go b/rdd/pkg/managementconfig/upgrade_pid_denial_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..848b434aff4fe1143aa18542f0b45cfe0749f940
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_pid_denial_windows.go
@@ -0,0 +1,277 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"io"
+	"unsafe"
+)
+
+const upgradeHistoricalPIDName = "rdd.pid.orbwin-historical"
+
+// Only ordinary selected old rdd serve/app/service startup is denied here.
+// Already issued main/hostagents and manual optional-pidfile hostagent launches
+// remain the independent exact-generation/ingress retirement obligation.
+func (t *upgradeColdTree) installPIDDenial(ctx context.Context, r *upgradeRecorder, j upgradeJournal) error {
+	if t.captureRecorder != r || t.captureStore == nil || j.Stage != "capture-admitted" || !t.uncertain || !t.mutationAdmitted || t.denialDirectory != 0 || t.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	root := t.handles["root"]
+	if h := t.handles["pid"]; h != 0 {
+		// Preserve the very same original FILE_OBJECT and bytes. A fixed fresh child
+		// is non-replacing; there is no deletion, overwrite or collision retry.
+		if protectUpgradeHistoricalPID(h, t.sid) != nil || renameUpgradeChild(h, root, upgradeHistoricalPIDName) != nil || windows.FlushFileBuffers(root) != nil {
+			return ErrUpgrade
+		}
+		if t.retirement.recheck(ctx) != nil {
+			return ErrUpgrade
+		}
+	}
+	// FILE_CREATE atomically owns the directory without DELETE sharing FROM BIRTH.
+	// A racing old starter winning this slot causes refusal, never repair/retry.
+	h, err := createUpgradeCaptureObject(root, "rdd.pid", t.sid, true)
+	if err != nil {
+		return ErrUpgrade
+	}
+	t.denialDirectory = h
+	id, err := upgradeObjectID(h)
+	if err != nil || verifyPrivate(h, t.sid, true) != nil {
+		return ErrUpgrade
+	}
+	receipt, err := createUpgradeCaptureObject(h, "denial.json", t.sid, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	t.denialReceipt = receipt
+	receiptID, err := upgradeObjectID(receipt)
+	if err != nil || verifyPrivate(receipt, t.sid, false) != nil {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	admission := r.digest
+	actual := r.last.Journal
+	unknown := r.uncertain
+	sameStore := r.sink == t.captureStore
+	r.mu.Unlock()
+	if unknown || !sameStore || actual.Stage != j.Stage || !upgradeIntentEqual(actual, j) {
+		return ErrUpgrade
+	}
+	payload, err := json.Marshal(struct {
+		Schema                       int
+		Transaction                  string
+		Original, Directory, Receipt UpgradeObject
+		Admission, Retirement        [32]byte
+	}{2, j.Transaction, j.OldRoot, id, receiptID, admission, j.RetirementDigest})
+	if err != nil || len(payload) > 4096 {
+		return ErrUpgrade
+	}
+	n, err := nativeWrite(receipt, payload)
+	if err != nil || n != len(payload) || windows.FlushFileBuffers(receipt) != nil {
+		return ErrUpgrade
+	}
+	if _, err = windows.Seek(receipt, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	readback := make([]byte, len(payload)+1)
+	defer clear(readback)
+	var got uint32
+	if windows.ReadFile(receipt, readback, &got, nil) != nil || int(got) != len(payload) || !bytes.Equal(payload, readback[:got]) {
+		return ErrUpgrade
+	}
+	t.denialReceipt = 0
+	if windows.CloseHandle(receipt) != nil {
+		t.closeErr = ErrUpgrade
+		t.unknownDenialHandle = receipt
+		return ErrUpgrade
+	}
+	receipt, err = openUpgradeDeleteLease(h, "denial.json", false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	t.denialReceipt = receipt
+	reopened, err := upgradeObjectID(receipt)
+	if err != nil || reopened != receiptID || verifyPrivate(receipt, t.sid, false) != nil {
+		return ErrUpgrade
+	}
+	if _, err = windows.Seek(receipt, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	got = 0
+	if windows.ReadFile(receipt, readback, &got, nil) != nil || int(got) != len(payload) || !bytes.Equal(payload, readback[:got]) {
+		return ErrUpgrade
+	}
+	names, err := upgradeStoreNames(h)
+	if err != nil || len(names) != 1 || names[0] != "denial.json" || windows.FlushFileBuffers(h) != nil || windows.FlushFileBuffers(root) != nil || t.retirement.recheck(ctx) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	t.denial = UpgradePIDDenial{id, receiptID, sha256.Sum256(payload)}
+	return nil
+}
+
+func renameUpgradeChild(h, parent windows.Handle, name string) error {
+	type renameInfo struct {
+		Replace uint32
+		Root    windows.Handle
+		Length  uint32
+		Name    [1]uint16
+	}
+	text, err := windows.UTF16FromString(name)
+	if err != nil {
+		return ErrUpgrade
+	}
+	var shape renameInfo
+	buffer := make([]byte, int(unsafe.Offsetof(shape.Name))+(len(text)-1)*2)
+	info := (*renameInfo)(unsafe.Pointer(&buffer[0]))
+	info.Root = parent
+	info.Length = uint32((len(text) - 1) * 2)
+	copy(unsafe.Slice(&info.Name[0], len(text)-1), text[:len(text)-1])
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtSetInformationFile(h, &status, &buffer[0], uint32(len(buffer)), windows.FileRenameInformation) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+func openUpgradeDeleteLease(parent windows.Handle, name string, directory bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.READ_CONTROL | windows.DELETE | windows.FILE_READ_DATA | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtCreateFile(&h, access, &oa, &status, nil, 0, 0, windows.FILE_OPEN, options, 0, 0) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+// Reobserve the original literal name and complete known namespace; directory
+// sharing is not claimed to freeze child-name mutations by itself.
+func (t *upgradeColdTree) verifyOriginalNamespace(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil || len(t.observations) > 512 {
+		return ErrUpgrade
+	}
+	handles := t.originals
+	if handles == nil {
+		handles = t.handles
+	}
+	root := handles["root"]
+	h, err := openUpgradeDirectoryObservation(t.inventory.parents.leaf(), "rancher-desktop-orbwin")
+	if err != nil {
+		return ErrUpgrade
+	}
+	t.observations = append(t.observations, h)
+	id, err := upgradeObjectID(h)
+	if err != nil || id != t.inventory.root || objectKind(root, true) != nil {
+		return ErrUpgrade
+	}
+	for _, parent := range []string{"root", "db", "tls"} {
+		want := map[string]UpgradeObject{}
+		for _, entry := range t.entries {
+			if entry.Fact.Parent == parent {
+				name := entry.Fact.Name
+				if entry.Role == "pid" {
+					name = upgradeHistoricalPIDName
+				}
+				want[name] = entry.Fact.Object
+			}
+		}
+		if parent == "root" {
+			want["rdd.pid"] = t.denial.Directory
+		}
+		names, err := upgradeStoreNames(handles[parent])
+		if err != nil || len(names) != len(want) {
+			return ErrUpgrade
+		}
+		for _, name := range names {
+			expected, ok := want[name]
+			if !ok || !expected.valid() || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			directory := parent == "root" && (name == "db" || name == "tls" || name == "rdd.pid")
+			child, err := openUpgradeObjectObservation(handles[parent], name, directory)
+			if err != nil {
+				return ErrUpgrade
+			}
+			t.observations = append(t.observations, child)
+			actual, err := upgradeObjectID(child)
+			if err != nil || actual != expected || objectKind(child, directory) != nil {
+				return ErrUpgrade
+			}
+			delete(want, name)
+		}
+	}
+	did, err := upgradeObjectID(t.denialDirectory)
+	rid, other := upgradeObjectID(t.denialReceipt)
+	if err != nil || other != nil || did != t.denial.Directory || rid != t.denial.Receipt || verifyPrivate(t.denialDirectory, t.sid, true) != nil || verifyPrivate(t.denialReceipt, t.sid, false) != nil {
+		return ErrUpgrade
+	}
+	size, err := upgradeHandleSize(t.denialReceipt)
+	if err != nil || size > 4096 {
+		return ErrUpgrade
+	}
+	digest, err := hashUpgradeCapture(ctx, t.denialReceipt, size)
+	if err != nil || digest != t.denial.Digest {
+		return ErrUpgrade
+	}
+	names, err := upgradeStoreNames(t.denialDirectory)
+	if err != nil || len(names) != 1 || names[0] != "denial.json" {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func openUpgradeObjectObservation(parent windows.Handle, name string, directory bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, windows.FILE_OPEN, options, 0, 0) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+// Sealing changes only historical PID metadata on the exact held source object;
+// bytes and identity are preserved. Admission already covers this mutation.
+func protectUpgradeHistoricalPID(h windows.Handle, sid string) error {
+	before, err := upgradeObjectID(h)
+	if err != nil || objectKind(h, false) != nil {
+		return ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	acl, _, err := sd.DACL()
+	if err != nil || acl == nil {
+		return ErrUpgrade
+	}
+	if windows.SetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil || windows.FlushFileBuffers(h) != nil || verifyPrivate(h, sid, false) != nil {
+		return ErrUpgrade
+	}
+	after, err := upgradeObjectID(h)
+	if err != nil || after != before {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_process_family_windows.go b/rdd/pkg/managementconfig/upgrade_process_family_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..3cd71435c0005f3351c69260a53be2a3b2859a07
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_process_family_windows.go
@@ -0,0 +1,182 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+type upgradeProcessFamily struct {
+	mu        sync.Mutex
+	processes []*upgradeProcessLease
+	path      string
+	expected  map[uint32]UpgradeProcess
+	closed    bool
+	closeErr  error
+}
+
+func (f *upgradeProcessFamily) Close() error {
+	if f == nil {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed {
+		return f.closeErr
+	}
+	f.closed = true
+	for i := len(f.processes) - 1; i >= 0; i-- {
+		if f.processes[i].Close() != nil {
+			f.closeErr = ErrUpgrade
+		}
+	}
+	return f.closeErr
+}
+func upgradeProcessPath(process windows.Handle) (string, error) {
+	var path [1024]uint16
+	size := uint32(len(path))
+	if windows.QueryFullProcessImageName(process, 0, &path[0], &size) != nil || size == 0 || size >= uint32(len(path)) {
+		return "", ErrUpgrade
+	}
+	value := windows.UTF16ToString(path[:size])
+	if _, _, err := readerComponents(value); err != nil {
+		return "", ErrUpgrade
+	}
+	return value, nil
+}
+
+// Each caller tuple is independently pinned to a live actual process image.
+// Enumeration refuses another live process at the same actual executable path;
+// it never broadens the requested stop set to an unowned engine/CLI invocation.
+func holdUpgradeProcessFamily(ctx context.Context, main UpgradeProcess, hostagents []UpgradeProcess) (family *upgradeProcessFamily, result error) {
+	if ctx == nil || ctx.Err() != nil || !main.valid() || len(hostagents) > 16 {
+		return nil, ErrUpgrade
+	}
+	f := &upgradeProcessFamily{expected: map[uint32]UpgradeProcess{main.PID: main}}
+	ok := false
+	defer func() {
+		if !ok {
+			if f.Close() != nil {
+				family = f
+			}
+			result = ErrUpgrade
+		}
+	}()
+	for _, ha := range hostagents {
+		if !ha.valid() || ha.Image != main.Image || ha.Session != main.Session || f.expected[ha.PID].PID != 0 {
+			return nil, ErrUpgrade
+		}
+		f.expected[ha.PID] = ha
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	ordered := append([]UpgradeProcess{main}, hostagents...)
+	for _, expected := range ordered {
+		lease, err := holdUpgradeProcess(ctx, expected)
+		if lease != nil {
+			f.processes = append(f.processes, lease)
+		}
+		if err != nil || lease == nil {
+			return nil, ErrUpgrade
+		}
+		path, err := upgradeProcessPath(lease.handle)
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		if f.path == "" {
+			f.path = path
+		} else if !strings.EqualFold(f.path, path) {
+			return nil, ErrUpgrade
+		}
+	}
+	observed, err := observeUpgradeImageProcesses(ctx, f.path)
+	if err != nil || len(observed) != len(f.expected) {
+		return nil, ErrUpgrade
+	}
+	for pid := range observed {
+		if f.expected[pid].PID == 0 {
+			return nil, ErrUpgrade
+		}
+	}
+	ok = true
+	return f, nil
+}
+func observeUpgradeImageProcesses(ctx context.Context, path string) (observed map[uint32]bool, result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(snapshot) != nil {
+			observed = nil
+			result = ErrUpgrade
+		}
+	}()
+	entry := windows.ProcessEntry32{Size: uint32(unsafe.Sizeof(windows.ProcessEntry32{}))}
+	err = windows.Process32First(snapshot, &entry)
+	found := map[uint32]bool{}
+	for count := 0; err == nil; count++ {
+		if count >= 16384 || ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		if strings.EqualFold(windows.UTF16ToString(entry.ExeFile[:]), filepath.Base(path)) {
+			h, e := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, entry.ProcessID)
+			// An inaccessible matching name is uncertainty, not permission to skip it.
+			if e != nil {
+				return nil, ErrUpgrade
+			}
+			actual, e := upgradeProcessPath(h)
+			state, waitErr := windows.WaitForSingleObject(h, 0)
+			closeErr := windows.CloseHandle(h)
+			if e != nil || waitErr != nil || closeErr != nil {
+				return nil, ErrUpgrade
+			}
+			if strings.EqualFold(actual, path) && state == uint32(windows.WAIT_TIMEOUT) {
+				found[entry.ProcessID] = true
+			}
+			if state != uint32(windows.WAIT_TIMEOUT) && state != uint32(windows.WAIT_OBJECT_0) {
+				return nil, ErrUpgrade
+			}
+		}
+		err = windows.Process32Next(snapshot, &entry)
+	}
+	if err != windows.ERROR_NO_MORE_FILES {
+		return nil, ErrUpgrade
+	}
+	return found, nil
+}
+func (f *upgradeProcessFamily) retired(ctx context.Context) (bool, error) {
+	if f == nil || ctx == nil || ctx.Err() != nil {
+		return false, ErrUpgrade
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.closed {
+		return false, ErrUpgrade
+	}
+	for _, process := range f.processes {
+		exited, err := process.exited(ctx)
+		if err != nil {
+			return false, ErrUpgrade
+		}
+		if !exited {
+			return false, nil
+		}
+	}
+	// Process-object exit plus a new inventory fences a replacement at that path;
+	// this still is not the separate WSL/publication/cold-writer retirement grant.
+	remaining, err := observeUpgradeImageProcesses(ctx, f.path)
+	if err != nil || len(remaining) != 0 {
+		return false, ErrUpgrade
+	}
+	return true, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_process_windows.go b/rdd/pkg/managementconfig/upgrade_process_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..2bec5692959ec8fb3bf1297c9fb6f61180b3fab7
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_process_windows.go
@@ -0,0 +1,94 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+)
+
+// Actual process objects are captured while live, before any interruption.
+// This type cannot be reconstructed from a renderer/Rust 'retired' boolean.
+// Handles are held across re-observation so a recycled PID cannot prove exit.
+type upgradeProcessLease struct {
+	mu       sync.Mutex
+	expected UpgradeProcess
+	handle   windows.Handle
+	closed   bool
+	closeErr error
+}
+
+func holdUpgradeProcess(ctx context.Context, expected UpgradeProcess) (*upgradeProcessLease, error) {
+	if ctx == nil || ctx.Err() != nil || !expected.valid() {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	h, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, expected.PID)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	lease := &upgradeProcessLease{expected: expected, handle: h}
+	image, err := observeProcessImage(ctx, expected.PID, expected.Creation, expected.Session)
+	if err != nil || image != expected.Image {
+		if lease.Close() != nil {
+			return lease, ErrUpgrade
+		}
+		return nil, ErrUpgrade
+	}
+	var creation, exit, kernel, user windows.Filetime
+	state, err := windows.WaitForSingleObject(h, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || windows.GetProcessTimes(h, &creation, &exit, &kernel, &user) != nil || uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime) != expected.Creation || ctx.Err() != nil {
+		if lease.Close() != nil {
+			return lease, ErrUpgrade
+		}
+		return nil, ErrUpgrade
+	}
+	return lease, nil
+}
+
+func (p *upgradeProcessLease) exited(ctx context.Context) (bool, error) {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return false, ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.handle == 0 {
+		return false, ErrUpgrade
+	}
+	var creation, exit, kernel, user windows.Filetime
+	if windows.GetProcessTimes(p.handle, &creation, &exit, &kernel, &user) != nil || uint64(creation.HighDateTime)<<32|uint64(creation.LowDateTime) != p.expected.Creation {
+		return false, ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(p.handle, 0)
+	if err != nil || ctx.Err() != nil {
+		return false, ErrUpgrade
+	}
+	if state == uint32(windows.WAIT_TIMEOUT) {
+		return false, nil
+	}
+	if state != uint32(windows.WAIT_OBJECT_0) {
+		return false, ErrUpgrade
+	}
+	return true, nil
+}
+
+func (p *upgradeProcessLease) Close() error {
+	if p == nil {
+		return nil
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return p.closeErr
+	}
+	p.closed = true
+	h := p.handle
+	p.handle = 0
+	if h != 0 && windows.CloseHandle(h) != nil {
+		p.closeErr = ErrUpgrade
+	}
+	return p.closeErr
+}
diff --git a/rdd/pkg/managementconfig/upgrade_record.go b/rdd/pkg/managementconfig/upgrade_record.go
new file mode 100644
index 0000000000000000000000000000000000000000..3e4b3adc731ff0ba027c4193eca6e81b3e1b0a19
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_record.go
@@ -0,0 +1,248 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"sync"
+)
+
+const maxUpgradeRecords = 64
+const maxUpgradeRecordBytes = 40 << 10
+
+type upgradeRecord struct {
+	Schema   int            `json:"schema"`
+	Sequence uint32         `json:"sequence"`
+	Previous [32]byte       `json:"previous"`
+	Journal  upgradeJournal `json:"journal"`
+}
+
+func upgradeRecordBytes(record upgradeRecord) ([]byte, error) {
+	if record.Schema != 1 || record.Sequence < 1 || record.Sequence > maxUpgradeRecords || (record.Sequence == 1) != (record.Previous == [32]byte{}) || !record.Journal.valid() {
+		return nil, ErrUpgrade
+	}
+	if record.Sequence == 1 && record.Journal.Stage != "prepared" {
+		return nil, ErrUpgrade
+	}
+	data, err := json.Marshal(record)
+	if err != nil || len(data) > maxUpgradeRecordBytes {
+		return nil, ErrUpgrade
+	}
+	return data, nil
+}
+func parseUpgradeRecord(data []byte) (upgradeRecord, error) {
+	var record upgradeRecord
+	if len(data) == 0 || len(data) > maxUpgradeRecordBytes || json.Unmarshal(data, &record) != nil {
+		return record, ErrUpgrade
+	}
+	canonical, err := upgradeRecordBytes(record)
+	if err != nil || !bytes.Equal(canonical, data) {
+		return upgradeRecord{}, ErrUpgrade
+	}
+	return record, nil
+}
+
+// writeExclusive must create a new fixed numbered record, write all bytes,
+// flush its file and close positively. An error is always uncertain: the same
+// process never retries it or admits a dependent mutation.
+type upgradeRecordSink interface {
+	writeExclusive(context.Context, uint32, []byte) error
+}
+type upgradeUnknownRecordSink interface{ unknownUpgradeRecord() }
+type upgradeRecorder struct {
+	mu        sync.Mutex
+	sink      upgradeRecordSink
+	last      upgradeRecord
+	digest    [32]byte
+	uncertain bool
+	retired   bool // known pre-interruption abandonment; never reuse this owner
+}
+
+func newUpgradeRecorder(sink upgradeRecordSink, records [][]byte) (*upgradeRecorder, error) {
+	if sink == nil || len(records) > maxUpgradeRecords {
+		return nil, ErrUpgrade
+	}
+	out := &upgradeRecorder{sink: sink}
+	for _, data := range records {
+		record, err := parseUpgradeRecord(data)
+		if err != nil || record.Sequence != out.last.Sequence+1 || record.Previous != out.digest {
+			return nil, ErrUpgrade
+		}
+		if out.last.Sequence > 0 && !upgradeRecordFollows(out.last.Journal, record.Journal) {
+			return nil, ErrUpgrade
+		}
+		out.last = record
+		out.digest = sha256.Sum256(data)
+	}
+	return out, nil
+}
+func upgradeIntentEqual(before, after upgradeJournal) bool {
+	if before.Transaction != after.Transaction || before.OldRuntime != after.OldRuntime || before.Incoming != after.Incoming || before.OldRoot != after.OldRoot || before.OldService != after.OldService || before.Registration != after.Registration || before.Daemon != after.Daemon || before.DesiredRunning != after.DesiredRunning || before.ClusterVersion != after.ClusterVersion || before.ArgsHash != after.ArgsHash || len(before.Hostagents) != len(after.Hostagents) {
+		return false
+	}
+	for i := range before.Hostagents {
+		if before.Hostagents[i] != after.Hostagents[i] {
+			return false
+		}
+	}
+	return true
+}
+func upgradeRecordFollows(before, after upgradeJournal) bool {
+	if before.Recovery.Schema != 0 || after.Recovery.Schema != 0 {
+		return upgradeRecoveryFollows(before, after)
+	}
+	// Native adapters may fill only acknowledged state fields. The transaction's
+	// original intent/expected identities are immutable across every record.
+	if !upgradeIntentEqual(before, after) || !upgradeCaptureFollows(before, after) {
+		return false
+	}
+	if before.WorkingRoot.valid() && before.WorkingRoot != after.WorkingRoot || before.Normalized.valid() && before.Normalized != after.Normalized || !upgradeColdFollows(before.Working, after.Working) {
+		return false
+	}
+	if before.NormalizedHash != [32]byte{} && (before.NormalizedHash != after.NormalizedHash || before.NormalizedSize != after.NormalizedSize) {
+		return false
+	}
+	if before.Certificate != [32]byte{} && before.Certificate != after.Certificate || before.ServiceAccount != [32]byte{} && before.ServiceAccount != after.ServiceAccount || before.Imported.Object.valid() && before.Imported != after.Imported {
+		return false
+	}
+	if before.SDKDigest != [32]byte{} && before.SDKDigest != after.SDKDigest || before.ValidationDigest != [32]byte{} && before.ValidationDigest != after.ValidationDigest {
+		return false
+	}
+	if before.RuntimeAdmission != (runtimePublicationAdmission{}) && before.RuntimeAdmission != after.RuntimeAdmission {
+		return false
+	}
+	if before.RuntimeAdmission == (runtimePublicationAdmission{}) && after.RuntimeAdmission != (runtimePublicationAdmission{}) && (before.Stage != "candidate-validated" || after.Stage != "runtime-publication-admitted") {
+		return false
+	}
+	if before.SDKDigest == [32]byte{} && after.SDKDigest != [32]byte{} && (before.Stage != "data-imported" || after.Stage != "candidate-start-admitted") {
+		return false
+	}
+	if before.Fence.valid() && before.Fence != after.Fence {
+		return false
+	}
+	if before.RetirementDigest != [32]byte{} && before.RetirementDigest != after.RetirementDigest || before.BackupRoot.valid() && before.BackupRoot != after.BackupRoot || before.PrivateRoot.valid() && before.PrivateRoot != after.PrivateRoot || !upgradeColdFollows(before.Cold, after.Cold) || !upgradeSealsFollow(before.Seals, after.Seals) || before.Snapshot.LogicalHash != [32]byte{} && before.Snapshot != after.Snapshot || before.CandidateWritesAdmitted && !after.CandidateWritesAdmitted || before.Candidate.valid() && before.Candidate != after.Candidate || before.RuntimeDigest != [32]byte{} && before.RuntimeDigest != after.RuntimeDigest {
+		return false
+	}
+	if before.Stage == after.Stage && (before.Stage == "sealing-admitted" || before.Stage == "sealing-unknown") && len(after.Seals) > len(before.Seals) {
+		return true
+	}
+	for _, next := range upgradeTransitions[before.Stage] {
+		if next == after.Stage {
+			return true
+		}
+	}
+	return false
+}
+func (r *upgradeRecorder) append(ctx context.Context, journal upgradeJournal) error {
+	if r == nil || ctx == nil {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if ctx.Err() != nil || r.uncertain || r.retired || r.last.Sequence >= maxUpgradeRecords || r.last.Sequence > 0 && !upgradeRecordFollows(r.last.Journal, journal) {
+		return ErrUpgrade
+	}
+	record := upgradeRecord{1, r.last.Sequence + 1, r.digest, journal}
+	data, err := upgradeRecordBytes(record)
+	if err != nil {
+		return err
+	}
+	// Latch BEFORE entering the OS so panic/error/cancellation cannot make an
+	// unacknowledged admission reusable in this recorder.
+	r.uncertain = true
+	if r.sink.writeExclusive(ctx, record.Sequence, data) != nil || ctx.Err() != nil {
+		if owner, ok := r.sink.(upgradeUnknownRecordSink); ok {
+			owner.unknownUpgradeRecord()
+		}
+		return ErrUpgrade
+	}
+	owned, parseErr := parseUpgradeRecord(data)
+	if parseErr != nil {
+		if owner, ok := r.sink.(upgradeUnknownRecordSink); ok {
+			owner.unknownUpgradeRecord()
+		}
+		return ErrUpgrade
+	}
+	r.last = owned
+	r.digest = sha256.Sum256(data)
+	r.uncertain = false
+	return nil
+}
+
+func upgradeColdFollows(before, after []UpgradeColdFile) bool {
+	if len(before) == 0 {
+		return true
+	}
+	if len(before) != len(after) {
+		return false
+	}
+	for i := range before {
+		a, b := before[i], after[i]
+		if a.Role != b.Role || a.Object != b.Object || a.Size != b.Size || a.Hash != [32]byte{} && a.Hash != b.Hash {
+			return false
+		}
+	}
+	return true
+}
+func upgradeSealsFollow(before, after []UpgradeSeal) bool {
+	if len(after) < len(before) {
+		return false
+	}
+	for i := range before {
+		if before[i] != after[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func upgradeRecordNamesMatch(names []string, count int) bool {
+	if count < 1 || count > maxUpgradeRecords || len(names) != count {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		if seen[name] {
+			return false
+		}
+		seen[name] = true
+	}
+	for sequence := 1; sequence <= count; sequence++ {
+		if !seen[fmt.Sprintf("record-%02d.json", sequence)] {
+			return false
+		}
+	}
+	return true
+}
+
+// The only non-record child belongs to admitted private working-copy work.
+// Merely finding it cannot resume a copy or bless its contents.
+func upgradeStoreLayoutMatch(names []string, count int, records [][]byte) bool {
+	filtered := make([]string, 0, len(names))
+	working := false
+	for _, name := range names {
+		if name == "working" {
+			if working {
+				return false
+			}
+			working = true
+		} else {
+			filtered = append(filtered, name)
+		}
+	}
+	if !upgradeRecordNamesMatch(filtered, count) {
+		return false
+	}
+	if working {
+		if len(records) != count || count < 1 {
+			return false
+		}
+		last, err := parseUpgradeRecord(records[count-1])
+		if err != nil || upgradeRank[last.Journal.Stage] < 7 {
+			return false
+		}
+	}
+	return true
+}
