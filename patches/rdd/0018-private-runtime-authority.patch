+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKCohortTupleCannotSubstituteForNativeRootCustody(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	w := testUpgradeSDKOwnerWire()
+	co := &nativeUpgradeSDKCohort{root: UpgradeProcess{w.SDK.PID, w.SDK.Creation, w.SDK.Session, w.SDK.Image}, ledger: upgradeSDKCohortLedger{}}
+	if co.waitCaptured(ctx) == nil {
+		t.Fatal("immutable tuple without an actual source/receiver gained native wait authority")
+	}
+	// A structurally valid wire is never a constructor. Missing actual serving
+	// permit/root/process/job refuses before inspecting any native handle.
+	if got, err := consumeNativeUpgradeSDKCohort(ctx, &nativeUpgradeSDKServingOwner{wire: w}); got != nil || err == nil {
+		t.Fatal("wire description manufactured native cohort custody")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..6190c6174401d91e95c6572b982bf57785b6d92b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_windows.go
@@ -0,0 +1,278 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sync"
+	"unsafe"
+)
+
+// Read-only native custody prototype, not retirement admission. Construction
+// occurs only on startSDK's actual fresh empty job before its first birth.
+// Source producer sealing and cross-process cohort adoption remain unavailable.
+type nativeUpgradeSDKCohort struct {
+	mu              sync.Mutex
+	birth           *nativeUpgradeSDKChild
+	receiver        *nativeUpgradeSDKServingOwner
+	root            UpgradeProcess // immutable tuple backed by actual retained root below
+	sid             string
+	transfer        *nativeUpgradeSDKCandidateTransfer
+	job             windows.Handle // independent QUERY|SYNCHRONIZE duplicate
+	ledger          upgradeSDKCohortLedger
+	members         map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember
+	partial         []*nativeUpgradeSDKCohortMember
+	unknown         bool
+	adoption        *nativeUpgradeSDKCohortAdoption
+	queryRetirement upgradeSDKLeafCloseAttempt
+}
+type nativeUpgradeSDKCohortMember struct {
+	process                                            windows.Handle
+	token                                              windows.Token
+	observedToken                                      windows.Token // independent actual process-token observation
+	generation                                         upgradeSDKCohortGeneration
+	joined                                             bool
+	retiredProcess, retiredToken, retiredObservedToken upgradeSDKLeafCloseAttempt
+}
+
+var upgradeSDKCohortCustody = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeSDKCohort]struct{}
+}{owners: map[*nativeUpgradeSDKCohort]struct{}{}}
+
+func newNativeUpgradeSDKCohort(ctx context.Context, birth *nativeUpgradeSDKChild) (*nativeUpgradeSDKCohort, error) {
+	if birth == nil || birth.grant == nil || birth.grant.child != birth || birth.job == 0 || birth.process != 0 || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	co := &nativeUpgradeSDKCohort{birth: birth, members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{}, unknown: true}
+	upgradeSDKCohortCustody.Lock()
+	upgradeSDKCohortCustody.owners[co] = struct{}{}
+	upgradeSDKCohortCustody.Unlock()
+	// Preserve every output before examining the native result. This observer
+	// never receives TERMINATE/ASSIGN rights or loans a job handle to children.
+	err := windows.DuplicateHandle(windows.CurrentProcess(), birth.job, windows.CurrentProcess(), &co.job, 0x0004|windows.SYNCHRONIZE, false, 0)
+	if err != nil || co.job == 0 || checkUpgradeSDKJobLimits(co.job) != nil || checkUpgradeSDKJobBirth(co.job, 0) != nil {
+		return co, ErrUpgrade
+	}
+	total, active, err := co.accounting()
+	if err != nil || total != 0 || active != 0 || co.ledger.observe(total, active) != nil {
+		return co, ErrUpgrade
+	}
+	co.unknown = false
+	return co, nil
+}
+
+func (co *nativeUpgradeSDKCohort) accounting() (uint32, uint32, error) {
+	var accounting struct {
+		User, Kernel, PeriodUser, PeriodKernel int64
+		Faults, Total, Active, Terminated      uint32
+	}
+	if co.job == 0 || windows.QueryInformationJobObject(co.job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&accounting)), uint32(unsafe.Sizeof(accounting)), nil) != nil {
+		return 0, 0, ErrUpgrade
+	}
+	return accounting.Total, accounting.Active, nil
+}
+
+func (co *nativeUpgradeSDKCohort) captureRootBeforeResume(ctx context.Context, birth *nativeUpgradeSDKChild) error {
+	if co == nil || birth != co.birth || birth.process == 0 || !birth.expected.valid() {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.unknown || len(co.members) != 0 || checkUpgradeSDKJobBirth(co.job, birth.expected.PID) != nil {
+		return ErrUpgrade
+	}
+	m := &nativeUpgradeSDKCohortMember{}
+	co.partial = append(co.partial, m)
+	err := windows.DuplicateHandle(windows.CurrentProcess(), birth.process, windows.CurrentProcess(), &m.process, windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, false, 0)
+	if err != nil || co.captureHeld(ctx, m, birth.expected.Session, birth.grant.wire.Scope.SID) != nil || m.generation != (upgradeSDKCohortGeneration{birth.expected.PID, birth.expected.Creation}) {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	if co.ledger.registerRoot(m.generation) != nil {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	co.root, co.sid = birth.expected, birth.grant.wire.Scope.SID
+	total, active, err := co.accounting()
+	if err != nil || total != 1 || active != 1 || co.ledger.observe(total, active) != nil || co.ledger.complete() != nil {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Caller holds co.mu. Identity comes from the retained native process, never a
+// caller PID/hash. Live exact-job membership precedes ledger registration.
+func (co *nativeUpgradeSDKCohort) captureHeld(ctx context.Context, m *nativeUpgradeSDKCohortMember, session uint32, sid string) error {
+	if ctx == nil || ctx.Err() != nil || m.process == 0 {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(m.process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return ErrUpgrade
+	}
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(m.process), uintptr(co.job), uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 1 {
+		return ErrUpgrade
+	}
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(m.process))
+	var made, ended, kernel, user windows.Filetime
+	var actualSession uint32
+	if pid == 0 || windows.GetProcessTimes(m.process, &made, &ended, &kernel, &user) != nil || windows.ProcessIdToSessionId(uint32(pid), &actualSession) != nil || actualSession != session {
+		return ErrUpgrade
+	}
+	m.generation = upgradeSDKCohortGeneration{uint32(pid), uint64(made.HighDateTime)<<32 | uint64(made.LowDateTime)}
+	if windows.OpenProcessToken(m.process, windows.TOKEN_QUERY, &m.token) != nil || legacySDKOrdinaryToken(m.token, sid, session) != nil {
+		return ErrUpgrade
+	}
+	if co.ledger.capture(m.generation) != nil {
+		return ErrUpgrade
+	}
+	if old := co.members[m.generation]; old != nil {
+		return ErrUpgrade
+	} // no duplicate native custody in this prototype
+	co.members[m.generation] = m
+	return nil
+}
+
+// Bounded discovery is advisory until actual captured generations reconcile
+// cumulative totals. Missing/short-lived/rejected associations refuse; no name
+// allowlist or accounting count manufactures a native process handle.
+func (co *nativeUpgradeSDKCohort) observe(ctx context.Context) error {
+	if co == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.unknown || !co.root.valid() || co.sid == "" || co.birth == nil && co.receiver == nil {
+		return ErrUpgrade
+	}
+	var list struct {
+		Assigned, Count uint32
+		PIDs            [upgradeSDKCohortBound]uintptr
+	}
+	if windows.QueryInformationJobObject(co.job, windows.JobObjectBasicProcessIdList, uintptr(unsafe.Pointer(&list)), uint32(unsafe.Sizeof(list)), nil) != nil || list.Count > upgradeSDKCohortBound || list.Assigned != list.Count {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	for _, pid := range list.PIDs[:list.Count] {
+		if pid == 0 || pid > uintptr(^uint32(0)) {
+			co.unknown = true
+			return ErrUpgrade
+		}
+		known := false
+		// This is discovery dedup only, NEVER same-PID generation proof. Any
+		// unobserved reused/brief generation leaves a cumulative count gap and
+		// refuses completeness. Actual waits recheck every held generation.
+		for g := range co.members {
+			if g.PID == uint32(pid) {
+				known = true
+				break
+			}
+		}
+		if known {
+			continue
+		}
+		m := &nativeUpgradeSDKCohortMember{}
+		co.partial = append(co.partial, m)
+		var err error
+		m.process, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, false, uint32(pid))
+		if err != nil || co.captureHeld(ctx, m, co.root.Session, co.sid) != nil {
+			co.unknown = true
+			return ErrUpgrade
+		}
+	}
+	total, active, err := co.accounting()
+	if err != nil || co.ledger.observe(total, active) != nil || co.ledger.complete() != nil {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Positive waits on actual retained generations are a separate observation.
+// This method has no close/release/grant effect and cannot seal late births.
+func (co *nativeUpgradeSDKCohort) waitCaptured(ctx context.Context) error {
+	if co == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	return co.waitCapturedLocked(ctx)
+}
+
+// Actual product retirement holds co.mu and the original protocol mutex.
+// No callback into owner/protocol and no close or scope-admission grant.
+func (co *nativeUpgradeSDKCohort) waitCapturedLocked(ctx context.Context) error {
+	if co == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	if co.unknown || !co.root.valid() || co.birth == nil && co.receiver == nil || co.ledger.complete() != nil {
+		return ErrUpgrade
+	}
+	rootGeneration := upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}
+	root := co.members[rootGeneration]
+	if co.ledger.root == nil || *co.ledger.root != rootGeneration || root == nil || root.process == 0 || root.generation != rootGeneration {
+		return ErrUpgrade
+	}
+	for g, m := range co.members {
+		if m == nil || m.process == 0 || m.generation != g {
+			co.unknown = true
+			return ErrUpgrade
+		}
+		for {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			state, err := windows.WaitForSingleObject(m.process, 20)
+			if err != nil {
+				co.unknown = true
+				return ErrUpgrade
+			}
+			if state == uint32(windows.WAIT_OBJECT_0) {
+				break
+			}
+			if state != uint32(windows.WAIT_TIMEOUT) {
+				co.unknown = true
+				return ErrUpgrade
+			}
+		}
+		var made, ended, kernel, user windows.Filetime
+		var exit uint32
+		pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(m.process))
+		if uint32(pid) != g.PID || windows.GetProcessTimes(m.process, &made, &ended, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != g.Creation || windows.GetExitCodeProcess(m.process, &exit) != nil {
+			co.unknown = true
+			return ErrUpgrade
+		}
+		m.joined = true
+		if co.ledger.joined(g) != nil {
+			co.unknown = true
+			return ErrUpgrade
+		}
+	}
+	return co.ledger.allCapturedSignaled()
+}
+
+func (co *nativeUpgradeSDKCohort) requireRetirementAdmission(*nativeUpgradeSDKServingOwner) error {
+	// Actual supervisor cohort-handle adoption and real source birth/assignment
+	// seals are not implemented. Even complete counts + waits are not a grant.
+	return ErrUpgrade
+}
+
+// Known support preflight, before consuming close or stopping the sole pump.
+// This must remain distinct from final joined-source/native retirement proof.
+func (co *nativeUpgradeSDKCohort) requireRetirementSupport(*nativeUpgradeSDKServingOwner) error {
+	// OS end-of-birth/assignment and issued-guest/old-engine closure remain
+	// unavailable. Retained waits/cleanup source is not whole support or native
+	// qualification. Keep this known no-effect refusal.
+	return ErrUpgrade
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_commit.go b/rdd/pkg/managementconfig/upgrade_sdk_commit.go
new file mode 100644
index 0000000000000000000000000000000000000000..9ef480e69c66f8861c89e656c195000edd552f5d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_commit.go
@@ -0,0 +1,18 @@
+package managementconfig
+
+import "context"
+
+// Positive writer closure precedes the only signal. A lost write/flush/readback/
+// close reply never releases a child. Callers latch one attempt before entry.
+func finishSDKFinalSlot(ctx context.Context, writeFlushReadback, closeWriter, signal func() error) error {
+	if ctx == nil || ctx.Err() != nil || writeFlushReadback == nil || closeWriter == nil || signal == nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	if writeFlushReadback() != nil || ctx.Err() != nil || closeWriter() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return signal()
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_commit_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_commit_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ac263e74c17a0121a2412471244aec1b7d2303fc
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_commit_windows.go
@@ -0,0 +1,263 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// Wire v2 is shared with sdkstate.transitionFinalRecord. No paths or signing
+// material enter it. Parent creation/image is reobserved by the child, and the
+// original inherited read FILE_OBJECT + nonce + event are required separately.
+type upgradeSDKFinalRecord struct {
+	Schema                             int
+	Transaction                        string
+	Nonce, SDKDigest, ManagementRecord [32]byte
+	Sequence                           uint32
+	ParentPID                          uint32
+	ParentCreation                     uint64
+	ParentSession                      uint32
+	ParentImage                        [32]byte
+	ServingPID                         uint32
+	ServingCreation                    uint64
+	ServingSession                     uint32
+	ServingImage                       [32]byte
+}
+type nativeUpgradeSDKFinalSlot struct {
+	mu                                            sync.Mutex
+	owner                                         *upgradeAuthorityOwner
+	store                                         *nativeUpgradeStore
+	recorder                                      *upgradeRecorder
+	writer, reader, event, inheritedEvent, sealed windows.Handle
+	object                                        UpgradeObject
+	nonce                                         [32]byte
+	parent                                        UpgradeProcess
+	attempted, unknown, signaled, transferred     bool
+}
+
+// Only the actual imported authority and its actual private journal store may
+// issue a slot. It must be included in the selected SDK child's explicit handle
+// allowlist together with the retirement grant before that one child starts.
+// A pathname/receipt/boolean cannot construct this owner.
+func (o *upgradeAuthorityOwner) newSDKFinalSlot(ctx context.Context) (*nativeUpgradeSDKFinalSlot, error) {
+	if o == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, identityErr := currentOwner()
+	if identityErr != nil {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown || !o.imported || o.released || o.created == nil || o.image == nil || o.recorder == nil || o.cold == nil {
+		return nil, ErrUpgrade
+	}
+	o.image.mu.Lock()
+	defer o.image.mu.Unlock()
+	if checkSDKFinalImage(o.image, o.cold.sid) != nil {
+		return nil, ErrUpgrade
+	}
+	r := o.recorder
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	store, ok := r.sink.(*nativeUpgradeStore)
+	if !ok || store.sid != sid || r.uncertain || r.last.Journal.Stage != "data-imported" || o.image.Image().Hash != r.last.Journal.Incoming {
+		return nil, ErrUpgrade
+	}
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.closed || store.uncertain || store.sdkActive || store.parents == nil || store.parents.leaf() == 0 || verifyPrivate(store.parents.leaf(), store.sid, true) != nil {
+		return nil, ErrUpgrade
+	}
+	parent, err := currentUpgradeGeneration(r.last.Journal.Incoming)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	slot := &nativeUpgradeSDKFinalSlot{owner: o, store: store, recorder: r, parent: parent, unknown: true}
+	// Retain the actual store on any unknown creation or signal outcome.
+	store.sdkActive = true
+	if _, err := rand.Read(slot.nonce[:]); err != nil {
+		return slot, ErrUpgrade
+	}
+	name := "services.final-" + r.last.Journal.Transaction + ".grant"
+	sd, err := privateDescriptor(store.sid, false)
+	if err != nil {
+		return slot, ErrUpgrade
+	}
+	slot.writer, err = openSDKFinalFile(store.parents.leaf(), name, sd, true)
+	if err != nil || verifyPrivate(slot.writer, store.sid, false) != nil {
+		return slot, ErrUpgrade
+	}
+	slot.object, err = upgradeObjectID(slot.writer)
+	if err != nil {
+		return slot, ErrUpgrade
+	}
+	// This is a NEW read-only FILE_OBJECT, not a reduced-access duplicate of the
+	// writer's FILE_OBJECT. Parent writer denies competing writers/rename/delete.
+	slot.reader, err = openSDKFinalFile(store.parents.leaf(), name, nil, false)
+	if err != nil || windows.SetHandleInformation(slot.reader, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return slot, ErrUpgrade
+	}
+	slot.event, err = windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil || windows.DuplicateHandle(windows.CurrentProcess(), slot.event, windows.CurrentProcess(), &slot.inheritedEvent, windows.SYNCHRONIZE, true, 0) != nil {
+		return slot, ErrUpgrade
+	}
+	slot.unknown = false
+	return slot, nil
+}
+func openSDKFinalFile(parent windows.Handle, name string, sd *windows.SECURITY_DESCRIPTOR, writer bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.FILE_READ_DATA | windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL | windows.SYNCHRONIZE)
+	share, disposition := uint32(windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE), uint32(windows.FILE_OPEN)
+	if writer {
+		access |= windows.FILE_WRITE_DATA
+		share = windows.FILE_SHARE_READ
+		disposition = windows.FILE_CREATE
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, share, disposition, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	runtime.KeepAlive(sd)
+	return h, err
+}
+func (s *nativeUpgradeSDKFinalSlot) transfer() (upgradeSDKFinalTransfer, error) {
+	if s == nil {
+		return upgradeSDKFinalTransfer{}, ErrUpgrade
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.unknown || s.attempted || s.transferred || s.reader == 0 || s.inheritedEvent == 0 || !s.object.valid() {
+		return upgradeSDKFinalTransfer{}, ErrUpgrade
+	}
+	s.transferred = true
+	return upgradeSDKFinalTransfer{uint64(s.reader), uint64(s.inheritedEvent), fmt.Sprintf("%08x:%08x%08x", s.object.Volume, s.object.High, s.object.Low), s.nonce}, nil
+}
+func (s *nativeUpgradeSDKFinalSlot) finalize(ctx context.Context, commit *upgradeSDKCommit) error {
+	if s == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, identityErr := currentOwner()
+	if identityErr != nil || s.store == nil || sid != s.store.sid {
+		return ErrUpgrade
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.attempted || s.unknown || !s.transferred || commit == nil || commit.recorder != s.recorder || commit.check() != nil || commit.record.Journal.Transaction != s.owner.fence.Transaction {
+		return ErrUpgrade
+	}
+	s.attempted, s.unknown = true, true
+	s.owner.image.mu.Lock()
+	defer s.owner.image.mu.Unlock()
+	if checkSDKFinalImage(s.owner.image, s.store.sid) != nil {
+		return ErrUpgrade
+	}
+	actual, err := currentUpgradeGeneration(commit.record.Journal.Incoming)
+	if err != nil || actual != s.parent || s.owner.image == nil || s.owner.image.Image().Hash != s.parent.Image {
+		return ErrUpgrade
+	}
+	s.recorder.mu.Lock()
+	defer s.recorder.mu.Unlock()
+	if s.recorder.uncertain || s.recorder.digest != commit.digest || s.recorder.last.Sequence != commit.record.Sequence {
+		return ErrUpgrade
+	}
+	s.store.mu.Lock()
+	defer s.store.mu.Unlock()
+	if s.store.closed || s.store.uncertain || s.writer == 0 || verifyPrivate(s.writer, s.store.sid, false) != nil {
+		return ErrUpgrade
+	}
+	id, err := upgradeObjectID(s.writer)
+	if err != nil || id != s.object {
+		return ErrUpgrade
+	}
+	serving := commit.record.Journal.Candidate
+	if !serving.valid() || serving.PID == s.parent.PID || serving.Creation <= s.parent.Creation || serving.Session != s.parent.Session || serving.Image != s.parent.Image {
+		return ErrUpgrade
+	}
+	// This is the candidate selected by the actual committed journal. It is
+	// only a target for native observation, never an accepted SDK job-owner ACK.
+	wire := upgradeSDKFinalRecord{2, commit.record.Journal.Transaction, s.nonce, commit.record.Journal.SDKDigest, commit.digest, commit.record.Sequence, s.parent.PID, s.parent.Creation, s.parent.Session, s.parent.Image, serving.PID, serving.Creation, serving.Session, serving.Image}
+	data, err := json.Marshal(wire)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if finishSDKFinalSlot(ctx, func() error {
+		for remaining := data; len(remaining) > 0; {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			n, err := nativeWrite(s.writer, remaining)
+			if err != nil || n < 1 || n > len(remaining) {
+				return ErrUpgrade
+			}
+			remaining = remaining[n:]
+		}
+		if windows.FlushFileBuffers(s.writer) != nil || verifyUpgradeWritten(ctx, s.writer, data) != nil || verifyPrivate(s.writer, s.store.sid, false) != nil {
+			return ErrUpgrade
+		}
+		return nil
+	}, func() error {
+		if windows.CloseHandle(s.writer) != nil {
+			return ErrUpgrade
+		}
+		s.writer = 0
+		// A new deny-write FILE_OBJECT must pin the closed writer's exact bytes
+		// before signal. A racing reopen makes this fail, never a permissive gap.
+		var err error
+		s.sealed, err = openRelative(s.store.parents.leaf(), "services.final-"+wire.Transaction+".grant", false, nil, false)
+		if err != nil || verifyPrivate(s.sealed, s.store.sid, false) != nil {
+			return ErrUpgrade
+		}
+		id, err := upgradeObjectID(s.sealed)
+		if err != nil || id != s.object || verifyUpgradeWritten(ctx, s.sealed, data) != nil {
+			return ErrUpgrade
+		}
+		return nil
+	}, func() error { return windows.SetEvent(s.event) }) != nil {
+		return ErrUpgrade
+	}
+	s.signaled, s.unknown = true, false
+	// The slot alone cannot acknowledge SDK marker durability. The retained SDK
+	// peer owner must observe that exact marker before finalizeUpgradeSDK succeeds.
+	return nil
+}
+
+// Caller holds image.mu through admission/publication so closure cannot lend a
+// stale cached hash. HoldServingImage already hashed the deny-write exact file.
+func checkSDKFinalImage(image *ServingImageLease, sid string) error {
+	if image == nil || image.closed || image.err != nil || len(image.chain) == 0 || !image.image.Present {
+		return ErrUpgrade
+	}
+	for i, h := range image.chain {
+		if h == 0 || checkReadObject(h, sid, i < len(image.chain)-1) != nil {
+			return ErrUpgrade
+		}
+	}
+	leaf := image.chain[len(image.chain)-1]
+	id, err := upgradeObjectID(leaf)
+	if err != nil || id != (UpgradeObject{image.image.Volume, image.image.High, image.image.Low}) || verifyPrivate(leaf, sid, false) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_control_client_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_control_client_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b4a00415492cf52d8966c461539e34017bbd2b65
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_control_client_windows.go
@@ -0,0 +1,86 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+)
+
+func (c *nativeUpgradeSDKChild) call(ctx context.Context, operation string) (reply upgradeSDKControlReply, resultErr error) {
+	var empty upgradeSDKControlReply
+	if c == nil || ctx == nil || ctx.Err() != nil || !c.protocol.TryLock() {
+		return empty, ErrUpgrade
+	}
+	defer c.protocol.Unlock()
+	if c.controlOffered {
+		return empty, ErrUpgrade
+	}
+	switch operation {
+	case "inventory", "start-runtime", "commit":
+	default:
+		return empty, ErrUpgrade
+	}
+	if c.recheckIngressBirth(ctx) != nil || c.grant.denial.recheckTransferred(ctx) != nil {
+		return empty, ErrUpgrade
+	}
+	if c.sequence == ^uint32(0) {
+		return empty, ErrUpgrade
+	}
+	c.sequence++ // One use before the first byte; no lost-reply request replay.
+	defer func() {
+		if resultErr != nil {
+			c.mu.Lock()
+			c.unknown = true
+			c.mu.Unlock()
+		}
+	}()
+	return c.exchangeControlLocked(ctx, upgradeSDKControlRequest{Schema: 1, Sequence: c.sequence, Operation: operation})
+}
+
+// Only the actual TEMP owner under protocol may call this. The normal call
+// path refuses after offer; the sole reserved exception is the actual native
+// suspended candidate provisioner before its first Resume.
+func (c *nativeUpgradeSDKChild) exchangeControlLocked(ctx context.Context, request upgradeSDKControlRequest) (upgradeSDKControlReply, error) {
+	var empty upgradeSDKControlReply
+	body, _ := json.Marshal(request)
+	var head [4]byte
+	binary.LittleEndian.PutUint32(head[:], uint32(len(body)))
+	if c.controlFull(ctx, head[:], true) != nil || c.controlFull(ctx, body, true) != nil || c.controlFull(ctx, head[:], false) != nil {
+		return empty, ErrUpgrade
+	}
+	size := binary.LittleEndian.Uint32(head[:])
+	if size == 0 || size > 2<<20 {
+		return empty, ErrUpgrade
+	}
+	body = make([]byte, size)
+	if c.controlFull(ctx, body, false) != nil || c.recheckIngressBirth(ctx) != nil || c.grant.denial.recheckTransferred(ctx) != nil {
+		return empty, ErrUpgrade
+	}
+	r, err := parseUpgradeSDKControlReply(body, c.sequence, request.Operation)
+	if err != nil {
+		return empty, ErrUpgrade
+	}
+	if r.Receipt != nil {
+		if _, err := r.Receipt.digest(c.grant.wire.Scope); err != nil {
+			return empty, ErrUpgrade
+		}
+	}
+	return r, nil
+}
+
+func (c *nativeUpgradeSDKChild) controlFull(ctx context.Context, body []byte, write bool) error {
+	for len(body) > 0 {
+		chunk := body
+		if len(chunk) > 64<<10 {
+			chunk = chunk[:64<<10]
+		}
+		n, err := c.control.perform(ctx, chunk, write)
+		if err != nil || n <= 0 || n > len(chunk) {
+			return ErrUpgrade
+		}
+		body = body[n:]
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_control_io_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_control_io_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..df9a6007583810e09f00cc30bb6addfaa6a527f4
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_control_io_windows.go
@@ -0,0 +1,147 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"time"
+	"unsafe"
+)
+
+// The SAME control FILE_OBJECT crosses the serving-owner handoff. It must never
+// be wrapped in os.File/WinIO or associated with an IOCP in either process.
+// Borrowed pipe ownership remains with the enclosing native launch owner. One
+// bounded event-based operation is admitted at a time; unknown completion pins
+// its buffer/OVERLAPPED/event in this owner forever rather than freeing memory
+// while the kernel may still use it. No process termination is performed here.
+type upgradeSDKControlIO struct {
+	mu      sync.Mutex
+	pipe    windows.Handle
+	op      *upgradeSDKControlOperation
+	unknown bool
+}
+type upgradeSDKControlOperation struct {
+	ov     windows.Overlapped
+	buffer []byte
+	pinned runtime.Pinner
+}
+
+// Process-lifetime memory quarantine, NEVER an authority source. A caller may
+// drop its returned owner after an error; the kernel's pending buffer pointers
+// must still outlive GC/Pinner finalizers. Unknown entries have no removal API.
+var upgradeSDKControlQuarantine = struct {
+	sync.Mutex
+	owners map[*upgradeSDKControlIO]struct{}
+}{owners: map[*upgradeSDKControlIO]struct{}{}}
+
+func (p *upgradeSDKControlIO) perform(ctx context.Context, data []byte, write bool) (int, error) {
+	if p == nil || ctx == nil || ctx.Err() != nil || len(data) == 0 || len(data) > 64<<10 {
+		return 0, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return 0, ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+	// The closed request/reply pump has one native I/O owner. Refuse accidental
+	// concurrent callers immediately, without waiting past their cancellation.
+	if !p.mu.TryLock() {
+		return 0, ErrUpgrade
+	}
+	defer func() {
+		if p.unknown || p.op != nil {
+			p.unknown = true
+			upgradeSDKControlQuarantine.Lock()
+			upgradeSDKControlQuarantine.owners[p] = struct{}{}
+			upgradeSDKControlQuarantine.Unlock()
+		}
+		p.mu.Unlock()
+	}()
+	if p.pipe == 0 || p.pipe == windows.InvalidHandle || p.unknown || p.op != nil {
+		return 0, ErrUpgrade
+	}
+	o := &upgradeSDKControlOperation{buffer: make([]byte, len(data))}
+	p.op = o // Retain every partial operation before admission.
+	var err error
+	o.ov.HEvent, err = windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil {
+		p.unknown = true
+		return 0, ErrUpgrade
+	}
+	if write {
+		copy(o.buffer, data)
+	}
+	o.pinned.Pin(&o.ov)
+	o.pinned.Pin(&o.buffer[0])
+	// Use the native overlapped API with NULL byte-count as documented. The
+	// pinned x/sys convenience wrappers dereference that pointer under -race;
+	// their synchronous byte-count instrumentation is not this async lifetime.
+	name := "ReadFile"
+	if write {
+		name = "WriteFile"
+	}
+	accepted, _, nativeErr := windows.NewLazySystemDLL("kernel32.dll").NewProc(name).Call(uintptr(p.pipe), uintptr(unsafe.Pointer(&o.buffer[0])), uintptr(len(o.buffer)), 0, uintptr(unsafe.Pointer(&o.ov)))
+	err = nil
+	if accepted == 0 {
+		err = nativeErr
+	}
+	if err != nil && err != windows.ERROR_IO_PENDING {
+		// Native refusal before asynchronous admission has no outstanding I/O.
+		o.pinned.Unpin()
+		if windows.CloseHandle(o.ov.HEvent) != nil {
+			p.unknown = true
+			return 0, ErrUpgrade
+		}
+		p.op, p.unknown = nil, true
+		return 0, ErrUpgrade
+	}
+	canceled := false
+	var cleanupDeadline time.Time
+	for {
+		if ctx.Err() != nil && !canceled {
+			canceled = true
+			cleanupDeadline = time.Now().Add(2 * time.Second)
+			if cancelErr := windows.CancelIoEx(p.pipe, &o.ov); cancelErr != nil && cancelErr != windows.ERROR_NOT_FOUND {
+				p.unknown = true
+				return 0, ErrUpgrade // Original pinned operation remains reachable.
+			}
+		}
+		state, waitErr := windows.WaitForSingleObject(o.ov.HEvent, 25)
+		if waitErr != nil || state != uint32(windows.WAIT_OBJECT_0) && state != uint32(windows.WAIT_TIMEOUT) {
+			p.unknown = true
+			return 0, ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			var count uint32
+			resultErr := windows.GetOverlappedResult(p.pipe, &o.ov, &count, false)
+			if resultErr == windows.ERROR_IO_INCOMPLETE {
+				p.unknown = true
+				return 0, ErrUpgrade
+			}
+			// The private unsignaled event is kernel-completed. Only now may the
+			// pinned operation memory be released, including canceled operations.
+			o.pinned.Unpin()
+			if windows.CloseHandle(o.ov.HEvent) != nil {
+				p.unknown = true
+				return 0, ErrUpgrade
+			}
+			p.op = nil
+			if count > uint32(len(data)) || resultErr != nil || canceled || count == 0 {
+				p.unknown = true
+				return 0, ErrUpgrade
+			}
+			if !write {
+				copy(data, o.buffer[:count])
+			}
+			clear(o.buffer)
+			return int(count), nil
+		}
+		if canceled && time.Now().After(cleanupDeadline) {
+			p.unknown = true
+			return 0, ErrUpgrade
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_control_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_control_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..67be891428ea96a63d293cedd64770d875570337
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_control_windows.go
@@ -0,0 +1,134 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"golang.org/x/sys/windows"
+	"sync"
+	"time"
+	"unsafe"
+)
+
+var upgradeSDKControlConnectQuarantine = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeSDKGrant]struct{}
+}{owners: map[*nativeUpgradeSDKGrant]struct{}{}}
+
+// Creates the original private duplex control pair, NEVER IOCP-associated.
+// Only the raw server end is inherited into SDK; the actual temporary owner
+// retains the client end for a later same-FILE_OBJECT serving-owner transfer.
+func (g *nativeUpgradeSDKGrant) prepareControl(ctx context.Context, sid string) (result error) {
+	if g == nil || ctx == nil || ctx.Err() != nil || g.controlServer != 0 || g.controlClient != 0 || sid == "" {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	defer func() {
+		if result != nil && g.controlConnect != nil {
+			upgradeSDKControlConnectQuarantine.Lock()
+			upgradeSDKControlConnectQuarantine.owners[g] = struct{}{}
+			upgradeSDKControlConnectQuarantine.Unlock()
+		}
+	}()
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return ErrUpgrade
+	}
+	name, err := windows.UTF16PtrFromString(`\\.\pipe\OrbWinSDKCold-` + hex.EncodeToString(nonce[:]))
+	if err != nil {
+		return ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	sa := windows.SecurityAttributes{Length: uint32(unsafe.Sizeof(windows.SecurityAttributes{})), SecurityDescriptor: sd}
+	g.controlServer, err = windows.CreateNamedPipe(name, windows.PIPE_ACCESS_DUPLEX|windows.FILE_FLAG_OVERLAPPED|windows.FILE_FLAG_FIRST_PIPE_INSTANCE, windows.PIPE_TYPE_BYTE|windows.PIPE_READMODE_BYTE|windows.PIPE_WAIT|windows.PIPE_REJECT_REMOTE_CLIENTS, 1, 64<<10, 64<<10, 0, &sa)
+	if err != nil || verifySDKControlDACL(g.controlServer, sid) != nil {
+		return ErrUpgrade
+	}
+	o := &upgradeSDKControlOperation{}
+	g.controlConnect = o // Strong quarantine on unknown connection completion.
+	o.ov.HEvent, err = windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil {
+		return ErrUpgrade
+	}
+	o.pinned.Pin(&o.ov)
+	connectErr := windows.ConnectNamedPipe(g.controlServer, &o.ov)
+	if connectErr != nil && connectErr != windows.ERROR_IO_PENDING && connectErr != windows.ERROR_PIPE_CONNECTED {
+		return ErrUpgrade
+	}
+	g.controlClient, err = windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE|windows.READ_CONTROL, 0, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OVERLAPPED|windows.SECURITY_SQOS_PRESENT|windows.SECURITY_IDENTIFICATION, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if connectErr != windows.ERROR_PIPE_CONNECTED {
+		for {
+			if ctx.Err() != nil {
+				_ = windows.CancelIoEx(g.controlServer, &o.ov)
+				return ErrUpgrade // Pinned connection + original objects retained.
+			}
+			state, waitErr := windows.WaitForSingleObject(o.ov.HEvent, 25)
+			if waitErr != nil || state != uint32(windows.WAIT_TIMEOUT) && state != uint32(windows.WAIT_OBJECT_0) {
+				return ErrUpgrade
+			}
+			if state == uint32(windows.WAIT_OBJECT_0) {
+				var count uint32
+				if windows.GetOverlappedResult(g.controlServer, &o.ov, &count, false) != nil {
+					return ErrUpgrade
+				}
+				break
+			}
+		}
+	}
+	o.pinned.Unpin()
+	if windows.CloseHandle(o.ov.HEvent) != nil {
+		return ErrUpgrade
+	}
+	g.controlConnect = nil
+	var clientPID uint32
+	if windows.GetNamedPipeClientProcessId(g.controlServer, &clientPID) != nil || clientPID != windows.GetCurrentProcessId() || verifySDKControlDACL(g.controlClient, sid) != nil || windows.SetHandleInformation(g.controlServer, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func verifySDKControlDACL(h windows.Handle, sid string) error {
+	kind, err := windows.GetFileType(h)
+	if err != nil || kind != windows.FILE_TYPE_PIPE {
+		return ErrUpgrade
+	}
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if err != nil || sd == nil {
+		return ErrUpgrade
+	}
+	owner, _, err := sd.Owner()
+	control, _, controlErr := sd.Control()
+	acl, _, aclErr := sd.DACL()
+	if err != nil || owner == nil || owner.String() != sid || controlErr != nil || control&windows.SE_DACL_PROTECTED == 0 || aclErr != nil || acl == nil || acl.AceCount != 3 {
+		return ErrUpgrade
+	}
+	seen := map[string]bool{}
+	for n := uint32(0); n < 3; n++ {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if windows.GetAce(acl, n, &ace) != nil || ace == nil || ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceFlags != 0 || ace.Header.AceSize < 16 || uint32(ace.Mask) != 0x1f01ff {
+			return ErrUpgrade
+		}
+		principal := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		if !principal.IsValid() || principal.Len() > int(ace.Header.AceSize)-8 {
+			return ErrUpgrade
+		}
+		value := principal.String()
+		if seen[value] || value != sid && value != "S-1-5-18" && value != "S-1-5-32-544" {
+			return ErrUpgrade
+		}
+		seen[value] = true
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_denial_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_denial_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..09761127856477f1bdb30f181543bfeec2edbfd0
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_denial_windows.go
@@ -0,0 +1,466 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// Persistent READONLY denies the supported old SDK's actual RW OPEN_ALWAYS
+// serviceLease even between new owners. It is DENIAL ONLY, never credential,
+// publisher, historical cleanup or ACL authority. Native filesystem behavior
+// needs disposable qualification before any production route may use this.
+type nativeUpgradeSDKDenial struct {
+	mu                               sync.Mutex
+	retirement                       *upgradeRetirement
+	peer                             *nativeUpgradeLegacySDKPeer
+	recorder                         *upgradeRecorder
+	journalDigest                    [32]byte
+	journal                          upgradeJournal
+	sequence                         uint32
+	sdkDigest                        [32]byte
+	observedStage                    string
+	observedDigest                   [32]byte
+	store                            *nativeUpgradeStore
+	parents                          []windows.Handle
+	legacy                           windows.Handle
+	inherited                        []windows.Handle
+	controller                       windows.Handle // the only RW FILE_OBJECT; never duplicated/inherited
+	reader                           windows.Handle
+	receipt                          windows.Handle
+	sealed                           windows.Handle
+	metadataRoot, metadataController windows.Handle
+	transferred                      bool
+	root, object                     UpgradeObject
+	before, after                    uint32
+	admitted, unknown, converted     bool
+}
+type upgradeSDKDenialRecord struct {
+	Schema                                                               int
+	Transaction                                                          string
+	Root, Controller                                                     UpgradeObject
+	Before, After                                                        uint32
+	RootBeforeACL, RootAfterACL, ControllerBeforeACL, ControllerAfterACL [32]byte
+	Stage                                                                string
+}
+
+// No caller path/raw handle or boolean constructor. The combined held native
+// retirement and the actual private journal owner must already exist.
+func (r *upgradeRetirement) denyLegacySDK(ctx context.Context, recorder *upgradeRecorder, peer *nativeUpgradeLegacySDKPeer) (out *nativeUpgradeSDKDenial, result error) {
+	if r == nil || recorder == nil || peer == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if r.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	store, ok := recorder.sink.(*nativeUpgradeStore)
+	j := recorder.last.Journal
+	if !ok || recorder.uncertain || j.Stage != "data-imported" || !upgradeIntentEqual(j, r.journal) {
+		recorder.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	store.mu.Lock()
+	if store.closed || store.uncertain || store.sdkDenialActive || store.parents == nil {
+		store.mu.Unlock()
+		recorder.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	sid, err := currentOwner()
+	if err != nil || sid != store.sid || sid != r.root.sid {
+		store.mu.Unlock()
+		recorder.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	d := &nativeUpgradeSDKDenial{retirement: r, peer: peer, store: store, recorder: recorder, journalDigest: recorder.digest, journal: j, sequence: recorder.last.Sequence, observedStage: j.Stage, observedDigest: recorder.digest, unknown: true}
+	out = d
+	store.sdkDenialActive = true // uncertain creation/conversion retains this owner
+	store.mu.Unlock()
+	recorder.mu.Unlock()
+	volume, parts, err := readerComponents(filepath.Join(r.root.home, ".rdorbwin", "local-services"))
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	path, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	h, err := windows.CreateFile(path, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	d.parents = append(d.parents, h)
+	if objectKind(h, true) != nil {
+		return d, ErrUpgrade
+	}
+	for _, part := range parts {
+		h, err = openLegacyMetadata(h, part, true)
+		if err != nil {
+			return d, ErrUpgrade
+		}
+		d.parents = append(d.parents, h)
+		if objectKind(h, true) != nil {
+			return d, ErrUpgrade
+		}
+	}
+	if upgradeSDKOwned(h, sid, true) != nil {
+		return d, ErrUpgrade
+	}
+	d.legacy = h
+	d.root, err = upgradeObjectID(h)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	d.controller, err = peer.takeControllerForDenial(ctx, r, d.root)
+	if err != nil || upgradeSDKOwned(d.controller, sid, false) != nil {
+		return d, ErrUpgrade
+	}
+	d.object, err = upgradeObjectID(d.controller)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(d.controller, &info) != nil {
+		return d, ErrUpgrade
+	}
+	d.before = info.FileAttributes
+	// Refuse unsupported metadata rather than normalize it during migration.
+	if d.before & ^uint32(windows.FILE_ATTRIBUTE_NORMAL|windows.FILE_ATTRIBUTE_ARCHIVE) != 0 {
+		return d, ErrUpgrade
+	}
+	d.after = (d.before & ^uint32(windows.FILE_ATTRIBUTE_NORMAL)) | windows.FILE_ATTRIBUTE_READONLY
+	// Metadata-only WRITE_DAC opens preserve the exclusive data FILE_OBJECT.
+	// Controller intersection was observed in disposable v2; this fixed source
+	// directory walk/seal and whole-tree policy remain separate native gates.
+	d.metadataRoot, err = openSDKDenialMetadata(d.parents[len(d.parents)-2], "local-services", true)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	d.metadataController, err = openSDKDenialMetadata(d.legacy, "controller.lock", false)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	rootBefore, err := sdkDenialACL(d.metadataRoot)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	controllerBefore, err := sdkDenialACL(d.metadataController)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	record := upgradeSDKDenialRecord{Schema: 1, Transaction: j.Transaction, Root: d.root, Controller: d.object, Before: d.before, After: d.after, RootBeforeACL: rootBefore, ControllerBeforeACL: controllerBefore, Stage: "attribute-change-admitted"}
+	body, _ := json.Marshal(record)
+	d.receipt, err = createUpgradeWorkingFile(store.parents.leaf(), "services.denial-"+j.Transaction+"-admitted", sid)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	if writeSDKDenialRecord(ctx, d.receipt, body, sid) != nil || d.recheck(ctx) != nil {
+		return d, ErrUpgrade
+	}
+	d.admitted = true
+	// Seal the exact controller before its parent; only actual current owner and
+	// held native IDs authorize this mutation. Historical DACLs/receipts do not.
+	if sealSDKDenialObject(d.metadataController, sid, false, d.object) != nil || sealSDKDenialObject(d.metadataRoot, sid, true, d.root) != nil {
+		return d, ErrUpgrade
+	}
+	record.RootAfterACL, err = sdkDenialACL(d.metadataRoot)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	record.ControllerAfterACL, err = sdkDenialACL(d.metadataController)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	// FILE_BASIC_INFO (Windows SDK): zero times preserve them; only attributes
+	// change on this held exact file, never through a mutable source pathname.
+	basic := struct {
+		Creation, Access, Write, Change int64
+		Attributes                      uint32
+	}{Attributes: d.after}
+	if windows.SetFileInformationByHandle(d.controller, windows.FileBasicInfo, (*byte)(unsafe.Pointer(&basic)), uint32(unsafe.Sizeof(basic))) != nil || windows.FlushFileBuffers(d.controller) != nil {
+		return d, ErrUpgrade
+	}
+	if windows.GetFileInformationByHandle(d.controller, &info) != nil || info.FileAttributes != d.after || upgradeSDKOwned(d.controller, sid, false) != nil {
+		return d, ErrUpgrade
+	}
+	actual, err := upgradeObjectID(d.controller)
+	if err != nil || actual != d.object || d.recheck(ctx) != nil {
+		return d, ErrUpgrade
+	}
+	// This owner has never duplicated the RW file. Initial SDK inheritance occurs
+	// only AFTER this positive close and SAME-ID read-only/share0 reacquisition.
+	// The peer's original capture retains only an observation after transfer.
+	// Serialize native handle closure/reopen with that observer so it cannot
+	// query a closed/reused numeric value during the handoff.
+	peer.mu.Lock()
+	if windows.CloseHandle(d.controller) != nil {
+		peer.unknown = true
+		peer.mu.Unlock()
+		return d, ErrUpgrade
+	}
+	d.controller = 0
+	peer.controller = 0
+	d.reader, err = openSDKDenialController(h, false)
+	if err != nil || upgradeSDKOwned(d.reader, sid, false) != nil {
+		peer.unknown = true
+		peer.mu.Unlock()
+		return d, ErrUpgrade
+	}
+	actual, err = upgradeObjectID(d.reader)
+	if err != nil || actual != d.object || windows.GetFileInformationByHandle(d.reader, &info) != nil || info.FileAttributes != d.after {
+		peer.unknown = true
+		peer.mu.Unlock()
+		return d, ErrUpgrade
+	}
+	peer.controller = d.reader
+	peer.mu.Unlock()
+	if d.recheck(ctx) != nil {
+		return d, ErrUpgrade
+	}
+	record.Stage = "readonly-owner-acquired"
+	body, _ = json.Marshal(record)
+	committed, err := createUpgradeWorkingFile(store.parents.leaf(), "services.denial-"+j.Transaction+"-sealed", sid)
+	if err != nil {
+		return d, ErrUpgrade
+	}
+	d.parents = append(d.parents, committed)
+	if writeSDKDenialRecord(ctx, committed, body, sid) != nil {
+		return d, ErrUpgrade
+	}
+	if windows.CloseHandle(committed) != nil {
+		return d, ErrUpgrade
+	}
+	d.parents[len(d.parents)-1] = 0
+	d.sealed, err = openRelative(store.parents.leaf(), "services.denial-"+j.Transaction+"-sealed", false, nil, false)
+	if err != nil || verifyPrivate(d.sealed, sid, false) != nil || verifyUpgradeWritten(ctx, d.sealed, body) != nil {
+		return d, ErrUpgrade
+	}
+	d.converted, d.unknown = true, false
+	return d, nil
+}
+
+func openSDKDenialMetadata(parent windows.Handle, name string, dir bool) (windows.Handle, error) {
+	if name != "local-services" && name != "controller.lock" {
+		return 0, ErrUpgrade
+	}
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE)
+	access := uint32(windows.READ_CONTROL | windows.WRITE_DAC | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	if dir {
+		options = windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_DIRECTORY_FILE
+		access |= windows.FILE_TRAVERSE // participate in no-delete sharing, no LIST
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, options, 0, 0)
+	return h, err
+}
+func sdkDenialACL(h windows.Handle) ([32]byte, error) {
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if err != nil || sd == nil || sd.Length() < 20 || sd.Length() > 128<<10 {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256([]byte(sd.String())), nil
+}
+func sealSDKDenialObject(h windows.Handle, sid string, dir bool, want UpgradeObject) error {
+	id, err := upgradeObjectID(h)
+	if err != nil || id != want || upgradeSDKOwned(h, sid, dir) != nil {
+		return ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, dir)
+	if err != nil {
+		return ErrUpgrade
+	}
+	acl, _, err := sd.DACL()
+	if err != nil || acl == nil {
+		return ErrUpgrade
+	}
+	if windows.SetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil || verifyPrivate(h, sid, dir) != nil {
+		return ErrUpgrade
+	}
+	id, err = upgradeObjectID(h)
+	if err != nil || id != want {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+type upgradeSDKDenialTransfer struct{ LegacyRoot, Controller, Denial uint64 }
+
+func (d *nativeUpgradeSDKDenial) transfer(ctx context.Context) (upgradeSDKDenialTransfer, error) {
+	if d == nil {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != d.store.sid {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.unknown || !d.converted || d.transferred || d.reader == 0 || d.sealed == 0 || d.recheck(ctx) != nil {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	d.transferred = true
+	// From the first native open onward, a lost reply can leave a partially
+	// prepared inherited set. Retain it as unknown; it must not look like a
+	// successful converted owner to a future peer-composition implementation.
+	d.unknown = true
+	// Capture the exact original directory with WRITE_DAC metadata access for
+	// the SDK's later per-object seal. Metadata access does not release/share the
+	// separate read-only data lock or turn historical DACLs into authority.
+	text, err := windows.NewNTUnicodeString("local-services")
+	if err != nil {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	if len(d.parents) < 3 {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	// parents includes the closed sealed receipt slot; the original directory is
+	// immediately before it and its parent immediately before the directory.
+	parent := d.parents[len(d.parents)-3]
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var directory windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&directory, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL|windows.WRITE_DAC|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, windows.FILE_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if err != nil {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	d.inherited = append(d.inherited, directory)
+	actual, err := upgradeObjectID(directory)
+	if err != nil || actual != d.root || upgradeSDKOwned(directory, d.store.sid, true) != nil {
+		return upgradeSDKDenialTransfer{}, ErrUpgrade
+	}
+	var handles [3]windows.Handle
+	for i, source := range []windows.Handle{directory, d.reader, d.sealed} {
+		if windows.DuplicateHandle(windows.CurrentProcess(), source, windows.CurrentProcess(), &handles[i], 0, true, windows.DUPLICATE_SAME_ACCESS) != nil {
+			return upgradeSDKDenialTransfer{}, ErrUpgrade
+		}
+		d.inherited = append(d.inherited, handles[i])
+	}
+	d.unknown = false
+	return upgradeSDKDenialTransfer{uint64(handles[0]), uint64(handles[1]), uint64(handles[2])}, nil
+}
+
+func (d *nativeUpgradeSDKDenial) recheck(ctx context.Context) error {
+	if d == nil || d.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	d.recorder.mu.Lock()
+	defer d.recorder.mu.Unlock()
+	d.store.mu.Lock()
+	defer d.store.mu.Unlock()
+	if d.recorder.uncertain || d.recorder.digest != d.journalDigest || d.store.closed || d.store.uncertain || !d.store.sdkDenialActive {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// After transfer, activation legitimately advances this same held recorder.
+// Keep the strict original digest check above for conversion/transfer; this
+// distinct phase observes only acknowledged monotonic activation records.
+// It supplies denial continuity only. It cannot replace the SDK peer's actual
+// owner/listener checks or create a retirement grant.
+func (d *nativeUpgradeSDKDenial) recheckTransferred(ctx context.Context) error {
+	if d == nil {
+		return ErrUpgrade
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.unknown || !d.converted || !d.transferred || d.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	d.recorder.mu.Lock()
+	defer d.recorder.mu.Unlock()
+	d.store.mu.Lock()
+	defer d.store.mu.Unlock()
+	actual, ok := d.recorder.sink.(*nativeUpgradeStore)
+	j := d.recorder.last.Journal
+	body, err := upgradeRecordBytes(d.recorder.last)
+	if !ok || actual != d.store || d.recorder.uncertain || d.store.closed || d.store.uncertain || !d.store.sdkDenialActive || err != nil || sha256.Sum256(body) != d.recorder.digest || !upgradeSDKTransferredJournal(d.journal, j) || !upgradeSDKTransferredProgress(d.sequence, d.observedStage, d.observedDigest, d.sdkDigest, d.recorder.last, d.recorder.digest) {
+		return ErrUpgrade
+	}
+	// Reobserve the persistent denial on the actual retained original objects.
+	for _, entry := range []struct {
+		h   windows.Handle
+		id  UpgradeObject
+		dir bool
+	}{{d.legacy, d.root, true}, {d.reader, d.object, false}} {
+		id, err := upgradeObjectID(entry.h)
+		if err != nil || id != entry.id || verifyPrivate(entry.h, d.store.sid, entry.dir) != nil {
+			return ErrUpgrade
+		}
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(d.reader, &info) != nil || info.FileAttributes != d.after {
+		return ErrUpgrade
+	}
+	d.sequence, d.sdkDigest = d.recorder.last.Sequence, j.SDKDigest
+	d.observedStage, d.observedDigest = j.Stage, d.recorder.digest
+	return nil
+}
+func openSDKDenialController(parent windows.Handle, write bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString("controller.lock")
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.GENERIC_READ | windows.READ_CONTROL | windows.SYNCHRONIZE)
+	if write {
+		access |= windows.GENERIC_WRITE
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, 0, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	return h, err
+}
+func upgradeSDKOwned(h windows.Handle, sid string, dir bool) error {
+	if objectKind(h, dir) != nil {
+		return ErrUpgrade
+	}
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION)
+	if err != nil {
+		return ErrUpgrade
+	}
+	owner, _, err := sd.Owner()
+	if err != nil || owner == nil || owner.String() != sid {
+		return ErrUpgrade
+	}
+	return nil
+}
+func writeSDKDenialRecord(ctx context.Context, h windows.Handle, data []byte, sid string) error {
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		n, err := nativeWrite(h, remaining)
+		if err != nil || n < 1 || n > len(remaining) {
+			return ErrUpgrade
+		}
+		remaining = remaining[n:]
+	}
+	if verifyPrivate(h, sid, false) != nil || windows.FlushFileBuffers(h) != nil || verifyUpgradeWritten(ctx, h, data) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_drain.go b/rdd/pkg/managementconfig/upgrade_sdk_drain.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b984d1418eecd2c456fa291f41c3eb62052eab9
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_drain.go
@@ -0,0 +1,44 @@
+package managementconfig
+
+import (
+	"context"
+	"time"
+)
+
+// Runs on the SAME existing control owner after its heartbeat work is joined.
+// Each nonblocking drain frame leaves that pump available for actual custody
+// offers while SDK's real actor/source join remains pending. A joined reply is
+// protocol progress only; it never substitutes for native cohort/Root checks.
+func drainUpgradeSDKRuntime(ctx context.Context, call func(context.Context, string) (string, error)) error {
+	if ctx == nil || ctx.Err() != nil || call == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	stage, err := call(ctx, "seal-runtime")
+	if err != nil || stage != "runtime-draining" {
+		return ErrUpgrade
+	}
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		stage, err = call(ctx, "drain-runtime")
+		if err != nil || ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		switch stage {
+		case "runtime-joined":
+			return nil
+		case "runtime-draining":
+		default:
+			return ErrUpgrade
+		}
+		select {
+		case <-ctx.Done():
+			return ErrUpgrade
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_drain_test.go b/rdd/pkg/managementconfig/upgrade_sdk_drain_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1bd1d3699e6c3750611e9ab4059f8c06ee7ac7f3
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_drain_test.go
@@ -0,0 +1,58 @@
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKDrainKeepsSamePumpUntilJoinAndNeverSendsRetireItself(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var calls []string
+	err := drainUpgradeSDKRuntime(ctx, func(_ context.Context, operation string) (string, error) {
+		calls = append(calls, operation)
+		if len(calls) == 3 {
+			return "runtime-joined", nil
+		}
+		return "runtime-draining", nil
+	})
+	if err != nil || !reflect.DeepEqual(calls, []string{"seal-runtime", "drain-runtime", "drain-runtime"}) {
+		t.Fatal("same control pump staging differs", calls, err)
+	}
+}
+
+func TestUpgradeSDKDrainUnknownAndCancelledNeverRetryOrBecomeRetired(t *testing.T) {
+	for _, mode := range []string{"seal-error", "seal-premature-joined", "drain-error", "foreign-stage", "cancelled"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			calls := 0
+			err := drainUpgradeSDKRuntime(ctx, func(_ context.Context, operation string) (string, error) {
+				calls++
+				if operation == "seal-runtime" {
+					if mode == "seal-error" {
+						return "", errors.New(mode)
+					}
+					if mode == "seal-premature-joined" {
+						return "runtime-joined", nil
+					}
+					return "runtime-draining", nil
+				}
+				if mode == "drain-error" {
+					return "", errors.New(mode)
+				}
+				if mode == "foreign-stage" {
+					return "retirement-admitted", nil
+				}
+				cancel()
+				return "runtime-draining", nil
+			})
+			if err == nil || calls > 2 {
+				t.Fatal("unknown drain retried or retired", calls, err)
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_grant.go b/rdd/pkg/managementconfig/upgrade_sdk_grant.go
