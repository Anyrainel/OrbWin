index 0000000000000000000000000000000000000000..00f2b8695c824399358a33b1d467bdcca51dfb6d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_owner_windows.go
@@ -0,0 +1,183 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+)
+
+const upgradeSDKOwnerEnv = upgradeSDKOwnerEnvironmentName
+
+type nativeUpgradeSDKCandidateTransfer struct {
+	mu                            sync.Mutex
+	prepared                      *nativeUpgradeSDKPreparation
+	management                    *upgradeServingTransfer
+	wire                          upgradeSDKOwnerWire
+	writer, reader, sealed, event windows.Handle
+	object                        UpgradeObject
+	inherited                     []windows.Handle
+	unknownCloses                 []windows.Handle
+	started, unknown              bool
+	acceptance                    *nativeUpgradeSDKCandidateAcceptance
+	supervisorEvent               windows.Handle
+	provisional                   *nativeUpgradeSDKProvisional
+}
+
+func (p *nativeUpgradeSDKPreparation) bindUpgradeSDKCandidate(ctx context.Context, t *upgradeServingTransfer) (upgradeSDKCandidateInheritance, error) {
+	if p == nil || t == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	j := t.record.Record.Journal
+	if t.started || t.inherited == 0 || !t.record.valid() || p.recheckLocked(ctx, j) != nil || j.SDKDigest != p.digest || t.recorder != p.authority.recorder {
+		return nil, ErrUpgrade
+	}
+	x := &nativeUpgradeSDKCandidateTransfer{prepared: p, management: t, unknown: true}
+	// Retain every partial native transfer from this one preparation. A second
+	// envelope must not duplicate the job or invent a second close owner.
+	if p.transfer != nil {
+		return nil, ErrUpgrade
+	}
+	p.transfer = x
+	t.sdk = x // retain partial envelope on the SAME first-candidate transfer
+	// Transfer the sole protocol writer before the first native duplication.
+	// A concurrent/in-flight TEMP request refuses without producing an envelope;
+	// after admission, even a failed launch cannot restore TEMP replay authority.
+	if !p.child.protocol.TryLock() {
+		return x, ErrUpgrade
+	}
+	defer p.child.protocol.Unlock()
+	if p.child.controlOffered || p.child.sequence != 1 {
+		return x, ErrUpgrade
+	}
+	p.child.controlOffered = true
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != p.grant.wire.Scope.SID {
+		return x, ErrUpgrade
+	}
+	var nonce [32]byte
+	if _, err = rand.Read(nonce[:]); err != nil {
+		return x, ErrUpgrade
+	}
+	x.event, err = windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	x.supervisorEvent, err = windows.CreateEvent(nil, 1, 0, nil)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	var roles [8]windows.Handle
+	for n, original := range []windows.Handle{p.child.job, p.child.process, windows.Handle(p.child.token), p.child.image, p.grant.controlClient, x.event, x.supervisorEvent, p.grant.final.event} {
+		access, options := uint32(0), uint32(windows.DUPLICATE_SAME_ACCESS)
+		if n >= 5 {
+			access = windows.EVENT_MODIFY_STATE | windows.SYNCHRONIZE
+			options = 0
+			if n == 7 {
+				access = windows.SYNCHRONIZE
+			}
+		}
+		roles[n], err = retainUpgradeSDKDuplicate(&x.inherited, func(slot *windows.Handle) error {
+			return windows.DuplicateHandle(windows.CurrentProcess(), original, windows.CurrentProcess(), slot, access, true, options)
+		})
+		if err != nil {
+			return x, ErrUpgrade
+		}
+	}
+	cohort, err := p.child.cohort.prepareNativeTransfer(ctx, x)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	x.wire = upgradeSDKOwnerWire{Schema: 6, Transaction: j.Transaction, SDKDigest: p.digest, Nonce: nonce, Sequence: 2, Parent: p.grant.wire.Parent, SDK: upgradeSDKProcessWire(p.child.expected), Job: uint64(roles[0]), Process: uint64(roles[1]), Token: uint64(roles[2]), Image: uint64(roles[3]), Control: uint64(roles[4]), Acceptance: uint64(roles[5]), Supervisor: uint64(roles[6]), Final: uint64(roles[7]), Cohort: cohort}
+	store := p.grant.denial.store
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.closed || store.uncertain || store.parents == nil {
+		return x, ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	name := "services.owner-" + j.Transaction + ".grant"
+	x.writer, err = openSDKFinalFile(store.parents.leaf(), name, sd, true)
+	if err != nil || verifyPrivate(x.writer, sid, false) != nil {
+		return x, ErrUpgrade
+	}
+	x.object, err = upgradeObjectID(x.writer)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	x.reader, err = openSDKFinalFile(store.parents.leaf(), name, nil, false)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	body, err := json.Marshal(x.wire)
+	if err != nil {
+		return x, ErrUpgrade
+	}
+	if _, err := parseUpgradeSDKOwner(body, uint64(x.reader), uint64(t.inherited)); err != nil {
+		return x, ErrUpgrade
+	}
+	for left := body; len(left) > 0; {
+		n, err := nativeWrite(x.writer, left)
+		if err != nil || n <= 0 || n > len(left) {
+			return x, ErrUpgrade
+		}
+		left = left[n:]
+	}
+	if windows.FlushFileBuffers(x.writer) != nil || verifyUpgradeWritten(ctx, x.writer, body) != nil {
+		return x, ErrUpgrade
+	}
+	writer := x.writer
+	x.writer = 0
+	if windows.CloseHandle(writer) != nil {
+		x.unknownCloses = append(x.unknownCloses, writer)
+		return x, ErrUpgrade
+	}
+	x.sealed, err = openRelative(store.parents.leaf(), name, false, nil, false)
+	if err != nil || verifyPrivate(x.sealed, sid, false) != nil {
+		return x, ErrUpgrade
+	}
+	id, err := upgradeObjectID(x.sealed)
+	if err != nil || id != x.object || verifyUpgradeWritten(ctx, x.sealed, body) != nil || windows.SetHandleInformation(x.reader, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return x, ErrUpgrade
+	}
+	x.unknown = false
+	return x, nil
+}
+
+// Old single-handle launchers cannot accidentally discard SDK ownership.
+func (x *nativeUpgradeSDKCandidateTransfer) startUpgradeCandidate(func(uintptr) error) error {
+	return ErrUpgrade
+}
+func (x *nativeUpgradeSDKCandidateTransfer) startUpgradeSDKCandidate(ctx context.Context, start func(upgradeSDKCandidateLaunch) error) error {
+	if x == nil || ctx == nil || ctx.Err() != nil || start == nil {
+		return ErrUpgrade
+	}
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	if x.started || x.unknown || x.reader == 0 || x.writer != 0 || len(x.inherited) != 9+2*len(x.wire.Cohort.Members) || x.prepared.child.recheckIngressBirth(ctx) != nil || x.prepared.grant.denial.recheckTransferred(ctx) != nil {
+		return ErrUpgrade
+	}
+	x.started, x.unknown = true, true
+	return x.management.startManagementCandidate(func(handle uintptr) error {
+		list := []uintptr{handle, uintptr(x.reader)}
+		for _, h := range x.inherited {
+			list = append(list, uintptr(h))
+		}
+		// The sole trusted launcher puts this exact allowlist and canonical SDK
+		// owner env into the SAME management candidate's birth, then starts once.
+		return start(upgradeSDKCandidateLaunch{handle, uintptr(x.reader), list})
+	})
+}
