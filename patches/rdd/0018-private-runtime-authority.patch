+	signaled := false
+	if finishSDKFinalSlot(ctx, func() error { cancel(); return nil }, func() error { t.Fatal("closed after cancelled write acknowledgement"); return nil }, func() error { signaled = true; return nil }) == nil || signaled {
+		t.Fatal("cancellation released SDK child")
+	}
+}
