@@ -0,0 +1,297 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"unsafe"
+)
+
+// Only the actual inherited serving owner constructs this receiver. Its state
+// is serialized by owner.protocol; actual cohort members are also protected by
+// cohort.mu. It never opens a process by PID and never lends a job handle.
+type nativeUpgradeSDKLeafReceiver struct {
+	self      *nativeUpgradeSDKLeafReceiver
+	owner     *nativeUpgradeSDKServingOwner
+	cohort    *nativeUpgradeSDKCohort
+	ready     bool // assigned once after the real SDK master roundtrip
+	lastOffer uint64
+	current   *nativeUpgradeSDKReceivedLeaf
+}
+type nativeUpgradeSDKReceivedLeaf struct {
+	id                                                           uint64
+	member                                                       *nativeUpgradeSDKCohortMember
+	phase                                                        string
+	stopQuery                                                    windows.Handle
+	stopQueryClose, tokenClose, observedTokenClose, processClose upgradeSDKLeafCloseAttempt
+}
+
+func (a *upgradeSDKLeafCloseAttempt) close(slot *windows.Handle) error {
+	if a.attempted {
+		return a.err
+	}
+	if slot == nil || *slot == 0 || *slot == windows.InvalidHandle {
+		return ErrUpgrade
+	}
+	return a.run(func() error {
+		err := windows.CloseHandle(*slot)
+		if err == nil {
+			*slot = 0
+		}
+		return err
+	})
+}
+
+func (o *nativeUpgradeSDKServingOwner) adoptNativeSDKLeafMaster(ctx context.Context, co *nativeUpgradeSDKCohort) (result error) {
+	if o == nil || co == nil || ctx == nil || ctx.Err() != nil || !o.protocol.TryLock() {
+		return ErrUpgrade
+	}
+	defer o.protocol.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLeafReceiver()
+			panic(p)
+		}
+		if result != nil {
+			o.fenceLeafReceiver()
+		}
+	}()
+	if o.leaves != nil || o.cohort != co || co.receiver != o || o.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	g := upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}
+	root := co.members[g]
+	valid := !co.unknown && co.ledger.initialTransferComplete() == nil && root != nil && root.process != 0 && root.generation == g && sameUpgradeSDKKernelObject(root.process, o.process) == nil
+	co.mu.Unlock()
+	if !valid {
+		return ErrUpgrade
+	}
+	r := &nativeUpgradeSDKLeafReceiver{owner: o, cohort: co}
+	r.self = r
+	o.leaves = r // actual owner retained before any control bytes
+	if _, e := o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "adopt-leaf-master", Master: &upgradeSDKLeafMasterWire{Process: uint64(root.process)}}); e != nil {
+		return e
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.unknown || o.cohort != co || co.receiver != o || co.members[g] != root || sameUpgradeSDKKernelObject(root.process, o.process) != nil || co.ledger.initialTransferComplete() != nil {
+		return ErrUpgrade
+	}
+	r.ready = true
+	return nil
+}
+
+func (o *nativeUpgradeSDKServingOwner) fenceLeafReceiver() {
+	if o == nil {
+		return
+	}
+	if o.cohort != nil {
+		o.cohort.mu.Lock()
+		o.cohort.unknown = true
+		o.cohort.mu.Unlock()
+	}
+	o.mu.Lock()
+	o.unknown = true
+	o.mu.Unlock()
+	retainUnknownUpgradeSDKServingOwner(o)
+}
+
+// owner.protocol remains held across native admission, the original-pipe ACK,
+// and this completion. Lost ACKs never replay native effects or free custody.
+func (o *nativeUpgradeSDKServingOwner) acceptSDKLeafOffer(ctx context.Context, offer *upgradeSDKLeafOfferWire) (result error) {
+	if o == nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLeafReceiver()
+			panic(p)
+		}
+		if result != nil {
+			o.fenceLeafReceiver()
+		}
+	}()
+	r := o.leaves
+	if r == nil || r.self != r || r.owner != o || r.cohort != o.cohort || !r.ready || !offer.valid() || o.joinedSource != nil && o.joinedSource.complete {
+		return ErrUpgrade
+	}
+	ack, e := r.prepare(ctx, offer)
+	if e != nil {
+		return e
+	}
+	if _, e = o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "ack-leaf", Leaf: &ack}); e != nil {
+		return e
+	}
+	r.cohort.mu.Lock()
+	defer r.cohort.mu.Unlock()
+	if r.cohort.unknown || r.current == nil || r.current.id != offer.Leaf {
+		return ErrUpgrade
+	}
+	switch offer.Kind {
+	case "birth":
+		if r.current.phase != "birth-ack" {
+			return ErrUpgrade
+		}
+		r.current.phase = "running"
+	case "stopped":
+		if r.current.phase != "stopped-ack" {
+			return ErrUpgrade
+		}
+		r.current.phase = "stopped"
+	case "closed":
+		if r.current.phase != "closed-ack" {
+			return ErrUpgrade
+		}
+		r.current = nil
+	default:
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (r *nativeUpgradeSDKLeafReceiver) prepare(ctx context.Context, v *upgradeSDKLeafOfferWire) (upgradeSDKLeafAckWire, error) {
+	var empty upgradeSDKLeafAckWire
+	co, o := r.cohort, r.owner
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if ctx == nil || ctx.Err() != nil || co.unknown || co.receiver != o || o.cohort != co || o.leaves != r || r.lastOffer == ^uint64(0) || v.Offer != r.lastOffer+1 || o.checkNative(ctx) != nil {
+		return empty, ErrUpgrade
+	}
+	r.lastOffer = v.Offer // one use BEFORE any native effect
+	g := upgradeSDKCohortGeneration{v.PID, v.Creation}
+	ack := upgradeSDKLeafAckWire{Offer: v.Offer, Leaf: v.Leaf, Kind: v.Kind}
+	if v.Kind == "birth" {
+		if r.current != nil || v.Leaf <= co.ledger.lastIssuedLeafID || g == (upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}) {
+			return empty, ErrUpgrade
+		}
