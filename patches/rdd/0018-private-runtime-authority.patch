+	if err != nil || user.User.Sid == nil || !user.User.Sid.IsValid() {
+		return nil, ErrSelection
+	}
+	var session, size uint32
+	if windows.GetTokenInformation(token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 {
+		return nil, ErrSelection
+	}
+	profile, err := token.KnownFolderPath(windows.FOLDERID_Profile, 0)
+	if err != nil {
+		return nil, ErrSelection
+	}
+	local, err := token.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
