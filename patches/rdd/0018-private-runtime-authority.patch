@@ -0,0 +1,120 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"testing"
+	"time"
+)
+
+func TestUpgradeFenceCrashBarriersNeverOrdinarilyBootImportedAuthority(t *testing.T) {
+	r, sink := upgradeImportedFixture(t)
+	imported := r.last.Journal
+	fence := upgradeFence{1, imported.Transaction, imported.Incoming, imported.ArgsHash, UpgradeProcess{900, 901, imported.OldService.Session, imported.Incoming}}
+	data, err := upgradeFenceBytes(fence)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, malformed := range [][]byte{nil, data[:len(data)-1], append(append([]byte(nil), data...), '\n'), bytes.Replace(data, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1)} {
+		if _, err := parseUpgradeFence(malformed); err == nil {
+			t.Fatal("partial/ambiguous durable fence accepted")
+		}
+	}
+	// Pure persisted-state crash contract: loss of EVERY in-memory handle and
+	// either absence or presence of ordinary authority.init cannot change this
+	// decision. The Windows gates supply the actual private journal/root/DB IDs.
+	for _, recordBytes := range sink.records {
+		record, err := parseUpgradeRecord(recordBytes)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if fence.allowsOrdinary(record.Journal, imported.PrivateRoot, imported.Imported.Object) {
+			t.Fatal("ordinary boot at crash barrier", record.Journal.Stage)
+		}
+	}
+	candidate := &fakeUpgradeCandidate{validation: upgradeValidationFixture(imported)}
+	a, err := newUpgradeActivation(r, &fakeUpgradeHandoff{}, &fakeUpgradeLauncher{candidate: candidate}, &fakeUpgradeRuntime{}, &fakeUpgradeSDK{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if a.activate(ctx) != nil {
+		t.Fatal("activation fixture")
+	}
+	for _, recordBytes := range sink.records {
+		record, _ := parseUpgradeRecord(recordBytes)
+		j := record.Journal
+		allowed := fence.allowsOrdinary(j, imported.PrivateRoot, imported.Imported.Object)
+		if allowed != (j.Stage == "committed") {
+			t.Fatal("crash barrier bypass or missing final commit", j.Stage)
+		}
+	}
+	j := r.last.Journal
+	if fence.allowsOrdinary(j, j.PrivateRoot, UpgradeObject{}) || fence.allowsOrdinary(j, UpgradeObject{}, j.Imported.Object) {
+		t.Fatal("committed receipt adopted missing/foreign data root")
+	}
+	j.Recovery = upgradeRecovery{Schema: 1, Stage: "rollback-admitted", Original: [32]byte{1}, Decision: [32]byte{2}, Evidence: [32]byte{3}}
+	if fence.allowsOrdinary(j, j.PrivateRoot, j.Imported.Object) {
+		t.Fatal("ordinary boot during rollback")
+	}
+	j.Recovery.Stage = "rolled-back"
+	j.Recovery.Restored = j.OldRoot
+	j.Recovery.OldCandidate = UpgradeProcess{333, 444, j.OldService.Session, j.OldRuntime}
+	j.Recovery.Validation = [32]byte{4}
+	j.Recovery.Runtime = [32]byte{5}
+	if !j.valid() || fence.allowsOrdinary(j, j.PrivateRoot, j.Imported.Object) {
+		t.Fatal("leftover new authority booted after rollback")
+	}
+}
+
+func TestUpgradePermitRequiresAdmittedRecordExactLiveParentAndInheritedObject(t *testing.T) {
+	r, _ := upgradeImportedFixture(t)
+	imported := r.last.Journal
+	imported.SDKDigest = [32]byte{72}
+	j, err := advanceUpgrade(imported, "candidate-start-admitted")
+	if err != nil || r.append(context.Background(), j) != nil {
+		t.Fatal(err)
+	}
+	fence := upgradeFence{1, j.Transaction, j.Incoming, j.ArgsHash, UpgradeProcess{900, 901, j.OldService.Session, j.Incoming}}
+	receipt := upgradeServingRecord{1, fence, j.Fence, r.last}
+	facts := upgradePermitFacts{true, UpgradeProcess{123, 456, j.OldService.Session, j.Incoming}, fence.Owner, j.PrivateRoot, j.Imported.Object}
+	if !receipt.allows(facts) {
+		t.Fatal("valid retained native facts refused")
+	}
+	for _, mutate := range []func(*upgradePermitFacts){func(f *upgradePermitFacts) { f.Inherited = false }, func(f *upgradePermitFacts) { f.Parent = UpgradeProcess{} }, func(f *upgradePermitFacts) { f.Parent.Creation++ }, func(f *upgradePermitFacts) { f.Parent.Image[0] ^= 1 }, func(f *upgradePermitFacts) { f.Candidate.Image[0] ^= 1 }, func(f *upgradePermitFacts) { f.Root.Low++ }, func(f *upgradePermitFacts) { f.Database.Low++ }} {
+		bad := facts
+		mutate(&bad)
+		if receipt.allows(bad) {
+			t.Fatal("stale/crashed/foreign handoff fact accepted")
+		}
+	}
+	// An ordinary valid init record is insufficient: the permit itself binds
+	// exact import + durable write admission, and cannot use an earlier stage.
+	bad := receipt
+	bad.Record.Journal.Stage = "data-imported"
+	bad.Record.Journal.CandidateWritesAdmitted = false
+	if bad.allows(facts) {
+		t.Fatal("permit before durable candidate-write cutoff")
+	}
+}
+
+func TestUpgradeValidationAcceptsReusedPIDOnlyAsDifferentGeneration(t *testing.T) {
+	r, _ := upgradeImportedFixture(t)
+	j := r.last.Journal
+	for _, old := range append([]UpgradeProcess{j.OldService}, j.Hostagents...) {
+		v := upgradeValidationFixture(j)
+		v.Candidate.PID = old.PID
+		v.Candidate.Creation = old.Creation + 1
+		if !v.valid(j) {
+			t.Fatal("legitimate incoming PID reuse rejected")
+		}
+		if sameUpgradeGeneration(v.Candidate, old) {
+			t.Fatal("distinct generation collapsed to PID")
+		}
+		v.Candidate = old
+		if v.valid(j) {
+			t.Fatal("retired old generation accepted as incoming")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_fence_windows.go b/rdd/pkg/managementconfig/upgrade_fence_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..50afb07ef2948a5dc1c2b2843f15f2bf78726a66
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_fence_windows.go
@@ -0,0 +1,197 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"unsafe"
+)
+
+// A committed migrated service retains the SAME actual owner lock as migration
+// writers. This is FILE_READ_DATA/WRITE_DATA, not metadata-only sharing, and is
+// OPEN_EXISTING only. It serializes an ordinary restart against a new recovery
+// admission; preflight remains a read-only observation with no writer lease.
+func retainOrdinaryUpgradeOwner(c *Created, root *InstanceRoot) error {
+	chain := c.parents.chain
+	if len(chain) < 2 {
+		return ErrUpgrade
+	}
+	parent := chain[len(chain)-2]
+	marker, err := openRelative(parent, upgradeFenceName, false, nil, false)
+	if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil
+	}
+	if err != nil {
+		return ErrUpgrade
+	}
+	if windows.CloseHandle(marker) != nil {
+		return ErrUpgrade
+	}
+	text, err := windows.NewNTUnicodeString("migration.owner.lock")
+	if err != nil {
+		return ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	c.upgradeOrdinaryLock = h
+	size, err := upgradeHandleSize(h)
+	if err != nil || size != 0 || verifyPrivate(h, root.sid, false) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+const upgradeFenceName = "authority.migration"
+
+type upgradeReadOnlyJournal struct{}
+
+func (upgradeReadOnlyJournal) writeExclusive(context.Context, uint32, []byte) error {
+	return ErrUpgrade
+}
+
+func observeUpgradeFenceJournal(ctx context.Context, parent windows.Handle, sid string) (journal upgradeJournal, result error) {
+	dir, err := openRelative(parent, "migration", true, nil, false)
+	if err != nil {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(dir) != nil {
+			journal = upgradeJournal{}
+			result = ErrUpgrade
+		}
+	}()
+	if verifyPrivate(dir, sid, true) != nil {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	names, err := upgradeStoreNames(dir)
+	if err != nil {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	var records [][]byte
+	for sequence := uint32(1); sequence <= maxUpgradeRecords; sequence++ {
+		if ctx.Err() != nil {
+			return upgradeJournal{}, ErrUpgrade
+		}
+		h, err := openRelative(dir, upgradeRecordName(sequence), false, nil, false)
+		if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			break
+		}
+		if err != nil {
+			return upgradeJournal{}, ErrUpgrade
+		}
+		data, readErr := readUpgradeRecordHandle(h)
+		privateErr := verifyPrivate(h, sid, false)
+		closeErr := windows.CloseHandle(h)
+		if readErr != nil || privateErr != nil || closeErr != nil {
+			return upgradeJournal{}, ErrUpgrade
+		}
+		records = append(records, data)
+	}
+	if !upgradeStoreLayoutMatch(names, len(records), records) {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	r, err := newUpgradeRecorder(upgradeReadOnlyJournal{}, records)
+	if err != nil || r.last.Sequence == 0 {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	return r.last.Journal, nil
+}
+
+// Every ordinary constructor/preflight checks this before acquiring a writer.
+// Unknown/unreadable/malformed state blocks. Commit is observed from immutable
+// private records, never inferred from init, file absence or a released lock.
+func requireOrdinaryUpgradeComplete(ctx context.Context, root *InstanceRoot) (result error) {
+	parents, err := openInstanceParentMode(ctx, root, false, true)
+	if err == errProductParentAbsent {
+		return nil
+	}
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if parents.Close() != nil {
+			result = ErrUpgrade
+		}
+	}()
+	h, err := openRelative(parents.leaf(), upgradeFenceName, false, nil, false)
+	if err == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+		return nil
+	}
+	if err != nil {
+		return ErrUpgrade
+	}
+	data, readErr := authorityRead(h, 2048)
+	privateErr := verifyPrivate(h, root.sid, false)
+	fenceID, fenceErr := upgradeObjectID(h)
+	closeErr := windows.CloseHandle(h)
+	if readErr != nil || privateErr != nil || closeErr != nil || fenceErr != nil {
+		return ErrUpgrade
+	}
+	fence, err := parseUpgradeFence(data)
+	if err != nil {
+		return ErrUpgrade
+	}
+	j, err := observeUpgradeFenceJournal(ctx, parents.leaf(), root.sid)
+	if err != nil {
+		return ErrUpgrade
+	}
+	anchor, err := openUpgradeDirectoryObservation(parents.leaf(), anchorName)
+	if err != nil {
+		return ErrUpgrade
+	}
+	id, idErr := upgradeObjectID(anchor)
+	kind := verifyPrivate(anchor, root.sid, true)
+	if idErr == nil && kind == nil {
+		kind = observeUpgradeImportedID(anchor, root.sid, j.Imported.Object)
+	}
+	closeErr = windows.CloseHandle(anchor)
+	if idErr != nil || kind != nil || closeErr != nil || j.Fence != fenceID || !fence.allowsOrdinary(j, id, j.Imported.Object) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func observeUpgradeImportedID(anchor windows.Handle, sid string, want UpgradeObject) (result error) {
+	db, err := openUpgradeDirectoryObservation(anchor, "db")
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(db) != nil {
+			result = ErrUpgrade
+		}
+	}()
+	if verifyPrivate(db, sid, true) != nil {
+		return ErrUpgrade
+	}
+	text, err := windows.NewNTUnicodeString("state.db")
+	if err != nil {
+		return ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: db, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if windows.CloseHandle(h) != nil {
+			result = ErrUpgrade
+		}
+	}()
+	id, err := upgradeObjectID(h)
+	size, sizeErr := upgradeHandleSize(h)
+	if err != nil || id != want || sizeErr != nil || size == 0 || verifyPrivate(h, sid, false) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_import_windows.go b/rdd/pkg/managementconfig/upgrade_import_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..54145d16c0164495ecb77d508265f23c2197adf0
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_import_windows.go
@@ -0,0 +1,429 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"io"
+	"sync"
+
+	"golang.org/x/sys/windows"
+	certutil "k8s.io/client-go/util/cert"
+	"k8s.io/client-go/util/keyutil"
+)
+
+// This is a data import, never ctl Create/App recreation. Only normalized
+// SQLite bytes enter db/state.db. TLS/SA are freshly generated with the same
+// upstream helpers as ordinary service startup. Config, old TLS, token stores,
+// kubeconfigs and arbitrary source paths cannot enter the new authority.
+// Admitted failures retain every handle and both roots. No deferred cleanup,
+// overwrite or automatic rollback is hidden in this owner.
+type upgradeAuthorityOwner struct {
+	fence                                                     upgradeFence
+	transfer                                                  *upgradeServingTransfer
+	sdk                                                       *nativeUpgradeSDKPreparation
+	mu                                                        sync.Mutex
+	cold                                                      *upgradeColdTree
+	working                                                   *upgradeWorkingCopy
+	recorder                                                  *upgradeRecorder
+	created                                                   *Created
+	image                                                     *ServingImageLease
+	directories                                               map[string]windows.Handle
+	handles                                                   []windows.Handle
+	root                                                      UpgradeObject
+	initialized, imported, importAttempted, released, unknown bool
+	releaseAttempted                                          bool
+}
+
+func (t *upgradeColdTree) initializeAuthority(ctx context.Context, w *upgradeWorkingCopy, recorder *upgradeRecorder) (*upgradeAuthorityOwner, error) {
+	if t == nil || w == nil || recorder == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup || w.closed || w.closeErr != nil || !w.validated || w.normalizedCold == 0 || w.pin == nil || t.retirement.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j := recorder.last.Journal
+	uncertain := recorder.uncertain
+	recorder.mu.Unlock()
+	if uncertain || recorder.sink != w.store || j.Stage != "checkpoint-validated" || !upgradeIntentEqual(j, t.retirement.journal) || j.WorkingRoot != w.pin.workingRoot || j.Normalized != w.normalized.object || !t.argumentsMatch(ctx, j.ArgsHash) {
+		return nil, ErrUpgrade
+	}
+	image, err := HoldServingImage(ctx, t.retirement.root.home, "orbwin")
+	o := &upgradeAuthorityOwner{cold: t, working: w, recorder: recorder, image: image, directories: map[string]windows.Handle{}}
+	if err != nil || image == nil || image.Image().Hash != j.Incoming {
+		if image != nil && image.Close() != nil {
+			o.unknown = true
+			return o, ErrUpgrade
+		}
+		return nil, ErrUpgrade
+	}
+	next, err := advanceUpgrade(j, "initialize-admitted")
+	if err != nil || recorder.append(ctx, next) != nil {
+		o.unknown = true
+		return o, ErrUpgrade
+	}
+	o.unknown = true // latch before any authority namespace creation
+	parents, err := openInstanceParent(ctx, t.retirement.root, false)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.created = &Created{parents: parents, parent: parents.leaf()}
+	owner, err := currentUpgradeGeneration(j.Incoming)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.fence = upgradeFence{Schema: 1, Transaction: j.Transaction, Incoming: j.Incoming, ArgsHash: j.ArgsHash, Owner: owner}
+	fenceBytes, err := upgradeFenceBytes(o.fence)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	fenceHandle, err := createUpgradeWorkingFile(parents.leaf(), upgradeFenceName, t.sid)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.handles = append(o.handles, fenceHandle)
+	for remaining := fenceBytes; len(remaining) > 0; {
+		n, err := nativeWrite(fenceHandle, remaining)
+		if err != nil || n < 1 || n > len(remaining) {
+			return o, ErrUpgrade
+		}
+		remaining = remaining[n:]
+	}
+	if verifyPrivate(fenceHandle, t.sid, false) != nil || windows.FlushFileBuffers(fenceHandle) != nil || verifyUpgradeWritten(ctx, fenceHandle, fenceBytes) != nil {
+		return o, ErrUpgrade
+	}
+	next.Fence, err = upgradeObjectID(fenceHandle)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	sd, err := privateDescriptor(t.sid, true)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.created.anchor, err = openRelative(parents.leaf(), anchorName, true, sd, true)
+	if err != nil || verifyPrivate(o.created.anchor, t.sid, true) != nil {
+		return o, ErrUpgrade
+	}
+	o.directories["root"] = o.created.anchor
+	o.root, err = upgradeObjectID(o.created.anchor)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	for _, role := range []string{"db", "tls"} {
+		h, err := openRelative(o.created.anchor, role, true, sd, true)
+		if err != nil {
+			return o, ErrUpgrade
+		}
+		o.handles = append(o.handles, h)
+		o.directories[role] = h
+		if verifyPrivate(h, t.sid, true) != nil {
+			return o, ErrUpgrade
+		}
+	}
+	// Fresh sole-service lock is CREATE_NEW, never adoption of a stray lock.
+	if _, err = o.writeFixed(ctx, "owner", nil); err != nil {
+		return o, ErrUpgrade
+	}
+	args, err := readUpgradeArguments(ctx, t.handles["args"])
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	defer clear(args)
+	if digest, err := upgradeArgsHash(args); err != nil || digest != j.ArgsHash {
+		return o, ErrUpgrade
+	}
+	if _, err = o.writeFixed(ctx, "args", args); err != nil {
+		return o, ErrUpgrade
+	}
+	cert, key, err := certutil.GenerateSelfSignedCertKey("127.0.0.1", nil, nil)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	defer clear(key)
+	account, err := rsa.GenerateKey(rand.Reader, 4096)
+	if err != nil || ctx.Err() != nil {
+		return o, ErrUpgrade
+	}
+	sa, err := keyutil.MarshalPrivateKeyToPEM(account)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	defer clear(sa)
+	public, err := x509.MarshalPKIXPublicKey(&account.PublicKey)
+	if err != nil || validateAuthorityMaterial(cert, key, sa) != nil {
+		return o, ErrUpgrade
+	}
+	for _, file := range []struct {
+		role string
+		data []byte
+	}{{"cert", cert}, {"key", key}, {"sa", sa}} {
+		if _, err = o.writeFixed(ctx, file.role, file.data); err != nil {
+			return o, ErrUpgrade
+		}
+	}
+	next.PrivateRoot = o.root
+	next.Certificate, err = authorityCertificate(cert)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	next.ServiceAccount = sha256.Sum256(public)
+	if t.retirement.recheck(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	next, err = advanceUpgrade(next, "private-initialized")
+	if err != nil || recorder.append(ctx, next) != nil {
+		return o, ErrUpgrade
+	}
+	o.initialized = true
+	o.unknown = false
+	return o, nil
+}
+
+func readUpgradeArguments(ctx context.Context, h windows.Handle) ([]byte, error) {
+	size, err := upgradeHandleSize(h)
+	if err != nil || size == 0 || size > 65536 {
+		return nil, ErrUpgrade
+	}
+	if _, err = windows.Seek(h, 0, io.SeekStart); err != nil {
+		return nil, ErrUpgrade
+	}
+	data := make([]byte, int(size))
+	offset := 0
+	for offset < len(data) {
+		if ctx.Err() != nil {
+			clear(data)
+			return nil, ErrUpgrade
+		}
+		var n uint32
+		if windows.ReadFile(h, data[offset:], &n, nil) != nil || n == 0 || int(n) > len(data)-offset {
+			clear(data)
+			return nil, ErrUpgrade
+		}
+		offset += int(n)
+	}
+	return data, nil
+}
+
+func (o *upgradeAuthorityOwner) writeFixed(ctx context.Context, role string, data []byte) (windows.Handle, error) {
+	roles := map[string][2]string{"owner": {"root", "authority.owner.lock"}, "args": {"root", "args.json"}, "init": {"root", "authority.init"}, "cert": {"tls", "apiserver.crt"}, "key": {"tls", "apiserver.key"}, "sa": {"tls", "sa.key"}, "database": {"db", "state.db"}}
+	spec, ok := roles[role]
+	if !ok || ctx == nil || ctx.Err() != nil || len(data) > MaxConfigBytes || len(data) == 0 && role != "owner" && role != "database" {
+		return 0, ErrUpgrade
+	}
+	h, err := createUpgradeWorkingFile(o.directories[spec[0]], spec[1], o.cold.sid)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	o.handles = append(o.handles, h)
+	if verifyPrivate(h, o.cold.sid, false) != nil {
+		return 0, ErrUpgrade
+	}
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return 0, ErrUpgrade
+		}
+		n, err := nativeWrite(h, remaining)
+		if err != nil || n < 1 || n > len(remaining) {
+			return 0, ErrUpgrade
+		}
+		remaining = remaining[n:]
+	}
+	if ctx.Err() != nil || windows.FlushFileBuffers(h) != nil {
+		return 0, ErrUpgrade
+	}
+	if len(data) > 0 && verifyUpgradeWritten(ctx, h, data) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+func verifyUpgradeWritten(ctx context.Context, h windows.Handle, want []byte) error {
+	size, err := upgradeHandleSize(h)
+	if err != nil || size != uint64(len(want)) {
+		return ErrUpgrade
+	}
+	if _, err = windows.Seek(h, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	buffer := make([]byte, 64<<10)
+	defer clear(buffer)
+	for offset := 0; offset < len(want); {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		next := len(want) - offset
+		if next > len(buffer) {
+			next = len(buffer)
+		}
+		var n uint32
+		if windows.ReadFile(h, buffer[:next], &n, nil) != nil || n == 0 || int(n) > next || !bytes.Equal(buffer[:n], want[offset:offset+int(n)]) {
+			return ErrUpgrade
+		}
+		offset += int(n)
+	}
+	return nil
+}
+
+// The sole lifecycle owner calls this only AFTER durable admission of candidate
+// writes. Releasing the fresh exclusive Create/service-lock handles allows the
+// candidate's existing OpenInitialized owner to acquire them normally. There is
+// no new service orchestrator or authority-reader fallback. Unknown Close fences
+// launch and keeps the migration/image/checkpoint owners retained for inspection.
+func (o *upgradeAuthorityOwner) releaseUpgradeAuthority(ctx context.Context, j upgradeJournal) error {
+	if o == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown || !o.imported || o.released || o.releaseAttempted || o.created == nil || j.Stage != "candidate-start-admitted" || !j.CandidateWritesAdmitted || j.PrivateRoot != o.root {
+		return ErrUpgrade
+	}
+	o.recorder.mu.Lock()
+	actual := o.recorder.last.Journal
+	uncertain := o.recorder.uncertain
+	o.recorder.mu.Unlock()
+	wantBytes, err := upgradeJournalBytes(j)
+	actualBytes, actualErr := upgradeJournalBytes(actual)
+	if uncertain || err != nil || actualErr != nil || !bytes.Equal(wantBytes, actualBytes) || o.cold.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	for _, h := range o.handles {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		var info windows.ByHandleFileInformation
+		if windows.GetFileInformationByHandle(h, &info) != nil || verifyPrivate(h, o.cold.sid, info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != nil {
+			return ErrUpgrade
+		}
+	}
+	o.releaseAttempted = true
+	o.unknown = true
+	// authority.init is deliberately absent throughout initialization/import.
+	// Even now the persistent sibling fence denies ALL ordinary startup until
+	// final commit. Only the exclusive inherited permit may cross this boundary.
+	args, err := readUpgradeArguments(ctx, o.cold.handles["args"])
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer clear(args)
+	digest, err := upgradeArgsHash(args)
+	if err != nil || digest != j.ArgsHash {
+		return ErrUpgrade
+	}
+	marker, err := initializationBytes(args)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if _, err = o.writeFixed(ctx, "init", marker); err != nil || o.prepareUpgradeTransfer(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	for i := len(o.handles) - 1; i >= 0; i-- {
+		if windows.CloseHandle(o.handles[i]) != nil {
+			return ErrUpgrade
+		}
+	}
+	if o.created.Close() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	o.released = true
+	o.unknown = false
+	return nil
+}
+
+func (o *upgradeAuthorityOwner) importDatabase(ctx context.Context) error {
+	if o == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown || !o.initialized || o.imported || o.importAttempted || o.released {
+		return ErrUpgrade
+	}
+	o.working.mu.Lock()
+	defer o.working.mu.Unlock()
+	if o.working.closed || !o.working.validated || o.working.normalizedCold == 0 {
+		return ErrUpgrade
+	}
+	o.recorder.mu.Lock()
+	j := o.recorder.last.Journal
+	uncertain := o.recorder.uncertain
+	o.recorder.mu.Unlock()
+	if uncertain || j.Stage != "private-initialized" || j.PrivateRoot != o.root || j.Normalized != o.working.normalized.object || o.cold.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	o.importAttempted = true
+	next, err := advanceUpgrade(j, "import-admitted")
+	if err != nil || o.recorder.append(ctx, next) != nil {
+		o.unknown = true
+		return ErrUpgrade
+	}
+	o.unknown = true
+	source := o.working.normalizedCold
+	id, err := upgradeObjectID(source)
+	if err != nil || id != j.Normalized || verifyPrivate(source, o.cold.sid, false) != nil {
+		return ErrUpgrade
+	}
+	if _, err = windows.Seek(source, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	dest, err := o.writeFixed(ctx, "database", nil)
+	if err != nil {
+		return ErrUpgrade
+	}
+	file := UpgradeColdFile{Role: "main", Object: j.Normalized, Size: j.NormalizedSize, Hash: j.NormalizedHash}
+	if copyUpgradeCold(ctx, upgradeHandleReader{source}, upgradeHandleWriter{dest}, file) != nil || windows.FlushFileBuffers(dest) != nil {
+		return ErrUpgrade
+	}
+	id, err = upgradeObjectID(dest)
+	if err != nil || id == j.Normalized {
+		return ErrUpgrade
+	}
+	file.Object = id
+	if _, err = windows.Seek(dest, 0, io.SeekStart); err != nil || copyUpgradeCold(ctx, upgradeHandleReader{dest}, io.Discard, file) != nil || verifyPrivate(dest, o.cold.sid, false) != nil || o.cold.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	next.Imported = file
+	next, err = advanceUpgrade(next, "data-imported")
+	if err != nil || o.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	o.imported = true
+	o.unknown = false
+	return nil
+}
+
+// Bind the actual retained original-root/denial graph to this authority and the
+// same journal store through every activation barrier. A JSON hash cannot stand
+// in for these native objects or a released cold owner.
+func (o *upgradeAuthorityOwner) checkUpgradeLegacyDenial(ctx context.Context, j upgradeJournal) error {
+	if o == nil || o.cold == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	t := o.cold
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup || t.captureRecorder != o.recorder || t.captureStore == nil || t.originals == nil || j.OldRoot != t.inventory.root || j.LegacyPIDDenial != t.denial || j.Recovery.Schema != 0 {
+		return ErrUpgrade
+	}
+	o.recorder.mu.Lock()
+	uncertain := o.recorder.uncertain
+	same := o.recorder.sink == t.captureStore
+	actual := o.recorder.last.Journal
+	o.recorder.mu.Unlock()
+	// Activation sometimes presents its imminent acknowledgement before append;
+	// compare immutable capture facts, not an invented authority from stage text.
+	if uncertain || !same || !upgradeIntentEqual(j, actual) || !upgradeCaptureFollows(actual, j) || actual.BackupRoot != j.BackupRoot {
+		return ErrUpgrade
+	}
+	return t.verifyOriginalNamespace(ctx)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_inventory.go b/rdd/pkg/managementconfig/upgrade_inventory.go
new file mode 100644
index 0000000000000000000000000000000000000000..8eee4d7da9ff3f0334b122a31c787ecd2584b56f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_inventory.go
@@ -0,0 +1,78 @@
+package managementconfig
+
+import "strings"
+
+// The native walker fills these copied metadata facts from held no-reparse
+// objects. This planner grants no authority and cannot mint a backup/seal lease.
+type upgradeInventoryObject struct {
+	Parent, Name string
+	Object       UpgradeObject
+	Directory    bool
+	Links        uint32
+	Reparse      bool
+}
+type upgradeInventoryEntry struct {
+	Role string
+	Fact upgradeInventoryObject
+}
+type upgradeInventoryRole struct {
+	parent, name        string
+	directory, required bool
+}
+
+var upgradeInventoryRoles = map[string]upgradeInventoryRole{
+	"args":                 {"root", "args.json", false, true},
+	"management-config":    {"root", "config.yaml", false, false},
+	"cluster-config":       {"root", "k3s.yaml", false, false},
+	"pid":                  {"root", "rdd.pid", false, false},
+	"tls":                  {"root", "tls", true, true},
+	"db":                   {"root", "db", true, true},
+	"management-cert":      {"tls", "apiserver.crt", false, false},
+	"management-key":       {"tls", "apiserver.key", false, false},
+	"service-account-key":  {"tls", "sa.key", false, false},
+	"obsolete-token-store": {"tls", ".admin-token-store", false, false},
+	"main":                 {"db", "state.db", false, true},
+	"wal":                  {"db", "state.db-wal", false, false},
+	"shm":                  {"db", "state.db-shm", false, false},
+	"rollback-journal":     {"db", "state.db-journal", false, false},
+}
+
+func planUpgradeInventory(root UpgradeObject, facts []upgradeInventoryObject) ([]upgradeInventoryEntry, error) {
+	if !root.valid() || len(facts) < 4 || len(facts) > len(upgradeInventoryRoles) {
+		return nil, ErrUpgrade
+	}
+	seenRoles := map[string]bool{}
+	seenObjects := map[UpgradeObject]bool{root: true}
+	result := make([]upgradeInventoryEntry, 0, len(facts))
+	for _, fact := range facts {
+		if !fact.Object.valid() || fact.Object.Volume != root.Volume || seenObjects[fact.Object] || fact.Reparse || !fact.Directory && fact.Links != 1 {
+			return nil, ErrUpgrade
+		}
+		role := ""
+		for candidate, spec := range upgradeInventoryRoles {
+			if fact.Parent == spec.parent && strings.EqualFold(fact.Name, spec.name) && fact.Directory == spec.directory {
+				role = candidate
+				break
+			}
+		}
+		// Canonical names only: an unexpected old object blocks before any rename or
+		// WRITE_DAC. It is retained for explicit inspection rather than discarded.
+		if role == "" || seenRoles[role] || fact.Name != upgradeInventoryRoles[role].name {
+			return nil, ErrUpgrade
+		}
+		seenRoles[role] = true
+		seenObjects[fact.Object] = true
+		result = append(result, upgradeInventoryEntry{role, fact})
+	}
+	for role, spec := range upgradeInventoryRoles {
+		if spec.required && !seenRoles[role] {
+			return nil, ErrUpgrade
+		}
+	}
+	for _, entry := range result {
+		if entry.Fact.Parent != "root" && !seenRoles[entry.Fact.Parent] {
+			return nil, ErrUpgrade
+		}
+	}
+	return result, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_inventory_test.go b/rdd/pkg/managementconfig/upgrade_inventory_test.go
