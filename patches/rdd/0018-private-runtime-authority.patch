+func sdkResourcesFixtureJobSnapshot(job windows.Handle) sdkResourcesFixtureJobObservation {
+	var out sdkResourcesFixtureJobObservation
+	var accounting struct {
+		TotalUser, TotalKernel, PeriodUser, PeriodKernel int64
+		PageFaults, Total, Active, Terminated            uint32
+	}
+	out.AccountingSize = uint32(unsafe.Sizeof(accounting))
+	err := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&accounting)), out.AccountingSize, &out.AccountingLength)
+	if err != nil {
+		out.AccountingError = err.Error()
+	}
+	out.Total, out.Active, out.Terminated = accounting.Total, accounting.Active, accounting.Terminated
+	out.AccountingRaw = hex.EncodeToString(unsafe.Slice((*byte)(unsafe.Pointer(&accounting)), int(out.AccountingSize)))
+	var list struct {
+		Assigned, Count uint32
+		PIDs            [16]uintptr
+	}
+	err = windows.QueryInformationJobObject(job, windows.JobObjectBasicProcessIdList, uintptr(unsafe.Pointer(&list)), uint32(unsafe.Sizeof(list)), &out.ListLength)
+	if err != nil {
+		out.ListError = err.Error()
+	}
+	out.Assigned, out.Count = list.Assigned, list.Count
+	count := list.Count
+	if count > uint32(len(list.PIDs)) {
+		count = uint32(len(list.PIDs))
+		out.ListError += " bounded PID-list overflow"
+	}
+	for _, pid := range list.PIDs[:count] {
+		out.PIDs = append(out.PIDs, uint64(pid))
+	}
+	return out
+}
+
+type sdkResourcesFixtureMemberObservation struct {
+	process, image                      windows.Handle // retained actual caps; never JSON authority
+	PID                                 uint32
+	Creation                            uint64
+	ParentPID                           uint64
+	Session                             uint32
+	SID                                 string
+	TokenID                             windows.LUID
+	ImagePath, ImageSHA256              string
+	ImageObject                         UpgradeObject
+	Live, InOwnedJob, ActualMappedImage bool
+	Error                               string
+}
+
+// Observations come ONLY from this actual fresh job's bounded native PID list.
+// The list is not an ambient stop set and filenames never grant ownership.
+func sdkResourcesFixtureObserveMembers(ctx context.Context, job windows.Handle, snapshot sdkResourcesFixtureJobObservation, root UpgradeProcess, descendant uint32, descendantCreation uint64, sid string, caps *[]windows.Handle) ([]sdkResourcesFixtureMemberObservation, sdkResourcesFixtureJobObservation, error) {
+	var observations []sdkResourcesFixtureMemberObservation
+	var after sdkResourcesFixtureJobObservation
+	if snapshot.AccountingError != "" || snapshot.ListError != "" || snapshot.Count == 0 || snapshot.Count > 16 || snapshot.Assigned != snapshot.Count || uint32(len(snapshot.PIDs)) != snapshot.Count || snapshot.Active != snapshot.Count {
+		return observations, after, ErrUpgrade
+	}
+	foundRoot, foundDesc := false, false
+	seen := map[uint64]bool{}
+	var result error
+	for _, raw := range snapshot.PIDs {
+		if raw == 0 || raw > uint64(^uint32(0)) || seen[raw] || raw == uint64(windows.GetCurrentProcessId()) {
+			return observations, after, ErrUpgrade
+		}
+		seen[raw] = true
+		observation, err := sdkResourcesFixtureObserveMember(ctx, job, uint32(raw), root.Session, sid, caps)
+		if err != nil {
+			observation.Error = err.Error()
+			result = errors.Join(result, err)
+		}
+		observations = append(observations, observation)
+		if uint32(raw) == root.PID && observation.Creation == root.Creation && observation.ImageSHA256 == hex.EncodeToString(root.Image[:]) {
+			foundRoot = true
+		}
+		if uint32(raw) == descendant && observation.Creation == descendantCreation && observation.ImageSHA256 == hex.EncodeToString(root.Image[:]) {
+			foundDesc = true
+		}
+	}
+	if !foundRoot || !foundDesc {
+		result = errors.Join(result, ErrUpgrade)
+	}
+	// Require complete observed current membership, never a stale count/list.
+	after = sdkResourcesFixtureJobSnapshot(job)
+	if result != nil {
+		return observations, after, result
+	}
+	if ctx.Err() != nil || after.AccountingError != "" || after.ListError != "" || after.Count == 0 || after.Count > 16 || after.Assigned != after.Count || after.Active != after.Count || uint32(len(after.PIDs)) != after.Count {
+		return observations, after, ErrUpgrade
+	}
+	afterSeen := map[uint64]bool{}
+	changed := after.Active != snapshot.Active || after.Assigned != snapshot.Assigned || after.Count != snapshot.Count
+	for _, pid := range after.PIDs {
+		if pid == 0 || pid > uint64(^uint32(0)) || afterSeen[pid] || pid == uint64(windows.GetCurrentProcessId()) {
+			return observations, after, ErrUpgrade
+		}
+		afterSeen[pid] = true
+		if !seen[pid] {
+			changed = true
+		}
+	}
+	if !afterSeen[uint64(root.PID)] || !afterSeen[uint64(descendant)] {
+		return observations, after, ErrUpgrade
+	}
+	for _, observation := range observations {
+		if observation.PID != root.PID && observation.PID != descendant {
+			continue
+		}
+		state, err := windows.WaitForSingleObject(observation.process, 0)
+		var made, ended, kernel, user windows.Filetime
+		if err != nil || state != uint32(windows.WAIT_TIMEOUT) || windows.GetProcessTimes(observation.process, &made, &ended, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != observation.Creation || queryUpgradeObservedImage(observation.process, observation.image) != nil {
+			return observations, after, ErrUpgrade
+		}
+	}
+	if changed {
+		return observations, after, &sdkResourcesFixtureKnownMemberSetChanged{}
+	}
+	return observations, after, nil
+}
+
+type sdkResourcesFixtureKnownMemberSetChanged struct{}
+
+func (*sdkResourcesFixtureKnownMemberSetChanged) Error() string {
+	return "known complete owned member set changed after all native facts succeeded"
+}
+
+type sdkResourcesFixtureMemberCapture struct {
+	Before, After         sdkResourcesFixtureJobObservation
+	Members               []sdkResourcesFixtureMemberObservation
+	KnownMemberSetChanged bool
+	Error                 string
+}
+
+func sdkResourcesFixtureObserveMember(ctx context.Context, job windows.Handle, pid, session uint32, sid string, caps *[]windows.Handle) (out sdkResourcesFixtureMemberObservation, result error) {
+	out.PID = pid
+	if ctx.Err() != nil {
+		return out, ErrUpgrade
+	}
+	process, err := windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if process != 0 {
+		*caps = append(*caps, process)
+	}
+	out.process = process
+	if err != nil {
+		return out, err
+	}
+	state, err := windows.WaitForSingleObject(process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return out, ErrUpgrade
+	}
+	out.Live = true
+	var member uint32
+	status, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(process), uintptr(job), uintptr(unsafe.Pointer(&member)))
+	if status == 0 || member != 1 {
+		return out, ErrUpgrade
+	}
+	out.InOwnedJob = true
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var length uint32
+	if windows.NtQueryInformationProcess(process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &length) != nil || length != uint32(unsafe.Sizeof(basic)) {
+		return out, ErrUpgrade
+	}
+	out.ParentPID = uint64(basic.InheritedFromUniqueProcessId)
+	var made, ended, kernel, user windows.Filetime
+	if windows.GetProcessTimes(process, &made, &ended, &kernel, &user) != nil {
+		return out, ErrUpgrade
+	}
+	out.Creation = uint64(made.HighDateTime)<<32 | uint64(made.LowDateTime)
+	if out.Creation == 0 || windows.ProcessIdToSessionId(pid, &out.Session) != nil || out.Session != session {
+		return out, ErrUpgrade
+	}
+	var token windows.Token
+	err = windows.OpenProcessToken(process, windows.TOKEN_QUERY, &token)
+	if token != 0 {
+		*caps = append(*caps, windows.Handle(token))
+	}
+	if err != nil {
+		return out, err
+	}
+	tokenUser, err := token.GetTokenUser()
+	if err != nil {
+		return out, err
+	}
+	out.SID = tokenUser.User.Sid.String()
+	out.TokenID, err = legacySDKTokenID(token)
+	if err != nil || out.SID != sid || legacySDKOrdinaryToken(token, sid, session) != nil {
+		return out, ErrUpgrade
+	}
+	out.ImagePath, err = upgradeProcessPath(process)
+	if err != nil {
+		return out, err
+	}
+	path, err := windows.UTF16PtrFromString(out.ImagePath)
+	if err != nil {
+		return out, err
+	}
+	// Path is merely a query observation. This held leaf must independently
+	// match the actual live process mapping; no execution is admitted from it.
+	image, err := windows.CreateFile(path, windows.FILE_READ_DATA|windows.FILE_EXECUTE|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if image != 0 && image != windows.InvalidHandle {
+		*caps = append(*caps, image)
+	}
+	out.image = image
+	if err != nil {
+		return out, err
+	}
+	// Read-only PUBLIC image observation does not require private-cache
+	// single-link eligibility. Actual mapped-object binding remains mandatory;
+	// filenames and aliases grant neither execution nor job ownership.
+	if objectKindCheckedLinks(image, false, false) != nil || queryUpgradeObservedImage(process, image) != nil {
+		return out, ErrUpgrade
+	}
+	out.ActualMappedImage = true
+	out.ImageObject, err = upgradeObjectID(image)
+	if err != nil {
+		return out, err
+	}
+	size, err := upgradeHandleSize(image)
+	if err != nil || size == 0 || size > 128<<20 {
+		return out, ErrUpgrade
+	}
+	digest := sha256.New()
+	buffer := make([]byte, 64<<10)
+	for remaining := size; remaining > 0; {
+		if ctx.Err() != nil {
+			return out, ErrUpgrade
+		}
+		next := uint64(len(buffer))
+		if next > remaining {
+			next = remaining
+		}
+		var count uint32
+		if windows.ReadFile(image, buffer[:next], &count, nil) != nil || count == 0 || uint64(count) > next {
+			return out, ErrUpgrade
+		}
+		digest.Write(buffer[:count])
+		remaining -= uint64(count)
+	}
+	clear(buffer)
+	out.ImageSHA256 = hex.EncodeToString(digest.Sum(nil))
+	if queryUpgradeObservedImage(process, image) != nil {
+		return out, ErrUpgrade
+	}
+	return out, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_resources_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_resources_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..90591dfc2a9a90005a4824e6a139d5d916900268
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_resources_windows.go
@@ -0,0 +1,162 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sync"
+	"unsafe"
+)
+
+// Physical ownership only. This is not an SDK authority, execution lease,
+// signer, retirement-admission or ColdTransition grant. Product construction
+// follows native SDK/controller/supervisor verification; the closed native
+// fixture may construct only these kernel resources from its own inert birth.
+type nativeUpgradeSDKResources struct {
+	mu                    sync.Mutex
+	process, job, control *windows.Handle
+	expected              UpgradeProcess
+	io                    *upgradeSDKControlIO
+	release               func() error
+	attempted             bool
+	result                error
+	stages                []string                      // observations only, never a quiescence grant
+	source                *nativeUpgradeSDKJoinedSource // actual product constructor backing; physical fixtures mint no source grant
+	product               *nativeUpgradeSDKRetainedRetirement
+}
+
+func (o *nativeUpgradeSDKServingOwner) captureResources(ctx context.Context, source *nativeUpgradeSDKJoinedSource) (*nativeUpgradeSDKResources, error) {
+	if o == nil || source == nil || source.owner != o || source.checkBeforeRetire(ctx) != nil || o.cohort == nil || o.cohort.requireRetirementAdmission(o) != nil || o.checkNative(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	o.mu.Lock()
+	if o.unknown || !o.supervisorReady || o.resources != nil {
+		o.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	r := &nativeUpgradeSDKResources{process: &o.process, job: &o.job, control: &o.control, expected: UpgradeProcess{o.wire.SDK.PID, o.wire.SDK.Creation, o.wire.SDK.Session, o.wire.SDK.Image}, io: o.io, release: o.releaseRetiredControllers, source: source}
+	o.resources = r
+	o.mu.Unlock()
+	if o.bindRetainedRetirement(ctx, r, source) != nil {
+		return nil, ErrUpgrade
+	}
+	return r, nil
+}
+
+func (r *nativeUpgradeSDKResources) retire(ctx context.Context) (result error) {
+	// Physical prototype ONLY. No product-backed resource can choose this path.
+	if r == nil || r.source != nil || r.product != nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.attempted {
+		return r.result
+	}
+	if r.process == nil || r.job == nil || r.control == nil || *r.process == 0 || *r.job == 0 || *r.control == 0 || r.io == nil || r.release == nil || !r.expected.valid() {
+		return ErrUpgrade
+	}
+	r.attempted, r.result = true, ErrUpgrade
+	return runUpgradeSDKCloseBody(func() {
+		upgradeSDKPhysicalQuarantine.Lock()
+		upgradeSDKPhysicalQuarantine.owners[r] = struct{}{}
+		upgradeSDKPhysicalQuarantine.Unlock()
+	}, func() error { return r.retireNative(ctx) }, func(err error, completed bool) {
+		r.result = err
+		if completed {
+			upgradeSDKPhysicalQuarantine.Lock()
+			delete(upgradeSDKPhysicalQuarantine.owners, r)
+			upgradeSDKPhysicalQuarantine.Unlock()
+		}
+	})
+}
+
+// The enclosing one-shot/unwind guard owns the lock and pins the actual graph.
+func (r *nativeUpgradeSDKResources) retireNative(ctx context.Context) error {
+	if r.waitNativeRoot(ctx) != nil {
+		return ErrUpgrade
+	}
+	return finishUpgradeSDKRetirement(ctx, r.nativeJobActive, r.terminateNativeJob, r.closeNativeIO, r.closeNativeJob, r.releaseNativeControllers)
+}
+func (r *nativeUpgradeSDKResources) waitNativeRoot(ctx context.Context) error {
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForSingleObject(*r.process, 20)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			break
+		}
+		if state != uint32(windows.WAIT_TIMEOUT) {
+			return ErrUpgrade
+		}
+	}
+	var exit uint32
+	var created, exited, kernel, user windows.Filetime
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(*r.process))
+	if windows.GetExitCodeProcess(*r.process, &exit) != nil || exit != 0 || uint32(pid) != r.expected.PID || windows.GetProcessTimes(*r.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != r.expected.Creation || checkUpgradeSDKJobLimits(*r.job) != nil {
+		return ErrUpgrade
+	}
+	var member uint32
+	status, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(windows.CurrentProcess()), uintptr(*r.job), uintptr(unsafe.Pointer(&member)))
+	if status == 0 || member != 0 {
+		return ErrUpgrade
+	}
+	r.stages = append(r.stages, "root-exit-zero")
+	return nil
+}
+func (r *nativeUpgradeSDKResources) nativeJobActive() (uint32, error) {
+	count, e := upgradeSDKJobActive(*r.job)
+	if e == nil && count == 0 {
+		r.stages = append(r.stages, "job-empty")
+	}
+	return count, e
+}
+func (r *nativeUpgradeSDKResources) terminateNativeJob() error {
+	if windows.TerminateJobObject(*r.job, 0) != nil {
+		return ErrUpgrade
+	}
+	r.stages = append(r.stages, "job-termination-requested")
+	return nil
+}
+func (r *nativeUpgradeSDKResources) drainNativeJob(ctx context.Context) error {
+	return drainUpgradeSDKRetirementJob(ctx, r.nativeJobActive, r.terminateNativeJob)
+}
+func (r *nativeUpgradeSDKResources) closeNativeIO() error {
+	if !r.io.mu.TryLock() {
+		return ErrUpgrade
+	}
+	defer r.io.mu.Unlock()
+	if r.io.unknown || r.io.op != nil || r.io.pipe != *r.control {
+		return ErrUpgrade
+	}
+	if windows.CloseHandle(*r.control) != nil {
+		r.io.unknown = true
+		return ErrUpgrade
+	}
+	r.io.pipe, *r.control = 0, 0
+	r.stages = append(r.stages, "io-joined")
+	return nil
+}
+func (r *nativeUpgradeSDKResources) closeNativeJob() error {
+	if windows.CloseHandle(*r.job) != nil {
+		return ErrUpgrade
+	}
+	*r.job = 0
+	r.stages = append(r.stages, "job-closed")
+	return nil
+}
+func (r *nativeUpgradeSDKResources) releaseNativeControllers() error {
+	if r.release() == nil {
+		r.stages = append(r.stages, "exclusions-released")
+		return nil
+	}
+	return ErrUpgrade
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement.go b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement.go
new file mode 100644
index 0000000000000000000000000000000000000000..cfa6b93f5df7b7c99a4ab2efc79d108b175135ee
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement.go
@@ -0,0 +1,60 @@
+package managementconfig
+
+// DATA ordering only. The concrete product native callee binds these steps to
+// its retained objects; callbacks cannot create a product ACK/retirement owner.
+type upgradeSDKRetainedStep uint8
+
+const (
+	sdkRetainedPrecheck upgradeSDKRetainedStep = iota
+	sdkRetainedRootWait
+	sdkRetainedDrainJob
+	sdkRetainedPreAccounting
+	sdkRetainedAllWait
+	sdkRetainedPostAccounting
+	sdkRetainedCloseQueries
+	sdkRetainedFinalAccounting
+	sdkRetainedCloseIO
+	sdkRetainedCloseMainJob
+	sdkRetainedReleaseControllers
+)
+
+func runSDKRetainedRetirement(effect func(upgradeSDKRetainedStep) error) error {
+	if effect == nil {
+		return ErrUpgrade
+	}
+	for _, step := range []upgradeSDKRetainedStep{sdkRetainedPrecheck, sdkRetainedRootWait, sdkRetainedDrainJob, sdkRetainedPreAccounting, sdkRetainedAllWait, sdkRetainedPostAccounting, sdkRetainedCloseQueries, sdkRetainedFinalAccounting, sdkRetainedCloseIO, sdkRetainedCloseMainJob, sdkRetainedReleaseControllers} {
+		if e := effect(step); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+
+func sdkRetireAckSequence(before, after uint32) bool {
+	return before != 0 && before != ^uint32(0) && after == before+1
+}
+
+type sdkRetainedQueryRole uint8
+
+const (
+	sdkQueryObservedToken sdkRetainedQueryRole = iota
+	sdkQueryToken
+	sdkQueryProcess
+	sdkQueryJob
+)
+
+// Native cleanup calls this same stop-first order with fixed retained slots.
+// It has no ACK/owner output and cannot establish native custody.
+func closeSDKRetainedQueries(members int, effect func(int, sdkRetainedQueryRole) error) error {
+	if members < 1 || members > upgradeSDKCohortBound || effect == nil {
+		return ErrUpgrade
+	}
+	for i := 0; i < members; i++ {
+		for _, role := range []sdkRetainedQueryRole{sdkQueryObservedToken, sdkQueryToken, sdkQueryProcess} {
+			if e := effect(i, role); e != nil {
+				return e
+			}
+		}
+	}
+	return effect(-1, sdkQueryJob)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_test.go b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..735dea35478c93ab2790809506e6788636529023
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_test.go
@@ -0,0 +1,122 @@
+package managementconfig
+
+import (
+	"testing"
+)
+
+func TestUpgradeSDKRetainedOrderAndEverySuffixFault(t *testing.T) {
+	for fail := -1; fail <= int(sdkRetainedReleaseControllers); fail++ {
+		var seen []upgradeSDKRetainedStep
+		err := runSDKRetainedRetirement(func(s upgradeSDKRetainedStep) error {
+			seen = append(seen, s)
+			if int(s) == fail {
+				return ErrUpgrade
+			}
+			return nil
+		})
+		expected := int(sdkRetainedReleaseControllers) + 1
+		if fail >= 0 {
+			expected = fail + 1
+		}
+		if len(seen) != expected || (err != nil) != (fail >= 0) {
+			t.Fatal("crossed failed native suffix", fail, seen)
+		}
+		for i, s := range seen {
+			if int(s) != i {
+				t.Fatal("incorrect order", seen)
+			}
+		}
+	}
+}
+func TestUpgradeSDKRetainedPanicRetainsBeforeAnyRelease(t *testing.T) {
+	for fail := sdkRetainedPrecheck; fail <= sdkRetainedReleaseControllers; fail++ {
+		retained, publishedFailure := false, false
+		seen := 0
+		func() {
+			defer func() {
+				if recover() == nil {
+					t.Fatal("expected injected panic")
+				}
+			}()
+			runUpgradeSDKCloseBody(func() { retained = true }, func() error {
+				return runSDKRetainedRetirement(func(s upgradeSDKRetainedStep) error {
+					if !retained {
+						t.Fatal("native effect before retained owner")
+					}
+					seen++
+					if s == fail {
+						panic("actual-called order model")
+					}
+					return nil
+				})
+			}, func(e error, complete bool) { publishedFailure = e != nil && !complete })
+		}()
+		if !retained || !publishedFailure || seen != int(fail)+1 {
+			t.Fatal("panic crossed release/false success", fail)
+		}
+	}
+}
+func TestUpgradeSDKRetainedQueryCloseCache(t *testing.T) {
+	for _, panics := range []bool{false, true} {
+		var attempt upgradeSDKLeafCloseAttempt
+		calls := 0
+		func() {
+			defer func() { recover() }()
+			attempt.run(func() error {
+				calls++
+				if panics {
+					panic("close uncertainty")
+				}
+				return ErrUpgrade
+			})
+		}()
+		if attempt.run(func() error { calls++; return nil }) == nil || calls != 1 {
+			t.Fatal("unknown query close retried")
+		}
+	}
+}
+
+func TestUpgradeSDKRetainedExactAckRelation(t *testing.T) {
+	for _, v := range []struct {
+		before, after uint32
+		ok            bool
+	}{{1, 2, true}, {100, 101, true}, {0, 1, false}, {1, 1, false}, {1, 3, false}, {^uint32(0), 0, false}, {^uint32(0) - 1, ^uint32(0), true}} {
+		if sdkRetireAckSequence(v.before, v.after) != v.ok {
+			t.Fatal("sequence wrap/replay", v)
+		}
+	}
+}
+func TestUpgradeSDKRetainedEveryQuerySuffixStopsBeforeIO(t *testing.T) {
+	for failure := 0; failure < 7; failure++ {
+		var attempt upgradeSDKLeafCloseAttempt
+		seen := 0
+		jobClosed := false
+		call := func() error {
+			return closeSDKRetainedQueries(2, func(member int, role sdkRetainedQueryRole) error {
+				if seen == failure {
+					seen++
+					return ErrUpgrade
+				}
+				seen++
+				if role == sdkQueryJob {
+					if member != -1 {
+						t.Fatal("query job index")
+					}
+					jobClosed = true
+				} else if member < 0 || int(role) != (seen-1)%3 {
+					t.Fatal("wrong member-token-process ordering")
+				}
+				return nil
+			})
+		}
+		if attempt.run(call) == nil || attempt.run(call) == nil || seen != failure+1 || jobClosed {
+			t.Fatal("unknown query suffix retried/crossed job", failure, seen)
+		}
+	}
+	for _, n := range []int{0, upgradeSDKCohortBound + 1} {
+		calls := 0
+		if closeSDKRetainedQueries(n, func(int, sdkRetainedQueryRole) error { calls++; return nil }) == nil || calls != 0 {
+			t.Fatal("unbounded query cleanup")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..fc8b57101a39907f520d5a84a18331e2e244be5d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows.go
@@ -0,0 +1,401 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sort"
+	"unsafe"
+)
+
+// Only the actual original framer creates this after the complete retire reply.
+// No parser/DTO/callback constructor or fields are exported.
+type nativeUpgradeSDKRetireAck struct {
+	self             *nativeUpgradeSDKRetireAck
+	product          *nativeUpgradeSDKRetainedRetirement
+	owner            *nativeUpgradeSDKServingOwner
+	source           *nativeUpgradeSDKJoinedSource
+	resources        *nativeUpgradeSDKResources
+	cohort           *nativeUpgradeSDKCohort
+	io               *upgradeSDKControlIO
+	control, mainJob windows.Handle
+	before, after    uint32
+	lastOffer        uint64
+}
+type sdkRetainedMemberSlots struct {
+	member          *nativeUpgradeSDKCohortMember
+	generation      upgradeSDKCohortGeneration
+	process         windows.Handle
+	token, observed windows.Token
+}
+type nativeUpgradeSDKRetainedRetirement struct {
+	self                       *nativeUpgradeSDKRetainedRetirement
+	owner                      *nativeUpgradeSDKServingOwner
+	resources                  *nativeUpgradeSDKResources
+	source                     *nativeUpgradeSDKJoinedSource
+	cohort                     *nativeUpgradeSDKCohort
+	io                         *upgradeSDKControlIO
+	control, mainJob, queryJob windows.Handle
+	expected                   UpgradeProcess
+	members                    []sdkRetainedMemberSlots
+	total, retired             uint32
+	lastIssued                 uint64
+	cleanup                    upgradeSDKLeafCloseAttempt
+	cleaned                    bool
+}
+
+// Original protocol held; o.mu is used briefly, never while taking co.mu.
+func (p *nativeUpgradeSDKRetainedRetirement) bindingLocked() error {
+	if p == nil || p.self != p || p.owner == nil || p.resources == nil || p.source == nil || p.cohort == nil || p.io == nil {
+		return ErrUpgrade
+	}
+	o, r, s, co := p.owner, p.resources, p.source, p.cohort
+	o.mu.Lock()
+	bad := o.unknown || o.closed || !o.closeAttempted || !o.heartbeatStopped || o.resources != r || o.cohort != co || o.io != p.io || o.control != p.control || o.job != p.mainJob
+	o.mu.Unlock()
+	if bad || r.product != p || r.source != s || s.owner != o || s.cohort != co || s.io != p.io || s.control != p.control || s.bindingLocked() != nil || !s.complete || s.receiver.current != nil || s.receiver.lastOffer != s.lastOffer || co.receiver != o || co.birth != nil || r.process != &o.process || r.job != &o.job || r.control != &o.control || r.io != p.io || r.expected != p.expected || co.root != p.expected {
+		return ErrUpgrade
+	}
+	if !p.io.mu.TryLock() {
+		return ErrUpgrade
+	}
+	bad = p.io.unknown || p.io.op != nil || p.io.pipe != p.control
+	p.io.mu.Unlock()
+	if bad {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (p *nativeUpgradeSDKRetainedRetirement) ackLocked() error {
+	if p.bindingLocked() != nil {
+		return ErrUpgrade
+	}
+	a := p.owner.retireAck
+	if a == nil || a.self != a || a.product != p || a.owner != p.owner || a.source != p.source || a.resources != p.resources || a.cohort != p.cohort || a.io != p.io || a.control != p.control || a.mainJob != p.mainJob || a.before != p.source.sequence || !sdkRetireAckSequence(a.before, a.after) || a.after != p.owner.sequence || a.lastOffer != p.source.lastOffer {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (o *nativeUpgradeSDKServingOwner) bindRetainedRetirement(ctx context.Context, r *nativeUpgradeSDKResources, s *nativeUpgradeSDKJoinedSource) error {
+	if o == nil || r == nil || s == nil || ctx == nil || ctx.Err() != nil || !o.protocol.TryLock() {
+		return ErrUpgrade
+	}
+	defer o.protocol.Unlock()
+	if s.checkLocked(ctx) != nil || o.resources != r || r.product != nil || r.source != s || o.cohort == nil {
+		return ErrUpgrade
+	}
+	p := &nativeUpgradeSDKRetainedRetirement{owner: o, resources: r, source: s, cohort: o.cohort, io: o.io, control: o.control, mainJob: o.job, queryJob: o.cohort.job, expected: r.expected}
+	p.self = p
+	r.product = p
+	if p.bindingLocked() != nil {
+		return ErrUpgrade
+	}
+	co := p.cohort
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.unknown || co.ledger.complete() != nil || co.queryRetirement.attempted || co.job == 0 || sameUpgradeSDKKernelObject(co.job, o.job) != nil {
+		return ErrUpgrade
+	}
+	p.total, p.retired, p.lastIssued = co.ledger.total, co.ledger.retired, co.ledger.lastIssuedLeafID
+	for g, m := range co.members {
+		if m == nil || m.generation != g {
+			return ErrUpgrade
+		}
+		p.members = append(p.members, sdkRetainedMemberSlots{m, g, m.process, m.token, m.observedToken})
+	}
+	sort.Slice(p.members, func(i, j int) bool {
+		a, b := p.members[i].generation, p.members[j].generation
+		root := upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}
+		if a == root {
+			return false
+		}
+		if b == root {
+			return true
+		}
+		if a.PID != b.PID {
+			return a.PID < b.PID
+		}
+		return a.Creation < b.Creation
+	})
+	return p.checkQueriesLocked()
+}
+
+// Caller holds original protocol. No reentrant lock or live SDK postcheck:
+// existing exchange already checked live source/native owner before first byte.
+func (o *nativeUpgradeSDKServingOwner) issueRetireAckLocked(sequence uint32, reply upgradeSDKControlReply) error {
+	if o == nil || o.resources == nil || o.resources.product == nil || o.retireAck != nil || reply.Stage != "retirement-admitted" || reply.Leaf != nil {
+		return ErrUpgrade
+	}
+	p := o.resources.product
+	if p.bindingLocked() != nil || !sdkRetireAckSequence(p.source.sequence, sequence) || o.sequence != sequence {
+		return ErrUpgrade
+	}
+	a := &nativeUpgradeSDKRetireAck{product: p, owner: o, source: p.source, resources: p.resources, cohort: p.cohort, io: p.io, control: p.control, mainJob: p.mainJob, before: p.source.sequence, after: sequence, lastOffer: p.source.lastOffer}
+	a.self = a
+	o.retireAck = a
+	return nil
+}
+
+// co.mu + protocol held. This preclose check uses actual still-live query slots.
+func (p *nativeUpgradeSDKRetainedRetirement) checkQueriesLocked() error {
+	co, o := p.cohort, p.owner
+	if co.unknown || p.cleaned || co.job != p.queryJob || co.job == 0 || co.ledger.complete() != nil || co.ledger.total != p.total || co.ledger.retired != p.retired || co.ledger.lastIssuedLeafID != p.lastIssued || len(co.members) != len(p.members) || len(co.partial) > upgradeSDKCohortBound {
+		return ErrUpgrade
+	}
+	if sameUpgradeSDKKernelObject(co.job, p.mainJob) != nil || checkUpgradeSDKJobLimits(co.job) != nil {
+		return ErrUpgrade
+	}
+	// Independent actual query slots may refer to the same kernel objects, but
+	// raw handle values cannot alias main resources or another close-owner slot.
+	seen := map[windows.Handle]bool{}
+	for _, h := range []windows.Handle{o.process, o.job, o.control, o.image, windows.Handle(o.token), o.acceptance, o.supervisor, o.finalEvent, o.selfImage, o.file} {
+		if h != 0 {
+			seen[h] = true
+		}
+	}
+	for _, h := range o.controllers {
+		if h != 0 {
+			seen[h] = true
+		}
+	}
+	add := func(h windows.Handle) bool {
+		if h == 0 || h == windows.InvalidHandle || seen[h] {
+			return false
+		}
+		seen[h] = true
+		return true
+	}
+	if !add(co.job) {
+		return ErrUpgrade
+	}
+	known := map[*nativeUpgradeSDKCohortMember]bool{}
+	for _, slot := range p.members {
+		m := slot.member
+		if m == nil || known[m] || co.members[slot.generation] != m || m.generation != slot.generation || m.process != slot.process || m.token != slot.token || m.observedToken != slot.observed || m.retiredProcess.attempted || m.retiredToken.attempted || m.retiredObservedToken.attempted || !add(m.process) || !add(windows.Handle(m.token)) {
+			return ErrUpgrade
+		}
+		known[m] = true
+		if m.observedToken != 0 && !add(windows.Handle(m.observedToken)) {
+			return ErrUpgrade
+		}
+		if recheckUpgradeSDKCohortGeneration(m.process, slot.generation) != nil || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil {
+			return ErrUpgrade
+		}
+		if m.observedToken != 0 {
+			a, e := legacySDKTokenID(m.observedToken)
+			b, f := legacySDKTokenID(m.token)
+			if e != nil || f != nil || a != b || legacySDKOrdinaryToken(m.observedToken, co.sid, co.root.Session) != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	if co.checkRetainedPartialAliases(known) != nil {
+		return ErrUpgrade
+	}
+	root := co.members[upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}]
+	if root == nil || sameUpgradeSDKKernelObject(root.process, o.process) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// co.mu held. Map custody is sufficient; partial capture aliases are optional.
+// Every remaining partial must name an already validated exact map member.
+func (co *nativeUpgradeSDKCohort) checkRetainedPartialAliases(known map[*nativeUpgradeSDKCohortMember]bool) error {
+	if co == nil || len(co.partial) > upgradeSDKCohortBound {
+		return ErrUpgrade
+	}
+	for _, m := range co.partial {
+		if m == nil || !known[m] || co.members[m.generation] != m {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+func (p *nativeUpgradeSDKRetainedRetirement) accountingLocked() error {
+	total, active, e := p.cohort.accounting()
+	if e != nil || active != 0 || total != p.total || p.cohort.ledger.observe(total, active) != nil || p.cohort.ledger.complete() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (p *nativeUpgradeSDKRetainedRetirement) accountingBeforeRootLocked() error {
+	total, active, e := p.cohort.accounting()
+	if e != nil || total != p.total || p.cohort.ledger.observe(total, active) != nil || p.cohort.ledger.complete() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (p *nativeUpgradeSDKRetainedRetirement) closeQueriesLocked() error {
+	co := p.cohort
+	return p.cleanup.run(func() error {
+		if p.checkQueriesLocked() != nil || co.ledger.allCapturedSignaled() != nil {
+			return ErrUpgrade
+		}
+		if closeSDKRetainedQueries(len(p.members), func(index int, role sdkRetainedQueryRole) error {
+			if role == sdkQueryJob {
+				return co.queryRetirement.close(&co.job)
+			}
+			m := p.members[index].member
+			switch role {
+			case sdkQueryObservedToken:
+				if m.observedToken != 0 {
+					h := windows.Handle(m.observedToken)
+					if m.retiredObservedToken.close(&h) != nil {
+						return ErrUpgrade
+					}
+					m.observedToken = 0
+				}
+				return nil
+			case sdkQueryToken:
+				h := windows.Handle(m.token)
+				if m.retiredToken.close(&h) != nil {
+					return ErrUpgrade
+				}
+				m.token = 0
+				return nil
+			case sdkQueryProcess:
+				return m.retiredProcess.close(&m.process)
+			}
+			return ErrUpgrade
+		}) != nil {
+			return ErrUpgrade
+		}
+		p.cleaned = true
+		return nil
+	})
+}
+
+// Post-query-close phase uses cached positive completion and MAIN job only.
+// No generation/token/same-object query is issued on a consumed cohort cap.
+func (p *nativeUpgradeSDKRetainedRetirement) checkCleanedLocked() error {
+	co := p.cohort
+	if !p.cleaned || !p.cleanup.attempted || p.cleanup.err != nil || !co.queryRetirement.attempted || co.queryRetirement.err != nil || p.cohort.job != 0 || p.cohort.unknown {
+		return ErrUpgrade
+	}
+	if p.owner.job != p.mainJob || p.resources.job != &p.owner.job || co.ledger.total != p.total || co.ledger.retired != p.retired || co.ledger.lastIssuedLeafID != p.lastIssued || co.ledger.allCapturedSignaled() != nil || len(co.members) != len(p.members) {
+		return ErrUpgrade
+	}
+	for _, slot := range p.members {
+		m := slot.member
+		if m == nil || co.members[slot.generation] != m || m.generation != slot.generation || m.process != 0 || m.token != 0 || m.observedToken != 0 || !m.retiredProcess.attempted || m.retiredProcess.err != nil || !m.retiredToken.attempted || m.retiredToken.err != nil || slot.observed != 0 && (!m.retiredObservedToken.attempted || m.retiredObservedToken.err != nil) {
+			return ErrUpgrade
+		}
+	}
+	var accounting struct {
+		User, Kernel, PeriodUser, PeriodKernel int64
+		Faults, Total, Active, Terminated      uint32
+	}
+	if windows.QueryInformationJobObject(p.mainJob, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&accounting)), uint32(unsafe.Sizeof(accounting)), nil) != nil || accounting.Active != 0 || accounting.Total != p.total {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (r *nativeUpgradeSDKResources) retireProduct(ctx context.Context) (result error) {
+	if r == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	p := r.product
+	if p == nil || p.self != p || p.resources != r || r.source == nil || p.source != r.source || p.owner == nil {
+		return ErrUpgrade
+	}
+	if r.attempted {
+		return r.result
+	}
+	if !p.owner.protocol.TryLock() {
+		return ErrUpgrade
+	}
+	defer p.owner.protocol.Unlock()
+	if p.ackLocked() != nil {
+		return ErrUpgrade
+	}
+	r.attempted, r.result = true, ErrUpgrade
+	return runUpgradeSDKCloseBody(func() {
+		upgradeSDKPhysicalQuarantine.Lock()
+		upgradeSDKPhysicalQuarantine.owners[r] = struct{}{}
+		upgradeSDKPhysicalQuarantine.Unlock()
+	}, func() error {
+		return runSDKRetainedRetirement(func(step upgradeSDKRetainedStep) error {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			switch step {
+			case sdkRetainedPrecheck:
+				if p.ackLocked() != nil {
+					return ErrUpgrade
+				}
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				if p.checkQueriesLocked() != nil {
+					return ErrUpgrade
+				}
+				return p.accountingBeforeRootLocked()
+			case sdkRetainedRootWait:
+				return r.waitNativeRoot(ctx)
+			case sdkRetainedDrainJob:
+				return r.drainNativeJob(ctx)
+			case sdkRetainedPreAccounting:
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				if p.checkQueriesLocked() != nil {
+					return ErrUpgrade
+				}
+				return p.accountingLocked()
+			case sdkRetainedAllWait:
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				return p.cohort.waitCapturedLocked(ctx)
+			case sdkRetainedPostAccounting:
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				if p.cohort.ledger.allCapturedSignaled() != nil {
+					return ErrUpgrade
+				}
+				return p.accountingLocked()
+			case sdkRetainedCloseQueries:
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				return p.closeQueriesLocked()
+			case sdkRetainedFinalAccounting:
+				p.cohort.mu.Lock()
+				defer p.cohort.mu.Unlock()
+				return p.checkCleanedLocked()
+			case sdkRetainedCloseIO:
+				return r.closeNativeIO()
+			case sdkRetainedCloseMainJob:
+				return r.closeNativeJob()
+			case sdkRetainedReleaseControllers:
+				// Product release is the concrete bound owner method, never the
+				// historical physical prototype's configurable test callback.
+				if p.owner.releaseRetiredControllers() != nil {
+					return ErrUpgrade
+				}
+				r.stages = append(r.stages, "exclusions-released")
+				return nil
+			}
+			return ErrUpgrade
+		})
+	}, func(e error, complete bool) {
+		r.result = e
+		if !complete {
+			p.owner.fenceLeafReceiver()
+		} else {
+			upgradeSDKCohortCustody.Lock()
+			delete(upgradeSDKCohortCustody.owners, p.cohort)
+			upgradeSDKCohortCustody.Unlock()
+			upgradeSDKPhysicalQuarantine.Lock()
+			delete(upgradeSDKPhysicalQuarantine.owners, r)
+			upgradeSDKPhysicalQuarantine.Unlock()
+		}
+	})
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows_test.go b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows_test.go
