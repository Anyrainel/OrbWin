@@ -0,0 +1,46 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+)
+
+// All refusals happen before an OS call: valid serialized observations and
+// plausible native-owner structure cannot substitute for actual held resources.
+func TestRuntimeObservedCandidateRefusesDTOOnlyOwnerAndCopiedWitness(t *testing.T) {
+	r, _ := upgradeImportedFixture(t)
+	j := r.last.Journal
+	v := upgradeValidationFixture(j)
+	digest, err := v.digest(j)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := new(InstanceRoot)
+	c := &nativeUpgradeCandidate{resumed: true, expected: v.Candidate,
+		launcher: &nativeUpgradeCandidateLauncher{authority: &upgradeAuthorityOwner{
+			cold: &upgradeColdTree{retirement: &upgradeRetirement{root: root}},
+		}},
+	}
+	if c.retainObservedCandidate(context.Background(), j, v) == nil || c.observed != nil {
+		t.Fatal("DTO and owner shape issued an observed capability")
+	}
+	w := &nativeUpgradeObservedCandidate{c, root, j.Transaction, digest}
+	c.observed = w // Data-only hostile shape; no native authority is installed.
+	copy := *w
+	if copy.check(context.Background(), root, j, v) == nil {
+		t.Fatal("copied witness admitted")
+	}
+	if w.check(context.Background(), new(InstanceRoot), j, v) == nil {
+		t.Fatal("borrowed root admitted")
+	}
+	v.Candidate.Creation++
+	if w.check(context.Background(), root, j, v) == nil {
+		t.Fatal("another generation admitted")
+	}
+	v.Candidate = c.expected
+	if w.check(context.Background(), root, j, v) == nil {
+		t.Fatal("missing held native process/token/image admitted")
+	}
+}
