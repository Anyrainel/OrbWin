+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"io"
+	"runtime"
+	"sync"
+)
+
+// Sole operation graph. No caller can supply this owner or its root/storage.
+// The fixed entry owns the real selection before storage can create setup.lock.
+// Unknown selection release fences storage BEFORE its controller may release.
+type runtimePreflightNativeOwner struct {
+	selection *authoritypath.ProductSelectionOwner
+	storage   *nativeRuntimeStorage
+	root      *InstanceRoot
+	unknown   bool
+}
+
+var runtimePreflightOwners = struct {
+	sync.Mutex
+	owners map[*runtimePreflightNativeOwner]bool
+}{owners: make(map[*runtimePreflightNativeOwner]bool)}
+
+func (o *runtimePreflightNativeOwner) retainUnknown() {
+	o.unknown = true
+	if o.storage != nil {
+		o.storage.mu.Lock()
+		o.storage.fence()
+		o.storage.mu.Unlock()
+	}
+	runtimePreflightOwners.Lock()
+	runtimePreflightOwners.owners[o] = true
+	runtimePreflightOwners.Unlock()
+}
+func (o *runtimePreflightNativeOwner) close() error {
+	if o.unknown {
+		return ErrRuntimePreflight
+	}
+	// The selector's checked close must precede the real controller-last graph.
+	// If selector cleanup is unknown, leave storage.setup.lock actually held.
+	if runtimePreflightReleaseSequence(func() error {
+		if o.selection != nil {
+			return o.selection.Close()
+		}
+		return nil
+	}, func() error {
+		if o.storage != nil {
+			return o.storage.Close()
+		}
+		return nil
+	}, o.retainUnknown) != nil {
+		return ErrRuntimePreflight
+	}
+	runtimePreflightOwners.Lock()
+	delete(runtimePreflightOwners.owners, o)
+	runtimePreflightOwners.Unlock()
+	return nil
+}
+func (o *runtimePreflightNativeOwner) checkStorage() error {
+	o.storage.mu.Lock()
+	defer o.storage.mu.Unlock()
+	return o.storage.checkPrevious()
+}
+
+func runtimeOperationWrite(ctx context.Context, output io.Writer, state string) error {
+	body, e := json.Marshal(struct {
+		Schema       int    `json:"schema"`
+		State        string `json:"state"`
+		SetupSuccess bool   `json:"setupSuccess"`
+		Publication  bool   `json:"runtimePublication"`
+	}{1, state, false, false})
+	if e != nil || len(body) > 256 || output == nil {
+		return ErrRuntimePreflight
+	}
+	body = append(body, '\n')
+	// IO task owns DATA only, never selection/storage/controller. On a blocked
+	// stdio writer the owner deadline still settles the native graph; no native
+	// completion or IO-retirement grant is derived from this worker's existence.
+	done := make(chan error, 1)
+	go func() {
+		n, e := output.Write(body)
+		if e != nil || n != len(body) {
+			e = ErrRuntimePreflight
+		}
+		done <- e
+	}()
+	select {
+	case e := <-done:
+		return e
+	case <-ctx.Done():
+		return ErrRuntimePreflight
+	}
+}
+
+// RunNativeRuntimePreflight is the fixed product-only entry. It performs no
+// service lifecycle, runtime stage/rename, SDK, engine, fresh/upgrade journal,
+// observed-candidate binding or success publication. Its ONLY positive path
+// constructs the actual native owner below and checks both real graph releases.
+func RunNativeRuntimePreflight(ctx context.Context, input io.Reader, output io.Writer) (result error) {
+	if ctx == nil || ctx.Err() != nil || input == nil || output == nil {
+		return ErrRuntimePreflight
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrRuntimePreflight
+	}
+	ownerCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	first := make(chan runtimePreflightFrame, 1)
+	terminal := make(chan runtimePreflightFrame, 1)
+	var held runtimePreflightHeldBarrier
+	// Exactly two bounded frames. Reader owns only stdin DATA; disconnect/unknown
+	// cancels acquisition, never closes/drops an actual native owner from here.
+	go func() {
+		op, e := readRuntimeOperationFrame(input)
+		first <- runtimePreflightFrame{op, e}
+		if e != nil || op != "preflight" {
+			return
+		}
+		terminal <- readRuntimeOperationTerminal(input, cancel)
+	}()
+	select {
+	case frame := <-first:
+		if frame.err != nil || frame.operation != "preflight" {
+			return ErrRuntimePreflight
+		}
+	case <-ownerCtx.Done():
+		return ErrRuntimePreflight
+	}
+	o := &runtimePreflightNativeOwner{}
+	runtimePreflightOwners.Lock()
+	if len(runtimePreflightOwners.owners) >= 16 {
+		runtimePreflightOwners.Unlock()
+		return ErrRuntimePreflight
+	}
+	runtimePreflightOwners.owners[o] = true
+	runtimePreflightOwners.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.retainUnknown()
+			panic(p)
+		}
+	}()
+	// Constructor errors retain any real partial owner before checking cleanup.
+	result = runtimePreflightSequence(ownerCtx, func(step runtimePreflightStep) error {
+		switch step {
+		case runtimePreflightCapture:
+			var e error
+			o.selection, e = authoritypath.CaptureCurrentProduct(ownerCtx)
+			if e != nil {
+				if o.close() != nil {
+					o.retainUnknown()
+				}
+				return ErrRuntimePreflight
+			}
+			selected, e := o.selection.Selection(ownerCtx)
+			if e != nil {
+				if o.close() != nil {
+					o.retainUnknown()
+				}
+				return ErrRuntimePreflight
+			}
+			o.root = &InstanceRoot{home: selected.GuestHome(), sid: selected.Owner(), selection: selected}
+			if runtimePreflightCaptureSequence(func() error {
+				var e error
+				o.storage, e = allocateNativeRuntimeStorageCapture(ownerCtx, o.root)
+				return e
+			}, func() error { return o.storage.captureNative(ownerCtx) }, o.close, o.retainUnknown) != nil {
+				return ErrRuntimePreflight
+			}
+		case runtimePreflightVerify:
+			if o.checkStorage() != nil {
+				return ErrRuntimePreflight
+			}
+		case runtimePreflightObserveHeld:
+			if held.publish(func() error { return runtimeOperationWrite(ownerCtx, output, "storage-preflight-held") }) != nil {
+				return ErrRuntimePreflight
+			}
+		case runtimePreflightWaitControl:
+			select {
+			case frame := <-terminal:
+				if held.terminal(frame.operation, frame.err) != nil || frame.operation != "release" {
+					return ErrRuntimePreflight
+				}
+			case <-ownerCtx.Done():
+				return ErrRuntimePreflight
+			}
+			if o.checkStorage() != nil {
+				return ErrRuntimePreflight
+			}
+		case runtimePreflightRelease:
+			return o.close()
+		}
+		return nil
+	})
+	runtime.KeepAlive(o)
+	if result != nil {
+		return ErrRuntimePreflight
+	}
+	return runtimeOperationWrite(ctx, output, "preflight-completed")
+}
