@@ -0,0 +1,36 @@
+//go:build windows
+
+package managementconfig
+
+import "sync"
+
+// Process-lifetime custody only. The actual owner retains permit/root, code,
+// physical resources and pinned IO through its original graph. An unknown
+// native result is never repaired by a descriptor or another Close attempt.
+// Unknown entries have no removal capability; only positive closed completion
+// removes a guard. This map cannot grant admission or retirement.
+var upgradeSDKServingQuarantine = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeSDKServingOwner]struct{}
+}{owners: map[*nativeUpgradeSDKServingOwner]struct{}{}}
+
+func retainUnknownUpgradeSDKServingOwner(owner *nativeUpgradeSDKServingOwner) {
+	if owner == nil {
+		return
+	}
+	upgradeSDKServingQuarantine.Lock()
+	upgradeSDKServingQuarantine.owners[owner] = struct{}{}
+	upgradeSDKServingQuarantine.Unlock()
+}
+
+func releaseClosedUpgradeSDKServingOwner(owner *nativeUpgradeSDKServingOwner) {
+	// Sole callsite follows the actual close guard's completed success.
+	upgradeSDKServingQuarantine.Lock()
+	delete(upgradeSDKServingQuarantine.owners, owner)
+	upgradeSDKServingQuarantine.Unlock()
+}
+
+var upgradeSDKPhysicalQuarantine = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeSDKResources]struct{}
+}{owners: map[*nativeUpgradeSDKResources]struct{}{}}
