+	"golang.org/x/sys/windows"
+	"testing"
+	"time"
+)
+
+type refusedNativeCandidateObservers struct{ root *InstanceRoot }
+
+func (p refusedNativeCandidateObservers) RootBacking() *InstanceRoot { return p.root }
+
+func (refusedNativeCandidateObservers) observeNativeUpgradeCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal) (upgradeValidation, error) {
+	return upgradeValidation{}, ErrUpgrade
+}
+
+func TestUpgradeNativeCandidateResumeAttemptCannotUseSuspendedCleanup(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	c := &nativeUpgradeCandidate{resumeAttempted: true, process: 101, thread: 102}
+	b := &nativeUpgradeCandidateUnresumed{candidate: c, process: 101, thread: 102, pid: 103}
+	if b.retire(ctx) == nil || b.attempted || b.retired {
+		t.Fatal("ambiguous ResumeThread reached narrow cleanup")
+	}
+	b.attempted, b.err = true, ErrUpgrade
+	if b.retire(ctx) == nil || b.retired {
+		t.Fatal("unknown cleanup repeated or became a grant")
+	}
+	// A cached unknown close never invokes Win32 again, even when another
+	// cleanup path still sees the original numeric field for inspection.
+	h := windows.Handle(201)
+	c.closeAttempts = map[windows.Handle]error{h: ErrUpgrade}
+	for n := 0; n < 2; n++ {
+		if c.closeNativeOnce(&h) == nil || h != 201 {
+			t.Fatal("lost close reply retried/dropped")
+		}
+	}
+}
+
+type refusedNativeCandidateRetirement struct{ root *InstanceRoot }
+
+func (p refusedNativeCandidateRetirement) RootBacking() *InstanceRoot { return p.root }
+
+type refusedNativeCandidatePublication struct {
+	fakeUpgradeRuntime
+	root *InstanceRoot
+}
+
+func (p refusedNativeCandidatePublication) RootBacking() *InstanceRoot { return p.root }
+
+func (refusedNativeCandidatePublication) retainNativeUpgradeObservedCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal, upgradeValidation) error {
+	return ErrUpgrade
+}
+
+func (refusedNativeCandidateRetirement) retireNativeUpgradeCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal) (upgradeNativeCandidateRetired, error) {
+	return nil, ErrUpgrade
+}
+
+func TestUpgradeNativeCandidateMissingProvidersRefuseBeforeSDKPreparation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	root := &InstanceRoot{}
+	for _, missing := range []string{"all", "observe", "retire", "publish", "typed-nil", "foreign-root"} {
+		providers := &upgradeNativeCandidateProviders{observations: refusedNativeCandidateObservers{root}, retirement: refusedNativeCandidateRetirement{root}, publication: &refusedNativeCandidatePublication{root: root}}
+		switch missing {
+		case "all":
+			providers = nil
+		case "observe":
+			providers.observations = nil
+		case "retire":
+			providers.retirement = nil
+		case "publish":
+			providers.publication = nil
+		case "typed-nil":
+			providers.observations = (*refusedNativeCandidateObservers)(nil)
+		case "foreign-root":
+			providers.observations = refusedNativeCandidateObservers{&InstanceRoot{}}
+		}
+		authority := &upgradeAuthorityOwner{cold: &upgradeColdTree{retirement: &upgradeRetirement{root: root}}}
+		if a, err := prepareNativeUpgradeActivation(ctx, authority, &nativeUpgradeLegacySDKOwner{}, providers); err == nil || a != nil || authority.sdk != nil {
+			t.Fatal("missing full-scope provider reached SDK/native effects", missing, err)
+		}
+	}
+	providers := &upgradeNativeCandidateProviders{observations: refusedNativeCandidateObservers{root}, retirement: refusedNativeCandidateRetirement{root}, publication: &refusedNativeCandidatePublication{root: root}}
+	partial, err := prepareNativeUpgradeActivation(ctx, &upgradeAuthorityOwner{cold: &upgradeColdTree{retirement: &upgradeRetirement{root: root}}}, &nativeUpgradeLegacySDKOwner{}, providers)
+	if err == nil || partial == nil || !partial.attempted || !partial.unknown || partial.activate(ctx) == nil {
+		t.Fatal("failed native construction discarded/restarted partial coordinator", err)
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort.go
new file mode 100644
index 0000000000000000000000000000000000000000..f319c4fc9d777811b6d91027603d867ff0b2f21f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort.go
@@ -0,0 +1,154 @@
+package managementconfig
+
+// Completeness ledger only, never an end-of-birth or retirement grant. Native
+// capture owns every generation before registering it here. Cumulative job
+// counts include rejected associations: an unexplained count therefore refuses.
+type upgradeSDKCohortGeneration struct {
+	PID      uint32
+	Creation uint64
+}
+type upgradeSDKCohortLedger struct {
+	root             *upgradeSDKCohortGeneration
+	total            uint32
+	retired          uint32 // actual same-custodian positive wait/closed-member compaction only
+	lastIssuedLeafID uint64 // DATA ordering in one actual native issuer, never generation proof
+	unknown          bool
+	members          map[upgradeSDKCohortGeneration]bool // true only after actual positive wait
+}
+
+func (l *upgradeSDKCohortLedger) registerRoot(g upgradeSDKCohortGeneration) error {
+	if l == nil || l.root != nil || l.capture(g) != nil {
+		return ErrUpgrade
+	}
+	copy := g
+	l.root = &copy
+	return nil
+}
+
+const upgradeSDKCohortBound = 256
+
+func (l *upgradeSDKCohortLedger) observe(total, active uint32) error {
+	if l == nil || l.unknown || total < l.total || active > total || active > upgradeSDKCohortBound {
+		if l != nil {
+			l.unknown = true
+		}
+		return ErrUpgrade
+	}
+	l.total = total
+	return nil
+}
+func (l *upgradeSDKCohortLedger) capture(g upgradeSDKCohortGeneration) error {
+	if l != nil && l.retired != 0 {
+		// Advisory PID discovery cannot distinguish a compacted generation
+		// from a new birth. Never let it fill a later cumulative count gap.
+		l.unknown = true
+		return ErrUpgrade
+	}
+	return l.captureMember(g, true)
+}
+
+// DATA accounting only. The sole native receiver must FIRST validate an actual
+// SDK-issued suspended process handle and its exact issuer/leaf identity. A
+// monotonically increasing serial does not prove universal generation freshness
+// and cannot replace that native prerequisite. No native caller is added here.
+func (l *upgradeSDKCohortLedger) captureIssuedLeaf(g upgradeSDKCohortGeneration, leafID uint64) error {
+	if l == nil {
+		return ErrUpgrade
+	}
+	if l.unknown || l.root == nil || g == *l.root || leafID == 0 || leafID <= l.lastIssuedLeafID {
+		l.unknown = true
+		return ErrUpgrade
+	}
+	if e := l.captureMember(g, false); e != nil {
+		l.unknown = true
+		return e
+	}
+	l.lastIssuedLeafID = leafID
+	return nil
+}
+
+func (l *upgradeSDKCohortLedger) captureMember(g upgradeSDKCohortGeneration, duplicateOK bool) error {
+	if l == nil || l.unknown || g.PID == 0 || g.Creation == 0 {
+		return ErrUpgrade
+	}
+	if l.members == nil {
+		l.members = map[upgradeSDKCohortGeneration]bool{}
+	}
+	if _, seen := l.members[g]; seen {
+		if duplicateOK {
+			return nil
+		}
+		l.unknown = true
+		return ErrUpgrade
+	}
+	if len(l.members) >= upgradeSDKCohortBound {
+		l.unknown = true
+		return ErrUpgrade
+	}
+	for old, joined := range l.members {
+		if old.PID == g.PID && !joined {
+			l.unknown = true
+			return ErrUpgrade
+		}
+	}
+	l.members[g] = false
+	return nil
+}
+func (l *upgradeSDKCohortLedger) joined(g upgradeSDKCohortGeneration) error {
+	if l == nil || l.unknown {
+		return ErrUpgrade
+	}
+	if _, known := l.members[g]; !known {
+		l.unknown = true
+		return ErrUpgrade
+	}
+	l.members[g] = true
+	return nil
+}
+func (l *upgradeSDKCohortLedger) complete() error {
+	if l == nil || l.unknown || l.root == nil || uint64(l.total) != uint64(l.retired)+uint64(len(l.members)) {
+		return ErrUpgrade
+	}
+	if _, known := l.members[*l.root]; !known {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// DATA accounting only. The native custodian must first bind the actual leaf,
+// observe its positive signal and producer closed ACK, and checked-close its
+// own query/token handles. This method neither closes handles nor grants scope
+// retirement. In particular a count or joined DTO cannot call the native path.
+func (l *upgradeSDKCohortLedger) compact(g upgradeSDKCohortGeneration) error {
+	if l == nil {
+		return ErrUpgrade
+	}
+	joined, known := l.members[g]
+	if l.complete() != nil || l.root == nil || g == *l.root || !known || !joined || l.retired == ^uint32(0) {
+		l.unknown = true
+		return ErrUpgrade
+	}
+	delete(l.members, g)
+	l.retired++
+	return l.complete()
+}
+
+// Initial TEMP -> management candidate transfer occurs before leaf issuance.
+// Its existing wire has no compacted-history field; never infer such history.
+func (l *upgradeSDKCohortLedger) initialTransferComplete() error {
+	if l == nil || l.retired != 0 {
+		return ErrUpgrade
+	}
+	return l.complete()
+}
+func (l *upgradeSDKCohortLedger) allCapturedSignaled() error {
+	if l.complete() != nil {
+		return ErrUpgrade
+	}
+	for _, joined := range l.members {
+		if !joined {
+			return ErrUpgrade
+		}
+	}
+	return nil // observation only; late-admission/producer seal is still required
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_compaction_test.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_compaction_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..43ea61b86b112b571e5663d8bf016171ea10bdda
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_compaction_test.go
@@ -0,0 +1,192 @@
+package managementconfig
+
+import "testing"
+
+func TestUpgradeSDKCohortCompactsOnlyStoppedChildrenWithoutLifetimeBudget(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root := upgradeSDKCohortGeneration{1, 100}
+	if l.registerRoot(root) != nil || l.observe(1, 1) != nil || l.initialTransferComplete() != nil {
+		t.Fatal("initial root")
+	}
+	for n := uint32(1); n <= 4096; n++ {
+		child := upgradeSDKCohortGeneration{2, uint64(n) + 100}
+		if l.captureIssuedLeaf(child, uint64(n)) != nil || l.observe(n+1, 2) != nil || l.complete() != nil || l.joined(child) != nil || l.compact(child) != nil || l.observe(n+1, 1) != nil {
+			t.Fatal("serial native-observation accounting", n)
+		}
+		if len(l.members) != 1 || l.retired != n || l.complete() != nil || l.allCapturedSignaled() == nil || l.initialTransferComplete() == nil {
+			t.Fatal("compaction lost root, count, or transfer boundary", n)
+		}
+	}
+	if l.joined(root) != nil || l.allCapturedSignaled() != nil {
+		t.Fatal("retired child accounting cannot replace root wait")
+	}
+}
+
+func TestUpgradeSDKCohortCompactionMisorderingFencesRatherThanDropsHistory(t *testing.T) {
+	for _, kind := range []string{"root", "not-signaled", "missing", "replayed", "count-gap"} {
+		t.Run(kind, func(t *testing.T) {
+			l := &upgradeSDKCohortLedger{}
+			root, child := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}
+			if l.registerRoot(root) != nil || l.capture(child) != nil || l.observe(2, 1) != nil {
+				t.Fatal("setup")
+			}
+			g := child
+			switch kind {
+			case "root":
+				g = root
+				if l.joined(root) != nil {
+					t.Fatal("root observation")
+				}
+			case "missing":
+				g = upgradeSDKCohortGeneration{3, 300}
+			case "replayed":
+				if l.joined(child) != nil || l.compact(child) != nil {
+					t.Fatal("first compaction")
+				}
+			case "count-gap":
+				if l.joined(child) != nil || l.observe(3, 1) != nil {
+					t.Fatal("unaccounted native birth")
+				}
+			}
+			before := len(l.members)
+			if l.compact(g) == nil || !l.unknown || len(l.members) != before || l.complete() == nil || l.observe(l.total, 0) == nil {
+				t.Fatal("invalid compaction released accounting", kind)
+			}
+		})
+	}
+}
+
+func TestUpgradeSDKCohortCompactedHistoryCannotExplainANewMissingBirth(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root, child := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}
+	if l.registerRoot(root) != nil || l.capture(child) != nil || l.observe(2, 1) != nil || l.joined(child) != nil || l.compact(child) != nil || l.observe(3, 1) != nil {
+		t.Fatal("setup")
+	}
+	if l.complete() == nil || l.allCapturedSignaled() == nil || l.initialTransferComplete() == nil {
+		t.Fatal("retired count manufactured native generation")
+	}
+	if l.captureIssuedLeaf(upgradeSDKCohortGeneration{2, 300}, 1) != nil || l.complete() != nil {
+		t.Fatal("actual new-generation observation did not reconcile")
+	}
+}
+
+func TestUpgradeSDKCohortStillBoundsLiveCustodyAfterCompaction(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	if l.registerRoot(upgradeSDKCohortGeneration{1, 100}) != nil {
+		t.Fatal("root")
+	}
+	for n := uint32(2); n <= upgradeSDKCohortBound; n++ {
+		if l.capture(upgradeSDKCohortGeneration{n, uint64(n) + 100}) != nil {
+			t.Fatal("within live bound", n)
+		}
+	}
+	if l.capture(upgradeSDKCohortGeneration{999, 999}) == nil || !l.unknown {
+		t.Fatal("unbounded actual live custody")
+	}
+}
+
+func TestUpgradeSDKCohortRetiredGenerationCannotFillLaterCountGapByAdvisoryCapture(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root, child := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}
+	if l.registerRoot(root) != nil || l.capture(child) != nil || l.observe(2, 1) != nil || l.joined(child) != nil || l.compact(child) != nil || l.observe(3, 1) != nil {
+		t.Fatal("setup")
+	}
+	if l.complete() == nil {
+		t.Fatal("missing native birth accepted")
+	}
+	if l.capture(child) == nil || !l.unknown || len(l.members) != 1 || l.retired != 1 {
+		t.Fatal("compacted advisory replay changed accounting")
+	}
+	if l.complete() == nil || l.captureIssuedLeaf(upgradeSDKCohortGeneration{3, 300}, 1) == nil || l.observe(3, 0) == nil {
+		t.Fatal("metadata resurrected fenced history")
+	}
+}
+
+func TestUpgradeSDKCohortIssuedLeafRejectsIDReplayWrapAndLiveDuplicates(t *testing.T) {
+	for _, kind := range []string{"zero", "replay", "backward", "wrap", "root", "live-generation", "live-pid", "invalid-generation", "no-root"} {
+		t.Run(kind, func(t *testing.T) {
+			l := &upgradeSDKCohortLedger{}
+			root, child := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}
+			last := uint64(5)
+			if kind == "wrap" {
+				last = ^uint64(0)
+			}
+			if kind != "no-root" {
+				if l.registerRoot(root) != nil || l.captureIssuedLeaf(child, last) != nil || l.observe(2, 2) != nil {
+					t.Fatal("setup")
+				}
+			}
+			g, id := upgradeSDKCohortGeneration{3, 300}, uint64(6)
+			switch kind {
+			case "zero":
+				id = 0
+			case "replay":
+				id = 5
+			case "backward":
+				id = 4
+			case "wrap":
+				id = 1
+			case "root":
+				g = root
+			case "live-generation":
+				g = child
+			case "live-pid":
+				g = upgradeSDKCohortGeneration{2, 300}
+			case "invalid-generation":
+				g = upgradeSDKCohortGeneration{}
+			}
+			before, total, retired, serial := len(l.members), l.total, l.retired, l.lastIssuedLeafID
+			if l.captureIssuedLeaf(g, id) == nil || !l.unknown || len(l.members) != before || l.total != total || l.retired != retired || l.lastIssuedLeafID != serial {
+				t.Fatal("bad issued accounting changed state")
+			}
+			if l.complete() == nil || l.observe(total, 0) == nil || l.captureIssuedLeaf(upgradeSDKCohortGeneration{9, 900}, 99) == nil {
+				t.Fatal("fenced issuer reopened")
+			}
+		})
+	}
+}
+
+func TestUpgradeSDKCohortIssuedIDGapsNeverExplainNativeBirthCounts(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root, a, b := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}, upgradeSDKCohortGeneration{3, 300}
+	if l.registerRoot(root) != nil || l.observe(1, 1) != nil || l.captureIssuedLeaf(a, 5) != nil || l.observe(2, 2) != nil || l.complete() != nil || l.joined(a) != nil || l.compact(a) != nil {
+		t.Fatal("first actual issued leaf")
+	}
+	// IDs 6..999 may represent no-birth claims. They are neither native
+	// associations nor an explanation for any cumulative job count increase.
+	if l.captureIssuedLeaf(b, 1000) != nil || l.observe(4, 2) != nil || l.complete() == nil || l.retired != 1 || len(l.members) != 2 {
+		t.Fatal("serial filled a missing native birth")
+	}
+	if l.observe(3, 2) == nil || !l.unknown {
+		t.Fatal("backwards native total recovered gap")
+	}
+}
+
+func TestUpgradeSDKCohortIssuedPathKeepsLiveBoundAfterManyCompactions(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root, old := upgradeSDKCohortGeneration{1, 100}, upgradeSDKCohortGeneration{2, 200}
+	if l.registerRoot(root) != nil || l.captureIssuedLeaf(old, 1) != nil || l.observe(2, 2) != nil || l.joined(old) != nil || l.compact(old) != nil {
+		t.Fatal("compacted setup")
+	}
+	for n := uint32(2); n <= upgradeSDKCohortBound; n++ {
+		if l.captureIssuedLeaf(upgradeSDKCohortGeneration{n, uint64(n) + 1000}, uint64(n)) != nil {
+			t.Fatal("live bound too small", n)
+		}
+	}
+	if l.observe(upgradeSDKCohortBound+1, upgradeSDKCohortBound) != nil || l.complete() != nil || len(l.members) != upgradeSDKCohortBound || l.retired != 1 {
+		t.Fatal("retired history charged live budget")
+	}
+	if l.captureIssuedLeaf(upgradeSDKCohortGeneration{999, 9999}, upgradeSDKCohortBound+1) == nil || !l.unknown || len(l.members) != upgradeSDKCohortBound {
+		t.Fatal("issued path escaped live bound")
+	}
+}
+
+func TestUpgradeSDKCohortCumulativeCounterWrapCannotResurrectHistory(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	if l.registerRoot(upgradeSDKCohortGeneration{1, 100}) != nil || l.observe(^uint32(0), 1) != nil || l.observe(0, 0) == nil || !l.unknown {
+		t.Fatal("wrapped native counter accepted")
+	}
+	if l.complete() == nil || l.captureIssuedLeaf(upgradeSDKCohortGeneration{2, 200}, 1) == nil {
+		t.Fatal("wrapped ledger reopened")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..2c4a5a03792fe6e60244fd613e979ab7bc005fcb
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows.go
@@ -0,0 +1,187 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sync"
+)
+
+// Actual native initial-set custody, not a current live-job snapshot or source
+// seal. Only the held before-Resume management process supplies remote handles.
+type nativeUpgradeSDKCohortAdoption struct {
+	co            *nativeUpgradeSDKCohort
+	x             *nativeUpgradeSDKCandidateTransfer
+	returns       []*nativeUpgradeSDKCohortReturn
+	verified      bool
+	close         upgradeSDKHandoffClose
+	unknownCloses []windows.Handle
+}
+type nativeUpgradeSDKCohortReturn struct {
+	original, remote, held windows.Handle
+	rights, allowed        uint32
+}
+
+var upgradeSDKHandoffCustody = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeSDKCohortAdoption]struct{}
+}{owners: map[*nativeUpgradeSDKCohortAdoption]struct{}{}}
+
+// Caller holds co.mu. Only the immutable INITIAL transfer is compared. The
+// receiving actor may already have issued/closed newer leaves; TEMP does not
+// reconcile its historical initial ledger with the current job's accounting.
+func (co *nativeUpgradeSDKCohort) historicalTransferLocked(x *nativeUpgradeSDKCandidateTransfer) error {
+	if co == nil || x == nil || x.prepared == nil || x.prepared.child == nil || x.prepared.grant == nil || co.birth != x.prepared.child || co.transfer != x || co.unknown || co.sid != x.prepared.grant.wire.Scope.SID || co.root != co.birth.expected || co.ledger.initialTransferComplete() != nil || uint32(len(co.members)) != x.wire.Cohort.Total || len(co.members) != len(x.wire.Cohort.Members) {
+		return ErrUpgrade
+	}
+	for _, v := range x.wire.Cohort.Members {
+		g := upgradeSDKCohortGeneration{v.PID, v.Creation}
+		m := co.members[g]
+		if m == nil || m.generation != g {
+			return ErrUpgrade
+		}
+	}
+	// Partial slots alias registered owners after successful capture. They may
+	// not hide an unregistered partial native output or become a second closer.
+	for _, m := range co.partial {
+		if m == nil || co.members[m.generation] != m {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+func (co *nativeUpgradeSDKCohort) recheckHistoricalTransfer(x *nativeUpgradeSDKCandidateTransfer) error {
+	if co == nil {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	return co.historicalTransferLocked(x)
+}
+
+// x.mu is held. Both actual events must already be positive. Every returned
+// native output is retained before syscall/error and never retried on failure.
+func (co *nativeUpgradeSDKCohort) requireHandoffAdoption(ctx context.Context, x *nativeUpgradeSDKCandidateTransfer) error {
+	if co == nil || ctx == nil || ctx.Err() != nil || x == nil {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.historicalTransferLocked(x) != nil || co.adoption != nil || co.job == 0 || x.provisional == nil || !x.provisional.admitted || x.provisional.transfer != x || x.provisional.candidate == nil || x.provisional.returned == 0 || x.acceptance == nil || !x.acceptance.accepted {
+		return ErrUpgrade
+	}
+	p := x.provisional
+	a := x.acceptance
+	if p.candidate.expected != a.expected || p.candidate.process == 0 || sameUpgradeSDKKernelObject(p.returned, p.candidate.process) != nil || sameUpgradeSDKKernelObject(p.returned, a.process) != nil || a.checkNative(ctx, co.sid) != nil {
+		return ErrUpgrade
+	}
+	for _, e := range []windows.Handle{x.event, x.supervisorEvent} {
+		s, err := windows.WaitForSingleObject(e, 0)
+		if err != nil || s != uint32(windows.WAIT_OBJECT_0) {
+			return ErrUpgrade
+		}
+	}
+	ad := &nativeUpgradeSDKCohortAdoption{co: co, x: x}
+	co.adoption = ad
+	completed := false
+	defer func() {
+		if !completed {
+			co.unknown = true
+		}
+	}()
+	upgradeSDKHandoffCustody.Lock()
+	upgradeSDKHandoffCustody.owners[ad] = struct{}{}
+	upgradeSDKHandoffCustody.Unlock()
+	add := func(original windows.Handle, remote uint64, rights, allowed uint32) error {
+		r := &nativeUpgradeSDKCohortReturn{original: original, remote: windows.Handle(remote), rights: rights, allowed: allowed}
+		ad.returns = append(ad.returns, r)
+		if original == 0 || remote == 0 || uint64(uintptr(remote)) != remote || windows.DuplicateHandle(p.returned, r.remote, windows.CurrentProcess(), &r.held, rights, false, 0) != nil || r.held == 0 || sameUpgradeSDKKernelObject(original, r.held) != nil || upgradeSDKCohortHandleRights(r.held, rights, allowed) != nil {
+			return ErrUpgrade
+		}
+		return nil
+	}
+	if add(co.job, x.wire.Cohort.Job, 0x0004|windows.SYNCHRONIZE, 0x0004|windows.SYNCHRONIZE) != nil {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	for _, v := range x.wire.Cohort.Members {
+		g := upgradeSDKCohortGeneration{v.PID, v.Creation}
+		m := co.members[g]
+		rights := uint32(windows.PROCESS_QUERY_INFORMATION | windows.SYNCHRONIZE)
+		if recheckUpgradeSDKCohortGeneration(m.process, g) != nil || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil || add(m.process, v.Process, rights, rights|windows.PROCESS_QUERY_LIMITED_INFORMATION) != nil || add(windows.Handle(m.token), v.Token, windows.TOKEN_QUERY, windows.TOKEN_QUERY) != nil {
+			co.unknown = true
+			return ErrUpgrade
+		}
+	}
+	if ad.checkHeld(ctx) != nil {
+		co.unknown = true
+		return ErrUpgrade
+	}
+	ad.verified = true
+	completed = true
+	return nil
+}
+
+// Private pre-close check; never used as positive posthandoff admission. It
+// must run while TEMP still has all original query handles, before any closes.
+func (ad *nativeUpgradeSDKCohortAdoption) checkHeld(ctx context.Context) error {
+	if ad == nil || ad.co == nil || ad.x == nil || ad.co.adoption != ad || ctx == nil || ctx.Err() != nil || ad.x.provisional == nil || ad.x.acceptance == nil || ad.co.unknown || ad.co.historicalTransferLocked(ad.x) != nil || ad.x.acceptance.checkNative(ctx, ad.co.sid) != nil {
+		return ErrUpgrade
+	}
+	if len(ad.returns) != 1+2*len(ad.x.wire.Cohort.Members) {
+		return ErrUpgrade
+	}
+	for _, r := range ad.returns {
+		if r == nil || sameUpgradeSDKKernelObject(r.original, r.held) != nil || upgradeSDKCohortHandleRights(r.held, r.rights, r.allowed) != nil {
+			return ErrUpgrade
+		}
+	}
+	for _, e := range []windows.Handle{ad.x.event, ad.x.supervisorEvent} {
+		s, err := windows.WaitForSingleObject(e, 0)
+		if err != nil || s != uint32(windows.WAIT_OBJECT_0) {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+// co.mu and the actual c.mu/control.mu/x.mu remain held by the sole finish
+// caller. This closes query custody only, preserving c.process/token/image and
+// candidate acceptance/provisional caps needed by later native rechecks.
+func (ad *nativeUpgradeSDKCohortAdoption) closeInitialQueries() error {
+	closeSlot := func(slot *windows.Handle) error {
+		return closeUpgradeSDKHandoffSlot(slot, windows.CloseHandle, func(h windows.Handle) { ad.unknownCloses = append(ad.unknownCloses, h) })
+	}
+	for _, r := range ad.returns {
+		if closeSlot(&r.held) != nil {
+			return ErrUpgrade
+		}
+	}
+	seen := map[*nativeUpgradeSDKCohortMember]struct{}{}
+	for _, m := range ad.co.members {
+		if _, exists := seen[m]; exists {
+			continue
+		}
+		seen[m] = struct{}{}
+		if m.observedToken != 0 {
+			t := windows.Handle(m.observedToken)
+			m.observedToken = 0
+			if closeSlot(&t) != nil {
+				return ErrUpgrade
+			}
+		}
+		if m.token != 0 {
+			t := windows.Handle(m.token)
+			m.token = 0
+			if closeSlot(&t) != nil {
+				return ErrUpgrade
+			}
+		}
+		if closeSlot(&m.process) != nil {
+			return ErrUpgrade
+		}
+	}
+	return closeSlot(&ad.co.job)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows_test.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..61609ecb6c877a0b6c7353942e241b3dc9b0397f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_handoff_windows_test.go
@@ -0,0 +1,68 @@
+//go:build windows
+
+package managementconfig
+
+import "testing"
+
+// Calls the actual posthandoff guard with inert data. An early atomic publish
+// is not admission, even if a fake close coordinator could return success.
+func TestUpgradeSDKHandoffNativeGuardRequiresActualBoundCompletion(t *testing.T) {
+	c := &nativeUpgradeSDKChild{}
+	x := &nativeUpgradeSDKCandidateTransfer{prepared: &nativeUpgradeSDKPreparation{child: c}, unknown: true}
+	co := &nativeUpgradeSDKCohort{birth: c}
+	c.cohort = co
+	ad := &nativeUpgradeSDKCohortAdoption{co: co, x: x, verified: true}
+	co.adoption = ad
+	a := &nativeUpgradeSDKCandidateAcceptance{transfer: x}
+	h := &nativeUpgradeSDKHandoff{acceptance: a, custody: ad}
+	c.handoff.Store(h)
+	if h.checkNative() == nil {
+		t.Fatal("published custody bypassed unstarted close")
+	}
+	_ = ad.close.run(func() error {
+		if h.checkNative() == nil {
+			t.Fatal("in-flight close admitted")
+		}
+		return ErrUpgrade
+	})
+	x.unknown = false
+	if h.checkNative() == nil {
+		t.Fatal("failed close admitted from published pointer")
+	}
+	ad.close = upgradeSDKHandoffClose{}
+	_ = ad.close.run(func() error { return nil }) // DATA success is not a native grant
+	for _, mutation := range []func(){func() { c.unknown = true }, func() { c.unknown = false; x.unknown = true }, func() { x.unknown = false; co.unknown = true }, func() { co.unknown = false; h.commit = nil }} {
+		mutation()
+		if h.checkNative() == nil {
+			t.Fatal("unknown or missing native owner admitted")
+		}
+	}
+}
+
+func TestUpgradeSDKHandoffHistoricalBindingCannotBecomeLiveJobReconciliation(t *testing.T) {
+	g := upgradeSDKCohortGeneration{12, 24}
+	c := &nativeUpgradeSDKChild{expected: UpgradeProcess{PID: 12, Creation: 24}}
+	x := &nativeUpgradeSDKCandidateTransfer{prepared: &nativeUpgradeSDKPreparation{child: c, grant: &nativeUpgradeSDKGrant{}}}
+	x.wire.Cohort = upgradeSDKOwnerCohortWire{Total: 1, Members: []upgradeSDKOwnerMemberWire{{PID: 12, Creation: 24}}}
+	m := &nativeUpgradeSDKCohortMember{generation: g}
+	co := &nativeUpgradeSDKCohort{birth: c, transfer: x, root: c.expected, members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{g: m}, partial: []*nativeUpgradeSDKCohortMember{m, m}}
+	if co.ledger.registerRoot(g) != nil || co.ledger.observe(1, 1) != nil {
+		t.Fatal("fixture")
+	}
+	// No native job/process handles exist: this function checks only immutable
+	// initial binding. It must not query current accounting or confer custody.
+	if co.recheckHistoricalTransfer(x) != nil {
+		t.Fatal("historical data requires current native snapshot")
+	}
+	if co.adoption != nil {
+		t.Fatal("data check manufactured custody")
+	}
+	foreign := &nativeUpgradeSDKCandidateTransfer{prepared: x.prepared, wire: x.wire}
+	if co.recheckHistoricalTransfer(foreign) == nil {
+		t.Fatal("copied transfer identity admitted")
+	}
+	co.partial = append(co.partial, &nativeUpgradeSDKCohortMember{generation: g})
+	if co.recheckHistoricalTransfer(x) == nil {
+		t.Fatal("unowned partial query output hidden by alias")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_test.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7d36920082928d431d905cae4c2153583aafc1e3
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_test.go
@@ -0,0 +1,73 @@
+package managementconfig
+
+import "testing"
+
+func TestUpgradeSDKCohortCountsCannotReplaceCapturedPositiveWaits(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	root := upgradeSDKCohortGeneration{1, 100}
+	child := upgradeSDKCohortGeneration{2, 200}
+	if l.observe(0, 0) != nil || l.registerRoot(root) != nil || l.observe(1, 1) != nil {
+		t.Fatal("initial native-root accounting")
+	}
+	if l.allCapturedSignaled() == nil {
+		t.Fatal("live captured root became stopped")
+	}
+	if l.observe(2, 0) != nil || l.joined(root) != nil || l.complete() == nil {
+		t.Fatal("active0 hid an uncaptured generation")
+	}
+	if l.capture(child) != nil || l.complete() != nil || l.allCapturedSignaled() == nil {
+		t.Fatal("capture alone granted terminal wait")
+	}
+	if l.joined(child) != nil || l.allCapturedSignaled() != nil {
+		t.Fatal("actual captured wait observations did not reconcile")
+	}
+	// Duplicate discovery never accounts for a missing native association.
+	if l.capture(child) != nil || l.observe(3, 0) != nil || l.complete() == nil {
+		t.Fatal("duplicate filled a cumulative count gap")
+	}
+}
+func TestUpgradeSDKCohortUnknownCounterAndGenerationNeverRecoverByMetadata(t *testing.T) {
+	for _, kind := range []string{"counter-backwards", "active-over-bound", "active-invalid", "live-pid-reuse", "unknown-wait"} {
+		t.Run(kind, func(t *testing.T) {
+			l := &upgradeSDKCohortLedger{}
+			g := upgradeSDKCohortGeneration{1, 100}
+			if l.observe(1, 1) != nil || l.registerRoot(g) != nil {
+				t.Fatal("setup")
+			}
+			var err error
+			switch kind {
+			case "counter-backwards":
+				err = l.observe(0, 0)
+			case "active-over-bound":
+				err = l.observe(upgradeSDKCohortBound+1, upgradeSDKCohortBound+1)
+			case "active-invalid":
+				err = l.observe(1, 2)
+			case "live-pid-reuse":
+				err = l.capture(upgradeSDKCohortGeneration{1, 200})
+			case "unknown-wait":
+				err = l.joined(upgradeSDKCohortGeneration{2, 200})
+			}
+			if err == nil || !l.unknown || l.observe(1, 0) == nil || l.complete() == nil {
+				t.Fatal("unknown accounting replayed into completion")
+			}
+		})
+	}
+}
+
+func TestUpgradeSDKCohortRequiresItsActualRegisteredRootBeforeWaitObservations(t *testing.T) {
+	l := &upgradeSDKCohortLedger{}
+	if l.observe(0, 0) != nil || l.complete() == nil || l.allCapturedSignaled() == nil {
+		t.Fatal("empty prebirth became positive wait observation")
+	}
+	other := upgradeSDKCohortGeneration{2, 200}
+	if l.capture(other) != nil || l.observe(1, 0) != nil || l.joined(other) != nil || l.allCapturedSignaled() == nil {
+		t.Fatal("foreign captured generation substituted for actual root")
+	}
+	root := upgradeSDKCohortGeneration{1, 100}
+	if l.registerRoot(root) != nil || l.observe(2, 0) != nil || l.allCapturedSignaled() == nil {
+		t.Fatal("root registration substituted for its positive wait")
+	}
+	if l.joined(root) != nil || l.allCapturedSignaled() != nil {
+		t.Fatal("actual registered root wait observations failed")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_transfer_test.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_transfer_test.go
new file mode 100644
