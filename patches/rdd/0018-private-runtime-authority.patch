+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimePublisherCannotBorrowModelJournalOrForeignStorage(t *testing.T) {
+	r, _ := upgradeImportedFixture(t) // Deliberately model-only, never a native sink.
+	n := &nativeRuntimeStorage{root: new(InstanceRoot)}
+	origin := &nativeRuntimeBuildOrigin{storage: n}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if publisher, err := newNativeUpgradeRuntimePublisher(ctx, n, origin, r); err == nil || publisher != nil {
+		t.Fatal("model journal minted a native publisher")
+	}
+	if publisher, err := newNativeUpgradeRuntimePublisher(ctx, &nativeRuntimeStorage{root: n.root}, origin, r); err == nil || publisher != nil {
+		t.Fatal("borrowed build origin admitted another storage owner")
+	}
+	if publisher, err := newNativeUpgradeRuntimePublisher(context.Background(), n, origin, r); err == nil || publisher != nil {
+		t.Fatal("unbounded operation admitted")
+	}
+	// None of these refusals invokes an OS provider, creates a native handle,
+	// changes the storage domain or installs a positive publication capability.
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk.go b/rdd/pkg/managementconfig/upgrade_sdk.go
new file mode 100644
index 0000000000000000000000000000000000000000..70945db21a988543150c4668441d61fe4a31e0ac
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk.go
@@ -0,0 +1,89 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+)
+
+// The same recorder's acknowledged journal may advance after the one-use SDK
+// transfer. Only activation fields may change from the cold-import receipt;
+// recovery, backward stages and any changed checkpoint/authority fact refuse.
+func upgradeSDKTransferredJournal(before, after upgradeJournal) bool {
+	if before.Stage != "data-imported" || !before.valid() || !after.valid() || before.Recovery.Schema != 0 || after.Recovery.Schema != 0 {
+		return false
+	}
+	switch after.Stage {
+	case "data-imported", "candidate-start-admitted", "candidate-validated", "runtime-publication-admitted", "committed":
+	default:
+		return false
+	}
+	after.Stage = before.Stage
+	after.SDKDigest = before.SDKDigest
+	after.CandidateWritesAdmitted = before.CandidateWritesAdmitted
+	after.Candidate = before.Candidate
+	after.ValidationDigest = before.ValidationDigest
+	after.RuntimeDigest = before.RuntimeDigest
+	after.RuntimeAdmission = before.RuntimeAdmission
+	want, e := upgradeJournalBytes(before)
+	got, f := upgradeJournalBytes(after)
+	return e == nil && f == nil && bytes.Equal(want, got)
+}
+
+func upgradeSDKTransferredProgress(sequence uint32, stage string, recordDigest, sdkDigest [32]byte, next upgradeRecord, nextDigest [32]byte) bool {
+	priorRank, known := upgradeRank[stage]
+	nextRank, valid := upgradeRank[next.Journal.Stage]
+	return known && valid && next.Sequence >= sequence && nextRank >= priorRank && (next.Sequence != sequence || nextDigest == recordDigest) && (sdkDigest == [32]byte{} || next.Journal.SDKDigest == sdkDigest)
+}
+
+// Only a retained native SDK owner can implement this package-private gate.
+// A preservation receipt, absence probe, historical removal receipt or expired/
+// opaque signer review cannot admit a publisher. The owner must retain the
+// original compatible controller lock, actual retired generations and ingress
+// exclusion, and the new private state/semantic admission through final commit.
+// There is deliberately no public constructor or production issuer yet.
+type upgradeSDKOwner interface {
+	admitUpgradeSDK(context.Context, upgradeJournal) ([32]byte, error)
+	checkUpgradeSDK(context.Context, upgradeJournal) error
+	finalizeUpgradeSDK(context.Context, *upgradeSDKCommit) error
+}
+
+// This capability exists only after this recorder positively acknowledged the
+// exact durable committed record. The record/digest are correlation; the native
+// issuer must additionally retain this recorder's actual private store owner.
+type upgradeSDKCommit struct {
+	recorder *upgradeRecorder
+	record   upgradeRecord
+	digest   [32]byte
+}
+
+func (r *upgradeRecorder) sdkCommit() (*upgradeSDKCommit, error) {
+	if r == nil {
+		return nil, ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.uncertain || r.last.Journal.Stage != "committed" || r.last.Journal.Recovery.Schema != 0 || r.last.Journal.SDKDigest == [32]byte{} {
+		return nil, ErrUpgrade
+	}
+	data, err := upgradeRecordBytes(r.last)
+	if err != nil || sha256.Sum256(data) != r.digest {
+		return nil, ErrUpgrade
+	}
+	return &upgradeSDKCommit{r, r.last, r.digest}, nil
+}
+func (c *upgradeSDKCommit) check() error {
+	if c == nil || c.recorder == nil {
+		return ErrUpgrade
+	}
+	latest, err := c.recorder.sdkCommit()
+	if err != nil || latest.digest != c.digest {
+		return ErrUpgrade
+	}
+	want, e := upgradeRecordBytes(c.record)
+	got, f := upgradeRecordBytes(latest.record)
+	if e != nil || f != nil || !bytes.Equal(want, got) {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_acceptance_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_acceptance_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..54c559da0d1707bd0a1dd9475685619e3f7b012e
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_acceptance_windows.go
@@ -0,0 +1,140 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"time"
+	"unsafe"
+)
+
+// This records only the serving candidate's positive retention of the original
+// SDK job/control objects. It does not authorize temporary-owner release: the
+// SDK must separately accept its logical supervisor and retain its controller.
+// The committed record selects a target, while this actual native process,
+// token, mapped image and original inherited event establish the acceptance.
+type nativeUpgradeSDKCandidateAcceptance struct {
+	transfer       *nativeUpgradeSDKCandidateTransfer
+	process, image windows.Handle
+	token          windows.Token
+	tokenID        windows.LUID
+	expected       UpgradeProcess
+	binding        upgradeObservedImageBinding
+	accepted       bool
+}
+
+func (x *nativeUpgradeSDKCandidateTransfer) observeNativeAcceptance(ctx context.Context, commit *upgradeSDKCommit) error {
+	if x == nil || ctx == nil || ctx.Err() != nil || commit == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	if !x.started || !x.unknown || x.prepared == nil || x.event == 0 || commit.recorder != x.management.recorder || commit.check() != nil {
+		return ErrUpgrade
+	}
+	j := commit.record.Journal
+	if j.Transaction != x.wire.Transaction || j.SDKDigest != x.wire.SDKDigest || j.Candidate.Image != x.wire.Parent.Image || j.Candidate.PID == x.wire.Parent.PID || j.Candidate.Creation <= x.wire.SDK.Creation || j.Candidate.Session != x.wire.Parent.Session {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != x.prepared.grant.wire.Scope.SID {
+		return ErrUpgrade
+	}
+	code := x.prepared.authority.image
+	if code == nil {
+		return ErrUpgrade
+	}
+	code.mu.Lock()
+	defer code.mu.Unlock()
+	if checkSDKFinalImage(code, sid) != nil || len(code.chain) < 2 {
+		return ErrUpgrade
+	}
+	if x.acceptance == nil {
+		a := &nativeUpgradeSDKCandidateAcceptance{transfer: x, expected: j.Candidate}
+		x.acceptance = a // one capture, retaining every partial native return
+		a.process, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, a.expected.PID)
+		if err != nil || windows.OpenProcessToken(a.process, windows.TOKEN_QUERY, &a.token) != nil {
+			return ErrUpgrade
+		}
+		a.tokenID, err = legacySDKTokenID(a.token)
+		if err != nil {
+			return ErrUpgrade
+		}
+		a.image, err = openUpgradeObservedImageFile(code.chain[len(code.chain)-2], "rdd.exe")
+		if err != nil {
+			return ErrUpgrade
+		}
+		id, idErr := upgradeObjectID(a.image)
+		original, originalErr := upgradeObjectID(code.chain[len(code.chain)-1])
+		if idErr != nil || originalErr != nil || id != original || a.binding.capture(a.process, a.image) != nil {
+			return ErrUpgrade
+		}
+	}
+	a := x.acceptance
+	if a.expected != j.Candidate || a.checkNative(ctx, sid) != nil {
+		return ErrUpgrade
+	}
+	// A local cap applies even to a much longer owner context. Wait on the same
+	// retained candidate and SDK roots as well as the original acceptance event;
+	// an exited root is not mistaken for a lost/late acknowledgement.
+	until := time.Now().Add(10 * time.Second)
+	for {
+		if ctx.Err() != nil || time.Now().After(until) {
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForMultipleObjects([]windows.Handle{x.event, a.process, x.prepared.child.process}, false, 20)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_TIMEOUT) {
+			continue
+		}
+		if state != uint32(windows.WAIT_OBJECT_0) || a.checkNative(ctx, sid) != nil || x.prepared.child.recheckIngressBirth(ctx) != nil || checkSDKFinalImage(code, sid) != nil || commit.check() != nil {
+			return ErrUpgrade
+		}
+		a.accepted = true
+		return nil
+	}
+}
+
+// x.mu protects this object. Original OS parent and original control-pipe
+// creator remain TEMP; duplicated control does not change either kernel fact.
+func (a *nativeUpgradeSDKCandidateAcceptance) checkNative(ctx context.Context, sid string) error {
+	if a == nil || a.transfer == nil || ctx.Err() != nil || a.process == 0 || a.image == 0 || a.token == 0 || !a.expected.valid() {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(a.process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || a.binding.same() != nil || legacySDKOrdinaryToken(a.token, sid, a.expected.Session) != nil {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(a.token)
+	if err != nil || id != a.tokenID {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.GetProcessTimes(a.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != a.expected.Creation || windows.NtQueryInformationProcess(a.process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || uint32(basic.UniqueProcessId) != a.expected.PID || uint32(basic.InheritedFromUniqueProcessId) != a.transfer.wire.Parent.PID {
+		return ErrUpgrade
+	}
+	if a.transfer.prepared.child.job == 0 {
+		handoff := a.transfer.prepared.child.handoff.Load()
+		if handoff == nil || handoff.acceptance != a {
+			return ErrUpgrade
+		}
+		return nil
+	}
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(a.process), uintptr(a.transfer.prepared.child.job), uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
