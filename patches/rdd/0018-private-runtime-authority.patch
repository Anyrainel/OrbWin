+//go:build windows
+
+package managementconfig
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestUpgradeDirectoryBufferMeetsNativeAlignmentWithoutAPI(t *testing.T) {
+	for _, size := range []int{2048, 64 << 10} {
+		backing, buffer, err := managementDirectoryBuffer(size)
+		if err != nil || len(buffer) != size || len(backing) != size/8 || uintptr(unsafe.Pointer(&buffer[0]))%8 != 0 || unsafe.Pointer(&buffer[0]) != unsafe.Pointer(&backing[0]) {
+			t.Fatal("unaligned or detached directory ABI buffer", size)
+		}
+		buffer[0] = 1
+		if *(*byte)(unsafe.Pointer(&backing[0])) != 1 {
+			t.Fatal("directory buffer lost typed backing")
+		}
+	}
+	for _, size := range []int{0, 1, 7, 9, 65537} {
+		if _, _, err := managementDirectoryBuffer(size); err == nil {
+			t.Fatal("invalid native buffer size accepted")
+		}
+	}
+}
