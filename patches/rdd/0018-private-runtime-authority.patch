new file mode 100644
index 0000000000000000000000000000000000000000..37dd8200153806822d1f86cd4cf722bec9f8de1a
--- /dev/null
+++ b/rdd/pkg/binlinks/private_cache.go
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+package binlinks
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// Set by the product build from the independently compiled upstream forwarder.
+// An absent/invalid pin refuses publication; there is no hardlink fallback.
+var expectedForwarderSHA256 string
+var errPrivateForwarder = errors.New("private command forwarder unavailable")
+
+func forwarderDigest(text string) ([32]byte, error) {
+	var digest [32]byte
+	bytes, err := hex.DecodeString(text)
+	if err != nil || len(bytes) != len(digest) || hex.EncodeToString(bytes) != text {
+		return digest, errPrivateForwarder
+	}
+	copy(digest[:], bytes)
+	if digest == [32]byte{} {
+		return digest, errPrivateForwarder
+	}
+	return digest, nil
+}
+
+// The caller retains an authenticated source lease through this operation.
+// Publish only the two multicall entries; unrelated standalone tools survive.
+func publishPrivateSelf(execPath, binDir string, expected [32]byte) error {
+	source := filepath.Join(filepath.Dir(execPath), forwarderName)
+	file, err := os.Open(source)
+	if err != nil {
+		return errPrivateForwarder
+	}
+	bytes, readErr := io.ReadAll(io.LimitReader(file, (4<<20)+1))
+	closeErr := file.Close()
+	if readErr != nil || closeErr != nil || len(bytes) == 0 || len(bytes) > 4<<20 || sha256.Sum256(bytes) != expected {
+		return errPrivateForwarder
+	}
+	if err := os.MkdirAll(binDir, 0755); err != nil {
+		return errPrivateForwarder
+	}
+	master := filepath.Join(binDir, forwarderName)
+	if err := ensureForwarderCopy(source, master); err != nil {
+		return errPrivateForwarder
+	}
+	for _, name := range []string{"rdd.exe", "kubectl.exe"} {
+		if err := os.WriteFile(shimPath(binDir, name), shimContent(execPath), 0644); err != nil {
+			return errPrivateForwarder
+		}
+		if err := ensureForwarderLink(master, filepath.Join(binDir, name)); err != nil {
+			return errPrivateForwarder
+		}
+	}
+	return nil
+}
