+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"testing"
+	"time"
+)
+
+type fakeUpgradeOldOwner struct {
+	validation upgradeOldValidation
+	calls      int
+	change     bool
+}
+
+func (o *fakeUpgradeOldOwner) observeUpgradeOld(context.Context, upgradeJournal) (upgradeOldValidation, error) {
+	o.calls++
+	v := o.validation
+	if o.change && o.calls > 1 {
+		v.Process.Creation++
+	}
+	return v, nil
+}
+
+type fakeUpgradeRecoveryOps struct {
+	r                                              *upgradeRecorder
+	old                                            *fakeUpgradeOldOwner
+	restoreCalls, launchCalls, publishCalls        int
+	failRestore, failLaunch, failPublish, mismatch bool
+}
+
+func (o *fakeUpgradeRecoveryOps) restoreUpgradeCheckpoint(_ context.Context, c *upgradeRollbackCapability, _ *upgradeRecorder) (UpgradeObject, error) {
+	o.restoreCalls++
+	if o.failRestore || o.r.last.Journal.Recovery.Stage != "rollback-admitted" {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	return c.journal.OldRoot, nil
+}
+func (o *fakeUpgradeRecoveryOps) launchUpgradeOld(context.Context, upgradeJournal) (upgradeOldOwner, error) {
+	o.launchCalls++
+	if o.failLaunch || o.r.last.Journal.Recovery.Stage != "old-start-admitted" {
+		return o.old, ErrUpgrade
+	}
+	return o.old, nil
+}
+func (o *fakeUpgradeRecoveryOps) publishUpgradeOldRuntime(_ context.Context, j upgradeJournal, v upgradeOldValidation) ([32]byte, error) {
+	o.publishCalls++
+	if o.failPublish || j.Recovery.Stage != "old-runtime-publication-admitted" || !v.valid(j) {
+		return [32]byte{}, ErrUpgrade
+	}
+	return [32]byte{99}, nil
+}
+func (o *fakeUpgradeRecoveryOps) observeUpgradeOldRuntime(context.Context, upgradeJournal) ([32]byte, error) {
+	if o.mismatch {
+		return [32]byte{98}, nil
+	}
+	return [32]byte{99}, nil
+}
+
+func upgradeRecoveryFixture(t *testing.T) (*upgradeRecoveryOwner, *fakeUpgradeRecoveryOps, *fakeUpgradeSink) {
+	t.Helper()
+	r, sink := upgradeImportedFixture(t)
+	imported := r.last.Journal
+	imported.SDKDigest = [32]byte{72}
+	j, err := advanceUpgrade(imported, "candidate-start-admitted")
+	if err != nil || r.append(context.Background(), j) != nil {
+		t.Fatal(err)
+	}
+	data, _ := upgradeJournalBytes(j)
+	decision := upgradeRollbackDecision{Transaction: j.Transaction, Scope: "restore-retained-checkpoint-and-accept-post-checkpoint-control-loss", Journal: sha256.Sum256(data), Checkpoint: j.NormalizedHash}
+	evidence := upgradeRollbackEvidence{OldRuntime: j.OldRuntime, OldRoot: j.OldRoot, BackupRoot: j.BackupRoot, Registration: j.Registration, Daemon: j.Daemon, CandidateRetirement: [32]byte{1}, OldBinaryLease: [32]byte{2}, BackupVerification: [32]byte{3}, RegistrationBasePath: [32]byte{4}, CompatibleDiskFormats: [32]byte{5}, OldLaunchRecipe: [32]byte{6}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	cap, err := authorizeUpgradeRollback(ctx, j, decision, fakeUpgradeRollbackObserver{evidence})
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := &fakeUpgradeOldOwner{validation: upgradeOldValidation{Process: UpgradeProcess{222, 333, j.OldService.Session, j.OldRuntime}, Daemon: j.Daemon, Registration: j.Registration, ClusterVersion: j.ClusterVersion, DesiredRunning: j.DesiredRunning, Publication: [32]byte{1}, Authentication: [32]byte{2}, RegistrationBasePath: [32]byte{3}, DockerInventory: [32]byte{4}, PersistentState: [32]byte{5}, GuestState: [32]byte{6}, ClusterState: [32]byte{7}}}
+	ops := &fakeUpgradeRecoveryOps{r: r, old: old}
+	owner, err := newUpgradeRecoveryOwner(cap, r, ops)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return owner, ops, sink
+}
+
+func TestUpgradeRecoveryPreservesForwardCutoffAndObservedOldOwner(t *testing.T) {
+	o, ops, sink := upgradeRecoveryFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if o.recover(ctx) != nil || !o.complete || o.unknown || ops.restoreCalls != 1 || ops.launchCalls != 1 || ops.publishCalls != 1 {
+		t.Fatal("unproven recovery")
+	}
+	j := o.recorder.last.Journal
+	if j.Recovery.Stage != "rolled-back" || j.Stage != "candidate-start-admitted" || !j.CandidateWritesAdmitted || j.Recovery.Restored != j.OldRoot || j.Recovery.OldCandidate.Image != j.OldRuntime {
+		t.Fatal("recovery erased write cutoff or old identity")
+	}
+	if _, err := newUpgradeRecorder(sink, sink.records); err != nil {
+		t.Fatal("recovery chain invalid", err)
+	}
+	if o.recover(ctx) == nil || ops.restoreCalls != 1 || ops.launchCalls != 1 {
+		t.Fatal("recovery replayed")
+	}
+	bad := j
+	bad.CandidateWritesAdmitted = false
+	if upgradeRecordFollows(j, bad) {
+		t.Fatal("recovery cleared forward-write cutoff")
+	}
+	if _, err := authorizeUpgradeRollback(ctx, j, o.capability.decision, o.capability.observer); err == nil {
+		t.Fatal("second rollback transaction adopted already-recovering state")
+	}
+}
+
+func TestUpgradeRecoveryFaultsNeverReplayRestoreLaunchOrPublish(t *testing.T) {
+	for _, kind := range []string{"admission", "restore", "restored-reply", "start-admission", "launch", "validation", "runtime-admission", "publish", "readback", "generation", "commit-reply"} {
+		t.Run(kind, func(t *testing.T) {
+			o, ops, sink := upgradeRecoveryFixture(t)
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			switch kind {
+			case "admission":
+				sink.failAt = sink.writes + 1
+			case "restore":
+				ops.failRestore = true
+			case "restored-reply":
+				sink.failAt = sink.writes + 2
+			case "start-admission":
+				sink.failAt = sink.writes + 3
+			case "launch":
+				ops.failLaunch = true
+			case "validation":
+				ops.old.validation.PersistentState = [32]byte{}
+			case "runtime-admission":
+				sink.failAt = sink.writes + 5
+			case "publish":
+				ops.failPublish = true
+			case "readback":
+				ops.mismatch = true
+			case "generation":
+				ops.old.change = true
+			case "commit-reply":
+				sink.failAt = sink.writes + 6
+			}
+			if o.recover(ctx) == nil || !o.unknown || o.complete {
+				t.Fatal("partial rollback acknowledged")
+			}
+			restored, launched, published, writes := ops.restoreCalls, ops.launchCalls, ops.publishCalls, sink.writes
+			if o.recover(ctx) == nil || restored != ops.restoreCalls || launched != ops.launchCalls || published != ops.publishCalls || writes != sink.writes {
+				t.Fatal("unknown recovery replayed")
+			}
+			if kind == "admission" && restored != 0 {
+				t.Fatal("restore before durable admission")
+			}
+			if (kind == "restored-reply" || kind == "start-admission") && launched != 0 {
+				t.Fatal("old launch before acknowledged restore/start admission")
+			}
+			if launched > 0 && o.old != ops.old {
+				t.Fatal("lost unknown old-owner generation")
+			}
+			if kind == "runtime-admission" && published != 0 {
+				t.Fatal("old runtime published before admission")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_restore_windows.go b/rdd/pkg/managementconfig/upgrade_restore_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..024e07b7251d758371cf01a3eee4ad4b70129733
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_restore_windows.go
@@ -0,0 +1,186 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"golang.org/x/sys/windows"
+	"unsafe"
+)
+
+// Original data never leaves its root and is never used for SQLite recovery.
+// Recovery verifies every original byte against the complete child-copy receipt
+// and the distinct sealed backup. No write-back/overlay is needed or permitted.
+// The ordinary-start denial remains present until durable old-start admission.
+func (t *upgradeColdTree) restoreUpgradeCheckpoint(ctx context.Context, cap *upgradeRollbackCapability, r *upgradeRecorder) (UpgradeObject, error) {
+	if t == nil || cap == nil || r == nil || ctx == nil || ctx.Err() != nil || cap.recheck(ctx) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup || t.restoreAttempted || t.originals == nil || cap.journal.OldRoot != t.inventory.root || !upgradeIntentEqual(cap.journal, t.retirement.journal) || t.captureRecorder != r {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	r.mu.Lock()
+	j := r.last.Journal
+	uncertain := r.uncertain
+	native := r.sink == t.captureStore
+	r.mu.Unlock()
+	if uncertain || !native || j.Recovery.Stage != "rollback-admitted" || j.Recovery.Original != cap.decision.Journal {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	base := j
+	base.Recovery = upgradeRecovery{}
+	current, err := upgradeJournalBytes(base)
+	expected, other := upgradeJournalBytes(cap.journal)
+	if err != nil || other != nil || !bytes.Equal(current, expected) {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	t.restoreAttempted = true
+	t.uncertain = true
+	if t.verifyOriginalNamespace(ctx) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	rootID, err := upgradeObjectID(t.originals["root"])
+	backupID, other := upgradeObjectID(t.handles["root"])
+	if err != nil || other != nil || rootID != j.OldRoot || backupID != j.BackupRoot || rootID == backupID {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	for _, item := range j.Capture {
+		source := t.originals[item.Role]
+		target := t.handles[item.Role]
+		sid, e := upgradeObjectID(source)
+		tid, e2 := upgradeObjectID(target)
+		if e != nil || e2 != nil || sid != item.Source || tid != item.Target || objectKind(source, item.Directory) != nil || verifyPrivate(target, t.sid, item.Directory) != nil {
+			return UpgradeObject{}, ErrUpgrade
+		}
+		if !item.Directory {
+			size, e := upgradeHandleSize(source)
+			otherSize, e2 := upgradeHandleSize(target)
+			if e != nil || e2 != nil || size != item.Size || otherSize != item.Size {
+				return UpgradeObject{}, ErrUpgrade
+			}
+			sh, e := hashUpgradeCapture(ctx, source, item.Size)
+			th, e2 := hashUpgradeCapture(ctx, target, item.Size)
+			if e != nil || e2 != nil || sh != item.Hash || th != item.Hash {
+				return UpgradeObject{}, ErrUpgrade
+			}
+		}
+	}
+	if cap.recheck(ctx) != nil {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	t.restored = true
+	t.uncertain = false
+	return rootID, nil
+}
+
+func (t *upgradeColdTree) releaseRestored(ctx context.Context, j upgradeJournal, r *upgradeRecorder) error {
+	if t == nil || r == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || r != t.captureRecorder || !t.restored || !t.restoreAttempted || t.restoreReleased || j.Recovery.Stage != "old-start-admitted" || j.Recovery.Restored != t.inventory.root {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	actual := r.last.Journal
+	uncertain := r.uncertain
+	native := r.sink == t.captureStore
+	r.mu.Unlock()
+	data, err := upgradeJournalBytes(j)
+	got, other := upgradeJournalBytes(actual)
+	if uncertain || !native || err != nil || other != nil || !bytes.Equal(data, got) {
+		return ErrUpgrade
+	}
+	// Latch before the first intentional fence-removal syscall. Failure is
+	// inspection-only and never opens a retry path for deletion or old launch.
+	t.restoreReleased = true
+	t.uncertain = true
+	if t.verifyOriginalNamespace(ctx) != nil {
+		return ErrUpgrade
+	}
+	for i := len(t.observations) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.observations[i]) != nil {
+			return ErrUpgrade
+		}
+		t.observations[i] = 0
+	}
+	remove := uint32(1)
+	if windows.SetFileInformationByHandle(t.denialReceipt, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4) != nil || windows.CloseHandle(t.denialReceipt) != nil {
+		return ErrUpgrade
+	}
+	t.denialReceipt = 0
+	if windows.SetFileInformationByHandle(t.denialDirectory, windows.FileDispositionInfo, (*byte)(unsafe.Pointer(&remove)), 4) != nil || windows.CloseHandle(t.denialDirectory) != nil {
+		return ErrUpgrade
+	}
+	t.denialDirectory = 0
+	if pid := t.originals["pid"]; pid != 0 {
+		if renameUpgradeChild(pid, t.originals["root"], "rdd.pid") != nil {
+			return ErrUpgrade
+		}
+	}
+	if windows.FlushFileBuffers(t.originals["root"]) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	for i := len(t.order) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.handles[t.order[i]]) != nil {
+			return ErrUpgrade
+		}
+		t.handles[t.order[i]] = 0
+	}
+	for i := len(t.originalOrder) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.originals[t.originalOrder[i]]) != nil {
+			return ErrUpgrade
+		}
+		t.originals[t.originalOrder[i]] = 0
+	}
+	// The ancestor chain stays held through independent old-owner validation.
+	t.order = nil
+	t.originalOrder = nil
+	t.observations = nil
+	t.backup = false
+	t.uncertain = false
+	return nil
+}
+
+type upgradeOldLauncher interface {
+	launchUpgradeOld(context.Context, upgradeJournal) (upgradeOldOwner, error)
+}
+type upgradeOldRuntimePublisher interface {
+	publishUpgradeOldRuntime(context.Context, upgradeJournal, upgradeOldValidation) ([32]byte, error)
+	observeUpgradeOldRuntime(context.Context, upgradeJournal) ([32]byte, error)
+}
+type nativeUpgradeRecoveryOps struct {
+	tree      *upgradeColdTree
+	recorder  *upgradeRecorder
+	launcher  upgradeOldLauncher
+	publisher upgradeOldRuntimePublisher
+}
+
+func newNativeUpgradeRecoveryOps(tree *upgradeColdTree, r *upgradeRecorder, l upgradeOldLauncher, p upgradeOldRuntimePublisher) (*nativeUpgradeRecoveryOps, error) {
+	if tree == nil || r == nil || l == nil || p == nil {
+		return nil, ErrUpgrade
+	}
+	return &nativeUpgradeRecoveryOps{tree, r, l, p}, nil
+}
+func (o *nativeUpgradeRecoveryOps) restoreUpgradeCheckpoint(ctx context.Context, cap *upgradeRollbackCapability, r *upgradeRecorder) (UpgradeObject, error) {
+	if r != o.recorder {
+		return UpgradeObject{}, ErrUpgrade
+	}
+	return o.tree.restoreUpgradeCheckpoint(ctx, cap, r)
+}
+func (o *nativeUpgradeRecoveryOps) launchUpgradeOld(ctx context.Context, j upgradeJournal) (upgradeOldOwner, error) {
+	if o.tree.releaseRestored(ctx, j, o.recorder) != nil {
+		return nil, ErrUpgrade
+	}
+	return o.launcher.launchUpgradeOld(ctx, j)
+}
+func (o *nativeUpgradeRecoveryOps) publishUpgradeOldRuntime(ctx context.Context, j upgradeJournal, v upgradeOldValidation) ([32]byte, error) {
+	return o.publisher.publishUpgradeOldRuntime(ctx, j, v)
+}
+func (o *nativeUpgradeRecoveryOps) observeUpgradeOldRuntime(ctx context.Context, j upgradeJournal) ([32]byte, error) {
+	return o.publisher.observeUpgradeOldRuntime(ctx, j)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_retirement_windows.go b/rdd/pkg/managementconfig/upgrade_retirement_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..386030e3b8ae296ed91b45c19fa70dfee2a44b46
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_retirement_windows.go
@@ -0,0 +1,132 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"sync"
+)
+
+// A provider must retain the actual admission/publication owner, including the
+// SDK/native pipe publishers and local-services cleanup ledger, until release.
+// No production provider is wired yet: file absence, mutable PID files and a
+// caller boolean deliberately cannot satisfy this contract.
+type upgradeIngressRetirement interface {
+	recheckUpgradeIngress(context.Context, upgradeJournal) ([32]byte, error)
+}
+
+type upgradeRetirement struct {
+	mu        sync.Mutex
+	family    *upgradeProcessFamily
+	ingress   upgradeIngressRetirement
+	root      *InstanceRoot
+	journal   upgradeJournal
+	endpoints []upgradeTCPRow
+	digest    [32]byte
+	retained  *upgradeWSLCommandResource
+}
+
+// Construction only observes retirement; it never asks legacy Stop to trust a
+// PID file, kills a process, terminates WSL or changes a publication. The future
+// attended owner must perform those actions against independently held identity.
+func observeUpgradeRetirement(ctx context.Context, family *upgradeProcessFamily, ingress upgradeIngressRetirement, root *InstanceRoot, journal upgradeJournal, endpoints []upgradeTCPRow) (*upgradeRetirement, error) {
+	if family == nil || ingress == nil || root == nil || !journal.valid() || journal.Stage != "interruption-admitted" && journal.Stage != "retirement-unknown" || len(endpoints) > 128 {
+		return nil, ErrUpgrade
+	}
+	family.mu.Lock()
+	matching := !family.closed && len(family.expected) == 1+len(journal.Hostagents) && family.expected[journal.OldService.PID] == journal.OldService
+	for _, p := range journal.Hostagents {
+		matching = matching && family.expected[p.PID] == p
+	}
+	family.mu.Unlock()
+	if !matching {
+		return nil, ErrUpgrade
+	}
+	data, err := upgradeJournalBytes(journal)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	journal, err = parseUpgradeJournal(data)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	for _, endpoint := range endpoints {
+		if endpoint.port == 0 || endpoint.family != 4 && endpoint.family != 6 || family.expected[endpoint.pid].PID == 0 {
+			return nil, ErrUpgrade
+		}
+	}
+	r := &upgradeRetirement{family: family, ingress: ingress, root: root, journal: journal, endpoints: append([]upgradeTCPRow(nil), endpoints...)}
+	if r.recheck(ctx) != nil {
+		return r, ErrUpgrade
+	}
+	return r, nil
+}
+
+func (r *upgradeRetirement) recheck(ctx context.Context) error {
+	if r == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.retained != nil {
+		return ErrUpgrade
+	}
+	exited, err := r.family.retired(ctx)
+	if err != nil || !exited {
+		return ErrUpgrade
+	}
+	publication, err := r.ingress.recheckUpgradeIngress(ctx, r.journal)
+	if err != nil || publication == [32]byte{} {
+		return ErrUpgrade
+	}
+	for _, family := range []uint8{4, 6} {
+		rows, err := observeUpgradeTCPTable(ctx, family)
+		if err != nil {
+			return ErrUpgrade
+		}
+		for _, row := range rows {
+			// Reject an old PID even after process exit and reject replacement
+			// publication of a prepared address/port by any process generation.
+			if r.family.expected[row.pid].PID != 0 {
+				return ErrUpgrade
+			}
+			for _, old := range r.endpoints {
+				if row.family == old.family && row.address == old.address && row.scope == old.scope && row.port == old.port {
+					return ErrUpgrade
+				}
+			}
+		}
+	}
+	wsl, retained, err := observeUpgradeWSLStopped(ctx, r.root, r.journal.Registration)
+	r.retained = retained
+	if err != nil || retained != nil || wsl == nil {
+		return ErrUpgrade
+	}
+	// Recheck the admission owner and exact held process objects after the WSL
+	// child; they cannot be inferred from that child's successful exit.
+	second, err := r.ingress.recheckUpgradeIngress(ctx, r.journal)
+	exited, processErr := r.family.retired(ctx)
+	if err != nil || second != publication || processErr != nil || !exited || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	data, err := json.Marshal(struct {
+		Main             UpgradeProcess
+		Hostagents       []UpgradeProcess
+		Root             UpgradeObject
+		Publication, WSL [32]byte
+	}{r.journal.OldService, r.journal.Hostagents, r.journal.OldRoot, publication, wsl.digest})
+	if err != nil {
+		return ErrUpgrade
+	}
+	digest := sha256.Sum256(data)
+	if r.digest != [32]byte{} && r.digest != digest {
+		return ErrUpgrade
+	}
+	r.digest = digest
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_build_origin.go b/rdd/pkg/managementconfig/upgrade_runtime_build_origin.go
new file mode 100644
index 0000000000000000000000000000000000000000..75f555432a8f8e3f8abb17387b06d268c653bc59
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_build_origin.go
@@ -0,0 +1,49 @@
+package managementconfig
+
+type runtimeBuildOriginStep uint8
+
+// A positive source-lease close is a known refusal to use its provenance. An
+// actual failed close is resource uncertainty and must retain the independent
+// duplicate graph, original source lease and storage owner before refusing.
+func runtimeBuildSourceLeaseState(closed bool, closeErr error, fence func()) error {
+	if closeErr != nil {
+		fence()
+		return ErrUpgrade
+	}
+	if closed {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+const (
+	runtimeBuildDuplicateLease runtimeBuildOriginStep = iota
+	runtimeBuildHoldSelfProcess
+	runtimeBuildOpenSelfImage
+	runtimeBuildCaptureMapping
+	runtimeBuildCaptureCommit
+	runtimeBuildVerify
+)
+
+// Actual native construction calls this order. A commit string can be captured
+// only after independently pinned bytes and the mapped current process agree.
+func runtimeBuildOriginSequence(call func(runtimeBuildOriginStep) error) error {
+	if call == nil {
+		return ErrUpgrade
+	}
+	for _, step := range []runtimeBuildOriginStep{runtimeBuildDuplicateLease, runtimeBuildHoldSelfProcess, runtimeBuildOpenSelfImage, runtimeBuildCaptureMapping, runtimeBuildCaptureCommit, runtimeBuildVerify} {
+		if err := call(step); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Used by the real native owner. Never continue through a failed close and
+// never retry a cached failed/panicked graph release. Storage's controller is
+// deliberately outside this graph and stays held until its own later seal.
+func runtimeBuildOriginRelease(attempt *runtimeStorageCloseAttempt, count int, closeOne func(int) error, fence func()) error {
+	return attempt.run(func() error {
+		return runtimeStorageCloseSequence(count, -1, closeOne)
+	}, fence)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_build_origin.md b/rdd/pkg/managementconfig/upgrade_runtime_build_origin.md
new file mode 100644
index 0000000000000000000000000000000000000000..6b465edbe92c5293483c0a5ea5794ea8a1d5cdfc
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_build_origin.md
@@ -0,0 +1,17 @@
+# Incoming mapped-self build origin
+
+Source/build only, 2026-10-26. No native constructor, product namespace, candidate or publisher execution was performed for this component.
+
+The build chain already links `pkg/version.GitCommit` from the exact `upstream.lock.json` captured by `scripts/build-backend.mjs`. The script checks those lock bytes again before publishing its manifest. Rust `runtime::validate_backend_manifest` compares the manifest commit with its compiled upstream lock, and `runtime::backend` verifies the independently pinned executable and native private cache. The upstream `rdd version` command prints only the human version; its output is not the commit issuer. A mutable adjacent manifest or old `runtime.json` cannot supply incoming provenance.
+
+The executing process's linked commit is useful only when that executing process is the independently pinned incoming image. `captureRuntimeBuildOrigin(ctx, storage, lease, journal)` requires the actual native storage owner/root and actual serving lease, then duplicates the real lease FILE_OBJECT graph under its lock. These are independent native ownership references with the original no-write/no-delete sharing; retaining a Go pointer alone would not suffice. It hashes the duplicated read cap against the independently admitted incoming digest, retains an actual current-process QUERY/SYNCHRONIZE handle by duplicating the native current-process pseudo-handle, and opens the fixed `rdd.exe` observation cap through the actual duplicated parent. Native ID/SD/body identity must match the leased image. `upgradeObservedImageBinding.capture` establishes live class44 mapping and the actual generation before the lower-case, nonzero, 40-digit linked commit is captured. Another process's old linked commit cannot label an arbitrary held new image.
+
+The owner rechecks the actual storage/root/token, original lease closed state and image identity, duplicated graph identities/descriptors, actual current process generation, class44 mapping and unchanged linked commit. `sourceCommit(ctx,journal)` returns checked compatibility DATA. It is not a publisher or a replacement for actual candidate observation, durable runtime admission or SDK custody.
+
+Lock order is candidate.operation (the future binder) → origin.mu → storage.mu → lease.mu. `checkHeld` requires the caller to hold ONLY origin.mu; it acquires/releases storage and lease mutexes internally. The publisher keeps origin.mu through subsequent actual storage operations, which acquire storage.mu themselves. `checkNativeHeld` is the construction/all-three-locks form. No method calls back into candidate.operation. No generic callback grant API was added.
+
+Every returned native output is observed before error handling. Partial nonzero HANDLE outputs are retained before global fencing; they never mean absence. Per-handle and graph closes are cached, stop on the first unknown result and never retry. Panic retains the actual remaining origin, storage and lease graph. The origin fence touches the short global storage-domain fence, never storage.unknown outside its mutex. Root must close this graph before storage's controller-last seal. This owner never calls `ServingImageLease.Close`; its dedicated duplicates therefore do not inherit that method's existing continue-after-error behavior. If the original owner has already observed a source-lease close error, construction/check/release all fence and retain the duplicate graph, original lease and storage rather than treating that error as an ordinary refusal. A known successful original close refuses further provenance use but permits checked release of the independent duplicates. The original lease remains its original owner's responsibility; that pre-existing closure limitation is not claimed fixed here.
+
+Pure tests exercise the exact constructor sequence used by native code and its refusal boundaries, including mapped-image prerequisites before provenance capture. The actual graph release uses the tested stop-first/cached success/error/panic helper, plus the existing partial-output and per-handle close helpers. These establish source ordering, not observed Windows mapping/close behavior or a positive publisher.
+
+The current setup integration is still a distinct gate. Rust `operations::Running` retains a cancellation sender and mutation slot, not a Go owner; Setup directly awaits `installation::setup_at`, and `installation::rdd` launches separate transient commands. Existing persistent local-services IPC first requires `engine::target` and a recorded engine identity, so it cannot bootstrap first setup. The isolated Go upgradeActivation/authority/cold/working/store graph can retain the same storage owner but has no attended product entrypoint yet. A fixed single backend-owned operation must acquire setup.lock and capture the predecessor before interruption, then retain that same owner through activation/publication/seal. Only then may Rust remove its direct setup.lock acquisition. Fresh setup still needs its distinct actual native observation adapter; an upgrade validation DTO cannot stand in for it. No second lock, lifecycle orchestrator, generic raw-handle constructor or renderer proof is proposed.
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_build_origin_test.go b/rdd/pkg/managementconfig/upgrade_runtime_build_origin_test.go
