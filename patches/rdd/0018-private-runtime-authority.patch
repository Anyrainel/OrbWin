+
+func TestServingImagePathRequiresNativeProfileFixedRoleAndDigest(t *testing.T) {
+	profile := `C:\Users\fixture`
+	valid := profile + `\.orbwin-private\runtime\rdd-` + strings.Repeat("a", 64) + `\rdd.exe`
+	if _, err := servingImageDigest(profile, valid); err != nil {
+		t.Fatal("fixed native layout refused")
+	}
+	for _, path := range []string{`F:\runtime\rdd.exe`, profile + `\AppData\Local\rdd.exe`, strings.Replace(valid, "rdd-", "sdk-", 1), strings.Replace(valid, strings.Repeat("a", 64), strings.Repeat("A", 64), 1), strings.Replace(valid, strings.Repeat("a", 64), strings.Repeat("0", 64), 1), valid + ".other", strings.Replace(valid, `\runtime\`, `\runtime\..\runtime\`, 1)} {
+		if _, err := servingImageDigest(profile, path); err == nil {
+			t.Fatal("unbound executable layout accepted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade.go b/rdd/pkg/managementconfig/upgrade.go
new file mode 100644
index 0000000000000000000000000000000000000000..4799028011db7dae4cb5c0916bcb92be02de5eb1
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade.go
@@ -0,0 +1,341 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"strings"
+)
+
+var ErrUpgrade = errors.New("selected management authority transition refused; retained state requires inspection")
+
+// UpgradeProcess is an expected native identity, never a retirement receipt.
+// Native preparation must observe and hold the exact process/image; later
+// operations independently observe those held objects or the private journal.
+type UpgradeProcess struct {
+	PID      uint32   `json:"pid"`
+	Creation uint64   `json:"creation"`
+	Session  uint32   `json:"session"`
+	Image    [32]byte `json:"image"`
+}
+
+type UpgradeObject struct {
+	Volume uint32 `json:"volume"`
+	High   uint32 `json:"high"`
+	Low    uint32 `json:"low"`
+}
+
+// Fixed roles only. No manifest path or input-selected filename is accepted.
+type UpgradeColdFile struct {
+	Role   string        `json:"role"`
+	Object UpgradeObject `json:"object"`
+	Size   uint64        `json:"size"`
+	Hash   [32]byte      `json:"hash"`
+}
+
+// UpgradeBackupObject records a child copy, never identity-preserving rename.
+// Source is the held original object; Target is the distinct private copy.
+type UpgradeBackupObject struct {
+	Role      string        `json:"role"`
+	Source    UpgradeObject `json:"source"`
+	Target    UpgradeObject `json:"target"`
+	Directory bool          `json:"directory"`
+	Size      uint64        `json:"size"`
+	Hash      [32]byte      `json:"hash"`
+}
+
+type UpgradePIDDenial struct {
+	Directory UpgradeObject `json:"directory"`
+	Receipt   UpgradeObject `json:"receipt"`
+	Digest    [32]byte      `json:"digest"`
+}
+
+type UpgradeSnapshot struct {
+	Rows         uint64   `json:"rows"`
+	LastRevision uint64   `json:"lastRevision"`
+	Sequence     uint64   `json:"sequence"`
+	LogicalHash  [32]byte `json:"logicalHash"`
+}
+
+type UpgradeSeal struct {
+	Role      string        `json:"role"`
+	Object    UpgradeObject `json:"object"`
+	BeforeACL [32]byte      `json:"beforeACL"`
+	AfterACL  [32]byte      `json:"afterACL"`
+}
+
+// No credentials, native paths or arbitrary commands belong in the journal.
+// A stage describing admission is deliberately distinct from acknowledgement.
+type upgradeJournal struct {
+	Schema                  int                         `json:"schema"`
+	Transaction             string                      `json:"transaction"`
+	Stage                   string                      `json:"stage"`
+	OldRuntime              [32]byte                    `json:"oldRuntime"`
+	Incoming                [32]byte                    `json:"incoming"`
+	OldRoot                 UpgradeObject               `json:"oldRoot"`
+	OldService              UpgradeProcess              `json:"oldService"`
+	Hostagents              []UpgradeProcess            `json:"hostagents"`
+	Registration            string                      `json:"registration"`
+	Daemon                  string                      `json:"daemon"`
+	DesiredRunning          bool                        `json:"desiredRunning"`
+	ClusterVersion          string                      `json:"clusterVersion"`
+	ArgsHash                [32]byte                    `json:"argsHash"`
+	RetirementDigest        [32]byte                    `json:"retirementDigest"`
+	Capture                 []UpgradeBackupObject       `json:"capture"`
+	LegacyPIDDenial         UpgradePIDDenial            `json:"legacyPIDDenial"`
+	BackupRoot              UpgradeObject               `json:"backupRoot"`
+	PrivateRoot             UpgradeObject               `json:"privateRoot"`
+	Fence                   UpgradeObject               `json:"fence"`
+	Certificate             [32]byte                    `json:"certificate"`
+	ServiceAccount          [32]byte                    `json:"serviceAccount"`
+	Imported                UpgradeColdFile             `json:"imported"`
+	WorkingRoot             UpgradeObject               `json:"workingRoot"`
+	Working                 []UpgradeColdFile           `json:"working"`
+	Normalized              UpgradeObject               `json:"normalized"`
+	NormalizedHash          [32]byte                    `json:"normalizedHash"`
+	NormalizedSize          uint64                      `json:"normalizedSize"`
+	Cold                    []UpgradeColdFile           `json:"cold"`
+	Seals                   []UpgradeSeal               `json:"seals"`
+	Snapshot                UpgradeSnapshot             `json:"snapshot"`
+	CandidateWritesAdmitted bool                        `json:"candidateWritesAdmitted"`
+	Candidate               UpgradeProcess              `json:"candidate"`
+	ValidationDigest        [32]byte                    `json:"validationDigest"`
+	RuntimeDigest           [32]byte                    `json:"runtimeDigest"`
+	RuntimeAdmission        runtimePublicationAdmission `json:"runtimeAdmission,omitzero"`
+	SDKDigest               [32]byte                    `json:"sdkDigest"`
+	Recovery                upgradeRecovery             `json:"recovery"`
+}
+
+func (p UpgradeProcess) valid() bool {
+	return p.PID > 0 && p.Creation > 0 && p.Session > 0 && p.Image != [32]byte{}
+}
+func (o UpgradeObject) valid() bool { return o.High != 0 || o.Low != 0 }
+func upgradeASCII(value string, max int) bool {
+	if len(value) < 1 || len(value) > max {
+		return false
+	}
+	for _, r := range value {
+		if r < 33 || r > 126 {
+			return false
+		}
+	}
+	return true
+}
+func upgradeHex(value string, n int) bool {
+	if len(value) != n || value == strings.Repeat("0", n) {
+		return false
+	}
+	decoded, e := hex.DecodeString(value)
+	return e == nil && hex.EncodeToString(decoded) == value
+}
+
+func (j upgradeJournal) valid() bool {
+	if j.Schema != 2 || !upgradeHex(j.Transaction, 32) || j.OldRuntime == [32]byte{} || j.Incoming == [32]byte{} || j.OldRuntime == j.Incoming || !j.OldRoot.valid() || !j.OldService.valid() || len(j.Hostagents) > 16 || !upgradeASCII(j.Daemon, 128) || len(j.Registration) != 38 || j.Registration[0] != '{' || j.Registration[37] != '}' || j.Registration[9] != '-' || j.Registration[14] != '-' || j.Registration[19] != '-' || j.Registration[24] != '-' || !upgradeHex(strings.ReplaceAll(j.Registration[1:37], "-", ""), 32) || j.ArgsHash == [32]byte{} || j.ClusterVersion != "" && !upgradeASCII(j.ClusterVersion, 64) || len(j.Cold) > 4 || len(j.Seals) > 32 {
+		return false
+	}
+	rank, ok := upgradeRank[j.Stage]
+	if !ok {
+		return false
+	}
+	seen := map[uint32]bool{}
+	for _, p := range j.Hostagents {
+		if !p.valid() || p.Session != j.OldService.Session || p.PID == j.OldService.PID || seen[p.PID] {
+			return false
+		}
+		seen[p.PID] = true
+	}
+	roles := map[string]bool{}
+	for _, file := range j.Cold {
+		if !upgradeColdRole(file.Role) || roles[file.Role] || !file.Object.valid() || file.Object.Volume != j.OldRoot.Volume || file.Size > 1<<63-1 || rank >= 4 && file.Hash == [32]byte{} {
+			return false
+		}
+		roles[file.Role] = true
+	}
+	seals := map[string]bool{}
+	for _, seal := range j.Seals {
+		if !upgradeSealRole(seal.Role) || seals[seal.Role] || !seal.Object.valid() || seal.Object.Volume != j.OldRoot.Volume || seal.BeforeACL == [32]byte{} || seal.AfterACL == [32]byte{} {
+			return false
+		}
+		seals[seal.Role] = true
+	}
+	if rank >= 2 && (j.RetirementDigest == [32]byte{} || !roles["main"]) {
+		return false
+	}
+	if !validUpgradeCapture(j, rank) {
+		return false
+	}
+	if rank >= 6 && (len(j.Seals) != len(j.Capture)+1 || !seals["root"] || !seals["main"] || !seals["db"] || !seals["args"]) {
+		return false
+	}
+	if rank >= 8 {
+		if !j.WorkingRoot.valid() || j.WorkingRoot == j.OldRoot || !j.Normalized.valid() || j.Normalized.Volume != j.WorkingRoot.Volume || j.Normalized == j.WorkingRoot || j.Normalized == j.OldRoot || len(j.Working) != len(j.Cold) {
+			return false
+		}
+		seen := map[UpgradeObject]bool{j.OldRoot: true, j.BackupRoot: true, j.LegacyPIDDenial.Directory: true, j.LegacyPIDDenial.Receipt: true}
+		for _, item := range j.Capture {
+			seen[item.Source] = true
+			seen[item.Target] = true
+		}
+		if seen[j.WorkingRoot] || seen[j.Normalized] {
+			return false
+		}
+		seen[j.WorkingRoot] = true
+		seen[j.Normalized] = true
+		for _, old := range j.Cold {
+			if old.Object == j.WorkingRoot || old.Object == j.Normalized {
+				return false
+			}
+			seen[old.Object] = true
+		}
+		for i, file := range j.Working {
+			old := j.Cold[i]
+			if !file.Object.valid() || file.Object.Volume != j.WorkingRoot.Volume || seen[file.Object] || file.Role != old.Role || file.Hash != old.Hash || file.Size != old.Size {
+				return false
+			}
+			seen[file.Object] = true
+		}
+	}
+	if rank >= 9 && (j.NormalizedHash == [32]byte{} || j.NormalizedSize == 0 || j.NormalizedSize > maxUpgradeCopyBytes || j.Snapshot.Rows == 0 || j.Snapshot.LogicalHash == [32]byte{} || j.Snapshot.Sequence < j.Snapshot.LastRevision) {
+		return false
+	}
+	if rank >= 11 && (!j.PrivateRoot.valid() || !j.Fence.valid() || j.Fence.Volume != j.PrivateRoot.Volume || j.Fence == j.PrivateRoot || j.PrivateRoot == j.OldRoot || j.PrivateRoot == j.WorkingRoot || j.Certificate == [32]byte{} || j.ServiceAccount == [32]byte{} || j.Certificate == j.ServiceAccount) {
+		return false
+	}
+	if rank >= 13 && (j.Imported.Role != "main" || !j.Imported.Object.valid() || j.Imported.Object.Volume != j.PrivateRoot.Volume || j.Imported.Object == j.Normalized || j.Imported.Object == j.PrivateRoot || j.Imported.Hash != j.NormalizedHash || j.Imported.Size != j.NormalizedSize) {
+		return false
+	}
+	if j.CandidateWritesAdmitted != (rank >= 14) {
+		return false
+	}
+	if rank >= 14 && j.SDKDigest == [32]byte{} {
+		return false
+	}
+	if rank >= 15 && (!j.Candidate.valid() || j.Candidate.Image != j.Incoming || j.Candidate.Session != j.OldService.Session || j.ValidationDigest == [32]byte{}) {
+		return false
+	}
+	if rank < 16 && j.RuntimeAdmission != (runtimePublicationAdmission{}) || rank >= 16 && !j.RuntimeAdmission.matches(j) {
+		return false
+	}
+	if rank >= 17 && (j.RuntimeDigest == [32]byte{} || j.RuntimeDigest != j.RuntimeAdmission.Stage.Body) {
+		return false
+	}
+	if !j.Recovery.valid(j) {
+		return false
+	}
+	return true
+}
+
+var upgradeRank = map[string]int{
+	"prepared": 0, "interruption-admitted": 1, "retirement-unknown": 1, "retired": 2,
+	"capture-admitted": 3, "capture-unknown": 3, "checkpoint-captured": 4,
+	"sealing-admitted": 5, "sealing-unknown": 5, "checkpoint-sealed": 6,
+	"copy-admitted": 7, "copy-unknown": 7, "working-copied": 8, "checkpoint-validated": 9,
+	"initialize-admitted": 10, "initialize-unknown": 10, "private-initialized": 11,
+	"import-admitted": 12, "import-unknown": 12, "data-imported": 13,
+	"candidate-start-admitted": 14, "candidate-unknown": 14, "candidate-validated": 15,
+	"runtime-publication-admitted": 16, "runtime-publication-unknown": 16, "committed": 17,
+}
+
+func upgradeColdRole(role string) bool {
+	return role == "main" || role == "wal" || role == "shm" || role == "rollback-journal"
+}
+func upgradeSealRole(role string) bool {
+	switch role {
+	case "root", "args", "management-config", "cluster-config", "pid", "tls", "management-cert", "management-key", "service-account-key", "obsolete-token-store", "db", "main", "wal", "shm", "rollback-journal":
+		return true
+	}
+	return false
+}
+
+var upgradeTransitions = map[string][]string{
+	"prepared":                     {"interruption-admitted"},
+	"interruption-admitted":        {"retired", "retirement-unknown"},
+	"retirement-unknown":           {"retired"},
+	"retired":                      {"capture-admitted"},
+	"capture-admitted":             {"checkpoint-captured", "capture-unknown"},
+	"capture-unknown":              {"checkpoint-captured"},
+	"checkpoint-captured":          {"sealing-admitted"},
+	"sealing-admitted":             {"checkpoint-sealed", "sealing-unknown"},
+	"sealing-unknown":              {"checkpoint-sealed"},
+	"checkpoint-sealed":            {"copy-admitted"},
+	"copy-admitted":                {"working-copied", "copy-unknown"},
+	"copy-unknown":                 {"working-copied"},
+	"working-copied":               {"checkpoint-validated"},
+	"checkpoint-validated":         {"initialize-admitted"},
+	"initialize-admitted":          {"private-initialized", "initialize-unknown"},
+	"initialize-unknown":           {"private-initialized"},
+	"private-initialized":          {"import-admitted"},
+	"import-admitted":              {"data-imported", "import-unknown"},
+	"import-unknown":               {"data-imported"},
+	"data-imported":                {"candidate-start-admitted"},
+	"candidate-start-admitted":     {"candidate-validated", "candidate-unknown"},
+	"candidate-unknown":            {"candidate-validated"},
+	"candidate-validated":          {"runtime-publication-admitted"},
+	"runtime-publication-admitted": {"committed", "runtime-publication-unknown"},
+	"runtime-publication-unknown":  {"committed"},
+	"committed":                    {},
+}
+
+// advanceUpgrade is admission/recording only; native acknowledgement constructors
+// must establish each claimed postcondition before calling it. Unknown stages
+// have observation-only successors: no Stop/rename/copy/import retry is encoded.
+func advanceUpgrade(before upgradeJournal, next string) (upgradeJournal, error) {
+	if !before.valid() {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	allowed := false
+	for _, stage := range upgradeTransitions[before.Stage] {
+		if stage == next {
+			allowed = true
+			break
+		}
+	}
+	if !allowed {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	after := before
+	after.Hostagents = append([]UpgradeProcess(nil), before.Hostagents...)
+	after.Cold = append([]UpgradeColdFile(nil), before.Cold...)
+	after.Seals = append([]UpgradeSeal(nil), before.Seals...)
+	after.Capture = append([]UpgradeBackupObject(nil), before.Capture...)
+	after.Working = append([]UpgradeColdFile(nil), before.Working...)
+	after.Stage = next
+	if next == "candidate-start-admitted" {
+		after.CandidateWritesAdmitted = true
+	}
+	if !after.valid() {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	return after, nil
+}
+
+func upgradeJournalBytes(j upgradeJournal) ([]byte, error) {
+	if !j.valid() {
+		return nil, ErrUpgrade
+	}
+	data, e := json.Marshal(j)
+	if e != nil || len(data) > 32768 {
+		return nil, ErrUpgrade
+	}
+	return data, nil
+}
+func parseUpgradeJournal(data []byte) (upgradeJournal, error) {
+	var j upgradeJournal
+	if len(data) < 1 || len(data) > 32768 || json.Unmarshal(data, &j) != nil {
+		return j, ErrUpgrade
+	}
+	want, e := upgradeJournalBytes(j)
+	if e != nil || !bytes.Equal(want, data) {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	return j, nil
+}
+
+func upgradeArgsHash(args []byte) ([32]byte, error) {
+	if !privateStartupArguments(args) {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(args), nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_activation.go b/rdd/pkg/managementconfig/upgrade_activation.go
new file mode 100644
index 0000000000000000000000000000000000000000..1d02a878c8ec4ec77aeed8d8120dba9c526b1ec5
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_activation.go
@@ -0,0 +1,290 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"sync"
+)
+
+// These are bounded evidence digests supplied by independent native observers,
+// never caller booleans or command exit status. A production observer/launcher
+// and runtime CAS publisher are deliberately not wired while qualification and
+// the attended owner are absent. No CLI can obtain this activation capability.
+type upgradeValidation struct {
+	Candidate                                                                        UpgradeProcess
+	PrivateRoot                                                                      UpgradeObject
+	Certificate, ServiceAccount                                                      [32]byte
+	Daemon, Registration, ClusterVersion                                             string
+	DesiredRunning                                                                   bool
+	Publication, FreshAuthentication, OldCredentialRejection, KineIsolation          [32]byte
+	RegistrationBasePath, DockerInventory, PersistentState, GuestState, ClusterState [32]byte
+}
+
+func (v upgradeValidation) valid(j upgradeJournal) bool {
+	if !v.Candidate.valid() || sameUpgradeGeneration(v.Candidate, j.OldService) || v.Candidate.Image != j.Incoming || v.Candidate.Session != j.OldService.Session || v.PrivateRoot != j.PrivateRoot || v.Certificate != j.Certificate || v.ServiceAccount != j.ServiceAccount || v.Daemon != j.Daemon || v.Registration != j.Registration || v.ClusterVersion != j.ClusterVersion || v.DesiredRunning != j.DesiredRunning {
+		return false
+	}
+	for _, ha := range j.Hostagents {
+		if sameUpgradeGeneration(ha, v.Candidate) {
+			return false
+		}
+	}
+	for _, digest := range [][32]byte{v.Publication, v.FreshAuthentication, v.OldCredentialRejection, v.KineIsolation, v.RegistrationBasePath, v.DockerInventory, v.PersistentState, v.GuestState, v.ClusterState} {
+		if digest == [32]byte{} {
+			return false
+		}
+	}
+	return true
+}
+func sameUpgradeGeneration(a, b UpgradeProcess) bool {
+	return a.PID == b.PID && a.Creation == b.Creation && a.Image == b.Image
+}
+func (v upgradeValidation) digest(j upgradeJournal) ([32]byte, error) {
+	if !v.valid(j) {
+		return [32]byte{}, ErrUpgrade
+	}
+	data, err := json.Marshal(struct {
+		Transaction   string
+		Old, Incoming [32]byte
+		Snapshot      UpgradeSnapshot
+		SDK           [32]byte
+		Evidence      upgradeValidation
+	}{j.Transaction, j.OldRuntime, j.Incoming, j.Snapshot, j.SDKDigest, v})
+	if err != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(data), nil
+}
+
+type upgradeAuthorityHandoff interface {
+	releaseUpgradeAuthority(context.Context, upgradeJournal) error
+	checkUpgradeLegacyDenial(context.Context, upgradeJournal) error
+	candidateUpgradeTransfer() upgradeCandidateTransfer
+}
+type upgradeCandidateOwner interface {
+	observeUpgradeCandidate(context.Context, upgradeJournal) (upgradeValidation, error)
+	retireUpgradeCandidate(context.Context, upgradeJournal) ([32]byte, error)
+}
+type upgradeCandidateLauncher interface {
+	launchUpgradeCandidate(context.Context, upgradeJournal, upgradeCandidateTransfer) (upgradeCandidateOwner, error)
+}
+type upgradeRuntimePublisher interface {
+	// Capture/flush/immutably admit the actual stage and return storage DATA.
+	// The coordinator durably records this before permitting native rename.
+	prepareUpgradeRuntime(context.Context, upgradeJournal, upgradeValidation) (runtimePublicationAdmission, error)
+	publishUpgradeRuntime(context.Context, upgradeJournal, upgradeValidation) ([32]byte, error)
+	observeUpgradeRuntime(context.Context, upgradeJournal) ([32]byte, error)
+	// Positive checked release of this publication's actual file/I/O/parent
+	// graph, controller last. A matching record alone cannot acknowledge it.
+	sealUpgradeRuntimePublication(context.Context, upgradeJournal) error
+}
+type upgradeActivation struct {
+	mu                            sync.Mutex
+	recorder                      *upgradeRecorder
+	authority                     upgradeAuthorityHandoff
+	launcher                      upgradeCandidateLauncher
+	publisher                     upgradeRuntimePublisher
+	sdk                           upgradeSDKOwner
+	candidate                     upgradeCandidateOwner
+	attempted, unknown, committed bool
+}
+
+func newUpgradeActivation(r *upgradeRecorder, authority upgradeAuthorityHandoff, launcher upgradeCandidateLauncher, publisher upgradeRuntimePublisher, sdk upgradeSDKOwner) (*upgradeActivation, error) {
+	if r == nil || authority == nil || launcher == nil || publisher == nil || sdk == nil {
+		return nil, ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.uncertain || r.retired || r.last.Journal.Stage != "data-imported" || !r.last.Journal.valid() {
+		return nil, ErrUpgrade
+	}
+	return &upgradeActivation{recorder: r, authority: authority, launcher: launcher, publisher: publisher, sdk: sdk}, nil
+}
+
+// ctx is the bounded backend OWNER context, not the renderer/request context.
+// After interruption, client cancellation only detaches its observer. Native
+// owners retain resources on unknown launch/wait/publication; no deferred Stop
+// or rollback runs on error. A lost reply inspects this same durable operation.
+func (a *upgradeActivation) activate(ctx context.Context) error {
+	if a == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.attempted {
+		return ErrUpgrade
+	}
+	a.attempted = true
+	a.recorder.mu.Lock()
+	j := a.recorder.last.Journal
+	uncertain := a.recorder.uncertain || a.recorder.retired
+	a.recorder.mu.Unlock()
+	if uncertain || j.Stage != "data-imported" || a.authority.checkUpgradeLegacyDenial(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	a.unknown = true // SDK admission may have retained native effects on error.
+	sdkDigest, err := a.sdk.admitUpgradeSDK(ctx, j)
+	if err != nil || sdkDigest == [32]byte{} || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	j.SDKDigest = sdkDigest
+	if a.sdk.checkUpgradeSDK(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	next, err := advanceUpgrade(j, "candidate-start-admitted")
+	if err != nil || a.recorder.append(ctx, next) != nil {
+		a.unknown = true
+		return ErrUpgrade
+	}
+	a.unknown = true
+	if a.authority.releaseUpgradeAuthority(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	transfer := a.authority.candidateUpgradeTransfer()
+	if transfer == nil || a.sdk.checkUpgradeSDK(ctx, next) != nil || a.authority.checkUpgradeLegacyDenial(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	owner, err := a.launcher.launchUpgradeCandidate(ctx, next, transfer)
+	a.candidate = owner // retain even when launch/Wait outcome is unknown
+	if err != nil || owner == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	validation, err := owner.observeUpgradeCandidate(ctx, next)
+	if err != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	digest, err := validation.digest(next)
+	if err != nil {
+		return ErrUpgrade
+	}
+	next.Candidate = validation.Candidate
+	next.ValidationDigest = digest
+	next, err = advanceUpgrade(next, "candidate-validated")
+	if err != nil || a.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	admission, err := a.publisher.prepareUpgradeRuntime(ctx, next, validation)
+	if err != nil || !admission.matches(next) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	next, err = admitRuntimePublication(next, admission)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if a.sdk.checkUpgradeSDK(ctx, next) != nil || a.authority.checkUpgradeLegacyDenial(ctx, next) != nil || a.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	runtime, err := a.publisher.publishUpgradeRuntime(ctx, next, validation)
+	if err != nil || runtime == [32]byte{} || runtime != next.RuntimeAdmission.Stage.Body || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	observed, err := a.publisher.observeUpgradeRuntime(ctx, next)
+	if err != nil || observed != runtime || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	// Revalidate the SAME held generation after runtime publication, before the
+	// journal can claim success. A restart/replacement cannot borrow its proof.
+	again, err := owner.observeUpgradeCandidate(ctx, next)
+	if err != nil {
+		return ErrUpgrade
+	}
+	againDigest, err := again.digest(next)
+	if err != nil || againDigest != digest {
+		return ErrUpgrade
+	}
+	next.RuntimeDigest = runtime
+	if a.sdk.checkUpgradeSDK(ctx, next) != nil || a.authority.checkUpgradeLegacyDenial(ctx, next) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	// Keep the migration/startup fence until publication ownership has positively
+	// released. An unknown native close must never leave a committed journal.
+	if a.publisher.sealUpgradeRuntimePublication(ctx, next) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	next, err = advanceUpgrade(next, "committed")
+	if err != nil || a.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	commit, err := a.recorder.sdkCommit()
+	if err != nil || a.sdk.finalizeUpgradeSDK(ctx, commit) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	a.committed = true
+	a.unknown = false
+	return nil
+}
+
+// Rollback is an explicit recovery transaction. The attended decision binds the
+// exact durable record, original checkpoint and loss scope; a stale approval or
+// generic "retry" is insufficient after candidate writes were admitted.
+type upgradeRollbackDecision struct {
+	Transaction, Scope  string
+	Journal, Checkpoint [32]byte
+}
+
+func (d upgradeRollbackDecision) valid(j upgradeJournal) bool {
+	data, err := upgradeJournalBytes(j)
+	if err != nil || d.Transaction != j.Transaction || d.Journal != sha256.Sum256(data) || d.Checkpoint != j.NormalizedHash {
+		return false
+	}
+	scope := "restore-retained-checkpoint"
+	if j.CandidateWritesAdmitted {
+		scope = "restore-retained-checkpoint-and-accept-post-checkpoint-control-loss"
+	}
+	return d.Scope == scope
+}
+
+type upgradeRollbackEvidence struct {
+	OldRuntime                                                                                                            [32]byte
+	OldRoot, BackupRoot                                                                                                   UpgradeObject
+	Registration, Daemon                                                                                                  string
+	CandidateRetirement, OldBinaryLease, BackupVerification, RegistrationBasePath, CompatibleDiskFormats, OldLaunchRecipe [32]byte
+}
+
+func (e upgradeRollbackEvidence) valid(j upgradeJournal) bool {
+	if e.OldRuntime != j.OldRuntime || e.OldRoot != j.OldRoot || e.BackupRoot != j.BackupRoot || e.BackupRoot == e.OldRoot || e.Registration != j.Registration || e.Daemon != j.Daemon {
+		return false
+	}
+	for _, hash := range [][32]byte{e.CandidateRetirement, e.OldBinaryLease, e.BackupVerification, e.RegistrationBasePath, e.CompatibleDiskFormats, e.OldLaunchRecipe} {
+		if hash == [32]byte{} {
+			return false
+		}
+	}
+	return true
+}
+
+type upgradeRollbackObserver interface {
+	observeUpgradeRollback(context.Context, upgradeJournal) (upgradeRollbackEvidence, error)
+}
+type upgradeRollbackCapability struct {
+	journal  upgradeJournal
+	decision upgradeRollbackDecision
+	evidence upgradeRollbackEvidence
+	observer upgradeRollbackObserver
+}
+
+func authorizeUpgradeRollback(ctx context.Context, j upgradeJournal, decision upgradeRollbackDecision, observer upgradeRollbackObserver) (*upgradeRollbackCapability, error) {
+	if ctx == nil || ctx.Err() != nil || observer == nil || !j.valid() || j.Recovery.Schema != 0 || !j.BackupRoot.valid() || !decision.valid(j) {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	evidence, err := observer.observeUpgradeRollback(ctx, j)
+	if err != nil || !evidence.valid(j) || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	data, err := upgradeJournalBytes(j)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	j, err = parseUpgradeJournal(data)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	return &upgradeRollbackCapability{j, decision, evidence, observer}, nil
+}
