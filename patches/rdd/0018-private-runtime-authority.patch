+// Historical observation/retirement ONLY. Public F: ancestors do not become a
+// new execution lease. The connected native pipe selects the process; neither
+// a caller PID/path/hash nor snapshot flags construct this capability.
+type nativeUpgradeLegacySDKPeer struct {
+	mu                                              sync.Mutex
+	root                                            *InstanceRoot
+	recorder                                        *upgradeRecorder
+	scope                                           upgradeJournal
+	name, path, command                             string
+	connection                                      net.Conn
+	pipe                                            windows.Handle
+	process                                         windows.Handle
+	token, callerToken                              windows.Token
+	tokenID                                         windows.LUID
+	expected                                        UpgradeProcess
+	image                                           *upgradeLegacySDKObservedImage
+	imageID                                         UpgradeObject
+	binding                                         upgradeObservedImageBinding
+	processRetired, stopDispatched, ingressAdmitted bool
+	ingress                                         net.Listener
+	successor                                       *nativeUpgradeSDKChild
+	helpers                                         upgradeLegacySDKHelpers
+	stateParents                                    []windows.Handle
+	legacyRoot, controllerMetadata, controller      windows.Handle
+	legacyRootID, controllerID                      UpgradeObject
+	controllerAdopted                               bool
+	unknown, closed                                 bool
+	closeErr                                        error
+}
+
+func (*nativeUpgradeLegacySDKPeer) String() string {
+	return "held historical SDK peer (retirement only)"
+}
+func (*nativeUpgradeLegacySDKPeer) GoString() string {
+	return "held historical SDK peer (retirement only)"
+}
+
+// Required native participant captures actual old helper/relay generations
+// before Stop and proves their retirement afterward. No production issuer is
+// supplied yet. A missing participant prevents the destructive request entirely.
+type upgradeLegacySDKHelpers interface {
+	recheckLegacySDKOwned(context.Context, *nativeUpgradeLegacySDKPeer) error
+	verifyLegacySDKRetired(context.Context, *nativeUpgradeLegacySDKPeer) error
+}
+
+func captureUpgradeLegacySDKPeer(ctx context.Context, root *InstanceRoot, recorder *upgradeRecorder) (out *nativeUpgradeLegacySDKPeer, result error) {
+	if ctx == nil || ctx.Err() != nil || root == nil || recorder == nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	store, native := recorder.sink.(*nativeUpgradeStore)
+	j := recorder.last.Journal
+	if !native || recorder.uncertain || !j.valid() || j.Stage != "prepared" || j.Recovery.Schema != 0 {
+		recorder.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	store.mu.Lock()
+	live := !store.closed && !store.uncertain && store.parents != nil && store.sid == root.sid
+	store.mu.Unlock()
+	recorder.mu.Unlock()
+	if !live {
+		return nil, ErrUpgrade
+	}
+	name, err := upgradeLegacySDKPipe(root.home, j.Daemon)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	p := &nativeUpgradeLegacySDKPeer{root: root, recorder: recorder, scope: j, name: name}
+	ok := false
+	defer func() {
+		if !ok {
+			if p.Close() != nil {
+				out = p
+			}
+			result = ErrUpgrade
+		}
+	}()
+	p.connection, err = winio.DialPipeContext(ctx, name)
+	if err != nil {
+		return nil, ErrUpgrade
+	} // Absence does not mint retirement.
+	fd, hasHandle := p.connection.(interface{ Fd() uintptr })
+	if !hasHandle {
+		return nil, ErrUpgrade
+	}
+	p.pipe = windows.Handle(fd.Fd())
+	var pid uint32
+	if windows.GetNamedPipeServerProcessId(p.pipe, &pid) != nil || pid == 0 {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != root.sid {
+		return nil, ErrUpgrade
+	}
+	p.callerToken, err = windows.OpenCurrentProcessToken()
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	var session, tokenSize uint32
+	if windows.GetTokenInformation(p.callerToken, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &tokenSize) != nil || tokenSize != 4 || session == 0 || legacySDKOrdinaryToken(p.callerToken, sid, session) != nil {
+		return nil, ErrUpgrade
+	}
+	p.process, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	var created, exit, kernel, user windows.Filetime
+	if windows.GetProcessTimes(p.process, &created, &exit, &kernel, &user) != nil {
+		return nil, ErrUpgrade
+	}
+	var processSession uint32
+	if windows.ProcessIdToSessionId(pid, &processSession) != nil || processSession != session {
+		return nil, ErrUpgrade
+	}
+	var digest [32]byte
+	decoded, _ := hex.DecodeString(upgradeLegacySDKImageSHA256)
+	copy(digest[:], decoded)
+	p.expected = UpgradeProcess{PID: pid, Creation: uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), Session: session, Image: digest}
+	if windows.OpenProcessToken(p.process, windows.TOKEN_QUERY, &p.token) != nil || legacySDKOrdinaryToken(p.token, sid, session) != nil {
+		return nil, ErrUpgrade
+	}
+	p.tokenID, err = legacySDKTokenID(p.token)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	// Initial connection identifies the native process only. Release it without
+	// a frame before hashing the image: the exact old server gives each accepted
+	// request only five seconds, which must not become an image-hash deadline.
+	var initialPID uint32
+	if windows.GetNamedPipeServerProcessId(p.pipe, &initialPID) != nil || initialPID != p.expected.PID {
+		return nil, ErrUpgrade
+	}
+	if p.connection.Close() != nil {
+		p.unknown = true
+		return nil, ErrUpgrade
+	}
+	p.connection, p.pipe = nil, 0
+	p.path, err = upgradeProcessPath(p.process)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	p.image, err = p.holdObservedImage(ctx)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	p.imageID, err = upgradeObjectID(p.image.leaf())
+	if err != nil || p.binding.capture(p.process, p.image.leaf()) != nil {
+		return nil, ErrUpgrade
+	}
+	p.command, err = legacySDKCommandLine(p.process)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	args, err := windows.DecomposeCommandLine(p.command)
+	if err != nil || !validateUpgradeLegacySDKArgs(args, p.path, root.home, j.Daemon) || p.check(true) != nil {
+		return nil, ErrUpgrade
+	}
+	if p.observeStateMetadata() != nil {
+		return nil, ErrUpgrade
+	}
+	if p.reconnectControl(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	reply, err := callUpgradeLegacySDK(p.connection, "snapshot", p.checkConnected, func() error { return p.check(true) })
+	if err != nil || validateUpgradeLegacySDKSnapshot(reply, j.Daemon) != nil {
+		return nil, ErrUpgrade
+	}
+	// The selected old server serves exactly ONE frame per connection. Keep the
+	// native process/token/image origin, not a dead snapshot stream, for Stop.
+	if p.connection.Close() != nil {
+		p.unknown = true
+		return nil, ErrUpgrade
+	}
+	p.connection, p.pipe = nil, 0
+	ok = true
+	return p, nil
+}
+
+type upgradeLegacySDKObservedImage struct {
+	chain    []windows.Handle
+	closed   bool
+	closeErr error
+}
+
+func (i *upgradeLegacySDKObservedImage) leaf() windows.Handle {
+	if i == nil || len(i.chain) == 0 {
+		return 0
+	}
+	return i.chain[len(i.chain)-1]
+}
+func (i *upgradeLegacySDKObservedImage) Close() error {
+	if i.closed {
+		return i.closeErr
+	}
+	i.closed = true
+	for n := len(i.chain) - 1; n >= 0; n-- {
+		if windows.CloseHandle(i.chain[n]) != nil {
+			i.closeErr = ErrUpgrade
+			return i.closeErr
+		}
+		i.chain[n] = 0
+	}
+	return nil
+}
+func (p *nativeUpgradeLegacySDKPeer) holdObservedImage(ctx context.Context) (out *upgradeLegacySDKObservedImage, result error) {
+	path, err := upgradeProcessPath(p.process)
+	if err != nil || !strings.EqualFold(path, p.path) {
+		return nil, ErrUpgrade
+	}
+	volume, parts, err := readerComponents(path)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	lease := &upgradeLegacySDKObservedImage{chain: []windows.Handle{h}}
+	ok := false
+	defer func() {
+		if !ok {
+			if lease.Close() != nil {
+				out = lease
+			}
+			result = ErrUpgrade
+		}
+	}()
+	if objectKind(h, true) != nil {
+		return nil, ErrUpgrade
+	}
+	for index, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		directory := index < len(parts)-1
+		if directory {
+			h, err = openRelative(h, part, true, nil, false)
+		} else {
+			h, err = openUpgradeObservedImageFile(h, part)
+		}
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		lease.chain = append(lease.chain, h)
+		if objectKind(h, directory) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > 64<<20 {
+		return nil, ErrUpgrade
+	}
+	var expected [32]byte
+	data, _ := hex.DecodeString(upgradeLegacySDKImageSHA256)
+	copy(expected[:], data)
+	if hashUpgradeSDKCode(ctx, h, uint64(info.FileSizeLow), expected) != nil {
+		return nil, ErrUpgrade
+	}
+	ok = true
+	return lease, nil
+}
+
+// ProcessImageFileMapping44 accepts an actual FILE_OBJECT with EXECUTE|SYNCHRONIZE.
+// These are observation rights, never admission to execute historical code.
+// Root's frozen v2 standard-user primitive qualified live same-file success,
+// different-file failure and post-exit unavailability; no section extraction.
+type upgradeObservedImageBinding struct {
+	process, file windows.Handle
+	id            UpgradeObject
+	creation      uint64
+	captured      bool
+}
+
+func openUpgradeObservedImageFile(parent windows.Handle, name string) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var io windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, windows.FILE_READ_DATA|windows.FILE_EXECUTE|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL|windows.SYNCHRONIZE, &oa, &io, nil, 0, windows.FILE_SHARE_READ, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	return h, err
+}
+func queryUpgradeObservedImage(process, file windows.Handle) error {
+	argument := file
+	var length uint32
+	status, _, _ := windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryInformationProcess").Call(uintptr(process), 44, uintptr(unsafe.Pointer(&argument)), unsafe.Sizeof(argument), uintptr(unsafe.Pointer(&length)))
+	if status != 0 || argument != file {
+		return ErrUpgrade
+	}
+	return nil
+}
+func (b *upgradeObservedImageBinding) capture(process, file windows.Handle) error {
+	if b.captured || process == 0 || file == 0 {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || queryUpgradeObservedImage(process, file) != nil {
+		return ErrUpgrade
+	}
+	var created, exit, kernel, user windows.Filetime
+	if windows.GetProcessTimes(process, &created, &exit, &kernel, &user) != nil {
+		return ErrUpgrade
+	}
+	id, err := upgradeObjectID(file)
+	if err != nil {
+		return ErrUpgrade
+	}
+	b.process, b.file, b.id, b.creation, b.captured = process, file, id, uint64(created.HighDateTime)<<32|uint64(created.LowDateTime), true
+	return nil
+}
+func (b *upgradeObservedImageBinding) same() error {
+	if !b.captured {
+		return ErrUpgrade
+	}
+	id, err := upgradeObjectID(b.file)
+	if err != nil || id != b.id {
+		return ErrUpgrade
+	}
+	var created, exit, kernel, user windows.Filetime
+	if windows.GetProcessTimes(b.process, &created, &exit, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != b.creation {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(b.process, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if state == uint32(windows.WAIT_OBJECT_0) {
+		return nil
+	} // Captured origin plus actual positive exit; class44 is unavailable after exit.
+	if state != uint32(windows.WAIT_TIMEOUT) {
+		return ErrUpgrade
+	}
+	return queryUpgradeObservedImage(b.process, b.file)
+}
+
+func (p *nativeUpgradeLegacySDKPeer) observeStateMetadata() error {
+	volume, parts, err := readerComponents(filepath.Join(p.root.home, ".rdorbwin", "local-services"))
+	if err != nil {
+		return ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	p.stateParents = append(p.stateParents, h)
+	if objectKind(h, true) != nil {
+		return ErrUpgrade
+	}
+	for _, part := range parts {
+		h, err = openLegacyMetadata(h, part, true)
+		if err != nil {
+			return ErrUpgrade
+		}
+		p.stateParents = append(p.stateParents, h)
+		if objectKind(h, true) != nil {
+			return ErrUpgrade
+		}
+	}
+	p.legacyRoot = h
+	if upgradeSDKOwned(h, p.root.sid, true) != nil {
+		return ErrUpgrade
+	}
+	p.legacyRootID, err = upgradeObjectID(h)
+	if err != nil {
+		return ErrUpgrade
+	}
+	p.controllerMetadata, err = openLegacyMetadata(h, "controller.lock", false)
+	if err != nil || upgradeSDKOwned(p.controllerMetadata, p.root.sid, false) != nil {
+		return ErrUpgrade
+	}
+	p.controllerID, err = upgradeObjectID(p.controllerMetadata)
+	return err
+}
+
+func (p *nativeUpgradeLegacySDKPeer) acquireRetiredController() error {
+	var err error
+	p.controller, err = openSDKDenialController(p.legacyRoot, true)
+	if err != nil || upgradeSDKOwned(p.controller, p.root.sid, false) != nil {
+		return ErrUpgrade
+	}
+	id, err := upgradeObjectID(p.controller)
+	if err != nil || id != p.controllerID {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Moves the sole original RW FILE_OBJECT into the denial converter without
+// duplication. This peer keeps only a mutex-protected observation of the current
+// handle; admitted Close never closes it. Conversion updates that observation
+// under this same mutex before retirement can be checked again.
+func (p *nativeUpgradeLegacySDKPeer) takeControllerForDenial(ctx context.Context, r *upgradeRetirement, root UpgradeObject) (windows.Handle, error) {
+	if p == nil || r == nil || ctx == nil || ctx.Err() != nil {
+		return 0, ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || p.closed || !p.processRetired || !p.stopDispatched || p.controller == 0 || p.controllerAdopted || p.root != r.root || root != p.legacyRootID || !upgradeIntentEqual(p.scope, r.journal) || p.check(false) != nil {
+		return 0, ErrUpgrade
+	}
+	p.controllerAdopted = true
+	return p.controller, nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) check(live bool) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if p == nil || p.closed || p.closeErr != nil || p.process == 0 || p.image == nil || !p.expected.valid() {
+		return ErrUpgrade
+	}
+	sid, err := currentOwner()
+	if err != nil || sid != p.root.sid || legacySDKOrdinaryToken(p.callerToken, sid, p.expected.Session) != nil || p.image.closed {
+		return ErrUpgrade
+	}
+	var created, exit, kernel, user windows.Filetime
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(p.process))
+	if pid == 0 || uint32(pid) != p.expected.PID {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(p.process, 0)
+	if err != nil || live && state != uint32(windows.WAIT_TIMEOUT) || !live && state != uint32(windows.WAIT_TIMEOUT) && state != uint32(windows.WAIT_OBJECT_0) || windows.GetProcessTimes(p.process, &created, &exit, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != p.expected.Creation {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(p.token)
+	if err != nil || id != p.tokenID || legacySDKOrdinaryToken(p.token, p.root.sid, p.expected.Session) != nil {
+		return ErrUpgrade
+	}
+	object, err := upgradeObjectID(p.image.leaf())
+	if err != nil || object != p.imageID || objectKind(p.image.leaf(), false) != nil || p.binding.same() != nil {
+		return ErrUpgrade
+	}
+	for _, directory := range p.image.chain[:len(p.image.chain)-1] {
+		if objectKind(directory, true) != nil {
+			return ErrUpgrade
+		}
+	}
+	if p.legacyRoot != 0 {
+		rootID, e := upgradeObjectID(p.legacyRoot)
+		controllerID, f := upgradeObjectID(p.controllerMetadata)
+		if e != nil || f != nil || rootID != p.legacyRootID || controllerID != p.controllerID || upgradeSDKOwned(p.legacyRoot, p.root.sid, true) != nil || upgradeSDKOwned(p.controllerMetadata, p.root.sid, false) != nil {
+			return ErrUpgrade
+		}
+		for _, directory := range p.stateParents {
+			if objectKind(directory, true) != nil {
+				return ErrUpgrade
+			}
+		}
+	}
+	return nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) checkConnected() error {
+	if p.connection == nil || p.pipe == 0 || p.check(true) != nil {
+		return ErrUpgrade
+	}
+	var pid uint32
+	if windows.GetNamedPipeServerProcessId(p.pipe, &pid) != nil || pid != p.expected.PID {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) reconnectControl(ctx context.Context) error {
+	if p.connection != nil || p.pipe != 0 {
+		return ErrUpgrade
+	}
+	var err error
+	p.connection, err = winio.DialPipeContext(ctx, p.name)
+	if err != nil {
+		return ErrUpgrade
+	}
+	fd, ok := p.connection.(interface{ Fd() uintptr })
+	if ok {
+		p.pipe = windows.Handle(fd.Fd())
+	}
+	if !ok || p.checkConnected() != nil || p.deadline(ctx) != nil {
+		if p.connection.Close() != nil {
+			p.unknown = true
+			return ErrUpgrade
+		}
+		p.connection, p.pipe = nil, 0
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) deadline(ctx context.Context) error {
+	until, ok := ctx.Deadline()
+	if !ok || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if maximum := time.Now().Add(5 * time.Second); maximum.Before(until) {
+		until = maximum
+	}
+	return p.connection.SetDeadline(until)
+}
+
+// Stop is one use and only sends the exact selected SDK's stop-process request.
+// It has no terminate-process access or bare-PID kill fallback. Reply/snapshot
+// flags do not acknowledge retirement: actual process wait, retained native
+// ingress ownership and independent old-helper proof are all mandatory.
+func (p *nativeUpgradeLegacySDKPeer) stop(ctx context.Context, helpers upgradeLegacySDKHelpers) error {
+	if p == nil || ctx == nil || helpers == nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || p.closed || p.stopDispatched || ctx.Err() != nil || p.check(true) != nil {
+		return ErrUpgrade
+	}
+	p.recorder.mu.Lock()
+	store, native := p.recorder.sink.(*nativeUpgradeStore)
+	j := p.recorder.last.Journal
+	admitted := native && !p.recorder.uncertain && j.Stage == "interruption-admitted" && j.Recovery.Schema == 0 && upgradeIntentEqual(p.scope, j)
+	if native {
+		store.mu.Lock()
+		admitted = admitted && !store.closed && !store.uncertain
+		store.mu.Unlock()
+	}
+	p.recorder.mu.Unlock()
+	if !admitted {
+		return ErrUpgrade
+	}
+	if helpers.recheckLegacySDKOwned(ctx, p) != nil {
+		return ErrUpgrade
+	}
+	if p.reconnectControl(ctx) != nil {
+		return ErrUpgrade
+	}
+	p.stopDispatched, p.unknown = true, true
+	p.helpers = helpers
+	reply, err := callUpgradeLegacySDK(p.connection, "stop-process", p.checkConnected, func() error { return p.check(false) })
+	if err != nil || validateUpgradeLegacySDKSnapshot(reply, j.Daemon) != nil {
+		return ErrUpgrade
+	}
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForSingleObject(p.process, 25)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			break
+		}
+		if state != uint32(windows.WAIT_TIMEOUT) {
+			return ErrUpgrade
+		}
+	}
+	p.processRetired = true
+	// Take the ORIGINAL compatible controller immediately after positive process
+	// exit. A racing old ordinary start wins the share-zero lock and makes this
+	// transaction refuse, never adopt that writer or copy beneath it.
+	if p.acquireRetiredController() != nil || p.check(false) != nil {
+		return ErrUpgrade
+	}
+	// The exact old services tail returns errors.Join(serveErr,runtime.Close).
+	// Require its native successful exit as additional cleanup correlation;
+	// this never substitutes for actual helper waits/controller/ingress owners.
+	var exitCode uint32
+	if windows.GetExitCodeProcess(p.process, &exitCode) != nil || exitCode != 0 || helpers.verifyLegacySDKRetired(ctx, p) != nil {
+		return ErrUpgrade
+	}
+	if p.connection.Close() != nil {
+		return ErrUpgrade
+	}
+	p.connection, p.pipe = nil, 0
+	p.ingressAdmitted = true
+	p.ingress, err = winio.ListenPipe(p.name, &winio.PipeConfig{SecurityDescriptor: "D:P(A;;GA;;;" + p.root.sid + ")", InputBufferSize: 8196, OutputBufferSize: 64 << 10})
+	if err != nil || p.ingress == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	p.unknown = false
+	return nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) recheckRetired(ctx context.Context) error {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || p.closed || !p.stopDispatched || !p.processRetired || !p.ingressAdmitted || p.helpers == nil || p.controller == 0 || p.check(false) != nil {
+		return ErrUpgrade
+	}
+	if p.ingress == nil && (p.successor == nil || p.successor.recheckIngressBirth(ctx) != nil) {
+		return ErrUpgrade
+	}
+	id, err := upgradeObjectID(p.controller)
+	if err != nil || id != p.controllerID || upgradeSDKOwned(p.controller, p.root.sid, false) != nil {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(p.process, 0)
+	if err != nil || state != uint32(windows.WAIT_OBJECT_0) || p.helpers.verifyLegacySDKRetired(ctx, p) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (p *nativeUpgradeLegacySDKPeer) Close() error {
+	if p == nil {
+		return nil
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || p.stopDispatched {
+		return ErrUpgrade
+	} // Inspection/handoff owns admitted resources.
+	if p.closed {
+		return p.closeErr
+	}
+	p.closed = true
+	var resources []func() error
+	if p.connection != nil {
+		resources = append(resources, p.connection.Close)
+	}
+	if p.image != nil {
+		resources = append(resources, p.image.Close)
+	}
+	if p.controllerMetadata != 0 {
+		resources = append(resources, func() error { return windows.CloseHandle(p.controllerMetadata) })
+	}
+	for n := len(p.stateParents) - 1; n >= 0; n-- {
+		handle := p.stateParents[n]
+		resources = append(resources, func() error { return windows.CloseHandle(handle) })
+	}
+	if p.token != 0 {
+		resources = append(resources, p.token.Close)
+	}
+	if p.callerToken != 0 {
+		resources = append(resources, p.callerToken.Close)
+	}
+	p.closeErr = closeOwnerLastLegacySDK(resources, func() error {
+		if p.process != 0 {
+			return windows.CloseHandle(p.process)
+		}
+		return nil
+	})
+	return p.closeErr
+}
+
+type legacySDKTokenStatistics struct {
+	TokenID, AuthenticationID                                                 windows.LUID
+	Expiration                                                                int64
+	Type, Impersonation, DynamicCharged, DynamicAvailable, Groups, Privileges uint32
+	Modified                                                                  windows.LUID
+}
+
+func legacySDKTokenID(token windows.Token) (windows.LUID, error) {
+	var facts legacySDKTokenStatistics
+	var size uint32
+	if windows.GetTokenInformation(token, windows.TokenStatistics, (*byte)(unsafe.Pointer(&facts)), uint32(unsafe.Sizeof(facts)), &size) != nil || size != uint32(unsafe.Sizeof(facts)) || facts.Type != 1 || facts.TokenID == (windows.LUID{}) {
+		return windows.LUID{}, ErrUpgrade
+	}
+	return facts.TokenID, nil
+}
+func legacySDKOrdinaryToken(token windows.Token, sid string, session uint32) error {
+	user, err := token.GetTokenUser()
+	if err != nil || user.User.Sid == nil || user.User.Sid.String() != sid {
+		return ErrUpgrade
+	}
+	for _, q := range []struct{ class, want uint32 }{{windows.TokenSessionId, session}, {windows.TokenElevation, 0}, {29, 0}} {
+		var value, size uint32
+		if windows.GetTokenInformation(token, q.class, (*byte)(unsafe.Pointer(&value)), 4, &size) != nil || size != 4 || value != q.want {
+			return ErrUpgrade
+		}
+	}
+	restricted, err := token.IsRestricted()
+	if err != nil || restricted {
+		return ErrUpgrade
+	}
+	return nil
+}
+func legacySDKCommandLine(process windows.Handle) (string, error) {
+	buffer := make([]byte, 16<<10)
+	var size uint32
+	if windows.NtQueryInformationProcess(process, 60, unsafe.Pointer(&buffer[0]), uint32(len(buffer)), &size) != nil || size < 16 || size > uint32(len(buffer)) {
+		return "", ErrUpgrade
+	}
+	text := (*windows.NTUnicodeString)(unsafe.Pointer(&buffer[0]))
+	start := uintptr(unsafe.Pointer(&buffer[0]))
+	pointer := uintptr(unsafe.Pointer(text.Buffer))
+	if text.Length == 0 || text.Length%2 != 0 || text.Length > text.MaximumLength || pointer < start+unsafe.Sizeof(*text) || pointer > start+uintptr(len(buffer)) || uintptr(text.Length) > start+uintptr(len(buffer))-pointer {
+		return "", ErrUpgrade
+	}
+	value := windows.UTF16ToString(unsafe.Slice(text.Buffer, int(text.Length/2)))
+	if strings.IndexByte(value, 0) >= 0 {
+		return "", ErrUpgrade
+	}
+	return value, nil
+}
