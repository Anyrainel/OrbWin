@@ -0,0 +1,77 @@
+package managementconfig
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func testUpgradeSDKOwnerWire() upgradeSDKOwnerWire {
+	return upgradeSDKOwnerWire{Schema: 6, Transaction: strings.Repeat("a", 32), SDKDigest: [32]byte{1}, Nonce: [32]byte{2}, Sequence: 2, Parent: upgradeSDKGrantProcess{31, 41, 1, [32]byte{3}}, SDK: upgradeSDKGrantProcess{32, 42, 1, [32]byte{4}}, Job: 103, Process: 104, Token: 105, Image: 106, Control: 107, Acceptance: 108, Supervisor: 109, Final: 110, Cohort: upgradeSDKOwnerCohortWire{111, 1, []upgradeSDKOwnerMemberWire{{112, 113, 32, 42}}}}
+}
+
+func TestUpgradeSDKOwnerRejectsEveryNativeRoleAlias(t *testing.T) {
+	want := testUpgradeSDKOwnerWire()
+	body, _ := json.Marshal(want)
+	if got, err := parseUpgradeSDKOwner(body, 101, 102); err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatal("valid structural envelope refused", err)
+	}
+	// All native roles must be disjoint BEFORE any inherited object is adopted.
+	// This includes both sealed files, which otherwise risk duplicate adoption
+	// even though their bodies describe distinct native ownership roles.
+	for one := 0; one < 13; one++ {
+		for two := one + 1; two < 13; two++ {
+			wire := testUpgradeSDKOwnerWire()
+			raw, management := uint64(101), uint64(102)
+			roles := []*uint64{&raw, &management, &wire.Job, &wire.Process, &wire.Token, &wire.Image, &wire.Control, &wire.Acceptance, &wire.Supervisor, &wire.Final, &wire.Cohort.Job, &wire.Cohort.Members[0].Process, &wire.Cohort.Members[0].Token}
+			*roles[two] = *roles[one]
+			body, _ := json.Marshal(wire)
+			if _, err := parseUpgradeSDKOwner(body, raw, management); err == nil {
+				t.Fatalf("native role alias %d/%d admitted", one, two)
+			}
+		}
+	}
+}
+
+func TestUpgradeSDKOwnerRejectsAmbiguousScopeAndGeneration(t *testing.T) {
+	for _, fault := range []string{"schema", "transaction", "digest", "nonce", "sequence", "same-process", "older-generation", "foreign-session", "missing-parent-image", "missing-sdk-image", "invalid-handle"} {
+		t.Run(fault, func(t *testing.T) {
+			wire := testUpgradeSDKOwnerWire()
+			switch fault {
+			case "schema":
+				wire.Schema++
+			case "transaction":
+				wire.Transaction = strings.Repeat("A", 32)
+			case "digest":
+				wire.SDKDigest = [32]byte{}
+			case "nonce":
+				wire.Nonce = [32]byte{}
+			case "sequence":
+				wire.Sequence++
+			case "same-process":
+				wire.SDK.PID = wire.Parent.PID
+			case "older-generation":
+				wire.SDK.Creation = wire.Parent.Creation
+			case "foreign-session":
+				wire.SDK.Session++
+			case "missing-parent-image":
+				wire.Parent.Image = [32]byte{}
+			case "missing-sdk-image":
+				wire.SDK.Image = [32]byte{}
+			case "invalid-handle":
+				wire.Control = uint64(^uintptr(0))
+			}
+			body, _ := json.Marshal(wire)
+			if _, err := parseUpgradeSDKOwner(body, 101, 102); err == nil {
+				t.Fatal("invalid inherited envelope admitted")
+			}
+		})
+	}
+	body, _ := json.Marshal(testUpgradeSDKOwnerWire())
+	for _, malformed := range [][]byte{nil, append([]byte(" "), body...), append(body, '\n'), append(body[:len(body)-1:len(body)-1], []byte(`,"Unknown":1}`)...)} {
+		if _, err := parseUpgradeSDKOwner(malformed, 101, 102); err == nil {
+			t.Fatal("noncanonical inherited envelope admitted")
+		}
+	}
+}
