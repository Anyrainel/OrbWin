+func sdkResourcesFixtureInherited(text string) (windows.Handle, error) {
+	raw, err := strconv.ParseUint(text, 10, strconv.IntSize)
+	if err != nil || raw == 0 || strconv.FormatUint(raw, 10) != text || uintptr(raw) == ^uintptr(0) {
