@@ -0,0 +1,84 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+func TestRuntimeStoragePublicRouteRejectsUnsupportedACLData(t *testing.T) {
+	for _, owner := range []string{"", "S-1-15-3-1234", "S-1-5-21-9-8-7-6"} {
+		if runtimeStoragePublicOwner(owner, "S-1-5-21-1-2-3-4") == nil {
+			t.Fatal("foreign/missing owner", owner)
+		}
+	}
+	for _, owner := range []string{"S-1-5-18", "S-1-5-32-544", "S-1-5-21-1-2-3-4"} {
+		if runtimeStoragePublicOwner(owner, "S-1-5-21-1-2-3-4") != nil {
+			t.Fatal("known owner", owner)
+		}
+	}
+	for _, tc := range []struct {
+		kind, flags uint8
+		size        uint16
+	}{
+		{windows.ACCESS_ALLOWED_ACE_TYPE, 0, 15},
+		{windows.ACCESS_DENIED_ACE_TYPE, 0x80, 20},
+		{5, 0, 32}, // ACCESS_ALLOWED_OBJECT_ACE_TYPE; unsupported object ACE
+		{255, 0, 32},
+	} {
+		if runtimeStorageSupportedACEHeader(tc.kind, tc.flags, tc.size) == nil {
+			t.Fatal("unsupported shape", tc)
+		}
+	}
+	for _, size := range []int{-1, 0, 7, 13, 100} {
+		if runtimeStorageSupportedACESID(20, size) == nil {
+			t.Fatal("out-of-ACE SID", size)
+		}
+	}
+	if runtimeStorageSupportedACEHeader(windows.ACCESS_ALLOWED_ACE_TYPE, windows.INHERIT_ONLY_ACE, 20) != nil || runtimeStorageSupportedACESID(20, 12) != nil {
+		t.Fatal("supported bounded shape")
+	}
+}
+
+// Pure masks/identity transitions only; no native provider or namespace call.
+func TestRuntimeStorageCompatibilityPublicReadNeverAllowsForeignMutation(t *testing.T) {
+	for _, m := range []uint32{windows.FILE_READ_DATA, windows.FILE_READ_ATTRIBUTES, windows.FILE_READ_EA, windows.READ_CONTROL, windows.SYNCHRONIZE, windows.GENERIC_READ, windows.GENERIC_EXECUTE} {
+		if runtimeStorageForeignWrite(m) {
+			t.Fatal("public read rejected", m)
+		}
+	}
+	for _, m := range []uint32{windows.FILE_WRITE_DATA, windows.FILE_APPEND_DATA, windows.FILE_WRITE_EA, windows.FILE_WRITE_ATTRIBUTES, windows.DELETE, windows.WRITE_OWNER, windows.WRITE_DAC, windows.GENERIC_WRITE, windows.GENERIC_ALL, 0x40} {
+		if !runtimeStorageForeignWrite(m) {
+			t.Fatal("foreign writer accepted", m)
+		}
+	}
+	a := runtimeStorageIdentity{volume: 1, high: 2, low: 3, size: 16, links: 1, descriptor: [32]byte{1}, written: windows.Filetime{LowDateTime: 4}}
+	b := a
+	b.written.LowDateTime++
+	if !runtimeStorageCreatedSame(a, b) {
+		t.Fatal("native write-close timestamp finalization rejected")
+	}
+	b.low++
+	if runtimeStorageCreatedSame(a, b) {
+		t.Fatal("different file object admitted")
+	}
+	b = a
+	b.descriptor[0]++
+	if runtimeStorageCreatedSame(a, b) {
+		t.Fatal("different SD admitted")
+	}
+}
+
+func TestRuntimeStorageTraversalAllowsOnlyUnrelatedChildCreation(t *testing.T) {
+	for _, mask := range []uint32{windows.FILE_WRITE_DATA, windows.FILE_APPEND_DATA, windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA | windows.GENERIC_READ} {
+		if runtimeStorageForeignTraversalMutation(mask) || !runtimeStorageForeignWrite(mask) {
+			t.Fatal("traversal relaxation escaped into destination policy", mask)
+		}
+	}
+	for _, mask := range []uint32{windows.FILE_WRITE_EA, windows.FILE_WRITE_ATTRIBUTES, windows.DELETE, windows.WRITE_OWNER, windows.WRITE_DAC, windows.GENERIC_WRITE, windows.GENERIC_ALL, 0x40} {
+		if !runtimeStorageForeignTraversalMutation(mask | windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA) {
+			t.Fatal("ancestor mutation admitted with child creation", mask)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_native_windows.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..f3639169fda0dbd7527c7c90d190e93fe10a9ced
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_windows.go
@@ -0,0 +1,876 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+// Native compatibility-DATA storage only. This deliberately does not implement
+// upgradeRuntimePublisher/upgradeNativeCandidatePublication. The future binder
+// must retain the actual observed candidate and durable publication admission.
+// All writers use the existing fixed setup.lock role; this is cooperative
+// exclusion, not a destination-ID kernel CAS against arbitrary same-user edits.
+type runtimeStorageResource struct {
+	handle windows.Handle
+	runtimeStorageCloseAttempt
+}
+type runtimeStorageIdentity struct {
+	volume, high, low, attributes, links uint32
+	size                                 uint64
+	written                              windows.Filetime
+	descriptor                           [32]byte
+}
+type runtimeStorageObject struct {
+	resource                      *runtimeStorageResource
+	identity                      runtimeStorageIdentity
+	directory, private, traversal bool
+}
+type nativeRuntimeStorage struct {
+	captureSelf                       *nativeRuntimeStorage
+	captureStarted                    bool
+	mu                                sync.Mutex
+	root                              *InstanceRoot
+	sid, profile, local, home         string
+	token                             windows.Token
+	tokenID, authenticationID         windows.LUID
+	resources                         []*runtimeStorageResource
+	ancestry                          []*runtimeStorageObject
+	publicRoute                       *nativeRuntimePublicRoute
+	controller                        *runtimeStorageObject
+	controllerIndex                   int
+	parent                            *runtimeStorageObject
+	predecessor                       *runtimeStorageObject // nil only after actual name-not-found capture
+	predecessorBody                   []byte
+	stage, target                     *runtimeStorageObject
+	stageBody                         []byte
+	prepared, unknown, closeAttempted bool
+	closeErr                          error
+	attempt                           runtimeStorageAttempt
+}
+type nativeRuntimePrepared struct {
+	owner    *nativeRuntimeStorage
+	consumed bool
+}
+type nativeRuntimeStorageReceipt struct {
+	owner  *nativeRuntimeStorage
+	target *runtimeStorageObject
+	body   []byte
+}
+
+var runtimeStorageDomain = struct {
+	sync.Mutex
+	failed bool
+	owners map[*nativeRuntimeStorage]bool
+}{owners: make(map[*nativeRuntimeStorage]bool)}
+
+func (*nativeRuntimeStorage) String() string   { return "native runtime compatibility storage owner" }
+func (*nativeRuntimeStorage) GoString() string { return "native runtime compatibility storage owner" }
+func (*nativeRuntimePrepared) String() string  { return "native runtime compatibility prepared storage" }
+func (*nativeRuntimePrepared) GoString() string {
+	return "native runtime compatibility prepared storage"
+}
+func (*nativeRuntimeStorageReceipt) String() string {
+	return "native runtime compatibility storage receipt"
+}
+func (*nativeRuntimeStorageReceipt) GoString() string {
+	return "native runtime compatibility storage receipt"
+}
+func (n *nativeRuntimeStorage) keep(h windows.Handle) *runtimeStorageResource {
+	r := &runtimeStorageResource{handle: h}
+	n.resources = append(n.resources, r)
+	return r
+}
+func (n *nativeRuntimeStorage) fence() {
+	n.unknown = true
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.owners[n] = true
+	runtimeStorageDomain.Unlock()
+}
+func runtimeStorageDomainKnown() bool {
+	runtimeStorageDomain.Lock()
+	defer runtimeStorageDomain.Unlock()
+	return !runtimeStorageDomain.failed
+}
+func (n *nativeRuntimeStorage) closeOne(r *runtimeStorageResource) error {
+	if r == nil {
+		return nil
+	}
+	return r.run(func() error {
+		if r.handle == 0 || windows.CloseHandle(r.handle) != nil {
+			return ErrUpgrade
+		}
+		r.handle = 0
+		return nil
+	}, n.fence)
+}
+func (n *nativeRuntimeStorage) closeTemporary(r *runtimeStorageResource) error {
+	e := n.closeOne(r)
+	if e == nil && len(n.resources) > 0 && n.resources[len(n.resources)-1] == r {
+		n.resources = n.resources[:len(n.resources)-1]
+	}
+	return e
+}
+func (n *nativeRuntimeStorage) Close() error {
+	if n == nil {
+		return nil
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.unknown || !runtimeStorageDomainKnown() {
+		n.fence()
+		return ErrUpgrade
+	}
+	if n.closeAttempted {
+		return n.closeErr
+	}
+	n.closeAttempted = true
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			panic(p)
+		}
+	}()
+	n.closeErr = runtimeStorageCloseSequence(len(n.resources), n.controllerIndex, func(i int) error { return n.closeOne(n.resources[i]) })
+	if n.closeErr != nil {
+		n.fence()
+		return n.closeErr
+	}
+	runtimeStorageDomain.Lock()
+	delete(runtimeStorageDomain.owners, n)
+	runtimeStorageDomain.Unlock()
+	return nil
+}
+func (n *nativeRuntimeStorage) observeOpen(h windows.Handle, e error) (windows.Handle, error) {
+	e = runtimeStorageOpenReply(e, h != 0 && h != windows.InvalidHandle, func() { n.keep(h) }, n.fence)
+	if e != nil {
+		return 0, e
+	}
+	return h, nil
+}
+func (n *nativeRuntimeStorage) open(parent windows.Handle, name string, directory bool, disposition, access, share uint32, sd *windows.SECURITY_DESCRIPTOR) (windows.Handle, error) {
+	text, e := windows.NewNTUnicodeString(name)
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	if directory {
+		options |= windows.FILE_DIRECTORY_FILE
+	} else {
+		options |= windows.FILE_NON_DIRECTORY_FILE
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&h, access|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, share, disposition, options, 0, 0)
+	runtime.KeepAlive(sd)
+	return n.observeOpen(h, e)
+}
+func runtimeStorageForeignWrite(mask uint32) bool {
+	return mask&uint32(windows.DELETE|windows.WRITE_DAC|windows.WRITE_OWNER|windows.FILE_WRITE_DATA|windows.FILE_APPEND_DATA|windows.FILE_WRITE_EA|windows.FILE_WRITE_ATTRIBUTES|0x40|windows.GENERIC_WRITE|windows.GENERIC_ALL) != 0
+}
+
+// Traversal ancestors may permit creating unrelated children. Retained
+// TRAVERSE opens deny their deletion/rename, and each selected child is itself
+// captured. Do not grant this relaxation to the publication parent or files.
+func runtimeStorageForeignTraversalMutation(mask uint32) bool {
+	return runtimeStorageForeignWrite(mask &^ uint32(windows.FILE_WRITE_DATA|windows.FILE_APPEND_DATA))
+}
+
+func runtimeStoragePublicOwner(owner, caller string) error {
+	if owner == "" || !readerTrustedSID(owner, caller) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func runtimeStorageSupportedACEHeader(kind, flags uint8, size uint16) error {
+	if size < 16 || (kind != windows.ACCESS_ALLOWED_ACE_TYPE && kind != windows.ACCESS_DENIED_ACE_TYPE) || flags&^uint8(0x1f) != 0 {
