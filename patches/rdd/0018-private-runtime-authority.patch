new file mode 100644
index 0000000000000000000000000000000000000000..75a24f58068919d784726fa7dbd48f8eacdeba8b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_preflight.go
@@ -0,0 +1,18 @@
+package managementconfig
+
+// Revoke this recorder BEFORE releasing any preflight native exclusions. The
+// same mutex serializes interruption admission, so a racing append either wins
+// first (abandon refuses), or sees retired and cannot admit later effects.
+// No journal rewrite/delete or post-interruption cancellation is authorized.
+func retireRuntimePreflight(r *upgradeRecorder) error {
+	if r == nil {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.retired || r.uncertain || r.last.Sequence == 0 || r.last.Journal.Stage != "prepared" || !r.last.Journal.valid() {
+		return ErrUpgrade
+	}
+	r.retired = true
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_preflight_test.go b/rdd/pkg/managementconfig/upgrade_runtime_preflight_test.go
