+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"testing"
+)
+
+func TestUpgradeSDKServingUnknownAttemptRetainsActualOwnerWithoutReplay(t *testing.T) {
+	stop, done := make(chan struct{}), make(chan struct{})
+	close(done)
+	// This is an already admitted, retained unknown owner. Missing support now
+	// refuses BEFORE admission (separately tested); it must not fabricate an
+	// attempted native failure merely to exercise the cached-unknown branch.
+	o := &nativeUpgradeSDKServingOwner{supervisorReady: true, heartbeatStop: stop, heartbeatDone: done, closeAttempted: true, closeErr: ErrUpgrade, unknown: true}
+	retainUnknownUpgradeSDKServingOwner(o)
+	upgradeSDKServingQuarantine.Lock()
+	_, retained := upgradeSDKServingQuarantine.owners[o]
+	upgradeSDKServingQuarantine.Unlock()
+	if !retained || o.close() == nil || o.heartbeatStopped || !o.closeAttempted || !o.unknown || o.closed {
+		t.Fatal("unknown actual owner dropped or replayed")
+	}
+	select {
+	case <-stop:
+		t.Fatal("cached unknown close replayed heartbeat effect")
+	default:
+	}
+	known := &nativeUpgradeSDKServingOwner{unknown: true}
+	if known.close() == nil || known.closeAttempted {
+		t.Fatal("known readiness refusal started native attempt")
+	}
+	upgradeSDKServingQuarantine.Lock()
+	_, retained = upgradeSDKServingQuarantine.owners[known]
+	upgradeSDKServingQuarantine.Unlock()
+	if retained {
+		t.Fatal("known pre-admission refusal misreported as attempted close")
+	}
+}
+
+func TestUpgradeSDKMissingCohortRetainsCreatedBeforeAnyNativeClose(t *testing.T) {
+	done := make(chan struct{})
+	close(done)
+	owner := &nativeUpgradeSDKServingOwner{supervisorReady: true, bootstrapDone: done, controllers: [4]windows.Handle{101, 102, 103, 104}}
+	// These are refusal-only values: missing cohort is checked before any
+	// native resource observation or close, even after apparent bootstrap.
+	created := &Created{upgradePermit: &upgradeServingPermit{sdk: owner}}
+	if created.Close() == nil || created.closed || owner.closeAttempted || created.upgradePermit.sdkCloseAttempted {
+		t.Fatal("missing real cohort entered native cleanup")
+	}
+	untouched := false
+	created.once.Do(func() { untouched = true })
+	if !untouched {
+		t.Fatal("cohort refusal consumed management cleanup")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_owner_receive_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_owner_receive_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..c590ef336359e618940d46b74e24aa018e8577e0
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_owner_receive_windows.go
@@ -0,0 +1,216 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+// Receiver of ORIGINAL birth-inherited SDK job/control capability in the SAME
+// management candidate that consumed its migration permit. No path/hash/JSON
+// constructor; the envelope is admitted only with all retained native objects.
+type nativeUpgradeSDKServingOwner struct {
+	mu                                       sync.Mutex
+	permit                                   *upgradeServingPermit
+	wire                                     upgradeSDKOwnerWire
+	file                                     windows.Handle
+	job, process, image, control, acceptance windows.Handle
+	token                                    windows.Token
+	actualToken                              windows.Token
+	selfImage                                windows.Handle
+	tokenID                                  windows.LUID
+	binding                                  upgradeObservedImageBinding
+	code                                     *nativeUpgradeSDKImage
+	io                                       *upgradeSDKControlIO
+	unknown                                  bool
+	supervisor                               windows.Handle
+	finalEvent                               windows.Handle
+	protocol                                 sync.Mutex
+	sequence                                 uint32
+	bootstrapDone                            chan struct{}
+	bootstrapErr                             error
+	supervisorReady                          bool
+	controllers                              [4]windows.Handle
+	closeAttempted, closed                   bool
+	closeErr                                 error
+	heartbeatStop, heartbeatDone             chan struct{}
+	heartbeatStopped                         bool
+	resources                                *nativeUpgradeSDKResources
+	cohort                                   *nativeUpgradeSDKCohort
+	retireAck                                *nativeUpgradeSDKRetireAck
+	leaves                                   *nativeUpgradeSDKLeafReceiver
+	joinedSource                             *nativeUpgradeSDKJoinedSource
+}
+
+func consumeUpgradeSDKServingOwner(ctx context.Context, p *upgradeServingPermit) (out *nativeUpgradeSDKServingOwner, result error) {
+	if p == nil || ctx == nil || ctx.Err() != nil || p.parent == nil || p.image == nil || !p.record.valid() {
+		return nil, ErrUpgrade
+	}
+	text, present := os.LookupEnv(upgradeSDKOwnerEnv)
+	if !present {
+		return nil, ErrUpgrade
+	}
+	if os.Unsetenv(upgradeSDKOwnerEnv) != nil {
+		return nil, ErrUpgrade
+	}
+	value, err := strconv.ParseUint(text, 10, strconv.IntSize)
+	if err != nil || value == 0 || uintptr(value) == ^uintptr(0) || strconv.FormatUint(value, 10) != text {
+		return nil, ErrUpgrade
+	}
+	o := &nativeUpgradeSDKServingOwner{permit: p, file: windows.Handle(value), unknown: true}
+	out = o
+	retainUnknownUpgradeSDKServingOwner(o) // pin actual graph before native effects
+	defer func() {
+		if result != nil {
+			retainUnknownUpgradeSDKServingOwner(o)
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != p.root.sid {
+		return o, ErrUpgrade
+	}
+	var flags uint32
+	status, _, _ := anchorGetHandleInformation.Call(uintptr(o.file), uintptr(unsafe.Pointer(&flags)))
+	if status == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 || windows.SetHandleInformation(o.file, windows.HANDLE_FLAG_INHERIT, 0) != nil || verifyPrivate(o.file, sid, false) != nil {
+		return o, ErrUpgrade
+	}
+	path, err := upgradeWorkingPath(o.file)
+	if err != nil || !strings.EqualFold(path, filepath.Join(p.root.selection.Parent(), "services.owner-"+p.record.Fence.Transaction+".grant")) {
+		return o, ErrUpgrade
+	}
+	if _, err := windows.Seek(o.file, 0, 0); err != nil {
+		return o, ErrUpgrade
+	}
+	body, err := authorityRead(o.file, 64<<10)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.wire, err = parseUpgradeSDKOwner(body, uint64(o.file), uint64(p.handle))
+	j := p.record.Record.Journal
+	if err != nil || o.wire.Transaction != j.Transaction || o.wire.SDKDigest != j.SDKDigest || o.wire.Parent != upgradeSDKProcessWire(p.parent.expected) || p.candidate.PID == o.wire.SDK.PID || p.candidate.Creation <= o.wire.SDK.Creation {
+		return o, ErrUpgrade
+	}
+	o.code, err = holdUpgradeSDKImage(ctx, p.root)
+	if err != nil || o.code == nil || o.wire.SDK.Image != o.code.pins.files[0] {
+		return o, ErrUpgrade
+	}
+	if len(p.image.chain) < 2 {
+		return o, ErrUpgrade
+	}
+	o.selfImage, err = openUpgradeObservedImageFile(p.image.chain[len(p.image.chain)-2], "rdd.exe")
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	selfID, selfErr := upgradeObjectID(o.selfImage)
+	heldSelf, heldSelfErr := upgradeObjectID(p.image.chain[len(p.image.chain)-1])
+	if selfErr != nil || heldSelfErr != nil || selfID != heldSelf || queryUpgradeObservedImage(windows.CurrentProcess(), o.selfImage) != nil {
+		return o, ErrUpgrade
+	}
+	o.job, o.process, o.token, o.image, o.control, o.acceptance = windows.Handle(o.wire.Job), windows.Handle(o.wire.Process), windows.Token(o.wire.Token), windows.Handle(o.wire.Image), windows.Handle(o.wire.Control), windows.Handle(o.wire.Acceptance)
+	o.supervisor = windows.Handle(o.wire.Supervisor)
+	o.finalEvent = windows.Handle(o.wire.Final)
+	for _, h := range []windows.Handle{o.job, o.process, windows.Handle(o.token), o.image, o.control, o.acceptance, o.supervisor, o.finalEvent} {
+		flags = 0
+		status, _, _ = anchorGetHandleInformation.Call(uintptr(h), uintptr(unsafe.Pointer(&flags)))
+		if status == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 || windows.SetHandleInformation(h, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+			return o, ErrUpgrade
+		}
+	}
+	var finalRights [14]uint32
+	var finalLength uint32
+	finalStatus, _, _ := windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryObject").Call(uintptr(o.finalEvent), 0, uintptr(unsafe.Pointer(&finalRights)), unsafe.Sizeof(finalRights), uintptr(unsafe.Pointer(&finalLength)))
+	finalState, finalErr := windows.WaitForSingleObject(o.finalEvent, 0)
+	if finalStatus != 0 || finalRights[1] != windows.SYNCHRONIZE || finalErr != nil || finalState != uint32(windows.WAIT_TIMEOUT) {
+		return o, ErrUpgrade
+	}
+	object, err := upgradeObjectID(o.image)
+	expected, expectedErr := upgradeObjectID(o.code.files[0])
+	if err != nil || expectedErr != nil || object != expected || verifyPrivate(o.image, sid, false) != nil || o.binding.capture(o.process, o.image) != nil {
+		return o, ErrUpgrade
+	}
+	o.tokenID, err = legacySDKTokenID(o.token)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	if windows.OpenProcessToken(o.process, windows.TOKEN_QUERY, &o.actualToken) != nil {
+		return o, ErrUpgrade
+	}
+	actualID, tokenErr := legacySDKTokenID(o.actualToken)
+	closeErr := o.actualToken.Close()
+	if closeErr == nil {
+		o.actualToken = 0
+	}
+	if tokenErr != nil || closeErr != nil || actualID != o.tokenID || o.checkNative(ctx) != nil {
+		return o, ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(o.acceptance, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+		return o, ErrUpgrade
+	}
+	o.io = &upgradeSDKControlIO{pipe: o.control}
+	o.sequence = o.wire.Sequence
+	if _, err := consumeNativeUpgradeSDKCohort(ctx, o); err != nil {
+		return o, ErrUpgrade
+	}
+	// Cohort receiver custody/support must be real BEFORE retention ACK or
+	// runtime bootstrap, never discovered missing after logical supervisor
+	// switch. Its native transport constructor is not implemented yet.
+	if o.cohort == nil || o.cohort.requirePreReadyNativeParticipant(ctx, o) != nil {
+		return o, ErrUpgrade
+	}
+	// ACK is ONLY actual native job/control retention in this candidate. SDK
+	// logical supervisor remains temporary until its separate final native ACK.
+	if windows.SetEvent(o.acceptance) != nil {
+		return o, ErrUpgrade
+	}
+	o.unknown = false
+	o.bootstrapDone = make(chan struct{})
+	go o.bootstrap()
+	return o, nil
+}
+
+func (o *nativeUpgradeSDKServingOwner) checkNative(ctx context.Context) error {
+	if o == nil || ctx == nil || ctx.Err() != nil || o.job == 0 || o.process == 0 || o.image == 0 || o.control == 0 || o.code == nil {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(o.process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || o.binding.same() != nil || o.code.recheck(ctx) != nil || checkUpgradeSDKJobLimits(o.job) != nil || verifySDKControlDACL(o.control, o.permit.root.sid) != nil || legacySDKOrdinaryToken(o.token, o.permit.root.sid, o.wire.SDK.Session) != nil {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(o.token)
+	if err != nil || id != o.tokenID {
+		return ErrUpgrade
+	}
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(o.process), uintptr(o.job), uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 1 {
+		return ErrUpgrade
+	}
+	// The serving rdd controls the SDK job but is never contained in it; SDK
+	// retirement must not terminate the engine's management owner itself.
+	member = 0
+	result, _, _ = windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(windows.CurrentProcess()), uintptr(o.job), uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 0 {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(o.process))
+	if uint32(pid) != o.wire.SDK.PID || windows.GetProcessTimes(o.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != o.wire.SDK.Creation {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Accepted owners retain the same inherited graph through supervisor transfer
+// and positive physical retirement. Partial/unknown consumption is quarantined;
+// generic permit cleanup cannot manufacture a replacement or retry lost close.
