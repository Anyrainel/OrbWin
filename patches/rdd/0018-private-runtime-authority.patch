--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_leaf_close.go
@@ -0,0 +1,20 @@
+package managementconfig
+
+// Serialized by the actual receiver owner. This caches an attempted effect,
+// including panic/unknown return; it never represents custody or retirement.
+type upgradeSDKLeafCloseAttempt struct {
+	attempted bool
+	err       error
+}
+
+func (a *upgradeSDKLeafCloseAttempt) run(close func() error) error {
+	if a.attempted {
+		return a.err
+	}
+	if close == nil {
+		return ErrUpgrade
+	}
+	a.attempted, a.err = true, ErrUpgrade
+	a.err = close()
+	return a.err
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_leaf_close_test.go b/rdd/pkg/managementconfig/upgrade_sdk_leaf_close_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..487f7c2c790f9e98a4f14f301df2818d912da169
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_leaf_close_test.go
@@ -0,0 +1,45 @@
+package managementconfig
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestUpgradeSDKLeafCloseNeverRetriesLostReturnOrUnwind(t *testing.T) {
+	for _, kind := range []string{"positive", "unknown", "panic"} {
+		t.Run(kind, func(t *testing.T) {
+			var a upgradeSDKLeafCloseAttempt
+			calls := 0
+			fault := errors.New("native close return unknown")
+			func() {
+				defer func() {
+					if p := recover(); p != nil && kind != "panic" {
+						panic(p)
+					}
+				}()
+				_ = a.run(func() error {
+					calls++
+					if kind == "panic" {
+						panic("lost close")
+					}
+					if kind == "unknown" {
+						return fault
+					}
+					return nil
+				})
+			}()
+			for n := 0; n < 3; n++ {
+				err := a.run(func() error { calls++; return nil })
+				if (err == nil) != (kind == "positive") {
+					t.Fatal("unknown close became positive", kind, err)
+				}
+				if kind == "unknown" && !errors.Is(err, fault) {
+					t.Fatal("lost original failure")
+				}
+			}
+			if !a.attempted || calls != 1 {
+				t.Fatal("replayed actual effect", calls)
+			}
+		})
+	}
+}
