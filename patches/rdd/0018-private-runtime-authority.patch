new file mode 100644
index 0000000000000000000000000000000000000000..0fcbf75347f3704c789cb18df4d3c93112692dfa
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_observed_candidate_windows.go
@@ -0,0 +1,66 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+// This witness exists only after the actual owner's native pre/post checks and
+// trusted full-scope observation. It retains that owner, not a reconstructed
+// process from the journal. It is one prerequisite for publication, never a
+// replacement for durable storage admission, SDK custody or startup exclusion.
+type nativeUpgradeObservedCandidate struct {
+	owner       *nativeUpgradeCandidate
+	root        *InstanceRoot
+	transaction string
+	digest      [32]byte
+}
+
+// Called while c.operation is held, after the actual observer has returned and
+// c.checkNative has succeeded. No DTO-only caller can supply an owner witness.
+func (c *nativeUpgradeCandidate) retainObservedCandidate(ctx context.Context, j upgradeJournal, v upgradeValidation) error {
+	if c == nil || c.unknown || !c.resumed || c.launcher == nil || c.launcher.authority == nil || c.launcher.authority.cold == nil || c.launcher.authority.cold.retirement == nil || v.Candidate != c.expected {
+		return ErrUpgrade
+	}
+	root := c.launcher.authority.cold.retirement.root
+	digest, err := v.digest(j)
+	if root == nil || err != nil || !upgradeHex(j.Transaction, 32) || c.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	if c.observed != nil {
+		if c.observed.owner != c || c.observed.root != root || c.observed.transaction != j.Transaction || c.observed.digest != digest {
+			return ErrUpgrade
+		}
+		return nil
+	}
+	c.observed = &nativeUpgradeObservedCandidate{c, root, j.Transaction, digest}
+	return nil
+}
+
+// The future concrete publisher must hold this exact witness. Serialized
+// validation, matching PIDs/hashes, copied witnesses and another owner cannot
+// authorize publication. Native checks run again immediately before its effects.
+func (w *nativeUpgradeObservedCandidate) check(ctx context.Context, root *InstanceRoot, j upgradeJournal, v upgradeValidation) error {
+	if w == nil || w.owner == nil || root == nil || w.root != root || w.transaction != j.Transaction || w.digest == [32]byte{} {
+		return ErrUpgrade
+	}
+	c := w.owner
+	if !c.operation.TryLock() {
+		return ErrUpgrade
+	}
+	defer c.operation.Unlock()
+	return w.checkHeld(ctx, root, j, v)
+}
+
+// Caller holds the actual candidate's operation mutex through its own native
+// effects. Keeping a successful unlocked check is not an authority lifetime.
+func (w *nativeUpgradeObservedCandidate) checkHeld(ctx context.Context, root *InstanceRoot, j upgradeJournal, v upgradeValidation) error {
+	if w == nil || w.owner == nil || root == nil || w.root != root || w.transaction != j.Transaction || w.digest == [32]byte{} {
+		return ErrUpgrade
+	}
+	c := w.owner
+	digest, err := v.digest(j)
+	if err != nil || digest != w.digest || c.observed != w || c.unknown || !c.resumed || v.Candidate != c.expected || c.launcher == nil || c.launcher.authority == nil || c.launcher.authority.cold == nil || c.launcher.authority.cold.retirement == nil || c.launcher.authority.cold.retirement.root != root {
+		return ErrUpgrade
+	}
+	return c.checkNative(ctx)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_observed_candidate_windows_test.go b/rdd/pkg/managementconfig/upgrade_runtime_observed_candidate_windows_test.go
