@@ -0,0 +1,124 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"testing"
+)
+
+type fakeUpgradeSink struct {
+	records [][]byte
+	fail    bool
+	cancel  context.CancelFunc
+	writes  int
+	failAt  int
+	unknown bool
+}
+
+func (s *fakeUpgradeSink) unknownUpgradeRecord() { s.unknown = true }
+
+func (s *fakeUpgradeSink) writeExclusive(_ context.Context, sequence uint32, data []byte) error {
+	s.writes++
+	if int(sequence) != len(s.records)+1 {
+		return errors.New("occupied")
+	}
+	s.records = append(s.records, append([]byte(nil), data...))
+	if s.cancel != nil {
+		s.cancel()
+	}
+	if s.fail || s.writes == s.failAt {
+		return errors.New("flush or close unknown")
+	}
+	return nil
+}
+func TestUpgradeRecordUnknownAdmissionNeverRetries(t *testing.T) {
+	sink := &fakeUpgradeSink{fail: true}
+	r, err := newUpgradeRecorder(sink, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.append(context.Background(), upgradeFixture()) == nil {
+		t.Fatal("unknown write acknowledged")
+	}
+	sink.fail = false
+	if r.append(context.Background(), upgradeFixture()) == nil || sink.writes != 1 {
+		t.Fatal("uncertain admission replayed")
+	}
+	// Recovery may observe a completely canonical durable record, rather than
+	// writing the occupied sequence again. It still cannot skip retirement.
+	recovered, err := newUpgradeRecorder(sink, sink.records)
+	if err != nil {
+		t.Fatal(err)
+	}
+	next := upgradeFixture()
+	next.Stage = "capture-admitted"
+	if recovered.append(context.Background(), next) == nil || sink.writes != 1 {
+		t.Fatal("retirement skipped")
+	}
+	next.Stage = "interruption-admitted"
+	if recovered.append(context.Background(), next) != nil || sink.writes != 2 {
+		t.Fatal("observed chain could not advance")
+	}
+}
+func TestUpgradeRecordCancellationAfterFlushStaysUncertain(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	sink := &fakeUpgradeSink{cancel: cancel}
+	r, _ := newUpgradeRecorder(sink, nil)
+	if r.append(ctx, upgradeFixture()) == nil || !r.uncertain || !sink.unknown || r.last.Sequence != 0 {
+		t.Fatal("canceled admission became acknowledged")
+	}
+	if r.append(context.Background(), upgradeFixture()) == nil || sink.writes != 1 {
+		t.Fatal("canceled admission retried")
+	}
+}
+func TestUpgradeRecordRejectsTamperingAndIntentChanges(t *testing.T) {
+	sink := &fakeUpgradeSink{}
+	r, _ := newUpgradeRecorder(sink, nil)
+	if r.append(context.Background(), upgradeFixture()) != nil {
+		t.Fatal("prepare")
+	}
+	next := upgradeFixture()
+	next.Stage = "interruption-admitted"
+	next.DesiredRunning = false
+	if r.append(context.Background(), next) == nil {
+		t.Fatal("intent changed")
+	}
+	next = upgradeFixture()
+	next.Stage = "interruption-admitted"
+	if r.append(context.Background(), next) != nil {
+		t.Fatal("admission")
+	}
+	for _, mutate := range []func(*upgradeRecord){func(r *upgradeRecord) { r.Sequence = 3 }, func(r *upgradeRecord) { r.Previous = sha256.Sum256([]byte("foreign")) }, func(r *upgradeRecord) { r.Journal.ArgsHash = [32]byte{9} }} {
+		changed, _ := parseUpgradeRecord(sink.records[1])
+		mutate(&changed)
+		bytes, _ := upgradeRecordBytes(changed)
+		if _, err := newUpgradeRecorder(sink, [][]byte{sink.records[0], bytes}); err == nil {
+			t.Fatal("tampered chain accepted")
+		}
+	}
+}
+
+func TestUpgradeRecordEnvelopeRejectsUnexpectedAndMissingFiles(t *testing.T) {
+	for _, names := range [][]string{{"record-01.json", "unexpected"}, {"record-01.json", "record-03.json"}, {"record-01.json", "record-01.json"}, {"record-1.json"}} {
+		if upgradeRecordNamesMatch(names, len(names)) {
+			t.Fatal("open envelope accepted")
+		}
+	}
+	if !upgradeRecordNamesMatch([]string{"record-02.json", "record-01.json"}, 2) {
+		t.Fatal("closed envelope refused")
+	}
+}
+func TestUpgradeRecordOwnsJournalSlices(t *testing.T) {
+	sink := &fakeUpgradeSink{}
+	r, _ := newUpgradeRecorder(sink, nil)
+	input := upgradeFixture()
+	if r.append(context.Background(), input) != nil {
+		t.Fatal("prepare")
+	}
+	input.Hostagents[0].PID = 999
+	if r.last.Journal.Hostagents[0].PID == 999 {
+		t.Fatal("caller mutated retained intent")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_recovery.go b/rdd/pkg/managementconfig/upgrade_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..b8be2ab9ebc3a37dad6b321b704c0bde5ec21166
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_recovery.go
@@ -0,0 +1,228 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"sync"
+)
+
+// Forward state is frozen during recovery. A distinct monotonic receipt keeps
+// the original candidate-write cutoff and evidence visible; rollback cannot
+// reset the forward journal to prepared or erase newer-state loss consent.
+type upgradeRecovery struct {
+	Schema                       int    `json:"schema"`
+	Stage                        string `json:"stage"`
+	Original, Decision, Evidence [32]byte
+	Restored                     UpgradeObject
+	OldCandidate                 UpgradeProcess
+	Validation, Runtime          [32]byte
+}
+
+var upgradeRecoveryRank = map[string]int{"rollback-admitted": 0, "rollback-unknown": 0, "checkpoint-restored": 1, "old-start-admitted": 2, "old-start-unknown": 2, "old-validated": 3, "old-runtime-publication-admitted": 4, "old-runtime-publication-unknown": 4, "rolled-back": 5}
+var upgradeRecoveryNext = map[string][]string{"rollback-admitted": {"rollback-unknown", "checkpoint-restored"}, "rollback-unknown": {"checkpoint-restored"}, "checkpoint-restored": {"old-start-admitted"}, "old-start-admitted": {"old-start-unknown", "old-validated"}, "old-start-unknown": {"old-validated"}, "old-validated": {"old-runtime-publication-admitted"}, "old-runtime-publication-admitted": {"old-runtime-publication-unknown", "rolled-back"}, "old-runtime-publication-unknown": {"rolled-back"}}
+
+func (r upgradeRecovery) valid(j upgradeJournal) bool {
+	if r.Schema == 0 {
+		return r == (upgradeRecovery{})
+	}
+	rank, ok := upgradeRecoveryRank[r.Stage]
+	if !ok || r.Schema != 1 || r.Original == [32]byte{} || r.Decision == [32]byte{} || r.Evidence == [32]byte{} || !j.BackupRoot.valid() {
+		return false
+	}
+	if rank >= 1 && r.Restored != j.OldRoot {
+		return false
+	}
+	if rank >= 3 && (!r.OldCandidate.valid() || r.OldCandidate.Image != j.OldRuntime || r.OldCandidate.Session != j.OldService.Session || r.Validation == [32]byte{}) {
+		return false
+	}
+	return rank < 5 || r.Runtime != [32]byte{}
+}
+func upgradeRecoveryFollows(before, after upgradeJournal) bool {
+	old, new := before.Recovery, after.Recovery
+	before.Recovery = upgradeRecovery{}
+	after.Recovery = upgradeRecovery{}
+	left, err := upgradeJournalBytes(before)
+	right, other := upgradeJournalBytes(after)
+	if err != nil || other != nil || !bytes.Equal(left, right) {
+		return false
+	}
+	if old.Schema == 0 {
+		return new.Schema == 1 && new.Stage == "rollback-admitted" && new.Original == sha256.Sum256(left)
+	}
+	if new.Schema != old.Schema || new.Original != old.Original || new.Decision != old.Decision || new.Evidence != old.Evidence || old.Restored.valid() && old.Restored != new.Restored || old.OldCandidate.valid() && old.OldCandidate != new.OldCandidate || old.Validation != [32]byte{} && old.Validation != new.Validation || old.Runtime != [32]byte{} && old.Runtime != new.Runtime {
+		return false
+	}
+	for _, stage := range upgradeRecoveryNext[old.Stage] {
+		if stage == new.Stage {
+			return true
+		}
+	}
+	return false
+}
+func (c *upgradeRollbackCapability) recheck(ctx context.Context) error {
+	if c == nil || c.observer == nil || ctx == nil || ctx.Err() != nil || !c.decision.valid(c.journal) {
+		return ErrUpgrade
+	}
+	evidence, err := c.observer.observeUpgradeRollback(ctx, c.journal)
+	if err != nil || evidence != c.evidence || !evidence.valid(c.journal) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+type upgradeOldValidation struct {
+	Process                                                                                                       UpgradeProcess
+	Daemon, Registration, ClusterVersion                                                                          string
+	DesiredRunning                                                                                                bool
+	Publication, Authentication, RegistrationBasePath, DockerInventory, PersistentState, GuestState, ClusterState [32]byte
+}
+
+func (v upgradeOldValidation) valid(j upgradeJournal) bool {
+	if !v.Process.valid() || v.Process.Image != j.OldRuntime || v.Process.Session != j.OldService.Session || v.Daemon != j.Daemon || v.Registration != j.Registration || v.ClusterVersion != j.ClusterVersion || v.DesiredRunning != j.DesiredRunning {
+		return false
+	}
+	for _, hash := range [][32]byte{v.Publication, v.Authentication, v.RegistrationBasePath, v.DockerInventory, v.PersistentState, v.GuestState, v.ClusterState} {
+		if hash == [32]byte{} {
+			return false
+		}
+	}
+	return true
+}
+func (v upgradeOldValidation) digest(j upgradeJournal) ([32]byte, error) {
+	if !v.valid(j) {
+		return [32]byte{}, ErrUpgrade
+	}
+	data, err := json.Marshal(struct {
+		Transaction string
+		Old         [32]byte
+		Checkpoint  [32]byte
+		Validation  upgradeOldValidation
+	}{j.Transaction, j.OldRuntime, j.NormalizedHash, v})
+	if err != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(data), nil
+}
+
+type upgradeOldOwner interface {
+	observeUpgradeOld(context.Context, upgradeJournal) (upgradeOldValidation, error)
+}
+type upgradeRecoveryOps interface {
+	restoreUpgradeCheckpoint(context.Context, *upgradeRollbackCapability, *upgradeRecorder) (UpgradeObject, error)
+	launchUpgradeOld(context.Context, upgradeJournal) (upgradeOldOwner, error)
+	publishUpgradeOldRuntime(context.Context, upgradeJournal, upgradeOldValidation) ([32]byte, error)
+	observeUpgradeOldRuntime(context.Context, upgradeJournal) ([32]byte, error)
+}
+type upgradeRecoveryOwner struct {
+	mu                           sync.Mutex
+	capability                   *upgradeRollbackCapability
+	recorder                     *upgradeRecorder
+	ops                          upgradeRecoveryOps
+	old                          upgradeOldOwner
+	attempted, unknown, complete bool
+}
+
+func newUpgradeRecoveryOwner(capability *upgradeRollbackCapability, r *upgradeRecorder, ops upgradeRecoveryOps) (*upgradeRecoveryOwner, error) {
+	if capability == nil || r == nil || ops == nil {
+		return nil, ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	data, err := upgradeJournalBytes(r.last.Journal)
+	expected, other := upgradeJournalBytes(capability.journal)
+	if r.uncertain || err != nil || other != nil || !bytes.Equal(data, expected) {
+		return nil, ErrUpgrade
+	}
+	return &upgradeRecoveryOwner{capability: capability, recorder: r, ops: ops}, nil
+}
+func (r *upgradeRecoveryOwner) recover(ctx context.Context) error {
+	if r == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.attempted {
+		return ErrUpgrade
+	}
+	r.attempted = true
+	if r.capability.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	j := r.capability.journal
+	decision, _ := json.Marshal(r.capability.decision)
+	evidence, _ := json.Marshal(r.capability.evidence)
+	j.Recovery = upgradeRecovery{Schema: 1, Stage: "rollback-admitted", Original: r.capability.decision.Journal, Decision: sha256.Sum256(decision), Evidence: sha256.Sum256(evidence)}
+	if r.recorder.append(ctx, j) != nil {
+		r.unknown = true
+		return ErrUpgrade
+	}
+	r.unknown = true
+	if r.capability.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	root, err := r.ops.restoreUpgradeCheckpoint(ctx, r.capability, r.recorder)
+	if err != nil || root != j.OldRoot || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	j.Recovery.Restored = root
+	j.Recovery.Stage = "checkpoint-restored"
+	if r.recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	j.Recovery.Stage = "old-start-admitted"
+	if r.recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	owner, err := r.ops.launchUpgradeOld(ctx, j)
+	r.old = owner
+	if err != nil || owner == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	validation, err := owner.observeUpgradeOld(ctx, j)
+	if err != nil {
+		return ErrUpgrade
+	}
+	digest, err := validation.digest(j)
+	if err != nil {
+		return ErrUpgrade
+	}
+	j.Recovery.OldCandidate = validation.Process
+	j.Recovery.Validation = digest
+	j.Recovery.Stage = "old-validated"
+	if r.recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	j.Recovery.Stage = "old-runtime-publication-admitted"
+	if r.recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	runtime, err := r.ops.publishUpgradeOldRuntime(ctx, j, validation)
+	if err != nil || runtime == [32]byte{} || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	observed, err := r.ops.observeUpgradeOldRuntime(ctx, j)
+	if err != nil || observed != runtime {
+		return ErrUpgrade
+	}
+	again, err := owner.observeUpgradeOld(ctx, j)
+	if err != nil {
+		return ErrUpgrade
+	}
+	againDigest, err := again.digest(j)
+	if err != nil || againDigest != digest {
+		return ErrUpgrade
+	}
+	j.Recovery.Runtime = runtime
+	j.Recovery.Stage = "rolled-back"
+	if r.recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	r.unknown = false
+	r.complete = true
+	return nil
+}
