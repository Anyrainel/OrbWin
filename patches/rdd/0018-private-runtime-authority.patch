+package authoritypath
+
+import "testing"
+
+func TestAuthoritySelectionSeparatesProfileAuthorityFromGuestAndLegacy(t *testing.T) {
+	profile := `C:\Users\fixture`
+	local := profile + `\AppData\Local`
+	home := local + `\OrbWinData\home`
+	s, err := selectNative(profile, local, home, "orbwin", "S-1-5-21-1-2-3-1001")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Directory() != profile+`\.orbwin-private\authority` || s.RuntimeParent() != profile+`\.orbwin-private\runtime` || s.GuestHome() != home || s.LegacyDirectory() != home+`\AppData\Local\rancher-desktop-orbwin` {
+		t.Fatal("authority adaptation moved or conflated guest/legacy roles")
+	}
+	for _, suffix := range []string{"orbwin-proof", "2", "rancher"} {
+		if _, err := selectNative(profile, local, home, suffix, s.Owner()); err == nil {
+			t.Fatal("nonproduct acquired private authority role")
+		}
+	}
+}
+func TestAuthoritySelectionRefusesEnvRedirectAndNoncanonicalNativePaths(t *testing.T) {
+	profile := `C:\Users\fixture`
+	local := profile + `\AppData\Local`
+	for _, home := range []string{`F:\renderer-home`, local + `\OrbWinData\home\..`, local + `/OrbWinData/home`, local + `\OrbWinData\home.`} {
+		if _, err := selectNative(profile, local, home, "orbwin", "S-1-5-21-1"); err == nil {
+			t.Fatal("arbitrary guest-home redirect accepted")
+		}
+	}
+	for _, profile := range []string{`\\server\profile`, `C:\Users\..\fixture`, `C:\Users\fixture\`, `C:\Users\fixture:stream`} {
+		if _, err := selectNative(profile, local, local+`\OrbWinData\home`, "orbwin", "S-1-5-21-1"); err == nil {
+			t.Fatal("ambiguous native profile path accepted")
+		}
+	}
+}
diff --git a/rdd/pkg/authoritypath/selection_windows.go b/rdd/pkg/authoritypath/selection_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..25b6f4e8e13a7f51ae4a6f8fe7f86e7b4b9a4d9d
--- /dev/null
+++ b/rdd/pkg/authoritypath/selection_windows.go
@@ -0,0 +1,46 @@
+//go:build windows
+
+package authoritypath
+
+import (
+	"golang.org/x/sys/windows"
+	"runtime"
+	"unsafe"
+)
+
+func Current(home, suffix string) (*Selection, error) {
+	if suffix != "orbwin" {
+		return nil, ErrSelection
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	var thread windows.Token
+	if err := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, &thread); err == nil {
+		thread.Close()
+		return nil, ErrSelection
+	} else if err != windows.ERROR_NO_TOKEN {
+		return nil, ErrSelection
+	}
