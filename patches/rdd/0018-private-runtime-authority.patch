@@ -0,0 +1,83 @@
+package managementconfig
+
+import (
+	"encoding/json"
+	"errors"
+	"testing"
+)
+
+func TestUpgradeSDKCohortEnvelopeRequiresCompleteBoundedActualRootDescription(t *testing.T) {
+	for _, fault := range []string{"old-schema", "missing-members", "count-gap", "count-overflow", "missing-root", "root-generation", "before-root", "zero-token", "member-alias", "duplicate-pid", "unsorted", "over-bound"} {
+		t.Run(fault, func(t *testing.T) {
+			w := testUpgradeSDKOwnerWire()
+			w.Cohort.Total = 2
+			w.Cohort.Members = append(w.Cohort.Members, upgradeSDKOwnerMemberWire{114, 115, 33, 43})
+			switch fault {
+			case "old-schema":
+				w.Schema = 4
+			case "missing-members":
+				w.Cohort.Members = nil
+			case "count-gap":
+				w.Cohort.Total++
+			case "count-overflow":
+				w.Cohort.Total = ^uint32(0)
+			case "missing-root":
+				w.Cohort.Members = w.Cohort.Members[1:]
+				w.Cohort.Total = 1
+			case "root-generation":
+				w.Cohort.Members[0].Creation++
+			case "before-root":
+				w.Cohort.Members[1].Creation = w.SDK.Creation - 1
+			case "zero-token":
+				w.Cohort.Members[1].Token = 0
+			case "member-alias":
+				w.Cohort.Members[1].Process = w.Cohort.Members[0].Token
+			case "duplicate-pid":
+				w.Cohort.Members[1].PID = w.Cohort.Members[0].PID
+			case "unsorted":
+				w.Cohort.Members[0], w.Cohort.Members[1] = w.Cohort.Members[1], w.Cohort.Members[0]
+			case "over-bound":
+				w.Cohort.Members = make([]upgradeSDKOwnerMemberWire, upgradeSDKCohortBound+1)
+				w.Cohort.Total = uint32(len(w.Cohort.Members))
+			}
+			body, _ := json.Marshal(w)
+			if _, err := parseUpgradeSDKOwner(body, 101, 102); err == nil {
+				t.Fatal("incomplete/ambiguous native custody description accepted")
+			}
+		})
+	}
+	w := testUpgradeSDKOwnerWire()
+	w.Cohort.Members = nil
+	for n := 0; n < upgradeSDKCohortBound; n++ {
+		w.Cohort.Members = append(w.Cohort.Members, upgradeSDKOwnerMemberWire{uint64(1000 + 2*n), uint64(1001 + 2*n), uint32(32 + n), uint64(42 + n)})
+	}
+	w.Cohort.Total = uint32(len(w.Cohort.Members))
+	body, _ := json.Marshal(w)
+	if _, err := parseUpgradeSDKOwner(body, 101, 102); err != nil {
+		t.Fatal("bounded complete structural data refused", err)
+	}
+	// Structural success above is data only; no native constructor/Ready or
+	// retirement grant is invoked by these schema tests.
+}
+
+func TestUpgradeSDKDuplicatePartialOutputRemainsInActualOwnerSlot(t *testing.T) {
+	for _, failure := range []bool{false, true} {
+		var owned []uintptr
+		calls := 0
+		out, err := retainUpgradeSDKDuplicate(&owned, func(slot *uintptr) error {
+			calls++
+			*slot = 701 // partial native output exists before the syscall reports error
+			if failure {
+				return errors.New("duplicate unknown")
+			}
+			return nil
+		})
+		if calls != 1 || len(owned) != 1 || owned[0] != 701 || out != 701 || (err != nil) != failure {
+			t.Fatal("partial native output lost or duplicate replayed", owned, out, err)
+		}
+	}
+	var owned []uintptr
+	if _, err := retainUpgradeSDKDuplicate(&owned, func(*uintptr) error { return nil }); err == nil || len(owned) != 1 || owned[0] != 0 {
+		t.Fatal("zero successful output admitted or slot dropped")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_cohort_transfer_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_cohort_transfer_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..84c2b8e5ea7a63c32be6e149ec838ab957ac3192
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_cohort_transfer_windows.go
@@ -0,0 +1,194 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sort"
+	"unsafe"
+)
+
+// The sole TEMP sender executes this with its original protocol transferred
+// and locked, before start-runtime. This transfers native custody only; source
+// issuer/OS birth sealing and SDK support remain absent.
+func (co *nativeUpgradeSDKCohort) prepareNativeTransfer(ctx context.Context, x *nativeUpgradeSDKCandidateTransfer) (upgradeSDKOwnerCohortWire, error) {
+	var result upgradeSDKOwnerCohortWire
+	if ctx == nil || ctx.Err() != nil || co == nil || x == nil || x.prepared == nil || co.birth != x.prepared.child {
+		return result, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return result, ErrUpgrade
+	}
+	if co.observe(ctx) != nil {
+		return result, ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.unknown || co.transfer != nil || co.root != co.birth.expected || co.sid != x.prepared.grant.wire.Scope.SID || co.ledger.initialTransferComplete() != nil || co.ledger.root == nil || *co.ledger.root != (upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}) || sameUpgradeSDKKernelObject(co.job, co.birth.job) != nil {
+		return result, ErrUpgrade
+	}
+	co.transfer = x // originals remain pinned even on partial duplicate
+	queryJob, err := retainUpgradeSDKDuplicate(&x.inherited, func(slot *windows.Handle) error {
+		return windows.DuplicateHandle(windows.CurrentProcess(), co.job, windows.CurrentProcess(), slot, 0x0004|windows.SYNCHRONIZE, true, 0)
+	})
+	if err != nil {
+		return result, ErrUpgrade
+	}
+	result.Job = uint64(queryJob)
+	generations := make([]upgradeSDKCohortGeneration, 0, len(co.members))
+	for g := range co.members {
+		generations = append(generations, g)
+	}
+	sort.Slice(generations, func(a, b int) bool { return generations[a].PID < generations[b].PID })
+	for _, g := range generations {
+		m := co.members[g]
+		if ctx.Err() != nil || m == nil || m.process == 0 || m.token == 0 || g.Creation < co.root.Creation || recheckUpgradeSDKCohortGeneration(m.process, g) != nil || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil {
+			return result, ErrUpgrade
+		}
+		process, err := retainUpgradeSDKDuplicate(&x.inherited, func(slot *windows.Handle) error {
+			return windows.DuplicateHandle(windows.CurrentProcess(), m.process, windows.CurrentProcess(), slot, windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, true, 0)
+		})
+		if err != nil {
+			return result, ErrUpgrade
+		}
+		token, err := retainUpgradeSDKDuplicate(&x.inherited, func(slot *windows.Handle) error {
+			return windows.DuplicateHandle(windows.CurrentProcess(), windows.Handle(m.token), windows.CurrentProcess(), slot, windows.TOKEN_QUERY, true, 0)
+		})
+		if err != nil {
+			return result, ErrUpgrade
+		}
+		result.Members = append(result.Members, upgradeSDKOwnerMemberWire{uint64(process), uint64(token), g.PID, g.Creation})
+	}
+	total, active, err := co.accounting()
+	if err != nil || co.ledger.observe(total, active) != nil || co.ledger.complete() != nil || uint64(total) != uint64(len(result.Members)) || ctx.Err() != nil {
+		return result, ErrUpgrade
+	}
+	result.Total = total
+	return result, nil
+}
+
+func sameUpgradeSDKKernelObject(one, two windows.Handle) error {
+	if one == 0 || two == 0 || one == windows.InvalidHandle || two == windows.InvalidHandle {
+		return ErrUpgrade
+	}
+	compare := windows.NewLazySystemDLL("kernelbase.dll").NewProc("CompareObjectHandles")
+	if compare.Find() != nil {
+		return ErrUpgrade
+	}
+	same, _, _ := compare.Call(uintptr(one), uintptr(two))
+	if same == 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func upgradeSDKCohortHandleRights(h windows.Handle, required, allowed uint32) error {
+	var info [14]uint32
+	var length uint32
+	status, _, _ := windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryObject").Call(uintptr(h), 0, uintptr(unsafe.Pointer(&info)), unsafe.Sizeof(info), uintptr(unsafe.Pointer(&length)))
+	if status != 0 || length != uint32(unsafe.Sizeof(info)) || info[1]&required != required || info[1]&^allowed != 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func consumeUpgradeSDKCohortInherited(h windows.Handle) error {
+	var flags uint32
+	status, _, _ := anchorGetHandleInformation.Call(uintptr(h), uintptr(unsafe.Pointer(&flags)))
+	if status == 0 || flags&windows.HANDLE_FLAG_INHERIT == 0 || windows.SetHandleInformation(h, windows.HANDLE_FLAG_INHERIT, 0) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func recheckUpgradeSDKCohortGeneration(process windows.Handle, g upgradeSDKCohortGeneration) error {
+	var made, ended, kernel, user windows.Filetime
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(process))
+	if uint32(pid) != g.PID || g.PID == 0 || g.Creation == 0 || windows.GetProcessTimes(process, &made, &ended, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != g.Creation {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func consumeNativeUpgradeSDKCohort(ctx context.Context, o *nativeUpgradeSDKServingOwner) (*nativeUpgradeSDKCohort, error) {
+	if ctx == nil || ctx.Err() != nil || o == nil || o.permit == nil || o.permit.root == nil || o.permit.root.sid == "" || o.cohort != nil || o.process == 0 || o.job == 0 || len(o.wire.Cohort.Members) == 0 || len(o.wire.Cohort.Members) > upgradeSDKCohortBound || uint32(len(o.wire.Cohort.Members)) != o.wire.Cohort.Total {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	co := &nativeUpgradeSDKCohort{receiver: o, job: windows.Handle(o.wire.Cohort.Job), root: UpgradeProcess{o.wire.SDK.PID, o.wire.SDK.Creation, o.wire.SDK.Session, o.wire.SDK.Image}, sid: o.permit.root.sid, members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{}, unknown: true}
+	o.cohort = co // all inherited outputs bound before an inspection can fail
+	upgradeSDKCohortCustody.Lock()
+	upgradeSDKCohortCustody.owners[co] = struct{}{}
+	upgradeSDKCohortCustody.Unlock()
+	for _, wire := range o.wire.Cohort.Members {
+		co.partial = append(co.partial, &nativeUpgradeSDKCohortMember{process: windows.Handle(wire.Process), token: windows.Token(wire.Token)})
+	}
+	if consumeUpgradeSDKCohortInherited(co.job) != nil || upgradeSDKCohortHandleRights(co.job, 0x0004|windows.SYNCHRONIZE, 0x0004|windows.SYNCHRONIZE) != nil || sameUpgradeSDKKernelObject(co.job, o.job) != nil || checkUpgradeSDKJobLimits(co.job) != nil {
+		return co, ErrUpgrade
+	}
+	for n, m := range co.partial {
+		wire := o.wire.Cohort.Members[n]
+		g := upgradeSDKCohortGeneration{wire.PID, wire.Creation}
+		if ctx.Err() != nil || consumeUpgradeSDKCohortInherited(m.process) != nil || consumeUpgradeSDKCohortInherited(windows.Handle(m.token)) != nil || upgradeSDKCohortHandleRights(m.process, windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE) != nil || upgradeSDKCohortHandleRights(windows.Handle(m.token), windows.TOKEN_QUERY, windows.TOKEN_QUERY) != nil || recheckUpgradeSDKCohortGeneration(m.process, g) != nil || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil {
+			return co, ErrUpgrade
+		}
+		var member uint32
+		status, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(m.process), uintptr(co.job), uintptr(unsafe.Pointer(&member)))
+		if status == 0 || member != 1 {
+			return co, ErrUpgrade
+		}
+		var session uint32
+		if windows.ProcessIdToSessionId(g.PID, &session) != nil || session != co.root.Session || recheckUpgradeSDKCohortGeneration(m.process, g) != nil {
+			return co, ErrUpgrade
+		}
+		// Independently inspect this actual process's token. Numeric token/PID
+		// tuples never supply that relation. Retain every output, including any
+		// partial/error return; no unknown close/reopen is attempted.
+		if windows.OpenProcessToken(m.process, windows.TOKEN_QUERY, &m.observedToken) != nil || m.observedToken == 0 {
+			return co, ErrUpgrade
+		}
+		actual, err := legacySDKTokenID(m.observedToken)
+		held, heldErr := legacySDKTokenID(m.token)
+		if err != nil || heldErr != nil || actual != held || legacySDKOrdinaryToken(m.observedToken, co.sid, co.root.Session) != nil {
+			return co, ErrUpgrade
+		}
+		m.generation = g
+		if g == (upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}) {
+			if sameUpgradeSDKKernelObject(m.process, o.process) != nil || queryUpgradeObservedImage(m.process, o.image) != nil || co.ledger.registerRoot(g) != nil {
+				return co, ErrUpgrade
+			}
+		} else if co.ledger.capture(g) != nil {
+			return co, ErrUpgrade
+		}
+		co.members[g] = m
+		state, err := windows.WaitForSingleObject(m.process, 0)
+		if err != nil {
+			return co, ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			var exit uint32
+			if windows.GetExitCodeProcess(m.process, &exit) != nil || recheckUpgradeSDKCohortGeneration(m.process, g) != nil || co.ledger.joined(g) != nil {
+				return co, ErrUpgrade
+			}
+			m.joined = true
+		} else if state != uint32(windows.WAIT_TIMEOUT) {
+			return co, ErrUpgrade
+		}
+	}
+	total, active, err := co.accounting()
+	if err != nil || total != o.wire.Cohort.Total || co.ledger.observe(total, active) != nil || co.ledger.complete() != nil || ctx.Err() != nil {
+		return co, ErrUpgrade
+	}
+	co.unknown = false
+	return co, nil
+}
+
+func (co *nativeUpgradeSDKCohort) requirePreReadyNativeParticipant(ctx context.Context, o *nativeUpgradeSDKServingOwner) error {
+	if co == nil || o == nil || o.cohort != co || co.receiver != o {
+		return ErrUpgrade
+	}
+	return o.adoptNativeSDKLeafMaster(ctx, co)
+}
