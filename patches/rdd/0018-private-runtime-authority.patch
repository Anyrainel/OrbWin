+		leaf := &nativeUpgradeSDKReceivedLeaf{id: v.Leaf, member: m, phase: "capturing"}
+		r.current = leaf
+		co.partial = append(co.partial, m) // all native partial outputs retained first
+		rights := uint32(windows.PROCESS_QUERY_INFORMATION | windows.SYNCHRONIZE)
+		if windows.DuplicateHandle(o.process, windows.Handle(v.Process), windows.CurrentProcess(), &m.process, rights, false, 0) != nil || m.process == 0 || m.process == windows.InvalidHandle {
+			return empty, ErrUpgrade
+		}
+		if upgradeSDKCohortHandleRights(m.process, rights, rights|windows.PROCESS_QUERY_LIMITED_INFORMATION) != nil || recheckUpgradeSDKCohortGeneration(m.process, g) != nil {
+			return empty, ErrUpgrade
+		}
+		state, e := windows.WaitForSingleObject(m.process, 0)
+		if e != nil || state != uint32(windows.WAIT_TIMEOUT) {
+			return empty, ErrUpgrade
+		}
+		var membership uint32
+		ok, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(m.process), uintptr(co.job), uintptr(unsafe.Pointer(&membership)))
+		var basic windows.PROCESS_BASIC_INFORMATION
+		var size, session uint32
+		if ok == 0 || membership != 1 || windows.NtQueryInformationProcess(m.process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || uint32(basic.UniqueProcessId) != g.PID || uint32(basic.InheritedFromUniqueProcessId) != co.root.PID || windows.ProcessIdToSessionId(g.PID, &session) != nil || session != co.root.Session || queryUpgradeObservedImage(m.process, o.image) != nil {
+			return empty, ErrUpgrade
+		}
+		if windows.OpenProcessToken(m.process, windows.TOKEN_QUERY, &m.token) != nil || m.token == 0 || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil || recheckUpgradeSDKCohortGeneration(m.process, g) != nil {
+			return empty, ErrUpgrade
+		}
+		m.generation = g
+		if co.members[g] != nil || co.ledger.captureIssuedLeaf(g, v.Leaf) != nil {
+			return empty, ErrUpgrade
+		}
+		co.members[g] = m
+		if len(co.partial) == 0 || co.partial[len(co.partial)-1] != m {
+			return empty, ErrUpgrade
+		}
+		co.partial = co.partial[:len(co.partial)-1] // actual member map now owns it
+		if r.reconcileLocked() != nil {
+			return empty, ErrUpgrade
+		}
+		leaf.phase = "birth-ack"
+		ack.Process = uint64(m.process)
+		return ack, nil
+	}
+	leaf := r.current
+	if leaf == nil || leaf.id != v.Leaf || leaf.member == nil || leaf.member.generation != g || co.members[g] != leaf.member {
+		return empty, ErrUpgrade
+	}
+	m := leaf.member
+	if v.Kind == "stopped" {
+		if leaf.phase != "running" || leaf.stopQuery != 0 || leaf.stopQueryClose.attempted {
+			return empty, ErrUpgrade
+		}
+		rights := uint32(windows.PROCESS_QUERY_INFORMATION | windows.SYNCHRONIZE)
+		if windows.DuplicateHandle(o.process, windows.Handle(v.Process), windows.CurrentProcess(), &leaf.stopQuery, rights, false, 0) != nil || leaf.stopQuery == 0 || sameUpgradeSDKKernelObject(leaf.stopQuery, m.process) != nil || upgradeSDKCohortHandleRights(leaf.stopQuery, rights, rights|windows.PROCESS_QUERY_LIMITED_INFORMATION) != nil {
+			return empty, ErrUpgrade
+		}
+		state, e := windows.WaitForSingleObject(m.process, 0)
+		var exit uint32
+		if e != nil || state != uint32(windows.WAIT_OBJECT_0) || windows.GetExitCodeProcess(m.process, &exit) != nil || recheckUpgradeSDKCohortGeneration(m.process, g) != nil || legacySDKOrdinaryToken(m.token, co.sid, co.root.Session) != nil || leaf.stopQueryClose.close(&leaf.stopQuery) != nil || r.reconcileLocked() != nil || co.ledger.joined(g) != nil {
+			return empty, ErrUpgrade
+		}
+		m.joined = true
+		leaf.phase = "stopped-ack"
+		ack.Process = uint64(m.process)
+		return ack, nil
+	}
+	if v.Kind != "closed" || leaf.phase != "stopped" || !m.joined || v.Process != 0 || r.reconcileLocked() != nil {
+		return empty, ErrUpgrade
+	}
+	// Only this actual captured member is compacted, after producer closed ACK,
+	// positive same-generation wait, and every receiver query/token checked close.
+	token := windows.Handle(m.token)
+	if leaf.tokenClose.close(&token) != nil {
+		return empty, ErrUpgrade
+	}
+	m.token = 0
+	if m.observedToken != 0 {
+		observed := windows.Handle(m.observedToken)
+		if leaf.observedTokenClose.close(&observed) != nil {
+			return empty, ErrUpgrade
+		}
+		m.observedToken = 0
+	}
+	if leaf.processClose.close(&m.process) != nil || co.ledger.compact(g) != nil {
+		return empty, ErrUpgrade
+	}
+	if co.removeClosedPartial(m) != nil {
+		return empty, ErrUpgrade
+	}
+	delete(co.members, g)
+	leaf.phase = "closed-ack"
+	return ack, nil
+}
+
+// co.mu held. Only the exact fully closed and already compacted member loses
+// any optional aliases. The members map is the owner after successful birth;
+// a map-only member is valid. A foreign pointer with the same tuple refuses.
+func (co *nativeUpgradeSDKCohort) removeClosedPartial(m *nativeUpgradeSDKCohortMember) error {
+	if co == nil || m == nil || m.process != 0 || m.token != 0 || m.observedToken != 0 || co.members[m.generation] != m || m.generation == (upgradeSDKCohortGeneration{co.root.PID, co.root.Creation}) {
+		return ErrUpgrade
+	}
+	if _, still := co.ledger.members[m.generation]; still || co.ledger.complete() != nil {
+		return ErrUpgrade
+	}
+	for _, part := range co.partial {
+		if part == nil || part != m && part.generation == m.generation {
+			return ErrUpgrade
+		}
+	}
+	kept := co.partial[:0]
+	for _, part := range co.partial {
+		if part != m {
+			kept = append(kept, part)
+		}
+	}
+	for i := len(kept); i < len(co.partial); i++ {
+		co.partial[i] = nil
+	}
+	co.partial = kept
+	return nil
+}
+
+// Caller holds actual cohort.mu. Counts only reconcile captured native members;
+// neither zero active processes nor this observation grants scope retirement.
+func (r *nativeUpgradeSDKLeafReceiver) reconcileLocked() error {
+	total, active, e := r.cohort.accounting()
+	if e != nil || r.cohort.ledger.observe(total, active) != nil || r.cohort.ledger.complete() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
