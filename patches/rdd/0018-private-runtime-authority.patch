@@ -0,0 +1,117 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"path/filepath"
+	"strings"
+)
+
+// Historical observation/retirement allowlist, never new execution admission.
+// Exact selected old services/IPC source provenance is recorded in
+// p2-legacy-sdk-static-order-20261026/selected-order-review.json.
+const upgradeLegacySDKImageSHA256 = "8f118fb18b233c70a6cf7c9d2284de7c3b02fca90f6be09395cdd9943cfdb8d5"
+const upgradeLegacySDKReplyLimit = 1 << 20
+
+func upgradeLegacySDKPipe(home, daemon string) (string, error) {
+	hexID := strings.ReplaceAll(daemon, "-", "")
+	if !filepath.IsAbs(home) || len(home) > 1024 || strings.ContainsAny(home+daemon, "\x00\r\n") || !upgradeHex(hexID, 32) || len(daemon) != 32 && !(len(daemon) == 36 && daemon[8] == '-' && daemon[13] == '-' && daemon[18] == '-' && daemon[23] == '-') {
+		return "", ErrUpgrade
+	}
+	sum := sha256.Sum256([]byte(strings.ToLower(filepath.Clean(home)) + "\x00" + daemon))
+	return `\\.\pipe\OrbWinLocalServices-` + hex.EncodeToString(sum[:16]), nil
+}
+
+type upgradeLegacySDKReply struct {
+	Version   int             `json:"version"`
+	State     json.RawMessage `json:"state,omitempty"`
+	Authority json.RawMessage `json:"authority,omitempty"`
+	Error     string          `json:"error,omitempty"`
+}
+
+// Only these exact old operations exist here. No current SDK client fallback,
+// generic dispatcher, configure/trust/rule command or caller-supplied request.
+func callUpgradeLegacySDK(stream io.ReadWriter, operation string, before, after func() error) (upgradeLegacySDKReply, error) {
+	var reply upgradeLegacySDKReply
+	var request []byte
+	switch operation {
+	case "snapshot":
+		request = []byte(`{"version":1,"operation":"snapshot"}`)
+	case "stop-process":
+		request = []byte(`{"version":1,"operation":"stop-process"}`)
+	default:
+		return reply, ErrUpgrade
+	}
+	if stream == nil || before == nil || after == nil || before() != nil {
+		return reply, ErrUpgrade
+	}
+	var header [4]byte
+	binary.LittleEndian.PutUint32(header[:], uint32(len(request)))
+	for _, body := range [][]byte{header[:], request} {
+		for len(body) > 0 {
+			n, err := stream.Write(body)
+			if err != nil || n < 1 || n > len(body) {
+				return reply, ErrUpgrade
+			}
+			body = body[n:]
+		}
+	}
+	if _, err := io.ReadFull(stream, header[:]); err != nil {
+		return reply, ErrUpgrade
+	}
+	size := binary.LittleEndian.Uint32(header[:])
+	if size == 0 || size > upgradeLegacySDKReplyLimit {
+		return reply, ErrUpgrade
+	}
+	data := make([]byte, size)
+	if _, err := io.ReadFull(stream, data); err != nil || json.Unmarshal(data, &reply) != nil {
+		return upgradeLegacySDKReply{}, ErrUpgrade
+	}
+	canonical, err := json.Marshal(reply)
+	if err != nil || !bytes.Equal(canonical, data) || reply.Version != 1 || reply.Error != "" || len(reply.State) == 0 || bytes.Equal(reply.State, []byte("null")) || after() != nil {
+		return upgradeLegacySDKReply{}, ErrUpgrade
+	}
+	return reply, nil
+}
+
+// Native process/pipe identity and the exact old argv recipe establish owner
+// scope. Snapshot fields remain untrusted correlation data; flags/phase/empty
+// inventories can never establish retirement, cleanup or code authority.
+func validateUpgradeLegacySDKSnapshot(reply upgradeLegacySDKReply, daemon string) error {
+	var state struct {
+		DaemonID     string `json:"daemonId"`
+		Installation string `json:"installation"`
+		BinarySHA256 string `json:"binarySha256"`
+	}
+	if json.Unmarshal(reply.State, &state) != nil || state.DaemonID != daemon || state.Installation != daemon || state.BinarySHA256 != upgradeLegacySDKImageSHA256 {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func validateUpgradeLegacySDKArgs(args []string, image, home, daemon string) bool {
+	if len(args) != 7 && len(args) != 9 {
+		return false
+	}
+	return strings.EqualFold(args[0], image) && args[1] == "local-services-serve" && strings.EqualFold(args[2], home) && args[3] == daemon && args[4] == daemon
+}
+
+func closeOwnerLastLegacySDK(resources []func() error, owner func() error) error {
+	for _, close := range resources {
+		if close() != nil {
+			return ErrUpgrade
+		}
+	}
+	if owner() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func upgradeLegacySDKChildLifetime(child, parentStart, parentEnd uint64, retired bool) bool {
+	return parentStart != 0 && child > parentStart && (!retired || parentEnd > parentStart && child < parentEnd)
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_legacy_owner_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_legacy_owner_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..96587b74e0dc10b8f3ec4dc7fc664d0248fd2724
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_legacy_owner_windows.go
@@ -0,0 +1,152 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"sort"
+	"sync"
+)
+
+// One actual SDK participant of the existing migration owner. This is NOT the
+// combined management/WSL/publication retirement provider: those independent
+// owners remain required. It never starts/stops an engine or a distribution.
+type nativeUpgradeLegacySDKOwner struct {
+	mu              sync.Mutex
+	peer            *nativeUpgradeLegacySDKPeer
+	helpers         *nativeUpgradeLegacySDKHelpers
+	digest          [32]byte
+	unknown, closed bool
+	closeErr        error
+}
+
+func captureUpgradeLegacySDKOwner(ctx context.Context, root *InstanceRoot, recorder *upgradeRecorder) (*nativeUpgradeLegacySDKOwner, error) {
+	if root == nil || root.selection == nil || recorder == nil {
+		return nil, ErrUpgrade
+	}
+	if err := requireUpgradeNoOuterJob(ctx, queryUpgradeOuterJob); err != nil {
+		return nil, err
+	}
+	o := &nativeUpgradeLegacySDKOwner{}
+	var err error
+	o.peer, err = captureUpgradeLegacySDKPeer(ctx, root, recorder)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	o.helpers, err = captureUpgradeLegacySDKHelpers(ctx, o.peer)
+	if err != nil {
+		return o, ErrUpgrade
+	}
+	return o, nil
+}
+
+func (o *nativeUpgradeLegacySDKOwner) interrupt(ctx context.Context) error {
+	if o == nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown || o.peer == nil || o.helpers == nil {
+		return ErrUpgrade
+	}
+	if err := requireUpgradeNoOuterJob(ctx, queryUpgradeOuterJob); err != nil {
+		return err
+	}
+	o.peer.mu.Lock()
+	alreadyDispatched := o.peer.stopDispatched
+	o.peer.mu.Unlock()
+	if alreadyDispatched {
+		return ErrUpgrade
+	}
+	err := o.peer.stop(ctx, o.helpers)
+	if err != nil {
+		o.peer.mu.Lock()
+		o.unknown = o.peer.unknown || o.peer.stopDispatched
+		o.peer.mu.Unlock()
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (o *nativeUpgradeLegacySDKOwner) recheckUpgradeLegacySDK(ctx context.Context, journal upgradeJournal) ([32]byte, error) {
+	if o == nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown || o.peer == nil || o.helpers == nil || !journal.valid() || journal.Recovery.Schema != 0 || !upgradeIntentEqual(o.peer.scope, journal) || o.peer.recheckRetired(ctx) != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	o.helpers.mu.Lock()
+	processes := make([]UpgradeProcess, 0, len(o.helpers.children))
+	seen := map[UpgradeProcess]bool{}
+	for _, child := range o.helpers.children {
+		if !seen[child.expected] {
+			seen[child.expected] = true
+			processes = append(processes, child.expected)
+		}
+	}
+	wslObject, wslHash := o.helpers.wsl.object, o.helpers.wsl.hash
+	o.helpers.mu.Unlock()
+	sort.Slice(processes, func(i, j int) bool {
+		if processes[i].PID == processes[j].PID {
+			return processes[i].Creation < processes[j].Creation
+		}
+		return processes[i].PID < processes[j].PID
+	})
+	// This digest correlates immutable native facts. Every return still requires
+	// the live original SDK/controller/ingress/helper owners above; bytes cannot
+	// reconstruct this participant or stand in for combined rdd retirement.
+	data, err := json.Marshal(struct {
+		SDK                   UpgradeProcess
+		Root, Controller, WSL UpgradeObject
+		WSLImage              [32]byte
+		Helpers               []UpgradeProcess
+		Daemon, SID           string
+	}{o.peer.expected, o.peer.legacyRootID, o.peer.controllerID, wslObject, wslHash, processes, journal.Daemon, o.peer.root.sid})
+	if err != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	digest := sha256.Sum256(data)
+	if o.digest != [32]byte{} && o.digest != digest {
+		return [32]byte{}, ErrUpgrade
+	}
+	o.digest = digest
+	return digest, nil
+}
+
+func (o *nativeUpgradeLegacySDKOwner) Close() error {
+	if o == nil {
+		return nil
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown {
+		return ErrUpgrade
+	}
+	if o.closed {
+		return o.closeErr
+	}
+	// Admitted Stop retains its actual peer/helper/controller graph for the
+	// native SDK denial/new-owner handoff. Observation-only refusals may close.
+	if o.peer != nil {
+		o.peer.mu.Lock()
+		admitted := o.peer.stopDispatched
+		o.peer.mu.Unlock()
+		if admitted {
+			return ErrUpgrade
+		}
+	}
+	o.closed = true
+	if o.helpers != nil && o.helpers.Close() != nil {
+		o.closeErr = ErrUpgrade
+		return o.closeErr
+	}
+	if o.peer != nil && o.peer.Close() != nil {
+		o.closeErr = ErrUpgrade
+		return o.closeErr
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_legacy_test.go b/rdd/pkg/managementconfig/upgrade_sdk_legacy_test.go
