+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// Set by the rdd build AFTER producing/signing the selected SDK bundle. Empty
+// developer pins refuse before native I/O. No environment, JSON, path or caller
+// hash may select SDK code. The existing frontend remains the sole publisher.
+var upgradeSDKManagerSHA256 string
+var upgradeSDKManifestSHA256 string
+var upgradeSDKSignatureSHA256 string
+var upgradeSDKHelperSHA256 string
+var upgradeSDKWorkerSHA256 string
+var upgradeSDKBundlePublicKeyHex string
+
+type upgradeSDKCodePins struct {
+	files [5][32]byte // manager, manifest, signature, helper, worker
+	key   [32]byte
+}
+
+func compiledUpgradeSDKPins() (upgradeSDKCodePins, error) {
+	return parseUpgradeSDKPins([6]string{upgradeSDKManagerSHA256, upgradeSDKManifestSHA256, upgradeSDKSignatureSHA256, upgradeSDKHelperSHA256, upgradeSDKWorkerSHA256, upgradeSDKBundlePublicKeyHex})
+}
+
+// Pure validation seam; only compiledUpgradeSDKPins calls it in production.
+func parseUpgradeSDKPins(values [6]string) (upgradeSDKCodePins, error) {
+	var pins upgradeSDKCodePins
+	for i, value := range values {
+		if !upgradeHex(value, 64) {
+			return upgradeSDKCodePins{}, ErrUpgrade
+		}
+		data, err := hex.DecodeString(value)
+		if err != nil || len(data) != 32 {
+			return upgradeSDKCodePins{}, ErrUpgrade
+		}
+		if i < 5 {
+			copy(pins.files[i][:], data)
+		} else {
+			copy(pins.key[:], data)
+		}
+	}
+	return pins, nil
+}
+
+// Wire/domain match the SDK's lanhelper.asset_bundle v1. This narrow reader
+// keeps independent compiled file pins as well as the detached signature; the
+// SDK module's internal package cannot be imported across the module boundary.
+type upgradeSDKBundleAsset struct {
+	Role   string `json:"role"`
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+	Size   uint64 `json:"size"`
+}
+type upgradeSDKBundle struct {
+	Version int                     `json:"version"`
+	Assets  []upgradeSDKBundleAsset `json:"assets"`
+}
+
+func verifyUpgradeSDKBundle(data, signature []byte, pins upgradeSDKCodePins) ([5]uint64, error) {
+	var sizes [5]uint64
+	if len(data) == 0 || len(data) > 4096 || len(signature) != 88 || sha256.Sum256(data) != pins.files[1] || sha256.Sum256(signature) != pins.files[2] || pins.key == [32]byte{} {
+		return sizes, ErrUpgrade
+	}
+	sig, err := base64.StdEncoding.Strict().DecodeString(string(signature))
+	if err != nil || len(sig) != ed25519.SignatureSize || base64.StdEncoding.EncodeToString(sig) != string(signature) || !ed25519.Verify(ed25519.PublicKey(pins.key[:]), append([]byte("orbwin-lan-asset-bundle-v1\n"), data...), sig) {
+		return sizes, ErrUpgrade
+	}
+	var bundle upgradeSDKBundle
+	if json.Unmarshal(data, &bundle) != nil || bundle.Version != 1 || len(bundle.Assets) != 3 {
+		return sizes, ErrUpgrade
+	}
+	canonical, err := json.Marshal(bundle)
+	if err != nil || !bytes.Equal(canonical, data) {
+		return sizes, ErrUpgrade
+	}
+	roles := [3]string{"manager", "helper", "worker"}
+	paths := [3]string{"orbwin-session.exe", "lan/orbwin-lan-helper.exe", "lan/orbwin-lan-worker.exe"}
+	indices := [3]int{0, 3, 4}
+	limits := [3]uint64{256 << 20, 64 << 20, 64 << 20}
+	for i, asset := range bundle.Assets {
+		index := indices[i]
+		if asset.Role != roles[i] || asset.Path != paths[i] || asset.SHA256 != hex.EncodeToString(pins.files[index][:]) || pins.files[index] == [32]byte{} || asset.Size == 0 || asset.Size > limits[i] {
+			return [5]uint64{}, ErrUpgrade
+		}
+		sizes[index] = asset.Size
+	}
+	sizes[1], sizes[2] = uint64(len(data)), uint64(len(signature))
+	return sizes, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_image_test.go b/rdd/pkg/managementconfig/upgrade_sdk_image_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f7ebceca21ad555a05d830f0a46943ce74a51290
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_image_test.go
@@ -0,0 +1,114 @@
+package managementconfig
+
+import (
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func upgradeSDKBundleFixture(t *testing.T) (upgradeSDKCodePins, []byte, []byte, ed25519.PrivateKey) {
+	t.Helper()
+	seed := sha256.Sum256([]byte("inert SDK code bundle contract fixture"))
+	key := ed25519.NewKeyFromSeed(seed[:])
+	var pins upgradeSDKCodePins
+	copy(pins.key[:], key.Public().(ed25519.PublicKey))
+	for _, i := range []int{0, 3, 4} {
+		pins.files[i] = sha256.Sum256([]byte{byte(i), 1, 2, 3})
+	}
+	bundle := upgradeSDKBundle{Version: 1, Assets: []upgradeSDKBundleAsset{
+		{"manager", "orbwin-session.exe", hex.EncodeToString(pins.files[0][:]), 4},
+		{"helper", "lan/orbwin-lan-helper.exe", hex.EncodeToString(pins.files[3][:]), 4},
+		{"worker", "lan/orbwin-lan-worker.exe", hex.EncodeToString(pins.files[4][:]), 4},
+	}}
+	data, _ := json.Marshal(bundle)
+	signature := []byte(base64.StdEncoding.EncodeToString(ed25519.Sign(key, append([]byte("orbwin-lan-asset-bundle-v1\n"), data...))))
+	pins.files[1], pins.files[2] = sha256.Sum256(data), sha256.Sum256(signature)
+	return pins, data, signature, key
+}
+
+func TestUpgradeSDKCodePinsRequireEveryIndependentCompiledRole(t *testing.T) {
+	for index := 0; index < 6; index++ {
+		for _, invalid := range []string{"", strings.Repeat("0", 64), strings.Repeat("A", 64), strings.Repeat("a", 63), "../orbwin-session.exe", strings.Repeat("a", 64) + "\n"} {
+			var values [6]string
+			for n := range values {
+				values[n] = strings.Repeat("a", 64)
+			}
+			values[index] = invalid
+			if _, err := parseUpgradeSDKPins(values); err == nil {
+				t.Fatalf("accepted unconfigured/noncanonical code role %d", index)
+			}
+		}
+	}
+	if _, err := parseUpgradeSDKPins([6]string{}); err == nil {
+		t.Fatal("developer defaults admitted SDK execution")
+	}
+}
+
+func TestUpgradeSDKBundleBindsActualFixedRolesToIndependentPins(t *testing.T) {
+	pins, data, signature, _ := upgradeSDKBundleFixture(t)
+	sizes, err := verifyUpgradeSDKBundle(data, signature, pins)
+	if err != nil || sizes != [5]uint64{4, uint64(len(data)), 88, 4, 4} {
+		t.Fatal(sizes, err)
+	}
+	for _, index := range []int{0, 1, 2, 3, 4} {
+		changed := pins
+		changed.files[index][0]++
+		if _, err := verifyUpgradeSDKBundle(data, signature, changed); err == nil {
+			t.Fatalf("signed bundle replaced compiled code pin %d", index)
+		}
+	}
+	changed := pins
+	changed.key[0]++
+	if _, err := verifyUpgradeSDKBundle(data, signature, changed); err == nil {
+		t.Fatal("foreign signer accepted")
+	}
+}
+
+func TestUpgradeSDKBundleRejectsEvenSignedNoncanonicalOrUnsupportedCatalog(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		change func(upgradeSDKBundle) []byte
+	}{
+		{"unknown field", func(b upgradeSDKBundle) []byte {
+			data, _ := json.Marshal(b)
+			return []byte(strings.Replace(string(data), `"version":1`, `"version":1,"extra":true`, 1))
+		}},
+		{"duplicate field", func(b upgradeSDKBundle) []byte {
+			data, _ := json.Marshal(b)
+			return []byte(strings.Replace(string(data), `"version":1`, `"version":1,"version":1`, 1))
+		}},
+		{"trailing whitespace", func(b upgradeSDKBundle) []byte { data, _ := json.Marshal(b); return append(data, '\n') }},
+		{"wrong path", func(b upgradeSDKBundle) []byte {
+			b.Assets[0].Path = "other.exe"
+			data, _ := json.Marshal(b)
+			return data
+		}},
+		{"wrong order", func(b upgradeSDKBundle) []byte {
+			b.Assets[0], b.Assets[1] = b.Assets[1], b.Assets[0]
+			data, _ := json.Marshal(b)
+			return data
+		}},
+		{"oversize", func(b upgradeSDKBundle) []byte {
+			b.Assets[1].Size = 64<<20 + 1
+			data, _ := json.Marshal(b)
+			return data
+		}},
+		{"missing role", func(b upgradeSDKBundle) []byte { b.Assets = b.Assets[:2]; data, _ := json.Marshal(b); return data }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pins, data, _, key := upgradeSDKBundleFixture(t)
+			var bundle upgradeSDKBundle
+			_ = json.Unmarshal(data, &bundle)
+			data = tc.change(bundle)
+			signature := []byte(base64.StdEncoding.EncodeToString(ed25519.Sign(key, append([]byte("orbwin-lan-asset-bundle-v1\n"), data...))))
+			pins.files[1], pins.files[2] = sha256.Sum256(data), sha256.Sum256(signature)
+			if _, err := verifyUpgradeSDKBundle(data, signature, pins); err == nil {
+				t.Fatal("unsupported signed catalog accepted")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_image_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_image_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..83e761624b87fc6f82f45b230714571ec3de204f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_image_windows.go
@@ -0,0 +1,316 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"golang.org/x/sys/windows"
+	"io"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+)
+
+type upgradeSDKCodeObject struct {
+	handle             windows.Handle
+	id                 UpgradeObject
+	directory, private bool
+	size               uint64
+	attributes         uint32
+	written            windows.Filetime
+}
+
+// Independent fixed SDK code role; never a widening of the rdd ImageLease.
+// Every native file denies write/delete sharing. Ancestors deny deletion;
+// private cache objects require the exact existing protected three-ACE policy.
+type nativeUpgradeSDKImage struct {
+	mu          sync.Mutex
+	root        *InstanceRoot
+	pins        upgradeSDKCodePins
+	held        []upgradeSDKCodeObject
+	files       [5]windows.Handle
+	sizes       [5]uint64
+	path        string
+	bundle, lan windows.Handle
+	closed      bool
+	closeErr    error
+}
+
+func (*nativeUpgradeSDKImage) String() string   { return "held independently pinned SDK code" }
+func (*nativeUpgradeSDKImage) GoString() string { return "held independently pinned SDK code" }
+
+func (i *nativeUpgradeSDKImage) Close() error {
+	if i == nil {
+		return nil
+	}
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if i.closed {
+		return i.closeErr
+	}
+	i.closed = true
+	for n := len(i.held) - 1; n >= 0; n-- {
+		if windows.CloseHandle(i.held[n].handle) != nil {
+			i.closeErr = ErrUpgrade
+			return i.closeErr
+		}
+		i.held[n].handle = 0
+	}
+	return nil
+}
+
+func (i *nativeUpgradeSDKImage) hold(h windows.Handle, directory, private bool) error {
+	i.held = append(i.held, upgradeSDKCodeObject{handle: h, directory: directory, private: private})
+	o := &i.held[len(i.held)-1]
+	var err error
+	if objectKind(h, directory) != nil {
+		return ErrUpgrade
+	}
+	if private {
+		err = verifyPrivate(h, i.root.sid, directory)
+	} else {
+		err = checkReadObject(h, i.root.sid, directory)
+	}
+	if err != nil {
+		return ErrUpgrade
+	}
+	o.id, err = upgradeObjectID(h)
+	var info windows.ByHandleFileInformation
+	if err != nil || windows.GetFileInformationByHandle(h, &info) != nil {
+		return ErrUpgrade
+	}
+	o.size, o.attributes, o.written = uint64(info.FileSizeHigh)<<32|uint64(info.FileSizeLow), info.FileAttributes, info.LastWriteTime
+	return nil
+}
+
+func holdUpgradeSDKImage(ctx context.Context, root *InstanceRoot) (out *nativeUpgradeSDKImage, result error) {
+	pins, err := compiledUpgradeSDKPins() // Refuse empty development builds BEFORE native I/O.
+	if err != nil || root == nil || root.selection == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != root.sid || sid != root.selection.Owner() {
+		return nil, ErrUpgrade
+	}
+	profile := root.selection.Profile()
+	volume, parts, err := readerComponents(filepath.Join(profile, ".orbwin-private", "runtime", "orbwin-session-"+hex.EncodeToString(pins.files[1][:])))
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	_, profileParts, err := readerComponents(profile)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	i := &nativeUpgradeSDKImage{root: root, pins: pins}
+	ok := false
+	defer func() {
+		if !ok {
+			if i.Close() != nil {
+				out = i
+			}
+			result = ErrUpgrade
+		}
+	}()
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	if i.hold(h, true, false) != nil {
+		return nil, ErrUpgrade
+	}
+	for n, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		h, err = openRelative(h, part, true, nil, false)
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		if i.hold(h, true, n >= len(profileParts)) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	bundle := h
+	i.bundle = bundle
+	i.files[0], err = openRelative(bundle, "orbwin-session.exe", false, nil, false)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	if i.hold(i.files[0], false, true) != nil {
+		return nil, ErrUpgrade
+	}
+	lan, err := openRelative(bundle, "lan", true, nil, false)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	if i.hold(lan, true, true) != nil {
+		return nil, ErrUpgrade
+	}
+	i.lan = lan
+	for n, name := range []string{"assets.json", "assets.sig", "orbwin-lan-helper.exe", "orbwin-lan-worker.exe"} {
+		i.files[n+1], err = openRelative(lan, name, false, nil, false)
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		if i.hold(i.files[n+1], false, true) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if !upgradeSDKCodeNames(bundle, []string{"orbwin-session.exe", "lan"}) || !upgradeSDKCodeNames(lan, []string{"assets.json", "assets.sig", "orbwin-lan-helper.exe", "orbwin-lan-worker.exe"}) {
+		return nil, ErrUpgrade
+	}
+	data, err := readUpgradeSDKCode(ctx, i.files[1], 4096)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	sig, err := readUpgradeSDKCode(ctx, i.files[2], 88)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	i.sizes, err = verifyUpgradeSDKBundle(data, sig, pins)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	for n, file := range i.files {
+		if hashUpgradeSDKCode(ctx, file, i.sizes[n], pins.files[n]) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	i.path = filepath.Join(profile, ".orbwin-private", "runtime", "orbwin-session-"+hex.EncodeToString(pins.files[1][:]), "orbwin-session.exe")
+	actual, err := upgradeWorkingPath(i.files[0])
+	if err != nil || !strings.EqualFold(actual, i.path) || i.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	ok = true
+	return i, nil
+}
+
+func upgradeSDKCodeNames(parent windows.Handle, want []string) bool {
+	names, err := upgradeStoreNames(parent)
+	if err != nil || len(names) != len(want) {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		seen[name] = true
+	}
+	for _, name := range want {
+		if !seen[name] {
+			return false
+		}
+	}
+	return true
+}
+
+func readUpgradeSDKCode(ctx context.Context, h windows.Handle, limit uint32) ([]byte, error) {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > limit {
+		return nil, ErrUpgrade
+	}
+	if _, err := windows.Seek(h, 0, io.SeekStart); err != nil {
+		return nil, ErrUpgrade
+	}
+	data := make([]byte, info.FileSizeLow)
+	for offset := 0; offset < len(data); {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		var n uint32
+		if windows.ReadFile(h, data[offset:], &n, nil) != nil || n == 0 || uint64(n) > uint64(len(data)-offset) {
+			return nil, ErrUpgrade
+		}
+		offset += int(n)
+	}
+	return data, nil
+}
+
+func hashUpgradeSDKCode(ctx context.Context, h windows.Handle, size uint64, expected [32]byte) error {
+	if size == 0 || size > 256<<20 || expected == [32]byte{} {
+		return ErrUpgrade
+	}
+	if _, err := windows.Seek(h, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total uint64
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		var n uint32
+		err := windows.ReadFile(h, buffer, &n, nil)
+		total += uint64(n)
+		if total > size {
+			return ErrUpgrade
+		}
+		if n > 0 {
+			_, _ = hash.Write(buffer[:n])
+		}
+		if err == windows.ERROR_HANDLE_EOF || err == nil && n == 0 {
+			break
+		}
+		if err != nil {
+			return ErrUpgrade
+		}
+	}
+	var actual [32]byte
+	copy(actual[:], hash.Sum(nil))
+	if total != size || actual != expected {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (i *nativeUpgradeSDKImage) recheck(ctx context.Context) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	return i.recheckLocked(ctx)
+}
+
+// Caller holds i.mu and the current locked OS thread through native launch.
+func (i *nativeUpgradeSDKImage) recheckLocked(ctx context.Context) error {
+	if i.closed || i.closeErr != nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	sid, err := currentOwner()
+	if err != nil || sid != i.root.sid {
+		return ErrUpgrade
+	}
+	for _, o := range i.held {
+		id, err := upgradeObjectID(o.handle)
+		var info windows.ByHandleFileInformation
+		if err != nil || id != o.id || objectKind(o.handle, o.directory) != nil || windows.GetFileInformationByHandle(o.handle, &info) != nil || info.FileAttributes != o.attributes || !o.directory && (uint64(info.FileSizeHigh)<<32|uint64(info.FileSizeLow) != o.size || info.LastWriteTime != o.written) {
+			return ErrUpgrade
+		}
+		if o.private {
+			err = verifyPrivate(o.handle, sid, o.directory)
+		} else {
+			err = checkReadObject(o.handle, sid, o.directory)
+		}
+		if err != nil {
+			return ErrUpgrade
+		}
+	}
+	if !upgradeSDKCodeNames(i.bundle, []string{"orbwin-session.exe", "lan"}) || !upgradeSDKCodeNames(i.lan, []string{"assets.json", "assets.sig", "orbwin-lan-helper.exe", "orbwin-lan-worker.exe"}) {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_inventory.go b/rdd/pkg/managementconfig/upgrade_sdk_inventory.go
new file mode 100644
index 0000000000000000000000000000000000000000..60e4a2dd3710cbe29daa210f7f438f9697af50e1
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_inventory.go
@@ -0,0 +1,170 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"regexp"
+)
+
+// Exact SDK TransitionReceipt wire. Inventory is correlation only: production
+// accepts it exclusively from the actual mapped SDK child's original control
+// capability and keeps that native child/retirement graph alive afterward.
+type upgradeSDKInventoryFile struct {
+	Name, Source, Target, Disposition string
+	Size                              uint64
+	SHA256                            [32]byte
+}
+type upgradeSDKInventory struct {
+	Schema                                                      int
+	Scope                                                       upgradeSDKGrantScope
+	LegacyRoot, LegacyController, Root, Init, Fence, Quarantine string
+	Files                                                       []upgradeSDKInventoryFile
+	Inventory, Active, Historical                               [32]byte
+}
+type upgradeSDKControlRequest struct {
+	Schema, Sequence uint32
+	Operation        string
+	Supervisor       *upgradeSDKSupervisorWire `json:",omitempty"`
+	Master           *upgradeSDKLeafMasterWire `json:",omitempty"`
+	Leaf             *upgradeSDKLeafAckWire    `json:",omitempty"`
+}
+type upgradeSDKSupervisorWire struct {
+	Process  uint64
+	PID      uint32
+	Creation uint64
+	Session  uint32
+	Image    [32]byte
+}
+type upgradeSDKControlReply struct {
+	Schema, Sequence uint32
+	Stage            string
+	Receipt          *upgradeSDKInventory
+	Controller       *[4]uint64               `json:",omitempty"`
+	Leaf             *upgradeSDKLeafOfferWire `json:",omitempty"`
+	Error            string
+}
+
+var upgradeSDKRecordPatterns = []struct {
+	pattern *regexp.Regexp
+	budget  uint64
+}{
+	{regexp.MustCompile(`^lan-review-[a-f0-9]{32}\.json$`), 64 << 10},
+	{regexp.MustCompile(`^namespace-[a-f0-9]{32}\.jsonl$`), 8192},
+	{regexp.MustCompile(`^relay-[a-f0-9]{32}\.receipt$`), 128 << 10},
+	{regexp.MustCompile(`^tools-image-[a-f0-9]{64}(?:-[a-f0-9]{32}\.archived-receipt|\.receipt)$`), 4096},
+	{regexp.MustCompile(`^(?:windows-trust-[a-f0-9]{64}|wsl-trust-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}-[a-f0-9]{64})\.json$`), 32768},
+	{regexp.MustCompile(`^(?:\.rotation-[a-f0-9]{64}\.(?:old|new)|authority-(?:retired|abandoned)-[a-f0-9]{64}\.pem)$`), 128 << 10},
+}
+
+func upgradeSDKRecordBudget(name string) uint64 {
+	switch name {
+	case "authority-v1.json", "settings-v1.json":
+		return 128 << 10
+	case "authority-rotation-v1.json":
+		return 384 << 10
+	case "lan-identity.json":
+		return 2048
+	}
+	for _, p := range upgradeSDKRecordPatterns {
+		if p.pattern.MatchString(name) {
+			return p.budget
+		}
+	}
+	return 0
+}
+func (r *upgradeSDKInventory) digest(scope upgradeSDKGrantScope) ([32]byte, error) {
+	if r == nil || r.Schema != 1 || r.Scope != scope || len(r.Files) > 2048 || r.LegacyRoot == "" || r.LegacyController == "" || r.Root == "" || r.Init == "" || r.Fence == "" || r.Quarantine == "" {
+		return [32]byte{}, ErrUpgrade
+	}
+	seen := map[string]bool{}
+	for _, id := range []string{r.LegacyRoot, r.LegacyController, r.Root, r.Init, r.Fence, r.Quarantine} {
+		if !upgradeASCII(id, 256) || seen[id] {
+			return [32]byte{}, ErrUpgrade
+		}
+		seen[id] = true
+	}
+	all, active, historical := sha256.New(), sha256.New(), sha256.New()
+	var total uint64
+	activeFiles := 0
+	for n, f := range r.Files {
+		budget := upgradeSDKRecordBudget(f.Name)
+		role := "historical-only"
+		if f.Name == "authority-v1.json" || f.Name == "settings-v1.json" {
+			role = "active-data"
+			activeFiles++
+		}
+		if budget == 0 || f.Size > budget || f.SHA256 == [32]byte{} || f.Disposition != role || n > 0 && r.Files[n-1].Name >= f.Name || !upgradeASCII(f.Source, 256) || !upgradeASCII(f.Target, 256) || seen[f.Source] || seen[f.Target] || f.Source == f.Target {
+			return [32]byte{}, ErrUpgrade
+		}
+		seen[f.Source], seen[f.Target] = true, true
+		total += f.Size
+		if total > 128<<20 {
+			return [32]byte{}, ErrUpgrade
+		}
+		body, _ := json.Marshal(f)
+		_ = json.NewEncoder(all).Encode(f)
+		if role == "active-data" {
+			_, _ = active.Write(body)
+		} else {
+			_, _ = historical.Write(body)
+		}
+	}
+	if activeFiles != 2 || !bytes.Equal(all.Sum(nil), r.Inventory[:]) || !bytes.Equal(active.Sum(nil), r.Active[:]) || !bytes.Equal(historical.Sum(nil), r.Historical[:]) {
+		return [32]byte{}, ErrUpgrade
+	}
+	body, err := json.Marshal(r)
+	if err != nil || len(body) > 2<<20 {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256(body), nil
+}
+
+func parseUpgradeSDKControlReply(body []byte, sequence uint32, operation string) (upgradeSDKControlReply, error) {
+	var r upgradeSDKControlReply
+	switch operation {
+	case "inventory", "provision-supervisor", "adopt-leaf-master", "ack-leaf", "start-runtime", "commit", "offer-controller", "retain-controller", "keepalive", "seal-runtime", "drain-runtime", "retire":
+	default:
+		return r, ErrUpgrade
+	}
+	if len(body) == 0 || len(body) > 2<<20 || json.Unmarshal(body, &r) != nil {
+		return r, ErrUpgrade
+	}
+	canonical, _ := json.Marshal(r)
+	stage := operation
+	if operation == "provision-supervisor" {
+		stage = "supervisor-provisioned"
+	}
+	if operation == "adopt-leaf-master" {
+		stage = "leaf-master-adopted"
+	}
+	if operation == "ack-leaf" {
+		stage = "leaf-acknowledged"
+	}
+	if operation == "start-runtime" {
+		stage = "runtime-start-admitted"
+	}
+	if operation == "commit" {
+		stage = "committed-parent-retained"
+	}
+	if operation == "retain-controller" {
+		stage = "supervisor-accepted"
+	}
+	if operation == "retire" {
+		stage = "retirement-admitted"
+	}
+	if operation == "seal-runtime" || operation == "drain-runtime" {
+		stage = "runtime-draining"
+		if operation == "drain-runtime" && r.Stage == "runtime-joined" {
+			stage = "runtime-joined"
+		}
+	}
+	pending := upgradeSDKBootstrapPending(operation, r.Stage)
+	if !bytes.Equal(canonical, body) || r.Schema != 1 || r.Sequence != sequence || (!pending && r.Stage != stage) || r.Error != "" || (operation == "inventory") != (r.Receipt != nil) || (operation == "offer-controller" && !pending) != (r.Controller != nil) || (pending && r.Leaf != nil) {
+		return r, ErrUpgrade
+	}
+	if r.Leaf != nil && ((operation != "keepalive" && operation != "drain-runtime") || r.Stage == "runtime-joined" || !r.Leaf.valid()) {
+		return r, ErrUpgrade
+	}
+	return r, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_inventory_test.go b/rdd/pkg/managementconfig/upgrade_sdk_inventory_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b5a3eb6b751f484534bb4e1152eb4dc1bb555723
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_inventory_test.go
@@ -0,0 +1,108 @@
+package managementconfig
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"testing"
+)
+
+func testUpgradeSDKInventory() *upgradeSDKInventory {
+	r := &upgradeSDKInventory{Schema: 1, Scope: testUpgradeSDKGrant().Scope, LegacyRoot: "old-root", LegacyController: "old-controller", Root: "root", Init: "init", Fence: "fence", Quarantine: "quarantine", Files: []upgradeSDKInventoryFile{{"authority-v1.json", "old-authority", "new-authority", "active-data", 12, [32]byte{1}}, {"settings-v1.json", "old-settings", "new-settings", "active-data", 12, [32]byte{2}}}}
+	a, b, c := sha256.New(), sha256.New(), sha256.New()
+	for _, f := range r.Files {
+		body, _ := json.Marshal(f)
+		_ = json.NewEncoder(a).Encode(f)
+		_, _ = b.Write(body)
+	}
+	copy(r.Inventory[:], a.Sum(nil))
+	copy(r.Active[:], b.Sum(nil))
+	copy(r.Historical[:], c.Sum(nil))
+	return r
+}
+
+func TestUpgradeSDKControlSupervisorStagesNeverBorrowInventoryOrControllerRoles(t *testing.T) {
+	for operation, stage := range map[string]string{"start-runtime": "runtime-start-admitted", "commit": "committed-parent-retained", "offer-controller": "offer-controller", "retain-controller": "supervisor-accepted", "keepalive": "keepalive", "seal-runtime": "runtime-draining", "drain-runtime": "runtime-draining", "retire": "retirement-admitted"} {
+		r := upgradeSDKControlReply{Schema: 1, Sequence: 7, Stage: stage}
+		if operation == "offer-controller" {
+			r.Controller = &[4]uint64{101, 102, 103, 104}
+		}
+		body, _ := json.Marshal(r)
+		if _, err := parseUpgradeSDKControlReply(body, 7, operation); err != nil {
+			t.Fatal(operation, err)
+		}
+		if _, err := parseUpgradeSDKControlReply(body, 8, operation); err == nil {
+			t.Fatal("stale supervisor frame admitted", operation)
+		}
+		r.Receipt = testUpgradeSDKInventory()
+		body, _ = json.Marshal(r)
+		if _, err := parseUpgradeSDKControlReply(body, 7, operation); err == nil {
+			t.Fatal("inventory borrowed supervisor stage", operation)
+		}
+		r.Receipt = nil
+		if r.Controller == nil {
+			r.Controller = &[4]uint64{101, 102, 103, 104}
+		} else {
+			r.Controller = nil
+		}
+		body, _ = json.Marshal(r)
+		if _, err := parseUpgradeSDKControlReply(body, 7, operation); err == nil {
+			t.Fatal("controller role added/omitted at wrong phase", operation)
+		}
+	}
+}
+
+func TestUpgradeSDKControlJoinedStageIsOnlyDrainProgress(t *testing.T) {
+	r := upgradeSDKControlReply{Schema: 1, Sequence: 9, Stage: "runtime-joined"}
+	body, _ := json.Marshal(r)
+	if _, err := parseUpgradeSDKControlReply(body, 9, "drain-runtime"); err != nil {
+		t.Fatal(err)
+	}
+	for _, operation := range []string{"seal-runtime", "retire", "keepalive", "start-runtime"} {
+		if _, err := parseUpgradeSDKControlReply(body, 9, operation); err == nil {
+			t.Fatal("joined progress borrowed another operation", operation)
+		}
+	}
+	r.Controller = &[4]uint64{11, 12, 13, 14}
+	body, _ = json.Marshal(r)
+	if _, err := parseUpgradeSDKControlReply(body, 9, "drain-runtime"); err == nil {
+		t.Fatal("controller payload manufactured native drain custody")
+	}
+}
+func TestUpgradeSDKInventoryRequiresWholeCanonicalColdScopeAndPartitions(t *testing.T) {
+	r := testUpgradeSDKInventory()
+	if _, err := r.digest(r.Scope); err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"foreign", "partial", "hash", "alias", "role", "unknown-file", "budget"} {
+		bad := testUpgradeSDKInventory()
+		switch kind {
+		case "foreign":
+			bad.Scope.SDKImage[0] ^= 1
+		case "partial":
+			bad.Files = bad.Files[:1]
+		case "hash":
+			bad.Active[0] ^= 1
+		case "alias":
+			bad.Files[1].Target = bad.Files[0].Target
+		case "role":
+			bad.Files[0].Disposition = "historical-only"
+		case "unknown-file":
+			bad.Files[0].Name = "caller-path"
+		case "budget":
+			bad.Files[0].Size = 129 << 10
+		}
+		if _, err := bad.digest(r.Scope); err == nil {
+			t.Fatal("foreign/partial inventory admitted", kind)
+		}
+	}
+	body, _ := json.Marshal(upgradeSDKControlReply{Schema: 1, Sequence: 1, Stage: "inventory", Receipt: r})
+	if _, err := parseUpgradeSDKControlReply(body, 1, "inventory"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parseUpgradeSDKControlReply(body, 2, "inventory"); err == nil {
+		t.Fatal("old reply sequence accepted")
+	}
+	if _, err := parseUpgradeSDKControlReply(append(body, '\n'), 1, "inventory"); err == nil {
+		t.Fatal("noncanonical reply accepted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_joined_source_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_joined_source_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..98d513e319077d4e31e32c86900aff7345514743
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_joined_source_windows.go
@@ -0,0 +1,144 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// Constructed only by the actual original native framer, never the generic
+// drain callback. It proves this SDK runtime producer joined, not OS/guest or
+// whole-job end-of-birth. owner.protocol protects every field and the receiver.
+type nativeUpgradeSDKJoinedSource struct {
+	self      *nativeUpgradeSDKJoinedSource
+	owner     *nativeUpgradeSDKServingOwner
+	receiver  *nativeUpgradeSDKLeafReceiver
+	cohort    *nativeUpgradeSDKCohort
+	io        *upgradeSDKControlIO
+	control   windows.Handle
+	complete  bool
+	sequence  uint32
+	lastOffer uint64
+}
+
+// No syscall or ownership promotion. Caller holds the original protocol lock.
+func (s *nativeUpgradeSDKJoinedSource) bindingLocked() error {
+	if s == nil || s.self != s || s.owner == nil || s.owner.joinedSource != s || s.receiver == nil || s.receiver.self != s.receiver || s.receiver.owner != s.owner || s.owner.leaves != s.receiver || !s.receiver.ready || s.cohort == nil || s.receiver.cohort != s.cohort || s.owner.cohort != s.cohort || s.cohort.receiver != s.owner || s.io == nil || s.owner.io != s.io || s.control == 0 || s.owner.control != s.control {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Original protocol lock held; native process remains live before final retire.
+func (s *nativeUpgradeSDKJoinedSource) checkLocked(ctx context.Context) error {
+	if ctx == nil || ctx.Err() != nil || s.bindingLocked() != nil || !s.complete || s.sequence == 0 || s.owner.sequence != s.sequence || s.receiver.lastOffer != s.lastOffer || s.receiver.current != nil {
+		return ErrUpgrade
+	}
+	s.owner.mu.Lock()
+	bad := s.owner.unknown || s.owner.closed || !s.owner.closeAttempted
+	s.owner.mu.Unlock()
+	if bad || !s.io.mu.TryLock() {
+		return ErrUpgrade
+	}
+	bad = s.io.unknown || s.io.op != nil || s.io.pipe != s.control
+	s.io.mu.Unlock()
+	if bad {
+		return ErrUpgrade
+	}
+	s.cohort.mu.Lock()
+	bad = s.cohort.unknown || s.cohort.ledger.complete() != nil
+	s.cohort.mu.Unlock()
+	if bad || s.owner.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *nativeUpgradeSDKJoinedSource) checkBeforeRetire(ctx context.Context) error {
+	if s == nil || s.owner == nil || !s.owner.protocol.TryLock() {
+		return ErrUpgrade
+	}
+	defer s.owner.protocol.Unlock()
+	return s.checkLocked(ctx)
+}
+
+func (o *nativeUpgradeSDKServingOwner) drainNativeRuntimeSource(ctx context.Context) (out *nativeUpgradeSDKJoinedSource, result error) {
+	if o == nil || ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded || !o.protocol.TryLock() {
+		return nil, ErrUpgrade
+	}
+	defer o.protocol.Unlock()
+	o.mu.Lock()
+	bad := o.unknown || o.closed || !o.closeAttempted || !o.heartbeatStopped
+	done := o.heartbeatDone
+	o.mu.Unlock()
+	if bad || done == nil || o.joinedSource != nil || o.leaves == nil || o.leaves.self != o.leaves || !o.leaves.ready {
+		return nil, ErrUpgrade
+	}
+	select {
+	case <-done:
+	default:
+		return nil, ErrUpgrade
+	}
+	if o.checkNative(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	s := &nativeUpgradeSDKJoinedSource{owner: o, receiver: o.leaves, cohort: o.cohort, io: o.io, control: o.control}
+	s.self = s
+	o.joinedSource = s // retain actual partial graph BEFORE the first seal byte
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLeafReceiver()
+			panic(p)
+		}
+		if result != nil {
+			o.fenceLeafReceiver()
+		}
+	}()
+	if s.bindingLocked() != nil {
+		return nil, ErrUpgrade
+	}
+	reply, err := o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "seal-runtime"})
+	if err != nil || reply.Stage != "runtime-draining" || reply.Leaf != nil {
+		return nil, ErrUpgrade
+	}
+	for {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		reply, err = o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "drain-runtime"})
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		if reply.Leaf != nil && o.acceptSDKLeafOffer(ctx, reply.Leaf) != nil {
+			return nil, ErrUpgrade
+		}
+		switch reply.Stage {
+		case "runtime-joined":
+			if reply.Leaf != nil || s.receiver.current != nil {
+				return nil, ErrUpgrade
+			}
+			// Only the native original stream reached the SDK's actual joined
+			// participant dispatcher. A stage from a callback cannot reach here.
+			s.sequence, s.lastOffer, s.complete = o.sequence, s.receiver.lastOffer, true
+			if s.checkLocked(ctx) != nil {
+				s.complete = false
+				return nil, ErrUpgrade
+			}
+			return s, nil
+		case "runtime-draining":
+		default:
+			return nil, ErrUpgrade
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ErrUpgrade
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
