@@ -0,0 +1,149 @@
+//go:build cgo
+
+package managementconfig
+
+import (
+	"context"
+	"database/sql"
+	"net/url"
+	"path/filepath"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+)
+
+func openUpgradeSQLite(ctx context.Context, file *upgradeSQLiteFile, role string) (*sql.DB, *sql.Conn, error) {
+	if !file.valid(role) || ctx == nil || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, nil, ErrUpgrade
+	}
+	path := filepath.ToSlash(file.path)
+	if filepath.VolumeName(file.path) != "" {
+		path = "/" + path
+	}
+	u := url.URL{Scheme: "file", Path: path}
+	q := url.Values{"mode": {"rw"}, "_busy_timeout": {"1000"}, "_foreign_keys": {"on"}}
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("sqlite3", u.String())
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	db.SetMaxOpenConns(1)
+	db.SetMaxIdleConns(1)
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		if db.Close() != nil {
+			file.pin.unknown(db)
+		}
+		return nil, nil, ErrUpgrade
+	}
+	for _, statement := range []string{`PRAGMA trusted_schema=OFF`, `PRAGMA temp_store=MEMORY`, `PRAGMA hard_heap_limit=134217728`, `PRAGMA cache_size=-8192`} {
+		if _, err := conn.ExecContext(ctx, statement); err != nil {
+			connErr, dbErr := conn.Close(), db.Close()
+			if connErr != nil || dbErr != nil {
+				file.pin.unknown(conn, db)
+			}
+			return nil, nil, ErrUpgrade
+		}
+	}
+	return db, conn, nil
+}
+
+// The SQLite backup API folds a complete copied main/WAL/SHM/rollback set into a
+// separate private precreated database. Only these working copies are opened
+// read/write. The untouched sealed historical checkpoint is never opened here.
+func checkpointUpgradeCopy(ctx context.Context, copied, normalized *upgradeSQLiteFile) (snapshot UpgradeSnapshot, result error) {
+	if !copied.valid("copied") || !normalized.valid("normalized") || copied.pin != normalized.pin || copied.path == normalized.path || copied.object == normalized.object {
+		return snapshot, ErrUpgrade
+	}
+	if !copied.pin.begin() {
+		return snapshot, ErrUpgrade
+	}
+	defer copied.pin.end()
+	sourceDB, source, err := openUpgradeSQLite(ctx, copied, "copied")
+	if err != nil {
+		return snapshot, ErrUpgrade
+	}
+	defer func() {
+		closeErr, dbErr := source.Close(), sourceDB.Close()
+		if closeErr != nil || dbErr != nil {
+			copied.pin.unknown(source, sourceDB)
+			snapshot = UpgradeSnapshot{}
+			result = ErrUpgrade
+		}
+	}()
+	before, err := snapshotUpgradeDatabase(ctx, source)
+	if err != nil {
+		return snapshot, ErrUpgrade
+	}
+	destDB, dest, err := openUpgradeSQLite(ctx, normalized, "normalized")
+	if err != nil {
+		return snapshot, ErrUpgrade
+	}
+	defer func() {
+		closeErr, dbErr := dest.Close(), destDB.Close()
+		if closeErr != nil || dbErr != nil {
+			copied.pin.unknown(dest, destDB)
+			snapshot = UpgradeSnapshot{}
+			result = ErrUpgrade
+		}
+	}()
+	err = dest.Raw(func(destRaw any) error {
+		return source.Raw(func(sourceRaw any) (result error) {
+			destination, ok := destRaw.(*sqlite3.SQLiteConn)
+			if !ok {
+				return ErrUpgrade
+			}
+			origin, ok := sourceRaw.(*sqlite3.SQLiteConn)
+			if !ok {
+				return ErrUpgrade
+			}
+			backup, err := destination.Backup("main", origin, "main")
+			if err != nil {
+				return ErrUpgrade
+			}
+			defer func() {
+				if backup.Finish() != nil {
+					copied.pin.unknown(backup)
+					result = ErrUpgrade
+				}
+			}()
+			for {
+				if ctx.Err() != nil {
+					return ErrUpgrade
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					return ErrUpgrade
+				}
+				if done {
+					return nil
+				}
+				timer := time.NewTimer(10 * time.Millisecond)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return ErrUpgrade
+				case <-timer.C:
+				}
+			}
+		})
+	})
+	if err != nil {
+		return snapshot, ErrUpgrade
+	}
+	after, err := snapshotUpgradeDatabase(ctx, dest)
+	if err != nil || after != before {
+		return snapshot, ErrUpgrade
+	}
+	// No pending write transaction or sidecar is imported by pretending a
+	// single-file copy was a checkpoint. The backup destination uses DELETE
+	// journal mode and is positively closed before native file sealing/import.
+	var mode string
+	if dest.QueryRowContext(ctx, `PRAGMA journal_mode=DELETE`).Scan(&mode) != nil || mode != "delete" {
+		return snapshot, ErrUpgrade
+	}
+	return after, nil
+}
