--- /dev/null
+++ b/rdd/cmd/rdd/runtime_operation.go
@@ -0,0 +1,26 @@
+package main
+
+import (
+	"context"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"io"
+	"os"
+	"time"
+)
+
+// Fixed early dispatch. No Cobra construction, lifecycle call, renderer target,
+// environment home, native handle argument or arbitrary operation selector.
+func privateRuntimeOperation(args []string, input io.Reader, output io.Writer) (bool, int) {
+	if len(args) == 0 || args[0] != "private-runtime-operation" {
+		return false, 0
+	}
+	if len(args) != 2 || args[1] != "preflight" || os.Getenv("RDD_INSTANCE") != "orbwin" {
+		return true, 2
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	if managementconfig.RunNativeRuntimePreflight(ctx, input, output) != nil {
+		return true, 2
+	}
+	return true, 0
+}
