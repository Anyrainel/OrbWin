+package managementconfig
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestUpgradeCandidateEnvironmentCannotRedirectNativeScopeOrReuseAmbientCaps(t *testing.T) {
+	home := `C:\native-owned-home`
+	input := []string{"USERPROFILE=elsewhere", "home=elsewhere", "rdd_instance=2", "LIMA_HOME=foreign", "RDD_LOG_DIR=foreign", "DOCKER_CONTEXT=foreign", "DOCKER_TLS_VERIFY=1", "DOCKER_CERT_PATH=foreign", "DOCKER_HOST=foreign", "KUBECONFIG=foreign", "Orbwin_Private_Migration_Handle=777", "ORBWIN_PRIVATE_UNRELATED_HANDLE=888", "SystemRoot=C:\\Windows", "path=first", "PATH=last"}
+	got, err := upgradeCandidateEnvironment(input, home, upgradeSDKCandidateLaunch{MigrationPermit: 101, SDKRetirement: 102})
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := map[string]string{}
+	for _, entry := range got {
+		key, value, _ := strings.Cut(entry, "=")
+		upper := strings.ToUpper(key)
+		if _, ok := values[upper]; ok {
+			t.Fatal("duplicate environment key", key)
+		}
+		values[upper] = value
+	}
+	for key, want := range map[string]string{"USERPROFILE": home, "HOME": home, "RDD_INSTANCE": "orbwin", "DOCKER_HOST": "npipe:////./pipe/docker-rancher-desktop-orbwin", "KUBECONFIG": filepath.Join(home, ".rdorbwin", "kube-client.config"), "ORBWIN_PRIVATE_MIGRATION_HANDLE": "101", "ORBWIN_PRIVATE_SDK_OWNER_HANDLE": "102", "PATH": "last"} {
+		if values[key] != want {
+			t.Fatal("native environment binding changed", key, values[key], want)
+		}
+	}
+	for _, key := range []string{"LIMA_HOME", "RDD_LOG_DIR", "DOCKER_CONTEXT", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH", "ORBWIN_PRIVATE_UNRELATED_HANDLE"} {
+		if _, ok := values[key]; ok {
+			t.Fatal("ambient redirect/capability retained", key)
+		}
+	}
+	for _, bad := range []upgradeSDKCandidateLaunch{{}, {MigrationPermit: 101, SDKRetirement: 101}} {
+		if _, err := upgradeCandidateEnvironment(nil, home, bad); err == nil {
+			t.Fatal("missing/aliased inherited grant admitted")
+		}
+	}
+	if _, err := upgradeCandidateEnvironment([]string{"PATH=bad\x00entry"}, home, upgradeSDKCandidateLaunch{MigrationPermit: 101, SDKRetirement: 102}); err == nil {
+		t.Fatal("embedded native environment terminator admitted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_candidate_unresumed_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_candidate_unresumed_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ffaa3990bde765ba277c072a276a94f4de7c79d0
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_candidate_unresumed_windows.go
@@ -0,0 +1,134 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"sync"
+)
+
+// Only the successful CREATE_SUSPENDED return constructs this participant. It
+// is never a backend/engine/guest retirement grant. No application thread has
+// been resumed by this owner, so this one actual root may be terminated and
+// positively waited without broadening to any PID, engine or helper family.
+type nativeUpgradeCandidateUnresumed struct {
+	mu                 sync.Mutex
+	candidate          *nativeUpgradeCandidate
+	process, thread    windows.Handle
+	pid                uint32
+	attempted, retired bool
+	err                error
+}
+
+// All raw handle closures cache their attempt BEFORE the syscall. A lost close
+// reply retains the original numeric handle and cannot be tried a second time.
+func (c *nativeUpgradeCandidate) closeNativeOnce(handle *windows.Handle) error {
+	if c == nil || handle == nil {
+		return ErrUpgrade
+	}
+	h := *handle
+	if h == 0 {
+		return nil
+	}
+	if c.closeAttempts == nil {
+		c.closeAttempts = map[windows.Handle]error{}
+	}
+	if err, attempted := c.closeAttempts[h]; attempted {
+		if err == nil {
+			*handle = 0
+		}
+		return err
+	}
+	c.closeAttempts[h] = ErrUpgrade
+	if windows.CloseHandle(h) != nil {
+		return ErrUpgrade
+	}
+	c.closeAttempts[h] = nil
+	*handle = 0
+	return nil
+}
+
+func (b *nativeUpgradeCandidateUnresumed) retire(ctx context.Context) (result error) {
+	if b == nil || b.candidate == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	c := b.candidate
+	if !c.operation.TryLock() {
+		return ErrUpgrade
+	}
+	defer c.operation.Unlock()
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.attempted {
+		return b.err
+	}
+	// Check before any native operation. `resumed == false` is insufficient:
+	// a ResumeThread error may have followed actual execution.
+	if c.resumeAttempted || b.process == 0 || b.thread == 0 || c.process != b.process || c.thread != b.thread || c.launcher == nil || c.launcher.sdk == nil || c.launcher.sdk.child == nil {
+		return ErrUpgrade
+	}
+	// SDK may already have exited independently; that must not strand this
+	// suspended child. Hold the actual TEMP job owner, rather than require a
+	// live SDK, across removal of the candidate's inherited SDK job copy.
+	sdk := c.launcher.sdk.child
+	sdk.mu.Lock()
+	defer sdk.mu.Unlock()
+	if sdk.handoff.Load() != nil || checkUpgradeSDKJobLimits(sdk.job) != nil {
+		return ErrUpgrade
+	}
+	b.attempted, b.err = true, ErrUpgrade
+	defer func() { b.err = result }()
+	state, err := windows.WaitForSingleObject(b.process, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if state == uint32(windows.WAIT_TIMEOUT) {
+		if windows.TerminateProcess(b.process, 125) != nil {
+			return ErrUpgrade
+		}
+	} else if state != uint32(windows.WAIT_OBJECT_0) {
+		return ErrUpgrade
+	}
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		state, err = windows.WaitForSingleObject(b.process, 20)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			break
+		}
+		if state != uint32(windows.WAIT_TIMEOUT) {
+			return ErrUpgrade
+		}
+	}
+	// ExitProcess/TerminateProcess closure and positive process wait cover this
+	// never-resumed child's inherited handles. TEMP's actual SDK job/control
+	// copies must still be retained; no healthy SDK lifetime may be lost here.
+	if checkUpgradeSDKJobLimits(sdk.job) != nil {
+		return ErrUpgrade
+	}
+	for _, handle := range []*windows.Handle{&c.stdin, &c.stdout, &c.stderr, &c.thread, &c.image} {
+		if c.closeNativeOnce(handle) != nil {
+			return ErrUpgrade
+		}
+	}
+	if c.token != 0 {
+		token := windows.Handle(c.token)
+		if c.closeNativeOnce(&token) != nil {
+			return ErrUpgrade
+		}
+		c.token = 0
+	}
+	if c.closeNativeOnce(&c.process) != nil {
+		return ErrUpgrade
+	}
+	b.retired = true
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_candidate_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_candidate_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..bbdd8cbdc6f39c9790fc80992076982f7f4ef716
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_candidate_windows.go
@@ -0,0 +1,427 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"reflect"
+	"runtime"
+	"sync"
+	"time"
+	"unsafe"
+)
+
+// Trusted native providers must bind this actual child, not a PID/ready DTO.
+// There are NO production issuers yet for these full-scope observations and
+// joined backend/HA/engine/guest retirement. Absence refuses BEFORE SDK effects.
+type upgradeNativeCandidateObservations interface {
+	RootBacking() *InstanceRoot
+	observeNativeUpgradeCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal) (upgradeValidation, error)
+}
+type upgradeNativeCandidateRetirement interface {
+	RootBacking() *InstanceRoot
+	retireNativeUpgradeCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal) (upgradeNativeCandidateRetired, error)
+}
+type upgradeNativeCandidateRetired interface {
+	checkNativeCandidateRetired(context.Context, *nativeUpgradeCandidate) ([32]byte, error)
+}
+type upgradeNativeCandidatePublication interface {
+	upgradeRuntimePublisher
+	RootBacking() *InstanceRoot
+	retainNativeUpgradeObservedCandidate(context.Context, *nativeUpgradeCandidate, upgradeJournal, upgradeValidation) error
+}
+type upgradeNativeCandidateProviders struct {
+	observations upgradeNativeCandidateObservations
+	retirement   upgradeNativeCandidateRetirement
+	publication  upgradeNativeCandidatePublication
+}
+
+func (p *upgradeNativeCandidateProviders) valid() bool {
+	return p != nil && upgradeNativeProviderPresent(p.observations) && upgradeNativeProviderPresent(p.retirement) && upgradeNativeProviderPresent(p.publication)
+}
+
+func upgradeNativeProviderPresent(provider any) bool {
+	if provider == nil {
+		return false
+	}
+	v := reflect.ValueOf(provider)
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return !v.IsNil()
+	}
+	return true
+}
+
+func (p *upgradeNativeCandidateProviders) validFor(root *InstanceRoot) bool {
+	return root != nil && p.valid() && p.observations.RootBacking() == root && p.retirement.RootBacking() == root && p.publication.RootBacking() == root
+}
+
+type nativeUpgradeCandidateLauncher struct {
+	mu        sync.Mutex
+	authority *upgradeAuthorityOwner
+	sdk       *nativeUpgradeSDKPreparation
+	providers *upgradeNativeCandidateProviders
+	child     *nativeUpgradeCandidate
+	attempted bool
+}
+type nativeUpgradeCandidate struct {
+	operation              sync.Mutex
+	launcher               *nativeUpgradeCandidateLauncher
+	process, thread, image windows.Handle
+	stdin, stdout, stderr  windows.Handle
+	token                  windows.Token
+	tokenID                windows.LUID
+	expected               UpgradeProcess
+	binding                upgradeObservedImageBinding
+	resumed, unknown       bool
+	resumeAttempted        bool
+	unresumed              *nativeUpgradeCandidateUnresumed
+	closeAttempts          map[windows.Handle]error
+	retirement             upgradeNativeCandidateRetired
+	observed               *nativeUpgradeObservedCandidate
+}
+
+// This is the existing activation coordinator, not a competing lifecycle.
+// Keep a partial coordinator on error; it is attempted/unknown and cannot run.
+func prepareNativeUpgradeActivation(ctx context.Context, authority *upgradeAuthorityOwner, legacy *nativeUpgradeLegacySDKOwner, providers *upgradeNativeCandidateProviders) (*upgradeActivation, error) {
+	if authority == nil || legacy == nil || authority.cold == nil || authority.cold.retirement == nil || !providers.validFor(authority.cold.retirement.root) {
+		return nil, ErrUpgrade
+	}
+	a := &upgradeActivation{recorder: authority.recorder, authority: authority, publisher: providers.publication, attempted: true, unknown: true}
+	sdk, err := prepareNativeUpgradeSDK(ctx, authority, legacy)
+	a.sdk = sdk
+	if err != nil {
+		return a, err
+	}
+	launcher, err := newNativeUpgradeCandidateLauncher(ctx, authority, providers)
+	a.launcher = launcher
+	if err != nil {
+		return a, err
+	}
+	return newUpgradeActivation(authority.recorder, authority, launcher, providers.publication, sdk)
+}
+
+func newNativeUpgradeCandidateLauncher(ctx context.Context, authority *upgradeAuthorityOwner, providers *upgradeNativeCandidateProviders) (*nativeUpgradeCandidateLauncher, error) {
+	if authority == nil || authority.cold == nil || authority.cold.retirement == nil || !providers.validFor(authority.cold.retirement.root) {
+		return nil, ErrUpgrade
+	}
+	authority.mu.Lock()
+	defer authority.mu.Unlock()
+	if authority.unknown || !authority.imported || authority.released || authority.sdk == nil || authority.sdk.birth == nil || authority.sdk.birth.owner != authority || authority.sdk.birth.check(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	return &nativeUpgradeCandidateLauncher{authority: authority, sdk: authority.sdk, providers: providers}, nil
+}
+
+func (l *nativeUpgradeCandidateLauncher) launchUpgradeCandidate(ctx context.Context, j upgradeJournal, transfer upgradeCandidateTransfer) (upgradeCandidateOwner, error) {
+	if l == nil || l.authority == nil || l.authority.cold == nil || l.authority.cold.retirement == nil || ctx == nil || ctx.Err() != nil || !l.providers.validFor(l.authority.cold.retirement.root) {
+		return nil, ErrUpgrade
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	x, ok := transfer.(*nativeUpgradeSDKCandidateTransfer)
+	if l.attempted || !ok || x.prepared != l.sdk || x.management.recorder != l.authority.recorder || j.Stage != "candidate-start-admitted" || j.SDKDigest != l.sdk.digest || l.sdk.birth.check(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	l.authority.mu.Lock()
+	valid := l.authority.released && !l.authority.unknown && l.authority.transfer == x.management && l.authority.sdk == l.sdk
+	l.authority.mu.Unlock()
+	if !valid {
+		return nil, ErrUpgrade
+	}
+	l.attempted = true
+	c := &nativeUpgradeCandidate{launcher: l, unknown: true, closeAttempts: map[windows.Handle]error{}}
+	l.child = c // retain before file/native birth effects
+	args, err := readUpgradeArguments(ctx, l.authority.cold.handles["args"])
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	defer clear(args)
+	digest, err := upgradeArgsHash(args)
+	var flags []string
+	if err != nil || digest != j.ArgsHash || json.Unmarshal(args, &flags) != nil {
+		return c, ErrUpgrade
+	}
+	if c.openStreams(ctx, j) != nil {
+		return c, ErrUpgrade
+	}
+	err = x.startUpgradeSDKCandidate(ctx, func(grant upgradeSDKCandidateLaunch) error { return c.create(ctx, grant, flags) })
+	if err != nil {
+		if c.unresumed != nil && !c.resumeAttempted {
+			// Safe scope is ONLY the never-resumed actual native birth. Cleanup
+			// gets its own finite owner budget even after caller cancellation.
+			cleanup, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			_ = c.unresumed.retire(cleanup)
+			cancel()
+		}
+		return c, ErrUpgrade
+	}
+	return c, nil
+}
+
+// Fixed transaction-specific private FILE_CREATE logs and the native Null
+// device have independent kernel lifetimes after TEMP exit. No parent pipe
+// drainer or replacement logfile orchestrator is required by the serving rdd.
+func (c *nativeUpgradeCandidate) openStreams(ctx context.Context, j upgradeJournal) error {
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	store := c.launcher.sdk.grant.denial.store
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.closed || store.uncertain || store.parents == nil {
+		return ErrUpgrade
+	}
+	sd, err := privateDescriptor(store.sid, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	for _, role := range []struct {
+		name string
+		out  *windows.Handle
+	}{{"candidate.stdout-" + j.Transaction + ".log", &c.stdout}, {"candidate.stderr-" + j.Transaction + ".log", &c.stderr}} {
+		*role.out, err = openSDKFinalFile(store.parents.leaf(), role.name, sd, true)
+		if err != nil || verifyPrivate(*role.out, store.sid, false) != nil || windows.SetHandleInformation(*role.out, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+			return ErrUpgrade
+		}
+	}
+	name, err := windows.NewNTUnicodeString(`\Device\Null`)
+	if err != nil {
+		return ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{ObjectName: name, Attributes: windows.OBJ_CASE_INSENSITIVE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&c.stdin, windows.GENERIC_READ|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	kind, kindErr := windows.GetFileType(c.stdin)
+	if err != nil || kindErr != nil || kind != windows.FILE_TYPE_CHAR || windows.SetHandleInformation(c.stdin, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (c *nativeUpgradeCandidate) create(ctx context.Context, grant upgradeSDKCandidateLaunch, flags []string) error {
+	c.operation.Lock()
+	defer c.operation.Unlock()
+	l := c.launcher
+	if l.sdk.birth.check(ctx) != nil {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	l.authority.image.mu.Lock()
+	defer l.authority.image.mu.Unlock()
+	code := l.authority.image
+	if checkSDKFinalImage(code, l.authority.cold.sid) != nil || len(code.chain) < 2 {
+		return ErrUpgrade
+	}
+	path, err := upgradeWorkingPath(code.chain[len(code.chain)-1])
+	if err != nil {
+		return ErrUpgrade
+	}
+	imageDigest, err := servingImageDigest(l.authority.cold.retirement.root.selection.Profile(), path)
+	if err != nil || imageDigest != code.image.Hash {
+		return ErrUpgrade
+	}
+	env, err := upgradeCandidateEnvironment(windows.Environ(), l.authority.cold.retirement.root.home, grant)
+	if err != nil {
+		return ErrUpgrade
+	}
+	var environment []uint16
+	for _, entry := range env {
+		part, err := windows.UTF16FromString(entry)
+		if err != nil {
+			return ErrUpgrade
+		}
+		environment = append(environment, part...)
+	}
+	environment = append(environment, 0)
+	app, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return ErrUpgrade
+	}
+	line, err := windows.UTF16PtrFromString(windows.ComposeCommandLine(append([]string{path, "service", "serve"}, flags...)))
+	if err != nil {
+		return ErrUpgrade
+	}
+	handles := make([]windows.Handle, 0, len(grant.Handles)+3)
+	seen := map[windows.Handle]bool{}
+	for _, raw := range append(append([]uintptr(nil), grant.Handles...), uintptr(c.stdin), uintptr(c.stdout), uintptr(c.stderr)) {
+		h := windows.Handle(raw)
+		if h == 0 || h == windows.InvalidHandle || seen[h] {
+			return ErrUpgrade
+		}
+		seen[h] = true
+		handles = append(handles, h)
+	}
+	attributes, err := windows.NewProcThreadAttributeList(1)
+	if err != nil {
+		return ErrUpgrade
+	}
+	defer attributes.Delete()
+	if attributes.Update(windows.PROC_THREAD_ATTRIBUTE_HANDLE_LIST, unsafe.Pointer(&handles[0]), uintptr(len(handles))*unsafe.Sizeof(handles[0])) != nil {
+		return ErrUpgrade
+	}
+	si := windows.StartupInfoEx{ProcThreadAttributeList: attributes.List()}
+	si.Cb = uint32(unsafe.Sizeof(si))
+	si.Flags = windows.STARTF_USESTDHANDLES
+	si.StdInput = c.stdin
+	si.StdOutput = c.stdout
+	si.StdErr = c.stderr
+	var info windows.ProcessInformation
+	err = windows.CreateProcess(app, line, nil, nil, true, windows.CREATE_SUSPENDED|windows.CREATE_NO_WINDOW|windows.CREATE_NEW_PROCESS_GROUP|windows.CREATE_UNICODE_ENVIRONMENT|windows.EXTENDED_STARTUPINFO_PRESENT, &environment[0], nil, &si.StartupInfo, &info)
+	c.process, c.thread = info.Process, info.Thread
+	runtime.KeepAlive(environment)
+	runtime.KeepAlive(handles)
+	if err != nil || c.process == 0 || c.thread == 0 {
+		return ErrUpgrade
+	}
+	c.unresumed = &nativeUpgradeCandidateUnresumed{candidate: c, process: c.process, thread: c.thread, pid: info.ProcessId}
+	var created, exited, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(c.process, &created, &exited, &kernel, &user) != nil || windows.ProcessIdToSessionId(info.ProcessId, &session) != nil {
+		return ErrUpgrade
+	}
+	c.expected = UpgradeProcess{info.ProcessId, uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), session, code.image.Hash}
+	if !c.expected.valid() || c.expected.Creation <= l.sdk.birth.generation.Creation || c.expected.Creation <= l.sdk.child.expected.Creation || session != l.sdk.birth.generation.Session || windows.OpenProcessToken(c.process, windows.TOKEN_QUERY, &c.token) != nil || legacySDKOrdinaryToken(c.token, l.sdk.birth.sid, session) != nil {
+		return ErrUpgrade
+	}
+	c.tokenID, err = legacySDKTokenID(c.token)
+	if err != nil {
+		return ErrUpgrade
+	}
+	c.image, err = openUpgradeObservedImageFile(code.chain[len(code.chain)-2], "rdd.exe")
+	if err != nil {
+		return ErrUpgrade
+	}
+	id, idErr := upgradeObjectID(c.image)
+	origin, originErr := upgradeObjectID(code.chain[len(code.chain)-1])
+	if idErr != nil || originErr != nil || id != origin || c.binding.capture(c.process, c.image) != nil || c.checkNative(ctx) != nil || l.sdk.birth.check(ctx) != nil {
+		return ErrUpgrade
+	}
+	// The suspended child already owns its independent inherited stream copies.
+	// Checked TEMP closure prevents any pipe-drainer or TEMP-lifetime dependency.
+	for _, handle := range []*windows.Handle{&c.stdin, &c.stdout, &c.stderr} {
+		if c.closeNativeOnce(handle) != nil {
+			return ErrUpgrade
+		}
+	}
+	if c.provisionSDKSupervisor(ctx) != nil {
+		return ErrUpgrade
+	}
+	c.resumeAttempted = true // BEFORE the syscall: any ambiguity forbids narrow cleanup
+	previous, err := windows.ResumeThread(c.thread)
+	if err != nil || previous != 1 {
+		return ErrUpgrade
+	}
+	c.resumed = true
+	if c.closeNativeOnce(&c.thread) != nil {
+		return ErrUpgrade
+	}
+	c.unknown = false
+	return nil
+}
+
+func (c *nativeUpgradeCandidate) checkNative(ctx context.Context) error {
+	if c == nil || ctx == nil || ctx.Err() != nil || c.process == 0 || c.token == 0 || c.image == 0 || !c.expected.valid() {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(c.process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || c.binding.same() != nil || legacySDKOrdinaryToken(c.token, c.launcher.sdk.birth.sid, c.expected.Session) != nil {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(c.token)
+	if err != nil || id != c.tokenID {
+		return ErrUpgrade
+	}
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(c.process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || uint32(basic.UniqueProcessId) != c.expected.PID || uint32(basic.InheritedFromUniqueProcessId) != c.launcher.sdk.birth.generation.PID {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	if windows.GetProcessTimes(c.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != c.expected.Creation {
+		return ErrUpgrade
+	}
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(c.process), 0, uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 0 {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (c *nativeUpgradeCandidate) observeUpgradeCandidate(ctx context.Context, j upgradeJournal) (upgradeValidation, error) {
+	if c == nil || !c.operation.TryLock() {
+		return upgradeValidation{}, ErrUpgrade
+	}
+	defer c.operation.Unlock()
+	if c.unknown || !c.resumed || c.checkNative(ctx) != nil {
+		return upgradeValidation{}, ErrUpgrade
+	}
+	v, err := c.launcher.providers.observations.observeNativeUpgradeCandidate(ctx, c, j)
+	if err != nil || v.Candidate != c.expected || !v.valid(j) || c.checkNative(ctx) != nil {
+		return upgradeValidation{}, ErrUpgrade
+	}
+	if c.retainObservedCandidate(ctx, j, v) != nil {
+		return upgradeValidation{}, ErrUpgrade
+	}
+	if c.launcher.providers.publication.retainNativeUpgradeObservedCandidate(ctx, c, j, v) != nil {
+		return upgradeValidation{}, ErrUpgrade
+	}
+	return v, nil
+}
+
+func (c *nativeUpgradeCandidate) retireUpgradeCandidate(ctx context.Context, j upgradeJournal) ([32]byte, error) {
+	if c == nil || !c.operation.TryLock() {
+		return [32]byte{}, ErrUpgrade
+	}
+	defer c.operation.Unlock()
+	if !c.resumeAttempted || c.retirement != nil || c.checkCapturedForRetirement(ctx) != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	c.unknown = true
+	var err error
+	c.retirement, err = c.launcher.providers.retirement.retireNativeUpgradeCandidate(ctx, c, j)
+	if err != nil || c.retirement == nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	digest, err := c.retirement.checkNativeCandidateRetired(ctx, c)
+	state, waitErr := windows.WaitForSingleObject(c.process, 0)
+	var created, exited, kernel, user windows.Filetime
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(c.process))
+	if err != nil || digest == [32]byte{} || waitErr != nil || state != uint32(windows.WAIT_OBJECT_0) || uint32(pid) != c.expected.PID || windows.GetProcessTimes(c.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != c.expected.Creation {
+		return [32]byte{}, ErrUpgrade
+	}
+	return digest, nil
+}
+
+// Actual process exit must not make a positively captured origin unusable.
+// Binding.same uses class44 while live, then held file/native generation plus
+// positive exit afterwards. It is observation/retirement, never new execution.
+func (c *nativeUpgradeCandidate) checkCapturedForRetirement(ctx context.Context) error {
+	if c == nil || ctx == nil || ctx.Err() != nil || c.process == 0 || c.image == 0 || c.token == 0 || !c.binding.captured || !c.expected.valid() {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	if c.binding.same() != nil || verifyPrivate(c.image, c.launcher.sdk.birth.sid, false) != nil || legacySDKOrdinaryToken(c.token, c.launcher.sdk.birth.sid, c.expected.Session) != nil {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(c.token)
+	if err != nil || id != c.tokenID {
+		return ErrUpgrade
+	}
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(c.process))
+	var created, exited, kernel, user windows.Filetime
+	if uint32(pid) != c.expected.PID || windows.GetProcessTimes(c.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != c.expected.Creation {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_candidate_windows_test.go b/rdd/pkg/managementconfig/upgrade_sdk_candidate_windows_test.go
