+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"io"
+	"testing"
+)
+
+func TestUpgradeCaptureSchemaRejectsRenameAndAliasedCopyReceipts(t *testing.T) {
+	o := upgradeCheckpointFixture(t, &fakeUpgradeSink{}, &fakeUpgradeSealer{})
+	j := o.journal
+	for name, mutate := range map[string]func(*upgradeJournal){
+		"old-schema":                  func(j *upgradeJournal) { j.Schema = 1 },
+		"whole-root-rename":           func(j *upgradeJournal) { j.BackupRoot = j.OldRoot },
+		"source-as-copy":              func(j *upgradeJournal) { j.Capture[0].Target = j.Capture[0].Source },
+		"other-source-as-copy":        func(j *upgradeJournal) { j.Capture[0].Target = j.Capture[len(j.Capture)-1].Source },
+		"duplicate-copy":              func(j *upgradeJournal) { j.Capture[0].Target = j.Capture[1].Target },
+		"duplicate-source":            func(j *upgradeJournal) { j.Capture[0].Source = j.Capture[1].Source },
+		"missing-fixed-child":         func(j *upgradeJournal) { j.Capture = j.Capture[1:] },
+		"source-overflow":             func(j *upgradeJournal) { j.Capture[0].Size = maxUpgradeCopyBytes + 1 },
+		"missing-fence":               func(j *upgradeJournal) { j.LegacyPIDDenial = UpgradePIDDenial{} },
+		"historical-pid-is-not-fence": func(j *upgradeJournal) { j.LegacyPIDDenial.Directory = j.Capture[0].Source },
+		"fence-child-is-not-copy":     func(j *upgradeJournal) { j.LegacyPIDDenial.Receipt = j.Capture[0].Target },
+	} {
+		t.Run(name, func(t *testing.T) {
+			bad := j
+			bad.Capture = append([]UpgradeBackupObject(nil), j.Capture...)
+			mutate(&bad)
+			raw, _ := json.Marshal(bad)
+			if bad.valid() {
+				t.Fatal("unsafe capture accepted")
+			}
+			if _, err := parseUpgradeJournal(raw); err == nil {
+				t.Fatal("unsafe on-disk capture adopted")
+			}
+		})
+	}
+	if j.BackupRoot == j.OldRoot || len(j.Capture) != 6 {
+		t.Fatal("fixture omitted distinct complete copy")
+	}
+	for _, item := range j.Capture {
+		if item.Source == item.Target {
+			t.Fatal("copy retained source ID")
+		}
+	}
+}
+func TestUpgradeCaptureMappingsAndFenceAreImmutableAfterAcknowledgement(t *testing.T) {
+	o := upgradeCheckpointFixture(t, &fakeUpgradeSink{}, &fakeUpgradeSealer{})
+	j := o.journal
+	for _, mutate := range []func(*upgradeJournal){
+		func(j *upgradeJournal) { j.Capture[0].Source.Low++ },
+		func(j *upgradeJournal) { j.Capture[0].Target.Low++ },
+		func(j *upgradeJournal) { j.Capture[0].Hash[0] ^= 1 },
+		func(j *upgradeJournal) { j.LegacyPIDDenial.Digest[0] ^= 1 },
+		func(j *upgradeJournal) { j.LegacyPIDDenial.Receipt.Low++ },
+	} {
+		next := j
+		next.Capture = append([]UpgradeBackupObject(nil), j.Capture...)
+		next.Stage = "sealing-admitted"
+		mutate(&next)
+		if upgradeRecordFollows(j, next) {
+			t.Fatal("acknowledged mapping/fence changed")
+		}
+	}
+	if o.seal(context.Background()) != nil {
+		t.Fatal("seal failed")
+	}
+	for _, seal := range o.journal.Seals {
+		if seal.Role == "root" {
+			if seal.Object != j.BackupRoot {
+				t.Fatal("sealed original root")
+			}
+			continue
+		}
+		found := false
+		for _, item := range j.Capture {
+			if item.Role == seal.Role {
+				found = true
+				if seal.Object != item.Target || seal.Object == item.Source {
+					t.Fatal("sealed source instead of copied child")
+				}
+			}
+		}
+		if !found {
+			t.Fatal("unknown seal")
+		}
+	}
+	bad := o.journal
+	bad.Seals = bad.Seals[:len(bad.Seals)-1]
+	if bad.valid() {
+		t.Fatal("incomplete backup seal accepted")
+	}
+}
+func TestUpgradeHistoricalCopyStreamsEveryAdmittedDataRoleAndRejectsCorruption(t *testing.T) {
+	data := bytes.Repeat([]byte("historical-private-data"), 10001)
+	for role, spec := range upgradeInventoryRoles {
+		if spec.directory {
+			continue
+		}
+		t.Run(role, func(t *testing.T) {
+			file := UpgradeColdFile{role, UpgradeObject{1, 2, 3}, uint64(len(data)), sha256.Sum256(data)}
+			var dst bytes.Buffer
+			if copyUpgradeHistorical(context.Background(), bytes.NewReader(data), &dst, file) != nil || !bytes.Equal(dst.Bytes(), data) {
+				t.Fatal("historical bytes changed")
+			}
+			for _, source := range []io.Reader{bytes.NewReader(data[:len(data)-1]), bytes.NewReader(append(append([]byte(nil), data...), 1)), bytes.NewReader(bytes.Repeat([]byte("x"), len(data)))} {
+				if copyUpgradeHistorical(context.Background(), source, io.Discard, file) == nil {
+					t.Fatal("truncated/overflow/corrupt historical source copied")
+				}
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if copyUpgradeHistorical(ctx, bytes.NewReader(data), io.Discard, file) == nil {
+				t.Fatal("cancelled copy admitted")
+			}
+		})
+	}
+	file := UpgradeColdFile{"synthetic-pid-denial", UpgradeObject{1, 2, 3}, uint64(len(data)), sha256.Sum256(data)}
+	if copyUpgradeHistorical(context.Background(), bytes.NewReader(data), io.Discard, file) == nil {
+		t.Fatal("synthetic fence treated as historical bytes")
+	}
+}
+
+type fakeUpgradeCaptureFile struct {
+	bytes                                            []byte
+	offset                                           int64
+	object                                           UpgradeObject
+	inspections, flushes, writes                     int
+	failInspectAt                                    int
+	failFlush, corruptFlush, replaceFlush, growFlush bool
+}
+
+func (f *fakeUpgradeCaptureFile) Read(data []byte) (int, error) {
+	if f.offset >= int64(len(f.bytes)) {
+		return 0, io.EOF
+	}
+	n := copy(data, f.bytes[f.offset:])
+	f.offset += int64(n)
+	return n, nil
+}
+func (f *fakeUpgradeCaptureFile) Write(data []byte) (int, error) {
+	f.writes++
+	if f.offset != int64(len(f.bytes)) {
+		return 0, ErrUpgrade
+	}
+	n := len(data)
+	if n > 17 {
+		n = 17
+	}
+	f.bytes = append(f.bytes, data[:n]...)
+	f.offset += int64(n)
+	return n, nil
+}
+func (f *fakeUpgradeCaptureFile) Seek(offset int64, whence int) (int64, error) {
+	if whence != io.SeekStart || offset != 0 {
+		return 0, ErrUpgrade
+	}
+	f.offset = offset
+	return 0, nil
+}
+func (f *fakeUpgradeCaptureFile) inspectCapture() (UpgradeObject, uint64, error) {
+	f.inspections++
+	if f.inspections == f.failInspectAt {
+		return UpgradeObject{}, 0, ErrUpgrade
+	}
+	return f.object, uint64(len(f.bytes)), nil
+}
+func (f *fakeUpgradeCaptureFile) flushCapture() error {
+	f.flushes++
+	if f.failFlush {
+		return ErrUpgrade
+	}
+	if f.corruptFlush {
+		f.bytes[0] ^= 1
+	}
+	if f.replaceFlush {
+		f.object.Low++
+	}
+	if f.growFlush {
+		f.bytes = append(f.bytes, 1)
+	}
+	return nil
+}
+func TestUpgradeCaptureChildRequiresPositiveFlushRereadAndNativeIdentity(t *testing.T) {
+	for _, fault := range []string{"none", "flush-lost", "reread-corrupt", "reread-overflow", "source-inspection", "target-inspection", "target-replaced", "source-alias"} {
+		t.Run(fault, func(t *testing.T) {
+			data := bytes.Repeat([]byte("checkpoint"), 111)
+			source := &fakeUpgradeCaptureFile{bytes: append([]byte(nil), data...), object: UpgradeObject{1, 0, 1}}
+			target := &fakeUpgradeCaptureFile{object: UpgradeObject{1, 0, 2}}
+			want := target.object
+			switch fault {
+			case "flush-lost":
+				target.failFlush = true
+			case "reread-corrupt":
+				target.corruptFlush = true
+			case "reread-overflow":
+				target.growFlush = true
+			case "source-inspection":
+				source.failInspectAt = 2
+			case "target-inspection":
+				target.failInspectAt = 2
+			case "target-replaced":
+				target.replaceFlush = true
+			case "source-alias":
+				target.object = source.object
+				want = source.object
+			}
+			file := UpgradeColdFile{"args", source.object, uint64(len(data)), sha256.Sum256(data)}
+			err := copyUpgradeCaptureChild(context.Background(), source, target, file, want)
+			if (fault == "none") != (err == nil) {
+				t.Fatalf("fault %s returned %v", fault, err)
+			}
+			if fault == "source-alias" {
+				if target.writes != 0 || target.flushes != 0 {
+					t.Fatal("aliased target mutated")
+				}
+				return
+			}
+			if target.flushes != 1 {
+				t.Fatal("copy did not require one positive flush")
+			}
+			if fault == "none" && (!bytes.Equal(data, target.bytes) || target.writes < 2) {
+				t.Fatal("streamed short writes lost historical bytes")
+			}
+			// A partial target is never a fresh CREATE_NEW empty object on a second
+			// invocation; even this byte seam refuses to overwrite/replay it.
+			writes := target.writes
+			if copyUpgradeCaptureChild(context.Background(), source, target, file, want) == nil || target.writes != writes {
+				t.Fatal("partial target overwritten on retry")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_capture_windows.go b/rdd/pkg/managementconfig/upgrade_capture_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..fc275a4327a2dd4595feaed29330bfedb08c02bd
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_capture_windows.go
@@ -0,0 +1,339 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+	"runtime"
+	"sort"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+const maxUpgradeColdBytes uint64 = 8 << 30
+
+func upgradeHandleSize(h windows.Handle) (uint64, error) {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil {
+		return 0, ErrUpgrade
+	}
+	size := uint64(info.FileSizeHigh)<<32 | uint64(info.FileSizeLow)
+	if size > maxUpgradeColdBytes {
+		return 0, ErrUpgrade
+	}
+	return size, nil
+}
+
+func (t *upgradeColdTree) argumentsMatch(ctx context.Context, want [32]byte) bool {
+	h := t.handles["args"]
+	size, err := upgradeHandleSize(h)
+	if err != nil || size == 0 || size > MaxConfigBytes {
+		return false
+	}
+	if _, err = windows.Seek(h, 0, io.SeekStart); err != nil {
+		return false
+	}
+	data := make([]byte, int(size))
+	defer clear(data)
+	for offset := 0; offset < len(data); {
+		if ctx.Err() != nil {
+			return false
+		}
+		var n uint32
+		if windows.ReadFile(h, data[offset:], &n, nil) != nil || n == 0 || int(n) > len(data)-offset {
+			return false
+		}
+		offset += int(n)
+	}
+	digest, err := upgradeArgsHash(data)
+	return err == nil && digest == want && ctx.Err() == nil
+}
+
+// Hash only the exact exclusive cold handles, never a reopened pathname. The
+// total checkpoint budget is bounded before reading. Credential files are not
+// hashed or copied through this API; only SQLite's four fixed roles enter it.
+func (t *upgradeColdTree) coldFiles(ctx context.Context) ([]UpgradeColdFile, error) {
+	var files []UpgradeColdFile
+	var total uint64
+	for role, h := range t.handles {
+		if !upgradeColdRole(role) {
+			continue
+		}
+		size, err := upgradeHandleSize(h)
+		if err != nil || total > maxUpgradeColdBytes-size {
+			return nil, ErrUpgrade
+		}
+		total += size
+		id, err := upgradeObjectID(h)
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		files = append(files, UpgradeColdFile{Role: role, Object: id, Size: size})
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].Role < files[j].Role })
+	buffer := make([]byte, 64<<10)
+	defer clear(buffer)
+	for i := range files {
+		file := &files[i]
+		h := t.handles[file.Role]
+		if _, err := windows.Seek(h, 0, io.SeekStart); err != nil {
+			return nil, ErrUpgrade
+		}
+		hash := sha256.New()
+		remaining := file.Size
+		for remaining > 0 {
+			if ctx.Err() != nil {
+				return nil, ErrUpgrade
+			}
+			next := uint64(len(buffer))
+			if remaining < next {
+				next = remaining
+			}
+			var n uint32
+			if windows.ReadFile(h, buffer[:next], &n, nil) != nil || n == 0 || uint64(n) > next {
+				return nil, ErrUpgrade
+			}
+			_, _ = hash.Write(buffer[:n])
+			remaining -= uint64(n)
+		}
+		copy(file.Hash[:], hash.Sum(nil))
+		size, err := upgradeHandleSize(h)
+		id, idErr := upgradeObjectID(h)
+		if err != nil || idErr != nil || size != file.Size || id != file.Object || objectKind(h, false) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	return files, nil
+}
+
+// The original FILE_OBJECT stays at its original name, without DELETE sharing.
+// A distinct bounded child-copy backup follows durable intent and the durable
+// old ordinary-start denial. No root rename or fallback is reachable.
+func (t *upgradeColdTree) capture(ctx context.Context, recorder *upgradeRecorder) error {
+	if t == nil || ctx == nil || ctx.Err() != nil || recorder == nil {
+		return ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || t.backup || t.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j := recorder.last.Journal
+	unknown := recorder.uncertain
+	store, native := recorder.sink.(*nativeUpgradeStore)
+	recorder.mu.Unlock()
+	if unknown || !native || j.Stage != "retired" || !upgradeIntentEqual(j, t.retirement.journal) || j.OldRoot != t.inventory.root || j.RetirementDigest != t.retirement.digest || !t.argumentsMatch(ctx, j.ArgsHash) {
+		return ErrUpgrade
+	}
+	store.mu.Lock()
+	if store.closed || store.uncertain || store.sid != t.sid || store.captureActive {
+		store.mu.Unlock()
+		return ErrUpgrade
+	}
+	store.captureActive = true
+	store.mu.Unlock()
+	t.captureStore = store
+	t.captureRecorder = recorder
+	files, err := t.coldFiles(ctx)
+	if err != nil || !upgradeColdFollows(j.Cold, files) {
+		return ErrUpgrade
+	}
+	j.Cold = files
+	var total uint64
+	for _, entry := range t.entries {
+		item := UpgradeBackupObject{Role: entry.Role, Source: entry.Fact.Object, Directory: entry.Fact.Directory}
+		h := t.handles[entry.Role]
+		if !item.Directory {
+			item.Size, err = upgradeHandleSize(h)
+			if err != nil || total > maxUpgradeCopyBytes-item.Size {
+				return ErrUpgrade
+			}
+			total += item.Size
+			item.Hash, err = hashUpgradeCapture(ctx, h, item.Size)
+			if err != nil {
+				return ErrUpgrade
+			}
+		}
+		j.Capture = append(j.Capture, item)
+	}
+	sort.Slice(j.Capture, func(i, k int) bool { return j.Capture[i].Role < j.Capture[k].Role })
+	next, err := advanceUpgrade(j, "capture-admitted")
+	if err != nil || recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	t.uncertain = true
+	t.mutationAdmitted = true
+	if ctx.Err() != nil || t.retirement.recheck(ctx) != nil || t.installPIDDenial(ctx, recorder, next) != nil {
+		return ErrUpgrade
+	}
+	// Keep both complete handle graphs; backup IDs never replace original IDs.
+	t.originals = t.handles
+	t.originalOrder = t.order
+	t.handles = map[string]windows.Handle{}
+	t.order = nil
+	root, err := createUpgradeCaptureObject(t.inventory.parents.leaf(), "rancher-desktop-orbwin.backup-"+j.Transaction, t.sid, true)
+	if err != nil {
+		return ErrUpgrade
+	}
+	t.handles["root"] = root
+	t.order = append(t.order, "root")
+	next.BackupRoot, err = upgradeObjectID(root)
+	if err != nil || verifyPrivate(root, t.sid, true) != nil {
+		return ErrUpgrade
+	}
+	for _, parent := range []string{"root", "db", "tls"} {
+		for i := range next.Capture {
+			item := &next.Capture[i]
+			spec := upgradeInventoryRoles[item.Role]
+			if spec.parent != parent {
+				continue
+			}
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			dest, err := createUpgradeCaptureObject(t.handles[parent], spec.name, t.sid, item.Directory)
+			if err != nil {
+				return ErrUpgrade
+			}
+			t.handles[item.Role] = dest
+			t.order = append(t.order, item.Role)
+			item.Target, err = upgradeObjectID(dest)
+			if err != nil || item.Target == item.Source || verifyPrivate(dest, t.sid, item.Directory) != nil {
+				return ErrUpgrade
+			}
+			if !item.Directory {
+				source := t.originals[item.Role]
+				file := UpgradeColdFile{item.Role, item.Source, item.Size, item.Hash}
+				if copyUpgradeCaptureChild(ctx, upgradeNativeCaptureFile{source, t.sid, false}, upgradeNativeCaptureFile{dest, t.sid, true}, file, item.Target) != nil {
+					return ErrUpgrade
+				}
+			}
+		}
+	}
+	for _, role := range []string{"db", "tls", "root"} {
+		if windows.FlushFileBuffers(t.handles[role]) != nil {
+			return ErrUpgrade
+		}
+	}
+	if windows.FlushFileBuffers(t.inventory.parents.leaf()) != nil || t.verifyOriginalNamespace(ctx) != nil || t.retirement.recheck(ctx) != nil {
+		return ErrUpgrade
+	}
+	next.LegacyPIDDenial = t.denial
+	next, err = advanceUpgrade(next, "checkpoint-captured")
+	if err != nil || recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	t.backup = true
+	t.uncertain = false
+	return nil
+}
+
+func hashUpgradeCapture(ctx context.Context, h windows.Handle, size uint64) ([32]byte, error) {
+	if ctx == nil || ctx.Err() != nil || size > maxUpgradeCopyBytes {
+		return [32]byte{}, ErrUpgrade
+	}
+	if _, err := windows.Seek(h, 0, io.SeekStart); err != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	defer clear(buffer)
+	remaining := size
+	for remaining > 0 {
+		if ctx.Err() != nil {
+			return [32]byte{}, ErrUpgrade
+		}
+		next := uint64(len(buffer))
+		if remaining < next {
+			next = remaining
+		}
+		var n uint32
+		if windows.ReadFile(h, buffer[:next], &n, nil) != nil || n == 0 || uint64(n) > next {
+			return [32]byte{}, ErrUpgrade
+		}
+		_, _ = hash.Write(buffer[:n])
+		remaining -= uint64(n)
+	}
+	var tail [1]byte
+	var n uint32
+	err := windows.ReadFile(h, tail[:], &n, nil)
+	if n != 0 || err != nil && err != windows.ERROR_HANDLE_EOF {
+		return [32]byte{}, ErrUpgrade
+	}
+	var result [32]byte
+	copy(result[:], hash.Sum(nil))
+	return result, nil
+}
+
+func createUpgradeCaptureObject(parent windows.Handle, name, sid string, directory bool) (windows.Handle, error) {
+	sd, err := privateDescriptor(sid, directory)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	options := uint32(windows.FILE_NON_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT)
+	access := uint32(windows.READ_CONTROL | windows.WRITE_DAC | windows.DELETE | windows.FILE_READ_ATTRIBUTES | windows.FILE_READ_DATA | windows.FILE_WRITE_DATA | windows.SYNCHRONIZE)
+	if directory {
+		options = windows.FILE_DIRECTORY_FILE | windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, access, &oa, &status, nil, 0, 0, windows.FILE_CREATE, options, 0, 0)
+	runtime.KeepAlive(sd)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+// Observe only the fixed original name. Enumerating unrelated LocalAppData entries
+// would make migration depend on an arbitrary directory-entry budget. Metadata
+// access does not compete with this owner's exclusive data/directory handles;
+// the retained original handle continues to deny competing WRITE/DELETE access.
+func openUpgradeDirectoryObservation(parent windows.Handle, name string) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	err = windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, windows.FILE_OPEN, windows.FILE_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	return h, err
+}
+
+type upgradeNativeCaptureFile struct {
+	h       windows.Handle
+	sid     string
+	private bool
+}
+
+func (f upgradeNativeCaptureFile) Read(data []byte) (int, error) {
+	return (upgradeHandleReader{f.h}).Read(data)
+}
+func (f upgradeNativeCaptureFile) Write(data []byte) (int, error) { return nativeWrite(f.h, data) }
+func (f upgradeNativeCaptureFile) Seek(offset int64, whence int) (int64, error) {
+	return windows.Seek(f.h, offset, whence)
+}
+func (f upgradeNativeCaptureFile) flushCapture() error { return windows.FlushFileBuffers(f.h) }
+func (f upgradeNativeCaptureFile) inspectCapture() (UpgradeObject, uint64, error) {
+	if objectKind(f.h, false) != nil || f.private && verifyPrivate(f.h, f.sid, false) != nil || !f.private && upgradeSealOwner(f.h, f.sid) != nil {
+		return UpgradeObject{}, 0, ErrUpgrade
+	}
+	id, err := upgradeObjectID(f.h)
+	if err != nil {
+		return UpgradeObject{}, 0, ErrUpgrade
+	}
+	size, err := upgradeHandleSize(f.h)
+	return id, size, err
+}
diff --git a/rdd/pkg/managementconfig/upgrade_checkpoint.go b/rdd/pkg/managementconfig/upgrade_checkpoint.go
new file mode 100644
index 0000000000000000000000000000000000000000..7ddf1265649e9472498f55aca071347cfef78c81
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_checkpoint.go
@@ -0,0 +1,138 @@
+package managementconfig
+
+import (
+	"context"
+	"sort"
+	"sync"
+)
+
+// The checkpoint owner serializes irreversible native work with journal writes.
+// It retains the entire exclusive tree on every uncertain outcome. Cancellation
+// after admission cannot make a native operation replayable. Recovery must open
+// the recorded transaction independently; this owner never retries a mutation.
+// No implementation may return success before its native IDs, DACL and flush
+// postconditions are verified. A rename alone is not a confidentiality receipt.
+type upgradeCheckpointOps interface {
+	seal(context.Context, upgradeInventoryEntry) (UpgradeSeal, error)
+	verifyUpgradeSealed(context.Context, []upgradeInventoryEntry) error
+}
+
+type upgradeCheckpointOwner struct {
+	mu        sync.Mutex
+	recorder  *upgradeRecorder
+	ops       upgradeCheckpointOps
+	entries   []upgradeInventoryEntry
+	journal   upgradeJournal
+	attempted bool
+}
+
+// root is the distinct backup root; entries are the original native inventory.
+// Only exact journaled Source→Target mappings can supply the seal plan.
+func newUpgradeCheckpointOwner(recorder *upgradeRecorder, ops upgradeCheckpointOps, root UpgradeObject, entries []upgradeInventoryEntry) (*upgradeCheckpointOwner, error) {
+	if recorder == nil || ops == nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	j := recorder.last.Journal
+	if recorder.uncertain || j.Stage != "checkpoint-captured" || j.BackupRoot != root || j.OldRoot == root || len(j.Seals) != 0 {
+		return nil, ErrUpgrade
+	}
+	facts := make([]upgradeInventoryObject, len(entries))
+	for i, entry := range entries {
+		facts[i] = entry.Fact
+		found := false
+		for _, copied := range j.Capture {
+			if copied.Role == entry.Role && copied.Source == entry.Fact.Object {
+				facts[i].Object = copied.Target
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, ErrUpgrade
+		}
+	}
+	planned, err := planUpgradeInventory(root, facts)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	cold := map[string]UpgradeObject{}
+	for _, file := range j.Cold {
+		for _, copied := range j.Capture {
+			if copied.Role == file.Role {
+				cold[file.Role] = copied.Target
+			}
+		}
+	}
+	for _, entry := range planned {
+		if upgradeColdRole(entry.Role) {
+			if cold[entry.Role] != entry.Fact.Object {
+				return nil, ErrUpgrade
+			}
+			delete(cold, entry.Role)
+		}
+	}
+	if len(cold) != 0 {
+		return nil, ErrUpgrade
+	}
+	// Include the root itself, which the ordinary inventory represents separately.
+	planned = append(planned, upgradeInventoryEntry{"root", upgradeInventoryObject{Object: root, Directory: true}})
+	// Seal leaves before directories so inheritance cannot alter a yet-unsealed
+	// child between that child's before/after receipts. Every object gets its own
+	// explicit descriptor; inherited privacy is never assumed.
+	sort.Slice(planned, func(i, j int) bool {
+		if planned[i].Fact.Directory != planned[j].Fact.Directory {
+			return !planned[i].Fact.Directory
+		}
+		if planned[i].Role == "root" {
+			return false
+		}
+		if planned[j].Role == "root" {
+			return true
+		}
+		return planned[i].Role < planned[j].Role
+	})
+	return &upgradeCheckpointOwner{recorder: recorder, ops: ops, entries: planned, journal: j}, nil
+}
+
+func (o *upgradeCheckpointOwner) seal(ctx context.Context) error {
+	if o == nil || ctx == nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.attempted || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	o.attempted = true
+	next, err := advanceUpgrade(o.journal, "sealing-admitted")
+	if err != nil || o.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	o.journal = next
+	for _, entry := range o.entries {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		receipt, err := o.ops.seal(ctx, entry)
+		if err != nil || receipt.Role != entry.Role || receipt.Object != entry.Fact.Object || receipt.BeforeACL == [32]byte{} || receipt.AfterACL == [32]byte{} {
+			return ErrUpgrade
+		}
+		next = o.journal
+		next.Seals = append(append([]UpgradeSeal(nil), o.journal.Seals...), receipt)
+		if o.recorder.append(ctx, next) != nil {
+			return ErrUpgrade
+		}
+		o.journal = next
+	}
+	if o.ops.verifyUpgradeSealed(ctx, o.entries) != nil {
+		return ErrUpgrade
+	}
+	next, err = advanceUpgrade(o.journal, "checkpoint-sealed")
+	if err != nil || o.recorder.append(ctx, next) != nil {
+		return ErrUpgrade
+	}
+	o.journal = next
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_checkpoint_test.go b/rdd/pkg/managementconfig/upgrade_checkpoint_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7b9de2fb1ff152fe215e61f2d0743464e6fc814d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_checkpoint_test.go
@@ -0,0 +1,193 @@
+package managementconfig
+
+import (
+	"context"
+	"fmt"
+	"testing"
+)
+
+func TestUpgradeWorkingReceiptKeepsColdIdentityAndRecoveryLayoutClosed(t *testing.T) {
+	sink := &fakeUpgradeSink{}
+	o := upgradeCheckpointFixture(t, sink, &fakeUpgradeSealer{})
+	if o.seal(context.Background()) != nil {
+		t.Fatal("seal fixture")
+	}
+	names := func(extra string) []string {
+		var names []string
+		for i := range sink.records {
+			names = append(names, fmt.Sprintf("record-%02d.json", i+1))
+		}
+		return append(names, extra)
+	}
+	if upgradeStoreLayoutMatch(names("working"), len(sink.records), sink.records) {
+		t.Fatal("working state adopted before admission")
+	}
+	j, err := advanceUpgrade(o.journal, "copy-admitted")
+	if err != nil || o.recorder.append(context.Background(), j) != nil {
+		t.Fatal("copy admission")
+	}
+	if !upgradeStoreLayoutMatch(names("working"), len(sink.records), sink.records) || upgradeStoreLayoutMatch(names("foreign"), len(sink.records), sink.records) {
+		t.Fatal("recovery namespace not closed")
+	}
+	j.WorkingRoot = UpgradeObject{9, 0, 1}
+	j.Normalized = UpgradeObject{9, 0, 2}
+	for i, file := range j.Cold {
+		file.Object = UpgradeObject{9, 0, uint32(i + 3)}
+		j.Working = append(j.Working, file)
+	}
+	j, err = advanceUpgrade(j, "working-copied")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*upgradeJournal){
+		func(j *upgradeJournal) { j.Working[0].Object = j.Cold[0].Object },
+		func(j *upgradeJournal) { j.Working[0].Size++ },
+		func(j *upgradeJournal) { j.Working[0].Hash[0] ^= 1 },
+		func(j *upgradeJournal) { j.Working[0].Object = j.Normalized },
+		func(j *upgradeJournal) { j.Working = j.Working[:1] },
+	} {
+		bad := j
+		bad.Working = append([]UpgradeColdFile(nil), j.Working...)
+		mutate(&bad)
+		if bad.valid() {
+			t.Fatal("altered working-copy evidence accepted")
+		}
+	}
+}
+
+type fakeUpgradeSealer struct {
+	verifyFail bool
+	calls      int
+	failAt     int
+	wrong      bool
+	cancel     context.CancelFunc
+}
+
+func (s *fakeUpgradeSealer) verifyUpgradeSealed(context.Context, []upgradeInventoryEntry) error {
+	if s.verifyFail {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *fakeUpgradeSealer) seal(_ context.Context, e upgradeInventoryEntry) (UpgradeSeal, error) {
+	s.calls++
+	if s.cancel != nil {
+		s.cancel()
+	}
+	if s.calls == s.failAt {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	id := e.Fact.Object
+	if s.wrong {
+		id.Low++
+	}
+	return UpgradeSeal{e.Role, id, [32]byte{1}, [32]byte{2}}, nil
+}
+
+func upgradeCheckpointFixture(t *testing.T, sink *fakeUpgradeSink, ops *fakeUpgradeSealer) *upgradeCheckpointOwner {
+	t.Helper()
+	j := upgradeFixture()
+	j.OldRoot = UpgradeObject{1, 0, 1}
+	r, _ := newUpgradeRecorder(sink, nil)
+	if r.append(context.Background(), j) != nil {
+		t.Fatal("prepare")
+	}
+	for _, stage := range []string{"interruption-admitted", "retired", "capture-admitted", "checkpoint-captured"} {
+		if stage == "retired" {
+			j.RetirementDigest = [32]byte{1}
+			j.Cold = []UpgradeColdFile{{Role: "main", Object: UpgradeObject{1, 0, 5}, Size: 4096}, {Role: "wal", Object: UpgradeObject{1, 0, 6}}, {Role: "shm", Object: UpgradeObject{1, 0, 7}}}
+		}
+		if stage == "checkpoint-captured" {
+			fixtureUpgradeCapture(&j)
+			j.Cold[0].Hash = [32]byte{1}
+			j.Cold[1].Hash = [32]byte{2}
+			j.Cold[2].Hash = [32]byte{3}
+		}
+		var err error
+		if stage == "capture-admitted" {
+			fixtureUpgradeCapturePlan(&j)
+		}
+		j, err = advanceUpgrade(j, stage)
+		if err != nil || r.append(context.Background(), j) != nil {
+			t.Fatal(stage, err)
+		}
+	}
+	entries, err := planUpgradeInventory(j.OldRoot, upgradeInventoryFixture())
+	if err != nil {
+		t.Fatal(err)
+	}
+	o, err := newUpgradeCheckpointOwner(r, ops, j.BackupRoot, entries)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return o
+}
+
+func TestUpgradeCheckpointSealsEveryLeafBeforeRoot(t *testing.T) {
+	sealer := &fakeUpgradeSealer{}
+	sink := &fakeUpgradeSink{}
+	o := upgradeCheckpointFixture(t, sink, sealer)
+	if o.seal(context.Background()) != nil || o.journal.Stage != "checkpoint-sealed" || sealer.calls != 7 {
+		t.Fatal("complete exact tree was not sealed")
+	}
+	if o.journal.Seals[len(o.journal.Seals)-1].Role != "root" {
+		t.Fatal("root sealed before descendants")
+	}
+	seenDirectory := false
+	for _, entry := range o.entries {
+		if entry.Fact.Directory {
+			seenDirectory = true
+		} else if seenDirectory {
+			t.Fatal("directory sealed before leaf")
+		}
+	}
+	if o.seal(context.Background()) == nil || sealer.calls != 7 {
+		t.Fatal("successful mutation replayed")
+	}
+	if _, err := newUpgradeRecorder(sink, sink.records); err != nil {
+		t.Fatal("durable per-object chain unrecoverable", err)
+	}
+}
+
+func TestUpgradeCheckpointFailuresRetainAdmissionAndNeverReplay(t *testing.T) {
+	for _, kind := range []string{"native", "identity", "journal", "journal-after-leaf", "late-entry", "cancel"} {
+		t.Run(kind, func(t *testing.T) {
+			sealer := &fakeUpgradeSealer{}
+			sink := &fakeUpgradeSink{}
+			o := upgradeCheckpointFixture(t, sink, sealer)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			switch kind {
+			case "native":
+				sealer.failAt = 2
+			case "late-entry":
+				sealer.verifyFail = true
+			case "identity":
+				sealer.wrong = true
+			case "journal":
+				sink.fail = true
+			case "journal-after-leaf":
+				sink.failAt = sink.writes + 3
+			case "cancel":
+				sealer.cancel = cancel
+			}
+			if o.seal(ctx) == nil || o.journal.Stage == "checkpoint-sealed" {
+				t.Fatal("partial/unknown seal acknowledged")
+			}
+			calls, writes := sealer.calls, sink.writes
+			if o.seal(context.Background()) == nil || sealer.calls != calls || sink.writes != writes {
+				t.Fatal("uncertain seal replayed")
+			}
+			if kind == "native" && len(o.journal.Seals) != 1 {
+				t.Fatal("lost earlier seal receipt")
+			}
+			if kind == "journal" && sealer.calls != 0 {
+				t.Fatal("native mutation before durable admission")
+			}
+			if kind == "journal-after-leaf" && (sealer.calls != 2 || len(o.journal.Seals) != 1 || !o.recorder.uncertain) {
+				t.Fatal("lost-reply leaf seal treated as acknowledged or lost earlier receipt")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_cold_windows.go b/rdd/pkg/managementconfig/upgrade_cold_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..668932339f4ae002cb386e461daecc3da234a163
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_cold_windows.go
@@ -0,0 +1,361 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Exclusive handles own the whole bounded tree, including directories. Failure
+// retains partial ownership for inspection; it never repairs the old root or
+// closes a handle to retry a refused file. No filesystem path is accepted here.
+type upgradeColdTree struct {
+	observations                                []windows.Handle
+	originals                                   map[string]windows.Handle
+	originalOrder                               []string
+	denialDirectory, denialReceipt              windows.Handle
+	unknownDenialHandle                         windows.Handle
+	denial                                      UpgradePIDDenial
+	captureStore                                *nativeUpgradeStore
+	captureRecorder                             *upgradeRecorder
+	mu                                          sync.Mutex
+	inventory                                   *upgradeLegacyInventory
+	retirement                                  *upgradeRetirement
+	handles                                     map[string]windows.Handle
+	order                                       []string
+	entries                                     []upgradeInventoryEntry
+	sid                                         string
+	closed, uncertain                           bool
+	closeErr                                    error
+	backup                                      bool
+	mutationAdmitted                            bool
+	restoreAttempted, restored, restoreReleased bool
+}
+
+func (t *upgradeColdTree) Close() error {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.uncertain && t.mutationAdmitted {
+		return ErrUpgrade
+	}
+	if t.mutationAdmitted {
+		if t.captureRecorder == nil {
+			return ErrUpgrade
+		}
+		t.captureRecorder.mu.Lock()
+		j := t.captureRecorder.last.Journal
+		unknown := t.captureRecorder.uncertain
+		t.captureRecorder.mu.Unlock()
+		if unknown || t.restoreReleased && j.Recovery.Stage != "rolled-back" || !t.restoreReleased && (j.Stage != "committed" || j.Recovery.Schema != 0) {
+			return ErrUpgrade
+		}
+	}
+	if t.closeErr != nil || t.inventory != nil && t.inventory.closeErr != nil {
+		return ErrUpgrade
+	}
+	if t.closed {
+		return t.closeErr
+	}
+	t.closed = true
+	for i := len(t.observations) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.observations[i]) != nil {
+			t.closeErr = ErrUpgrade
+			return t.closeErr
+		}
+	}
+	for i := len(t.order) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.handles[t.order[i]]) != nil {
+			t.closeErr = ErrUpgrade
+			return t.closeErr
+		}
+	}
+	// The nonempty denial is intentionally persistent after handle closure.
+	for _, h := range []windows.Handle{t.denialReceipt, t.denialDirectory} {
+		if h != 0 && windows.CloseHandle(h) != nil {
+			t.closeErr = ErrUpgrade
+			return t.closeErr
+		}
+	}
+	for i := len(t.originalOrder) - 1; i >= 0; i-- {
+		if windows.CloseHandle(t.originals[t.originalOrder[i]]) != nil {
+			t.closeErr = ErrUpgrade
+			return t.closeErr
+		}
+	}
+	if t.inventory != nil && t.inventory.Close() != nil {
+		t.closeErr = ErrUpgrade
+	}
+	if t.closeErr == nil && t.captureStore != nil {
+		t.captureStore.mu.Lock()
+		t.captureStore.captureActive = false
+		t.captureStore.mu.Unlock()
+	}
+	return t.closeErr
+}
+
+func openUpgradeExclusive(parent windows.Handle, name string, directory bool) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	access := uint32(windows.READ_CONTROL | windows.WRITE_DAC | windows.FILE_READ_ATTRIBUTES | windows.SYNCHRONIZE)
+	options := uint32(windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_NON_DIRECTORY_FILE)
+	if directory {
+		access |= windows.FILE_LIST_DIRECTORY | windows.FILE_WRITE_DATA
+		options = windows.FILE_OPEN_REPARSE_POINT | windows.FILE_SYNCHRONOUS_IO_NONALERT | windows.FILE_DIRECTORY_FILE
+	} else {
+		access |= windows.FILE_READ_DATA
+		if name == "rdd.pid" {
+			access |= windows.DELETE | windows.FILE_WRITE_DATA
+		}
+	}
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtCreateFile(&h, access, &oa, &status, nil, 0, 0, windows.FILE_OPEN, options, 0, 0) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+// Preparation's permissive read/write-sharing metadata handles cannot become
+// exclusive by duplication. Release only this inventory's child/root handles,
+// retain its parent chain, then reopen relative to that held parent and compare
+// every original ID. A namespace swap during this handoff refuses the transaction.
+// The returned nonnil owner MUST be retained even on error.
+func takeUpgradeColdTree(ctx context.Context, inventory *upgradeLegacyInventory, retirement *upgradeRetirement) (*upgradeColdTree, error) {
+	if ctx == nil || ctx.Err() != nil || inventory == nil || retirement == nil || retirement.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	inventory.mu.Lock()
+	defer inventory.mu.Unlock()
+	if inventory.closed || inventory.parents == nil || len(inventory.parents.chain) < 2 || inventory.root != retirement.journal.OldRoot {
+		return nil, ErrUpgrade
+	}
+	t := &upgradeColdTree{inventory: inventory, retirement: retirement, handles: map[string]windows.Handle{}, entries: append([]upgradeInventoryEntry(nil), inventory.entries...), sid: inventory.parents.sid, uncertain: true}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != t.sid {
+		return t, ErrUpgrade
+	}
+	// Consume the old handles. Mark failures closed in the inventory so Close
+	// cannot accidentally double-close a reused numeric handle.
+	for i := len(inventory.children) - 1; i >= 0; i-- {
+		h := inventory.children[i]
+		inventory.children = inventory.children[:i]
+		if windows.CloseHandle(h) != nil {
+			inventory.closeErr = ErrUpgrade
+			return t, ErrUpgrade
+		}
+	}
+	chain := inventory.parents.chain
+	oldRoot := chain[len(chain)-1]
+	inventory.parents.chain = chain[:len(chain)-1]
+	if windows.CloseHandle(oldRoot) != nil {
+		inventory.closeErr = ErrUpgrade
+		return t, ErrUpgrade
+	}
+	h, err := openUpgradeExclusive(inventory.parents.leaf(), "rancher-desktop-orbwin", true)
+	if err != nil {
+		return t, ErrUpgrade
+	}
+	t.handles["root"] = h
+	t.order = append(t.order, "root")
+	if objectKind(h, true) != nil {
+		return t, ErrUpgrade
+	}
+	if upgradeSealOwner(h, t.sid) != nil {
+		return t, ErrUpgrade
+	}
+	id, err := upgradeObjectID(h)
+	if err != nil || id != inventory.root {
+		return t, ErrUpgrade
+	}
+	// Two fixed directory levels; inventory input order is deliberately ignored.
+	for _, parent := range []string{"root", "db", "tls"} {
+		p := t.handles[parent]
+		if p == 0 {
+			return t, ErrUpgrade
+		}
+		names, err := upgradeStoreNames(p)
+		if err != nil {
+			return t, ErrUpgrade
+		}
+		expected := map[string]upgradeInventoryEntry{}
+		for _, entry := range t.entries {
+			if entry.Fact.Parent == parent {
+				expected[entry.Fact.Name] = entry
+			}
+		}
+		if len(names) != len(expected) {
+			return t, ErrUpgrade
+		}
+		for _, name := range names {
+			entry, ok := expected[name]
+			if !ok || ctx.Err() != nil {
+				return t, ErrUpgrade
+			}
+			child, err := openUpgradeExclusive(p, name, entry.Fact.Directory)
+			if err != nil {
+				return t, ErrUpgrade
+			}
+			t.handles[entry.Role] = child
+			t.order = append(t.order, entry.Role)
+			if objectKind(child, entry.Fact.Directory) != nil {
+				return t, ErrUpgrade
+			}
+			if upgradeSealOwner(child, t.sid) != nil {
+				return t, ErrUpgrade
+			}
+			id, err := upgradeObjectID(child)
+			if err != nil || id != entry.Fact.Object {
+				return t, ErrUpgrade
+			}
+		}
+	}
+	if retirement.recheck(ctx) != nil {
+		return t, ErrUpgrade
+	}
+	t.uncertain = false
+	return t, nil
+}
+
+func upgradeACLHash(h windows.Handle) ([32]byte, error) {
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if err != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	text := sd.String()
+	if text == "" || len(text) > 64<<10 {
+		return [32]byte{}, ErrUpgrade
+	}
+	return sha256.Sum256([]byte(text)), nil
+}
+
+func upgradeSealOwner(h windows.Handle, sid string) error {
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION)
+	if err != nil {
+		return ErrUpgrade
+	}
+	owner, _, err := sd.Owner()
+	if err != nil || owner == nil || owner.String() != sid {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Directory handle sharing is not treated as an immutable child-name snapshot.
+// Once EVERY known directory has a private protected DACL, re-enumerate the
+// complete namespace and recheck every held ID, one-link kind and descriptor.
+// A late/foreign child is retained for inspection, never silently adopted or
+// given WRITE_DAC. Unknown prior directory writers were refused at takeover.
+func (t *upgradeColdTree) verifyUpgradeSealed(ctx context.Context, entries []upgradeInventoryEntry) error {
+	if t == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup || len(entries) != len(t.entries)+1 {
+		return ErrUpgrade
+	}
+	t.uncertain = true
+	for _, entry := range entries {
+		h := t.handles[entry.Role]
+		id, err := upgradeObjectID(h)
+		if err != nil || id != entry.Fact.Object || verifyPrivate(h, t.sid, entry.Fact.Directory) != nil {
+			return ErrUpgrade
+		}
+	}
+	for _, parent := range []string{"root", "db", "tls"} {
+		names, err := upgradeStoreNames(t.handles[parent])
+		if err != nil {
+			return ErrUpgrade
+		}
+		want := map[string]bool{}
+		for _, entry := range t.entries {
+			if entry.Fact.Parent == parent {
+				want[entry.Fact.Name] = true
+			}
+		}
+		if len(names) != len(want) {
+			return ErrUpgrade
+		}
+		for _, name := range names {
+			if !want[name] || ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			delete(want, name)
+		}
+		if len(want) != 0 {
+			return ErrUpgrade
+		}
+	}
+	if ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	t.uncertain = false
+	return nil
+}
+
+// Only the checkpoint coordinator invokes this after durable sealing admission
+// and exact distinct-backup copy acknowledgement. Explicit DACLs on every leaf avoid
+// Windows traversal bypass leaking inherited-readable historical credentials.
+func (t *upgradeColdTree) seal(ctx context.Context, entry upgradeInventoryEntry) (UpgradeSeal, error) {
+	if t == nil || ctx == nil || ctx.Err() != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	h := t.handles[entry.Role]
+	if h == 0 {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	id, err := upgradeObjectID(h)
+	if err != nil || id != entry.Fact.Object || objectKind(h, entry.Fact.Directory) != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	before, err := upgradeACLHash(h)
+	if err != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	sd, err := privateDescriptor(t.sid, entry.Fact.Directory)
+	if err != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	acl, _, err := sd.DACL()
+	if err != nil || acl == nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	// Latch BEFORE WRITE_DAC. The owner cannot retry a lost or cancelled reply.
+	t.uncertain = true
+	if windows.SetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil) != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	if ctx.Err() != nil || verifyPrivate(h, t.sid, entry.Fact.Directory) != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	after, err := upgradeACLHash(h)
+	if err != nil {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	id, err = upgradeObjectID(h)
+	if err != nil || id != entry.Fact.Object {
+		return UpgradeSeal{}, ErrUpgrade
+	}
+	t.uncertain = false
+	return UpgradeSeal{entry.Role, id, before, after}, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_copy.go b/rdd/pkg/managementconfig/upgrade_copy.go
new file mode 100644
index 0000000000000000000000000000000000000000..29bccdc67cd062ac84e45c26adb37f6fb10711ef
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_copy.go
@@ -0,0 +1,82 @@
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+)
+
+const maxUpgradeCopyBytes uint64 = 8 << 30
+
+// This byte primitive grants no filesystem capability. The native copy owner
+// must supply a held exclusive sealed SQLite source and a CREATE_NEW private
+// destination, latch admission before calling, flush/recheck IDs/privacy/bytes
+// after it, and retain the partial destination on ANY error. Keys/config/TLS
+// cannot enter through a non-SQLite role. Buffer size is independent of DB size.
+// Synchronous I/O is cancellable at call boundaries, never by abandoning a worker
+// which may still be writing. Errors must not cause a replay against that file.
+func copyUpgradeCold(ctx context.Context, source io.Reader, destination io.Writer, file UpgradeColdFile) error {
+	if ctx == nil || ctx.Err() != nil || source == nil || destination == nil || !upgradeColdRole(file.Role) || !file.Object.valid() || file.Hash == [32]byte{} || file.Size > maxUpgradeCopyBytes {
+		return ErrUpgrade
+	}
+	return copyUpgradeBytes(ctx, source, destination, file)
+}
+
+// Historical keys/configuration are copied only by the complete native capture
+// owner, never fed into SQLite. This bounded byte primitive itself grants no
+// native authority and uses the same EOF, short-write and digest checks.
+func copyUpgradeHistorical(ctx context.Context, source io.Reader, destination io.Writer, file UpgradeColdFile) error {
+	spec, ok := upgradeInventoryRoles[file.Role]
+	if !ok || spec.directory || ctx == nil || ctx.Err() != nil || source == nil || destination == nil || !file.Object.valid() || file.Hash == [32]byte{} || file.Size > maxUpgradeCopyBytes {
+		return ErrUpgrade
+	}
+	return copyUpgradeBytes(ctx, source, destination, file)
+}
+func copyUpgradeBytes(ctx context.Context, source io.Reader, destination io.Writer, file UpgradeColdFile) error {
+	buffer := make([]byte, 64<<10)
+	defer clear(buffer)
+	hash := sha256.New()
+	remaining := file.Size
+	for remaining > 0 {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		next := uint64(len(buffer))
+		if remaining < next {
+			next = remaining
+		}
+		n, err := source.Read(buffer[:next])
+		if n < 1 || uint64(n) > next || err != nil && err != io.EOF {
+			return ErrUpgrade
+		}
+		_, _ = hash.Write(buffer[:n])
+		for pending := buffer[:n]; len(pending) > 0; {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			written, writeErr := destination.Write(pending)
+			if writeErr != nil || written < 1 || written > len(pending) {
+				return ErrUpgrade
+			}
+			pending = pending[written:]
+		}
+		remaining -= uint64(n)
+		if err == io.EOF && remaining != 0 {
+			return ErrUpgrade
+		}
+	}
+	// A size change, long source or a stalled reader cannot be accepted merely
+	// because its declared prefix matched. EOF is independently required.
+	var tail [1]byte
+	n, err := source.Read(tail[:])
+	clear(tail[:])
+	if n != 0 || err != io.EOF || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	var digest [32]byte
+	copy(digest[:], hash.Sum(nil))
+	if digest != file.Hash {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_copy_test.go b/rdd/pkg/managementconfig/upgrade_copy_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4c4e361a0abb1b0382fe50282da27e4d9664d795
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_copy_test.go
@@ -0,0 +1,86 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"io"
+	"testing"
+)
+
+type upgradeShortWriter struct {
+	bytes.Buffer
+	cancel context.CancelFunc
+	calls  int
+	fail   int
+}
+
+func (w *upgradeShortWriter) Write(data []byte) (int, error) {
+	w.calls++
+	if w.calls == w.fail {
+		return 0, io.ErrShortWrite
+	}
+	if w.cancel != nil {
+		w.cancel()
+	}
+	if len(data) > 7 {
+		data = data[:7]
+	}
+	return w.Buffer.Write(data)
+}
+
+type upgradeStalledReader struct{}
+
+func (upgradeStalledReader) Read([]byte) (int, error) { return 0, nil }
+
+func TestUpgradeColdCopyPreservesOpaqueBytesAndHandlesShortWrites(t *testing.T) {
+	data := bytes.Repeat([]byte{0, 255, 128, 42}, 40000)
+	file := UpgradeColdFile{Role: "main", Object: UpgradeObject{1, 0, 2}, Size: uint64(len(data)), Hash: sha256.Sum256(data)}
+	dest := &upgradeShortWriter{}
+	if copyUpgradeCold(context.Background(), bytes.NewReader(data), dest, file) != nil || !bytes.Equal(data, dest.Bytes()) {
+		t.Fatal("opaque complete checkpoint changed")
+	}
+	file.Role = "wal"
+	file.Size = 0
+	file.Hash = sha256.Sum256(nil)
+	if copyUpgradeCold(context.Background(), bytes.NewReader(nil), &bytes.Buffer{}, file) != nil {
+		t.Fatal("empty recorded sidecar refused")
+	}
+}
+
+func TestUpgradeColdCopyRefusesIncompleteChangedAndCancelledInput(t *testing.T) {
+	data := []byte("opaque application state")
+	for _, kind := range []string{"short", "long", "hash", "role", "stalled", "write", "cancel", "budget"} {
+		t.Run(kind, func(t *testing.T) {
+			file := UpgradeColdFile{Role: "main", Object: UpgradeObject{1, 0, 2}, Size: uint64(len(data)), Hash: sha256.Sum256(data)}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			var source io.Reader = bytes.NewReader(data)
+			dest := &upgradeShortWriter{}
+			switch kind {
+			case "short":
+				source = bytes.NewReader(data[:len(data)-1])
+			case "long":
+				source = bytes.NewReader(append(append([]byte(nil), data...), 0))
+			case "hash":
+				file.Hash[0] ^= 1
+			case "role":
+				file.Role = "management-key"
+			case "stalled":
+				source = upgradeStalledReader{}
+			case "write":
+				dest.fail = 2
+			case "cancel":
+				dest.cancel = cancel
+			case "budget":
+				file.Size = maxUpgradeCopyBytes + 1
+			}
+			if copyUpgradeCold(ctx, source, dest, file) == nil {
+				t.Fatal("unproven copy acknowledged")
+			}
+			if (kind == "role" || kind == "budget") && dest.Len() != 0 {
+				t.Fatal("invalid admission wrote destination")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_directory_windows.go b/rdd/pkg/managementconfig/upgrade_directory_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..20391c8be7f0ce1664e5d325ac698537c289587c
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_directory_windows.go
@@ -0,0 +1,20 @@
+//go:build windows
+
+package managementconfig
+
+import "unsafe"
+
+// FILE_ID_BOTH_DIR_INFO requires an 8-byte aligned buffer. A []byte stack
+// allocation has only byte alignment in Go; do not depend on heap escape or
+// incidental frame layout to satisfy the Windows ABI.
+func managementDirectoryBuffer(size int) ([]uint64, []byte, error) {
+	if size < 8 || size > 64<<10 || size%8 != 0 {
+		return nil, nil, ErrUpgrade
+	}
+	words := make([]uint64, size/8)
+	buffer := unsafe.Slice((*byte)(unsafe.Pointer(&words[0])), size)
+	if uintptr(unsafe.Pointer(&buffer[0]))%8 != 0 {
+		return nil, nil, ErrUpgrade
+	}
+	return words, buffer, nil
+}
