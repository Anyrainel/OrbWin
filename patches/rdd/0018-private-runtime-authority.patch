@@ -0,0 +1,57 @@
+package managementconfig
+
+import (
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type upgradeSDKCandidateLaunch struct {
+	MigrationPermit uintptr
+	SDKRetirement   uintptr
+	Handles         []uintptr
+}
+
+// Same fixed product environment as the existing desktop launcher. Native
+// constructors supply the home and inherited caps; caller environment cannot
+// redirect authority, engine, kubeconfig or a private capability role.
+func upgradeCandidateEnvironment(inherited []string, home string, launch upgradeSDKCandidateLaunch) ([]string, error) {
+	if home == "" || strings.ContainsRune(home, 0) || launch.MigrationPermit == 0 || launch.SDKRetirement == 0 || launch.MigrationPermit == launch.SDKRetirement {
+		return nil, ErrUpgrade
+	}
+	remove := map[string]bool{"USERPROFILE": true, "HOME": true, "RDD_INSTANCE": true, "RDD_LOG_DIR": true, "LIMA_HOME": true, "DOCKER_CONFIG": true, "KUBECONFIG": true, "DOCKER_HOST": true, "DOCKER_CONTEXT": true, "DOCKER_TLS_VERIFY": true, "DOCKER_CERT_PATH": true, "RDD_DEVELOPER_MODE": true, "RDD_KEEP_LOGS": true}
+	values := map[string]string{}
+	for _, entry := range inherited {
+		if strings.ContainsRune(entry, 0) {
+			return nil, ErrUpgrade
+		}
+		key, _, ok := strings.Cut(entry, "=")
+		if !ok || key == "" {
+			continue
+		}
+		upper := strings.ToUpper(key)
+		if remove[upper] || strings.HasPrefix(upper, "ORBWIN_PRIVATE_") {
+			continue
+		}
+		values[upper] = entry
+	}
+	short := filepath.Join(home, ".rdorbwin")
+	for _, entry := range []string{"USERPROFILE=" + home, "HOME=" + home, "RDD_INSTANCE=orbwin", "RDD_DEVELOPER_MODE=1", "RDD_KEEP_LOGS=1", "DOCKER_CONFIG=" + filepath.Join(short, "docker"), "KUBECONFIG=" + filepath.Join(short, "kube-client.config"), "DOCKER_HOST=npipe:////./pipe/docker-rancher-desktop-orbwin", upgradePermitEnvironmentName + "=" + strconv.FormatUint(uint64(launch.MigrationPermit), 10), upgradeSDKOwnerEnvironmentName + "=" + strconv.FormatUint(uint64(launch.SDKRetirement), 10)} {
+		key, _, _ := strings.Cut(entry, "=")
+		values[strings.ToUpper(key)] = entry
+	}
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	result := make([]string, 0, len(keys))
+	for _, key := range keys {
+		result = append(result, values[key])
+	}
+	return result, nil
+}
+
+const upgradePermitEnvironmentName = "ORBWIN_PRIVATE_MIGRATION_HANDLE"
+const upgradeSDKOwnerEnvironmentName = "ORBWIN_PRIVATE_SDK_OWNER_HANDLE"
