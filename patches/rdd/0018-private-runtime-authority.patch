index 0000000000000000000000000000000000000000..20851facc1663368aea095d7b15e85179b619d52
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_grant_test.go
@@ -0,0 +1,54 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+)
+
+func testUpgradeSDKGrant() upgradeSDKGrantWire {
+	var old [32]byte
+	body, _ := hex.DecodeString(upgradeLegacySDKImageSHA256)
+	copy(old[:], body)
+	return upgradeSDKGrantWire{2, upgradeSDKGrantScope{strings.Repeat("a", 32), strings.Repeat("b", 32), strings.Repeat("b", 32), "S-1-5-21-123", [32]byte{1}, [32]byte{2}}, upgradeSDKGrantProcess{31, 41, 1, [32]byte{3}}, 102, 103, []upgradeSDKGrantInherited{{upgradeSDKGrantProcess{32, 21, 1, old}, 107, 108, 109}}, upgradeSDKFinalTransfer{105, 106, "01:02", [32]byte{4}}, 104, 110}
+}
+
+func TestUpgradeSDKGrantWirePreservesSDKFieldCaseAndDisjointOwnership(t *testing.T) {
+	g := testUpgradeSDKGrant()
+	body, err := upgradeSDKGrantBytes(g, 101)
+	if err != nil || !bytes.Contains(body, []byte(`"Identity":{"PID":32,"Creation":21,"Session":1,"Image":`)) || bytes.Contains(body, []byte(`"pid"`)) {
+		t.Fatal("native wire reused lower-case management journal process tags", err)
+	}
+	// Every role-pair alias must refuse before writing an inherited grant. This
+	// prevents double native adoption even when an internal launcher has a bug.
+	for one := 0; one < 10; one++ {
+		for two := one + 1; two < 10; two++ {
+			bad := testUpgradeSDKGrant()
+			raw := uint64(101)
+			roles := []*uint64{&raw, &bad.LegacyRoot, &bad.Controller, &bad.Denial, &bad.Final.File, &bad.Final.Event, &bad.Processes[0].Process, &bad.Processes[0].Token, &bad.Processes[0].Image, &bad.Control}
+			*roles[two] = *roles[one]
+			if _, err := upgradeSDKGrantBytes(bad, raw); err == nil {
+				t.Fatalf("native role alias %d/%d was serialized", one, two)
+			}
+		}
+	}
+	for _, kind := range []string{"old-image", "scope", "daemon", "session", "no-old-generation"} {
+		bad := testUpgradeSDKGrant()
+		switch kind {
+		case "old-image":
+			bad.Processes[0].Identity.Image[0] ^= 1
+		case "scope":
+			bad.Scope.Installation = strings.Repeat("c", 32)
+		case "daemon":
+			bad.Scope.Daemon, bad.Scope.Installation = "not-a-daemon", "not-a-daemon"
+		case "session":
+			bad.Processes[0].Identity.Session++
+		case "no-old-generation":
+			bad.Processes = nil
+		}
+		if _, err := upgradeSDKGrantBytes(bad, 101); err == nil {
+			t.Fatal("invalid native grant encoded", kind)
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_grant_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_grant_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..75cd358ee51fa59eda20b2e2dcb9f0a63835e3e8
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_grant_windows.go
@@ -0,0 +1,230 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+)
+
+// Owns initial SDK launch admission, not a running SDK or an accepted serving
+// parent. Every partial native step remains reachable through this owner.
+// There is deliberately no destructor or listener-release method: admitting a
+// child or losing a syscall outcome must not close the predecessor graph.
+type nativeUpgradeSDKGrant struct {
+	mu                           sync.Mutex
+	authority                    *upgradeAuthorityOwner
+	legacy                       *nativeUpgradeLegacySDKOwner
+	image                        *nativeUpgradeSDKImage
+	denial                       *nativeUpgradeSDKDenial
+	final                        *nativeUpgradeSDKFinalSlot
+	writer, sealed               windows.Handle
+	controlServer, controlClient windows.Handle
+	controlConnect               *upgradeSDKControlOperation
+	object                       UpgradeObject
+	inherited                    []windows.Handle
+	wire                         upgradeSDKGrantWire
+	journalDigest                [32]byte
+	unknown, issued              bool
+	launchAttempted              bool
+	child                        *nativeUpgradeSDKChild
+	birth                        *upgradeSDKBirthAdmission
+}
+
+func (g *nativeUpgradeSDKGrant) String() string   { return "held native SDK launch grant" }
+func (g *nativeUpgradeSDKGrant) GoString() string { return "held native SDK launch grant" }
+
+func prepareUpgradeSDKGrant(ctx context.Context, authority *upgradeAuthorityOwner, legacy *nativeUpgradeLegacySDKOwner, image *nativeUpgradeSDKImage) (out *nativeUpgradeSDKGrant, result error) {
+	if ctx == nil || ctx.Err() != nil || authority == nil || legacy == nil || image == nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	authority.mu.Lock()
+	if authority.unknown || !authority.imported || authority.released || authority.cold == nil || authority.cold.retirement == nil || authority.recorder == nil || authority.sdk == nil || authority.sdk.birth == nil || authority.sdk.birth.check(ctx) != nil {
+		authority.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	retirement, recorder := authority.cold.retirement, authority.recorder
+	birth := authority.sdk.birth
+	authority.mu.Unlock()
+	if image.root != retirement.root || image.recheck(ctx) != nil || retirement.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j, journalDigest := recorder.last.Journal, recorder.digest
+	store, native := recorder.sink.(*nativeUpgradeStore)
+	valid := native && !recorder.uncertain && j.valid() && j.Stage == "data-imported" && j.SDKDigest == [32]byte{} && j.Recovery.Schema == 0 && upgradeIntentEqual(j, retirement.journal)
+	recorder.mu.Unlock()
+	if !valid {
+		return nil, ErrUpgrade
+	}
+	if _, err := legacy.recheckUpgradeLegacySDK(ctx, j); err != nil {
+		return nil, ErrUpgrade
+	}
+	legacy.mu.Lock()
+	peer := legacy.peer
+	same := !legacy.closed && !legacy.unknown && peer != nil && peer.root == retirement.root && peer.recorder == recorder
+	legacy.mu.Unlock()
+	if !same {
+		return nil, ErrUpgrade
+	}
+	g := &nativeUpgradeSDKGrant{authority: authority, legacy: legacy, image: image, journalDigest: journalDigest, unknown: true, birth: birth}
+	out = g // All consequential partial admission is retained from here onward.
+	var err error
+	g.final, err = authority.newSDKFinalSlot(ctx)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	g.denial, err = retirement.denyLegacySDK(ctx, recorder, peer)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	denial, err := g.denial.transfer(ctx)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	final, err := g.final.transfer()
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != store.sid {
+		return g, ErrUpgrade
+	}
+	peer.mu.Lock()
+	defer peer.mu.Unlock()
+	if peer.check(false) != nil || !peer.processRetired || !peer.controllerAdopted || peer.helpers == nil || peer.helpers.verifyLegacySDKRetired(ctx, peer) != nil || peer.ingress == nil {
+		return g, ErrUpgrade
+	}
+	var inherited [3]windows.Handle
+	for n, original := range []windows.Handle{peer.process, windows.Handle(peer.token), peer.image.leaf()} {
+		if windows.DuplicateHandle(windows.CurrentProcess(), original, windows.CurrentProcess(), &inherited[n], 0, true, windows.DUPLICATE_SAME_ACCESS) != nil {
+			return g, ErrUpgrade
+		}
+		g.inherited = append(g.inherited, inherited[n])
+	}
+	parent, err := currentUpgradeGeneration(j.Incoming)
+	if err != nil || parent != g.final.parent || parent.Session != peer.expected.Session {
+		return g, ErrUpgrade
+	}
+	if g.prepareControl(ctx, store.sid) != nil {
+		return g, ErrUpgrade
+	}
+	g.wire = upgradeSDKGrantWire{2, upgradeSDKGrantScope{j.Transaction, j.Daemon, j.Daemon, store.sid, j.RetirementDigest, image.pins.files[0]}, upgradeSDKProcessWire(parent), denial.LegacyRoot, denial.Controller, []upgradeSDKGrantInherited{{upgradeSDKProcessWire(peer.expected), uint64(inherited[0]), uint64(inherited[1]), uint64(inherited[2])}}, final, denial.Denial, uint64(g.controlServer)}
+	// Installation is the native observed old services argument, validated as
+	// the daemon GUID in both old slots. Never the management WSL registration.
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.closed || store.uncertain || store.parents == nil || verifyPrivate(store.parents.leaf(), sid, true) != nil {
+		return g, ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	name := "services.retirement-" + j.Transaction + ".grant"
+	g.writer, err = openSDKFinalFile(store.parents.leaf(), name, sd, true)
+	if err != nil || verifyPrivate(g.writer, sid, false) != nil {
+		return g, ErrUpgrade
+	}
+	g.object, err = upgradeObjectID(g.writer)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	// Reserve the actual reader value for alias validation. It is a NEW read
+	// FILE_OBJECT; writer close and deny-write reopen must finish before issuance.
+	var reader windows.Handle
+	reader, err = openSDKFinalFile(store.parents.leaf(), name, nil, false)
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	g.inherited = append(g.inherited, reader)
+	body, err := upgradeSDKGrantBytes(g.wire, uint64(reader))
+	if err != nil {
+		return g, ErrUpgrade
+	}
+	for left := body; len(left) > 0; {
+		if ctx.Err() != nil {
+			return g, ErrUpgrade
+		}
+		n, err := nativeWrite(g.writer, left)
+		if err != nil || n <= 0 || n > len(left) {
+			return g, ErrUpgrade
+		}
+		left = left[n:]
+	}
+	if windows.FlushFileBuffers(g.writer) != nil || verifyUpgradeWritten(ctx, g.writer, body) != nil || windows.CloseHandle(g.writer) != nil {
+		return g, ErrUpgrade
+	}
+	g.writer = 0
+	g.sealed, err = openRelative(store.parents.leaf(), name, false, nil, false)
+	if err != nil || verifyPrivate(g.sealed, sid, false) != nil {
+		return g, ErrUpgrade
+	}
+	id, err := upgradeObjectID(g.sealed)
+	if err != nil || id != g.object || verifyUpgradeWritten(ctx, g.sealed, body) != nil || windows.SetHandleInformation(reader, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return g, ErrUpgrade
+	}
+	g.issued, g.unknown = true, false
+	return g, nil
+}
+
+// This strict admission is for the sole future SDK child launch. The denial's
+// separate post-transfer checker permits later activation progress; that must
+// not allow an initial cold launch against a changed recorder/scope. It never
+// returns a handle allowlist or releases the original ingress reservation.
+func (g *nativeUpgradeSDKGrant) recheckBeforeLaunch(ctx context.Context) error {
+	if g == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if g.unknown || !g.issued || g.authority == nil || g.legacy == nil || g.image == nil || g.denial == nil || g.final == nil || g.sealed == 0 || g.writer != 0 || len(g.inherited) != 4 || g.image.recheck(ctx) != nil || g.denial.recheckTransferred(ctx) != nil {
+		return ErrUpgrade
+	}
+	sid, ownerErr := currentOwner()
+	if ownerErr != nil || sid != g.denial.store.sid {
+		return ErrUpgrade
+	}
+	r := g.authority.recorder
+	if r == nil {
+		return ErrUpgrade
+	}
+	r.mu.Lock()
+	j := r.last.Journal
+	unchanged := !r.uncertain && r.digest == g.journalDigest && r.sink == g.denial.store && j.Stage == "data-imported" && j.SDKDigest == [32]byte{} && j.Recovery.Schema == 0
+	r.mu.Unlock()
+	if !unchanged {
+		return ErrUpgrade
+	}
+	if _, err := g.legacy.recheckUpgradeLegacySDK(ctx, j); err != nil {
+		return ErrUpgrade
+	}
+	parent, err := currentUpgradeGeneration(j.Incoming)
+	if err != nil || upgradeSDKProcessWire(parent) != g.wire.Parent {
+		return ErrUpgrade
+	}
+	reader := g.inherited[3]
+	body, err := upgradeSDKGrantBytes(g.wire, uint64(reader))
+	if err != nil || verifyPrivate(g.sealed, g.denial.store.sid, false) != nil || verifyUpgradeWritten(ctx, g.sealed, body) != nil {
+		return ErrUpgrade
+	}
+	for _, h := range []windows.Handle{reader, g.sealed} {
+		id, err := upgradeObjectID(h)
+		if err != nil || id != g.object {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_guest_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_guest_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..55585fc9973680e8770b8add21178a279c172f7f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_guest_windows.go
@@ -0,0 +1,69 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// This closed constructor supports ONLY the exact selected executable's
+// no-trust-asset entry branch. In services-selected-reconstructed.go, argv len7
+// leaves trustAsset/hash empty; the default factory calls NewHost, whose first
+// ValidateHelperAsset fails before any WSL launch. Neither IPC nor the selected
+// runtime can replace that factory/asset. This is not a general guest fence:
+// trust-enabled len9 peers still need an actual guest serialization owner.
+// The observed native command line is correlation only until joined to the
+// actual live class-44-bound compiled 8f process in this constructor.
+type nativeUpgradeLegacySDKNoGuest struct {
+	peer    *nativeUpgradeLegacySDKPeer
+	helpers *nativeUpgradeLegacySDKHelpers
+}
+
+// Caller holds the peer mutex; helper checks are called under helpers.mu, after
+// that same peer mutex. The borrowed native graph remains owned by the peer.
+func captureUpgradeLegacySDKNoGuest(ctx context.Context, peer *nativeUpgradeLegacySDKPeer, helpers *nativeUpgradeLegacySDKHelpers) (*nativeUpgradeLegacySDKNoGuest, error) {
+	g := &nativeUpgradeLegacySDKNoGuest{peer: peer, helpers: helpers}
+	if g.recheckLegacySDKGuestOrigin(ctx, peer) != nil {
+		return nil, ErrUpgrade
+	}
+	return g, nil
+}
+
+func (g *nativeUpgradeLegacySDKNoGuest) recheckLegacySDKGuestOrigin(ctx context.Context, peer *nativeUpgradeLegacySDKPeer) error {
+	if g == nil || ctx == nil || ctx.Err() != nil || peer == nil || g.peer != peer || g.helpers == nil || g.helpers.peer != peer || len(g.helpers.children) != 0 || peer.image == nil || peer.check(true) != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	command, err := legacySDKCommandLine(peer.process)
+	if err != nil || command != peer.command {
+		return ErrUpgrade
+	}
+	args, err := windows.DecomposeCommandLine(command)
+	if err != nil || len(args) != 7 || !validateUpgradeLegacySDKArgs(args, peer.path, peer.root.home, peer.scope.Daemon) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (g *nativeUpgradeLegacySDKNoGuest) verifyLegacySDKGuestRetired(ctx context.Context, peer *nativeUpgradeLegacySDKPeer) error {
+	if g == nil || ctx == nil || ctx.Err() != nil || peer == nil || g.peer != peer || g.helpers == nil || g.helpers.peer != peer || len(g.helpers.children) != 0 || peer.image == nil || !peer.processRetired || peer.check(false) != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	// The actual held generation and captured mapped-image origin survive exit;
+	// class44 itself is a live-only query. No snapshot pending flag is read.
+	state, err := windows.WaitForSingleObject(peer.process, 0)
+	if err != nil || state != uint32(windows.WAIT_OBJECT_0) {
+		return ErrUpgrade
+	}
+	args, err := windows.DecomposeCommandLine(peer.command)
+	if err != nil || len(args) != 7 || !validateUpgradeLegacySDKArgs(args, peer.path, peer.root.home, peer.scope.Daemon) {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_handoff_close.go b/rdd/pkg/managementconfig/upgrade_sdk_handoff_close.go
new file mode 100644
index 0000000000000000000000000000000000000000..182a15137cd62ff3757b5d878f2fd9d6144dc44d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_handoff_close.go
@@ -0,0 +1,66 @@
+package managementconfig
+
+import "sync"
+
+// Actual native callers own slot and witness for the lifetime of the one-use
+// completion participant. Zero BEFORE the syscall; unknown means no replay.
+func closeUpgradeSDKHandoffSlot[T ~uintptr](slot *T, close func(T) error, witness func(T)) error {
+	if slot == nil || close == nil || witness == nil {
+		return ErrUpgrade
+	}
+	if *slot == 0 {
+		return nil
+	}
+	h := *slot
+	*slot = 0
+	completed := false
+	defer func() {
+		if !completed {
+			witness(h)
+		}
+	}()
+	if close(h) != nil {
+		return ErrUpgrade
+	}
+	completed = true
+	return nil
+}
+
+// One actual TEMP handoff completion participant. Its state is not custody:
+// native construction separately binds the actual co/x/recipient graph. Check
+// is deliberately nonblocking while the physical close sequence is running.
+type upgradeSDKHandoffClose struct {
+	mu                   sync.Mutex
+	attempted, completed bool
+	result               error
+}
+
+func (s *upgradeSDKHandoffClose) check() error {
+	if s == nil || !s.mu.TryLock() {
+		return ErrUpgrade
+	}
+	defer s.mu.Unlock()
+	if !s.attempted || !s.completed || s.result != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (s *upgradeSDKHandoffClose) run(perform func() error) error {
+	if s == nil || perform == nil {
+		return ErrUpgrade
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.attempted {
+		return s.result
+	}
+	s.attempted, s.result = true, ErrUpgrade
+	// Panic or any non-normal unwind leaves the initial cached refusal. No nil
+	// named return may publish completion while native ownership is unfinished.
+	if err := perform(); err != nil {
+		return ErrUpgrade
+	}
+	s.completed, s.result = true, nil
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_handoff_close_test.go b/rdd/pkg/managementconfig/upgrade_sdk_handoff_close_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..046391c0d295a8cba6d89078fc33448f431c2b63
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_handoff_close_test.go
@@ -0,0 +1,90 @@
+package managementconfig
+
+import (
+	"testing"
+)
+
+func TestUpgradeSDKHandoffPublishedCustodyNeverCompletesFailedOrPanickedClose(t *testing.T) {
+	for _, mode := range []string{"error", "panic", "success"} {
+		t.Run(mode, func(t *testing.T) {
+			var s upgradeSDKHandoffClose
+			calls := 0
+			if s.check() == nil {
+				t.Fatal("unstarted publication became completion")
+			}
+			func() {
+				defer func() {
+					if p := recover(); p != nil && mode != "panic" {
+						t.Fatal(p)
+					}
+				}()
+				_ = s.run(func() error {
+					calls++
+					if s.check() == nil {
+						t.Fatal("in-flight close admitted posthandoff")
+					}
+					if mode == "panic" {
+						panic("owned close uncertainty")
+					}
+					if mode == "error" {
+						return ErrUpgrade
+					}
+					return nil
+				})
+			}()
+			if (s.check() == nil) != (mode == "success") {
+				t.Fatal("unfinished close became positive")
+			}
+			if got := s.run(func() error { calls++; return nil }); (got == nil) != (mode == "success") || calls != 1 {
+				t.Fatal("unknown native effect replayed", calls, got)
+			}
+		})
+	}
+}
+
+func TestUpgradeSDKHandoffStopsAtFirstUnknownSlotAndCannotFinalizeOrReplay(t *testing.T) {
+	for fail := 0; fail < 4; fail++ {
+		for _, panicClose := range []bool{false, true} {
+			var state upgradeSDKHandoffClose
+			slots := []uintptr{11, 12, 13, 14}
+			var witness []uintptr
+			calls := 0
+			finalized := false
+			func() {
+				defer func() { _ = recover() }()
+				_ = state.run(func() error {
+					for i := range slots {
+						if closeUpgradeSDKHandoffSlot(&slots[i], func(h uintptr) error {
+							if slots[i] != 0 {
+								t.Fatal("native close lacked prior slot consumption")
+							}
+							calls++
+							if i == fail {
+								if panicClose {
+									panic("native-close-unknown")
+								}
+								return ErrUpgrade
+							}
+							return nil
+						}, func(h uintptr) { witness = append(witness, h) }) != nil {
+							return ErrUpgrade
+						}
+					}
+					finalized = true
+					return nil
+				})
+			}()
+			if finalized || state.check() == nil || calls != fail+1 || len(witness) != 1 || witness[0] != uintptr(11+fail) {
+				t.Fatal("unknown close gained completion or lost actual witness", fail, panicClose, calls, witness)
+			}
+			for i := fail + 1; i < len(slots); i++ {
+				if slots[i] != uintptr(11+i) {
+					t.Fatal("later exclusion released after unknown")
+				}
+			}
+			if state.run(func() error { calls++; finalized = true; return nil }) == nil || calls != fail+1 || finalized {
+				t.Fatal("attempted native close replayed")
+			}
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_handoff_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_handoff_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..66abe396767bd29d810a3cd27d4a013c4d21b634
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_handoff_windows.go
@@ -0,0 +1,148 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"time"
+)
+
+// Actual dual acknowledgement: retained candidate-native acceptance plus the
+// original second event set only AFTER SDK's positive controller/supervisor ACK.
+// This capability never comes from JSON or a caller success Boolean.
+type nativeUpgradeSDKHandoff struct {
+	acceptance *nativeUpgradeSDKCandidateAcceptance
+	commit     *upgradeSDKCommit
+	supervisor windows.Handle
+	custody    *nativeUpgradeSDKCohortAdoption
+}
+
+func (h *nativeUpgradeSDKHandoff) checkNative() error {
+	if h == nil || h.custody == nil || h.custody.co == nil || h.custody.x == nil || h.custody.x.prepared == nil || h.custody.x.prepared.child == nil || h.custody.close.check() != nil || !h.custody.verified || h.acceptance == nil || h.acceptance.transfer != h.custody.x || h.custody.co.adoption != h.custody || h.custody.co.birth != h.custody.x.prepared.child {
+		return ErrUpgrade
+	}
+	x := h.custody.x
+	if x.unknown || len(x.unknownCloses) != 0 || len(h.custody.unknownCloses) != 0 || x.prepared.child.unknown || h.custody.co.unknown || x.prepared.child.handoff.Load() != h {
+		return ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	return h.checkRecipientNative(ctx)
+}
+
+// This private native pre-close check has no cached-completion requirement and
+// cannot grant posthandoff admission. Final checkNative always requires it.
+func (h *nativeUpgradeSDKHandoff) checkRecipientNative(ctx context.Context) error {
+	if h == nil || h.acceptance == nil || h.commit == nil || h.supervisor == 0 || h.commit.check() != nil {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(h.supervisor, 0)
+	if err != nil || state != uint32(windows.WAIT_OBJECT_0) || h.acceptance.checkNative(ctx, h.acceptance.transfer.prepared.grant.wire.Scope.SID) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (x *nativeUpgradeSDKCandidateTransfer) finishHandoff(ctx context.Context, commit *upgradeSDKCommit) error {
+	if x == nil || ctx == nil || ctx.Err() != nil || commit == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	if x.acceptance == nil || !x.acceptance.accepted || x.supervisorEvent == 0 || x.prepared.child.handoff.Load() != nil || commit.check() != nil {
+		return ErrUpgrade
+	}
+	until := time.Now().Add(15 * time.Second)
+	for {
+		if ctx.Err() != nil || time.Now().After(until) {
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForMultipleObjects([]windows.Handle{x.supervisorEvent, x.acceptance.process, x.prepared.child.process}, false, 20)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_TIMEOUT) {
+			continue
+		}
+		if state != uint32(windows.WAIT_OBJECT_0) {
+			return ErrUpgrade
+		}
+		break
+	}
+	co := x.prepared.child.cohort
+	if co == nil || co.requireHandoffAdoption(ctx, x) != nil {
+		return ErrUpgrade
+	}
+	h := &nativeUpgradeSDKHandoff{acceptance: x.acceptance, commit: commit, supervisor: x.supervisorEvent, custody: co.adoption}
+	if h.checkRecipientNative(ctx) != nil || x.prepared.child.recheckIngressBirth(ctx) != nil {
+		return ErrUpgrade
+	}
+	c := x.prepared.child
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.unknown || c.control == nil || !c.control.mu.TryLock() {
+		return ErrUpgrade
+	}
+	defer c.control.mu.Unlock()
+	if c.control.unknown || c.control.op != nil || c.control.pipe != x.prepared.grant.controlClient {
+		return ErrUpgrade
+	}
+	co.mu.Lock()
+	defer co.mu.Unlock()
+	if co.adoption != h.custody || h.custody.checkHeld(ctx) != nil {
+		return ErrUpgrade
+	}
+	completed := false
+	defer func() {
+		if !completed {
+			c.unknown = true
+			c.control.unknown = true
+			co.unknown = true
+			x.unknown = true
+		}
+	}()
+	// The original native FILE_OBJECT now has a positively verified long-lived
+	// owner. Publish that actual capability before closing either TEMP job copy.
+	c.handoff.Store(h)
+	result := h.custody.close.run(func() error {
+		if h.custody.closeInitialQueries() != nil {
+			return ErrUpgrade
+		}
+		for n := range x.inherited {
+			if closeUpgradeSDKHandoffSlot(&x.inherited[n], windows.CloseHandle, func(h windows.Handle) { x.unknownCloses = append(x.unknownCloses, h) }) != nil {
+				return ErrUpgrade
+			}
+		}
+		for _, handle := range []*windows.Handle{&x.provisional.returned, &x.reader, &x.sealed, &x.event, &c.job, &x.prepared.grant.controlClient, &x.prepared.grant.controlServer} {
+			if closeUpgradeSDKHandoffSlot(handle, windows.CloseHandle, func(h windows.Handle) { x.unknownCloses = append(x.unknownCloses, h) }) != nil {
+				return ErrUpgrade
+			}
+		}
+		c.control.pipe = 0
+		// Correlation flags are released only by this actual one-use handoff owner,
+		// after both native acknowledgements and checked TEMP-copy closure.
+		store := x.prepared.grant.denial.store
+		if h.checkRecipientNative(ctx) != nil || commit.check() != nil {
+			c.unknown = true
+			return ErrUpgrade
+		}
+		store.mu.Lock()
+		defer store.mu.Unlock()
+		if store.closed || store.uncertain || !store.sdkActive || !store.sdkDenialActive {
+			c.unknown = true
+			return ErrUpgrade
+		}
+		store.sdkActive, store.sdkDenialActive = false, false
+		x.unknown = false
+		return nil
+	})
+	if result != nil {
+		return ErrUpgrade
+	}
+	completed = true
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_helpers_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_helpers_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..3a580b0793465dd19866f5dbbb09cfe768a7035e
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_helpers_windows.go
@@ -0,0 +1,352 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strings"
+	"sync"
+	"unsafe"
+)
+
+// Exact supported 8f source closure has no runtime LAN adapters/controller and
+// its exact IPC schema cannot register one. The only native
+// child launcher reachable from that ordinary service is the selected WSL-trust
+// host's direct System32 wsl.exe command. No absence/snapshot flag establishes
+// this catalog. Other images/entrypoints require a separately reviewed route.
+type nativeUpgradeLegacySDKHelpers struct {
+	mu                     sync.Mutex
+	peer                   *nativeUpgradeLegacySDKPeer
+	wsl                    *upgradeWSLImage
+	wslObservation         windows.Handle
+	guest                  upgradeLegacySDKGuestOwner
+	engine                 upgradeLegacySDKEngineOwner
+	children               []*upgradeLegacySDKChild
+	snapshots              []windows.Handle
+	closed, armed, unknown bool
+	closeErr               error
+}
+
+// A Windows proxy's exit does not retire its Linux updater. This trusted native
+// participant must retain actual selected-guest serialization/closure owners;
+// plaintext receipts and old snapshot pending flags cannot implement it. No
+// trust-enabled constructor is supplied yet, so those SDK Stop/retirement
+// routes refuse until the guest boundary has a concrete provider. The exact
+// compiled no-trust-asset entry has a separate native closed constructor.
+type upgradeLegacySDKGuestOwner interface {
+	recheckLegacySDKGuestOrigin(context.Context, *nativeUpgradeLegacySDKPeer) error
+	verifyLegacySDKGuestRetired(context.Context, *nativeUpgradeLegacySDKPeer) error
+}
+
+// Selected old NamespaceManager can lose an unknown ContainerCreate from its
+// active map; selected runtime can also drop a cleanup error before exit zero.
+// Therefore actual anchored engine-helper ownership/late-admission retirement
+// is mandatory separately from the WSL Host branch. No production issuer yet.
+type upgradeLegacySDKEngineOwner interface {
+	recheckLegacySDKEngineOrigin(context.Context, *nativeUpgradeLegacySDKPeer) error
+	verifyLegacySDKEngineRetired(context.Context, *nativeUpgradeLegacySDKPeer) error
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) bindEngineOwner(ctx context.Context, peer *nativeUpgradeLegacySDKPeer, engine upgradeLegacySDKEngineOwner) error {
+	if h == nil || ctx == nil || ctx.Err() != nil || engine == nil {
+		return ErrUpgrade
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed || h.unknown || h.armed || h.engine != nil || h.peer != peer || engine.recheckLegacySDKEngineOrigin(ctx, peer) != nil {
+		return ErrUpgrade
+	}
+	h.engine = engine
+	return nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) bindGuestOwner(ctx context.Context, peer *nativeUpgradeLegacySDKPeer, guest upgradeLegacySDKGuestOwner) error {
+	if h == nil || ctx == nil || ctx.Err() != nil || guest == nil {
+		return ErrUpgrade
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed || h.unknown || h.armed || h.guest != nil || h.peer != peer || guest.recheckLegacySDKGuestOrigin(ctx, peer) != nil {
+		return ErrUpgrade
+	}
+	h.guest = guest
+	return nil
+}
+
+type upgradeLegacySDKChild struct {
+	process  windows.Handle
+	token    windows.Token
+	tokenID  windows.LUID
+	expected UpgradeProcess
+	binding  upgradeObservedImageBinding
+}
+
+func captureUpgradeLegacySDKHelpers(ctx context.Context, peer *nativeUpgradeLegacySDKPeer) (out *nativeUpgradeLegacySDKHelpers, result error) {
+	if ctx == nil || peer == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	peer.mu.Lock()
+	defer peer.mu.Unlock()
+	if peer.check(true) != nil || peer.stopDispatched {
+		return nil, ErrUpgrade
+	}
+	h := &nativeUpgradeLegacySDKHelpers{peer: peer}
+	ok := false
+	defer func() {
+		if !ok {
+			if h.Close() != nil {
+				out = h
+			}
+			result = ErrUpgrade
+		}
+	}()
+	var err error
+	h.wsl, err = holdUpgradeWSLImage(ctx)
+	if err != nil || h.wsl == nil {
+		return nil, ErrUpgrade
+	}
+	chain := h.wsl.chain.chain
+	if len(chain) < 2 {
+		return nil, ErrUpgrade
+	}
+	h.wslObservation, err = openUpgradeObservedImageFile(chain[len(chain)-2], "wsl.exe")
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	id, err := upgradeObjectID(h.wslObservation)
+	if err != nil || id != h.wsl.object || systemCodeKind(h.wslObservation) != nil || checkObjectDACL(h.wslObservation, "", false) != nil {
+		return nil, ErrUpgrade
+	}
+	if h.scan(ctx, false) != nil || peer.check(true) != nil {
+		return nil, ErrUpgrade
+	}
+	args, err := windows.DecomposeCommandLine(peer.command)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	if len(args) == 7 {
+		guest, err := captureUpgradeLegacySDKNoGuest(ctx, peer, h)
+		if err != nil || h.bindGuestOwner(ctx, peer, guest) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	ok = true
+	return h, nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) recheckLegacySDKOwned(ctx context.Context, peer *nativeUpgradeLegacySDKPeer) error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed || h.unknown || peer != h.peer || h.wsl == nil || h.guest == nil || h.engine == nil || h.engine.recheckLegacySDKEngineOrigin(ctx, peer) != nil || h.scan(ctx, false) != nil || h.guest.recheckLegacySDKGuestOrigin(ctx, peer) != nil {
+		return ErrUpgrade
+	}
+	h.armed = true // Actual captured handles cannot be released after dispatch admission.
+	return nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) verifyLegacySDKRetired(ctx context.Context, peer *nativeUpgradeLegacySDKPeer) error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed || h.unknown || !h.armed || peer != h.peer || h.wsl == nil || h.guest == nil || h.engine == nil {
+		return ErrUpgrade
+	}
+	// Parent exit is the native birth cutoff. Scan AFTER that positive wait so a
+	// WSL child issued during the old service's final request cannot be omitted.
+	state, err := windows.WaitForSingleObject(peer.process, 0)
+	if err != nil || state != uint32(windows.WAIT_OBJECT_0) || h.scan(ctx, true) != nil {
+		h.unknown = true
+		return ErrUpgrade
+	}
+	for _, child := range h.children {
+		if h.checkChild(child) != nil {
+			h.unknown = true
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForSingleObject(child.process, 0)
+		if err != nil || state != uint32(windows.WAIT_OBJECT_0) {
+			return ErrUpgrade
+		}
+	}
+	if h.guest.verifyLegacySDKGuestRetired(ctx, peer) != nil {
+		return ErrUpgrade
+	}
+	if h.engine.verifyLegacySDKEngineRetired(ctx, peer) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Callers hold the peer's owner mutex before this helper mutex. No method below
+// calls a peer locking method or waits/kills an ambient PID. Toolhelp selects
+// candidates only; each is bound to a held native process, native parent/time
+// interval, ordinary token and actual mapped System32 image before acceptance.
+func (h *nativeUpgradeLegacySDKHelpers) scan(ctx context.Context, retired bool) (result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, ownerErr := currentOwner()
+	if ownerErr != nil || sid != h.peer.root.sid {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	if windows.GetProcessTimes(h.peer.process, &created, &exited, &kernel, &user) != nil {
+		return ErrUpgrade
+	}
+	start := uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+	end := uint64(exited.HighDateTime)<<32 | uint64(exited.LowDateTime)
+	if start != h.peer.expected.Creation || retired && end < start {
+		return ErrUpgrade
+	}
+	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
+	if err != nil {
+		return ErrUpgrade
+	}
+	index := len(h.snapshots)
+	h.snapshots = append(h.snapshots, snapshot)
+	// Retain a failed snapshot Close and propagate unknown; never lose its
+	// original numeric handle or turn an uncertain inventory into success.
+	defer func() {
+		if windows.CloseHandle(snapshot) != nil {
+			h.unknown = true
+			result = ErrUpgrade
+		} else {
+			h.snapshots[index] = 0
+		}
+	}()
+	entry := windows.ProcessEntry32{Size: uint32(unsafe.Sizeof(windows.ProcessEntry32{}))}
+	err = windows.Process32First(snapshot, &entry)
+	for err == nil {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		if entry.ParentProcessID == h.peer.expected.PID {
+			known := false
+			for _, child := range h.children {
+				if child.expected.PID == entry.ProcessID {
+					state, e := windows.WaitForSingleObject(child.process, 0)
+					if e != nil {
+						return ErrUpgrade
+					}
+					if state == uint32(windows.WAIT_TIMEOUT) {
+						if h.checkChild(child) != nil {
+							return ErrUpgrade
+						}
+						known = true
+						break
+					}
+				}
+			}
+			if !known {
+				if h.captureChild(ctx, entry.ProcessID, start, end, retired) != nil {
+					return ErrUpgrade
+				}
+			}
+		}
+		err = windows.Process32Next(snapshot, &entry)
+	}
+	if err != windows.ERROR_NO_MORE_FILES {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) captureChild(ctx context.Context, pid uint32, parentStart, parentEnd uint64, retired bool) error {
+	child := &upgradeLegacySDKChild{}
+	var err error
+	child.process, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if err != nil {
+		return ErrUpgrade
+	}
+	h.children = append(h.children, child) // Partial/unknown capture retains the actual object.
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(child.process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || uint32(basic.UniqueProcessId) != pid || uint32(basic.InheritedFromUniqueProcessId) != h.peer.expected.PID {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	if windows.GetProcessTimes(child.process, &created, &exited, &kernel, &user) != nil {
+		return ErrUpgrade
+	}
+	creation := uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+	if !upgradeLegacySDKChildLifetime(creation, parentStart, parentEnd, retired) {
+		return ErrUpgrade
+	}
+	path, err := upgradeProcessPath(child.process)
+	if err != nil || !strings.EqualFold(path, h.wsl.path) {
+		return ErrUpgrade
+	}
+	var session uint32
+	if windows.ProcessIdToSessionId(pid, &session) != nil || session != h.peer.expected.Session || windows.OpenProcessToken(child.process, windows.TOKEN_QUERY, &child.token) != nil || legacySDKOrdinaryToken(child.token, h.peer.root.sid, session) != nil {
+		return ErrUpgrade
+	}
+	child.tokenID, err = legacySDKTokenID(child.token)
+	if err != nil {
+		return ErrUpgrade
+	}
+	child.expected = UpgradeProcess{PID: pid, Creation: creation, Session: session, Image: h.wsl.hash}
+	if child.binding.capture(child.process, h.wslObservation) != nil || h.checkChild(child) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) checkChild(child *upgradeLegacySDKChild) error {
+	if child == nil || !child.expected.valid() || child.token == 0 {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	if windows.GetProcessTimes(child.process, &created, &exited, &kernel, &user) != nil || uint64(created.HighDateTime)<<32|uint64(created.LowDateTime) != child.expected.Creation {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(child.token)
+	if err != nil || id != child.tokenID || legacySDKOrdinaryToken(child.token, h.peer.root.sid, child.expected.Session) != nil || child.binding.same() != nil {
+		return ErrUpgrade
+	}
+	actual, err := upgradeObjectID(h.wsl.chain.leaf())
+	if err != nil || actual != h.wsl.object {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (h *nativeUpgradeLegacySDKHelpers) Close() error {
+	if h == nil {
+		return nil
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.armed || h.unknown {
+		return ErrUpgrade
+	}
+	if h.closed {
+		return h.closeErr
+	}
+	h.closed = true
+	var resources []func() error
+	for _, child := range h.children {
+		if child.token != 0 {
+			resources = append(resources, child.token.Close)
+		}
+		if child.process != 0 {
+			process := child.process
+			resources = append(resources, func() error { return windows.CloseHandle(process) })
+		}
+	}
+	if h.wslObservation != 0 {
+		resources = append(resources, func() error { return windows.CloseHandle(h.wslObservation) })
+	}
+	h.closeErr = closeOwnerLastLegacySDK(resources, func() error {
+		if h.wsl != nil {
+			return h.wsl.Close()
+		}
+		return nil
+	})
+	return h.closeErr
+}
