+// native inspection, ownership, or the supported ACL shape cannot become a
+// deferred traversal-policy decision.
+func runtimeStoragePublicFacts(h windows.Handle, sid string, directory bool) (runtimeStorageRouteFacts, error) {
+	out := runtimeStorageRouteFacts{strict: true, traversalSafe: true}
+	if objectKind(h, directory) != nil {
+		return out, ErrUpgrade
+	}
+	sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if e != nil || sd == nil {
+		return out, ErrUpgrade
+	}
+	owner, _, e := sd.Owner()
+	if e != nil || owner == nil || !owner.IsValid() || runtimeStoragePublicOwner(owner.String(), sid) != nil {
+		return out, ErrUpgrade
+	}
+	acl, _, e := sd.DACL()
+	if e != nil || acl == nil || acl.AceCount > 256 {
+		return out, ErrUpgrade
+	}
+	control, _, e := sd.Control()
+	if e != nil || sd.Length() < 20 || sd.Length() > 65536 || control&windows.SE_SELF_RELATIVE == 0 {
+		return out, ErrUpgrade
+	}
