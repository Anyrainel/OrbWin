+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"testing"
+	"time"
+)
+
+func runtimeOperationFixtureFrame(body string) []byte {
+	b := make([]byte, 4)
+	binary.LittleEndian.PutUint32(b, uint32(len(body)))
+	return append(b, []byte(body)...)
+}
+func TestRuntimeOperationClosedFrames(t *testing.T) {
+	for _, op := range []string{"preflight", "cancel", "release"} {
+		if got, e := readRuntimeOperationFrame(bytes.NewReader(runtimeOperationFixtureFrame(`{"schema":1,"operation":"` + op + `"}`))); e != nil || got != op {
+			t.Fatal("closed valid frame")
+		}
+	}
+	for _, body := range []string{`{"schema":1,"operation":"preflight","home":"C:\\other"}`, `{"schema":1,"operation":"preflight","ready":true}`, `{"schema":1,"operation":"preflight","schema":1}`, `{"operation":"preflight","schema":1}`, `{"schema":2,"operation":"preflight"}`, `{"schema":1,"operation":"setup"}`, `{}`, `null`, "", string(bytes.Repeat([]byte{'x'}, 129))} {
+		if _, e := readRuntimeOperationFrame(bytes.NewReader(runtimeOperationFixtureFrame(body))); e == nil {
+			t.Fatal("unknown or authority input", body)
+		}
+	}
+	for _, body := range [][]byte{{}, {1, 0, 0}, {255, 255, 255, 255}, runtimeOperationFixtureFrame(`{"schema":1,"operation":"preflight"}`)[:9]} {
+		if _, e := readRuntimeOperationFrame(bytes.NewReader(body)); e == nil {
+			t.Fatal("truncation/bound")
+		}
+	}
+}
+func TestRuntimeOperationSelectionUnknownKeepsController(t *testing.T) {
+	var events []string
+	if runtimePreflightReleaseSequence(func() error { events = append(events, "selection-close-unknown"); return ErrRuntimePreflight }, func() error { events = append(events, "controller-release"); return nil }, func() { events = append(events, "retain-whole-graph") }) == nil || len(events) != 2 || events[1] != "retain-whole-graph" {
+		t.Fatal("unknown selection released controller", events)
+	}
+	events = nil
+	if runtimePreflightReleaseSequence(func() error { events = append(events, "selection-closed"); return nil }, func() error { events = append(events, "storage-controller-last"); return nil }, func() { t.Fatal("false unknown") }) != nil || len(events) != 2 || events[0] != "selection-closed" {
+		t.Fatal("release order")
+	}
+}
+
+func TestRuntimeOperationPartialCaptureAndPanicCustody(t *testing.T) {
+	for _, panicAfterController := range []bool{false, true} {
+		var events []string
+		bound := false
+		released := false
+		func() {
+			defer func() {
+				p := recover()
+				if (p != nil) != panicAfterController {
+					t.Fatal("panic custody")
+				}
+			}()
+			e := runtimePreflightCaptureSequence(func() error { bound = true; events = append(events, "actual-storage-bound-before-effects"); return nil }, func() error {
+				if !bound {
+					t.Fatal("effects precede bound graph")
+				}
+				events = append(events, "controller-captured")
+				if panicAfterController {
+					panic("native capture model")
+				}
+				return ErrRuntimePreflight
+			}, func() error {
+				return runtimePreflightReleaseSequence(func() error { events = append(events, "selection-close-unknown"); return ErrRuntimePreflight }, func() error { released = true; return nil }, func() { events = append(events, "retain-selection-and-partial-storage") })
+			}, func() { events = append(events, "retain-selection-and-partial-storage") })
+			if e == nil {
+				t.Fatal("partial capture success")
+			}
+		}()
+		if released || len(events) < 3 || events[0] != "actual-storage-bound-before-effects" || events[1] != "controller-captured" || events[len(events)-1] != "retain-selection-and-partial-storage" {
+			t.Fatal("lost actual partial ownership order", events)
+		}
+		if panicAfterController && len(events) != 3 {
+			t.Fatal("panic attempted ordinary release", events)
+		}
+	}
+}
+
+func TestRuntimeOperationHeldWriteCompletionBarrier(t *testing.T) {
+	var barrier runtimePreflightHeldBarrier
+	entered, finish, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	go func() { done <- barrier.publish(func() error { close(entered); <-finish; return nil }) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("controlled writer did not enter")
+	}
+	if barrier.terminal("release", nil) == nil {
+		t.Fatal("blocked write admitted terminal")
+	}
+	close(finish)
+	select {
+	case e := <-done:
+		if e != nil {
+			t.Fatal(e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("controlled writer did not finish")
+	}
+	// Arrival time is unknowable. A reader scheduled late may parse bytes that
+	// were queued earlier; acceptance requires the observed positive write only.
+	op, e := readRuntimeOperationFrame(bytes.NewReader(runtimeOperationFixtureFrame(`{"schema":1,"operation":"release"}`)))
+	if barrier.terminal(op, e) != nil {
+		t.Fatal("late-reader positive-write boundary")
+	}
+	var failed runtimePreflightHeldBarrier
+	if failed.publish(func() error { return ErrRuntimePreflight }) == nil || failed.terminal("release", nil) == nil {
+		t.Fatal("failed writer published positive barrier")
+	}
+	if failed.publish(func() error { t.Fatal("write replay"); return nil }) == nil {
+		t.Fatal("write replay admitted")
+	}
+}
+
+func TestRuntimeOperationFastResponseQueuedBeforeWriterDone(t *testing.T) {
+	var barrier runtimePreflightHeldBarrier
+	queued := make(chan runtimePreflightFrame, 1)
+	// A real client can observe bytes/respond before the owner is scheduled to
+	// consume writer.done. Reader parsing must not turn that timing into refusal.
+	if barrier.publish(func() error {
+		frame := readRuntimeOperationTerminal(bytes.NewReader(runtimeOperationFixtureFrame(`{"schema":1,"operation":"release"}`)), func() { t.Fatal("valid queued release cancelled") })
+		if frame.err != nil {
+			t.Fatal("fast response falsely refused")
+		}
+		queued <- frame
+		if barrier.terminal(frame.operation, frame.err) == nil {
+			t.Fatal("owner allowed release before positive write")
+		}
+		return nil
+	}) != nil {
+		t.Fatal("positive held writer")
+	}
+	frame := <-queued
+	if barrier.terminal(frame.operation, frame.err) != nil {
+		t.Fatal("owner refused queued fast response after write completion")
+	}
+	for _, data := range [][]byte{runtimeOperationFixtureFrame(`{"schema":1,"operation":"cancel"}`), append(runtimeOperationFixtureFrame(`{"schema":1,"operation":"release"}`), 'x'), runtimeOperationFixtureFrame(`{"schema":1,"operation":"preflight"}`)} {
+		cancelled := false
+		frame := readRuntimeOperationTerminal(bytes.NewReader(data), func() { cancelled = true })
+		if !cancelled {
+			t.Fatal("cancel or malformed terminal ignored")
+		}
+		if frame.operation != "cancel" && frame.err == nil {
+			t.Fatal("malformed terminal success")
+		}
+	}
+}
+func TestRuntimeOperationActualSequenceFaults(t *testing.T) {
+	for fail := runtimePreflightCapture; fail <= runtimePreflightRelease; fail++ {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		var steps []runtimePreflightStep
+		injected := errors.New("injected data error")
+		err := runtimePreflightSequence(ctx, func(s runtimePreflightStep) error {
+			steps = append(steps, s)
+			if s == fail {
+				return injected
+			}
+			return nil
+		})
+		cancel()
+		if err == nil {
+			t.Fatal("fault success")
+		}
+		if fail == runtimePreflightCapture {
+			if len(steps) != 1 {
+				t.Fatal("capture owns partial")
+			}
+		} else if steps[len(steps)-1] != runtimePreflightRelease {
+			t.Fatal("must checked-release")
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	var steps []runtimePreflightStep
+	err := runtimePreflightSequence(ctx, func(s runtimePreflightStep) error {
+		steps = append(steps, s)
+		if s == runtimePreflightObserveHeld {
+			cancel()
+		}
+		return nil
+	})
+	if err == nil || len(steps) != 4 || steps[3] != runtimePreflightRelease {
+		t.Fatal("cancel did not settle")
+	}
+	calls := 0
+	if runtimePreflightSequence(context.Background(), func(runtimePreflightStep) error { calls++; return nil }) == nil || calls != 0 {
+		t.Fatal("unbounded grant")
+	}
+	panicCtx, done := context.WithTimeout(context.Background(), time.Second)
+	defer done()
+	released := false
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("panic must reach native graph custodian")
+			}
+		}()
+		runtimePreflightSequence(panicCtx, func(s runtimePreflightStep) error {
+			if s == runtimePreflightVerify {
+				panic("retain actual graph")
+			}
+			if s == runtimePreflightRelease {
+				released = true
+			}
+			return nil
+		})
+	}()
+	if released {
+		t.Fatal("panic released native graph before outer quarantine")
+	}
+	// These callbacks never construct native storage and cannot reach the public
+	// native entrypoint's static preflight-completed event or a publisher.
+}
