@@ -0,0 +1,126 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+func runtimeAdmissionFixture() runtimePublicationAdmission {
+	return runtimePublicationAdmission{
+		Schema: 1, Transaction: strings.Repeat("a", 32), Candidate: UpgradeProcess{7, ^uint64(0), 1, [32]byte{8}},
+		Validation: [32]byte{9}, PrivateRoot: UpgradeObject{2, 0, 1}, Parent: UpgradeObject{3, 0, 1},
+		Controller:       UpgradeObject{3, 0, 2},
+		ParentDescriptor: [32]byte{10}, ControllerDescriptor: [32]byte{11},
+		Previous: runtimePublicationFileWitness{UpgradeObject{3, 0, 3}, 123, ^uint64(0), [32]byte{4}, [32]byte{5}},
+		Stage:    runtimePublicationFileWitness{UpgradeObject{3, 0, 4}, 234, ^uint64(0) - 1, [32]byte{6}, [32]byte{7}},
+	}
+}
+
+func TestRuntimePublicationJournalRequiresAndPreservesExactAdmission(t *testing.T) {
+	r, sink := upgradeImportedFixture(t)
+	candidate := &fakeUpgradeCandidate{validation: upgradeValidationFixture(r.last.Journal)}
+	a, err := newUpgradeActivation(r, &fakeUpgradeHandoff{}, &fakeUpgradeLauncher{candidate: candidate}, &fakeUpgradeRuntime{recorder: r}, &fakeUpgradeSDK{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if a.activate(ctx) != nil {
+		t.Fatal("model activation failed")
+	}
+	var admitted, validated upgradeJournal
+	for _, body := range sink.records {
+		record, err := parseUpgradeRecord(body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if record.Journal.Stage == "candidate-validated" {
+			validated = record.Journal
+		}
+		if record.Journal.Stage == "runtime-publication-admitted" {
+			admitted = record.Journal
+		}
+	}
+	if !validated.valid() || !admitted.valid() || !admitted.RuntimeAdmission.matches(admitted) {
+		t.Fatal("durable admission missing")
+	}
+	if _, err := advanceUpgrade(validated, "runtime-publication-admitted"); err == nil {
+		t.Fatal("receipt-free publication admitted")
+	}
+	early := validated
+	early.RuntimeAdmission = admitted.RuntimeAdmission
+	if early.valid() {
+		t.Fatal("early receipt smuggled into a prior stage")
+	}
+	for name, mutate := range map[string]func(*upgradeJournal){
+		"erased":             func(j *upgradeJournal) { j.RuntimeAdmission = runtimePublicationAdmission{} },
+		"changed-body":       func(j *upgradeJournal) { j.RuntimeAdmission.Stage.Body[0]++ },
+		"changed-controller": func(j *upgradeJournal) { j.RuntimeAdmission.Controller.Low++ },
+		"changed-generation": func(j *upgradeJournal) { j.RuntimeAdmission.Candidate.Creation++ },
+		"wrong-runtime":      func(j *upgradeJournal) { j.RuntimeDigest[0]++ },
+	} {
+		t.Run(name, func(t *testing.T) {
+			changed := r.last.Journal
+			mutate(&changed)
+			if changed.valid() && upgradeRecordFollows(admitted, changed) {
+				t.Fatal("committed successor replaced its admitted storage identity")
+			}
+		})
+	}
+}
+
+func TestRuntimePublicationAdmissionClosedExactAndNoAuthority(t *testing.T) {
+	a := runtimeAdmissionFixture()
+	body, err := runtimePublicationAdmissionBytes(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := parseRuntimePublicationAdmission(body)
+	if err != nil || parsed != a || !bytes.Contains(body, []byte("18446744073709551615")) {
+		t.Fatal("exact native integer witness did not survive canonical data codec")
+	}
+	for _, bad := range [][]byte{
+		append(bytes.Clone(body), '\n'),
+		bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"schema":1`), 1),
+		bytes.Replace(body, []byte(`"schema":1`), []byte(`"Schema":1`), 1),
+		bytes.Replace(body, []byte(`"schema":1`), []byte(`"schema":1,"ready":true`), 1),
+		bytes.Replace(body, []byte(`18446744073709551615`), []byte(`18446744073709551616`), 1),
+	} {
+		if _, err := parseRuntimePublicationAdmission(bad); err == nil {
+			t.Fatal("noncanonical or lossy data accepted")
+		}
+	}
+	old, _ := a.digest()
+	a.Previous = runtimePublicationFileWitness{}
+	absent, err := a.digest()
+	if err != nil || old == absent {
+		t.Fatal("actual captured absence not distinct from predecessor")
+	}
+}
+
+func TestRuntimePublicationAdmissionRejectsAliasAndIncompleteBindings(t *testing.T) {
+	for name, mutate := range map[string]func(*runtimePublicationAdmission){
+		"partial-absence":           func(a *runtimePublicationAdmission) { a.Previous.Object = UpgradeObject{} },
+		"stage-is-previous":         func(a *runtimePublicationAdmission) { a.Stage.Object = a.Previous.Object },
+		"stage-is-controller":       func(a *runtimePublicationAdmission) { a.Stage.Object = a.Controller },
+		"stage-is-parent":           func(a *runtimePublicationAdmission) { a.Stage.Object = a.Parent },
+		"foreign-stage-volume":      func(a *runtimePublicationAdmission) { a.Stage.Object.Volume++ },
+		"foreign-controller-volume": func(a *runtimePublicationAdmission) { a.Controller.Volume++ },
+		"missing-stage-body":        func(a *runtimePublicationAdmission) { a.Stage.Body = [32]byte{} },
+		"missing-descriptor":        func(a *runtimePublicationAdmission) { a.Previous.Descriptor = [32]byte{} },
+		"missing-validation":        func(a *runtimePublicationAdmission) { a.Validation = [32]byte{} },
+		"missing-candidate":         func(a *runtimePublicationAdmission) { a.Candidate = UpgradeProcess{} },
+		"oversized-stage":           func(a *runtimePublicationAdmission) { a.Stage.Size = runtimeIdentityBudget + 1 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			a := runtimeAdmissionFixture()
+			mutate(&a)
+			if _, err := runtimePublicationAdmissionBytes(a); err == nil {
+				t.Fatal("incomplete or aliased publication binding admitted")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_admission_windows.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_admission_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..d09856f2013b292ec1a78defd438595156305561
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_admission_windows.go
@@ -0,0 +1,80 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"runtime"
+)
+
+func runtimeStorageObjectData(o *runtimeStorageObject) UpgradeObject {
+	return UpgradeObject{o.identity.volume, o.identity.high, o.identity.low}
+}
+
+func runtimeStorageFileData(o *runtimeStorageObject, body []byte) runtimePublicationFileWitness {
+	return runtimePublicationFileWitness{
+		Object: runtimeStorageObjectData(o), Size: o.identity.size,
+		Written:    uint64(o.identity.written.HighDateTime)<<32 | uint64(o.identity.written.LowDateTime),
+		Descriptor: o.identity.descriptor, Body: sha256.Sum256(body),
+	}
+}
+
+// Capture metadata exclusively from actual owner-held resources. This method
+// does NOT append a journal, consume commitStorage, or issue a rename grant.
+// The concrete publisher still must durably bind this exact record and hold
+// the same candidate/storage owners through revalidation and native effects.
+func (p *nativeRuntimePrepared) captureAdmission(ctx context.Context, w *nativeUpgradeObservedCandidate, j upgradeJournal, v upgradeValidation) (runtimePublicationAdmission, error) {
+	if p == nil || p.owner == nil || w == nil || w.check(ctx, p.owner.root, j, v) != nil {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	return p.captureAdmissionStorage(ctx, w, j, v)
+}
+
+// DATA capture only; the concrete publisher separately holds/rechecks the
+// actual candidate mutex and witness across this call and subsequent effects.
+func (p *nativeRuntimePrepared) captureAdmissionStorage(ctx context.Context, w *nativeUpgradeObservedCandidate, j upgradeJournal, v upgradeValidation) (runtimePublicationAdmission, error) {
+	if p == nil || p.owner == nil || w == nil || w.root != p.owner.root || ctx == nil || ctx.Err() != nil {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	n := p.owner
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	defer func() {
+		if value := recover(); value != nil {
+			n.fence()
+			panic(value)
+		}
+	}()
+	if p.consumed || !n.prepared || n.stage == nil || n.parent == nil || n.controller == nil || n.checkPrevious() != nil || n.checkObject(n.stage) != nil {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	body, err := n.read(n.stage, false)
+	if err != nil || !bytes.Equal(body, n.stageBody) {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	record, err := parseRuntimeIdentity(body, n.home)
+	if err != nil || !record.matchesUpgradeData(j, v) {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	digest, err := v.digest(j)
+	if err != nil || digest != w.digest {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	a := runtimePublicationAdmission{
+		Schema: 1, Transaction: j.Transaction, Candidate: v.Candidate, Validation: digest,
+		PrivateRoot: j.PrivateRoot, Parent: runtimeStorageObjectData(n.parent),
+		Controller: runtimeStorageObjectData(n.controller), Stage: runtimeStorageFileData(n.stage, body),
+		ParentDescriptor: n.parent.identity.descriptor, ControllerDescriptor: n.controller.identity.descriptor,
+	}
+	if n.predecessor != nil {
+		a.Previous = runtimeStorageFileData(n.predecessor, n.predecessorBody)
+	}
+	if !a.valid() {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	return a, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_native.md b/rdd/pkg/managementconfig/upgrade_runtime_publication_native.md
new file mode 100644
index 0000000000000000000000000000000000000000..562b098ea4cd034e88f676232300756762fda56c
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_native.md
@@ -0,0 +1,33 @@
+# Native runtime compatibility storage
+
+Source/build implementation, 2026-10-26. No native provider execution or installed setup/upgrade qualification has occurred for this component.
+
+`captureNativeRuntimeStorage(ctx, root)` accepts the actual `InstanceRoot` only. It derives the profile and LocalAppData from a retained actual primary token and rejects impersonation/restriction. Private ancestry keeps its previous strict policy, including the exact private leaf descriptor. Public routing uses a distinct complete held native graph described below; it cannot grant private-state, source-file or executable trust.
+
+The fixed `setup.lock` is opened read/write/share-zero using FILE_OPEN_IF. This is the existing setup writer role, never a second owner lock. Existing safe inherited public-read descriptors are accepted without repair; foreign mutation rights at the actual destination, reparse objects, nonlocal objects and multiply linked files refuse. The lock body must be empty. Every native open's returned output is observed before error classification, including token opens, traversal and absence probes. An error with a nonzero, non-invalid HANDLE first retains that actual partial output and then fences the remaining graph; it cannot become an absence result. Successful calls missing a valid output also fence. Known errors with no output preserve their precise status.
+
+Capture retains the exact predecessor native identity, descriptor and at most 16 KiB of closed six-field compatibility data before interruption. A missing predecessor is an internal result of actual relative name-not-found under the same owner. Neither a DTO nor a path/hash/absence flag can construct this capture. Fixed `runtime.publication.stage` collision refuses; this module cannot adopt or recover an orphan stage.
+
+`prepareStorage` validates the exact new compatibility record, creates the private stage in the SAME held destination parent, writes bounded bytes, flushes, reads back, explicitly closes the writable handle, then admits an immutable READ_DATA/DELETE handle and verifies identity/descriptor/body. Last-write time can finalize at writable close; the transition preserves native object/descriptor/size/body and captures the resulting immutable timestamp. The actual preparation coordinator stops at every failed step. Cancellation is checked before effects; bounded synchronous preparation thereafter settles or retains resources.
+
+`nativeRuntimePrepared.commitStorage` is one-use storage publication. It rechecks token/ancestry/controller/predecessor/stage, checked-closes its old read-only predecessor, arms uncertainty before relative same-parent rename, then closes the stage, reopens the immutable target and verifies exact identity/descriptor/body plus absence of the old stage name. Any error after arming, or any panic/actual close uncertainty, strongly retains the actual remaining graph in a process-wide quarantine. No retry, rollback or cleanup follows. Positive release stops on its first close failure and closes the controller last. Close attempts are cached individually, including failures and panics. Actual file I/O uses owned handles directly, without the hidden duplicate-close behavior of `authorityRead`; graph release does not use `ParentLease.Close`.
+
+The receipt retains the real target and owner and rechecks them; it is STORAGE evidence only. This module does not implement `upgradeRuntimePublisher` or `upgradeNativeCandidatePublication`, and cannot grant engine/SDK/process authority from the six-field record. The future root-owned binder must supply the actual candidate/observation and durable admission before calling commit. Cooperative setup.lock exclusion is not a kernel destination-ID compare-and-swap against uncooperative writers.
+
+Current Rust setup still holds its existing direct setup.lock for the whole setup. It correctly conflicts with this constructor. Product integration must move that acquisition into this sole owner and retain its real lifetime; opening a by-name equivalent or passing a Boolean lease is insufficient. There is no generic received-handle constructor, cold recovery issuer or installed publisher integration in this change.
+
+The actual preparation, publication and release methods call the tested sequencing helpers. Pure fault tests cover every preparation/publication failure boundary, one-use replay refusal, positive order, panic retention, cached close success/failure/panic, and controller-last stop-first release. Windows pure policy tests cover foreign mutation masks and the writable-close identity transition. These model/source tests establish ordering, not observed Windows rename/close faults, sharing behavior, supported ACL compatibility, crash recovery, or full setup/upgrade acceptance.
+
+## Held public routing graph, source-only revision
+
+The fixed existing `LocalAppData/OrbWinData` route has its own opaque `nativeRuntimePublicRoute`. A node retains an actual directory handle opened with TRAVERSE, deny-share-DELETE, OPEN_REPARSE_POINT and (for each relative component) OBJ_DONT_REPARSE. Nodes are pending routing observations, never ordinary storage objects. Owner, supported bounded ACL shape, valid SIDs and native identity must be successfully inspected. An inspection error cannot become a deferred policy decision. Each selected parent/name/child edge is independently reopened from the actual retained parent; the verification output enters the actual resource graph before inspection, must match the selected child's native ID/attributes/exact descriptor, and is checked-closed. Partial native outputs are retained before fencing; failed closes are cached and retain the complete graph. Panic also fences the real graph.
+
+The final existing publication boundary always passes the unchanged strict public policy: no effective untrusted mutation rights. If every intermediate also passes the old traversal policy (which tolerates only unrelated ADD_FILE/ADD_SUBDIRECTORY), the old safe route remains valid. If any successfully inspected intermediate carries additional mutation rights, the final boundary additionally must have actual SE_DACL_PROTECTED. No capability SID is trusted specially. The route rechecks each exact descriptor, classification, edge and final protection predicate before controller creation and during later storage checks. Only the completed route supplies the normal strict publication-parent object. Missing boundaries refuse. There is no fresh-child creation operation or fixture convenience switch in this module; creating a new protected boundary under a held prefix requires separate review and cannot fabricate this existing-boundary result.
+
+Each successful public-policy classification carries the SHA-256 of the SAME returned native descriptor buffer parsed for its owner, ACL and protection facts. Initial node capture, retained checks, edge verification and ordinary strict public-object admission require that digest to equal the separately measured identity descriptor. Facts from descriptor A cannot admit an identity measured from descriptor B. This checks split observations explicitly; it does not claim the kernel offers an atomic directory/ACL transaction.
+
+The route addresses active-lifetime compatibility-DATA reachability, not ancestor ACL immutability or persistent pathname identity after release. Deny-delete sharing pins selected directory objects against ordinary rename/delete, and each captured intermediate remains nonempty because its selected child is held. Relative single-component no-reparse opens guard selection before the complete graph exists. A protected strict boundary blocks inherited ACE propagation into the writable publication boundary. Foreign WRITE_DAC/WRITE_OWNER/DELETE_CHILD at that actual boundary still refuses: cooperative setup.lock is not a kernel target-ID CAS. Descendant stage/controller/runtime policies are unchanged, and unsafe inherited existing boundaries remain unsupported.
+
+Primary rules: [CreateFile sharing](https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilea), [RootDirectory and OBJ_DONT_REPARSE](https://learn.microsoft.com/en-us/windows/win32/api/ntdef/ns-ntdef-_object_attributes), [nonempty-directory reparse refusal](https://learn.microsoft.com/en-us/windows-hardware/drivers/ifs/fsctl-set-reparse-point), and [protected DACL inheritance](https://learn.microsoft.com/en-us/windows/win32/secauthz/automatic-propagation-of-inheritable-aces). The pinned Go single-component relative-open implementation also corroborates the no-follow construction; it is not used as an alternative native owner with hidden closes.
+
+Pure tests exercise the actual route/admission coordinators: safe versus conditional protected boundaries, writable-boundary refusal, inspection faults at every node (including owner/unsupported-shape refusal), edge faults before controller admission, partial-output retention, cached unknown close and exact inspection/edge/controller order. These are model observations, not actual native faults or a Windows race proof. Root's preserved primitive candidate-2 run stopped both producer probes before namespace creation at an ancestor SD/identity gate. Ordinary known-ancestor metadata predicts refusal at AppData/Local under the previous strict policy; the saved native result did not identify the exact failing component. This revision has no native execution or regenerated fixture qualification yet.
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model.go
new file mode 100644
index 0000000000000000000000000000000000000000..7b0796114d4e7e2ea777af7cb2eda3a5c4bcfabd
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model.go
@@ -0,0 +1,130 @@
+package managementconfig
+
+// Storage sequencing only; none of these states is candidate/upgrade authority.
+type runtimeStorageStep uint8
+
+const (
+	runtimeStorageRecheck runtimeStorageStep = iota
+	runtimeStorageClosePrevious
+	runtimeStorageArmRename
+	runtimeStorageRename
+	runtimeStorageCloseStage
+	runtimeStorageOpenTarget
+	runtimeStorageVerifyTarget
+)
+
+type runtimeStorageAttempt struct{ used, armed, complete bool }
+
+// Native opens may report an error with a partial output. Such an output is
+// never an absence result or an admitted cap: retain it before fencing. A
+// successful call with no valid output is also unknown. Ordinary errors with
+// no output retain their exact status for closed name-not-found classification.
+func runtimeStorageOpenReply(callErr error, hasOutput bool, retain, fence func()) error {
+	if callErr == nil && hasOutput {
+		return nil
+	}
+	if hasOutput {
+		retain()
+	}
+	if hasOutput || callErr == nil {
+		fence()
+		return ErrUpgrade
+	}
+	return callErr
+}
+
+type runtimeStoragePrepareStep uint8
+
+const (
+	runtimeStorageCreateStage runtimeStoragePrepareStep = iota
+	runtimeStorageWriteStage
+	runtimeStorageFlushStage
+	runtimeStorageReadbackStage
+	runtimeStorageCloseWriter
+	runtimeStorageAdmitStage
+	runtimeStorageVerifyStage
+)
+
+func runtimeStoragePrepareSequence(call func(runtimeStoragePrepareStep) error) error {
+	if call == nil {
+		return ErrUpgrade
+	}
+	for _, step := range []runtimeStoragePrepareStep{runtimeStorageCreateStage, runtimeStorageWriteStage, runtimeStorageFlushStage, runtimeStorageReadbackStage, runtimeStorageCloseWriter, runtimeStorageAdmitStage, runtimeStorageVerifyStage} {
+		if e := call(step); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+
+type runtimeStorageCloseAttempt struct {
+	attempted bool
+	closeErr  error
+}
+
+func (a *runtimeStorageCloseAttempt) run(closeOne func() error, fence func()) error {
+	if a == nil || closeOne == nil || fence == nil {
+		return ErrUpgrade
+	}
+	if a.attempted {
+		return a.closeErr
+	}
+	a.attempted = true
+	defer func() {
+		if p := recover(); p != nil {
+			a.closeErr = ErrUpgrade
+			fence()
+			panic(p)
+		}
+	}()
+	a.closeErr = closeOne()
+	if a.closeErr != nil {
+		fence()
+	}
+	return a.closeErr
+}
+
+func runtimeStorageCommitSequence(s *runtimeStorageAttempt, call func(runtimeStorageStep) error, fence func()) (result error) {
+	if s == nil || s.used || call == nil || fence == nil {
+		return ErrUpgrade
+	}
+	s.used = true
+	defer func() {
+		if p := recover(); p != nil {
+			fence()
+			panic(p)
+		}
+		if s.armed && !s.complete {
+			fence()
+		}
+	}()
+	for _, step := range []runtimeStorageStep{runtimeStorageRecheck, runtimeStorageClosePrevious, runtimeStorageArmRename, runtimeStorageRename, runtimeStorageCloseStage, runtimeStorageOpenTarget, runtimeStorageVerifyTarget} {
+		if step == runtimeStorageArmRename {
+			s.armed = true
+		}
+		if e := call(step); e != nil {
+			return e
+		}
+	}
+	s.complete = true
+	return nil
+}
+
+// The controller index is withheld until every other owned resource closed.
+// Native close callbacks cache each attempt and fence on actual uncertainty.
+func runtimeStorageCloseSequence(count, controller int, closeOne func(int) error) error {
+	if count < 0 || controller >= count || controller < -1 || closeOne == nil {
+		return ErrUpgrade
+	}
+	for i := count - 1; i >= 0; i-- {
+		if i != controller {
+			if e := closeOne(i); e != nil {
+				return e
+			}
+		}
+	}
+	if controller >= 0 {
+		return closeOne(controller)
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model_test.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..db55c177a5dd0bedfcc9d8a2ad234297171d2a1b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_native_model_test.go
@@ -0,0 +1,158 @@
+package managementconfig
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestRuntimeStorageNativeOpenReplyRetainsPartialOutputBeforeFence(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		for _, present := range []bool{false, true} {
+			var nativeErr error
+			if failed {
+				nativeErr = errors.New("native name-not-found or failure")
+			}
+			var order []string
+			e := runtimeStorageOpenReply(nativeErr, present, func() { order = append(order, "actual output retained") }, func() { order = append(order, "remaining graph fenced") })
+			switch {
+			case failed && present:
+				if e != ErrUpgrade || len(order) != 2 || order[0] != "actual output retained" || order[1] != "remaining graph fenced" {
+					t.Fatal("partial output mistaken for absence or dropped", order, e)
+				}
+			case failed:
+				if e != nativeErr || len(order) != 0 {
+					t.Fatal("known no-output status was changed", order, e)
+				}
+			case !present:
+				if e != ErrUpgrade || len(order) != 1 || order[0] != "remaining graph fenced" {
+					t.Fatal("missing success output admitted", order, e)
+				}
+			default:
+				if e != nil || len(order) != 0 {
+					t.Fatal("positive output retained twice", order, e)
+				}
+			}
+		}
+	}
+}
+
+func TestRuntimeStorageActualCloseAttemptCachesFailureSuccessAndPanic(t *testing.T) {
+	for _, failure := range []bool{false, true} {
+		a := new(runtimeStorageCloseAttempt)
+		calls, fences := 0, 0
+		call := func() error {
+			calls++
+			if failure {
+				return ErrUpgrade
+			}
+			return nil
+		}
+		fence := func() { fences++ }
+		first := a.run(call, fence)
+		second := a.run(func() error { t.Fatal("second native close"); return nil }, fence)
+		if calls != 1 || (first != nil) != failure || (second != nil) != failure || fences != map[bool]int{false: 0, true: 1}[failure] {
+			t.Fatal("close reply cache", calls, fences)
+		}
+	}
+	a := new(runtimeStorageCloseAttempt)
+	fences := 0
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("panic swallowed")
+			}
+		}()
+		_ = a.run(func() error { panic("lost close reply") }, func() { fences++ })
+	}()
+	if a.run(func() error { t.Fatal("retry after panic"); return nil }, func() { fences++ }) == nil || fences != 1 {
+		t.Fatal("panic close not retained")
+	}
+}
+
+func TestRuntimeStorageAttemptStopsEverySuffixAndNeverRetries(t *testing.T) {
+	for fail := runtimeStorageRecheck; fail <= runtimeStorageVerifyTarget; fail++ {
+		s := new(runtimeStorageAttempt)
+		var calls []runtimeStorageStep
+		fenced := false
+		e := runtimeStorageCommitSequence(s, func(step runtimeStorageStep) error {
+			calls = append(calls, step)
+			if step == fail {
+				return errors.New("lost or failed step")
+			}
+			return nil
+		}, func() { fenced = true })
+		if e == nil || len(calls) != int(fail)+1 || fenced != (fail >= runtimeStorageArmRename) {
+			t.Fatal(fail, calls, fenced)
+		}
+		if runtimeStorageCommitSequence(s, func(runtimeStorageStep) error { t.Fatal("retried one-use owner"); return nil }, func() {}) == nil {
+			t.Fatal("replay")
+		}
+	}
+	s := new(runtimeStorageAttempt)
+	if runtimeStorageCommitSequence(s, func(runtimeStorageStep) error { return nil }, func() { t.Fatal("success fenced") }) != nil || !s.complete {
+		t.Fatal("positive suffix")
+	}
+}
+func TestRuntimeStoragePreparationCannotAdmitBeforeDurabilityAndWriterClose(t *testing.T) {
+	for fail := runtimeStorageCreateStage; fail <= runtimeStorageVerifyStage; fail++ {
+		var calls []runtimeStoragePrepareStep
+		e := runtimeStoragePrepareSequence(func(step runtimeStoragePrepareStep) error {
+			calls = append(calls, step)
+			if step == fail {
+				return ErrUpgrade
+			}
+			return nil
+		})
+		if e == nil || len(calls) != int(fail)+1 {
+			t.Fatal("preparation crossed failed durability/close", fail, calls)
+		}
+	}
+	var calls []runtimeStoragePrepareStep
+	if runtimeStoragePrepareSequence(func(step runtimeStoragePrepareStep) error { calls = append(calls, step); return nil }) != nil || len(calls) != 7 || calls[4] != runtimeStorageCloseWriter || calls[5] != runtimeStorageAdmitStage {
+		t.Fatal("readonly admission before actual writer close", calls)
+	}
+}
+func TestRuntimeStoragePanicAndCloseStopFirstRetainController(t *testing.T) {
+	fenced := false
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("panic swallowed")
+			}
+		}()
+		_ = runtimeStorageCommitSequence(new(runtimeStorageAttempt), func(runtimeStorageStep) error { panic("panic at admission") }, func() { fenced = true })
+	}()
+	if !fenced {
+		t.Fatal("panic did not retain")
+	}
+	for fail := 0; fail < 5; fail++ {
+		var order []int
+		_ = runtimeStorageCloseSequence(5, 1, func(i int) error {
+			order = append(order, i)
+			if i == fail {
+				return ErrUpgrade
+			}
+			return nil
+		})
+		at := -1
+		for n, i := range order {
+			if i == fail {
+				at = n
+			}
+		}
+		if at != len(order)-1 {
+			t.Fatal("continued after uncertain close", fail, order)
+		}
+		if fail != 1 {
+			for _, i := range order {
+				if i == 1 {
+					t.Fatal("released controller after uncertainty")
+				}
+			}
+		}
+	}
+	var order []int
+	if runtimeStorageCloseSequence(5, 1, func(i int) error { order = append(order, i); return nil }) != nil || order[len(order)-1] != 1 {
+		t.Fatal("controller not last", order)
+	}
+}
