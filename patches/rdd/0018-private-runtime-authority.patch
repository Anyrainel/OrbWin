@@ -0,0 +1,37 @@
+package managementconfig
+
+import (
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestRuntimePreflightAbandonCannotRaceInterruptionAdmission(t *testing.T) {
+	for n := 0; n < 32; n++ {
+		sink := &fakeUpgradeSink{}
+		r, _ := newUpgradeRecorder(sink, nil)
+		j := upgradeFixture()
+		if r.append(context.Background(), j) != nil {
+			t.Fatal("prepare")
+		}
+		next, err := advanceUpgrade(j, "interruption-admitted")
+		if err != nil {
+			t.Fatal(err)
+		}
+		var group sync.WaitGroup
+		group.Add(2)
+		var abandoned, interrupted error
+		go func() { defer group.Done(); abandoned = retireRuntimePreflight(r) }()
+		go func() { defer group.Done(); interrupted = r.append(context.Background(), next) }()
+		group.Wait()
+		if (abandoned == nil) == (interrupted == nil) {
+			t.Fatal("both or neither paths admitted")
+		}
+		if abandoned == nil && (sink.writes != 1 || !r.retired || r.last.Journal.Stage != "prepared") {
+			t.Fatal("native release could race later interruption")
+		}
+		if interrupted == nil && (sink.writes != 2 || r.retired || retireRuntimePreflight(r) == nil) {
+			t.Fatal("post-interruption abandonment admitted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication.go b/rdd/pkg/managementconfig/upgrade_runtime_publication.go
new file mode 100644
index 0000000000000000000000000000000000000000..8123401d69bdcb3dcbbfc1bfa549315a0849e5c5
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication.go
@@ -0,0 +1,161 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"strings"
+	"unicode/utf8"
+)
+
+const runtimeIdentityBudget = 16 << 10
+const runtimeIdentityEndpoint = "npipe:////./pipe/docker-rancher-desktop-orbwin"
+
+// Compatibility DATA only. These fields never authorize an image, process,
+// root, endpoint owner or publication. The native provider owns those separately.
+type runtimeIdentityRecord struct {
+	Endpoint     string `json:"endpoint"`
+	Home         string `json:"home"`
+	Daemon       string `json:"daemonId"`
+	SourceCommit string `json:"sourceCommit"`
+	BinarySHA    string `json:"binarySha256"`
+	Verified     bool   `json:"identityVerified"`
+}
+
+func (r runtimeIdentityRecord) valid(home string) bool {
+	return home != "" && utf8.ValidString(home) && utf8.ValidString(r.Home) && strings.EqualFold(r.Home, home) && r.Endpoint == runtimeIdentityEndpoint &&
+		r.Verified && upgradeASCII(r.Daemon, 256) && upgradeHex(r.SourceCommit, 40) && upgradeHex(r.BinarySHA, 64)
+}
+
+// Adapted from OrbWin's ordinary raw JSON Unicode guard. This metadata reader
+// also refuses lossy replacement of malformed UTF-8 or unpaired UTF-16 escapes.
+func runtimeIdentityUnicode(body []byte) bool {
+	if !utf8.Valid(body) {
+		return false
+	}
+	inside := false
+	unit := func(at int) (uint16, bool) {
+		if at+4 > len(body) {
+			return 0, false
+		}
+		var v uint16
+		for _, b := range body[at : at+4] {
+			v *= 16
+			switch {
+			case b >= '0' && b <= '9':
+				v += uint16(b - '0')
+			case b >= 'a' && b <= 'f':
+				v += uint16(b - 'a' + 10)
+			case b >= 'A' && b <= 'F':
+				v += uint16(b - 'A' + 10)
+			default:
+				return 0, false
+			}
+		}
+		return v, true
+	}
+	for i := 0; i < len(body); i++ {
+		if body[i] == '"' {
+			inside = !inside
+			continue
+		}
+		if !inside || body[i] != '\\' {
+			continue
+		}
+		i++
+		if i >= len(body) {
+			return false
+		}
+		if body[i] != 'u' {
+			continue
+		}
+		v, ok := unit(i + 1)
+		if !ok {
+			return false
+		}
+		i += 4
+		if v >= 0xd800 && v <= 0xdbff {
+			if i+6 >= len(body) || body[i+1] != '\\' || body[i+2] != 'u' {
+				return false
+			}
+			low, ok := unit(i + 3)
+			if !ok || low < 0xdc00 || low > 0xdfff {
+				return false
+			}
+			i += 6
+		} else if v >= 0xdc00 && v <= 0xdfff {
+			return false
+		}
+	}
+	return !inside
+}
+
+// Decode each occurrence before forming a struct: encoding/json's ordinary
+// struct decoder otherwise accepts duplicate and case-folded tagged fields.
+func parseRuntimeIdentity(body []byte, home string) (runtimeIdentityRecord, error) {
+	var r runtimeIdentityRecord
+	if len(body) == 0 || len(body) > runtimeIdentityBudget || !runtimeIdentityUnicode(body) {
+		return r, ErrUpgrade
+	}
+	d := json.NewDecoder(bytes.NewReader(body))
+	start, err := d.Token()
+	if err != nil || start != json.Delim('{') {
+		return r, ErrUpgrade
+	}
+	seen := map[string]bool{}
+	for d.More() {
+		key, err := d.Token()
+		name, ok := key.(string)
+		if err != nil || !ok || seen[name] {
+			return runtimeIdentityRecord{}, ErrUpgrade
+		}
+		seen[name] = true
+		switch name {
+		case "endpoint":
+			err = d.Decode(&r.Endpoint)
+		case "home":
+			err = d.Decode(&r.Home)
+		case "daemonId":
+			err = d.Decode(&r.Daemon)
+		case "sourceCommit":
+			err = d.Decode(&r.SourceCommit)
+		case "binarySha256":
+			err = d.Decode(&r.BinarySHA)
+		case "identityVerified":
+			err = d.Decode(&r.Verified)
+		default:
+			return runtimeIdentityRecord{}, ErrUpgrade
+		}
+		if err != nil {
+			return runtimeIdentityRecord{}, ErrUpgrade
+		}
+	}
+	end, err := d.Token()
+	if err != nil || end != json.Delim('}') || len(seen) != 6 || !r.valid(home) {
+		return runtimeIdentityRecord{}, ErrUpgrade
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return runtimeIdentityRecord{}, ErrUpgrade
+	}
+	return r, nil
+}
+
+func encodeRuntimeIdentity(r runtimeIdentityRecord, home string) ([]byte, error) {
+	if !r.valid(home) {
+		return nil, ErrUpgrade
+	}
+	body, err := json.Marshal(r)
+	if err != nil || len(body) > runtimeIdentityBudget {
+		return nil, ErrUpgrade
+	}
+	return body, nil
+}
+
+// Native publication additionally requires a current actual observed-candidate
+// capability. This comparison is only an early data rejection, never its issuer.
+func (r runtimeIdentityRecord) matchesUpgradeData(j upgradeJournal, v upgradeValidation) bool {
+	return j.Incoming != [32]byte{} && j.Candidate.valid() && upgradeASCII(j.Daemon, 128) &&
+		r.Daemon == j.Daemon && v.Candidate == j.Candidate && v.Daemon == j.Daemon &&
+		r.BinarySHA == hex.EncodeToString(j.Incoming[:])
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_admission.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_admission.go
new file mode 100644
index 0000000000000000000000000000000000000000..f61c0e5d447b8f2bce2cdf5da36d53676c0b5cbd
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_admission.go
@@ -0,0 +1,103 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+)
+
+// Data for a future durable pre-rename record. No paths, credentials or raw
+// handles; parsing it issues no storage/candidate/restore authority. It binds
+// the actual captured predecessor (including observed absence), prepared stage,
+// same setup controller and independently observed incoming generation.
+type runtimePublicationFileWitness struct {
+	Object     UpgradeObject `json:"object"`
+	Size       uint64        `json:"size"`
+	Written    uint64        `json:"written"`
+	Descriptor [32]byte      `json:"descriptor"`
+	Body       [32]byte      `json:"body"`
+}
+
+type runtimePublicationAdmission struct {
+	Schema               int                           `json:"schema"`
+	Transaction          string                        `json:"transaction"`
+	Candidate            UpgradeProcess                `json:"candidate"`
+	Validation           [32]byte                      `json:"validation"`
+	PrivateRoot          UpgradeObject                 `json:"privateRoot"`
+	Parent               UpgradeObject                 `json:"parent"`
+	Controller           UpgradeObject                 `json:"controller"`
+	ParentDescriptor     [32]byte                      `json:"parentDescriptor"`
+	ControllerDescriptor [32]byte                      `json:"controllerDescriptor"`
+	Previous             runtimePublicationFileWitness `json:"previous"`
+	Stage                runtimePublicationFileWitness `json:"stage"`
+}
+
+func (w runtimePublicationFileWitness) valid() bool {
+	return w.Object.valid() && w.Size > 0 && w.Size <= runtimeIdentityBudget && w.Descriptor != [32]byte{} && w.Body != [32]byte{}
+}
+
+func (a runtimePublicationAdmission) valid() bool {
+	if a.Schema != 1 || !upgradeHex(a.Transaction, 32) || !a.Candidate.valid() || a.Validation == [32]byte{} || !a.PrivateRoot.valid() || !a.Parent.valid() || !a.Controller.valid() || a.ParentDescriptor == [32]byte{} || a.ControllerDescriptor == [32]byte{} || !a.Stage.valid() {
+		return false
+	}
+	if a.Previous != (runtimePublicationFileWitness{}) && !a.Previous.valid() {
+		return false
+	}
+	// The publication, controller and destination directory are distinct actual
+	// objects on the same destination volume. A predecessor cannot alias stage.
+	if a.Controller.Volume != a.Parent.Volume || a.Stage.Object.Volume != a.Parent.Volume || a.Controller == a.Parent || a.Stage.Object == a.Parent || a.Stage.Object == a.Controller {
+		return false
+	}
+	return !a.Previous.Object.valid() || a.Previous.Object.Volume == a.Parent.Volume && a.Previous.Object != a.Stage.Object && a.Previous.Object != a.Controller && a.Previous.Object != a.Parent
+}
+
+func (a runtimePublicationAdmission) matches(j upgradeJournal) bool {
+	return a.valid() && a.Transaction == j.Transaction && a.Candidate == j.Candidate && a.Candidate.Image == j.Incoming && a.PrivateRoot == j.PrivateRoot && a.Validation == j.ValidationDigest
+}
+
+// This one admission transition installs its mandatory receipt atomically in
+// the in-memory record; neither a receipt-free destination nor an early receipt
+// is a valid journal. append remains the actual durability boundary.
+func admitRuntimePublication(before upgradeJournal, a runtimePublicationAdmission) (upgradeJournal, error) {
+	if before.Stage != "candidate-validated" || !before.valid() || !a.matches(before) {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	after := before
+	after.RuntimeAdmission = a
+	after.Stage = "runtime-publication-admitted"
+	if !after.valid() || !upgradeRecordFollows(before, after) {
+		return upgradeJournal{}, ErrUpgrade
+	}
+	return after, nil
+}
+
+func runtimePublicationAdmissionBytes(a runtimePublicationAdmission) ([]byte, error) {
+	if !a.valid() {
+		return nil, ErrUpgrade
+	}
+	b, err := json.Marshal(a)
+	if err != nil || len(b) > 4096 {
+		return nil, ErrUpgrade
+	}
+	return b, nil
+}
+
+func parseRuntimePublicationAdmission(body []byte) (runtimePublicationAdmission, error) {
+	var a runtimePublicationAdmission
+	if len(body) == 0 || len(body) > 4096 || json.Unmarshal(body, &a) != nil {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	canonical, err := runtimePublicationAdmissionBytes(a)
+	if err != nil || !bytes.Equal(canonical, body) {
+		return runtimePublicationAdmission{}, ErrUpgrade
+	}
+	return a, nil
+}
+
+func (a runtimePublicationAdmission) digest() ([32]byte, error) {
+	body, err := runtimePublicationAdmissionBytes(a)
+	if err != nil {
+		return [32]byte{}, err
+	}
+	return sha256.Sum256(body), nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_admission_test.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_admission_test.go
