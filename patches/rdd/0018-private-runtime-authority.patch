+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKOfferedControlNeverReturnsToTemporaryWriter(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	// No native handles exist in this fixture: admission must reject BEFORE any
+	// native proof or I/O is attempted, preserving the acknowledged sequence.
+	c := &nativeUpgradeSDKChild{sequence: 1, controlOffered: true}
+	if _, err := c.call(ctx, "inventory"); err == nil || c.sequence != 1 || c.unknown {
+		t.Fatal("offered original pipe reused by TEMP", err)
+	}
+	// An in-flight writer also refuses immediately; no waiting behind another
+	// operation may outlive this caller's cancellation boundary.
+	c.controlOffered = false
+	c.protocol.Lock()
+	if _, err := c.call(ctx, "inventory"); err == nil || c.sequence != 1 {
+		t.Fatal("concurrent protocol writer admitted", err)
+	}
+	c.protocol.Unlock()
+}
+
+func TestUpgradeSDKManagementOnlyLaunchCannotLoseOwner(t *testing.T) {
+	called := false
+	start := func(uintptr) error { called = true; return nil }
+	for _, transfer := range []upgradeCandidateTransfer{&upgradeServingTransfer{}, &nativeUpgradeSDKCandidateTransfer{}} {
+		if err := transfer.startUpgradeCandidate(start); err == nil || called {
+			t.Fatal("management-only allowlist crossed SDK ownership boundary")
+		}
+	}
+}
