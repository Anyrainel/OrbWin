+package managementconfig
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+type legacySDKStreamFake struct {
+	input   *bytes.Reader
+	output  bytes.Buffer
+	maximum int
+	zero    bool
+}
+
+func (f *legacySDKStreamFake) Read(p []byte) (int, error) { return f.input.Read(p) }
+func (f *legacySDKStreamFake) Write(p []byte) (int, error) {
+	if f.zero {
+		return 0, nil
+	}
+	if f.maximum > 0 && len(p) > f.maximum {
+		p = p[:f.maximum]
+	}
+	return f.output.Write(p)
+}
+func legacySDKReplyFrame(body []byte) []byte {
+	frame := make([]byte, 4+len(body))
+	binary.LittleEndian.PutUint32(frame, uint32(len(body)))
+	copy(frame[4:], body)
+	return frame
+}
+func legacySDKReplyFixture(t *testing.T) []byte {
+	t.Helper()
+	state, _ := json.Marshal(map[string]any{"daemonId": strings.Repeat("a", 32), "installation": strings.Repeat("a", 32), "binarySha256": upgradeLegacySDKImageSHA256, "phase": "stopped"})
+	data, err := json.Marshal(upgradeLegacySDKReply{Version: 1, State: state})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestUpgradeLegacySDKFramingVerifiesBeforeAnyRequestAndAfterReply(t *testing.T) {
+	for _, operation := range []string{"snapshot", "stop-process"} {
+		for _, failure := range []string{"", "before", "after"} {
+			t.Run(operation+failure, func(t *testing.T) {
+				stream := &legacySDKStreamFake{input: bytes.NewReader(legacySDKReplyFrame(legacySDKReplyFixture(t))), maximum: 2}
+				var events []string
+				before := func() error {
+					events = append(events, "native-before")
+					if failure == "before" {
+						return ErrUpgrade
+					}
+					return nil
+				}
+				after := func() error {
+					events = append(events, "native-after")
+					if failure == "after" {
+						return ErrUpgrade
+					}
+					return nil
+				}
+				reply, err := callUpgradeLegacySDK(stream, operation, before, after)
+				if (err != nil) != (failure != "") {
+					t.Fatal(err)
+				}
+				if failure == "before" {
+					if stream.output.Len() != 0 || len(events) != 1 {
+						t.Fatal("unverified peer received request")
+					}
+					return
+				}
+				frame := stream.output.Bytes()
+				want := []byte(`{"version":1,"operation":"` + operation + `"}`)
+				if len(frame) < 4 || int(binary.LittleEndian.Uint32(frame)) != len(want) || !bytes.Equal(frame[4:], want) || len(events) != 2 {
+					t.Fatal("old fixed framing/order changed")
+				}
+				if failure == "" && validateUpgradeLegacySDKSnapshot(reply, strings.Repeat("a", 32)) != nil {
+					t.Fatal("matching data correlation refused")
+				}
+			})
+		}
+	}
+}
+
+func TestUpgradeLegacySDKRejectsMalformedReplyAndUnsupportedOperations(t *testing.T) {
+	valid := legacySDKReplyFixture(t)
+	for _, body := range [][]byte{nil, []byte(`{"version":2,"state":{}}`), []byte(`{"version":1,"state":null}`), []byte(`{"version":1,"state":{},"error":"cleanup unknown"}`), []byte(strings.Replace(string(valid), `"version":1`, `"version":1,"version":1`, 1)), []byte(strings.Replace(string(valid), `"version":1`, `"version":1,"extra":true`, 1)), append(append([]byte(nil), valid...), '\n')} {
+		stream := &legacySDKStreamFake{input: bytes.NewReader(legacySDKReplyFrame(body))}
+		if _, err := callUpgradeLegacySDK(stream, "snapshot", func() error { return nil }, func() error { return nil }); err == nil {
+			t.Fatal("malformed historical reply accepted")
+		}
+	}
+	oversize := make([]byte, 4)
+	binary.LittleEndian.PutUint32(oversize, upgradeLegacySDKReplyLimit+1)
+	for _, frame := range [][]byte{oversize, {1, 0, 0}, {10, 0, 0, 0, 1}} {
+		stream := &legacySDKStreamFake{input: bytes.NewReader(frame)}
+		if _, err := callUpgradeLegacySDK(stream, "snapshot", func() error { return nil }, func() error { return nil }); err == nil {
+			t.Fatal("unbounded/partial reply accepted")
+		}
+	}
+	for _, operation := range []string{"configure", "trust-remove", "lan-cleanup", "stop", "shutdown"} {
+		stream := &legacySDKStreamFake{input: bytes.NewReader(nil)}
+		if _, err := callUpgradeLegacySDK(stream, operation, func() error { t.Fatal("unsupported request reached peer verification"); return nil }, func() error { return nil }); err == nil || stream.output.Len() != 0 {
+			t.Fatal("unsupported legacy command emitted")
+		}
+	}
+	stream := &legacySDKStreamFake{input: bytes.NewReader(nil), zero: true}
+	if _, err := callUpgradeLegacySDK(stream, "snapshot", func() error { return nil }, func() error { return nil }); err == nil {
+		t.Fatal("zero write spun or succeeded")
+	}
+}
+
+func TestUpgradeLegacySDKScopeRequiresExactObservedServeRecipe(t *testing.T) {
+	image, home, daemon := `F:\observed\orbwin-session.exe`, `C:\Users\fixture\home`, strings.Repeat("a", 32)
+	args := []string{image, "local-services-serve", home, daemon, daemon, `F:\observed\orbwin-services`, strings.Repeat("b", 64)}
+	if !validateUpgradeLegacySDKArgs(args, image, home, daemon) {
+		t.Fatal("selected ordinary serve recipe refused")
+	}
+	for _, index := range []int{0, 1, 2, 3, 4} {
+		changed := append([]string(nil), args...)
+		changed[index] = "foreign"
+		if validateUpgradeLegacySDKArgs(changed, image, home, daemon) {
+			t.Fatalf("foreign native argv scope %d accepted", index)
+		}
+	}
+	reply := upgradeLegacySDKReply{Version: 1, State: []byte(`{"daemonId":"foreign","installation":"` + daemon + `","binarySha256":"` + upgradeLegacySDKImageSHA256 + `","phase":"stopped","retired":true}`)}
+	if validateUpgradeLegacySDKSnapshot(reply, daemon) == nil {
+		t.Fatal("snapshot flags granted foreign scope")
+	}
+}
+
+func TestUpgradeLegacySDKCloseUnknownRetainsProcessOwner(t *testing.T) {
+	for _, failure := range []string{"", "pipe", "view", "image", "token", "process"} {
+		var events []string
+		step := func(name string) func() error {
+			return func() error {
+				events = append(events, name)
+				if failure == name {
+					return ErrUpgrade
+				}
+				return nil
+			}
+		}
+		err := closeOwnerLastLegacySDK([]func() error{step("pipe"), step("view"), step("image"), step("token")}, step("process"))
+		if (err != nil) != (failure != "") {
+			t.Fatal(err)
+		}
+		if failure != "" && events[len(events)-1] != failure {
+			t.Fatal("unknown close released later owner", events)
+		}
+	}
+}
+
+func TestUpgradeLegacySDKHelperLifetimeRejectsPIDReuseAndAmbiguousEdges(t *testing.T) {
+	for _, tc := range []struct {
+		child, start, end uint64
+		retired, want     bool
+	}{
+		{150, 100, 200, true, true}, {150, 100, 0, false, true},
+		{99, 100, 200, true, false}, {100, 100, 200, true, false},
+		{200, 100, 200, true, false}, {201, 100, 200, true, false},
+		{150, 100, 0, true, false}, {150, 100, 99, true, false}, {150, 0, 200, true, false},
+	} {
+		if got := upgradeLegacySDKChildLifetime(tc.child, tc.start, tc.end, tc.retired); got != tc.want {
+			t.Fatal("ambiguous/foreign child generation accepted", tc)
+		}
+	}
+}
