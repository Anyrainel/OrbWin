+++ b/rdd/pkg/managementconfig/upgrade_sdk_grant.go
@@ -0,0 +1,68 @@
+package managementconfig
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+)
+
+type upgradeSDKFinalTransfer struct {
+	File, Event uint64
+	Object      string
+	Nonce       [32]byte
+}
+
+// Exact sdkstate.transitionGrant v1 field spelling/order. These wire values
+// describe owned inherited objects; parsing or constructing them grants none.
+// In particular UpgradeProcess has lower-case JSON tags and must not be used
+// as this cross-module native launch wire's nested process representation.
+type upgradeSDKGrantProcess struct {
+	PID      uint32
+	Creation uint64
+	Session  uint32
+	Image    [32]byte
+}
+type upgradeSDKGrantScope struct {
+	Transaction, Installation, Daemon, SID string
+	ManagementRetirement, SDKImage         [32]byte
+}
+type upgradeSDKGrantInherited struct {
+	Identity              upgradeSDKGrantProcess
+	Process, Token, Image uint64
+}
+type upgradeSDKGrantWire struct {
+	Schema                 int
+	Scope                  upgradeSDKGrantScope
+	Parent                 upgradeSDKGrantProcess
+	LegacyRoot, Controller uint64
+	Processes              []upgradeSDKGrantInherited
+	Final                  upgradeSDKFinalTransfer
+	Denial                 uint64
+	Control                uint64
+}
+
+func upgradeSDKProcessWire(p UpgradeProcess) upgradeSDKGrantProcess {
+	return upgradeSDKGrantProcess{p.PID, p.Creation, p.Session, p.Image}
+}
+
+func upgradeSDKGrantBytes(g upgradeSDKGrantWire, raw uint64) ([]byte, error) {
+	if g.Schema != 2 || !upgradeHex(g.Scope.Transaction, 32) || g.Scope.Installation != g.Scope.Daemon || g.Scope.SID == "" || g.Scope.ManagementRetirement == [32]byte{} || g.Scope.SDKImage == [32]byte{} || g.Parent.PID == 0 || g.Parent.Creation == 0 || g.Parent.Session == 0 || g.Parent.Image == [32]byte{} || len(g.Processes) != 1 || g.Processes[0].Identity.PID == 0 || g.Processes[0].Identity.PID == g.Parent.PID || g.Processes[0].Identity.Creation == 0 || g.Processes[0].Identity.Session != g.Parent.Session || g.Processes[0].Identity.Image == [32]byte{} || g.Final.Object == "" || g.Final.Nonce == [32]byte{} {
+		return nil, ErrUpgrade
+	}
+	daemon := g.Scope.Daemon
+	if !upgradeHex(strings.ReplaceAll(daemon, "-", ""), 32) || len(daemon) != 32 && !(len(daemon) == 36 && daemon[8] == '-' && daemon[13] == '-' && daemon[18] == '-' && daemon[23] == '-') || hex.EncodeToString(g.Processes[0].Identity.Image[:]) != upgradeLegacySDKImageSHA256 {
+		return nil, ErrUpgrade
+	}
+	seen := map[uint64]bool{}
+	for _, h := range []uint64{raw, g.LegacyRoot, g.Controller, g.Denial, g.Final.File, g.Final.Event, g.Processes[0].Process, g.Processes[0].Token, g.Processes[0].Image, g.Control} {
+		if h == 0 || h == uint64(^uintptr(0)) || uint64(uintptr(h)) != h || seen[h] {
+			return nil, ErrUpgrade
+		}
+		seen[h] = true
+	}
+	body, err := json.Marshal(g)
+	if err != nil || len(body) > 64<<10 {
+		return nil, ErrUpgrade
+	}
+	return body, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_grant_test.go b/rdd/pkg/managementconfig/upgrade_sdk_grant_test.go
