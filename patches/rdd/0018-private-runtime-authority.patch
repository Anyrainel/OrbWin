+package main
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestRuntimeOperationClosedDispatch(t *testing.T) {
+	t.Setenv("RDD_INSTANCE", "orbwin")
+	for _, args := range [][]string{{"private-runtime-operation"}, {"private-runtime-operation", "setup"}, {"private-runtime-operation", "preflight", "C:\\other"}} {
+		var out bytes.Buffer
+		if handled, code := privateRuntimeOperation(args, bytes.NewReader(nil), &out); !handled || code != 2 || out.Len() != 0 {
+			t.Fatal("invalid dispatch/native leak")
+		}
+	}
+	for _, scope := range []string{"", "orbwin-proof", "rancher-desktop"} {
+		t.Setenv("RDD_INSTANCE", scope)
+		var out bytes.Buffer
+		if handled, code := privateRuntimeOperation([]string{"private-runtime-operation", "preflight"}, bytes.NewReader(nil), &out); !handled || code != 2 || out.Len() != 0 {
+			t.Fatal("scope refusal")
+		}
+	}
+	var out bytes.Buffer
+	if handled, _ := privateRuntimeOperation([]string{"service", "start"}, bytes.NewReader(nil), &out); handled || out.Len() != 0 {
+		t.Fatal("intercepted lifecycle")
+	}
+}
diff --git a/rdd/pkg/authoritypath/product_owner.go b/rdd/pkg/authoritypath/product_owner.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c00e63b994804a4c0cad371d8e791788bd9bf4e
--- /dev/null
+++ b/rdd/pkg/authoritypath/product_owner.go
@@ -0,0 +1,62 @@
+package authoritypath
+
+// Actual native product selection uses these DATA sequencing/close helpers.
+// Their callbacks cannot construct ProductSelectionOwner or a Selection.
+type productSelectionStep uint8
+
+const (
+	productCaptureThread productSelectionStep = iota
+	productCaptureProcess
+	productQueryIdentity
+	productQueryFolders
+	productAdmitSelection
+)
+
+func productSelectionSequence(effect func(productSelectionStep) error) error {
+	if effect == nil {
+		return ErrSelection
+	}
+	for _, s := range []productSelectionStep{productCaptureThread, productCaptureProcess, productQueryIdentity, productQueryFolders, productAdmitSelection} {
+		if e := effect(s); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+
+type productCloseAttempt struct {
+	used bool
+	err  error
+}
+
+func (a *productCloseAttempt) run(effect func() error, unknown func()) (result error) {
+	if a == nil || effect == nil || unknown == nil {
+		return ErrSelection
+	}
+	if a.used {
+		return a.err
+	}
+	a.used = true
+	defer func() {
+		if p := recover(); p != nil {
+			a.err = ErrSelection
+			unknown()
+			panic(p)
+		}
+	}()
+	a.err = effect()
+	if a.err != nil {
+		unknown()
+	}
+	return a.err
+}
+func productOpenReply(callErr error, hasOutput bool, retain, unknown func()) error {
+	if hasOutput {
+		retain()
+	}
+	if callErr != nil && hasOutput || callErr == nil && !hasOutput {
+		unknown()
+		return ErrSelection
+	}
+	return callErr
+}
diff --git a/rdd/pkg/authoritypath/product_owner_test.go b/rdd/pkg/authoritypath/product_owner_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d5ec855606237b86eea68d712ee1d638ed290338
--- /dev/null
+++ b/rdd/pkg/authoritypath/product_owner_test.go
@@ -0,0 +1,59 @@
+package authoritypath
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestProductSelectionActualOrderAndPartialOutputs(t *testing.T) {
+	for fault := productCaptureThread; fault <= productAdmitSelection; fault++ {
+		calls := 0
+		if productSelectionSequence(func(s productSelectionStep) error {
+			calls++
+			if s == fault {
+				return ErrSelection
+			}
+			return nil
+		}) == nil || calls != int(fault)+1 {
+			t.Fatal("constructor crosses failure")
+		}
+	}
+	for _, v := range []struct {
+		e             error
+		output        bool
+		retain, fence int
+	}{{nil, true, 1, 0}, {errors.New("known no output"), false, 0, 0}, {errors.New("partial"), true, 1, 1}, {nil, false, 0, 1}} {
+		retained, fenced := 0, 0
+		productOpenReply(v.e, v.output, func() { retained++ }, func() { fenced++ })
+		if retained != v.retain || fenced != v.fence {
+			t.Fatal("output not owned before unknown")
+		}
+	}
+}
+func TestProductSelectionCachedStopFirstClose(t *testing.T) {
+	for _, panicClose := range []bool{false, true} {
+		a := &productCloseAttempt{}
+		calls, fences := 0, 0
+		effect := func() error {
+			calls++
+			if panicClose {
+				panic("actual-call model")
+			}
+			return ErrSelection
+		}
+		func() { defer func() { recover() }(); a.run(effect, func() { fences++ }) }()
+		if a.run(effect, func() { fences++ }) == nil || calls != 1 || fences != 1 {
+			t.Fatal("unknown close replay")
+		}
+	}
+	a := &productCloseAttempt{}
+	calls := 0
+	for i := 0; i < 2; i++ {
+		if a.run(func() error { calls++; return nil }, func() { t.Fatal("false unknown") }) != nil {
+			t.Fatal("positive close")
+		}
+	}
+	if calls != 1 {
+		t.Fatal("success close replay")
+	}
+}
diff --git a/rdd/pkg/authoritypath/product_owner_windows.go b/rdd/pkg/authoritypath/product_owner_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..160f6676ae4ce307a69ef5d525ef2a62de248525
--- /dev/null
+++ b/rdd/pkg/authoritypath/product_owner_windows.go
@@ -0,0 +1,212 @@
+//go:build windows
+
+package authoritypath
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// Actual current-process tokens and native known folders only. This opaque
+// owner has no caller-path/facts/raw-handle/Boolean constructor. Selection alone
+// remains routing DATA; independent native filesystem admission is still owed.
+type ProductSelectionOwner struct {
+	mu              sync.Mutex
+	self            *ProductSelectionOwner
+	process         uint32
+	token           windows.Token
+	resources       []*productTokenResource
+	selection       *Selection
+	local, sid      string
+	session         uint32
+	closed, unknown bool
+	close           productCloseAttempt
+}
+type productTokenResource struct {
+	token windows.Token
+	close productCloseAttempt
+}
+
+var productSelectionDomain = struct {
+	sync.Mutex
+	failed bool
+	owners map[*ProductSelectionOwner]bool
+}{owners: make(map[*ProductSelectionOwner]bool)}
+
+func (*ProductSelectionOwner) String() string   { return "actual native product selection owner" }
+func (*ProductSelectionOwner) GoString() string { return "actual native product selection owner" }
+func productBounded(ctx context.Context) bool {
+	if ctx == nil || ctx.Err() != nil {
+		return false
+	}
+	_, ok := ctx.Deadline()
+	return ok
+}
+func productDomainKnown() bool {
+	productSelectionDomain.Lock()
+	defer productSelectionDomain.Unlock()
+	return !productSelectionDomain.failed
+}
+func (o *ProductSelectionOwner) fence() {
+	o.unknown = true
+	productSelectionDomain.Lock()
+	productSelectionDomain.failed = true
+	productSelectionDomain.owners[o] = true
+	productSelectionDomain.Unlock()
+}
+func (o *ProductSelectionOwner) openReply(token windows.Token, e error) error {
+	return productOpenReply(e, token != 0 && windows.Handle(token) != windows.InvalidHandle, func() { o.resources = append(o.resources, &productTokenResource{token: token}) }, o.fence)
+}
+func (o *ProductSelectionOwner) facts() error {
+	user, e := o.token.GetTokenUser()
+	if e != nil || user == nil || user.User.Sid == nil || !user.User.Sid.IsValid() {
+		return ErrSelection
+	}
+	sid := user.User.Sid.String()
+	var session uint32
+	for _, q := range []struct{ class, want uint32 }{{windows.TokenElevation, 0}, {29, 0}, {windows.TokenType, 1}} {
+		var value, size uint32
+		if windows.GetTokenInformation(o.token, q.class, (*byte)(unsafe.Pointer(&value)), 4, &size) != nil || size != 4 || value != q.want {
+			return ErrSelection
+		}
+	}
+	var size uint32
+	if windows.GetTokenInformation(o.token, windows.TokenSessionId, (*byte)(unsafe.Pointer(&session)), 4, &size) != nil || size != 4 || session == 0 {
+		return ErrSelection
+	}
+	restricted, e := o.token.IsRestricted()
+	if e != nil || restricted {
+		return ErrSelection
+	}
+	if o.sid != "" && (o.sid != sid || o.session != session) {
+		return ErrSelection
+	}
+	o.sid, o.session = sid, session
+	return nil
+}
+func CaptureCurrentProduct(ctx context.Context) (out *ProductSelectionOwner, result error) {
+	if !productBounded(ctx) {
+		return nil, ErrSelection
+	}
+	o := &ProductSelectionOwner{process: windows.GetCurrentProcessId()}
+	o.self = o
+	productSelectionDomain.Lock()
+	if productSelectionDomain.failed || len(productSelectionDomain.owners) >= 16 {
+		productSelectionDomain.Unlock()
+		return nil, ErrSelection
+	}
+	productSelectionDomain.owners[o] = true
+	productSelectionDomain.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fence()
+			panic(p)
+		}
+		if result != nil && o.Close() != nil {
+			out = o
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	result = productSelectionSequence(func(step productSelectionStep) error {
+		if !productBounded(ctx) {
+			return ErrSelection
+		}
+		switch step {
+		case productCaptureThread:
+			var token windows.Token
+			e := windows.OpenThreadToken(windows.CurrentThread(), windows.TOKEN_QUERY, true, &token)
+			if o.openReply(token, e) != windows.ERROR_NO_TOKEN {
+				return ErrSelection
+			}
+		case productCaptureProcess:
+			var token windows.Token
+			e := windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY, &token)
+			if e = o.openReply(token, e); e != nil {
+				return e
+			}
+			o.token = token
+		case productQueryIdentity:
+			return o.facts()
+		case productQueryFolders:
+			profile, e := o.token.KnownFolderPath(windows.FOLDERID_Profile, 0)
+			if e != nil {
+				return ErrSelection
+			}
+			local, e := o.token.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
+			if e != nil {
+				return ErrSelection
+			}
+			o.selection, e = selectNative(profile, local, local+`\OrbWinData\home`, "orbwin", o.sid)
+			o.local = local
+			return e
+		case productAdmitSelection:
+			if o.selection == nil || o.selection.owner != o.sid || o.process != windows.GetCurrentProcessId() || o.facts() != nil {
+				return ErrSelection
+			}
+		}
+		return nil
+	})
+	if result != nil {
+		return nil, result
+	}
+	return o, nil
+}
+func (o *ProductSelectionOwner) Selection(ctx context.Context) (*Selection, error) {
+	if o == nil || o.self != o || !productBounded(ctx) {
+		return nil, ErrSelection
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed || o.unknown || !productDomainKnown() || o.selection == nil || o.process != windows.GetCurrentProcessId() || o.facts() != nil {
+		return nil, ErrSelection
+	}
+	profile, e := o.token.KnownFolderPath(windows.FOLDERID_Profile, 0)
+	if e != nil || profile != o.selection.profile {
+		return nil, ErrSelection
+	}
+	local, e := o.token.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
+	if e != nil || local != o.local || !productBounded(ctx) {
+		return nil, ErrSelection
+	}
+	return o.selection, nil
+}
+func (o *ProductSelectionOwner) Close() error {
+	if o == nil {
+		return nil
+	}
+	if o.self != o {
+		return ErrSelection
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed {
+		return o.close.err
+	}
+	if o.unknown || !productDomainKnown() {
+		o.fence()
+		return ErrSelection
+	}
+	return o.close.run(func() error {
+		for i := len(o.resources) - 1; i >= 0; i-- {
+			r := o.resources[i]
+			if r.close.run(func() error {
+				if r.token == 0 || r.token.Close() != nil {
+					return ErrSelection
+				}
+				r.token = 0
+				return nil
+			}, o.fence) != nil {
+				return ErrSelection
+			}
+		}
+		o.closed = true
+		productSelectionDomain.Lock()
+		delete(productSelectionDomain.owners, o)
+		productSelectionDomain.Unlock()
+		return nil
+	}, o.fence)
+}
diff --git a/rdd/pkg/authoritypath/product_owner_windows_test.go b/rdd/pkg/authoritypath/product_owner_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a725adfd6b3b00fd8eaec65e34085ce619f75b67
--- /dev/null
+++ b/rdd/pkg/authoritypath/product_owner_windows_test.go
@@ -0,0 +1,29 @@
+//go:build windows
+
+package authoritypath
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestProductSelectionSourceOwnershipNegatives(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	actual := &ProductSelectionOwner{}
+	actual.self = actual
+	// Copy the claimed backing fields, not the mutex. A different wrapper must
+	// fail before querying any native token even if it names the actual owner.
+	copy := &ProductSelectionOwner{self: actual, process: actual.process, selection: actual.selection}
+	if _, e := copy.Selection(ctx); e == nil || copy.Close() == nil {
+		t.Fatal("copied wrapper borrowed real source")
+	}
+	if o, e := CaptureCurrentProduct(context.Background()); e == nil || o != nil {
+		t.Fatal("unbounded entered native constructor")
+	}
+	cancel()
+	if o, e := CaptureCurrentProduct(ctx); e == nil || o != nil {
+		t.Fatal("cancelled entered native constructor")
+	}
+}
diff --git a/rdd/pkg/authoritypath/selection.go b/rdd/pkg/authoritypath/selection.go
new file mode 100644
index 0000000000000000000000000000000000000000..032e3e93a503880779b79ec91e6ab9afa1cc1122
--- /dev/null
+++ b/rdd/pkg/authoritypath/selection.go
@@ -0,0 +1,96 @@
+// Package authoritypath selects fixed OrbWin authority roles from native known
+// folders. It does not open/create files, establish ACL safety or start services.
+package authoritypath
+
+import (
+	"errors"
+	"strings"
+)
+
+var ErrSelection = errors.New("native private authority selection unavailable")
+
+type Selection struct{ profile, home, owner string }
+
+func (*Selection) String() string   { return "native private authority selection" }
+func (*Selection) GoString() string { return "native private authority selection" }
+func (s *Selection) Profile() string {
+	if s == nil {
+		return ""
+	}
+	return s.profile
+}
+func (s *Selection) Owner() string {
+	if s == nil {
+		return ""
+	}
+	return s.owner
+}
+func (s *Selection) GuestHome() string {
+	if s == nil {
+		return ""
+	}
+	return s.home
+}
+func (s *Selection) Parent() string {
+	if s == nil {
+		return ""
+	}
+	return s.profile + `\.orbwin-private`
+}
+func (s *Selection) Directory() string {
+	if s == nil {
+		return ""
+	}
+	return s.Parent() + `\authority`
+}
+func (s *Selection) RuntimeParent() string {
+	if s == nil {
+		return ""
+	}
+	return s.Parent() + `\runtime`
+}
+func (s *Selection) LegacyParent() string {
+	if s == nil {
+		return ""
+	}
+	return s.home + `\AppData\Local`
+}
+func (s *Selection) LegacyDirectory() string {
+	if s == nil {
+		return ""
+	}
+	return s.LegacyParent() + `\rancher-desktop-orbwin`
+}
+func (s *Selection) Same(other *Selection) bool {
+	return s != nil && other != nil && s.owner == other.owner && strings.EqualFold(s.profile, other.profile) && strings.EqualFold(s.home, other.home)
+}
+
+// Package-private constructor receives only actual native-query outputs in
+// production. Environment home must match the existing fixed guest home; it
+// cannot redirect either authority or legacy input to a renderer path.
+func selectNative(profile, local, home, suffix, owner string) (*Selection, error) {
+	if suffix != "orbwin" || owner == "" || len(owner) > 184 || !nativePath(profile) || !nativePath(local) || !nativePath(home) {
+		return nil, ErrSelection
+	}
+	want := local + `\OrbWinData\home`
+	if !strings.EqualFold(home, want) {
+		return nil, ErrSelection
+	}
+	return &Selection{profile: profile, home: want, owner: owner}, nil
+}
+
+func nativePath(path string) bool {
+	if len(path) < 4 || len(path) > 1024 || path[1] != ':' || path[2] != '\\' || !((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) || strings.ContainsAny(path[2:], ":/\x00") {
+		return false
+	}
+	parts := strings.Split(path[3:], `\`)
+	if len(parts) > 32 {
+		return false
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") || strings.ContainsAny(part, `<>"|?*`) {
+			return false
+		}
+	}
+	return true
+}
