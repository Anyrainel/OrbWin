+package managementconfig
+
+// Public immutable System32 code and confidential/private cache files have
+// separate link-count requirements; both still require native kind/DACL/ID
+// checks and no-write/no-delete file-object sharing.
+func objectLinksAllowed(singleLink bool, links uint32) bool {
+	return links > 0 && (!singleLink || links == 1)
+}
