+	}
+	if windows.CloseHandle(c.thread) != nil {
+		c.unknown = true
+		peer.unknown = true
+		return c, ErrUpgrade
+	}
+	c.thread = 0
+	return c, nil
+}
+
+// Caller owns c.mu after publication in the peer. This independent native
+// observation never calls back into the old peer/recorder (avoiding cycles).
+func (c *nativeUpgradeSDKChild) checkNative() error {
+	if c == nil || c.process == 0 || c.token == 0 || c.image == 0 || !c.expected.valid() {
+		return ErrUpgrade
+	}
+	accepted := c.handoff.Load()
+	if accepted == nil && c.job == 0 {
+		return ErrUpgrade
+	}
+	state, err := windows.WaitForSingleObject(c.process, 0)
+	if err != nil || state != uint32(windows.WAIT_TIMEOUT) || c.binding.same() != nil {
+		return ErrUpgrade
+	}
+	id, err := legacySDKTokenID(c.token)
+	if err != nil || id != c.tokenID || legacySDKOrdinaryToken(c.token, c.grant.wire.Scope.SID, c.expected.Session) != nil {
+		return ErrUpgrade
+	}
+	if accepted != nil {
+		return accepted.checkNative()
+	}
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(c.process), uintptr(c.job), uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member != 1 || checkUpgradeSDKJobLimits(c.job) != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func checkUpgradeSDKJobLimits(job windows.Handle) error {
+	var limits windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION
+	if job == 0 || windows.QueryInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&limits)), uint32(unsafe.Sizeof(limits)), nil) != nil || limits.BasicLimitInformation.LimitFlags != windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Only the creator uses this assertion: first on its new unnamed empty job,
+// then with the exact suspended root returned by JOB_LIST creation. After
+// Resume, descendants may legitimately join this non-breakaway job, so neither
+// continuous ownership checks nor the serving receiver require a singleton.
+// A failed/oversized query retains the whole birth owner without resuming.
+func checkUpgradeSDKJobBirth(job windows.Handle, expected uint32) error {
+	var list struct {
+		Assigned, Count uint32
+		PID             uintptr
+	}
+	if job == 0 || windows.QueryInformationJobObject(job, windows.JobObjectBasicProcessIdList, uintptr(unsafe.Pointer(&list)), uint32(unsafe.Sizeof(list)), nil) != nil {
+		return ErrUpgrade
+	}
+	if expected == 0 {
+		if list.Assigned != 0 || list.Count != 0 {
+			return ErrUpgrade
+		}
+	} else if list.Assigned != 1 || list.Count != 1 || list.PID != uintptr(expected) {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (c *nativeUpgradeSDKChild) recheckIngressBirth(ctx context.Context) error {
+	if c == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || c.grant == nil || sid != c.grant.wire.Scope.SID {
+		return ErrUpgrade
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.unknown {
+		return ErrUpgrade
+	}
+	if c.handoff.Load() != nil {
+		return c.checkNative()
+	}
+	if c.cohort == nil {
+		return ErrUpgrade
+	}
+	// Once the initial snapshot was transferred, only the serving custodian
+	// tracks later births/compaction. TEMP's historical ledger is not current.
+	if c.cohort.transfer != nil {
+		if c.cohort.recheckHistoricalTransfer(c.cohort.transfer) != nil {
+			return ErrUpgrade
+		}
+	} else if c.cohort.observe(ctx) != nil {
+		return ErrUpgrade
+	}
+	return c.checkNative()
+}
