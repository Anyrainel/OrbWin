@@ -0,0 +1,49 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"golang.org/x/sys/windows"
+	"reflect"
+	"testing"
+)
+
+func TestUpgradeStoreGraphClosesActualOwnerLastAndStopsOnUnknown(t *testing.T) {
+	for _, kind := range []string{"success", "record", "parents", "owner"} {
+		t.Run(kind, func(t *testing.T) {
+			handles := []windows.Handle{1, 2, 3, 4}
+			var events []int
+			closeHandle := func(h windows.Handle) error {
+				events = append(events, int(h))
+				if kind == "record" && h == 3 || kind == "owner" && h == 1 {
+					return ErrUpgrade
+				}
+				return nil
+			}
+			closeParents := func() error {
+				events = append(events, 99)
+				if kind == "parents" {
+					return ErrUpgrade
+				}
+				return nil
+			}
+			err := closeUpgradeStoreGraph(handles, closeHandle, closeParents)
+			want := []int{4, 3, 2, 99, 1}
+			if kind == "record" {
+				want = []int{4, 3}
+			}
+			if kind == "parents" {
+				want = []int{4, 3, 2, 99}
+			}
+			if !reflect.DeepEqual(events, want) || (err == nil) != (kind == "success") {
+				t.Fatal("owner released before positive cleanup", events, err)
+			}
+			if kind != "success" && handles[0] != 1 {
+				t.Fatal("unknown cleanup discarded actual owner identity")
+			}
+			if kind == "success" && !reflect.DeepEqual(handles, []windows.Handle{0, 0, 0, 0}) {
+				t.Fatal("known closed numeric handles retained as live")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_tcp.go b/rdd/pkg/managementconfig/upgrade_tcp.go
new file mode 100644
index 0000000000000000000000000000000000000000..8b3a0a9853e548c871deeab21a2b600e724b69b4
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_tcp.go
@@ -0,0 +1,56 @@
+package managementconfig
+
+import "encoding/binary"
+
+// Native table observations are one part of retirement, never proof by port
+// absence alone. Held process generations, named pipes, selected WSL state,
+// admission closure and exclusive cold-file ownership remain separate gates.
+type upgradeTCPRow struct {
+	family     uint8
+	address    [16]byte
+	scope      uint32
+	port       uint16
+	pid, state uint32
+}
+
+const maxUpgradeTCPRows = 16384
+
+func parseUpgradeTCPTable(data []byte, family uint8) ([]upgradeTCPRow, error) {
+	if len(data) < 4 || len(data) > 4<<20 {
+		return nil, ErrUpgrade
+	}
+	count := uint64(binary.LittleEndian.Uint32(data))
+	size := uint64(24)
+	if family == 6 {
+		size = 56
+	} else if family != 4 {
+		return nil, ErrUpgrade
+	}
+	if count > maxUpgradeTCPRows || 4+count*size > uint64(len(data)) {
+		return nil, ErrUpgrade
+	}
+	rows := make([]upgradeTCPRow, 0, count)
+	for i := uint64(0); i < count; i++ {
+		entry := data[4+i*size : 4+(i+1)*size]
+		row := upgradeTCPRow{family: family}
+		portOffset := 8
+		if family == 4 {
+			row.state = binary.LittleEndian.Uint32(entry)
+			copy(row.address[:4], entry[4:8])
+			row.pid = binary.LittleEndian.Uint32(entry[20:24])
+		} else {
+			copy(row.address[:], entry[:16])
+			row.scope = binary.LittleEndian.Uint32(entry[16:20])
+			portOffset = 20
+			row.state = binary.LittleEndian.Uint32(entry[48:52])
+			row.pid = binary.LittleEndian.Uint32(entry[52:56])
+		}
+		// IP Helper stores the port in network-byte order in the low WORD.
+		if entry[portOffset+2] != 0 || entry[portOffset+3] != 0 {
+			return nil, ErrUpgrade
+		}
+		row.port = binary.BigEndian.Uint16(entry[portOffset : portOffset+2])
+		rows = append(rows, row)
+	}
+	return rows, nil
+}
