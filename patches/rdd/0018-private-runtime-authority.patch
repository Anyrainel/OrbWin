@@ -0,0 +1,60 @@
+package managementconfig
+
+// Closed original-control DATA. These numeric fields never construct native
+// custody; the receiver duplicates from its actual captured SDK process and
+// validates the returned object before issuing a roundtrip ACK.
+type upgradeSDKLeafMasterWire struct{ Process uint64 }
+type upgradeSDKLeafOfferWire struct {
+	Offer, Leaf uint64
+	Kind        string
+	Process     uint64
+	PID         uint32
+	Creation    uint64
+}
+type upgradeSDKLeafAckWire struct {
+	Offer, Leaf uint64
+	Kind        string
+	Process     uint64
+}
+
+func upgradeSDKLeafHandleValue(value uint64) bool {
+	return value != 0 && value != uint64(^uintptr(0)) && uint64(uintptr(value)) == value
+}
+func (v *upgradeSDKLeafOfferWire) valid() bool {
+	if v == nil || v.Offer == 0 || v.Leaf == 0 || v.PID == 0 || v.Creation == 0 {
+		return false
+	}
+	switch v.Kind {
+	case "birth", "stopped":
+		return upgradeSDKLeafHandleValue(v.Process)
+	case "closed":
+		return v.Process == 0
+	default:
+		return false
+	}
+}
+
+func (v upgradeSDKControlRequest) validPayload() bool {
+	switch v.Operation {
+	case "adopt-leaf-master":
+		return v.Supervisor == nil && v.Leaf == nil && v.Master != nil && upgradeSDKLeafHandleValue(v.Master.Process)
+	case "ack-leaf":
+		if v.Supervisor != nil || v.Master != nil || v.Leaf == nil || v.Leaf.Offer == 0 || v.Leaf.Leaf == 0 {
+			return false
+		}
+		switch v.Leaf.Kind {
+		case "birth", "stopped":
+			return upgradeSDKLeafHandleValue(v.Leaf.Process)
+		case "closed":
+			return v.Leaf.Process == 0
+		default:
+			return false
+		}
+	case "provision-supervisor":
+		return v.Master == nil && v.Leaf == nil && v.Supervisor != nil
+	case "inventory", "start-runtime", "commit", "offer-controller", "retain-controller", "keepalive", "seal-runtime", "drain-runtime", "retire":
+		return v.Supervisor == nil && v.Master == nil && v.Leaf == nil
+	default:
+		return false
+	}
+}
