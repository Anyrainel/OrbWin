+func TestUpgradeSDKFinalSlotNeverSignalsBeforePositiveWriterClose(t *testing.T) {
+	for _, failure := range []string{"", "write-flush-readback", "close-writer", "signal"} {
+		t.Run(failure, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			var events []string
+			step := func(name string) func() error {
+				return func() error {
+					events = append(events, name)
+					if failure == name {
+						return ErrUpgrade
+					}
+					return nil
+				}
+			}
+			err := finishSDKFinalSlot(ctx, step("write-flush-readback"), step("close-writer"), step("signal"))
+			want := "write-flush-readback,close-writer,signal"
+			if failure == "write-flush-readback" {
+				want = "write-flush-readback"
+			}
+			if failure == "close-writer" {
+				want = "write-flush-readback,close-writer"
+			}
+			if strings.Join(events, ",") != want || (err != nil) != (failure != "") {
+				t.Fatal("child release preceded durable/closed writer", events, err)
+			}
+		})
+	}
