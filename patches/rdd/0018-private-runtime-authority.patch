index 0000000000000000000000000000000000000000..4fa87c55116bcc1155af02c46cf6be6d46d6f8c6
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_tcp_windows.go
@@ -0,0 +1,48 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+var upgradeGetExtendedTCPTable = windows.NewLazySystemDLL("iphlpapi.dll").NewProc("GetExtendedTcpTable")
+
+func observeUpgradeTCPTable(ctx context.Context, family uint8) ([]upgradeTCPRow, error) {
+	if ctx == nil || ctx.Err() != nil || family != 4 && family != 6 {
+		return nil, ErrUpgrade
+	}
+	if upgradeGetExtendedTCPTable.Find() != nil {
+		return nil, ErrUpgrade
+	}
+	addressFamily := uint32(windows.AF_INET)
+	if family == 6 {
+		addressFamily = windows.AF_INET6
+	}
+	var size uint32
+	const ownerPIDAll = 5 // TCP_TABLE_OWNER_PID_ALL from the pinned Windows SDK.
+	code, _, _ := upgradeGetExtendedTCPTable.Call(0, uintptr(unsafe.Pointer(&size)), 0, uintptr(addressFamily), ownerPIDAll, 0)
+	if code != uintptr(windows.ERROR_INSUFFICIENT_BUFFER) || size < 4 || size > 4<<20 {
+		return nil, ErrUpgrade
+	}
+	for attempt := 0; attempt < 3; attempt++ {
+		if ctx.Err() != nil || size < 4 || size > 4<<20 {
+			return nil, ErrUpgrade
+		}
+		buffer := make([]byte, size)
+		code, _, _ = upgradeGetExtendedTCPTable.Call(uintptr(unsafe.Pointer(&buffer[0])), uintptr(unsafe.Pointer(&size)), 0, uintptr(addressFamily), ownerPIDAll, 0)
+		runtime.KeepAlive(buffer)
+		if code == uintptr(syscall.ERROR_INSUFFICIENT_BUFFER) {
+			continue
+		}
+		if code != 0 || size < 4 || size > uint32(len(buffer)) || ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		return parseUpgradeTCPTable(buffer[:size], family)
+	}
+	return nil, ErrUpgrade
+}
