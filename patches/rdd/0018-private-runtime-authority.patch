new file mode 100644
index 0000000000000000000000000000000000000000..3303508f2f2336d2728a34c00d87637540dde253
--- /dev/null
+++ b/rdd/pkg/binlinks/private_cache_windows.go
@@ -0,0 +1,41 @@
+//go:build windows
+
+package binlinks
+
+import (
+	"context"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig"
+	"os"
+	"time"
+)
+
+func linkPrivateCachedSelf(execPath, binDir string) (result error) {
+	expected, err := forwarderDigest(expectedForwarderSHA256)
+	if err != nil {
+		return err
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return errPrivateForwarder
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	lease, err := managementconfig.HoldServingForwarder(ctx, home, "orbwin", expected)
+	if lease != nil {
+		defer func() {
+			if lease.Close() != nil {
+				result = errPrivateForwarder
+			}
+		}()
+	}
+	if err != nil || lease == nil {
+		return errPrivateForwarder
+	}
+	// The native constructor binds actual self's fixed sibling. os.Executable is
+	// separately required to agree before writing the convenience command target.
+	actual, err := os.Executable()
+	if err != nil || actual != execPath {
+		return errPrivateForwarder
+	}
+	return publishPrivateSelf(execPath, binDir, expected)
+}
