+func sdkResourcesFixtureSpawnDescendant(ctx context.Context, io *upgradeSDKControlIO, image windows.Handle) (ret error) {
+	path, err := os.Executable()
+	if err != nil {
+		return err
+	}
+	app, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return err
+	}
+	line, err := windows.UTF16PtrFromString(windows.ComposeCommandLine([]string{path, "resources-descendant"}))
+	if err != nil {
+		return err
+	}
+	si := windows.StartupInfo{}
+	si.Cb = uint32(unsafe.Sizeof(si))
+	var info windows.ProcessInformation
+	err = windows.CreateProcess(app, line, nil, nil, false, windows.CREATE_SUSPENDED|windows.CREATE_NO_WINDOW, nil, nil, &si, &info)
+	// Membership is inherited from the already established job. No pipe, job,
+	// image handle or caller-specified target crosses this birth.
+	defer func() {
+		if io.unknown || io.op != nil {
+			sdkResourcesFixtureRetain(struct {
+				IO   *upgradeSDKControlIO
+				Info windows.ProcessInformation
+			}{io, info})
+			return
+		}
+		if info.Thread != 0 {
+			ret = errors.Join(ret, windows.CloseHandle(info.Thread))
+		}
+		if info.Process != 0 {
+			ret = errors.Join(ret, windows.CloseHandle(info.Process))
+		}
+	}()
+	if err != nil || info.Process == 0 || info.Thread == 0 || queryUpgradeObservedImage(info.Process, image) != nil {
+		return ErrUpgrade
+	}
+	var made, ended, kernel, user windows.Filetime
+	if windows.GetProcessTimes(info.Process, &made, &ended, &kernel, &user) != nil {
+		return ErrUpgrade
+	}
+	var observation [12]byte
+	binary.LittleEndian.PutUint32(observation[:4], info.ProcessId)
+	binary.LittleEndian.PutUint64(observation[4:], uint64(made.HighDateTime)<<32|uint64(made.LowDateTime))
+	if n, err := io.perform(ctx, observation[:], true); err != nil || n != len(observation) {
+		return ErrUpgrade
+	}
+	var request [1]byte
+	if n, err := io.perform(ctx, request[:], false); err != nil || n != 1 || request[0] != 0x53 {
+		return ErrUpgrade
+	}
+	if prior, err := windows.ResumeThread(info.Thread); err != nil || prior != 1 {
+		return ErrUpgrade
+	}
+	if n, err := io.perform(ctx, []byte{0xa6}, true); err != nil || n != 1 {
+		return ErrUpgrade
+	}
+	// Keep this actual root alive through the parent's post-resume job query.
+	if n, err := io.perform(ctx, request[:], false); err != nil || n != 1 || request[0] != 0x54 {
+		return ErrUpgrade
+	}
+	return nil
+}
