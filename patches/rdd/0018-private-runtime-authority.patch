+	size := 20 + 2*len(name)
+	words := make([]uint64, (size+7)/8)
+	b := unsafe.Slice((*byte)(unsafe.Pointer(&words[0])), len(words)*8)
+	b[0] = 1
+	*(*windows.Handle)(unsafe.Pointer(&b[8])) = parent
+	*(*uint32)(unsafe.Pointer(&b[16])) = uint32(len(name) * 2)
+	for i, v := range name {
+		*(*uint16)(unsafe.Pointer(&b[20+i*2])) = v
+	}
+	var status windows.IO_STATUS_BLOCK
+	return windows.NtSetInformationFile(file, &status, &b[0], uint32(size), 10)
+}
+
+// Last-write time may be finalized by closing the writable handle. Object/SD,
+// kind/links/size and exact bytes bind that transition; immutable admission then
+// captures the new timestamp for all later exact comparisons.
+func runtimeStorageCreatedSame(a, b runtimeStorageIdentity) bool {
+	a.written = windows.Filetime{}
+	b.written = windows.Filetime{}
+	return a == b
+}
+
+// Storage receipt only. The caller still owes actual candidate binding and a
+// durable admission journal BEFORE invoking this one-use native commit. No
+// execution/activation grant can be derived from this result or record fields.
+func (p *nativeRuntimePrepared) commitStorage() (receipt *nativeRuntimeStorageReceipt, result error) {
+	if p == nil || p.owner == nil {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	n := p.owner
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if p.consumed || n.stage == nil {
+		return nil, ErrUpgrade
+	}
+	p.consumed = true
+	expected := n.stage.identity
+	result = runtimeStorageCommitSequence(&n.attempt, func(step runtimeStorageStep) error {
+		switch step {
+		case runtimeStorageRecheck:
+			if n.checkPrevious() != nil || n.checkObject(n.stage) != nil {
+				return ErrUpgrade
+			}
+			actual, e := n.read(n.stage, false)
+			if e != nil || !bytes.Equal(actual, n.stageBody) {
+				return ErrUpgrade
+			}
+		case runtimeStorageClosePrevious:
+			if n.predecessor != nil {
+				return n.closeOne(n.predecessor.resource)
+			}
+		case runtimeStorageArmRename:
+		case runtimeStorageRename:
+			return runtimeStorageRenameFile(n.parent.resource.handle, n.stage.resource.handle)
+		case runtimeStorageCloseStage:
+			return n.closeOne(n.stage.resource)
+		case runtimeStorageOpenTarget:
+			h, e := n.open(n.parent.resource.handle, "runtime.json", false, windows.FILE_OPEN, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, nil)
+			if e != nil {
+				return ErrUpgrade
+			}
+			n.target, e = n.capture(h, false, true)
+			return e
+		case runtimeStorageVerifyTarget:
+			if n.check() != nil || n.target == nil || n.target.identity != expected {
+				return ErrUpgrade
+			}
+			body, e := n.read(n.target, false)
+			if e != nil || !bytes.Equal(body, n.stageBody) {
+				return ErrUpgrade
+			}
+			h, e := n.open(n.parent.resource.handle, "runtime.publication.stage", false, windows.FILE_OPEN, windows.FILE_READ_DATA, windows.FILE_SHARE_READ, nil)
+			if e == nil {
+				n.keep(h)
+				return ErrUpgrade
+			}
+			if e != windows.STATUS_OBJECT_NAME_NOT_FOUND {
+				return ErrUpgrade
+			}
+		}
+		return nil
+	}, n.fence)
+	if result != nil {
+		return nil, result
+	}
+	return &nativeRuntimeStorageReceipt{n, n.target, append([]byte(nil), n.stageBody...)}, nil
+}
+func (r *nativeRuntimeStorageReceipt) checkStorage() error {
+	if r == nil || r.owner == nil {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	n := r.owner
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			panic(p)
+		}
+	}()
+	if !n.attempt.complete || r.target != n.target || n.check() != nil || n.checkObject(r.target) != nil {
+		return ErrUpgrade
+	}
+	body, e := n.read(r.target, false)
+	if e != nil || !bytes.Equal(body, r.body) {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_route.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_route.go
new file mode 100644
index 0000000000000000000000000000000000000000..8377591b999095b57df9adf24f7045b3057ec53e
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_route.go
@@ -0,0 +1,53 @@
+package managementconfig
+
+// Successful native observations only. These values cannot issue storage
+// authority; the Windows coordinator additionally owns every actual handle.
+type runtimeStorageRouteFacts struct {
+	strict, traversalSafe, protected bool
+	descriptor                       [32]byte // hash of the SAME native SD buffer parsed for these facts
+}
+
+func runtimeStorageRouteDescriptorMatches(facts runtimeStorageRouteFacts, measured [32]byte) bool {
+	return facts.descriptor == measured
+}
+
+// Native constructor ordering only. Neither callback nor successful result is
+// retained as authority; the caller must already own the actual native graph.
+func runtimeStorageRouteBeforeController(check, open func() error) error {
+	if check == nil || open == nil {
+		return ErrUpgrade
+	}
+	if e := check(); e != nil {
+		return e
+	}
+	return open()
+}
+
+// Every selected edge must be checked before the conditional boundary rule is
+// evaluated. No controller/create callback is accepted here. Inspection errors
+// never mean "unsafe ancestor that a protected leaf can compensate for".
+func runtimeStorageRouteSequence(count int, inspect func(int) (runtimeStorageRouteFacts, error), edge func(int) error) error {
+	if count < 2 || count > 256 || inspect == nil || edge == nil {
+		return ErrUpgrade
+	}
+	needsProtected := false
+	for i := 0; i < count; i++ {
+		facts, e := inspect(i)
+		if e != nil {
+			return e
+		}
+		if i > 0 {
+			if e = edge(i); e != nil {
+				return e
+			}
+		}
+		if i == count-1 {
+			if !facts.strict || (needsProtected && !facts.protected) {
+				return ErrUpgrade
+			}
+		} else if !facts.traversalSafe {
+			needsProtected = true
+		}
+	}
+	return nil
+}
