index 0000000000000000000000000000000000000000..a1ce43500a73c7797905ba40aec56df847974ede
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_build_origin_windows.go
@@ -0,0 +1,359 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"runtime"
+	"sync"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/version"
+	"golang.org/x/sys/windows"
+)
+
+// Build provenance only, not a publisher/observer issuer. It owns independent
+// duplicates of the real serving lease graph plus actual self process/image
+// observation caps. A retained Go pointer alone is not native file ownership.
+type nativeRuntimeBuildOrigin struct {
+	mu                  sync.Mutex
+	storage             *nativeRuntimeStorage
+	lease               *ServingImageLease
+	resources           []*runtimeStorageResource
+	objects             []*runtimeStorageObject
+	process, image      *runtimeStorageResource
+	binding             upgradeObservedImageBinding
+	generation          UpgradeProcess
+	leased              ConfigVersion
+	transaction, commit string
+	unknown, closed     bool
+	closeAttempt        runtimeStorageCloseAttempt
+}
+
+var runtimeBuildOrigins = struct {
+	sync.Mutex
+	owners map[*nativeRuntimeBuildOrigin]bool
+}{owners: make(map[*nativeRuntimeBuildOrigin]bool)}
+
+func (*nativeRuntimeBuildOrigin) String() string   { return "mapped incoming self build origin" }
+func (*nativeRuntimeBuildOrigin) GoString() string { return "mapped incoming self build origin" }
+
+// Caller holds origin.mu (or construction is unpublished). Never write
+// storage.unknown without storage.mu. The shared short domain fence causes its
+// own Close/admission paths to retain the actual storage graph as well.
+func (o *nativeRuntimeBuildOrigin) fence() {
+	o.unknown = true
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.owners[o.storage] = true
+	runtimeStorageDomain.Unlock()
+	runtimeBuildOrigins.Lock()
+	runtimeBuildOrigins.owners[o] = true
+	runtimeBuildOrigins.Unlock()
+}
+func (o *nativeRuntimeBuildOrigin) keep(h windows.Handle) *runtimeStorageResource {
+	r := &runtimeStorageResource{handle: h}
+	o.resources = append(o.resources, r)
+	return r
+}
+func (o *nativeRuntimeBuildOrigin) openReply(h windows.Handle, err error) (windows.Handle, error) {
+	err = runtimeStorageOpenReply(err, h != 0 && h != windows.InvalidHandle, func() { o.keep(h) }, o.fence)
+	if err != nil {
+		return 0, err
+	}
+	return h, nil
+}
+func (o *nativeRuntimeBuildOrigin) capture(h windows.Handle, directory, private, traversal bool) (*runtimeStorageObject, error) {
+	r := o.keep(h)
+	id, err := runtimeStorageIdentityOf(h, o.storage.sid, directory, private, traversal)
+	if err != nil {
+		return nil, err
+	}
+	object := &runtimeStorageObject{r, id, directory, private, traversal}
+	o.objects = append(o.objects, object)
+	return object, nil
+}
+func runtimeBuildGeneration(h windows.Handle, image [32]byte) (UpgradeProcess, error) {
+	pid, err := windows.GetProcessId(h)
+	var session uint32
+	var created, exit, kernel, user windows.Filetime
+	if err != nil || pid != windows.GetCurrentProcessId() || windows.ProcessIdToSessionId(pid, &session) != nil || session == 0 || windows.GetProcessTimes(h, &created, &exit, &kernel, &user) != nil {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	p := UpgradeProcess{pid, uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), session, image}
+	if !p.valid() {
+		return UpgradeProcess{}, ErrUpgrade
+	}
+	return p, nil
+}
+func runtimeBuildHash(ctx context.Context, h windows.Handle) ([32]byte, error) {
+	var zero [32]byte
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > 512<<20 {
+		return zero, ErrUpgrade
+	}
+	if _, err := windows.Seek(h, 0, 0); err != nil {
+		return zero, ErrUpgrade
+	}
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total uint64
+	for {
+		if ctx.Err() != nil {
+			return zero, ErrUpgrade
+		}
+		var got uint32
+		err := windows.ReadFile(h, buffer, &got, nil)
+		if got > uint32(len(buffer)) {
+			return zero, ErrUpgrade
+		}
+		total += uint64(got)
+		if total > uint64(info.FileSizeLow) {
+			return zero, ErrUpgrade
+		}
+		if got > 0 {
+			_, _ = hash.Write(buffer[:got])
+		}
+		if err == windows.ERROR_HANDLE_EOF || err == nil && got == 0 {
+			break
+		}
+		if err != nil {
+			return zero, ErrUpgrade
+		}
+	}
+	if total != uint64(info.FileSizeLow) {
+		return zero, ErrUpgrade
+	}
+	copy(zero[:], hash.Sum(nil))
+	return zero, nil
+}
+
+// Fixed native source only. No sourceCommit/path/handle setter exists. The
+// executing binary's linked commit is useful ONLY after class44 proves that
+// exact executing generation maps the independently pinned incoming FILE_OBJECT.
+func captureRuntimeBuildOrigin(ctx context.Context, n *nativeRuntimeStorage, l *ServingImageLease, j upgradeJournal) (out *nativeRuntimeBuildOrigin, result error) {
+	if ctx == nil || ctx.Err() != nil || n == nil || l == nil || !j.valid() {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	o := &nativeRuntimeBuildOrigin{storage: n, lease: l, transaction: j.Transaction}
+	runtimeBuildOrigins.Lock()
+	if len(runtimeBuildOrigins.owners) >= 16 {
+		runtimeBuildOrigins.Unlock()
+		return nil, ErrUpgrade
+	}
+	for held := range runtimeBuildOrigins.owners {
+		if held.storage == n {
+			runtimeBuildOrigins.Unlock()
+			return nil, ErrUpgrade
+		}
+	}
+	runtimeBuildOrigins.owners[o] = true
+	runtimeBuildOrigins.Unlock()
+	defer func() {
+		if p := recover(); p != nil {
+			o.mu.Lock()
+			o.fence()
+			o.mu.Unlock()
+			panic(p)
+		}
+		if result != nil && o.Close() != nil {
+			out = o
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	// Global order: candidate.operation (future binder) -> origin.mu ->
+	// storage.mu -> lease.mu. No storage/lease callback enters this origin.
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if runtimeBuildSourceLeaseState(l.closed, l.err, o.fence) != nil || n.check() != nil || len(l.chain) < 3 || !l.image.Present || l.image.Hash != j.Incoming {
+		return nil, ErrUpgrade
+	}
+	o.leased = l.image
+	_, profileParts, err := readerComponents(n.profile)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	result = runtimeBuildOriginSequence(func(step runtimeBuildOriginStep) error {
+		switch step {
+		case runtimeBuildDuplicateLease:
+			for i, source := range l.chain {
+				var h windows.Handle
+				err := windows.DuplicateHandle(windows.CurrentProcess(), source, windows.CurrentProcess(), &h, 0, false, windows.DUPLICATE_SAME_ACCESS)
+				h, err = o.openReply(h, err)
+				if err != nil {
+					return err
+				}
+				directory := i < len(l.chain)-1
+				private := i > len(profileParts)
+				if _, err = o.capture(h, directory, private, directory && !private); err != nil {
+					return err
+				}
+			}
+			file := o.objects[len(o.objects)-1]
+			if file.identity.volume != l.image.Volume || file.identity.high != l.image.High || file.identity.low != l.image.Low {
+				return ErrUpgrade
+			}
+			actual, err := runtimeBuildHash(ctx, file.resource.handle)
+			if err != nil || actual != j.Incoming {
+				return ErrUpgrade
+			}
+		case runtimeBuildHoldSelfProcess:
+			var h windows.Handle
+			err := windows.DuplicateHandle(windows.CurrentProcess(), windows.CurrentProcess(), windows.CurrentProcess(), &h, windows.PROCESS_QUERY_INFORMATION|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, 0)
+			h, err = o.openReply(h, err)
+			if err != nil {
+				return err
+			}
+			o.process = o.keep(h)
+			o.generation, err = runtimeBuildGeneration(h, j.Incoming)
+			return err
+		case runtimeBuildOpenSelfImage:
+			parent := o.objects[len(o.objects)-2]
+			h, err := openUpgradeObservedImageFile(parent.resource.handle, "rdd.exe")
+			h, err = o.openReply(h, err)
+			if err != nil {
+				return err
+			}
+			observed, err := o.capture(h, false, true, false)
+			if err != nil {
+				return err
+			}
+			o.image = observed.resource
+			leased := o.objects[len(o.objects)-2]
+			if observed.identity != leased.identity {
+				return ErrUpgrade
+			}
+		case runtimeBuildCaptureMapping:
+			return o.binding.capture(o.process.handle, o.image.handle)
+		case runtimeBuildCaptureCommit:
+			if !upgradeHex(version.GitCommit, 40) {
+				return ErrUpgrade
+			}
+			o.commit = version.GitCommit
+		case runtimeBuildVerify:
+			return o.checkNativeHeld(ctx, j)
+		}
+		return nil
+	})
+	if result != nil {
+		return nil, result
+	}
+	return o, nil
+}
+
+// Caller holds origin.mu, storage.mu, lease.mu in that order and is bound to
+// its current OS thread. Construction uses this form while already holding all
+// three locks. Nothing calls back into a candidate or another origin.
+func (o *nativeRuntimeBuildOrigin) checkNativeHeld(ctx context.Context, j upgradeJournal) error {
+	if ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	if runtimeBuildSourceLeaseState(o.lease.closed, o.lease.err, o.fence) != nil || o.unknown || o.closed || o.storage.check() != nil || o.lease.image != o.leased || j.Transaction != o.transaction || !j.valid() || j.Incoming != o.leased.Hash || !upgradeHex(o.commit, 40) || version.GitCommit != o.commit || o.process == nil || o.image == nil {
+		return ErrUpgrade
+	}
+	for _, object := range o.objects {
+		id, err := runtimeStorageIdentityOf(object.resource.handle, o.storage.sid, object.directory, object.private, object.traversal)
+		if err != nil || id != object.identity {
+			return ErrUpgrade
+		}
+	}
+	generation, err := runtimeBuildGeneration(o.process.handle, j.Incoming)
+	if err != nil || generation != o.generation || o.binding.same() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+// Caller owns origin.mu ONLY; this method acquires storage.mu then lease.mu
+// internally and releases those two before returning. The concrete publisher
+// keeps origin.mu across its subsequent real storage operations, which acquire
+// storage.mu themselves. Never call this while holding storage.mu or lease.mu.
+func (o *nativeRuntimeBuildOrigin) checkHeld(ctx context.Context, j upgradeJournal) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if p := recover(); p != nil {
+			o.fence()
+			panic(p)
+		}
+	}()
+	o.storage.mu.Lock()
+	defer o.storage.mu.Unlock()
+	o.lease.mu.Lock()
+	defer o.lease.mu.Unlock()
+	return o.checkNativeHeld(ctx, j)
+}
+
+func (o *nativeRuntimeBuildOrigin) check(ctx context.Context, j upgradeJournal) error {
+	if o == nil || o.storage == nil || o.lease == nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.checkHeld(ctx, j)
+}
+
+// The value is immutable after construction; this getter returns DATA after a
+// real check. It is not an effect lifetime: publishers use checkHeld with the
+// origin mutex held across the real native publication instead.
+func (o *nativeRuntimeBuildOrigin) sourceCommit(ctx context.Context, j upgradeJournal) (string, error) {
+	if o.check(ctx, j) != nil {
+		return "", ErrUpgrade
+	}
+	return o.commit, nil
+}
+
+// The original ServingImageLease belongs to its original owner. Close only
+// this dedicated duplicated graph; never invoke its continue-on-error Close.
+// The future binder closes this graph BEFORE releasing storage's controller.
+func (o *nativeRuntimeBuildOrigin) Close() error {
+	if o == nil {
+		return nil
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	// Known source closure does not prevent releasing our own independent caps;
+	// an observed source close error must quarantine them even if check was not
+	// called between that error and this release attempt.
+	if o.lease != nil {
+		o.lease.mu.Lock()
+		sourceErr := runtimeBuildSourceLeaseState(false, o.lease.err, o.fence)
+		o.lease.mu.Unlock()
+		if sourceErr != nil {
+			return sourceErr
+		}
+	}
+	if o.unknown || !runtimeStorageDomainKnown() {
+		o.fence()
+		return ErrUpgrade
+	}
+	err := runtimeBuildOriginRelease(&o.closeAttempt, len(o.resources), func(i int) error {
+		r := o.resources[i]
+		return r.run(func() error {
+			if r.handle == 0 || windows.CloseHandle(r.handle) != nil {
+				return ErrUpgrade
+			}
+			r.handle = 0
+			return nil
+		}, o.fence)
+	}, o.fence)
+	if err != nil {
+		return err
+	}
+	o.closed = true
+	runtimeBuildOrigins.Lock()
+	delete(runtimeBuildOrigins.owners, o)
+	runtimeBuildOrigins.Unlock()
+	return nil
+}
