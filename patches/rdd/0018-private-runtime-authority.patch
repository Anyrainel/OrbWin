diff --git a/rdd/pkg/managementconfig/serving_image_windows.go b/rdd/pkg/managementconfig/serving_image_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..6fea2166f808f963e3d5c201521435cb95425e01
--- /dev/null
+++ b/rdd/pkg/managementconfig/serving_image_windows.go
@@ -0,0 +1,217 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"strings"
+	"sync"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/authoritypath"
+	"golang.org/x/sys/windows"
+)
+
+type ServingImageLease struct {
+	mu     sync.Mutex
+	chain  []windows.Handle
+	image  ConfigVersion
+	closed bool
+	err    error
+}
+
+func (*ServingImageLease) String() string   { return "private serving image lease" }
+func (*ServingImageLease) GoString() string { return "private serving image lease" }
+func (l *ServingImageLease) Image() ConfigVersion {
+	if l == nil {
+		return ConfigVersion{}
+	}
+	return l.image
+}
+func (l *ServingImageLease) Close() error {
+	if l == nil {
+		return nil
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return l.err
+	}
+	l.closed = true
+	for i := len(l.chain) - 1; i >= 0; i-- {
+		h := l.chain[i]
+		l.chain[i] = 0
+		if windows.CloseHandle(h) != nil {
+			l.err = ErrCreate
+		}
+	}
+	l.chain = nil
+	return l.err
+}
+
+func servingImageDigest(profile, image string) ([32]byte, error) {
+	var digest [32]byte
+	if _, _, err := readerComponents(profile + `\placeholder`); err != nil {
+		return digest, ErrCreate
+	}
+	if _, _, err := readerComponents(image); err != nil {
+		return digest, ErrCreate
+	}
+	prefix := profile + `\.orbwin-private\runtime\rdd-`
+	if len(image) != len(prefix)+64+len(`\rdd.exe`) || !strings.EqualFold(image[:len(prefix)], prefix) || !strings.EqualFold(image[len(prefix)+64:], `\rdd.exe`) {
+		return digest, ErrCreate
+	}
+	text := image[len(prefix) : len(prefix)+64]
+	decoded, err := hex.DecodeString(text)
+	if err != nil || hex.EncodeToString(decoded) != text || len(decoded) != 32 {
+		return digest, ErrCreate
+	}
+	copy(digest[:], decoded)
+	if digest == [32]byte{} {
+		return digest, ErrCreate
+	}
+	return digest, nil
+}
+
+// Root's independently pinned launcher authenticates the expected binary. This
+// constructor pins actual self bytes and the exact private native cache layout;
+// it never trusts a colocated mutable manifest or claims code signing.
+func HoldServingImage(ctx context.Context, home, suffix string) (*ServingImageLease, error) {
+	return holdServingFile(ctx, home, suffix, nil)
+}
+
+// HoldServingForwarder binds the sole fixed sibling to an independently compiled
+// digest. It holds the same private ancestor and no-write/no-delete file policy.
+func HoldServingForwarder(ctx context.Context, home, suffix string, expected [32]byte) (*ServingImageLease, error) {
+	if expected == [32]byte{} {
+		return nil, ErrCreate
+	}
+	return holdServingFile(ctx, home, suffix, &expected)
+}
+
+func holdServingFile(ctx context.Context, home, suffix string, forwarder *[32]byte) (lease *ServingImageLease, result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	selection, err := authoritypath.Current(home, suffix)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != selection.Owner() {
+		return nil, ErrCreate
+	}
+	var imagePath [1024]uint16
+	size := uint32(len(imagePath))
+	if windows.QueryFullProcessImageName(windows.CurrentProcess(), 0, &imagePath[0], &size) != nil || size == 0 || size >= uint32(len(imagePath)) {
+		return nil, ErrCreate
+	}
+	path := windows.UTF16ToString(imagePath[:size])
+	expected, err := servingImageDigest(selection.Profile(), path)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	limit := uint32(512 << 20)
+	if forwarder != nil {
+		path = path[:len(path)-len("rdd.exe")] + "rdd-forwarder.exe"
+		expected = *forwarder
+		limit = 4 << 20
+	}
+	volume, parts, err := readerComponents(path)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	_, profileParts, err := readerComponents(selection.Profile())
+	if err != nil {
+		return nil, ErrCreate
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, ErrCreate
+	}
+	l := &ServingImageLease{chain: []windows.Handle{h}}
+	ok := false
+	defer func() {
+		if !ok {
+			if l.Close() != nil {
+				lease = l
+			}
+			result = ErrCreate
+		}
+	}()
+	if checkReadObject(h, sid, true) != nil {
+		return nil, ErrCreate
+	}
+	for index, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrCreate
+		}
+		directory := index < len(parts)-1
+		next, e := openRelative(l.chain[len(l.chain)-1], part, directory, nil, false)
+		if e != nil {
+			return nil, ErrCreate
+		}
+		l.chain = append(l.chain, next)
+		if directory {
+			if checkReadObject(next, sid, true) != nil {
+				return nil, ErrCreate
+			}
+			if index >= len(profileParts) && verifyPrivate(next, sid, true) != nil {
+				return nil, ErrCreate
+			}
+		} else if verifyPrivate(next, sid, false) != nil {
+			return nil, ErrCreate
+		}
+	}
+	image := l.chain[len(l.chain)-1]
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(image, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow < 1 || info.FileSizeLow > limit {
+		return nil, ErrCreate
+	}
+	// Hash through the sole owned synchronous native handle. No duplicate/os.File
+	// can escape the lease graph on an uncertain Close.
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total uint64
+	for {
+		if ctx.Err() != nil {
+			return nil, ErrCreate
+		}
+		var n uint32
+		e := windows.ReadFile(image, buffer, &n, nil)
+		total += uint64(n)
+		if total > uint64(limit) {
+			return nil, ErrCreate
+		}
+		if n > 0 {
+			_, _ = hash.Write(buffer[:n])
+		}
+		if e == windows.ERROR_HANDLE_EOF || e == nil && n == 0 {
+			break
+		}
+		if e != nil {
+			return nil, ErrCreate
+		}
+	}
+	var actual [32]byte
+	copy(actual[:], hash.Sum(nil))
+	if actual != expected || total != uint64(info.FileSizeLow) || ctx.Err() != nil {
+		return nil, ErrCreate
+	}
+	var final [1024]uint16
+	length, e := windows.GetFinalPathNameByHandle(image, &final[0], uint32(len(final)), 0)
+	if e != nil || length == 0 || length >= uint32(len(final)) || !strings.EqualFold(strings.TrimPrefix(windows.UTF16ToString(final[:length]), `\\?\`), path) {
+		return nil, ErrCreate
+	}
+	l.image = ConfigVersion{true, info.VolumeSerialNumber, info.FileIndexHigh, info.FileIndexLow, actual}
+	ok = true
+	return l, nil
+}
