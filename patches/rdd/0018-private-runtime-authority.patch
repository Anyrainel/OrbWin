@@ -0,0 +1,101 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestUpgradeSDKJoinedSourceCallbackProgressCannotMintNativeParticipant(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	o := &nativeUpgradeSDKServingOwner{}
+	if drainUpgradeSDKRuntime(ctx, func(_ context.Context, operation string) (string, error) {
+		if operation == "seal-runtime" {
+			return "runtime-draining", nil
+		}
+		return "runtime-joined", nil
+	}) != nil {
+		t.Fatal("synthetic DATA progress")
+	}
+	if o.joinedSource != nil {
+		t.Fatal("callback created native participant")
+	}
+	if resource, err := o.captureResources(ctx, nil); resource != nil || err == nil || o.resources != nil {
+		t.Fatal("callback progress admitted resources")
+	}
+}
+
+func TestUpgradeSDKJoinedSourceCopyAndForeignOwnerRefuseBeforeNativeUse(t *testing.T) {
+	o := &nativeUpgradeSDKServingOwner{}
+	s := &nativeUpgradeSDKJoinedSource{owner: o}
+	s.self = s
+	o.joinedSource = s
+	copy := *s
+	if copy.bindingLocked() == nil {
+		t.Fatal("copied participant accepted")
+	}
+	foreign := &nativeUpgradeSDKServingOwner{joinedSource: s}
+	s.owner = foreign
+	if s.bindingLocked() == nil {
+		t.Fatal("foreign actual owner accepted")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if s.checkBeforeRetire(ctx) == nil {
+		t.Fatal("inert source became native grant")
+	}
+}
+
+func TestUpgradeSDKMissingRetirementSupportDoesNotConsumeCloseOrStopPump(t *testing.T) {
+	done := make(chan struct{})
+	close(done)
+	stop := make(chan struct{})
+	o := &nativeUpgradeSDKServingOwner{supervisorReady: true, bootstrapDone: done, heartbeatStop: stop, heartbeatDone: make(chan struct{}), controllers: [4]windows.Handle{1, 2, 3, 4}}
+	// Inert handle values are never queried: known missing source/cohort support
+	// must refuse before any native check or close/body effect.
+	for i := 0; i < 2; i++ {
+		if o.close() == nil || o.closeAttempted || o.closed || o.unknown || o.heartbeatStopped || o.joinedSource != nil || o.resources != nil {
+			t.Fatal("known no-effect refusal consumed operation", i)
+		}
+		select {
+		case <-stop:
+			t.Fatal("sole pump stopped before support admission")
+		default:
+		}
+	}
+}
+
+func TestUpgradeSDKJoinedSourceRequiresActualHeartbeatCompletionBeforeSeal(t *testing.T) {
+	o := &nativeUpgradeSDKServingOwner{closeAttempted: true, heartbeatStopped: true, heartbeatDone: make(chan struct{})}
+	r := &nativeUpgradeSDKLeafReceiver{owner: o, ready: true}
+	r.self = r
+	o.leaves = r
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if s, err := o.drainNativeRuntimeSource(ctx); s != nil || err == nil || o.joinedSource != nil || o.sequence != 0 || o.unknown {
+		t.Fatal("unjoined heartbeat admitted seal bytes or participant")
+	}
+}
+
+func TestUpgradeSDKFinalRetireCannotConsumeSequenceFromMissingOrCopiedSource(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	o := &nativeUpgradeSDKServingOwner{control: 101, io: &upgradeSDKControlIO{pipe: 101}, sequence: 7}
+	o.protocol.Lock()
+	defer o.protocol.Unlock()
+	if _, err := o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "retire"}); err == nil || o.sequence != 7 {
+		t.Fatal("missing source consumed final frame sequence")
+	}
+	s := &nativeUpgradeSDKJoinedSource{owner: o, complete: true, sequence: 7}
+	s.self = s
+	copy := *s
+	o.joinedSource = &copy
+	if _, err := o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: "retire"}); err == nil || o.sequence != 7 {
+		t.Fatal("copied source consumed final frame sequence")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_launch_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_launch_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..1abf07a98b3def2faa2828c0ca5444afeaccf2d2
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_launch_windows.go
@@ -0,0 +1,263 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"unsafe"
+)
+
+// No generic PID/path/hash constructor. Only startSDK below owns these native
+// process/thread/job objects returned by its own exact fixed-image creation.
+// The temporary owner has NO Close method: healthy SDK lifetime must first move
+// to a positively accepted serving candidate, retaining the same job/control.
+type nativeUpgradeSDKChild struct {
+	mu                          sync.Mutex
+	grant                       *nativeUpgradeSDKGrant
+	process, thread, job, image windows.Handle
+	token                       windows.Token
+	tokenID                     windows.LUID
+	expected                    UpgradeProcess
+	binding                     upgradeObservedImageBinding
+	control                     *upgradeSDKControlIO
+	unknown                     bool
+	protocol                    sync.Mutex
+	sequence                    uint32
+	controlOffered              bool // protocol lock; one-way before native inheritance
+	handoff                     atomic.Pointer[nativeUpgradeSDKHandoff]
+	cohort                      *nativeUpgradeSDKCohort
+}
+
+// Windows SDK winbase.h ProcThreadAttributeJobList=13, attribute input bit.
+// https://learn.microsoft.com/windows/desktop/api/processthreadsapi/nf-processthreadsapi-updateprocthreadattribute
+const upgradeSDKJobListAttribute = 0x0002000d
+
+func (g *nativeUpgradeSDKGrant) startSDK(ctx context.Context) (*nativeUpgradeSDKChild, error) {
+	if g == nil || g.birth == nil || g.birth.check(ctx) != nil || g.recheckBeforeLaunch(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.launchAttempted || g.unknown || !g.issued || g.child != nil {
+		return nil, ErrUpgrade
+	}
+	g.launchAttempted = true
+	c := &nativeUpgradeSDKChild{grant: g, unknown: true, control: &upgradeSDKControlIO{pipe: g.controlClient}}
+	g.child = c
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	g.image.mu.Lock()
+	defer g.image.mu.Unlock()
+	if g.image.recheckLocked(ctx) != nil {
+		return c, ErrUpgrade
+	}
+	sid, err := currentOwner()
+	if err != nil || sid != g.wire.Scope.SID {
+		return c, ErrUpgrade
+	}
+	c.job, err = windows.CreateJobObject(nil, nil)
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	limits := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}
+	limits.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+	configured, configureErr := windows.SetInformationJobObject(c.job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&limits)), uint32(unsafe.Sizeof(limits)))
+	if configureErr != nil || configured == 0 || checkUpgradeSDKJobLimits(c.job) != nil || checkUpgradeSDKJobBirth(c.job, 0) != nil {
+		return c, ErrUpgrade
+	}
+	c.cohort, err = newNativeUpgradeSDKCohort(ctx, c)
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	handles := []windows.Handle{g.inherited[3], windows.Handle(g.wire.LegacyRoot), windows.Handle(g.wire.Controller), windows.Handle(g.wire.Denial), windows.Handle(g.wire.Final.File), windows.Handle(g.wire.Final.Event), windows.Handle(g.wire.Processes[0].Process), windows.Handle(g.wire.Processes[0].Token), windows.Handle(g.wire.Processes[0].Image), g.controlServer}
+	attributes, err := windows.NewProcThreadAttributeList(2)
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	defer attributes.Delete()
+	jobs := []windows.Handle{c.job}
+	if attributes.Update(windows.PROC_THREAD_ATTRIBUTE_HANDLE_LIST, unsafe.Pointer(&handles[0]), uintptr(len(handles))*unsafe.Sizeof(handles[0])) != nil || attributes.Update(upgradeSDKJobListAttribute, unsafe.Pointer(&jobs[0]), unsafe.Sizeof(jobs[0])) != nil {
+		return c, ErrUpgrade
+	}
+	application, err := windows.UTF16PtrFromString(g.image.path)
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	command, err := windows.UTF16PtrFromString(windows.ComposeCommandLine([]string{g.image.path, "local-services-cold", strconv.FormatUint(uint64(g.inherited[3]), 10)}))
+	if err != nil {
+		return c, ErrUpgrade
+	}
+	startup := windows.StartupInfoEx{ProcThreadAttributeList: attributes.List()}
+	startup.Cb = uint32(unsafe.Sizeof(startup))
+	var process windows.ProcessInformation
+	// Job assignment is part of creation, not AssignProcess after an unowned
+	// child starts. The initial thread stays suspended until positive native
+	// membership/image/token checks and original pipe reservation transfer.
+	err = windows.CreateProcess(application, command, nil, nil, true, windows.CREATE_SUSPENDED|windows.CREATE_NO_WINDOW|windows.EXTENDED_STARTUPINFO_PRESENT, nil, nil, &startup.StartupInfo, &process)
+	runtime.KeepAlive(handles)
+	runtime.KeepAlive(jobs)
+	c.process, c.thread = process.Process, process.Thread // Preserve partial native returns.
+	if err != nil || c.process == 0 || c.thread == 0 {
+		return c, ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	var session uint32
+	if windows.GetProcessTimes(c.process, &created, &exited, &kernel, &user) != nil || windows.ProcessIdToSessionId(process.ProcessId, &session) != nil || session != g.wire.Parent.Session {
+		return c, ErrUpgrade
+	}
+	c.expected = UpgradeProcess{process.ProcessId, uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), session, g.image.pins.files[0]}
