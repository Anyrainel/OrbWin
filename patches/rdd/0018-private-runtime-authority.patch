@@ -0,0 +1,28 @@
+package managementconfig
+
+import (
+	"context"
+	"fmt"
+)
+
+// A temporary owner's outer job may kill healthy descendants after handoff.
+// Initial supported birth therefore requires positively observed no-job scope;
+// no breakaway permission or outer-job survivability is assumed or weakened.
+var ErrUpgradeJobbed = fmt.Errorf("%w: cold upgrade owner is inside an unsupported outer Windows job", ErrUpgrade)
+
+func requireUpgradeNoOuterJob(ctx context.Context, query func() (bool, error)) error {
+	if ctx == nil || ctx.Err() != nil || query == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	member, err := query()
+	if err != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if member {
+		return ErrUpgradeJobbed
+	}
+	return nil
+}
