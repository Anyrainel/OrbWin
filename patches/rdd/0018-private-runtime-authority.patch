+			if e != nil || !bytes.Equal(actual, body) {
+				return ErrUpgrade
+			}
+			expected = writer.identity
+		case runtimeStorageCloseWriter:
+			return n.closeOne(writer.resource)
+		case runtimeStorageAdmitStage:
+			h, e := n.open(n.parent.resource.handle, "runtime.publication.stage", false, windows.FILE_OPEN, windows.FILE_READ_DATA|windows.DELETE, windows.FILE_SHARE_READ, nil)
