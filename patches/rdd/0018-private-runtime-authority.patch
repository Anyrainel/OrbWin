+func sdkResourcesFixtureChild(args []string) (ret error) {
+	if len(args) == 1 && args[0] == "resources-descendant" {
+		// No inherited pipe/job handles or ambient targets. Independently bounded.
+		time.Sleep(15 * time.Second)
+		return nil
+	}
+	if len(args) != 3 || args[0] != "resources-child" {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	var server, image, parent windows.Handle
+	var io *upgradeSDKControlIO
+	defer func() {
+		if io != nil && (io.unknown || io.op != nil) {
+			sdkResourcesFixtureRetain(struct {
+				IO      *upgradeSDKControlIO
+				Handles []windows.Handle
+			}{io, []windows.Handle{server, image, parent}})
+			return
+		}
+		for _, h := range []windows.Handle{server, image, parent} {
+			if h != 0 {
+				if err := windows.CloseHandle(h); err != nil {
+					ret = errors.Join(ret, err)
+					sdkResourcesFixtureRetain(struct {
+						IO      *upgradeSDKControlIO
+						Handles []windows.Handle
+					}{io, []windows.Handle{server, image, parent}})
+					return
+				}
+			}
+		}
+	}()
+	server, err := sdkResourcesFixtureInherited(args[1])
+	if err != nil {
+		return err
+	}
+	image, err = sdkResourcesFixtureInherited(args[2])
+	if err != nil {
+		return err
+	}
+	if server == image || queryUpgradeObservedImage(windows.CurrentProcess(), image) != nil {
+		return ErrUpgrade
+	}
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(windows.CurrentProcess(), 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || basic.InheritedFromUniqueProcessId == 0 {
+		return ErrUpgrade
+	}
+	parent, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, false, uint32(basic.InheritedFromUniqueProcessId))
+	if err != nil {
+		return err
+	}
+	if queryUpgradeObservedImage(parent, image) != nil {
+		return ErrUpgrade
+	}
+	var parentSID string
+	parentToken, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		return err
+	}
+	user, err := parentToken.GetTokenUser()
+	if err == nil {
+		parentSID = user.User.Sid.String()
+	}
+	tokenErr := parentToken.Close()
+	if err != nil || tokenErr != nil || verifySDKControlDACL(server, parentSID) != nil {
+		return ErrUpgrade
+	}
+	var clientPID uint32
+	if windows.GetNamedPipeClientProcessId(server, &clientPID) != nil || clientPID != uint32(basic.InheritedFromUniqueProcessId) {
+		return ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	io = &upgradeSDKControlIO{pipe: server}
+	var request [1]byte
+	if n, err := io.perform(ctx, request[:], false); err != nil || n != 1 || request[0] != 0x52 {
+		return ErrUpgrade
+	}
+	if n, err := io.perform(ctx, []byte{0xa5}, true); err != nil || n != 1 {
+		return ErrUpgrade
+	}
+	return sdkResourcesFixtureSpawnDescendant(ctx, io, image)
+}
+
+func sdkResourcesFixtureObserveDescendant(process, image, job windows.Handle, parent UpgradeProcess, creation uint64, sid string) error {
+	if process == 0 || creation <= parent.Creation || queryUpgradeObservedImage(process, image) != nil {
+		return ErrUpgrade
+	}
+	var basic windows.PROCESS_BASIC_INFORMATION
+	var size uint32
+	if windows.NtQueryInformationProcess(process, 0, unsafe.Pointer(&basic), uint32(unsafe.Sizeof(basic)), &size) != nil || size != uint32(unsafe.Sizeof(basic)) || basic.InheritedFromUniqueProcessId != uintptr(parent.PID) {
+		return ErrUpgrade
+	}
+	var made, ended, kernel, user windows.Filetime
+	if windows.GetProcessTimes(process, &made, &ended, &kernel, &user) != nil || uint64(made.HighDateTime)<<32|uint64(made.LowDateTime) != creation {
+		return ErrUpgrade
+	}
+	var member uint32
+	status, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(process), uintptr(job), uintptr(unsafe.Pointer(&member)))
+	if status == 0 || member != 1 {
+		return ErrUpgrade
+	}
+	pid, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(process))
+	var session uint32
+	var token windows.Token
+	if windows.ProcessIdToSessionId(uint32(pid), &session) != nil || session != parent.Session || windows.OpenProcessToken(process, windows.TOKEN_QUERY, &token) != nil {
+		return ErrUpgrade
+	}
+	check := legacySDKOrdinaryToken(token, sid, session)
+	return errors.Join(check, token.Close())
+}
