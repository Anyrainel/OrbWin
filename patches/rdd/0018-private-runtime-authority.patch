@@ -0,0 +1,114 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func runtimeRecordFixture() runtimeIdentityRecord {
+	return runtimeIdentityRecord{runtimeIdentityEndpoint, `C:\Users\synthetic\AppData\Local\OrbWinData\home`, "synthetic-daemon", strings.Repeat("a", 40), strings.Repeat("b", 64), true}
+}
+
+func TestRuntimeIdentityRecordLegacyCompatibilityAndClosedShape(t *testing.T) {
+	r := runtimeRecordFixture()
+	canonical, err := encodeRuntimeIdentity(r, r.Home)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pretty, err := json.MarshalIndent(r, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, body := range [][]byte{canonical, pretty, append(bytes.Clone(pretty), '\n')} {
+		before := bytes.Clone(body)
+		got, err := parseRuntimeIdentity(body, r.Home)
+		if err != nil || got != r || !bytes.Equal(before, body) {
+			t.Fatal("prior producer bytes did not remain readable and unchanged")
+		}
+	}
+	for name, body := range map[string][]byte{
+		"duplicate":        bytes.Replace(canonical, []byte(`"endpoint":`), []byte(`"endpoint":"ignored","endpoint":`), 1),
+		"escapedDuplicate": append(append(bytes.Clone(canonical[:len(canonical)-1]), []byte(`,"\u0065ndpoint":"ignored"`)...), '}'),
+		"caseAlias":        bytes.Replace(canonical, []byte(`"endpoint":`), []byte(`"Endpoint":`), 1),
+		"unknown":          append(append(bytes.Clone(canonical[:len(canonical)-1]), []byte(`,"unknown":1`)...), '}'),
+		"missing":          []byte(`{}`),
+		"wrongType":        bytes.Replace(canonical, []byte(`"identityVerified":true`), []byte(`"identityVerified":"true"`), 1),
+		"null":             bytes.Replace(canonical, []byte(`"identityVerified":true`), []byte(`"identityVerified":null`), 1),
+		"trailing":         append(bytes.Clone(canonical), []byte(` {}`)...),
+		"array":            []byte(`[]`),
+		"unpaired":         bytes.Replace(canonical, []byte(`synthetic-daemon`), []byte(`\ud800`), 1),
+		"unpairedKey":      bytes.Replace(canonical, []byte(`"endpoint":`), []byte(`"\ud800":`), 1),
+		"invalidUTF8":      bytes.Replace(canonical, []byte(`synthetic-daemon`), []byte{0xff}, 1),
+		"overBudget":       append(bytes.Clone(canonical), bytes.Repeat([]byte(" "), runtimeIdentityBudget)...),
+	} {
+		t.Run(name, func(t *testing.T) {
+			before := bytes.Clone(body)
+			if _, err := parseRuntimeIdentity(body, r.Home); err == nil {
+				t.Fatal("unsupported input accepted")
+			}
+			if !bytes.Equal(before, body) {
+				t.Fatal("refused source changed")
+			}
+		})
+	}
+	for _, mutate := range []func(*runtimeIdentityRecord){
+		func(v *runtimeIdentityRecord) { v.Endpoint = "npipe:////./pipe/docker_engine" },
+		func(v *runtimeIdentityRecord) { v.Home += `\..` },
+		func(v *runtimeIdentityRecord) { v.Daemon = "" },
+		func(v *runtimeIdentityRecord) { v.Daemon = "with space" },
+		func(v *runtimeIdentityRecord) { v.Verified = false },
+		func(v *runtimeIdentityRecord) { v.SourceCommit = strings.Repeat("0", 40) },
+		func(v *runtimeIdentityRecord) { v.BinarySHA = strings.Repeat("B", 64) },
+		func(v *runtimeIdentityRecord) { v.BinarySHA = strings.Repeat("0", 64) },
+		func(v *runtimeIdentityRecord) { v.Home = string([]byte{0xff}) },
+	} {
+		changed := r
+		mutate(&changed)
+		if out, err := encodeRuntimeIdentity(changed, r.Home); err == nil || out != nil {
+			t.Fatal("unsupported target emitted")
+		}
+	}
+}
+
+func TestRuntimeIdentityRecordUnicodeAndExactBudget(t *testing.T) {
+	r := runtimeRecordFixture()
+	r.Home += `\Unicode-😀-�`
+	body, err := encodeRuntimeIdentity(r, r.Home)
+	if err != nil {
+		t.Fatal(err)
+	}
+	paired := bytes.Replace(body, []byte("😀"), []byte(`\uD83D\uDE00`), 1)
+	if got, err := parseRuntimeIdentity(paired, r.Home); err != nil || got != r {
+		t.Fatal("valid paired Unicode rejected")
+	}
+	for _, n := range []int{runtimeIdentityBudget - 1, runtimeIdentityBudget, runtimeIdentityBudget + 1} {
+		padded := append(bytes.Clone(body), bytes.Repeat([]byte(" "), n-len(body))...)
+		_, err := parseRuntimeIdentity(padded, r.Home)
+		if (err == nil) != (n <= runtimeIdentityBudget) {
+			t.Fatal("byte budget boundary differs")
+		}
+	}
+}
+
+func TestRuntimeIdentityUpgradeFieldMatchingNeverAdmitsEmptyOrForeignGeneration(t *testing.T) {
+	r := runtimeRecordFixture()
+	var incoming [32]byte
+	for i := range incoming {
+		incoming[i] = 0xbb
+	}
+	candidate := UpgradeProcess{123, 456, 1, incoming}
+	j := upgradeJournal{Incoming: incoming, Candidate: candidate, Daemon: r.Daemon}
+	v := upgradeValidation{Candidate: candidate, Daemon: r.Daemon}
+	if r.BinarySHA != hex.EncodeToString(incoming[:]) || !r.matchesUpgradeData(j, v) {
+		t.Fatal("matching fields rejected")
+	}
+	foreign := v
+	foreign.Candidate.Creation++
+	if r.matchesUpgradeData(j, foreign) || (runtimeIdentityRecord{}).matchesUpgradeData(upgradeJournal{}, upgradeValidation{}) {
+		t.Fatal("foreign/empty generation fields accepted")
+	}
+	// A matching DATA tuple intentionally supplies no native constructor or grant.
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publisher_windows.go b/rdd/pkg/managementconfig/upgrade_runtime_publisher_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..97d6cbd0c664e0bb56235e8d111ce4e6be72c311
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publisher_windows.go
@@ -0,0 +1,375 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"sync"
+)
+
+// The existing upgrade coordinator's concrete compatibility-record publisher.
+// It owns no service lifecycle. Its preparation inputs are actual native owners
+// captured before interruption; a renderer cannot construct any of them.
+type nativeUpgradeRuntimePublisher struct {
+	mu                                                  sync.Mutex
+	storage                                             *nativeRuntimeStorage
+	origin                                              *nativeRuntimeBuildOrigin
+	recorder                                            *upgradeRecorder
+	witness                                             *nativeUpgradeObservedCandidate
+	validation                                          upgradeValidation
+	prepared                                            *nativeRuntimePrepared
+	admission                                           runtimePublicationAdmission
+	receipt                                             *nativeRuntimeStorageReceipt
+	prepareAttempted, publishAttempted, unknown, sealed bool
+	abandoned                                           bool
+}
+
+var nativeRuntimePublishers = struct {
+	sync.Mutex
+	owners map[*nativeUpgradeRuntimePublisher]bool
+}{owners: make(map[*nativeUpgradeRuntimePublisher]bool)}
+
+func (*nativeUpgradeRuntimePublisher) String() string   { return "native upgrade runtime publisher" }
+func (*nativeUpgradeRuntimePublisher) GoString() string { return "native upgrade runtime publisher" }
+func (p *nativeUpgradeRuntimePublisher) RootBacking() *InstanceRoot {
+	if p == nil || p.storage == nil {
+		return nil
+	}
+	return p.storage.root
+}
+func (p *nativeUpgradeRuntimePublisher) fence() {
+	p.unknown = true // caller owns p.mu
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.owners[p.storage] = true
+	runtimeStorageDomain.Unlock()
+	nativeRuntimePublishers.Lock()
+	nativeRuntimePublishers.owners[p] = true
+	nativeRuntimePublishers.Unlock()
+}
+
+// The caller still owns storage/origin on refusal. In particular this never
+// drops/reacquires setup.lock. It cannot borrow a model/in-memory record sink.
+func newNativeUpgradeRuntimePublisher(ctx context.Context, n *nativeRuntimeStorage, origin *nativeRuntimeBuildOrigin, recorder *upgradeRecorder) (*nativeUpgradeRuntimePublisher, error) {
+	if ctx == nil || ctx.Err() != nil || n == nil || n.root == nil || origin == nil || origin.storage != n || recorder == nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	store, ok := recorder.sink.(*nativeUpgradeStore)
+	if !ok || store == nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j, uncertain, sequence := recorder.last.Journal, recorder.uncertain || recorder.retired, recorder.last.Sequence
+	recorder.mu.Unlock()
+	if uncertain || sequence == 0 || j.Stage != "prepared" || !j.valid() {
+		return nil, ErrUpgrade
+	}
+	store.mu.Lock()
+	available := !store.closed && !store.uncertain && store.directory != 0 && store.parents != nil && store.sid == n.sid
+	store.mu.Unlock()
+	if !available || origin.check(ctx, j) != nil {
+		return nil, ErrUpgrade
+	}
+	p := &nativeUpgradeRuntimePublisher{storage: n, origin: origin, recorder: recorder}
+	nativeRuntimePublishers.Lock()
+	defer nativeRuntimePublishers.Unlock()
+	if len(nativeRuntimePublishers.owners) >= 16 {
+		return nil, ErrUpgrade
+	}
+	for held := range nativeRuntimePublishers.owners {
+		if held.storage == n || held.origin == origin {
+			return nil, ErrUpgrade
+		}
+	}
+	nativeRuntimePublishers.owners[p] = true
+	return p, nil
+}
+
+// Called ONLY from actual c.observeUpgradeCandidate with c.operation held.
+// TryLock avoids a reverse wait against a publication already owning p.mu.
+func (p *nativeUpgradeRuntimePublisher) retainNativeUpgradeObservedCandidate(ctx context.Context, c *nativeUpgradeCandidate, j upgradeJournal, v upgradeValidation) error {
+	if p == nil || c == nil || !p.mu.TryLock() {
+		return ErrUpgrade
+	}
+	defer p.mu.Unlock()
+	if p.unknown || p.sealed || p.abandoned || c.launcher == nil || c.launcher.providers == nil || c.launcher.providers.publication != p || c.launcher.authority == nil || c.launcher.authority.recorder != p.recorder || c.observed == nil || c.observed.checkHeld(ctx, p.RootBacking(), j, v) != nil {
+		return ErrUpgrade
+	}
+	if p.witness != nil && p.witness != c.observed {
+		return ErrUpgrade
+	}
+	p.witness, p.validation = c.observed, v
+	return nil
+}
+
+// No native work under recorder.mu. The actual native record must already be
+// acknowledged, exact and current. seal alone may carry the uncommitted digest
+// in memory, which is independently checked against the admitted stage.
+func (p *nativeUpgradeRuntimePublisher) recorded(j upgradeJournal, sealing bool) bool {
+	if p == nil || p.recorder == nil || !j.valid() {
+		return false
+	}
+	p.recorder.mu.Lock()
+	durable, uncertain := p.recorder.last.Journal, p.recorder.uncertain || p.recorder.retired
+	p.recorder.mu.Unlock()
+	if uncertain {
+		return false
+	}
+	store, ok := p.recorder.sink.(*nativeUpgradeStore)
+	if !ok || store == nil {
+		return false
+	}
+	store.mu.Lock()
+	// Actual SDK owners set these custody flags and Close refuses while either
+	// is held. They are not minted by the publisher. They remain held through
+	// committed-record final handoff, after this publication's checked seal.
+	if store.uncertain || store.closeErr != nil {
+		p.fence()
+		store.mu.Unlock()
+		return false
+	}
+	live := !store.closed && store.sdkActive && store.sdkDenialActive && store.directory != 0 && store.parents != nil && store.sid == p.storage.sid
+	if live {
+		live = verifyPrivate(store.directory, store.sid, true) == nil
+	}
+	store.mu.Unlock()
+	if !live {
+		return false
+	}
+	if sealing {
+		if j.RuntimeDigest != j.RuntimeAdmission.Stage.Body || durable.RuntimeDigest != [32]byte{} {
+			return false
+		}
+		j.RuntimeDigest = [32]byte{}
+	}
+	a, e := upgradeJournalBytes(j)
+	b, f := upgradeJournalBytes(durable)
+	return e == nil && f == nil && bytes.Equal(a, b)
+}
+
+// Lock order for effects: p.mu -> candidate.operation (TryLock) -> origin.mu
+// -> storage.mu -> lease.mu. Observation takes p.mu only with TryLock. No
+// storage/origin callback enters this publisher or the candidate mutex.
+func (p *nativeUpgradeRuntimePublisher) lockCandidate() (*nativeUpgradeCandidate, error) {
+	if p.unknown || p.sealed || p.abandoned || p.witness == nil || p.witness.owner == nil {
+		return nil, ErrUpgrade
+	}
+	c := p.witness.owner
+	if !c.operation.TryLock() {
+		return nil, ErrUpgrade
+	}
+	return c, nil
+}
+
+// Only a known prepared operation can be abandoned. After interruption the
+// existing coordinator owns recovery; this method never guesses a cleanup.
+func (p *nativeUpgradeRuntimePublisher) abandonBeforeInterruption() (result error) {
+	if p == nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.abandoned {
+		return nil
+	}
+	if p.unknown || p.sealed || p.prepareAttempted || p.publishAttempted || retireRuntimePreflight(p.recorder) != nil {
+		return ErrUpgrade
+	}
+	defer func() {
+		if value := recover(); value != nil {
+			p.fence()
+			panic(value)
+		}
+		if result != nil {
+			p.fence()
+		}
+	}()
+	if p.origin.Close() != nil || p.storage.Close() != nil {
+		return ErrUpgrade
+	}
+	p.abandoned = true
+	nativeRuntimePublishers.Lock()
+	delete(nativeRuntimePublishers.owners, p)
+	nativeRuntimePublishers.Unlock()
+	return nil
+}
+
+func (p *nativeUpgradeRuntimePublisher) prepareUpgradeRuntime(ctx context.Context, j upgradeJournal, v upgradeValidation) (admission runtimePublicationAdmission, result error) {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return admission, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.prepareAttempted || j.Stage != "candidate-validated" || !p.recorded(j, false) {
+		return admission, ErrUpgrade
+	}
+	c, err := p.lockCandidate()
+	if err != nil {
+		return admission, err
+	}
+	defer c.operation.Unlock()
+	p.origin.mu.Lock()
+	defer p.origin.mu.Unlock()
+	if p.witness.checkHeld(ctx, p.RootBacking(), j, v) != nil || p.origin.checkHeld(ctx, j) != nil {
+		return admission, ErrUpgrade
+	}
+	p.prepareAttempted = true
+	defer func() {
+		if value := recover(); value != nil {
+			p.fence()
+			panic(value)
+		}
+		if result != nil {
+			p.fence()
+		}
+	}()
+	record := runtimeIdentityRecord{Endpoint: runtimeIdentityEndpoint, Home: p.storage.home, Daemon: j.Daemon, SourceCommit: p.origin.commit, BinarySHA: hex.EncodeToString(j.Incoming[:]), Verified: true}
+	p.prepared, result = p.storage.prepareStorage(ctx, record)
+	if result != nil || p.prepared == nil {
+		return admission, ErrUpgrade
+	}
+	admission, result = p.prepared.captureAdmissionStorage(ctx, p.witness, j, v)
+	if result != nil || !admission.matches(j) || p.witness.checkHeld(ctx, p.RootBacking(), j, v) != nil || p.origin.checkHeld(ctx, j) != nil {
+		return admission, ErrUpgrade
+	}
+	p.admission = admission
+	return admission, nil
+}
+
+func (p *nativeUpgradeRuntimePublisher) publishUpgradeRuntime(ctx context.Context, j upgradeJournal, v upgradeValidation) (digest [32]byte, result error) {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return digest, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.publishAttempted || !p.prepareAttempted || p.prepared == nil || j.Stage != "runtime-publication-admitted" || p.admission != j.RuntimeAdmission || !p.recorded(j, false) {
+		return digest, ErrUpgrade
+	}
+	c, err := p.lockCandidate()
+	if err != nil {
+		return digest, err
+	}
+	defer c.operation.Unlock()
+	p.origin.mu.Lock()
+	defer p.origin.mu.Unlock()
+	if p.witness.checkHeld(ctx, p.RootBacking(), j, v) != nil || p.origin.checkHeld(ctx, j) != nil {
+		return digest, ErrUpgrade
+	}
+	actual, err := p.prepared.captureAdmissionStorage(ctx, p.witness, j, v)
+	if err != nil || actual != p.admission {
+		return digest, ErrUpgrade
+	}
+	p.publishAttempted = true
+	defer func() {
+		if value := recover(); value != nil {
+			p.fence()
+			panic(value)
+		}
+		if result != nil {
+			p.fence()
+		}
+	}()
+	p.receipt, result = p.prepared.commitStorage()
+	if result != nil || p.receipt == nil || p.receipt.checkStorage() != nil || p.witness.checkHeld(ctx, p.RootBacking(), j, v) != nil || p.origin.checkHeld(ctx, j) != nil {
+		return digest, ErrUpgrade
+	}
+	digest = sha256.Sum256(p.receipt.body)
+	if digest != p.admission.Stage.Body {
+		return [32]byte{}, ErrUpgrade
+	}
+	return digest, nil
+}
+
+func (p *nativeUpgradeRuntimePublisher) observeUpgradeRuntime(ctx context.Context, j upgradeJournal) (digest [32]byte, result error) {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.sealed {
+		return digest, ErrUpgrade
+	}
+	defer func() {
+		if value := recover(); value != nil {
+			p.fence()
+			panic(value)
+		}
+		if result != nil && p.publishAttempted {
+			p.fence()
+		}
+	}()
+	if !p.publishAttempted || p.receipt == nil || p.admission != j.RuntimeAdmission || !p.recorded(j, false) {
+		return [32]byte{}, ErrUpgrade
+	}
+	c, err := p.lockCandidate()
+	if err != nil {
+		return [32]byte{}, err
+	}
+	defer c.operation.Unlock()
+	p.origin.mu.Lock()
+	defer p.origin.mu.Unlock()
+	if p.witness.checkHeld(ctx, p.RootBacking(), j, p.validation) != nil || p.origin.checkHeld(ctx, j) != nil || p.receipt.checkStorage() != nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	digest = sha256.Sum256(p.receipt.body)
+	if digest != p.admission.Stage.Body {
+		return [32]byte{}, ErrUpgrade
+	}
+	return digest, nil
+}
+
+func (p *nativeUpgradeRuntimePublisher) sealUpgradeRuntimePublication(ctx context.Context, j upgradeJournal) (result error) {
+	if p == nil || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.sealed {
+		return ErrUpgrade
+	}
+	defer func() {
+		if value := recover(); value != nil {
+			p.fence()
+			panic(value)
+		}
+		if result != nil && p.publishAttempted {
+			p.fence()
+		}
+	}()
+	if !p.publishAttempted || p.receipt == nil || p.admission != j.RuntimeAdmission || !p.recorded(j, true) {
+		return ErrUpgrade
+	}
+	c, err := p.lockCandidate()
+	if err != nil {
+		return err
+	}
+	defer c.operation.Unlock()
+	// check holds the origin only for verification. Close then acquires that
+	// same origin mutex and positively closes every independent build cap.
+	if p.witness.checkHeld(ctx, p.RootBacking(), j, p.validation) != nil || p.origin.check(ctx, j) != nil || p.receipt.checkStorage() != nil {
+		return ErrUpgrade
+	}
+	if p.origin.Close() != nil || p.storage.Close() != nil {
+		return ErrUpgrade
+	}
+	p.sealed = true
+	nativeRuntimePublishers.Lock()
+	delete(nativeRuntimePublishers.owners, p)
+	nativeRuntimePublishers.Unlock()
+	return nil
+}
