@@ -0,0 +1,139 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"sync"
+)
+
+// Actual producer chain through complete SDK cold inventory. It retains the
+// original native legacy family, code, grant, born-in-job SDK and control pipe.
+// Neither an inventory digest nor a started rdd may release this temporary job.
+type nativeUpgradeSDKPreparation struct {
+	mu        sync.Mutex
+	authority *upgradeAuthorityOwner
+	legacy    *nativeUpgradeLegacySDKOwner
+	image     *nativeUpgradeSDKImage
+	grant     *nativeUpgradeSDKGrant
+	child     *nativeUpgradeSDKChild
+	receipt   *upgradeSDKInventory
+	digest    [32]byte
+	unknown   bool
+	transfer  *nativeUpgradeSDKCandidateTransfer
+	birth     *upgradeSDKBirthAdmission
+}
+
+func prepareNativeUpgradeSDK(ctx context.Context, authority *upgradeAuthorityOwner, legacy *nativeUpgradeLegacySDKOwner) (*nativeUpgradeSDKPreparation, error) {
+	if ctx == nil || ctx.Err() != nil || authority == nil || legacy == nil {
+		return nil, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return nil, ErrUpgrade
+	}
+	authority.mu.Lock()
+	if authority.unknown || !authority.imported || authority.released || authority.releaseAttempted || authority.sdk != nil || authority.cold == nil || authority.cold.retirement == nil {
+		authority.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	root := authority.cold.retirement.root
+	birth, birthErr := holdUpgradeSDKBirth(ctx, authority)
+	if birthErr != nil {
+		authority.mu.Unlock()
+		return nil, birthErr
+	}
+	p := &nativeUpgradeSDKPreparation{authority: authority, legacy: legacy, unknown: true, birth: birth}
+	// Retain this one actual preparation, including partial native returns,
+	// BEFORE code/grant/child effects. It cannot be replaced by a later attempt.
+	authority.sdk = p
+	authority.mu.Unlock()
+	var err error
+	p.image, err = holdUpgradeSDKImage(ctx, root)
+	if err != nil {
+		return p, ErrUpgrade
+	}
+	p.grant, err = prepareUpgradeSDKGrant(ctx, authority, legacy, p.image)
+	if err != nil {
+		return p, ErrUpgrade
+	}
+	p.child, err = p.grant.startSDK(ctx)
+	if err != nil {
+		return p, ErrUpgrade
+	}
+	reply, err := p.child.call(ctx, "inventory")
+	if err != nil || reply.Receipt == nil {
+		return p, ErrUpgrade
+	}
+	p.digest, err = reply.Receipt.digest(p.grant.wire.Scope)
+	if err != nil || p.digest == [32]byte{} {
+		return p, ErrUpgrade
+	}
+	p.receipt = reply.Receipt
+	p.unknown = false
+	return p, nil
+}
+
+func (p *nativeUpgradeSDKPreparation) admitUpgradeSDK(ctx context.Context, j upgradeJournal) ([32]byte, error) {
+	if p == nil {
+		return [32]byte{}, ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.recheckLocked(ctx, j) != nil || j.Stage != "data-imported" || j.SDKDigest != [32]byte{} {
+		return [32]byte{}, ErrUpgrade
+	}
+	return p.digest, nil
+}
+func (p *nativeUpgradeSDKPreparation) checkUpgradeSDK(ctx context.Context, j upgradeJournal) error {
+	if p == nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.recheckLocked(ctx, j)
+}
+func (p *nativeUpgradeSDKPreparation) recheckLocked(ctx context.Context, j upgradeJournal) error {
+	if p.child != nil {
+		if handed := p.child.handoff.Load(); handed != nil {
+			// Closed post-handoff phase: the original store's SDK flags were
+			// positively transferred. Never re-use the pre-transfer flag check.
+			if ctx == nil || ctx.Err() != nil || p.unknown || j.Stage != "committed" || j.SDKDigest != p.digest || handed.commit.check() != nil || !upgradeSDKTransferredJournal(p.grant.denial.journal, j) || p.child.recheckIngressBirth(ctx) != nil {
+				return ErrUpgrade
+			}
+			want, err := upgradeJournalBytes(handed.commit.record.Journal)
+			got, actualErr := upgradeJournalBytes(j)
+			if err != nil || actualErr != nil || !bytes.Equal(want, got) {
+				return ErrUpgrade
+			}
+			return nil
+		}
+	}
+	if ctx == nil || ctx.Err() != nil || p.unknown || p.child == nil || p.grant == nil || p.receipt == nil || p.digest == [32]byte{} || !j.valid() || j.Recovery.Schema != 0 || j.SDKDigest != [32]byte{} && j.SDKDigest != p.digest || p.child.recheckIngressBirth(ctx) != nil || p.grant.denial.recheckTransferred(ctx) != nil {
+		return ErrUpgrade
+	}
+	if !upgradeSDKTransferredJournal(p.grant.denial.journal, j) || j.Transaction != p.grant.wire.Scope.Transaction || j.RetirementDigest != p.grant.wire.Scope.ManagementRetirement || j.Daemon != p.grant.wire.Scope.Installation {
+		return ErrUpgrade
+	}
+	digest, err := p.receipt.digest(p.grant.wire.Scope)
+	if err != nil || digest != p.digest {
+		return ErrUpgrade
+	}
+	return nil
+}
+
+func (p *nativeUpgradeSDKPreparation) finalizeUpgradeSDK(ctx context.Context, commit *upgradeSDKCommit) error {
+	if p == nil {
+		return ErrUpgrade
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.unknown || p.transfer == nil || p.transfer.observeNativeAcceptance(ctx, commit) != nil {
+		return ErrUpgrade
+	}
+	if p.grant.final.finalize(ctx, commit) != nil || p.transfer.finishHandoff(ctx, commit) != nil {
+		p.unknown = true
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_provider_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_provider_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..8024524855ed0b5130085112c7fde6de400bfd96
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_provider_windows.go
@@ -0,0 +1,92 @@
+//go:build windows
+
+package managementconfig
+
+import "context"
+
+// This is a trusted native ingress participant, not the existing ingress
+// digest observation. Its implementation must already own the actual old SDK
+// pipe peer, process/token/image generations and compatible controller. The
+// management main/HA process family cannot stand in for this distinct family.
+// There is no production issuer yet; nil/absence means refusal.
+type upgradeSDKPreparedIngress interface {
+	prepareUpgradeSDKServing(context.Context, upgradeJournal, *nativeUpgradeSDKImage) (upgradeSDKServingRetirement, error)
+}
+
+// The temporary upgrade owner keeps this capability until the first candidate
+// positively accepts the inherited ORIGINAL native objects through its serving
+// permit. Preparing an inherited allowlist or losing a reply does not release
+// it. No DTO, path, hash or process-exit Boolean constructs this owner.
+type upgradeSDKServingRetirement interface {
+	recheckUpgradeSDKRetirement(context.Context, upgradeJournal) error
+	bindUpgradeSDKCandidate(context.Context, *upgradeServingTransfer) (upgradeSDKCandidateInheritance, error)
+}
+
+// The existing first-candidate launcher must carry these actual owned handles
+// with its existing migration permit in one explicit native allowlist. It must not
+// transfer SDK ownership merely because the serving rdd started. The same SDK
+// process may start under the temporary upgrader to produce its complete cold
+// inventory, but retains that initial supervisor until native acceptance/ACK.
+// Unknown child launch/acceptance retains both owners.
+type upgradeSDKCandidateInheritance interface {
+	startUpgradeSDKCandidate(context.Context, func(upgradeSDKCandidateLaunch) error) error
+}
+
+// Constructed only by consumption of the original inherited owner in the exact
+// first candidate process. This long-lived serving-rdd owner must retain the
+// actual SAME SDK process/job/control objects before acknowledging acceptance.
+// The SDK then switches logical supervisor only after verifying the new actual
+// process/token/image grant and producing a positive peer ACK. The OS parent
+// remains the upgrader as provenance. The upgrader must keep its original job
+// copy and supervision until both acknowledgements. No constructor is supplied
+// until actual ingress/native inheritance and this lifetime boundary compose.
+type upgradeSDKServingParent interface {
+	acceptOwnedUpgradeSDK(context.Context, upgradeSDKCandidateInheritance) (upgradeSDKOwner, error)
+}
+
+// Only the native prepared reader may supply the target image. Installation
+// scope is provided by the actual ingress owner and preserved SDK semantic
+// records; it is never derived from the management WSL registration UUID.
+func prepareUpgradeSDKServing(ctx context.Context, r *upgradeRetirement, recorder *upgradeRecorder) (*nativeUpgradeSDKImage, upgradeSDKServingRetirement, error) {
+	if r == nil || recorder == nil || ctx == nil || ctx.Err() != nil || r.recheck(ctx) != nil {
+		return nil, nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	store, native := recorder.sink.(*nativeUpgradeStore)
+	j, digest := recorder.last.Journal, recorder.digest
+	if !native || recorder.uncertain || !j.valid() || j.Stage != "data-imported" || j.SDKDigest != [32]byte{} || j.Recovery.Schema != 0 || !upgradeIntentEqual(r.journal, j) {
+		recorder.mu.Unlock()
+		return nil, nil, ErrUpgrade
+	}
+	store.mu.Lock()
+	live := !store.closed && !store.uncertain && store.parents != nil && store.sid == r.root.sid
+	store.mu.Unlock()
+	recorder.mu.Unlock()
+	if !live {
+		return nil, nil, ErrUpgrade
+	}
+	provider, ok := r.ingress.(upgradeSDKPreparedIngress)
+	if !ok {
+		return nil, nil, ErrUpgrade
+	}
+	image, err := holdUpgradeSDKImage(ctx, r.root)
+	if err != nil {
+		return image, nil, ErrUpgrade
+	}
+	// A nonnil owner is retained even on uncertain preparation. Do not Close the
+	// code image here after dispatch: the provider may already have inherited it.
+	owner, err := provider.prepareUpgradeSDKServing(ctx, j, image)
+	if err != nil || owner == nil || owner.recheckUpgradeSDKRetirement(ctx, j) != nil || image.recheck(ctx) != nil {
+		return image, owner, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	unchanged := !recorder.uncertain && recorder.digest == digest && recorder.sink == store
+	store.mu.Lock()
+	unchanged = unchanged && !store.closed && !store.uncertain && store.parents != nil
+	store.mu.Unlock()
+	recorder.mu.Unlock()
+	if !unchanged {
+		return image, owner, ErrUpgrade
+	}
+	return image, owner, nil
+}
