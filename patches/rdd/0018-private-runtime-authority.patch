+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+	"sort"
+	"strings"
+	"testing"
+)
+
+func upgradeFixture() upgradeJournal {
+	return upgradeJournal{Schema: 2, Transaction: strings.Repeat("a", 32), Stage: "prepared", OldRuntime: [32]byte{1}, Incoming: [32]byte{2}, OldRoot: UpgradeObject{3, 4, 5}, OldService: UpgradeProcess{12, 34, 1, [32]byte{1}}, Hostagents: []UpgradeProcess{{56, 78, 1, [32]byte{1}}}, Registration: "{11111111-1111-1111-1111-111111111111}", Daemon: "existing-daemon", DesiredRunning: true, ClusterVersion: "v1.35.1+k3s1", ArgsHash: [32]byte{6}}
+}
+
+func TestUpgradeJournalClosedCanonicalAndNoCredentialFields(t *testing.T) {
+	j := upgradeFixture()
+	data, err := upgradeJournalBytes(j)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := parseUpgradeJournal(data); err != nil || got.Stage != j.Stage || got.OldRoot != j.OldRoot {
+		t.Fatal("canonical journal failed")
+	}
+	for _, bad := range [][]byte{append(append([]byte{}, data...), '\n'), bytes.Replace(data, []byte(`"schema":2`), []byte(`"Schema":2`), 1), bytes.Replace(data, []byte(`"schema":2`), []byte(`"schema":2,"schema":1`), 1), bytes.Replace(data, []byte(`"schema":2`), []byte(`"schema":2,"token":"untrusted"`), 1)} {
+		if _, err := parseUpgradeJournal(bad); err == nil {
+			t.Fatal("ambiguous or credential journal accepted")
+		}
+	}
+	for _, mutate := range []func(*upgradeJournal){func(j *upgradeJournal) { j.OldRuntime = j.Incoming }, func(j *upgradeJournal) { j.OldService.Creation = 0 }, func(j *upgradeJournal) { j.Hostagents = append(j.Hostagents, j.Hostagents[0]) }, func(j *upgradeJournal) { j.Registration = "{11111111-11111111-1111-1111-11111111}" }, func(j *upgradeJournal) { j.CandidateWritesAdmitted = true }, func(j *upgradeJournal) { j.Stage = "committed" }} {
+		bad := upgradeFixture()
+		mutate(&bad)
+		encoded, _ := json.Marshal(bad)
+		if _, err := parseUpgradeJournal(encoded); err == nil {
+			t.Fatal("unproved authority/state accepted")
+		}
+	}
+}
+
+func TestUpgradeAdmissionUnknownCannotReplayOrSkipRetirement(t *testing.T) {
+	j := upgradeFixture()
+	if _, err := advanceUpgrade(j, "capture-admitted"); err == nil {
+		t.Fatal("capture admitted before retirement")
+	}
+	j, err := advanceUpgrade(j, "interruption-admitted")
+	if err != nil {
+		t.Fatal(err)
+	}
+	j, err = advanceUpgrade(j, "retirement-unknown")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := advanceUpgrade(j, "interruption-admitted"); err == nil {
+		t.Fatal("unknown retirement repeated stop admission")
+	}
+	if _, err := advanceUpgrade(j, "retired"); err == nil {
+		t.Fatal("retirement recorded without native digest/cold identity")
+	}
+	j.RetirementDigest = [32]byte{7}
+	j.Cold = []UpgradeColdFile{{Role: "main", Object: UpgradeObject{3, 8, 9}, Size: 4096}}
+	j, err = advanceUpgrade(j, "retired")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixtureUpgradeCapturePlan(&j)
+	j, err = advanceUpgrade(j, "capture-admitted")
+	if err != nil {
+		t.Fatal(err)
+	}
+	j, err = advanceUpgrade(j, "capture-unknown")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := advanceUpgrade(j, "capture-admitted"); err == nil {
+		t.Fatal("unknown capture repeated mutation")
+	}
+	fixtureUpgradeCapture(&j)
+	j, err = advanceUpgrade(j, "checkpoint-captured")
+	if err != nil {
+		t.Fatal(err)
+	}
+	j, err = advanceUpgrade(j, "sealing-admitted")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := advanceUpgrade(j, "checkpoint-sealed"); err == nil {
+		t.Fatal("historical readable checkpoint called confidential")
+	}
+}
+
+func TestUpgradeSavedArgumentsNeverFollowCustomAuthorities(t *testing.T) {
+	if _, err := upgradeArgsHash([]byte(`["--secure-port","6443","--controllers=*,-path-management"]`)); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range []string{`["--secure-port","6443","--etcd-servers=http://foreign.invalid"]`, `["--secure-port","6443","--tls-private-key-file=C:/foreign"]`, `["--secure-port","6443","--controllers=*"]`} {
+		if _, err := upgradeArgsHash([]byte(args)); err == nil {
+			t.Fatal("custom legacy path/transport adopted")
+		}
+	}
+}
+
+func fixtureUpgradeCapturePlan(j *upgradeJournal) {
+	j.Capture = nil
+	for _, fact := range upgradeInventoryFixture() {
+		role := ""
+		for candidate, spec := range upgradeInventoryRoles {
+			if spec.parent == fact.Parent && spec.name == fact.Name {
+				role = candidate
+			}
+		}
+		item := UpgradeBackupObject{Role: role, Source: fact.Object, Directory: fact.Directory}
+		item.Source.Volume = j.OldRoot.Volume
+		if !item.Directory {
+			item.Hash = [32]byte{9}
+		}
+		if upgradeColdRole(role) {
+			found := false
+			for i, file := range j.Cold {
+				if file.Role == role {
+					item.Source = file.Object
+					item.Size = file.Size
+					item.Hash = file.Hash
+					if item.Hash == [32]byte{} {
+						item.Hash = [32]byte{byte(i + 1)}
+					}
+					found = true
+				}
+			}
+			if !found {
+				continue
+			}
+		}
+		j.Capture = append(j.Capture, item)
+	}
+	sort.Slice(j.Capture, func(i, k int) bool { return j.Capture[i].Role < j.Capture[k].Role })
+}
+func fixtureUpgradeCapture(j *upgradeJournal) {
+	if len(j.Capture) == 0 {
+		fixtureUpgradeCapturePlan(j)
+	}
+	j.BackupRoot = UpgradeObject{j.OldRoot.Volume, 10, 1}
+	j.LegacyPIDDenial = UpgradePIDDenial{UpgradeObject{j.OldRoot.Volume, 20, 1}, UpgradeObject{j.OldRoot.Volume, 20, 2}, [32]byte{1}}
+	for i := range j.Capture {
+		j.Capture[i].Target = UpgradeObject{j.OldRoot.Volume, 10, uint32(i + 2)}
+		for k := range j.Cold {
+			if j.Cold[k].Role == j.Capture[i].Role {
+				j.Cold[k].Hash = j.Capture[i].Hash
+			}
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_working_windows.go b/rdd/pkg/managementconfig/upgrade_working_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..472b6c4bf97ad7fa3525bf2cb640c04f561e07e4
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_working_windows.go
@@ -0,0 +1,399 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"io"
+	"path/filepath"
+	"strings"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Owns the migration store lease through copy/SQLite work. Close refuses while
+// the single SQLite operation is active; unknown close retains the store owner.
+// Partial copies remain private and are never overwritten or resumed by absence.
+type upgradeWorkingCopy struct {
+	mu                 sync.Mutex
+	store              *nativeUpgradeStore
+	root               windows.Handle
+	handles            []windows.Handle
+	pin                *upgradeDatabasePin
+	copied, normalized *upgradeSQLiteFile
+	closed             bool
+	closeErr           error
+	unknownHandle      windows.Handle
+	normalizeAttempted bool
+	validated          bool
+	normalizedCold     windows.Handle
+}
+
+// SQLite may mutate only this private working copy. Even a known validation
+// refusal consumes this owner's attempt: inspection never reruns recovery on an
+// ambiguous copy. Success requires positive DB/Conn/backup close, a private
+// namespace audit and an exclusive normalized-file lease before journal ack.
+func (w *upgradeWorkingCopy) normalize(ctx context.Context, recorder *upgradeRecorder) error {
+	if w == nil || ctx == nil || ctx.Err() != nil || recorder == nil {
+		return ErrUpgrade
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed || w.closeErr != nil || w.normalizeAttempted || w.pin == nil || !w.copied.valid("copied") || !w.normalized.valid("normalized") {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j := recorder.last.Journal
+	uncertain := recorder.uncertain
+	recorder.mu.Unlock()
+	if uncertain || recorder.sink != w.store || j.Stage != "working-copied" || j.Transaction != w.pin.transaction || j.WorkingRoot != w.pin.workingRoot || j.Normalized != w.normalized.object {
+		return ErrUpgrade
+	}
+	w.normalizeAttempted = true
+	snapshot, err := checkpointUpgradeCopy(ctx, w.copied, w.normalized)
+	if err != nil {
+		return ErrUpgrade
+	}
+	names, err := upgradeStoreNames(w.root)
+	if err != nil {
+		return ErrUpgrade
+	}
+	seen := map[string]bool{}
+	for _, name := range names {
+		allowed := name == "normalized.db"
+		for _, file := range j.Working {
+			if name == upgradeInventoryRoles[file.Role].name {
+				allowed = true
+			}
+		}
+		if !allowed || seen[name] || ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		seen[name] = true
+		h, err := openLegacyMetadata(w.root, name, false)
+		if err != nil {
+			return ErrUpgrade
+		}
+		w.handles = append(w.handles, h)
+		// SQLite-created temporary sidecars may inherit the exact private parent's
+		// ACEs. They are data only: demand current owner, no foreign read/write,
+		// local disk and one link; do not repair or trust them as authority.
+		if upgradeSealOwner(h, w.store.sid) != nil || objectKind(h, false) != nil || checkObjectDACL(h, w.store.sid, true) != nil {
+			return ErrUpgrade
+		}
+	}
+	if !seen["state.db"] || !seen["normalized.db"] {
+		return ErrUpgrade
+	}
+	h, err := openUpgradeExclusive(w.root, "normalized.db", false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	w.handles = append(w.handles, h)
+	id, err := upgradeObjectID(h)
+	if err != nil || id != j.Normalized || verifyPrivate(h, w.store.sid, false) != nil {
+		return ErrUpgrade
+	}
+	size, err := upgradeHandleSize(h)
+	if err != nil || size == 0 {
+		return ErrUpgrade
+	}
+	if _, err = windows.Seek(h, 0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	defer clear(buffer)
+	for remaining := size; remaining > 0; {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		next := uint64(len(buffer))
+		if remaining < next {
+			next = remaining
+		}
+		var n uint32
+		if windows.ReadFile(h, buffer[:next], &n, nil) != nil || n == 0 || uint64(n) > next {
+			return ErrUpgrade
+		}
+		_, _ = hash.Write(buffer[:n])
+		remaining -= uint64(n)
+	}
+	actualSize, err := upgradeHandleSize(h)
+	if err != nil || size != actualSize {
+		return ErrUpgrade
+	}
+	j.Snapshot = snapshot
+	j.NormalizedSize = size
+	copy(j.NormalizedHash[:], hash.Sum(nil))
+	j, err = advanceUpgrade(j, "checkpoint-validated")
+	if err != nil || recorder.append(ctx, j) != nil {
+		return ErrUpgrade
+	}
+	w.normalizedCold = h
+	w.validated = true
+	return nil
+}
+
+func (w *upgradeWorkingCopy) Close() error {
+	if w == nil {
+		return nil
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return w.closeErr
+	}
+	if w.closeErr != nil {
+		return w.closeErr
+	}
+	if w.pin != nil {
+		w.pin.mu.Lock()
+		if w.pin.active {
+			w.pin.mu.Unlock()
+			return ErrUpgrade
+		}
+		w.pin.closed = true
+		w.pin.mu.Unlock()
+	}
+	w.closed = true
+	for i := len(w.handles) - 1; i >= 0; i-- {
+		if windows.CloseHandle(w.handles[i]) != nil {
+			w.closeErr = ErrUpgrade
+			return w.closeErr
+		}
+	}
+	if w.closeErr == nil {
+		w.store.mu.Lock()
+		w.store.workingActive = false
+		w.store.mu.Unlock()
+	}
+	return w.closeErr
+}
+
+type upgradeHandleReader struct{ h windows.Handle }
+
+func (r upgradeHandleReader) Read(data []byte) (int, error) {
+	var n uint32
+	err := windows.ReadFile(r.h, data, &n, nil)
+	if err == windows.ERROR_HANDLE_EOF || err == nil && n == 0 {
+		return int(n), io.EOF
+	}
+	return int(n), err
+}
+
+type upgradeHandleWriter struct{ h windows.Handle }
+
+func (w upgradeHandleWriter) Write(data []byte) (int, error) { return nativeWrite(w.h, data) }
+
+func createUpgradeWorkingFile(parent windows.Handle, name, sid string) (windows.Handle, error) {
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	if windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_CREATE, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+func openUpgradeMutablePin(parent windows.Handle, name string) (windows.Handle, error) {
+	text, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: text, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	// Main DB pins must take part in delete sharing while permitting SQLite's
+	// ordinary read/write access. Metadata-only opens cannot prevent replacement.
+	// Callers pin only main/normalized.db; WAL/SHM/journals remain deletable until
+	// actual SQLite/backup/connection shutdown has positively joined.
+	if windows.NtCreateFile(&h, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.FILE_READ_DATA|windows.SYNCHRONIZE, &oa, &status, nil, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, windows.FILE_OPEN, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0) != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+
+func upgradeWorkingPath(h windows.Handle) (string, error) {
+	var text [2048]uint16
+	n, err := windows.GetFinalPathNameByHandle(h, &text[0], uint32(len(text)), 0)
+	if err != nil || n == 0 || n >= uint32(len(text)) {
+		return "", ErrUpgrade
+	}
+	path := strings.TrimPrefix(windows.UTF16ToString(text[:n]), `\\?\`)
+	if _, _, err := readerComponents(path); err != nil {
+		return "", ErrUpgrade
+	}
+	return path, nil
+}
+
+func (t *upgradeColdTree) copyWorking(ctx context.Context, store *nativeUpgradeStore, recorder *upgradeRecorder) (*upgradeWorkingCopy, error) {
+	if t == nil || ctx == nil || ctx.Err() != nil || store == nil || recorder == nil {
+		return nil, ErrUpgrade
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed || t.uncertain || !t.backup || t.retirement.recheck(ctx) != nil {
+		return nil, ErrUpgrade
+	}
+	recorder.mu.Lock()
+	j := recorder.last.Journal
+	uncertain := recorder.uncertain
+	recorder.mu.Unlock()
+	if uncertain || recorder.sink != store || j.Stage != "checkpoint-sealed" || !upgradeIntentEqual(j, t.retirement.journal) || j.OldRoot != t.inventory.root || j.BackupRoot == t.inventory.root {
+		return nil, ErrUpgrade
+	}
+	for role, h := range t.handles {
+		directory := role == "root" || role == "db" || role == "tls"
+		if verifyPrivate(h, t.sid, directory) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	store.mu.Lock()
+	if store.closed || store.uncertain || store.workingActive || store.sid != t.sid {
+		store.mu.Unlock()
+		return nil, ErrUpgrade
+	}
+	store.workingActive = true
+	store.mu.Unlock()
+	w := &upgradeWorkingCopy{store: store}
+	// The returned owner is nonnil from here on, including lost admission replies.
+	next, err := advanceUpgrade(j, "copy-admitted")
+	if err != nil || recorder.append(ctx, next) != nil {
+		return w, ErrUpgrade
+	}
+	sd, err := privateDescriptor(t.sid, true)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.root, err = openRelative(store.directory, "working", true, sd, true)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.handles = append(w.handles, w.root)
+	if verifyPrivate(w.root, t.sid, true) != nil {
+		return w, ErrUpgrade
+	}
+	rootID, err := upgradeObjectID(w.root)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.pin = &upgradeDatabasePin{transaction: j.Transaction, workingRoot: rootID}
+	rootPath, err := upgradeWorkingPath(w.root)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	var copied []UpgradeColdFile
+	for _, original := range j.Cold {
+		old := original
+		for _, copied := range j.Capture {
+			if copied.Role == old.Role {
+				old.Object = copied.Target
+			}
+		}
+		if ctx.Err() != nil {
+			return w, ErrUpgrade
+		}
+		source := t.handles[old.Role]
+		if source == 0 {
+			return w, ErrUpgrade
+		}
+		if _, err = windows.Seek(source, 0, io.SeekStart); err != nil {
+			return w, ErrUpgrade
+		}
+		name := upgradeInventoryRoles[old.Role].name
+		dest, err := createUpgradeWorkingFile(w.root, name, t.sid)
+		if err != nil {
+			return w, ErrUpgrade
+		}
+		w.handles = append(w.handles, dest)
+		if verifyPrivate(dest, t.sid, false) != nil || copyUpgradeCold(ctx, upgradeHandleReader{source}, upgradeHandleWriter{dest}, old) != nil || windows.FlushFileBuffers(dest) != nil {
+			return w, ErrUpgrade
+		}
+		id, err := upgradeObjectID(dest)
+		if err != nil {
+			return w, ErrUpgrade
+		}
+		file := old
+		file.Object = id
+		if _, err = windows.Seek(dest, 0, io.SeekStart); err != nil || copyUpgradeCold(ctx, upgradeHandleReader{dest}, io.Discard, file) != nil {
+			return w, ErrUpgrade
+		}
+		// Only main is pinned through SQLite's recovery. Its copied sidecars must
+		// be removable by SQLite; the original sealed checkpoint stays untouched.
+		w.handles = w.handles[:len(w.handles)-1]
+		if windows.CloseHandle(dest) != nil {
+			w.closeErr = ErrUpgrade
+			w.unknownHandle = dest
+			return w, ErrUpgrade
+		}
+		if old.Role == "main" {
+			h, err := openUpgradeMutablePin(w.root, name)
+			if err != nil {
+				return w, ErrUpgrade
+			}
+			w.handles = append(w.handles, h)
+			actual, err := upgradeObjectID(h)
+			if err != nil || actual != id || verifyPrivate(h, t.sid, false) != nil {
+				return w, ErrUpgrade
+			}
+			w.copied = &upgradeSQLiteFile{path: filepath.Join(rootPath, name), role: "copied", pin: w.pin, object: id}
+		}
+		copied = append(copied, file)
+	}
+	h, err := createUpgradeWorkingFile(w.root, "normalized.db", t.sid)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.handles = append(w.handles, h)
+	if verifyPrivate(h, t.sid, false) != nil || windows.FlushFileBuffers(h) != nil {
+		return w, ErrUpgrade
+	}
+	id, err := upgradeObjectID(h)
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.handles = w.handles[:len(w.handles)-1]
+	if windows.CloseHandle(h) != nil {
+		w.closeErr = ErrUpgrade
+		w.unknownHandle = h
+		return w, ErrUpgrade
+	}
+	h, err = openUpgradeMutablePin(w.root, "normalized.db")
+	if err != nil {
+		return w, ErrUpgrade
+	}
+	w.handles = append(w.handles, h)
+	actual, err := upgradeObjectID(h)
+	if err != nil || actual != id || verifyPrivate(h, t.sid, false) != nil {
+		return w, ErrUpgrade
+	}
+	w.normalized = &upgradeSQLiteFile{path: filepath.Join(rootPath, "normalized.db"), role: "normalized", pin: w.pin, object: id}
+	if !w.copied.valid("copied") || !w.normalized.valid("normalized") || t.retirement.recheck(ctx) != nil {
+		return w, ErrUpgrade
+	}
+	next.WorkingRoot = rootID
+	next.Working = copied
+	next.Normalized = id
+	next, err = advanceUpgrade(next, "working-copied")
+	if err != nil || recorder.append(ctx, next) != nil {
+		return w, ErrUpgrade
+	}
+	return w, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_wsl.go b/rdd/pkg/managementconfig/upgrade_wsl.go
new file mode 100644
index 0000000000000000000000000000000000000000..a486e1ad24e99f1c994588264c0b3e6f6234082b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_wsl.go
@@ -0,0 +1,97 @@
+package managementconfig
+
+import (
+	"encoding/binary"
+	"strings"
+	"unicode/utf16"
+	"unicode/utf8"
+)
+
+// Registry facts come from the actual current-user Lxss keys and retained
+// native BasePath directory identities, never from localized CLI headings.
+type upgradeWSLRegistration struct {
+	GUID, Name, BasePath string
+	Object               UpgradeObject
+}
+
+func decodeUpgradeWSLRunning(data []byte, registered map[string]upgradeWSLRegistration) (map[string]bool, error) {
+	if len(data) > 64<<10 || len(registered) > 512 {
+		return nil, ErrUpgrade
+	}
+	text := ""
+	wide := len(data) >= 2 && data[0] == 0xff && data[1] == 0xfe
+	if wide {
+		data = data[2:]
+	}
+	if !wide {
+		for _, b := range data {
+			if b == 0 {
+				wide = true
+				break
+			}
+		}
+	}
+	if wide {
+		if len(data)%2 != 0 {
+			return nil, ErrUpgrade
+		}
+		units := make([]uint16, len(data)/2)
+		for i := range units {
+			units[i] = binary.LittleEndian.Uint16(data[i*2:])
+		}
+		for i := 0; i < len(units); i++ {
+			unit := units[i]
+			if unit == 0 {
+				return nil, ErrUpgrade
+			}
+			if unit >= 0xd800 && unit <= 0xdbff {
+				if i+1 >= len(units) || units[i+1] < 0xdc00 || units[i+1] > 0xdfff {
+					return nil, ErrUpgrade
+				}
+				i++
+			} else if unit >= 0xdc00 && unit <= 0xdfff {
+				return nil, ErrUpgrade
+			}
+		}
+		text = string(utf16.Decode(units))
+	} else {
+		if len(data) >= 3 && string(data[:3]) == "\xef\xbb\xbf" {
+			data = data[3:]
+		}
+		if !utf8.Valid(data) {
+			return nil, ErrUpgrade
+		}
+		text = string(data)
+	}
+	if text == "" {
+		return map[string]bool{}, nil
+	}
+	lines := strings.Split(text, "\n")
+	if lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	if len(lines) > 512 {
+		return nil, ErrUpgrade
+	}
+	found := map[string]bool{}
+	for _, line := range lines {
+		line = strings.TrimSuffix(line, "\r")
+		registration, ok := registered[line]
+		if !ok || line == "" || len(line) > 256 || found[line] || registration.Name != line || strings.ContainsAny(line, "\x00\r\n") {
+			return nil, ErrUpgrade
+		}
+		found[line] = true
+	}
+	return found, nil
+}
+func sameUpgradeWSLRegistrations(before, after map[string]upgradeWSLRegistration) bool {
+	if len(before) != len(after) {
+		return false
+	}
+	for name, old := range before {
+		if now, ok := after[name]; !ok || old != now {
+			return false
+		}
+	}
+	return true
+}
diff --git a/rdd/pkg/managementconfig/upgrade_wsl_command_windows.go b/rdd/pkg/managementconfig/upgrade_wsl_command_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..86526dda32cab892bdf4ceee7e6255a2c474a680
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_wsl_command_windows.go
@@ -0,0 +1,160 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"os/exec"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type upgradeWSLCommandResource struct {
+	mu        sync.Mutex
+	image     *upgradeWSLImage
+	process   windows.Handle
+	token     windows.Token
+	waitKnown bool
+	closed    bool
+	closeErr  error
+}
+
+func (r *upgradeWSLCommandResource) Close() error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if !r.waitKnown {
+		return ErrUpgrade
+	} // retain image/process on unknown sole Wait
+	if r.closed {
+		return r.closeErr
+	}
+	r.closed = true
+	if r.token != 0 && r.token.Close() != nil {
+		r.closeErr = ErrUpgrade
+	}
+	if r.process != 0 && windows.CloseHandle(r.process) != nil {
+		r.closeErr = ErrUpgrade
+	}
+	if r.image != nil && r.image.Close() != nil {
+		r.closeErr = ErrUpgrade
+	}
+	return r.closeErr
+}
+
+type upgradeWSLStoppedObservation struct {
+	registration upgradeWSLRegistration
+	digest       [32]byte
+}
+
+// This bounded child can ONLY enumerate running names; no distro-selected
+// execution, terminate, shutdown, import/export or registry write is reachable.
+func runUpgradeWSLList(ctx context.Context, resource *upgradeWSLCommandResource) (output []byte, result error) {
+	if resource == nil {
+		return nil, ErrUpgrade
+	}
+	image := resource.image
+	if ctx == nil || ctx.Err() != nil || image == nil || image.chain == nil || image.hash == [32]byte{} || !image.object.valid() {
+		return nil, ErrUpgrade
+	}
+	if image.recheck() != nil {
+		return nil, ErrUpgrade
+	}
+	operation, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(operation, image.path, "--list", "--running", "--quiet")
+	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, CreationFlags: windows.CREATE_NO_WINDOW}
+	cmd.WaitDelay = time.Second
+	stdout := &upgradeBoundedOutput{limit: 64 << 10}
+	stderr := &upgradeBoundedOutput{limit: 1024}
+	cmd.Stdout = stdout
+	cmd.Stderr = stderr
+	if cmd.Start() != nil {
+		resource.waitKnown = cmd.Process == nil
+		return nil, ErrUpgrade
+	}
+	resource.waitKnown = false
+	// Hold the actual child process generation, correlate image BEFORE accepting
+	// its output, and retain that process object through the single Cmd.Wait.
+	process, openErr := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, uint32(cmd.Process.Pid))
+	resource.process = process
+	authenticated := false
+	if openErr == nil {
+		path, pathErr := upgradeProcessPath(process)
+		var creation, exit, kernel, user windows.Filetime
+		var childSession, selfSession uint32
+		tokenOK := windows.OpenProcessToken(process, windows.TOKEN_QUERY, &resource.token) == nil
+		ownerOK := false
+		if tokenOK {
+			user, e := resource.token.GetTokenUser()
+			ownerOK = e == nil && user.User.Sid.String() == image.chain.sid
+		}
+		sessionOK := windows.ProcessIdToSessionId(uint32(cmd.Process.Pid), &childSession) == nil && windows.ProcessIdToSessionId(windows.GetCurrentProcessId(), &selfSession) == nil && childSession == selfSession && childSession != 0
+		authenticated = ownerOK && sessionOK && pathErr == nil && strings.EqualFold(path, image.path) && windows.GetProcessTimes(process, &creation, &exit, &kernel, &user) == nil && (creation.HighDateTime != 0 || creation.LowDateTime != 0)
+	}
+	if !authenticated {
+		cancel()
+	}
+	waitErr := cmd.Wait() // sole Wait; cancellation affects only this owned child.
+	resource.waitKnown = cmd.ProcessState != nil && cmd.ProcessState.Exited()
+	if waitErr != nil || !resource.waitKnown || !authenticated || operation.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	out, outErr := stdout.take()
+	diagnostic, diagnosticErr := stderr.take()
+	if outErr != nil || diagnosticErr != nil || len(diagnostic) != 0 || image.recheck() != nil {
+		return nil, ErrUpgrade
+	}
+	return out, nil
+}
+func observeUpgradeWSLStopped(ctx context.Context, root *InstanceRoot, expectedGUID string) (observed *upgradeWSLStoppedObservation, retained *upgradeWSLCommandResource, result error) {
+	before, err := observeUpgradeWSLRegistrations(ctx, root, expectedGUID)
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	image, err := holdUpgradeWSLImage(ctx)
+	resource := &upgradeWSLCommandResource{image: image, waitKnown: true}
+	defer func() {
+		if resource.Close() != nil {
+			observed = nil
+			retained = resource
+			result = ErrUpgrade
+		}
+	}()
+	if err != nil || image == nil {
+		return nil, nil, ErrUpgrade
+	}
+	output, err := runUpgradeWSLList(ctx, resource)
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	running, err := decodeUpgradeWSLRunning(output, before)
+	clear(output)
+	if err != nil || running["lima-orbwin"] {
+		return nil, nil, ErrUpgrade
+	}
+	after, err := observeUpgradeWSLRegistrations(ctx, root, expectedGUID)
+	if err != nil || !sameUpgradeWSLRegistrations(before, after) || ctx.Err() != nil {
+		return nil, nil, ErrUpgrade
+	}
+	selected := after["lima-orbwin"]
+	// Deterministic public metadata receipt only. Callers must reobserve under
+	// retained old-process/owner/exclusive cold-file gates before candidate writes.
+	bytes, err := json.Marshal(struct {
+		Schema       int
+		Registration upgradeWSLRegistration
+		Image        UpgradeObject
+		Hash         [32]byte
+	}{1, selected, image.object, image.hash})
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	return &upgradeWSLStoppedObservation{selected, sha256.Sum256(bytes)}, nil, nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_wsl_image_windows.go b/rdd/pkg/managementconfig/upgrade_wsl_image_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..20d1638a617cf46df20b6d7fab5f5b52a2734db9
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_wsl_image_windows.go
@@ -0,0 +1,162 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"crypto/sha256"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"strings"
+)
+
+type upgradeWSLImage struct {
+	chain    *ParentLease
+	path     string
+	object   UpgradeObject
+	hash     [32]byte
+	size     uint32
+	modified windows.Filetime
+}
+
+func (i *upgradeWSLImage) Close() error {
+	if i == nil || i.chain == nil {
+		return nil
+	}
+	return i.chain.Close()
+}
+func holdUpgradeWSLImage(ctx context.Context) (image *upgradeWSLImage, result error) {
+	if ctx == nil || ctx.Err() != nil {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	directory, err := windows.GetSystemDirectory()
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	path := directory + `\wsl.exe`
+	volume, parts, err := readerComponents(path)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	lease := &upgradeWSLImage{chain: &ParentLease{chain: []windows.Handle{h}, sid: sid}, path: path}
+	ok := false
+	defer func() {
+		if !ok {
+			if lease.Close() != nil {
+				image = lease
+			}
+			result = ErrUpgrade
+		}
+	}()
+	if checkReadObject(h, sid, true) != nil {
+		return nil, ErrUpgrade
+	}
+	for index, part := range parts {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		isDirectory := index < len(parts)-1
+		next, e := openRelative(lease.chain.leaf(), part, isDirectory, nil, false)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		lease.chain.chain = append(lease.chain.chain, next)
+		if isDirectory {
+			if checkReadObject(next, sid, true) != nil {
+				return nil, ErrUpgrade
+			}
+		} else if systemCodeKind(next) != nil || checkObjectDACL(next, "", false) != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	file := lease.chain.leaf()
+	lease.object, err = upgradeObjectID(file)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(file, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow == 0 || info.FileSizeLow > 64<<20 {
+		return nil, ErrUpgrade
+	}
+	lease.size = info.FileSizeLow
+	lease.modified = info.LastWriteTime
+	hash := sha256.New()
+	buffer := make([]byte, 64<<10)
+	var total uint64
+	for {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		var n uint32
+		e := windows.ReadFile(file, buffer, &n, nil)
+		total += uint64(n)
+		if total > 64<<20 {
+			return nil, ErrUpgrade
+		}
+		if n > 0 {
+			_, _ = hash.Write(buffer[:n])
+		}
+		if e == windows.ERROR_HANDLE_EOF || e == nil && n == 0 {
+			break
+		}
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+	}
+	if total != uint64(info.FileSizeLow) {
+		return nil, ErrUpgrade
+	}
+	copy(lease.hash[:], hash.Sum(nil))
+	var final [1024]uint16
+	n, e := windows.GetFinalPathNameByHandle(file, &final[0], uint32(len(final)), 0)
+	if e != nil || n == 0 || n >= uint32(len(final)) || !strings.EqualFold(strings.TrimPrefix(windows.UTF16ToString(final[:n]), `\\?\`), path) {
+		return nil, ErrUpgrade
+	}
+	ok = true
+	return lease, nil
+}
+
+func (i *upgradeWSLImage) recheck() error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if i == nil || i.chain == nil || i.chain.closed || i.chain.leaf() == 0 || i.hash == [32]byte{} {
+		return ErrUpgrade
+	}
+	sid, err := currentOwner()
+	if err != nil || sid != i.chain.sid {
+		return ErrUpgrade
+	}
+	for index, h := range i.chain.chain {
+		if index < len(i.chain.chain)-1 {
+			if checkReadObject(h, sid, true) != nil {
+				return ErrUpgrade
+			}
+		} else if systemCodeKind(h) != nil || checkObjectDACL(h, "", false) != nil {
+			return ErrUpgrade
+		}
+	}
+	file := i.chain.leaf()
+	id, err := upgradeObjectID(file)
+	if err != nil || id != i.object {
+		return ErrUpgrade
+	}
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(file, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow != i.size || info.LastWriteTime != i.modified {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_wsl_output.go b/rdd/pkg/managementconfig/upgrade_wsl_output.go
new file mode 100644
index 0000000000000000000000000000000000000000..f0c09f42472d3b0e6591b7e4cf7e8a92641a3ab8
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_wsl_output.go
@@ -0,0 +1,29 @@
+package managementconfig
+
+import "sync"
+
+type upgradeBoundedOutput struct {
+	mu       sync.Mutex
+	data     []byte
+	limit    int
+	overflow bool
+}
+
+func (o *upgradeBoundedOutput) Write(data []byte) (int, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.limit < 1 || o.overflow || len(data) > o.limit-len(o.data) {
+		o.overflow = true
+		return 0, ErrUpgrade
+	}
+	o.data = append(o.data, data...)
+	return len(data), nil
+}
+func (o *upgradeBoundedOutput) take() ([]byte, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.overflow {
+		return nil, ErrUpgrade
+	}
+	return append([]byte(nil), o.data...), nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_wsl_registry_windows.go b/rdd/pkg/managementconfig/upgrade_wsl_registry_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..386eb4d6660334114cb2a716da7ccc4f234943b4
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_wsl_registry_windows.go
@@ -0,0 +1,154 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/registry"
+	"runtime"
+	"strings"
+)
+
+func upgradeRegistryString(key registry.Key, name string) (string, error) {
+	pointer, err := windows.UTF16PtrFromString(name)
+	if err != nil {
+		return "", ErrUpgrade
+	}
+	var data [2048]byte
+	size := uint32(len(data))
+	var kind uint32
+	if windows.RegQueryValueEx(windows.Handle(key), pointer, nil, &kind, &data[0], &size) != nil || kind != windows.REG_SZ || size < 2 || size > uint32(len(data)) || size%2 != 0 {
+		return "", ErrUpgrade
+	}
+	units := make([]uint16, size/2)
+	for i := range units {
+		units[i] = uint16(data[i*2]) | uint16(data[i*2+1])<<8
+	}
+	if units[len(units)-1] != 0 {
+		return "", ErrUpgrade
+	}
+	for _, unit := range units[:len(units)-1] {
+		if unit == 0 {
+			return "", ErrUpgrade
+		}
+	}
+	value := windows.UTF16ToString(units)
+	if value == "" {
+		return "", ErrUpgrade
+	}
+	return value, nil
+}
+func observeUpgradeDirectoryID(ctx context.Context, path string) (id UpgradeObject, result error) {
+	path = strings.TrimSuffix(strings.TrimPrefix(path, `\\?\`), `\`)
+	volume, parts, err := readerComponents(path)
+	if err != nil {
+		return id, ErrUpgrade
+	}
+	pointer, err := windows.UTF16PtrFromString(volume)
+	if err != nil {
+		return id, ErrUpgrade
+	}
+	h, err := windows.CreateFile(pointer, windows.FILE_LIST_DIRECTORY|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return id, ErrUpgrade
+	}
+	chain := &ParentLease{chain: []windows.Handle{h}}
+	defer func() {
+		if chain.Close() != nil {
+			id = UpgradeObject{}
+			result = ErrUpgrade
+		}
+	}()
+	if objectKind(h, true) != nil {
+		return id, ErrUpgrade
+	}
+	for _, part := range parts {
+		if ctx.Err() != nil {
+			return id, ErrUpgrade
+		}
+		next, e := openLegacyMetadata(chain.leaf(), part, true)
+		if e != nil {
+			return id, ErrUpgrade
+		}
+		chain.chain = append(chain.chain, next)
+		if objectKind(next, true) != nil {
+			return id, ErrUpgrade
+		}
+	}
+	return upgradeObjectID(chain.leaf())
+}
+
+// Actual registry snapshot only. No distribution launch, registry mutation,
+// renderer-supplied BasePath, credential access or ownership inference.
+func observeUpgradeWSLRegistrations(ctx context.Context, root *InstanceRoot, expectedGUID string) (facts map[string]upgradeWSLRegistration, result error) {
+	if ctx == nil || ctx.Err() != nil || root == nil || root.selection == nil {
+		return nil, ErrUpgrade
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != root.sid {
+		return nil, ErrUpgrade
+	}
+	selected, err := ResolveOrbWinRoot(root.home, "orbwin")
+	if err != nil || !selected.selection.Same(root.selection) {
+		return nil, ErrUpgrade
+	}
+	key, err := registry.OpenKey(registry.CURRENT_USER, `Software\Microsoft\Windows\CurrentVersion\Lxss`, registry.ENUMERATE_SUB_KEYS|registry.QUERY_VALUE)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	defer func() {
+		if key.Close() != nil {
+			facts = nil
+			result = ErrUpgrade
+		}
+	}()
+	found := map[string]upgradeWSLRegistration{}
+	owned := false
+	for index := uint32(0); index <= 512; index++ {
+		if ctx.Err() != nil {
+			return nil, ErrUpgrade
+		}
+		var name [64]uint16
+		length := uint32(len(name))
+		err = windows.RegEnumKeyEx(windows.Handle(key), index, &name[0], &length, nil, nil, nil, nil)
+		if err == windows.ERROR_NO_MORE_ITEMS {
+			if !owned {
+				return nil, ErrUpgrade
+			}
+			return found, nil
+		}
+		if err != nil || index == 512 || length != 38 {
+			return nil, ErrUpgrade
+		}
+		guid := strings.ToLower(windows.UTF16ToString(name[:length]))
+		if guid[0] != '{' || guid[37] != '}' || guid[9] != '-' || guid[14] != '-' || guid[19] != '-' || guid[24] != '-' || !upgradeHex(strings.ReplaceAll(guid[1:37], "-", ""), 32) {
+			return nil, ErrUpgrade
+		}
+		child, e := registry.OpenKey(key, guid, registry.QUERY_VALUE)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		distribution, nameErr := upgradeRegistryString(child, "DistributionName")
+		base, pathErr := upgradeRegistryString(child, "BasePath")
+		closeErr := child.Close()
+		if nameErr != nil || pathErr != nil || closeErr != nil || len(distribution) > 256 || strings.ContainsAny(distribution, "\r\n") || found[distribution].Name != "" {
+			return nil, ErrUpgrade
+		}
+		object, e := observeUpgradeDirectoryID(ctx, base)
+		if e != nil {
+			return nil, ErrUpgrade
+		}
+		found[distribution] = upgradeWSLRegistration{guid, distribution, base, object}
+		if distribution == "lima-orbwin" {
+			want := root.selection.GuestHome() + `\.rdorbwin\lima\orbwin`
+			if guid != expectedGUID || !strings.EqualFold(strings.TrimSuffix(strings.TrimPrefix(base, `\\?\`), `\`), want) {
+				return nil, ErrUpgrade
+			}
+			owned = true
+		}
+	}
+	return nil, ErrUpgrade
+}
