@@ -0,0 +1,155 @@
+package managementconfig
+
+import (
+	"context"
+	"io"
+)
+
+// Schema 2 preserves OldRoot in place. Schema 1's whole-root rename journals
+// are deliberately unsupported; they cannot acquire the new persistent denial.
+func validUpgradeCapture(j upgradeJournal, rank int) bool {
+	if rank < 3 && len(j.Capture) == 0 {
+		return len(j.Capture) == 0 && j.LegacyPIDDenial == (UpgradePIDDenial{}) && !j.BackupRoot.valid()
+	}
+	if len(j.Capture) < 4 || len(j.Capture) > len(upgradeInventoryRoles) {
+		return false
+	}
+	sources := map[UpgradeObject]bool{j.OldRoot: true}
+	targets := map[UpgradeObject]bool{}
+	facts := make([]upgradeInventoryObject, 0, len(j.Capture))
+	cold := map[string]UpgradeColdFile{}
+	for _, file := range j.Cold {
+		cold[file.Role] = file
+	}
+	var total uint64
+	last := ""
+	for _, item := range j.Capture {
+		spec, ok := upgradeInventoryRoles[item.Role]
+		if !ok || item.Role <= last || item.Directory != spec.directory || sources[item.Source] || !item.Source.valid() || item.Source.Volume != j.OldRoot.Volume || item.Size > maxUpgradeCopyBytes || total > maxUpgradeCopyBytes-item.Size {
+			return false
+		}
+		last = item.Role
+		sources[item.Source] = true
+		total += item.Size
+		if item.Directory {
+			if item.Size != 0 || item.Hash != [32]byte{} {
+				return false
+			}
+		} else if item.Hash == [32]byte{} {
+			return false
+		}
+		facts = append(facts, upgradeInventoryObject{spec.parent, spec.name, item.Source, item.Directory, 1, false})
+		if upgradeColdRole(item.Role) {
+			file, ok := cold[item.Role]
+			if !ok || file.Object != item.Source || file.Size != item.Size || file.Hash != [32]byte{} && file.Hash != item.Hash {
+				return false
+			}
+			delete(cold, item.Role)
+		}
+	}
+	if _, err := planUpgradeInventory(j.OldRoot, facts); err != nil || len(cold) != 0 {
+		return false
+	}
+	if rank < 4 && !j.BackupRoot.valid() {
+		if j.BackupRoot.valid() || j.LegacyPIDDenial != (UpgradePIDDenial{}) {
+			return false
+		}
+		for _, item := range j.Capture {
+			if item.Target.valid() {
+				return false
+			}
+		}
+		return true
+	}
+	if !j.BackupRoot.valid() || j.BackupRoot.Volume != j.OldRoot.Volume || sources[j.BackupRoot] {
+		return false
+	}
+	targets[j.BackupRoot] = true
+	for _, item := range j.Capture {
+		if !item.Target.valid() || item.Target.Volume != j.BackupRoot.Volume || sources[item.Target] || targets[item.Target] {
+			return false
+		}
+		targets[item.Target] = true
+	}
+	d := j.LegacyPIDDenial
+	if !d.Directory.valid() || !d.Receipt.valid() || d.Directory.Volume != j.OldRoot.Volume || d.Receipt.Volume != j.OldRoot.Volume || d.Directory == d.Receipt || sources[d.Directory] || sources[d.Receipt] || targets[d.Directory] || targets[d.Receipt] || d.Digest == [32]byte{} {
+		return false
+	}
+	for _, seal := range j.Seals {
+		want := j.BackupRoot
+		if seal.Role != "root" {
+			want = UpgradeObject{}
+			for _, item := range j.Capture {
+				if item.Role == seal.Role {
+					want = item.Target
+				}
+			}
+		}
+		if seal.Object != want {
+			return false
+		}
+	}
+	return true
+}
+func upgradeCaptureFollows(before, after upgradeJournal) bool {
+	if before.LegacyPIDDenial != (UpgradePIDDenial{}) && before.LegacyPIDDenial != after.LegacyPIDDenial {
+		return false
+	}
+	if len(before.Capture) == 0 {
+		return true
+	}
+	if len(before.Capture) != len(after.Capture) {
+		return false
+	}
+	for i, a := range before.Capture {
+		b := after.Capture[i]
+		target := a.Target
+		a.Target = b.Target
+		if a != b || target.valid() && target != b.Target {
+			return false
+		}
+	}
+	return true
+}
+
+// The native capture owner calls this once after admission, retaining both
+// FILE_OBJECTs on failure. The seam exercises actual copy/flush/reread ordering
+// without executing a native syscall or treating injected facts as authority.
+type upgradeCaptureSource interface {
+	io.Reader
+	io.Seeker
+	inspectCapture() (UpgradeObject, uint64, error)
+}
+type upgradeCaptureTarget interface {
+	upgradeCaptureSource
+	io.Writer
+	flushCapture() error
+}
+
+func copyUpgradeCaptureChild(ctx context.Context, source upgradeCaptureSource, target upgradeCaptureTarget, file UpgradeColdFile, want UpgradeObject) error {
+	if ctx == nil || ctx.Err() != nil || source == nil || target == nil || !want.valid() || want == file.Object {
+		return ErrUpgrade
+	}
+	sid, size, err := source.inspectCapture()
+	tid, empty, other := target.inspectCapture()
+	if err != nil || other != nil || sid != file.Object || size != file.Size || tid != want || empty != 0 {
+		return ErrUpgrade
+	}
+	if _, err = source.Seek(0, io.SeekStart); err != nil || copyUpgradeHistorical(ctx, source, target, file) != nil || target.flushCapture() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	if _, err = target.Seek(0, io.SeekStart); err != nil {
+		return ErrUpgrade
+	}
+	copied := file
+	copied.Object = want
+	if copyUpgradeHistorical(ctx, target, io.Discard, copied) != nil {
+		return ErrUpgrade
+	}
+	sid, size, err = source.inspectCapture()
+	tid, empty, other = target.inspectCapture()
+	if err != nil || other != nil || sid != file.Object || size != file.Size || tid != want || empty != file.Size || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return nil
+}
