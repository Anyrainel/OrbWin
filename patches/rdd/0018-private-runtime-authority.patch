@@ -0,0 +1,93 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+// This durable sibling exists BEFORE creating authority/. It is never removed
+// to recover or to enable startup. Ordinary startup requires the same private
+// journal's final committed record, with no rollback/recovery branch.
+type upgradeFence struct {
+	Schema             int    `json:"schema"`
+	Transaction        string `json:"transaction"`
+	Incoming, ArgsHash [32]byte
+	Owner              UpgradeProcess
+}
+
+func (f upgradeFence) valid() bool {
+	return f.Schema == 1 && upgradeHex(f.Transaction, 32) && f.Incoming != [32]byte{} && f.ArgsHash != [32]byte{} && f.Owner.valid() && f.Owner.Image == f.Incoming
+}
+func upgradeFenceBytes(f upgradeFence) ([]byte, error) {
+	if !f.valid() {
+		return nil, ErrUpgrade
+	}
+	data, err := json.Marshal(f)
+	if err != nil || len(data) > 2048 {
+		return nil, ErrUpgrade
+	}
+	return data, nil
+}
+func parseUpgradeFence(data []byte) (upgradeFence, error) {
+	var f upgradeFence
+	if len(data) == 0 || len(data) > 2048 || json.Unmarshal(data, &f) != nil {
+		return f, ErrUpgrade
+	}
+	want, err := upgradeFenceBytes(f)
+	if err != nil || !bytes.Equal(data, want) {
+		return upgradeFence{}, ErrUpgrade
+	}
+	return f, nil
+}
+func (f upgradeFence) allowsOrdinary(j upgradeJournal, root, database UpgradeObject) bool {
+	return f.valid() && j.valid() && j.Stage == "committed" && j.Recovery.Schema == 0 && j.Transaction == f.Transaction && j.Incoming == f.Incoming && j.ArgsHash == f.ArgsHash && j.PrivateRoot == root && root.valid() && database.valid() && j.Imported.Object == database
+}
+
+type upgradePermitFacts struct {
+	Inherited         bool
+	Candidate, Parent UpgradeProcess
+	Root, Database    UpgradeObject
+}
+
+func (r upgradeServingRecord) allows(f upgradePermitFacts) bool {
+	j := r.Record.Journal
+	return r.valid() && f.Inherited && f.Candidate.valid() && f.Candidate.Image == j.Incoming && f.Candidate.Session == r.Fence.Owner.Session && f.Parent == r.Fence.Owner && !sameUpgradeGeneration(f.Parent, f.Candidate) && f.Root == j.PrivateRoot && f.Database == j.Imported.Object
+}
+
+type upgradeCandidateTransfer interface {
+	startUpgradeCandidate(func(uintptr) error) error
+}
+
+type upgradeServingRecord struct {
+	Schema      int
+	Fence       upgradeFence
+	FenceObject UpgradeObject
+	Record      upgradeRecord
+}
+
+func (r upgradeServingRecord) valid() bool {
+	j := r.Record.Journal
+	_, err := upgradeRecordBytes(r.Record)
+	return r.Schema == 1 && r.Fence.valid() && r.FenceObject.valid() && r.FenceObject == j.Fence && err == nil && j.Stage == "candidate-start-admitted" && j.CandidateWritesAdmitted && j.Recovery.Schema == 0 && j.Transaction == r.Fence.Transaction && j.Incoming == r.Fence.Incoming && j.ArgsHash == r.Fence.ArgsHash
+}
+func upgradeServingBytes(r upgradeServingRecord) ([]byte, error) {
+	if !r.valid() {
+		return nil, ErrUpgrade
+	}
+	data, err := json.Marshal(r)
+	if err != nil || len(data) > 64<<10 {
+		return nil, ErrUpgrade
+	}
+	return data, nil
+}
+func parseUpgradeServing(data []byte) (upgradeServingRecord, error) {
+	var r upgradeServingRecord
+	if len(data) == 0 || len(data) > 64<<10 || json.Unmarshal(data, &r) != nil {
+		return r, ErrUpgrade
+	}
+	want, err := upgradeServingBytes(r)
+	if err != nil || !bytes.Equal(data, want) {
+		return upgradeServingRecord{}, ErrUpgrade
+	}
+	return r, nil
+}
