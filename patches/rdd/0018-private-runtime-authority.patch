new file mode 100644
index 0000000000000000000000000000000000000000..677c15647cfe36e1de094b2f6c6fbef2431e3594
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_route_test.go
@@ -0,0 +1,163 @@
+package managementconfig
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestRuntimeStorageRouteFactsBindTheActuallyParsedDescriptor(t *testing.T) {
+	facts := runtimeStorageRouteFacts{strict: true, traversalSafe: true, protected: true, descriptor: [32]byte{1, 2, 3}}
+	if !runtimeStorageRouteDescriptorMatches(facts, facts.descriptor) {
+		t.Fatal("same parsed SD rejected")
+	}
+	for i := range facts.descriptor {
+		changed := facts.descriptor
+		changed[i] ^= 1
+		if runtimeStorageRouteDescriptorMatches(facts, changed) {
+			t.Fatal("different measured SD admitted", i)
+		}
+	}
+}
+
+// Fault-model tests use the coordinator actually called by the native owner;
+// they do not mint handles or claim any observed kernel failure/race.
+func TestRuntimeStorageRouteProtectionAndStrictBoundary(t *testing.T) {
+	safe := runtimeStorageRouteFacts{strict: true, traversalSafe: true}
+	unsafe := runtimeStorageRouteFacts{}
+	protected := safe
+	protected.protected = true
+	for _, tc := range []struct {
+		name  string
+		nodes []runtimeStorageRouteFacts
+		ok    bool
+	}{
+		{"old-safe-route", []runtimeStorageRouteFacts{safe, safe, safe}, true},
+		{"protected-public-route", []runtimeStorageRouteFacts{safe, unsafe, protected}, true},
+		{"unprotected-boundary", []runtimeStorageRouteFacts{safe, unsafe, safe}, false},
+		{"foreign-writable-boundary", []runtimeStorageRouteFacts{safe, unsafe, {protected: true}}, false},
+		{"mutable-routing-volume", []runtimeStorageRouteFacts{unsafe, safe, protected}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			edges := 0
+			e := runtimeStorageRouteSequence(len(tc.nodes), func(i int) (runtimeStorageRouteFacts, error) { return tc.nodes[i], nil }, func(i int) error { edges++; return nil })
+			if (e == nil) != tc.ok || edges != len(tc.nodes)-1 {
+				t.Fatal("route predicate", e, edges)
+			}
+		})
+	}
+}
+
+func TestRuntimeStorageRouteInspectionErrorsNeverDeferOrCreateController(t *testing.T) {
+	safe := runtimeStorageRouteFacts{strict: true, traversalSafe: true, protected: true}
+	for _, reason := range []string{"native-query", "foreign-owner", "malformed-ace", "unsupported-ace", "invalid-sid"} {
+		for failAt := 0; failAt < 4; failAt++ {
+			fault := errors.New(reason)
+			created := false
+			visited := []int{}
+			e := runtimeStorageRouteBeforeController(func() error {
+				return runtimeStorageRouteSequence(4, func(i int) (runtimeStorageRouteFacts, error) {
+					visited = append(visited, i)
+					if i == failAt {
+						return runtimeStorageRouteFacts{}, fault
+					}
+					return safe, nil
+				}, func(int) error { return nil })
+			}, func() error { created = true; return nil })
+			if !errors.Is(e, fault) || created || len(visited) != failAt+1 {
+				t.Fatal(reason, failAt, e, created, visited)
+			}
+		}
+	}
+}
+
+func TestRuntimeStorageRouteEdgeFaultsStopAdmissionAndRetainUnknown(t *testing.T) {
+	for failAt := 1; failAt < 4; failAt++ {
+		created := false
+		retained := false
+		fenced := false
+		closeCalls := 0
+		var closeAttempt runtimeStorageCloseAttempt
+		fault := errors.New("unknown edge close")
+		var order []int
+		check := func() error {
+			return runtimeStorageRouteSequence(4, func(i int) (runtimeStorageRouteFacts, error) {
+				order = append(order, i*10)
+				return runtimeStorageRouteFacts{strict: true, traversalSafe: true, protected: true}, nil
+			}, func(i int) error {
+				order = append(order, i*10+1)
+				if i != failAt {
+					return nil
+				}
+				// A successfully returned output is retained BEFORE inspection;
+				// a cached unknown close never runs a second CloseHandle attempt.
+				retained = true
+				for j := 0; j < 2; j++ {
+					if !errors.Is(closeAttempt.run(func() error { closeCalls++; return fault }, func() { fenced = true }), fault) {
+						t.Fatal("cached close")
+					}
+				}
+				return fault
+			})
+		}
+		e := runtimeStorageRouteBeforeController(check, func() error { created = true; return nil })
+		if !errors.Is(e, fault) || created || !retained || !fenced || closeCalls != 1 || order[len(order)-1] != failAt*10+1 {
+			t.Fatal(e, created, retained, fenced, closeCalls, order)
+		}
+	}
+}
+
+func TestRuntimeStorageRoutePartialOpenIsNotMissingOrInspected(t *testing.T) {
+	for _, tc := range []struct {
+		err     error
+		output  bool
+		unknown bool
+	}{
+		{errors.New("partial native output"), true, true},
+		{nil, false, true},
+		{errors.New("ordinary native refusal"), false, false},
+	} {
+		var order []string
+		e := runtimeStorageRouteBeforeController(func() error {
+			return runtimeStorageRouteSequence(2, func(int) (runtimeStorageRouteFacts, error) {
+				return runtimeStorageRouteFacts{strict: true, traversalSafe: true}, nil
+			}, func(int) error {
+				return runtimeStorageOpenReply(tc.err, tc.output, func() { order = append(order, "retain") }, func() { order = append(order, "fence") })
+			})
+		}, func() error { order = append(order, "controller"); return nil })
+		if e == nil {
+			t.Fatal("error admitted")
+		}
+		want := []string(nil)
+		if tc.output {
+			want = append(want, "retain")
+		}
+		if tc.unknown {
+			want = append(want, "fence")
+		}
+		if !reflect.DeepEqual(order, want) {
+			t.Fatal(order, want)
+		}
+	}
+}
+
+func TestRuntimeStorageRouteAllEdgesBeforeController(t *testing.T) {
+	var order []int
+	e := runtimeStorageRouteBeforeController(func() error {
+		return runtimeStorageRouteSequence(3, func(i int) (runtimeStorageRouteFacts, error) {
+			order = append(order, i*10)
+			return runtimeStorageRouteFacts{strict: true, traversalSafe: true}, nil
+		}, func(i int) error { order = append(order, i*10+1); return nil })
+	}, func() error { order = append(order, 99); return nil })
+	if e != nil || !reflect.DeepEqual(order, []int{0, 10, 11, 20, 21, 99}) {
+		t.Fatal(e, order)
+	}
+	for _, count := range []int{-1, 0, 1, 257} {
+		if runtimeStorageRouteSequence(count, func(int) (runtimeStorageRouteFacts, error) {
+			t.Fatal("invalid route inspected")
+			return runtimeStorageRouteFacts{}, nil
+		}, func(int) error { return nil }) == nil {
+			t.Fatal("invalid route admitted")
+		}
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_runtime_publication_route_windows.go b/rdd/pkg/managementconfig/upgrade_runtime_publication_route_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a91943d49fa8197eb0327f17874979ef4268de2b
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_runtime_publication_route_windows.go
@@ -0,0 +1,129 @@
+//go:build windows
+
+package managementconfig
+
+import "golang.org/x/sys/windows"
+
+// Routing nodes are not runtimeStorageObject grants. Only the complete route
+// can expose its independently strict publication boundary. Intermediate ACL
+// mutation is supported only for this compatibility-DATA route, never private
+// state, code, an import source, or a persistent pathname after release.
+type runtimeStorageRouteNode struct {
+	resource *runtimeStorageResource
+	identity runtimeStorageIdentity
+	facts    runtimeStorageRouteFacts
+	name     string // exactly one parsed component relative to previous retained node
+}
+type nativeRuntimePublicRoute struct {
+	nodes    []runtimeStorageRouteNode
+	boundary *runtimeStorageObject
+}
+
+func (n *nativeRuntimeStorage) captureRouteNode(h windows.Handle, name string) (runtimeStorageRouteNode, error) {
+	// Own the actual output before ANY inspection. The constructor's strong
+	// domain entry retains all of these resources on panic/unknown close.
+	r := n.keep(h)
+	f, e := runtimeStoragePublicFacts(h, n.sid, true)
+	if e != nil {
+		return runtimeStorageRouteNode{}, e
+	}
+	id, e := runtimeStorageMeasureIdentity(h, true)
+	if e != nil || !runtimeStorageRouteDescriptorMatches(f, id.descriptor) {
+		return runtimeStorageRouteNode{}, ErrUpgrade
+	}
+	return runtimeStorageRouteNode{r, id, f, name}, nil
+}
+
+func (r *nativeRuntimePublicRoute) check(n *nativeRuntimeStorage) error {
+	if r == nil || n == nil || n.unknown || !runtimeStorageDomainKnown() {
+		return ErrUpgrade
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			n.fence()
+			panic(p)
+		}
+	}()
+	return runtimeStorageRouteSequence(len(r.nodes), func(i int) (runtimeStorageRouteFacts, error) {
+		node := &r.nodes[i]
+		if node.resource == nil || node.resource.handle == 0 || node.resource.attempted {
+			return runtimeStorageRouteFacts{}, ErrUpgrade
+		}
+		f, e := runtimeStoragePublicFacts(node.resource.handle, n.sid, true)
+		if e != nil {
+			return f, e
+		}
+		id, e := runtimeStorageMeasureIdentity(node.resource.handle, true)
+		if e != nil || !runtimeStorageRouteDescriptorMatches(f, id.descriptor) || id != node.identity || f != node.facts {
+			return f, ErrUpgrade
+		}
+		return f, nil
+	}, func(i int) error {
+		parent, child := &r.nodes[i-1], &r.nodes[i]
+		// Reopen relative to the ACTUAL held parent. No path/ID DTO or by-name
+		// substitute confers an edge. Every selected open has real TRAVERSE so
+		// deny-share-DELETE participates in Windows share accounting.
+		h, e := n.open(parent.resource.handle, child.name, true, windows.FILE_OPEN, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil)
+		if e != nil {
+			return e
+		}
+		temporary := n.keep(h)
+		f, inspectErr := runtimeStoragePublicFacts(h, n.sid, true)
+		var id runtimeStorageIdentity
+		if inspectErr == nil {
+			id, inspectErr = runtimeStorageMeasureIdentity(h, true)
+		}
+		// Positive checked close required even for a known inspection refusal.
+		// A failed close fences and retains the complete owner, without retries.
+		if e = n.closeTemporary(temporary); e != nil {
+			return e
+		}
+		if inspectErr != nil || !runtimeStorageRouteDescriptorMatches(f, id.descriptor) || id != child.identity || f != child.facts {
+			return ErrUpgrade
+		}
+		return nil
+	})
+}
+
+// Fixed token-native route, EXISTING boundary only. This neither creates a
+// protected boundary nor grants a fresh-child producer capability.
+func (n *nativeRuntimeStorage) capturePublicRoute() (*nativeRuntimePublicRoute, error) {
+	volume, parts, e := readerComponents(n.local + `\OrbWinData`)
+	if e != nil || len(parts) == 0 || len(parts) >= 256 {
+		return nil, ErrUpgrade
+	}
+	p, e := windows.UTF16PtrFromString(volume)
+	if e != nil {
+		return nil, ErrUpgrade
+	}
+	h, e := windows.CreateFile(p, windows.FILE_TRAVERSE|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	h, e = n.observeOpen(h, e)
+	if e != nil {
+		return nil, e
+	}
+	r := &nativeRuntimePublicRoute{}
+	node, e := n.captureRouteNode(h, "")
+	if e != nil {
+		return nil, e
+	}
+	r.nodes = append(r.nodes, node)
+	for _, part := range parts {
+		h, e = n.open(node.resource.handle, part, true, windows.FILE_OPEN, windows.FILE_TRAVERSE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil)
+		if e != nil {
+			return nil, e
+		}
+		node, e = n.captureRouteNode(h, part)
+		if e != nil {
+			return nil, e
+		}
+		r.nodes = append(r.nodes, node)
+	}
+	if e = r.check(n); e != nil {
+		return nil, e
+	}
+	last := &r.nodes[len(r.nodes)-1]
+	// No relaxed node becomes a normal storage object. The completed predicate
+	// has checked strict actual final ACL and, when necessary, DACL protection.
+	r.boundary = &runtimeStorageObject{resource: last.resource, identity: last.identity, directory: true}
+	return r, nil
+}
