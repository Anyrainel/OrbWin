--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_provisional_windows.go
@@ -0,0 +1,60 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+)
+
+// Actual candidate PI retained before first Resume, with a one-use remote
+// process output in SDK's handle table and independently returned SAME object.
+// No metadata/PID constructor or logical-supervisor switch is supplied here.
+type nativeUpgradeSDKProvisional struct {
+	transfer         *nativeUpgradeSDKCandidateTransfer
+	candidate        *nativeUpgradeCandidate
+	remote, returned windows.Handle
+	admitted         bool
+}
+
+func (c *nativeUpgradeCandidate) provisionSDKSupervisor(ctx context.Context) (result error) {
+	if c == nil || c.launcher == nil || c.launcher.sdk == nil || ctx == nil || ctx.Err() != nil || c.resumeAttempted || c.resumed || c.process == 0 || c.thread == 0 {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	p := c.launcher.sdk
+	x := p.transfer
+	if x == nil || x.prepared != p || x.management == nil || x.management.sdk != x || !x.started || x.provisional != nil || p.child == nil || c.checkNative(ctx) != nil || !p.child.protocol.TryLock() {
+		return ErrUpgrade
+	}
+	defer p.child.protocol.Unlock()
+	child := p.child
+	if !child.controlOffered || child.sequence != 1 || x.wire.Sequence != 2 || x.wire.Schema != 6 || child.recheckIngressBirth(ctx) != nil {
+		return ErrUpgrade
+	}
+	s := &nativeUpgradeSDKProvisional{transfer: x, candidate: c}
+	x.provisional = s // retain every remote/roundtrip output BEFORE syscall/error
+	defer func() {
+		if result != nil {
+			child.mu.Lock()
+			child.unknown = true
+			child.mu.Unlock()
+		}
+	}()
+	rights := uint32(windows.PROCESS_QUERY_INFORMATION | windows.PROCESS_QUERY_LIMITED_INFORMATION | windows.PROCESS_DUP_HANDLE | windows.SYNCHRONIZE)
+	if windows.DuplicateHandle(windows.CurrentProcess(), c.process, child.process, &s.remote, rights, false, 0) != nil || s.remote == 0 || s.remote == windows.InvalidHandle {
+		return ErrUpgrade
+	}
+	child.sequence++ // reserved frame2, BEFORE bytes; no replay after lost ACK
+	record := &upgradeSDKSupervisorWire{uint64(s.remote), c.expected.PID, c.expected.Creation, c.expected.Session, c.expected.Image}
+	if _, err := child.exchangeControlLocked(ctx, upgradeSDKControlRequest{Schema: 1, Sequence: child.sequence, Operation: "provision-supervisor", Supervisor: record}); err != nil {
+		return ErrUpgrade
+	}
+	if windows.DuplicateHandle(child.process, s.remote, windows.CurrentProcess(), &s.returned, rights, false, 0) != nil || s.returned == 0 || sameUpgradeSDKKernelObject(c.process, s.returned) != nil || upgradeSDKCohortHandleRights(s.returned, rights, rights) != nil || c.checkNative(ctx) != nil || child.recheckIngressBirth(ctx) != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	s.admitted = true
+	return nil
+}
