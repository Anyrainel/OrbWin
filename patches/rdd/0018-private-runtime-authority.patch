index 0000000000000000000000000000000000000000..d4f257c7f6fc1cfcb86c0fb8e0e05ca7fb5b6ff8
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retained_retirement_windows_test.go
@@ -0,0 +1,135 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKRetainedProductSourceNegatives(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, r := range []*nativeUpgradeSDKResources{nil, {}, {source: &nativeUpgradeSDKJoinedSource{}}, {product: &nativeUpgradeSDKRetainedRetirement{}}} {
+		if r.retireProduct(ctx) == nil {
+			t.Fatal("missing actual ACK/source admitted")
+		}
+	}
+	r := &nativeUpgradeSDKResources{source: &nativeUpgradeSDKJoinedSource{}}
+	if r.retire(ctx) == nil || r.attempted {
+		t.Fatal("product used physical prototype")
+	}
+	for _, p := range []*nativeUpgradeSDKRetainedRetirement{nil, {}, {self: &nativeUpgradeSDKRetainedRetirement{}}} {
+		if p.ackLocked() == nil {
+			t.Fatal("copied/zero ACK authority")
+		}
+	}
+	o := &nativeUpgradeSDKServingOwner{}
+	if o.issueRetireAckLocked(1, upgradeSDKControlReply{Stage: "retirement-admitted"}) == nil || o.retireAck != nil {
+		t.Fatal("reply DTO minted actual ACK")
+	}
+	co := &nativeUpgradeSDKCohort{}
+	if co.requireRetirementSupport(o) == nil || co.requireRetirementAdmission(o) == nil {
+		t.Fatal("whole-support gate changed")
+	}
+	cancel()
+	if (&nativeUpgradeSDKResources{}).retireProduct(ctx) == nil || co.waitCaptured(ctx) == nil {
+		t.Fatal("cancelled entry reached a native barrier")
+	}
+}
+func TestUpgradeSDKRetainedExactClosedPartialRemoval(t *testing.T) {
+	root := upgradeSDKCohortGeneration{1, 2}
+	g := upgradeSDKCohortGeneration{3, 4}
+	m := &nativeUpgradeSDKCohortMember{generation: g}
+	other := &nativeUpgradeSDKCohortMember{generation: root}
+	makeCo := func() *nativeUpgradeSDKCohort {
+		return &nativeUpgradeSDKCohort{root: UpgradeProcess{PID: 1, Creation: 2}, ledger: upgradeSDKCohortLedger{root: &root, total: 2, retired: 1, members: map[upgradeSDKCohortGeneration]bool{root: true}}, members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{root: other, g: m}, partial: []*nativeUpgradeSDKCohortMember{other, m, m}}
+	}
+	co := makeCo()
+	co.partial = nil // normal receiver birth has transferred custody to members
+	if co.removeClosedPartial(m) != nil {
+		t.Fatal("closed compacted map-only member refused")
+	}
+	co = makeCo()
+	if co.removeClosedPartial(m) != nil || len(co.partial) != 1 || co.partial[0] != other {
+		t.Fatal("exact pointer aliases not retired")
+	}
+	foreign := &nativeUpgradeSDKCohortMember{generation: g}
+	co = makeCo()
+	co.partial = append(co.partial, foreign)
+	before := len(co.partial)
+	if co.removeClosedPartial(m) == nil || len(co.partial) != before {
+		t.Fatal("foreign same-generation partial swept")
+	}
+	co = makeCo()
+	m.process = 123
+	if co.removeClosedPartial(m) == nil {
+		t.Fatal("pending native cap discarded")
+	}
+	m.process = 0
+	co = makeCo()
+	if co.removeClosedPartial(other) == nil {
+		t.Fatal("root compacted")
+	}
+}
+
+func TestUpgradeSDKRetainedClosedAliasHistoryStaysBounded(t *testing.T) {
+	root := upgradeSDKCohortGeneration{1, 2}
+	rootMember := &nativeUpgradeSDKCohortMember{generation: root}
+	co := &nativeUpgradeSDKCohort{root: UpgradeProcess{PID: 1, Creation: 2}, members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{root: rootMember}, partial: []*nativeUpgradeSDKCohortMember{rootMember}}
+	if co.ledger.registerRoot(root) != nil || co.ledger.observe(1, 1) != nil {
+		t.Fatal("root model")
+	}
+	// DATA model of the actual closed-member helper after checked native slots
+	// have become zero. No native ACK/owner or positive native cap is fabricated.
+	for n := uint32(1); n <= 4096; n++ {
+		g := upgradeSDKCohortGeneration{3, uint64(n) + 10}
+		m := &nativeUpgradeSDKCohortMember{generation: g, joined: true}
+		if co.ledger.captureIssuedLeaf(g, uint64(n)) != nil || co.ledger.observe(n+1, 2) != nil || co.ledger.joined(g) != nil {
+			t.Fatal("actual ledger transition", n)
+		}
+		co.members[g] = m
+		// Normal birth removes the partial slot; initial-capture aliases may
+		// still exist. Exercise both actual ownership shapes.
+		if n%2 == 0 {
+			co.partial = append(co.partial, m, m)
+		}
+		if co.removeClosedPartial(m) == nil {
+			t.Fatal("removed before actual successful compaction")
+		}
+		if co.ledger.compact(g) != nil || co.removeClosedPartial(m) != nil {
+			t.Fatal("actual helper failed", n)
+		}
+		delete(co.members, g)
+		if co.ledger.observe(n+1, 1) != nil || co.ledger.complete() != nil || len(co.partial) != 1 || co.partial[0] != rootMember || len(co.members) != 1 {
+			t.Fatal("zero-history accumulated", n)
+		}
+	}
+}
+
+func TestUpgradeSDKRetainedOptionalPartialCustody(t *testing.T) {
+	g := upgradeSDKCohortGeneration{3, 4}
+	m := &nativeUpgradeSDKCohortMember{generation: g}
+	co := &nativeUpgradeSDKCohort{members: map[upgradeSDKCohortGeneration]*nativeUpgradeSDKCohortMember{g: m}}
+	known := map[*nativeUpgradeSDKCohortMember]bool{m: true}
+	if co.checkRetainedPartialAliases(known) != nil {
+		t.Fatal("map-only member required alias")
+	}
+	co.partial = []*nativeUpgradeSDKCohortMember{m, m}
+	if co.checkRetainedPartialAliases(known) != nil {
+		t.Fatal("exact aliases refused")
+	}
+	foreign := &nativeUpgradeSDKCohortMember{generation: g}
+	for _, part := range []*nativeUpgradeSDKCohortMember{nil, foreign, {generation: upgradeSDKCohortGeneration{5, 6}, process: 123}} {
+		co.partial = []*nativeUpgradeSDKCohortMember{part}
+		if co.checkRetainedPartialAliases(known) == nil {
+			t.Fatal("unknown or foreign partial accepted")
+		}
+	}
+	co.partial = []*nativeUpgradeSDKCohortMember{m}
+	delete(co.members, g)
+	if co.checkRetainedPartialAliases(known) == nil {
+		t.Fatal("detached partial accepted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retirement.go b/rdd/pkg/managementconfig/upgrade_sdk_retirement.go
new file mode 100644
index 0000000000000000000000000000000000000000..e9a2530d6c2b74682221d0087dfd8cd35990b25f
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retirement.go
@@ -0,0 +1,83 @@
+package managementconfig
+
+import (
+	"context"
+	"time"
+)
+
+// Both actual native close owners use this unwind guard. A nil named result
+// during panic is never a completed native sequence. Retain is installed before
+// the first effect; publish may release that guard only after normal success.
+func runUpgradeSDKCloseBody(retain func(), perform func() error, publish func(error, bool)) (result error) {
+	completed := false
+	defer func() {
+		if !completed || result != nil {
+			publish(ErrUpgrade, false)
+		} else {
+			publish(nil, true)
+		}
+	}()
+	retain()
+	result = perform()
+	completed = result == nil
+	return result
+}
+
+// Called only after actual captured SDK root exit zero and scope rechecks. The
+// native owner binds every callback to its retained born-in-job objects. Job
+// query remains possible through empty observation and I/O join; a lost native
+// operation never falls through to job/controller release. No retry owner or
+// public grant constructor exists here.
+func finishUpgradeSDKRetirement(ctx context.Context, active func() (uint32, error), terminate, joinIO, closeJob, release func() error) error {
+	if ctx == nil || ctx.Err() != nil || active == nil || terminate == nil || joinIO == nil || closeJob == nil || release == nil {
+		return ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return ErrUpgrade
+	}
+	if drainUpgradeSDKRetirementJob(ctx, active, terminate) != nil {
+		return ErrUpgrade
+	}
+	if ctx.Err() != nil || joinIO() != nil || ctx.Err() != nil || closeJob() != nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	return release()
+}
+
+// Actual fixed product and physical owners share drain observations only.
+// This does not close anything or prove retained-member signal/late-birth seal.
+func drainUpgradeSDKRetirementJob(ctx context.Context, active func() (uint32, error), terminate func() error) error {
+	if ctx == nil || ctx.Err() != nil || active == nil || terminate == nil {
+		return ErrUpgrade
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrUpgrade
+	}
+	count, err := active()
+	if err != nil {
+		return ErrUpgrade
+	}
+	if count != 0 {
+		if ctx.Err() != nil || terminate() != nil {
+			return ErrUpgrade
+		}
+		for {
+			if ctx.Err() != nil {
+				return ErrUpgrade
+			}
+			count, err = active()
+			if err != nil {
+				return ErrUpgrade
+			}
+			if count == 0 {
+				break
+			}
+			select {
+			case <-ctx.Done():
+				return ErrUpgrade
+			case <-time.After(20 * time.Millisecond):
+			}
+		}
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retirement_panic_test.go b/rdd/pkg/managementconfig/upgrade_sdk_retirement_panic_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..795544ed08d60609f287aa39413297e80b19c461
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retirement_panic_test.go
@@ -0,0 +1,56 @@
+package managementconfig
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestUpgradeSDKCloseUnwindCannotPublishNilSuccess(t *testing.T) {
+	for _, mode := range []string{"panic", "error", "success"} {
+		t.Run(mode, func(t *testing.T) {
+			retained, released, published := false, false, false
+			var cached error = ErrUpgrade
+			var steps []string
+			func() {
+				defer func() {
+					value := recover()
+					if mode == "panic" && value == nil {
+						t.Error("panic disappeared")
+					}
+					if mode != "panic" && value != nil {
+						t.Errorf("unexpected panic: %v", value)
+					}
+				}()
+				result := runUpgradeSDKCloseBody(func() { retained = true }, func() error {
+					if !retained {
+						t.Fatal("native body entered without graph pin")
+					}
+					steps = append(steps, "joined")
+					if mode == "panic" {
+						panic("inert close body unwind")
+					}
+					if mode == "error" {
+						return errors.New("unknown close")
+					}
+					steps = append(steps, "controllers-last")
+					return nil
+				}, func(err error, complete bool) {
+					cached = err
+					published = true
+					if complete {
+						released = true
+					}
+				})
+				if (result == nil) != (mode == "success") {
+					t.Error("body result changed")
+				}
+			}()
+			if !published || !retained || released != (mode == "success") || (cached == nil) != (mode == "success") {
+				t.Fatal("unfinished body published completion or dropped actual guard", mode)
+			}
+			if mode != "success" && len(steps) != 1 {
+				t.Fatal("failure fell through to release")
+			}
+		})
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_retirement_test.go b/rdd/pkg/managementconfig/upgrade_sdk_retirement_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0c4ec38e4529d7b56bff11917778584a0e0caff3
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_retirement_test.go
@@ -0,0 +1,74 @@
+package managementconfig
+
+import (
+	"context"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKRetirementRetainsQueryableJobUntilEmptyAndIOJoin(t *testing.T) {
+	for _, fault := range []string{"", "query", "terminate", "query-after-terminate", "io", "job-close", "controller-release"} {
+		t.Run(fault, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			var events []string
+			queries, terminations := 0, 0
+			step := func(name string) func() error {
+				return func() error {
+					events = append(events, name)
+					if fault == name {
+						return ErrUpgrade
+					}
+					return nil
+				}
+			}
+			err := finishUpgradeSDKRetirement(ctx, func() (uint32, error) {
+				queries++
+				name := "query"
+				if queries > 1 {
+					name = "query-after-terminate"
+				}
+				events = append(events, name)
+				if fault == name {
+					return 0, ErrUpgrade
+				}
+				if queries == 1 {
+					return 2, nil
+				}
+				return 0, nil
+			}, func() error { terminations++; return step("terminate")() }, step("io"), step("job-close"), step("controller-release"))
+			if (err == nil) != (fault == "") || terminations > 1 {
+				t.Fatal("unknown native result admitted/retried", err, events)
+			}
+			want := []string{"query", "terminate", "query-after-terminate", "io", "job-close", "controller-release"}
+			if fault != "" {
+				for n, name := range want {
+					if name == fault {
+						want = want[:n+1]
+						break
+					}
+				}
+			}
+			if !reflect.DeepEqual(events, want) {
+				t.Fatal("authority released before exact job/IO sequence", events, want)
+			}
+		})
+	}
+}
+
+func TestUpgradeSDKRetirementEmptyJobNeverTerminatesAndCanceledJoinNeverReleases(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	var events []string
+	if finishUpgradeSDKRetirement(ctx, func() (uint32, error) { events = append(events, "empty"); return 0, nil }, func() error { t.Fatal("empty job terminated"); return nil }, func() error { events = append(events, "io"); return nil }, func() error { events = append(events, "job"); return nil }, func() error { events = append(events, "controller"); return nil }) != nil || !reflect.DeepEqual(events, []string{"empty", "io", "job", "controller"}) {
+		t.Fatal(events)
+	}
+	canceled, stop := context.WithTimeout(context.Background(), time.Second)
+	defer stop()
+	queries := 0
+	never := func() error { t.Fatal("canceled retirement released owner"); return nil }
+	if finishUpgradeSDKRetirement(canceled, func() (uint32, error) { queries++; return 1, nil }, func() error { stop(); return nil }, never, never, never) == nil || queries != 1 {
+		t.Fatal("canceled termination not retained", queries)
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_serving_control_windows.go b/rdd/pkg/managementconfig/upgrade_sdk_serving_control_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..dac4065a9416d222e9c25557caf6b0edf3de224d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_serving_control_windows.go
@@ -0,0 +1,416 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"golang.org/x/sys/windows"
+	"time"
+	"unsafe"
+)
+
+// One worker owns the SAME original control pipe after birth inheritance. It
+// starts the existing SDK runtime, waits for the original TEMP final slot via
+// commit, then adopts actual duplicated exclusions before supervisor acceptance.
+func (o *nativeUpgradeSDKServingOwner) bootstrap() {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Minute)
+	defer cancel()
+	var err error
+	for _, operation := range []string{"start-runtime", "commit", "offer-controller", "retain-controller"} {
+		if operation == "commit" {
+			err = o.waitFinal(ctx)
+			if err != nil {
+				break
+			}
+		}
+		var reply upgradeSDKControlReply
+		reply, err = driveUpgradeSDKBootstrapOperation(ctx, operation, o.call)
+		if err != nil {
+			break
+		}
+		if operation == "offer-controller" {
+			err = o.adoptControllers(ctx, reply.Controller)
+			if err != nil {
+				break
+			}
+		}
+	}
+	if err == nil {
+		err = windows.SetEvent(o.supervisor)
+	}
+	o.mu.Lock()
+	o.bootstrapErr = err
+	if err != nil {
+		o.unknown = true
+		retainUnknownUpgradeSDKServingOwner(o)
+	} else {
+		o.supervisorReady = true
+		o.heartbeatStop, o.heartbeatDone = make(chan struct{}), make(chan struct{})
+		go o.heartbeat()
+	}
+	close(o.bootstrapDone)
+	o.mu.Unlock()
+}
+
+// Engine/candidate validation may exceed one native IO deadline. Wait on the
+// actual read-only final event outside a frame, sending bounded no-effect
+// keepalives until TEMP has positively sealed/signaled its original final slot.
+func (o *nativeUpgradeSDKServingOwner) waitFinal(ctx context.Context) error {
+	next := time.Now().Add(250 * time.Millisecond)
+	for {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		state, err := windows.WaitForMultipleObjects([]windows.Handle{o.finalEvent, o.process, o.permit.parent.handle}, false, 20)
+		if err != nil {
+			return ErrUpgrade
+		}
+		if state == uint32(windows.WAIT_OBJECT_0) {
+			return o.checkNative(ctx)
+		}
+		if state != uint32(windows.WAIT_TIMEOUT) {
+			return ErrUpgrade
+		}
+		if time.Now().After(next) {
+			if _, err := o.call(ctx, "keepalive"); err != nil {
+				return err
+			}
+			next = time.Now().Add(250 * time.Millisecond)
+		}
+	}
+}
+
+// The actual serving owner keeps the original bounded control read alive.
+// Shutdown joins this sole writer without canceling an in-flight frame.
+func (o *nativeUpgradeSDKServingOwner) heartbeat() {
+	defer close(o.heartbeatDone)
+	ticker := time.NewTicker(250 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-o.heartbeatStop:
+			return
+		case <-ticker.C:
+		}
+		o.mu.Lock()
+		stop := o.closeAttempted || o.unknown || o.closed
+		o.mu.Unlock()
+		if stop {
+			return
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		_, err := o.call(ctx, "keepalive")
+		cancel()
+		if err != nil {
+			return
+		}
+	}
+}
+
+func (o *nativeUpgradeSDKServingOwner) joinHeartbeat(ctx context.Context) error {
+	o.mu.Lock()
+	if o.heartbeatStop == nil || o.heartbeatDone == nil {
+		o.mu.Unlock()
+		return ErrUpgrade
+	}
+	if !o.heartbeatStopped {
+		close(o.heartbeatStop)
+		o.heartbeatStopped = true
+	}
+	done := o.heartbeatDone
+	o.mu.Unlock()
+	select {
+	case <-done:
+		return nil
+	case <-ctx.Done():
+		return ErrUpgrade
+	}
+}
+
+func (o *nativeUpgradeSDKServingOwner) call(ctx context.Context, operation string) (reply upgradeSDKControlReply, result error) {
+	if o == nil || ctx == nil || ctx.Err() != nil || !o.protocol.TryLock() {
+		return reply, ErrUpgrade
+	}
+	defer o.protocol.Unlock()
+	o.mu.Lock()
+	bad := o.unknown || o.closed
+	o.mu.Unlock()
+	if bad || o.checkNative(ctx) != nil || o.sequence == ^uint32(0) {
+		return reply, ErrUpgrade
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			o.fenceLeafReceiver()
+			panic(p)
+		}
+		if result != nil {
+			o.fenceLeafReceiver()
+		}
+	}()
+	// exchangeControlLocked consumes the next sequence. The caller exclusively
+	// owns protocol across both the original reply and its optional leaf ACK.
+	reply, result = o.exchangeControlLocked(ctx, upgradeSDKControlRequest{Operation: operation})
+	if result != nil {
+		return reply, result
+	}
+	if reply.Leaf != nil {
+		result = o.acceptSDKLeafOffer(ctx, reply.Leaf)
+	}
+	return reply, result
+}
+
+// Only the actual original control owner calls this with protocol held. The
+// sole initialization caller additionally proves actual cohort/master custody;
+// there is no public raw-frame or unknown-owner bypass parameter.
+func (o *nativeUpgradeSDKServingOwner) exchangeControlLocked(ctx context.Context, request upgradeSDKControlRequest) (reply upgradeSDKControlReply, result error) {
+	if o == nil || ctx == nil || ctx.Err() != nil || o.io == nil || o.io.pipe != o.control || o.sequence == ^uint32(0) || !request.validPayload() {
+		return reply, ErrUpgrade
+	}
+	// The SAME original protocol lock protects this immediate source recheck.
+	// Resource-capture adjacency alone must not authorize final retire bytes.
+	if request.Operation == "retire" && (o.joinedSource == nil || o.joinedSource.checkLocked(ctx) != nil) {
+		return reply, ErrUpgrade
+	}
+	if o.checkNative(ctx) != nil {
+		return reply, ErrUpgrade
+	}
+	o.sequence++ // BEFORE first byte; lost replies are never replayed
+	request.Schema, request.Sequence = 1, o.sequence
+	body, err := json.Marshal(request)
+	if err != nil {
+		return reply, ErrUpgrade
+	}
+	var header [4]byte
+	binary.LittleEndian.PutUint32(header[:], uint32(len(body)))
+	if o.controlFull(ctx, header[:], true) != nil || o.controlFull(ctx, body, true) != nil || o.controlFull(ctx, header[:], false) != nil {
+		return reply, ErrUpgrade
+	}
+	size := binary.LittleEndian.Uint32(header[:])
+	if size == 0 || size > 2<<20 {
+		return reply, ErrUpgrade
+	}
+	body = make([]byte, size)
+	if o.controlFull(ctx, body, false) != nil || request.Operation != "retire" && o.checkNative(ctx) != nil {
+		return reply, ErrUpgrade
+	}
+	reply, result = parseUpgradeSDKControlReply(body, o.sequence, request.Operation)
+	if result == nil && request.Operation == "retire" {
+		result = o.issueRetireAckLocked(o.sequence, reply)
+	}
+	return reply, result
+}
+
+func (o *nativeUpgradeSDKServingOwner) readyToClose() error {
+	if o == nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.closed {
+		return o.closeErr
+	}
+	if o.unknown || !o.supervisorReady || o.bootstrapDone == nil || o.controllers == [4]windows.Handle{} {
+		return ErrUpgrade
+	}
+	select {
+	case <-o.bootstrapDone:
+	default:
+		return ErrUpgrade
+	}
+	if o.bootstrapErr != nil {
+		return ErrUpgrade
+	}
+	if o.cohort == nil || o.cohort.requireRetirementSupport(o) != nil {
+		return ErrUpgrade
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	return o.checkNative(ctx)
+}
+
+// The actual serving-rdd permit is the sole caller. A known readiness refusal
+// has no native effect; after admission every close/termination is one-use and
+// unknown retains this owner. Only this born-in-job SDK scope may be terminated.
+func (o *nativeUpgradeSDKServingOwner) close() (result error) {
+	if o == nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	if o.closeAttempted {
+		result = o.closeErr
+		o.mu.Unlock()
+		return result
+	}
+	o.mu.Unlock()
+	// Missing support is a known no-effect refusal. Do not consume close or
+	// stop the sole heartbeat/pump before all retirement families are present.
+	if o.readyToClose() != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	if o.closeAttempted {
+		result = o.closeErr
+		o.mu.Unlock()
+		return result
+	}
+	if o.unknown || !o.supervisorReady {
+		o.mu.Unlock()
+		return ErrUpgrade
+	}
+	o.closeAttempted, o.closeErr = true, ErrUpgrade
+	o.mu.Unlock()
+	return runUpgradeSDKCloseBody(func() { retainUnknownUpgradeSDKServingOwner(o) }, func() error { return o.closeNative() }, func(err error, completed bool) {
+		o.mu.Lock()
+		o.closeErr = err
+		o.closed = completed
+		o.unknown = !completed
+		o.mu.Unlock()
+		if completed {
+			releaseClosedUpgradeSDKServingOwner(o)
+		}
+	})
+}
+
+func (o *nativeUpgradeSDKServingOwner) closeNative() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
+	defer cancel()
+	if o.joinHeartbeat(ctx) != nil {
+		return ErrUpgrade
+	}
+	// This caller now owns the same serialized pump after the actual heartbeat
+	// joined. Do not block it in SDK's actor Join: seal promptly, keep bounded
+	// drain exchanges alive, then admit the final retire frame only after Join.
+	source, err := o.drainNativeRuntimeSource(ctx)
+	if err != nil {
+		return ErrUpgrade
+	}
+	// Final joined admission follows the actual source join while SDK is live;
+	// support preflight above must never demand an already joined participant.
+	resources, err := o.captureResources(ctx, source)
+	if err != nil {
+		return ErrUpgrade
+	}
+	if _, err := o.call(ctx, "retire"); err != nil {
+		return ErrUpgrade
+	}
+	return resources.retireProduct(ctx)
+}
+
+func (o *nativeUpgradeSDKServingOwner) releaseRetiredControllers() error {
+	closeHandle := func(h *windows.Handle) error {
+		if *h != 0 {
+			if windows.CloseHandle(*h) != nil {
+				return ErrUpgrade
+			}
+			*h = 0
+		}
+		return nil
+	}
+	// Empty job and all control I/O are positive BEFORE any exclusion release.
+	if o.job != 0 || closeHandle(&o.process) != nil || closeHandle(&o.image) != nil {
+		return ErrUpgrade
+	}
+	if o.token != 0 {
+		if o.token.Close() != nil {
+			return ErrUpgrade
+		}
+		o.token = 0
+	}
+	for _, h := range []*windows.Handle{&o.acceptance, &o.supervisor, &o.finalEvent, &o.selfImage, &o.file} {
+		if closeHandle(h) != nil {
+			return ErrUpgrade
+		}
+	}
+	if o.code == nil || o.code.Close() != nil {
+		return ErrUpgrade
+	}
+	for _, n := range []int{3, 2, 1, 0} {
+		if closeHandle(&o.controllers[n]) != nil {
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
+
+func upgradeSDKJobActive(job windows.Handle) (uint32, error) {
+	var accounting struct {
+		TotalUser, TotalKernel, PeriodUser, PeriodKernel int64
+		PageFaults, Total, Active, Terminated            uint32
+	}
+	if job == 0 || windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&accounting)), uint32(unsafe.Sizeof(accounting)), nil) != nil {
+		return 0, ErrUpgrade
+	}
+	return accounting.Active, nil
+}
+
+func (o *nativeUpgradeSDKServingOwner) controlFull(ctx context.Context, body []byte, write bool) error {
+	for len(body) != 0 {
+		chunk := body
+		if len(chunk) > 64<<10 {
+			chunk = chunk[:64<<10]
+		}
+		n, err := o.io.perform(ctx, chunk, write)
+		if err != nil || n <= 0 || n > len(chunk) {
+			return ErrUpgrade
+		}
+		body = body[n:]
+	}
+	return nil
+}
+
+// Only an actual reply from this native mapped SDK peer enters this method.
+// Record the entire incoming native set before validation so partial admission
+// never loses the remote handles. SDK independently compares the roundtrip to
+// its actual originals before acknowledging this candidate as supervisor.
+func (o *nativeUpgradeSDKServingOwner) adoptControllers(ctx context.Context, roles *[4]uint64) error {
+	if roles == nil || o.checkNative(ctx) != nil {
+		return ErrUpgrade
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.unknown || o.controllers != [4]windows.Handle{} {
+		return ErrUpgrade
+	}
+	for n, raw := range roles {
+		o.controllers[n] = windows.Handle(raw)
+	}
+	seen := map[windows.Handle]bool{}
+	for _, h := range []windows.Handle{o.file, o.job, o.process, windows.Handle(o.token), o.image, o.control, o.acceptance, o.supervisor, o.finalEvent} {
+		seen[h] = true
+	}
+	for n, h := range o.controllers {
+		if h == 0 || h == windows.InvalidHandle || uint64(h) != roles[n] || seen[h] {
+			o.unknown = true
+			return ErrUpgrade
+		}
+		seen[h] = true
+		dir := n == 2
+		if verifyPrivate(h, o.permit.root.sid, dir) != nil {
+			o.unknown = true
+			return ErrUpgrade
+		}
+		var info windows.ByHandleFileInformation
+		if windows.GetFileInformationByHandle(h, &info) != nil || info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != dir || n == 1 && info.FileAttributes&windows.FILE_ATTRIBUTE_READONLY == 0 {
+			o.unknown = true
+			return ErrUpgrade
+		}
+		var basic [14]uint32
+		var length uint32
+		status, _, _ := windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQueryObject").Call(uintptr(h), 0, uintptr(unsafe.Pointer(&basic)), unsafe.Sizeof(basic), uintptr(unsafe.Pointer(&length)))
+		access := basic[1]
+		forbidden := uint32(windows.DELETE | windows.WRITE_OWNER)
+		if n != 2 {
+			forbidden |= windows.WRITE_DAC
+		}
+		if n != 0 && !dir {
+			forbidden |= windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA
+		}
+		if status != 0 || access&forbidden != 0 || access&(windows.READ_CONTROL|windows.SYNCHRONIZE|windows.FILE_READ_DATA) != windows.READ_CONTROL|windows.SYNCHRONIZE|windows.FILE_READ_DATA || n == 0 && access&windows.FILE_WRITE_DATA == 0 {
+			o.unknown = true
+			return ErrUpgrade
+		}
+	}
+	return nil
+}
