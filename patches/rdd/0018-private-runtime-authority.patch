+package managementconfig
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestUpgradeTCPTableBoundsAndIndependentNativeOwnerRows(t *testing.T) {
+	for _, family := range []uint8{4, 6} {
+		size, portOffset, pidOffset := 24, 8, 20
+		if family == 6 {
+			size, portOffset, pidOffset = 56, 20, 52
+		}
+		data := make([]byte, 4+size)
+		binary.LittleEndian.PutUint32(data, 1)
+		entry := data[4:]
+		binary.BigEndian.PutUint16(entry[portOffset:], 6443)
+		binary.LittleEndian.PutUint32(entry[pidOffset:], 123)
+		if family == 4 {
+			entry[4], entry[7] = 127, 1
+			binary.LittleEndian.PutUint32(entry, 2)
+		} else {
+			entry[15] = 1
+			binary.LittleEndian.PutUint32(entry[48:], 2)
+		}
+		rows, err := parseUpgradeTCPTable(data, family)
+		if err != nil || len(rows) != 1 || rows[0].port != 6443 || rows[0].pid != 123 || rows[0].state != 2 {
+			t.Fatal("native row decoding failed")
+		}
+		if _, err := parseUpgradeTCPTable(data[:len(data)-1], family); err == nil {
+			t.Fatal("truncated native table counted as absence")
+		}
+		entry[portOffset+2] = 1
+		if _, err := parseUpgradeTCPTable(data, family); err == nil {
+			t.Fatal("invalid native port upper word accepted")
+		}
+	}
+	if _, err := parseUpgradeTCPTable([]byte{0xff, 0xff, 0xff, 0xff}, 4); err == nil {
+		t.Fatal("unbounded table counted as empty")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_tcp_windows.go b/rdd/pkg/managementconfig/upgrade_tcp_windows.go
