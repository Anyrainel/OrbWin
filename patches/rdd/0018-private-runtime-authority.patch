@@ -0,0 +1,34 @@
+package managementconfig
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKBirthRefusesOuterJobOrUnknownBeforeEffects(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		member   bool
+		queryErr error
+		want     error
+	}{{"job-free", false, nil, nil}, {"outer-job", true, nil, ErrUpgradeJobbed}, {"unknown", false, ErrUpgrade, ErrUpgrade}} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			calls := 0
+			err := requireUpgradeNoOuterJob(ctx, func() (bool, error) { calls++; return test.member, test.queryErr })
+			if calls != 1 || !errors.Is(err, test.want) {
+				t.Fatal("outer-job gate lost native result", calls, err)
+			}
+		})
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	for _, ctx := range []context.Context{nil, context.Background(), ctx} {
+		if requireUpgradeNoOuterJob(ctx, func() (bool, error) { t.Fatal("invalid owner context queried/admitted birth"); return false, nil }) == nil {
+			t.Fatal("unbounded/canceled birth admitted")
+		}
+	}
+}
