+	limits.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+	configured, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&limits)), uint32(unsafe.Sizeof(limits)))
+	if err != nil || configured == 0 || checkUpgradeSDKJobLimits(job) != nil || checkUpgradeSDKJobBirth(job, 0) != nil {
+		return ErrUpgrade
+	}
+	if windows.SetHandleInformation(image, windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT) != nil {
+		return ErrUpgrade
+	}
+	handles := []windows.Handle{pipe.controlServer, image}
+	jobs := []windows.Handle{job}
+	attrs, err := windows.NewProcThreadAttributeList(2)
+	if err != nil {
+		return err
+	}
+	defer attrs.Delete()
+	if attrs.Update(windows.PROC_THREAD_ATTRIBUTE_HANDLE_LIST, unsafe.Pointer(&handles[0]), uintptr(len(handles))*unsafe.Sizeof(handles[0])) != nil || attrs.Update(upgradeSDKJobListAttribute, unsafe.Pointer(&jobs[0]), unsafe.Sizeof(jobs[0])) != nil {
+		return ErrUpgrade
+	}
+	line, err := windows.UTF16PtrFromString(windows.ComposeCommandLine([]string{path, "resources-child", strconv.FormatUint(uint64(pipe.controlServer), 10), strconv.FormatUint(uint64(image), 10)}))
+	if err != nil {
+		return err
+	}
+	si := windows.StartupInfoEx{ProcThreadAttributeList: attrs.List()}
+	si.Cb = uint32(unsafe.Sizeof(si))
+	var info windows.ProcessInformation
+	err = windows.CreateProcess(app, line, nil, nil, true, windows.CREATE_SUSPENDED|windows.CREATE_NO_WINDOW|windows.EXTENDED_STARTUPINFO_PRESENT, nil, nil, &si.StartupInfo, &info)
+	process, thread = info.Process, info.Thread
+	runtime.KeepAlive(handles)
+	runtime.KeepAlive(jobs)
+	if err != nil || process == 0 || thread == 0 {
+		return ErrUpgrade
+	}
+	if queryUpgradeObservedImage(process, image) != nil {
+		return ErrUpgrade
+	}
+	out.OwnMappedChild = true
+	if checkUpgradeSDKJobBirth(job, info.ProcessId) != nil {
+		return ErrUpgrade
+	}
+	out.BirthOnlySingleton = true
+	var childSession uint32
+	var childToken windows.Token
+	if windows.ProcessIdToSessionId(info.ProcessId, &childSession) != nil || childSession != session || windows.OpenProcessToken(process, windows.TOKEN_QUERY, &childToken) != nil {
+		return ErrUpgrade
+	}
+	childOrdinary := legacySDKOrdinaryToken(childToken, sid, session)
+	childTokenClose := childToken.Close()
+	if childOrdinary != nil || childTokenClose != nil {
+		return ErrUpgrade
+	}
+	var created, exited, kernel, user windows.Filetime
+	if windows.GetProcessTimes(process, &created, &exited, &kernel, &user) != nil {
+		return ErrUpgrade
+	}
+	expected := UpgradeProcess{info.ProcessId, uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), session, imageSHA}
+	out.OwnRoot = expected
+	if closeHandle(&pipe.controlServer) != nil {
+		return ErrUpgrade
+	}
+	previous, err := windows.ResumeThread(thread)
+	if err != nil || previous != 1 {
+		return ErrUpgrade
+	}
+	if closeHandle(&thread) != nil {
+		return ErrUpgrade
+	}
+	io := &upgradeSDKControlIO{pipe: pipe.controlClient}
+	resources = &nativeUpgradeSDKResources{process: &process, job: &job, control: &pipe.controlClient, expected: expected, io: io}
+	resources.release = func() error {
+		if job != 0 || io.pipe != 0 || io.op != nil || io.unknown {
+			return ErrUpgrade
+		}
+		// Qualification-only stronger callback: observe the SAME captured
+		// descendant stopped before ANY process/image/controller release. This
+		// does not silently change the product job-empty retirement predicate.
+		if sdkResourcesFixtureJoinDescendant(ctx, descendant, out) != nil {
+			return ErrUpgrade
+		}
+		if closeHandle(&process) != nil || closeHandle(&image) != nil {
+			return ErrUpgrade
+		}
+		for _, n := range []int{3, 2, 1, 0} {
+			if closeHandle(&controllers[n]) != nil {
+				return ErrUpgrade
+			}
+		}
+		return nil
+	}
+	transferred = true // The holder owns the complete graph before any raw I/O.
+	// A real original raw operation completes before the captured root exits.
+	// The resource owner independently refuses any unknown or pinned operation.
+	if n, err := io.perform(ctx, []byte{0x52}, true); err != nil || n != 1 {
+		return ErrUpgrade
+	}
+	var reply [1]byte
+	if n, err := io.perform(ctx, reply[:], false); err != nil || n != 1 || reply[0] != 0xa5 {
+		return ErrUpgrade
+	}
+	out.ControlRoundTrip = true
+	var observation [12]byte
+	if n, err := io.perform(ctx, observation[:], false); err != nil || n != len(observation) {
+		return errors.New("descendant observation frame")
+	}
+	out.DescendantPID = binary.LittleEndian.Uint32(observation[:4])
+	out.DescendantCreation = binary.LittleEndian.Uint64(observation[4:])
+	descendant, err = windows.OpenProcess(windows.PROCESS_QUERY_INFORMATION|windows.SYNCHRONIZE, false, out.DescendantPID)
+	if err != nil || sdkResourcesFixtureObserveDescendant(descendant, image, job, expected, out.DescendantCreation, sid) != nil {
+		return errors.New("descendant native observation refused")
+	}
+	out.DescendantObserved = true
+	out.BeforeResume = sdkResourcesFixtureJobSnapshot(job)
+	var parentMember uint32
+	parentMemberStatus, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(windows.CurrentProcess()), uintptr(job), uintptr(unsafe.Pointer(&parentMember)))
+	if parentMemberStatus == 0 || parentMember != 0 {
+		return errors.New("fixture parent unexpectedly contained in owned job")
+	}
+	out.ParentNotInOwnedJob = true
+	if out.BeforeResume.AccountingError != "" || out.BeforeResume.ListError != "" {
+		return errors.New("owned job query failed before descendant resume")
+	}
+	out.BeforeMembers, out.BeforeResumeFinal, err = sdkResourcesFixtureObserveMembers(ctx, job, out.BeforeResume, expected, out.DescendantPID, out.DescendantCreation, sid, &memberCaps)
+	if err != nil {
+		return errors.New("pre-resume owned-member observation incomplete")
+	}
+	if n, err := io.perform(ctx, []byte{0x53}, true); err != nil || n != 1 {
+		return ErrUpgrade
+	}
+	if n, err := io.perform(ctx, reply[:], false); err != nil || n != 1 || reply[0] != 0xa6 {
+		return ErrUpgrade
+	}
+	if status, err := windows.WaitForSingleObject(descendant, 0); err != nil || status != uint32(windows.WAIT_TIMEOUT) {
+		return errors.New("descendant did not remain live for owned-job retirement")
+	}
+	captureCtx, captureCancel := context.WithTimeout(ctx, 2*time.Second)
+	defer captureCancel()
+	for attempt := 0; attempt < 3; attempt++ {
+		before := sdkResourcesFixtureJobSnapshot(job)
+		out.AfterResume = append(out.AfterResume, before)
+		members, after, captureErr := sdkResourcesFixtureObserveMembers(captureCtx, job, before, expected, out.DescendantPID, out.DescendantCreation, sid, &memberCaps)
+		out.AfterMembers = members
+		record := sdkResourcesFixtureMemberCapture{Before: before, After: after, Members: members}
+		var changed *sdkResourcesFixtureKnownMemberSetChanged
+		if captureErr != nil {
+			record.Error = captureErr.Error()
+			record.KnownMemberSetChanged = errors.As(captureErr, &changed)
+		}
+		out.PostCaptures = append(out.PostCaptures, record)
+		if captureErr == nil {
+			out.CompleteOwnedMembers = true
+			break
+		}
+		// Only positively captured facts + successful changed complete native
+		// sets permit this preplanned read-only recapture. Unknown never retries.
+		if !record.KnownMemberSetChanged || attempt == 2 || captureCtx.Err() != nil {
+			return errors.New("post-resume owned-member capture refused; no unknown retry")
+		}
+		select {
+		case <-captureCtx.Done():
+			return ErrUpgrade
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+	if !out.CompleteOwnedMembers || len(memberCaps) > 4*16*3 {
+		return ErrUpgrade
+	}
+	if n, err := io.perform(ctx, []byte{0x54}, true); err != nil || n != 1 {
+		return ErrUpgrade
+	}
+	retireErr := resources.retire(ctx)
+	out.Stages = append([]string(nil), resources.stages...)
+	if retireErr != nil {
+		return errors.New("actual product physical resource retirement refused")
+	}
+	out.Stages = append([]string(nil), resources.stages...)
+	want := []string{"root-exit-zero", "job-termination-requested", "job-empty", "io-joined", "job-closed", "exclusions-released"}
+	if len(out.Stages) != len(want) {
+		return ErrUpgrade
+	}
+	for n := range want {
+		if out.Stages[n] != want[n] {
+			return ErrUpgrade
+		}
+	}
+	out.SDKRootExitZero, out.PositiveJobEmpty, out.IOJoined, out.JobClosed, out.ControllersClosedLast = true, true, true, true, true
+	out.DescendantJoined, out.JobTerminationRequested = out.DescStoppedBeforeExclusions, true
+	finished = true
+	return nil
+}
