+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestUpgradeLegacySDKFlagsAndDuplicateStopCannotMintRetirement(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	peer := &nativeUpgradeLegacySDKPeer{stopDispatched: true}
+	owner := &nativeUpgradeLegacySDKOwner{peer: peer, helpers: &nativeUpgradeLegacySDKHelpers{}}
+	if owner.interrupt(ctx) == nil || owner.unknown {
+		t.Fatal("duplicate Stop replayed or poisoned known refusal")
+	}
+	if peer.recheckRetired(ctx) == nil {
+		t.Fatal("flags without actual process/controller/ingress/helper holders minted retirement")
+	}
+	if peer.stop(ctx, nil) == nil {
+		t.Fatal("missing helper owner emitted destructive request")
+	}
+	winOnly := &nativeUpgradeLegacySDKHelpers{peer: peer, wsl: &upgradeWSLImage{}}
+	if winOnly.recheckLegacySDKOwned(ctx, peer) == nil || winOnly.verifyLegacySDKRetired(ctx, peer) == nil {
+		t.Fatal("Windows-only proof minted guest closure")
+	}
+	if guest, err := captureUpgradeLegacySDKNoGuest(ctx, peer, winOnly); err == nil || guest != nil {
+		t.Fatal("copied flags without actual mapped image minted no-guest capability")
+	}
+	foreign := &nativeUpgradeLegacySDKNoGuest{peer: peer, helpers: &nativeUpgradeLegacySDKHelpers{peer: &nativeUpgradeLegacySDKPeer{}}}
+	if foreign.recheckLegacySDKGuestOrigin(ctx, peer) == nil || foreign.verifyLegacySDKGuestRetired(ctx, peer) == nil {
+		t.Fatal("guest origin from a different peer graph was accepted")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_owner.go b/rdd/pkg/managementconfig/upgrade_sdk_owner.go
new file mode 100644
index 0000000000000000000000000000000000000000..a71cc973f0998dfed9d1726a2e2c86093eadc11d
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_owner.go
@@ -0,0 +1,91 @@
+package managementconfig
+
+import (
+	"bytes"
+	"encoding/json"
+)
+
+// This envelope only describes ORIGINAL inherited native objects. The actual
+// management serving permit, mapped SDK/job membership and code pins are
+// mandatory separately; these bytes/ACK event cannot create ownership.
+type upgradeSDKOwnerWire struct {
+	Schema                                          int
+	Transaction                                     string
+	SDKDigest, Nonce                                [32]byte
+	Sequence                                        uint32
+	Parent, SDK                                     upgradeSDKGrantProcess
+	Job, Process, Token, Image, Control, Acceptance uint64
+	Supervisor                                      uint64
+	Final                                           uint64
+	Cohort                                          upgradeSDKOwnerCohortWire
+}
+
+// Correlation for ORIGINAL inherited query-only objects. Parsing this complete
+// history grants no cohort: the receiver must adopt and independently inspect
+// every native handle and bind the root to its actual held SDK process.
+type upgradeSDKOwnerCohortWire struct {
+	Job     uint64
+	Total   uint32
+	Members []upgradeSDKOwnerMemberWire
+}
+type upgradeSDKOwnerMemberWire struct {
+	Process, Token uint64
+	PID            uint32
+	Creation       uint64
+}
+
+func parseUpgradeSDKOwner(body []byte, raw, management uint64) (upgradeSDKOwnerWire, error) {
+	var r upgradeSDKOwnerWire
+	if len(body) == 0 || len(body) > 64<<10 || json.Unmarshal(body, &r) != nil {
+		return r, ErrUpgrade
+	}
+	canonical, _ := json.Marshal(r)
+	if !bytes.Equal(canonical, body) || r.Schema != 6 || !upgradeHex(r.Transaction, 32) || r.SDKDigest == [32]byte{} || r.Nonce == [32]byte{} || r.Sequence != 2 || r.Parent.PID == 0 || r.Parent.Creation == 0 || r.Parent.Session == 0 || r.Parent.Image == [32]byte{} || r.SDK.PID == 0 || r.SDK.PID == r.Parent.PID || r.SDK.Creation <= r.Parent.Creation || r.SDK.Session != r.Parent.Session || r.SDK.Image == [32]byte{} || len(r.Cohort.Members) == 0 || len(r.Cohort.Members) > upgradeSDKCohortBound || uint32(len(r.Cohort.Members)) != r.Cohort.Total {
+		return upgradeSDKOwnerWire{}, ErrUpgrade
+	}
+	seen := map[uint64]bool{}
+	roles := []uint64{raw, management, r.Job, r.Process, r.Token, r.Image, r.Control, r.Acceptance, r.Supervisor, r.Final, r.Cohort.Job}
+	root := false
+	var previous uint32
+	for _, m := range r.Cohort.Members {
+		if m.PID == 0 || m.PID <= previous || m.PID == r.Parent.PID || m.Creation < r.SDK.Creation {
+			return upgradeSDKOwnerWire{}, ErrUpgrade
+		}
+		previous = m.PID
+		if m.PID == r.SDK.PID {
+			if m.Creation != r.SDK.Creation {
+				return upgradeSDKOwnerWire{}, ErrUpgrade
+			}
+			root = true
+		}
+		roles = append(roles, m.Process, m.Token)
+	}
+	if !root {
+		return upgradeSDKOwnerWire{}, ErrUpgrade
+	}
+	for _, h := range roles {
+		if h == 0 || h == uint64(^uintptr(0)) || uint64(uintptr(h)) != h || seen[h] {
+			return upgradeSDKOwnerWire{}, ErrUpgrade
+		}
+		seen[h] = true
+	}
+	return r, nil
+}
+
+// The actual native sender passes the address of this retained slot directly
+// to DuplicateHandle. Even a nonzero output accompanying an error is therefore
+// reachable from the one-use transfer owner before that error can escape.
+func retainUpgradeSDKDuplicate[T ~uintptr](owned *[]T, duplicate func(*T) error) (T, error) {
+	var zero T
+	if owned == nil || duplicate == nil {
+		return zero, ErrUpgrade
+	}
+	*owned = append(*owned, zero)
+	index := len(*owned) - 1
+	err := duplicate(&(*owned)[index])
+	out := (*owned)[index]
+	if err != nil || out == zero || out == T(^uintptr(0)) {
+		return out, ErrUpgrade
+	}
+	return out, nil
+}
