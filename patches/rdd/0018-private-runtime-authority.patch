new file mode 100644
index 0000000000000000000000000000000000000000..3692b65bdbe0f991c0c895be5924c61461921d95
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_birth_windows.go
@@ -0,0 +1,68 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"context"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"unsafe"
+)
+
+type upgradeSDKBirthAdmission struct {
+	owner      *upgradeAuthorityOwner
+	generation UpgradeProcess
+	sid        string
+}
+
+func queryUpgradeOuterJob() (bool, error) {
+	var member uint32
+	result, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("IsProcessInJob").Call(uintptr(windows.CurrentProcess()), 0, uintptr(unsafe.Pointer(&member)))
+	if result == 0 || member > 1 {
+		return false, ErrUpgrade
+	}
+	return member == 1, nil
+}
+
+// Caller holds owner.mu; construction performs no namespace/process effects.
+func holdUpgradeSDKBirth(ctx context.Context, owner *upgradeAuthorityOwner) (*upgradeSDKBirthAdmission, error) {
+	if owner == nil || owner.image == nil || owner.cold == nil || owner.unknown || !owner.imported || owner.released || owner.releaseAttempted {
+		return nil, ErrUpgrade
+	}
+	if err := requireUpgradeNoOuterJob(ctx, queryUpgradeOuterJob); err != nil {
+		return nil, err
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != owner.cold.sid {
+		return nil, ErrUpgrade
+	}
+	owner.image.mu.Lock()
+	defer owner.image.mu.Unlock()
+	if checkSDKFinalImage(owner.image, sid) != nil {
+		return nil, ErrUpgrade
+	}
+	generation, err := currentUpgradeGeneration(owner.image.Image().Hash)
+	if err != nil {
+		return nil, ErrUpgrade
+	}
+	return &upgradeSDKBirthAdmission{owner, generation, sid}, nil
+}
+
+func (a *upgradeSDKBirthAdmission) check(ctx context.Context) error {
+	if a == nil || a.owner == nil || !a.generation.valid() {
+		return ErrUpgrade
+	}
+	if err := requireUpgradeNoOuterJob(ctx, queryUpgradeOuterJob); err != nil {
+		return err
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	actual, generationErr := currentUpgradeGeneration(a.generation.Image)
+	if err != nil || sid != a.sid || generationErr != nil || actual != a.generation {
+		return ErrUpgrade
+	}
+	return nil
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_bootstrap_pending.go b/rdd/pkg/managementconfig/upgrade_sdk_bootstrap_pending.go
new file mode 100644
index 0000000000000000000000000000000000000000..e077a5df21c6dc2ba0ec5b06209f3893343bffda
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sdk_bootstrap_pending.go
@@ -0,0 +1,48 @@
+package managementconfig
+
+import (
+	"context"
+	"time"
+)
+
+// Only these authenticated exact no-effect pre-admission Busy stages permit
+// another operation attempt. Native admitted errors/unknown ACKs never do.
+func upgradeSDKBootstrapPending(operation, stage string) bool {
+	return operation == "commit" && stage == "commit-pending" || operation == "offer-controller" && stage == "offer-controller-pending"
+}
+
+// The actual serving owner's single request pump calls this with its original
+// absolute bootstrap deadline. Pending native leaves are served BETWEEN known
+// no-effect attempts; waiting inside the commit request would deadlock their
+// ACKs. This sequences calls only and is not a native admission constructor.
+func driveUpgradeSDKBootstrapOperation(ctx context.Context, operation string, call func(context.Context, string) (upgradeSDKControlReply, error)) (upgradeSDKControlReply, error) {
+	var empty upgradeSDKControlReply
+	if ctx == nil || call == nil {
+		return empty, ErrUpgrade
+	}
+	if _, bounded := ctx.Deadline(); !bounded {
+		return empty, ErrUpgrade
+	}
+	for {
+		if ctx.Err() != nil {
+			return empty, ErrUpgrade
+		}
+		reply, e := call(ctx, operation)
+		if e != nil {
+			return reply, e
+		}
+		if !upgradeSDKBootstrapPending(operation, reply.Stage) {
+			return reply, nil
+		}
+		if _, e = call(ctx, "keepalive"); e != nil {
+			return empty, e
+		}
+		timer := time.NewTimer(250 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return empty, ErrUpgrade
+		case <-timer.C:
+		}
+	}
+}
