+func sdkResourcesFixtureJoinDescendant(ctx context.Context, process windows.Handle, out *sdkResourcesFixtureResult) error {
+	if process == 0 || ctx == nil || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	var err error
+	out.DescImmediateWait, err = windows.WaitForSingleObject(process, 0)
+	if err != nil {
+		out.DescImmediateWaitError = err.Error()
+	}
+	exitErr := windows.GetExitCodeProcess(process, &out.DescImmediateExit)
+	if exitErr != nil {
+		out.DescImmediateExitError = exitErr.Error()
+	}
+	if err != nil || exitErr != nil || out.DescImmediateWait != uint32(windows.WAIT_OBJECT_0) && out.DescImmediateWait != uint32(windows.WAIT_TIMEOUT) {
+		return ErrUpgrade
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	for {
+		if waitCtx.Err() != nil {
+			out.DescFinalWaitError = waitCtx.Err().Error()
+			return ErrUpgrade
+		}
+		out.DescFinalWait, err = windows.WaitForSingleObject(process, 20)
+		if err != nil {
+			out.DescFinalWaitError = err.Error()
+			return ErrUpgrade
+		}
+		if out.DescFinalWait == uint32(windows.WAIT_OBJECT_0) {
+			break
+		}
+		if out.DescFinalWait != uint32(windows.WAIT_TIMEOUT) {
+			return ErrUpgrade
+		}
+	}
+	if err = windows.GetExitCodeProcess(process, &out.DescFinalExit); err != nil {
+		out.DescFinalExitError = err.Error()
+		return ErrUpgrade
+	}
+	pid, _, nativeErr := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetProcessId").Call(uintptr(process))
+	out.DescHeldPID = uint32(pid)
+	if pid == 0 {
+		out.DescGenerationError = fmt.Sprint(nativeErr)
+		return ErrUpgrade
+	}
+	var made, ended, kernel, user windows.Filetime
+	if err = windows.GetProcessTimes(process, &made, &ended, &kernel, &user); err != nil {
+		out.DescGenerationError = err.Error()
+		return ErrUpgrade
+	}
+	out.DescHeldCreation = uint64(made.HighDateTime)<<32 | uint64(made.LowDateTime)
+	if out.DescHeldPID != out.DescendantPID || out.DescHeldCreation != out.DescendantCreation {
+		out.DescGenerationError = "captured descendant generation changed"
+		return ErrUpgrade
+	}
+	// Actual signaled generation plus a successful exit read is stopped proof.
+	// Abandoned children killed with their job need not complete naturally/0.
+	out.DescStoppedBeforeExclusions = true
+	return nil
+}
