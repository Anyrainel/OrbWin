@@ -0,0 +1,95 @@
+package managementconfig
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestUpgradeSDKBootstrapBusyReleasesTheOnlyPumpForLeafCustody(t *testing.T) {
+	for operation, stage := range map[string]string{"commit": "commit-pending", "offer-controller": "offer-controller-pending"} {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		pending := true
+		var calls []string
+		_, err := driveUpgradeSDKBootstrapOperation(ctx, operation, func(actual context.Context, op string) (upgradeSDKControlReply, error) {
+			if actual != ctx {
+				t.Fatal("bootstrap deadline replaced")
+			}
+			calls = append(calls, op)
+			if op == "keepalive" {
+				pending = false
+				return upgradeSDKControlReply{Stage: "keepalive"}, nil
+			}
+			if pending {
+				return upgradeSDKControlReply{Stage: stage}, nil
+			}
+			return upgradeSDKControlReply{Stage: "actual-positive-reply-already-parsed"}, nil
+		})
+		cancel()
+		if err != nil || !reflect.DeepEqual(calls, []string{operation, "keepalive", operation}) {
+			t.Fatal("custody could not finish", calls, err)
+		}
+	}
+}
+
+func TestUpgradeSDKBootstrapNeverRetriesUnknownOrResetsDeadline(t *testing.T) {
+	fault := errors.New("admitted native effect/ACK unknown")
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	calls := 0
+	if _, e := driveUpgradeSDKBootstrapOperation(ctx, "commit", func(context.Context, string) (upgradeSDKControlReply, error) {
+		calls++
+		return upgradeSDKControlReply{Stage: "commit-pending"}, fault
+	}); !errors.Is(e, fault) || calls != 1 {
+		t.Fatal("unknown request replayed", e, calls)
+	}
+	short, stop := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer stop()
+	calls = 0
+	if _, e := driveUpgradeSDKBootstrapOperation(short, "commit", func(actual context.Context, op string) (upgradeSDKControlReply, error) {
+		if actual != short {
+			t.Fatal("deadline replaced")
+		}
+		calls++
+		if op == "commit" {
+			return upgradeSDKControlReply{Stage: "commit-pending"}, nil
+		}
+		return upgradeSDKControlReply{Stage: "keepalive"}, nil
+	}); e == nil || calls != 2 {
+		t.Fatal("pending exceeded absolute deadline", e, calls)
+	}
+}
+
+func TestUpgradeSDKBootstrapPendingFramesCannotCarryNativeOutputs(t *testing.T) {
+	for operation, stage := range map[string]string{"commit": "commit-pending", "offer-controller": "offer-controller-pending"} {
+		r := upgradeSDKControlReply{Schema: 1, Sequence: 9, Stage: stage}
+		body, _ := json.Marshal(r)
+		if _, e := parseUpgradeSDKControlReply(body, 9, operation); e != nil {
+			t.Fatal("known pre-admission busy", operation, e)
+		}
+		for _, kind := range []string{"controller", "receipt", "leaf", "error"} {
+			bad := r
+			switch kind {
+			case "controller":
+				bad.Controller = &[4]uint64{1, 2, 3, 4}
+			case "receipt":
+				bad.Receipt = testUpgradeSDKInventory()
+			case "leaf":
+				bad.Leaf = &upgradeSDKLeafOfferWire{1, 1, "birth", 100, 2, 200}
+			case "error":
+				bad.Error = "unknown"
+			}
+			body, _ = json.Marshal(bad)
+			if _, e := parseUpgradeSDKControlReply(body, 9, operation); e == nil {
+				t.Fatal("pending borrowed output", operation, kind)
+			}
+		}
+		body, _ = json.Marshal(r)
+		if _, e := parseUpgradeSDKControlReply(body, 9, "keepalive"); e == nil {
+			t.Fatal("pending moved to another operation")
+		}
+	}
+}
