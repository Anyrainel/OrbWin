+package managementconfig
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestUpgradeSDKLeafOffersRemainClosedOriginalPumpData(t *testing.T) {
+	for _, operation := range []string{"keepalive", "drain-runtime"} {
+		for _, kind := range []string{"birth", "stopped", "closed"} {
+			process := uint64(100)
+			if kind == "closed" {
+				process = 0
+			}
+			r := upgradeSDKControlReply{Schema: 1, Sequence: 7, Stage: operation, Leaf: &upgradeSDKLeafOfferWire{Offer: 1, Leaf: 1, Kind: kind, Process: process, PID: 2, Creation: 0x1d0000000000001}}
+			if operation == "drain-runtime" {
+				r.Stage = "runtime-draining"
+			}
+			body, _ := json.Marshal(r)
+			got, err := parseUpgradeSDKControlReply(body, 7, operation)
+			if err != nil || got.Leaf.Creation != r.Leaf.Creation {
+				t.Fatal("exact uint64 data", operation, kind, err)
+			}
+			for _, changed := range []string{
+				strings.Replace(string(body), `"Leaf":1`, `"Leaf":1,"Leaf":1`, 1),
+				strings.Replace(string(body), `"Kind":"`+kind+`"`, `"Kind":"unknown"`, 1),
+				strings.Replace(string(body), `"Offer":1`, `"Offer":0`, 1),
+				strings.Replace(string(body), `"PID":2`, `"PID":0`, 1),
+				strings.Replace(string(body), `"Process":`+func() string {
+					if process == 0 {
+						return "0"
+					}
+					return "100"
+				}(), `"Process":-1`, 1),
+				string(body) + "\n",
+			} {
+				if _, err := parseUpgradeSDKControlReply([]byte(changed), 7, operation); err == nil {
+					t.Fatal("malformed/replayed data shape", changed)
+				}
+			}
+		}
+	}
+}
+
+func TestUpgradeSDKLeafOffersCannotBorrowOtherOperationReplies(t *testing.T) {
+	for operation, stage := range map[string]string{"adopt-leaf-master": "leaf-master-adopted", "ack-leaf": "leaf-acknowledged", "start-runtime": "runtime-start-admitted", "commit": "committed-parent-retained", "seal-runtime": "runtime-draining", "retire": "retirement-admitted"} {
+		r := upgradeSDKControlReply{Schema: 1, Sequence: 7, Stage: stage}
+		body, _ := json.Marshal(r)
+		if _, err := parseUpgradeSDKControlReply(body, 7, operation); err != nil {
+			t.Fatal("closed operation", operation, err)
+		}
+		r.Leaf = &upgradeSDKLeafOfferWire{1, 1, "birth", 100, 2, 200}
+		body, _ = json.Marshal(r)
+		if _, err := parseUpgradeSDKControlReply(body, 7, operation); err == nil {
+			t.Fatal("offer on wrong frame", operation)
+		}
+	}
+}
+
+func TestUpgradeSDKLeafRequestsCannotBorrowOtherNativeRoles(t *testing.T) {
+	master := &upgradeSDKLeafMasterWire{Process: 100}
+	ack := &upgradeSDKLeafAckWire{Offer: 1, Leaf: 1, Kind: "birth", Process: 100}
+	for _, v := range []upgradeSDKControlRequest{
+		{Operation: "adopt-leaf-master", Master: master},
+		{Operation: "ack-leaf", Leaf: ack},
+		{Operation: "ack-leaf", Leaf: &upgradeSDKLeafAckWire{Offer: 2, Leaf: 1, Kind: "closed"}},
+		{Operation: "keepalive"},
+	} {
+		if !v.validPayload() {
+			t.Fatal("valid private payload", v.Operation)
+		}
+	}
+	for _, v := range []upgradeSDKControlRequest{
+		{Operation: "adopt-leaf-master"},
+		{Operation: "adopt-leaf-master", Master: &upgradeSDKLeafMasterWire{}},
+		{Operation: "adopt-leaf-master", Master: master, Leaf: ack},
+		{Operation: "ack-leaf", Leaf: ack, Master: master},
+		{Operation: "ack-leaf", Leaf: &upgradeSDKLeafAckWire{Offer: 1, Leaf: 1, Kind: "closed", Process: 100}},
+		{Operation: "ack-leaf", Leaf: &upgradeSDKLeafAckWire{Offer: 1, Leaf: 1, Kind: "stopped"}},
+		{Operation: "keepalive", Leaf: ack},
+		{Operation: "start-runtime", Master: master},
+		{Operation: "unknown"},
+	} {
+		if v.validPayload() {
+			t.Fatal("borrowed native role", v.Operation)
+		}
+	}
+	r := upgradeSDKControlReply{Schema: 1, Sequence: 1, Stage: "runtime-joined", Leaf: &upgradeSDKLeafOfferWire{1, 1, "closed", 0, 2, 200}}
+	body, _ := json.Marshal(r)
+	if _, err := parseUpgradeSDKControlReply(body, 1, "drain-runtime"); err == nil {
+		t.Fatal("joined actor retained an unacknowledged leaf")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_sdk_legacy.go b/rdd/pkg/managementconfig/upgrade_sdk_legacy.go
new file mode 100644
index 0000000000000000000000000000000000000000..f32d215ef661d8ee33281c0fc29faa8a3f9d8be5
--- /dev/null
