new file mode 100644
index 0000000000000000000000000000000000000000..42e49a3bad18100d00b9bef34c6bc005ea1c9ec9
--- /dev/null
+++ b/rdd/pkg/managementconfig/runtime_operation.go
@@ -0,0 +1,179 @@
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"sync/atomic"
+)
+
+var ErrRuntimePreflight = errors.New("native runtime storage preflight refused; no setup or publication performed")
+
+const runtimeOperationFrameMax = 128
+
+// Exact closed encodings deliberately admit no home, PID, digest, ready flag,
+// commit, generation, caller-selected effect or caller-built native resource.
+func readRuntimeOperationFrame(input io.Reader) (string, error) {
+	var header [4]byte
+	if input == nil {
+		return "", ErrRuntimePreflight
+	}
+	if _, e := io.ReadFull(input, header[:]); e != nil {
+		return "", ErrRuntimePreflight
+	}
+	n := binary.LittleEndian.Uint32(header[:])
+	if n == 0 || n > runtimeOperationFrameMax {
+		return "", ErrRuntimePreflight
+	}
+	body := make([]byte, n)
+	if _, e := io.ReadFull(input, body); e != nil {
+		return "", ErrRuntimePreflight
+	}
+	for _, operation := range []string{"preflight", "release", "cancel"} {
+		if bytes.Equal(body, []byte(`{"schema":1,"operation":"`+operation+`"}`)) {
+			return operation, nil
+		}
+	}
+	return "", ErrRuntimePreflight
+}
+
+type runtimePreflightFrame struct {
+	operation string
+	err       error
+}
+
+// Reader produces bounded protocol DATA only. It cannot accept release or
+// inspect native owners; the owner consumes this only after positive held Write.
+func readRuntimeOperationTerminal(input io.Reader, cancel context.CancelFunc) runtimePreflightFrame {
+	op, e := readRuntimeOperationFrame(input)
+	if e != nil || op != "release" && op != "cancel" {
+		e = ErrRuntimePreflight
+	}
+	if (op == "cancel" || e != nil) && cancel != nil {
+		cancel()
+	}
+	if e == nil {
+		var extra [1]byte
+		n, end := input.Read(extra[:])
+		if n != 0 || end != io.EOF {
+			e = ErrRuntimePreflight
+		}
+	}
+	if e != nil && cancel != nil {
+		cancel()
+	}
+	return runtimePreflightFrame{op, e}
+}
+
+type runtimePreflightStep uint8
+
+const (
+	runtimePreflightCapture runtimePreflightStep = iota
+	runtimePreflightVerify
+	runtimePreflightObserveHeld
+	runtimePreflightWaitControl
+	runtimePreflightRelease
+)
+
+// Actual native entrypoint calls this bounded order. This is DATA sequencing,
+// with no exported callback constructor, native owner or positive-grant type.
+// Capture's operation step owns partial settlement through the bound native
+// graph. Once capture returns successfully, later error/cancellation attempts one
+// checked release; native unknown release retains the actual graph.
+func runtimePreflightSequence(ctx context.Context, effect func(runtimePreflightStep) error) (result error) {
+	if ctx == nil || ctx.Err() != nil || effect == nil {
+		return ErrRuntimePreflight
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		return ErrRuntimePreflight
+	}
+	if e := effect(runtimePreflightCapture); e != nil {
+		return e
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			panic(p)
+		}
+		if e := effect(runtimePreflightRelease); e != nil {
+			result = ErrRuntimePreflight
+		}
+	}()
+	for _, step := range []runtimePreflightStep{runtimePreflightVerify, runtimePreflightObserveHeld, runtimePreflightWaitControl} {
+		if ctx.Err() != nil {
+			return ErrRuntimePreflight
+		}
+		if e := effect(step); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+
+func runtimePreflightReleaseSequence(selection, storage func() error, retain func()) error {
+	if selection == nil || storage == nil || retain == nil {
+		return ErrRuntimePreflight
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			retain()
+			panic(p)
+		}
+	}()
+	if selection() != nil {
+		retain()
+		return ErrRuntimePreflight
+	}
+	if storage() != nil {
+		retain()
+		return ErrRuntimePreflight
+	}
+	return nil
+}
+
+// Concrete native operation uses this to publish its actual storage pointer
+// BEFORE capture effects. Error settlement belongs exclusively to that caller;
+// panic retains both selection and whatever partial storage was already bound.
+// These private DATA callbacks cannot construct or return a native capability.
+func runtimePreflightCaptureSequence(bind, capture, settle func() error, retain func()) (result error) {
+	if bind == nil || capture == nil || settle == nil || retain == nil {
+		return ErrRuntimePreflight
+	}
+	defer func() {
+		if p := recover(); p != nil {
+			retain()
+			panic(p)
+		}
+		if result != nil && settle() != nil {
+			result = ErrRuntimePreflight
+		}
+	}()
+	if e := bind(); e != nil {
+		return e
+	}
+	return capture()
+}
+
+// Protocol DATA barrier only. The actual writer must positively finish before
+// the OWNER accepts terminal DATA. The reader never consults this barrier.
+// This makes no claim about when the caller read
+// the event or when prequeued bytes arrived in the pipe.
+type runtimePreflightHeldBarrier struct{ used, positive atomic.Bool }
+
+func (b *runtimePreflightHeldBarrier) publish(write func() error) error {
+	if b == nil || write == nil || !b.used.CompareAndSwap(false, true) {
+		return ErrRuntimePreflight
+	}
+	if e := write(); e != nil {
+		return e
+	}
+	b.positive.Store(true)
+	return nil
+}
+func (b *runtimePreflightHeldBarrier) terminal(operation string, parseErr error) error {
+	if b == nil || !b.positive.Load() || parseErr != nil || operation != "release" && operation != "cancel" {
+		return ErrRuntimePreflight
+	}
+	return nil
+}
