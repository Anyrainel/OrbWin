+package managementconfig
+
+import (
+	"encoding/binary"
+	"testing"
+	"unicode/utf16"
+)
+
+func upgradeWide(text string) []byte {
+	units := utf16.Encode([]rune(text))
+	data := make([]byte, len(units)*2)
+	for i, u := range units {
+		binary.LittleEndian.PutUint16(data[i*2:], u)
+	}
+	return data
+}
+func TestUpgradeWSLClosedRunningObservation(t *testing.T) {
+	registered := map[string]upgradeWSLRegistration{"lima-orbwin": {Name: "lima-orbwin"}, "Other": {Name: "Other"}, "開発": {Name: "開発"}}
+	for _, data := range [][]byte{[]byte("Other\r\n"), upgradeWide("Other\r\n"), append([]byte{0xff, 0xfe}, upgradeWide("Other\r\n")...), []byte("開発\n"), upgradeWide("開発\n"), nil} {
+		got, err := decodeUpgradeWSLRunning(data, registered)
+		if err != nil || got["lima-orbwin"] {
+			t.Fatal("closed stopped observation refused")
+		}
+	}
+	got, err := decodeUpgradeWSLRunning(upgradeWide("lima-orbwin\r\nOther\r\n"), registered)
+	if err != nil || !got["lima-orbwin"] {
+		t.Fatal("running guest hidden")
+	}
+	for _, data := range [][]byte{[]byte("localized error\n"), []byte("Other\nOther\n"), []byte("Other\n\n"), []byte(" Other\n"), []byte{0xff}, []byte{0xff, 0xfe, 0, 0xd8}, []byte{0xff, 0xfe, 0, 0}, make([]byte, 65537)} {
+		if _, err := decodeUpgradeWSLRunning(data, registered); err == nil {
+			t.Fatal("ambiguous CLI output accepted")
+		}
+	}
+}
+func TestUpgradeWSLRegistryChangesInvalidateObservation(t *testing.T) {
+	before := map[string]upgradeWSLRegistration{"lima-orbwin": {GUID: "old", Name: "lima-orbwin", BasePath: "held", Object: UpgradeObject{1, 2, 3}}}
+	for _, after := range []map[string]upgradeWSLRegistration{{}, {"lima-orbwin": {GUID: "replacement", Name: "lima-orbwin", BasePath: "held", Object: UpgradeObject{1, 2, 3}}}, {"lima-orbwin": {GUID: "old", Name: "lima-orbwin", BasePath: "held", Object: UpgradeObject{1, 2, 4}}}} {
+		if sameUpgradeWSLRegistrations(before, after) {
+			t.Fatal("changed registry accepted")
+		}
+	}
+	if !sameUpgradeWSLRegistrations(before, before) {
+		t.Fatal("stable facts rejected")
+	}
+}
+
+func TestUpgradeWSLOutputBudgetIsLatched(t *testing.T) {
+	output := &upgradeBoundedOutput{limit: 4}
+	if n, err := output.Write([]byte("ab")); err != nil || n != 2 {
+		t.Fatal("bounded output refused")
+	}
+	if _, err := output.Write([]byte("cde")); err == nil {
+		t.Fatal("output overflow accepted")
+	}
+	if _, err := output.Write([]byte("x")); err == nil {
+		t.Fatal("overflow resumed")
+	}
+	if _, err := output.take(); err == nil {
+		t.Fatal("truncated output exposed as complete")
+	}
+}
