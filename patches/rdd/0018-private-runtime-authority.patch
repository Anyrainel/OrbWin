diff --git a/rdd/pkg/managementconfig/upgrade_sqlite_test.go b/rdd/pkg/managementconfig/upgrade_sqlite_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c18c865642c90473a60a4f6e805bb04e3f901c21
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_sqlite_test.go
@@ -0,0 +1,65 @@
+package managementconfig
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"testing"
+)
+
+func TestUpgradeDatabasePinSingleOperationAndUnknownCloseRetainsOwner(t *testing.T) {
+	pin := &upgradeDatabasePin{transaction: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", workingRoot: UpgradeObject{1, 0, 2}}
+	file := &upgradeSQLiteFile{path: "fixed-native-selection", role: "copied", object: UpgradeObject{1, 0, 3}, pin: pin}
+	if !file.valid("copied") || !pin.begin() || pin.begin() {
+		t.Fatal("missing exclusive SQLite lifetime")
+	}
+	pin.end()
+	if !pin.begin() {
+		t.Fatal("known closed operation did not retire")
+	}
+	resource := new(int)
+	pin.unknown(resource)
+	pin.end()
+	if !pin.active || !pin.uncertain || pin.begin() || file.valid("copied") || len(pin.retained) != 1 || pin.retained[0] != resource {
+		t.Fatal("unknown SQLite cleanup released ownership or replayed")
+	}
+}
+
+func TestUpgradeSchemaWhitelistDoesNotEraseForeignIdentifiers(t *testing.T) {
+	if upgradeNormalizedSQL("CREATE TABLE IF NOT EXISTS kine (id INTEGER)") != upgradeNormalizedSQL("create table kine(id integer)") {
+		t.Fatal("selected upstream DDL normalization failed")
+	}
+	if upgradeNormalizedSQL("CREATE TABLE kine (old_ifnotexistsvalue BLOB)") == upgradeNormalizedSQL("CREATE TABLE kine (old_value BLOB)") {
+		t.Fatal("foreign schema identifier hidden by normalization")
+	}
+	for _, key := range []string{"/registry/apps/app", "compact_rev_key", "compact_rev_key_apiserver", "gap-12"} {
+		if !upgradeKeyAllowed(key) {
+			t.Fatal("selected key refused")
+		}
+	}
+	for _, key := range []string{"", "/foreign/userdata", "gap-012", "gap--1", "/registry/line\nbreak"} {
+		if upgradeKeyAllowed(key) {
+			t.Fatal("foreign/malformed key adopted")
+		}
+	}
+}
+
+func TestUpgradeKeysRejectInvalidUTF8AndHashRawBytes(t *testing.T) {
+	first, second := string([]byte{'/', 'r', 'e', 'g', 'i', 's', 't', 'r', 'y', '/', 0xff}), string([]byte{'/', 'r', 'e', 'g', 'i', 's', 't', 'r', 'y', '/', 0xfe})
+	if upgradeKeyAllowed(first) || upgradeKeyAllowed(second) {
+		t.Fatal("invalid UTF8 key adopted")
+	}
+	left, right := sha256.New(), sha256.New()
+	upgradeHashPart(left, []byte(first))
+	upgradeHashPart(right, []byte(second))
+	if bytes.Equal(left.Sum(nil), right.Sum(nil)) {
+		t.Fatal("distinct raw key bytes collapsed")
+	}
+	a, b := sha256.New(), sha256.New()
+	upgradeHashPart(a, []byte("ab"))
+	upgradeHashPart(a, []byte("c"))
+	upgradeHashPart(b, []byte("a"))
+	upgradeHashPart(b, []byte("bc"))
+	if bytes.Equal(a.Sum(nil), b.Sum(nil)) {
+		t.Fatal("length boundaries collapsed")
+	}
+}
diff --git a/rdd/pkg/managementconfig/upgrade_store_windows.go b/rdd/pkg/managementconfig/upgrade_store_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..5451989a42addac236be4f2b82510de34a693e36
--- /dev/null
+++ b/rdd/pkg/managementconfig/upgrade_store_windows.go
@@ -0,0 +1,309 @@
+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"golang.org/x/sys/windows"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// Fixed private destination only. The old guest home and legacy input are not
+// reachable through this store. No exported caller-path or boolean-proof API.
+type nativeUpgradeStore struct {
+	mu                sync.Mutex
+	parents           *ParentLease
+	handles           []windows.Handle
+	directory         windows.Handle
+	sid               string
+	closed, uncertain bool
+	closeErr          error
+	workingActive     bool
+	sdkActive         bool
+	sdkDenialActive   bool
+	captureActive     bool
+}
+
+func (s *nativeUpgradeStore) Close() error {
+	if s == nil {
+		return nil
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.captureActive || s.workingActive || s.sdkActive || s.sdkDenialActive || s.uncertain {
+		return ErrUpgrade
+	}
+	if s.closed {
+		return s.closeErr
+	}
+	s.uncertain = true
+	// The first handle is the actual sole migration-owner lock. Keep it until
+	// every record/directory/ancestor has positively closed; an uncertain cleanup
+	// must not release ownership to another process.
+	if closeUpgradeStoreGraph(s.handles, windows.CloseHandle, func() error {
+		if s.parents != nil {
+			return s.parents.Close()
+		}
+		return nil
+	}) != nil {
+		s.closeErr = ErrUpgrade
+		return s.closeErr
+	}
+	s.closed = true
+	s.uncertain = false
+	return s.closeErr
+}
+
+// The injected seam tests lost-close replies without any native API execution.
+func closeUpgradeStoreGraph(handles []windows.Handle, closeHandle func(windows.Handle) error, closeParents func() error) error {
+	if closeHandle == nil || closeParents == nil {
+		return ErrUpgrade
+	}
+	for i := len(handles) - 1; i >= 1; i-- {
+		if closeHandle(handles[i]) != nil {
+			return ErrUpgrade
+		}
+		handles[i] = 0
+	}
+	if closeParents() != nil {
+		return ErrUpgrade
+	}
+	if len(handles) > 0 {
+		if closeHandle(handles[0]) != nil {
+			return ErrUpgrade
+		}
+		handles[0] = 0
+	}
+	return nil
+}
+func (s *nativeUpgradeStore) unknownUpgradeRecord() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.uncertain = true
+}
+func upgradeOwnerLock(parent windows.Handle, sid string) (windows.Handle, error) {
+	sd, e := privateDescriptor(sid, false)
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	name, e := windows.NewNTUnicodeString("migration.owner.lock")
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	oa := windows.OBJECT_ATTRIBUTES{RootDirectory: parent, ObjectName: name, Attributes: windows.OBJ_CASE_INSENSITIVE | windows.OBJ_DONT_REPARSE, SecurityDescriptor: sd}
+	oa.Length = uint32(unsafe.Sizeof(oa))
+	var h windows.Handle
+	var status windows.IO_STATUS_BLOCK
+	e = windows.NtCreateFile(&h, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA|windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.SYNCHRONIZE, &oa, &status, nil, 0, 0, windows.FILE_OPEN_IF, windows.FILE_NON_DIRECTORY_FILE|windows.FILE_OPEN_REPARSE_POINT|windows.FILE_SYNCHRONOUS_IO_NONALERT, 0, 0)
+	runtime.KeepAlive(sd)
+	if e != nil {
+		return 0, ErrUpgrade
+	}
+	return h, nil
+}
+func openUpgradeStore(ctx context.Context, root *InstanceRoot, transaction string, create bool) (store *nativeUpgradeStore, records [][]byte, result error) {
+	if ctx == nil || ctx.Err() != nil || !upgradeHex(transaction, 32) {
+		return nil, nil, ErrUpgrade
+	}
+	parents, err := openInstanceParent(ctx, root, create)
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	s := &nativeUpgradeStore{parents: parents, sid: parents.sid}
+	ok := false
+	defer func() {
+		if !ok {
+			if s.Close() != nil {
+				store = s
+			}
+			result = ErrUpgrade
+		}
+	}()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != s.sid {
+		return nil, nil, ErrUpgrade
+	}
+	owner, err := upgradeOwnerLock(parents.leaf(), sid)
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	s.handles = append(s.handles, owner)
+	if verifyPrivate(owner, sid, false) != nil {
+		return nil, nil, ErrUpgrade
+	}
+	var sd *windows.SECURITY_DESCRIPTOR
+	if create {
+		sd, err = privateDescriptor(sid, true)
+		if err != nil {
+			return nil, nil, ErrUpgrade
+		}
+	}
+	dir, err := openRelative(parents.leaf(), "migration", true, sd, create)
+	if err != nil {
+		return nil, nil, ErrUpgrade
+	}
+	s.handles = append(s.handles, dir)
+	s.directory = dir
+	if verifyPrivate(dir, sid, true) != nil {
+		return nil, nil, ErrUpgrade
+	}
+	if !create {
+		missing := false
+		for sequence := uint32(1); sequence <= maxUpgradeRecords; sequence++ {
+			if ctx.Err() != nil {
+				return nil, nil, ErrUpgrade
+			}
+			h, e := openRelative(dir, upgradeRecordName(sequence), false, nil, false)
+			if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+				missing = true
+				continue
+			}
+			if e != nil {
+				return nil, nil, ErrUpgrade
+			}
+			s.handles = append(s.handles, h)
+			if missing || verifyPrivate(h, sid, false) != nil {
+				return nil, nil, ErrUpgrade
+			}
+			data, e := readUpgradeRecordHandle(h)
+			if e != nil {
+				return nil, nil, ErrUpgrade
+			}
+			record, e := parseUpgradeRecord(data)
+			if e != nil || record.Journal.Transaction != transaction {
+				return nil, nil, ErrUpgrade
+			}
+			records = append(records, data)
+		}
+		if len(records) == 0 {
+			return nil, nil, ErrUpgrade
+		}
+		names, nameErr := upgradeStoreNames(dir)
+		if nameErr != nil || !upgradeStoreLayoutMatch(names, len(records), records) {
+			return nil, nil, ErrUpgrade
+		}
+		if _, e := newUpgradeRecorder(s, records); e != nil {
+			return nil, nil, ErrUpgrade
+		}
+	}
+	ok = true
+	return s, records, nil
+}
+func upgradeRecordName(sequence uint32) string { return fmt.Sprintf("record-%02d.json", sequence) }
+func readUpgradeRecordHandle(h windows.Handle) ([]byte, error) {
+	var info windows.ByHandleFileInformation
+	if windows.GetFileInformationByHandle(h, &info) != nil || info.FileSizeHigh != 0 || info.FileSizeLow < 1 || info.FileSizeLow > maxUpgradeRecordBytes {
+		return nil, ErrUpgrade
+	}
+	data := make([]byte, info.FileSizeLow)
+	var total uint32
+	for total < uint32(len(data)) {
+		var n uint32
+		e := windows.ReadFile(h, data[total:], &n, nil)
+		if e != nil || n == 0 {
+			return nil, ErrUpgrade
+		}
+		total += n
+	}
+	return data, nil
+}
+func (s *nativeUpgradeStore) writeExclusive(ctx context.Context, sequence uint32, data []byte) (result error) {
+	if s == nil || ctx == nil || ctx.Err() != nil || sequence < 1 || sequence > maxUpgradeRecords || len(data) == 0 || len(data) > maxUpgradeRecordBytes {
+		return ErrUpgrade
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.uncertain {
+		return ErrUpgrade
+	}
+	s.uncertain = true
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	sid, err := currentOwner()
+	if err != nil || sid != s.sid {
+		return ErrUpgrade
+	}
+	sd, err := privateDescriptor(sid, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	h, err := openRelative(s.directory, upgradeRecordName(sequence), false, sd, true)
+	if err != nil {
+		return ErrUpgrade
+	}
+	closed := false
+	defer func() {
+		if !closed && windows.CloseHandle(h) != nil {
+			result = ErrUpgrade
+		}
+	}()
+	var before windows.ByHandleFileInformation
+	if verifyPrivate(h, sid, false) != nil || windows.GetFileInformationByHandle(h, &before) != nil {
+		return ErrUpgrade
+	}
+	for remaining := data; len(remaining) > 0; {
+		if ctx.Err() != nil {
+			return ErrUpgrade
+		}
+		n, e := nativeWrite(h, remaining)
+		if e != nil || n < 1 || n > len(remaining) {
+			return ErrUpgrade
+		}
+		remaining = remaining[n:]
+	}
+	if ctx.Err() != nil || windows.FlushFileBuffers(h) != nil {
+		return ErrUpgrade
+	}
+	closed = true
+	if windows.CloseHandle(h) != nil {
+		return ErrUpgrade
+	}
+	retained, err := openRelative(s.directory, upgradeRecordName(sequence), false, nil, false)
+	if err != nil {
+		return ErrUpgrade
+	}
+	s.handles = append(s.handles, retained)
+	var after windows.ByHandleFileInformation
+	if verifyPrivate(retained, sid, false) != nil || windows.GetFileInformationByHandle(retained, &after) != nil || before.VolumeSerialNumber != after.VolumeSerialNumber || before.FileIndexHigh != after.FileIndexHigh || before.FileIndexLow != after.FileIndexLow {
+		return ErrUpgrade
+	}
+	observed, err := readUpgradeRecordHandle(retained)
+	if err != nil || !bytes.Equal(observed, data) || ctx.Err() != nil {
+		return ErrUpgrade
+	}
+	s.uncertain = false
+	return nil
+}
+
+func upgradeStoreNames(directory windows.Handle) ([]string, error) {
+	var names []string
+	backing, buffer, allocationErr := managementDirectoryBuffer(2048)
+	if allocationErr != nil {
+		return nil, ErrUpgrade
+	}
+	class := uint32(windows.FileIdBothDirectoryRestartInfo)
+	for batch := 0; batch < 8; batch++ {
+		err := windows.GetFileInformationByHandleEx(directory, class, &buffer[0], uint32(len(buffer)))
+		runtime.KeepAlive(backing)
+		if err == windows.ERROR_NO_MORE_FILES {
+			return names, nil
+		}
+		if err != nil {
+			return nil, ErrUpgrade
+		}
+		class = windows.FileIdBothDirectoryInfo
+		parsed, err := datastoreDirectoryBatch(buffer)
+		if err != nil || len(names)+len(parsed) > maxUpgradeRecords {
+			return nil, ErrUpgrade
+		}
+		names = append(names, parsed...)
+		clear(buffer)
+	}
+	return nil, ErrUpgrade
+}
diff --git a/rdd/pkg/managementconfig/upgrade_store_windows_test.go b/rdd/pkg/managementconfig/upgrade_store_windows_test.go
