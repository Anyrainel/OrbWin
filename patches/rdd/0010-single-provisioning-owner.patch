@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin adaptation: the existing systemd unit owns stateful provisioning.
+package controllers
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"sigs.k8s.io/yaml"
+)
+
+func provisionTestBash(t *testing.T) string {
+	t.Helper()
+	if runtime.GOOS == "windows" {
+		git, err := exec.LookPath("git")
+		if err != nil {
+			t.Skip("Git Bash unavailable")
+		}
+		path := filepath.Join(filepath.Dir(git), "..", "bin", "bash.exe")
+		if _, err := os.Stat(path); err != nil {
+			t.Skip("Git Bash unavailable")
+		}
+		return path
+	}
+	path, err := exec.LookPath("bash")
+	if err != nil {
+		t.Skip("bash unavailable")
+	}
+	return path
+}
+
+func TestOwnedProvisioningContext(t *testing.T) {
+	const marker = "# ORBWIN_PROVISION_CONTEXT"
+	for _, tc := range []struct {
+		name, current, state, result string
+		allowed, success             bool
+	}{
+		{"authoritative namespace", "engine", "running", "success", true, true},
+		{"unrecognized private namespace", "foreign", "running", "success", false, false},
+		{"duplicate waits for success", "init", "exited", "success", false, true},
+		{"failed owner propagates", "init", "failed", "exit-code", false, false},
+		{"running owner cannot claim success", "init", "running", "success", false, false},
+		{"non-success exit cannot claim success", "init", "exited", "exit-code", false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// Function stubs isolate namespace/unit observations. Execute the actual
+			// generated guard; no host systemctl, sleeps or guest mutation runs.
+			prefix := fmt.Sprintf(`readlink() { case "$1" in /proc/self/ns/net) echo %s;; /proc/42/ns/net) echo engine;; *) echo init;; esac; }
+systemctl() { case "$3" in --property=SubState) echo %s;; --property=Result) echo %s;; --property=MainPID) echo 42;; esac; }
+sleep() { :; }
+`, tc.current, tc.state, tc.result)
+			guard := guardOwnedProvisioning("    " + marker + "\necho MUTATION\n")
+			// Preserve timeout control flow without spending 900 real polls in a
+			// unit test; the production deadline remains in the generated template.
+			guard = strings.ReplaceAll(guard, "orbwin_wait<900", "orbwin_wait<2")
+			cmd := exec.Command(provisionTestBash(t), "--noprofile", "--norc", "-s")
+			cmd.Stdin = strings.NewReader("set -eu\n" + prefix + guard)
+			for _, value := range os.Environ() {
+				if !strings.HasPrefix(value, "BASH_ENV=") {
+					cmd.Env = append(cmd.Env, value)
+				}
+			}
+			out, err := cmd.CombinedOutput()
+			if (err == nil) != tc.success || strings.Contains(string(out), "MUTATION") != tc.allowed {
+				t.Fatalf("result=%v output=%s", err, out)
+			}
+		})
+	}
+}
+
+func TestEveryStatefulProvisionHasContextGuard(t *testing.T) {
+	base, err := os.ReadFile("../lima-template.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc struct{ Provision []struct{ Script string } }
+	if err := yaml.Unmarshal([]byte(guardOwnedProvisioning(string(base))), &doc); err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	for _, item := range doc.Provision {
+		if item.Script == "" {
+			continue
+		}
+		count++
+		guard := strings.Index(item.Script, `readlink /proc/self/ns/net`)
+		if guard < 0 || strings.Contains(item.Script, "# ORBWIN_PROVISION_CONTEXT") {
+			t.Fatal("stateful script lacks namespace guard")
+		}
+		for _, mutation := range []string{"systemctl stop", "systemd-run", "STAGED="} {
+			if at := strings.Index(item.Script, mutation); at >= 0 && at < guard {
+				t.Fatal("mutation precedes namespace guard")
+			}
+		}
+	}
+	if count != 3 {
+		t.Fatalf("review changed provision surface: %d scripts", count)
+	}
+}
