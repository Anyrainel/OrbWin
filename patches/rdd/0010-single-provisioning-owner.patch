+
+// Lima's WSL boot command and the guest systemd unit both run boot.sh. Only
+// systemd has the configured engine network namespace. The direct boot path
+// must observe that existing unit, never race its stateful provision scripts.
+// Waiting in the first script also keeps Lima's boot-done marker honest.
+func guardOwnedProvisioning(base string) string {
+	const guard = `if [[ "$(readlink /proc/self/ns/net)" == "$(readlink /proc/1/ns/net)" ]]; then
+    echo "OrbWin: waiting for provisioning in lima-init.service"
+    for ((orbwin_wait=0; orbwin_wait<900; orbwin_wait++)); do
+        orbwin_unit_state=$(systemctl show lima-init.service --property=SubState --value)
+        orbwin_unit_result=$(systemctl show lima-init.service --property=Result --value)
+        if [[ "$orbwin_unit_state" == "exited" && "$orbwin_unit_result" == "success" ]]; then
+            echo "OrbWin: systemd provisioning completed; skipping duplicate script"
+            exit 0
+        fi
+        if [[ "$orbwin_unit_state" == "failed" ]]; then
+            echo "OrbWin: systemd provisioning failed: $orbwin_unit_result" >&2
+            exit 1
+        fi
+        sleep 1
+    done
+    echo "OrbWin: systemd provisioning did not finish within 900 seconds" >&2
+    exit 1
+fi
+orbwin_namespace_pid=$(systemctl show network-namespace.service --property=MainPID --value)
+if [[ ! "$orbwin_namespace_pid" =~ ^[1-9][0-9]*$ ]] || [[ "$(readlink /proc/self/ns/net)" != "$(readlink "/proc/$orbwin_namespace_pid/ns/net")" ]]; then
+    echo "OrbWin: provisioning is outside the owned network namespace" >&2
+    exit 1
+fi`
+	return strings.ReplaceAll(base, "    # ORBWIN_PROVISION_CONTEXT", "    "+strings.ReplaceAll(guard, "\n", "\n    "))
 }
 
