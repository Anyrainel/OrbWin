+// SPDX-License-Identifier: Apache-2.0
+// OrbWin product boundary: never operate a stock Rancher instance or shared
+// client configuration, including from dynamic help or autostart paths.
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+)
+
+func validateOrbWinInstance(name string) error {
+	if name != "orbwin" && name != "orbwin-proof" {
+		return fmt.Errorf("OrbWin build refuses instance %q; use orbwin (or orbwin-proof for management-only tests)", name)
+	}
+	return nil
+}
+
+func prepareOrbWinEnvironment() error {
+	name := os.Getenv("RDD_INSTANCE")
+	if name == "" {
+		name = "orbwin"
+		if err := os.Setenv("RDD_INSTANCE", name); err != nil {
+			return err
+		}
+	}
+	if err := validateOrbWinInstance(name); err != nil {
+		return err
+	}
+	for key, path := range map[string]string{
+		"DOCKER_CONFIG": filepath.Join(instance.ShortDir(), "docker"),
+		"KUBECONFIG":    filepath.Join(instance.ShortDir(), "kube-client.config"),
+	} {
+		if err := os.Setenv(key, path); err != nil {
+			return err
+		}
+	}
+	return nil
+}
