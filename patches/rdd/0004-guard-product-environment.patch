@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import "testing"
+
+func TestOrbWinRejectsForeignInstances(t *testing.T) {
+	for _, name := range []string{"2", "test", "orbwin-other", "../orbwin", `orbwin\..\2`, "OR BWIN"} {
+		if err := validateOrbWinInstance(name); err == nil {
+			t.Fatalf("accepted foreign identity %q", name)
+		}
+	}
+	for _, name := range []string{"orbwin", "orbwin-proof"} {
+		if err := validateOrbWinInstance(name); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
