diff --git a/rdd/pkg/controllers/app/app/controllers/guest_bridge.go b/rdd/pkg/controllers/app/app/controllers/guest_bridge.go
new file mode 100644
index 000000000..ae72279d4
--- /dev/null
+++ b/rdd/pkg/controllers/app/app/controllers/guest_bridge.go
@@ -0,0 +1,92 @@
+package controllers
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	goruntime "runtime"
+	"strings"
+	"sync"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/embedded"
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/instance"
+)
+
+// Windows replacement/open sharing is not equivalent to POSIX rename. Serialize
+// publishers in the single authoritative rdd process; disk identity remains the
+// content hash and is always checked on subsequent calls.
+var guestBridgeStageMu sync.Mutex
+
+// The Windows guest agent already publishes through gvisor. Lima's generic
+// SSH forwarder must not race that owner to bind/remove the same host ports.
+// Unix socket forwarding rules remain intact. Only product instances opt in.
+func ownedWindowsTemplate(base string) string {
+	if goruntime.GOOS != "windows" || (instance.Suffix() != "orbwin" && instance.Suffix() != "orbwin-proof") {
+		return base
+	}
+	return ignoreLimaNetworkPorts(base)
+}
+
+func ignoreLimaNetworkPorts(base string) string {
+	return strings.Replace(strings.ReplaceAll(base, "\r\n", "\n"), "portForwards:\n", "portForwards:\n- guestIP: 0.0.0.0\n  guestIPMustBeZero: false\n  guestPortRange: [1, 65535]\n  proto: any\n  ignore: true\n", 1)
+}
+
+// Stage immutable, content-addressed executable code. This never opens a VM
+// disk. Concurrent reconcilers may stage the same bytes; a mismatched existing
+// file is an error rather than permission to overwrite unknown state.
+func stageGuestBridge() (string, string, error) {
+	if goruntime.GOOS != "windows" || (instance.Suffix() != "orbwin" && instance.Suffix() != "orbwin-proof") || len(embedded.RDDGuest) == 0 {
+		return "", "", nil
+	}
+	return stageGuestBridgeAt(filepath.Join(instance.ShortDir(), "guest-code"), embedded.RDDGuest)
+}
+
+func stageGuestBridgeAt(dir string, payload []byte) (string, string, error) {
+	guestBridgeStageMu.Lock()
+	defer guestBridgeStageMu.Unlock()
+	digest := fmt.Sprintf("%x", sha256.Sum256(payload))
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", "", err
+	}
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return "", "", fmt.Errorf("guest code directory is not a regular directory")
+	}
+	path := filepath.Join(dir, "rdd-guest-"+digest)
+	if info, err := os.Lstat(path); err == nil {
+		if !info.Mode().IsRegular() {
+			return "", "", fmt.Errorf("guest code path is not a regular file")
+		}
+		data, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(data, payload) {
+			return "", "", fmt.Errorf("guest code checksum mismatch; preserve and inspect %s", path)
+		}
+		return toLinuxPath(path), digest, nil
+	} else if !os.IsNotExist(err) {
+		return "", "", err
+	}
+	file, err := os.CreateTemp(dir, ".stage-")
+	if err != nil {
+		return "", "", err
+	}
+	defer os.Remove(file.Name())
+	if _, err = file.Write(payload); err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return "", "", err
+	}
+	if err = os.Rename(file.Name(), path); err != nil {
+		data, readErr := os.ReadFile(path)
+		if readErr != nil || !bytes.Equal(data, payload) {
+			return "", "", err
+		}
+	}
+	return toLinuxPath(path), digest, nil
+}
