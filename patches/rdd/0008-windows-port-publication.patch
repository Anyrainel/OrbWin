+//go:build windows
+
+package hostswitch
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestPublicationGenerationsOnlyObserveSuccessfulOwnedListeners(t *testing.T) {
+	var epochs publicationEpochs
+	var calls atomic.Int32
+	handler := epochs.handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.Header.Get("Fail") != "" {
+			w.WriteHeader(409)
+		} else {
+			w.WriteHeader(200)
+		}
+	}))
+	send := func(path, local string, fail bool) {
+		request := httptest.NewRequest("POST", path, strings.NewReader(fmt.Sprintf(`{"local":%q,"protocol":"tcp","remote":"192.168.127.2:50000"}`, local)))
+		if fail {
+			request.Header.Set("Fail", "yes")
+		}
+		handler.ServeHTTP(httptest.NewRecorder(), request)
+	}
+	const local = "127.0.0.1:50000"
+	send("/services/forwarder/expose", local, false)
+	first := epochs.generation("tcp", local, func() bool { return true })
+	if first == 0 || epochs.generation("tcp", local, func() bool { return false }) != 0 {
+		t.Fatal("unverified listener accepted")
+	}
+	send("/services/forwarder/expose", local, true)
+	if epochs.generation("tcp", local, func() bool { return true }) != first {
+		t.Fatal("failed expose advanced generation")
+	}
+	send("/services/forwarder/unexpose", local, false)
+	if epochs.generation("tcp", local, func() bool { return true }) != 0 {
+		t.Fatal("removed listener retained generation")
+	}
+	send("/services/forwarder/expose", local, false)
+	if epochs.generation("tcp", local, func() bool { return true }) <= first {
+		t.Fatal("replacement listener has stale generation")
+	}
+	before := calls.Load()
+	handler.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest("POST", "/services/forwarder/expose", strings.NewReader(strings.Repeat("x", 16385))))
+	if calls.Load() != before {
+		t.Fatal("oversized request reached mutation handler")
+	}
+	var clients sync.WaitGroup
+	for n := 0; n < 32; n++ {
+		clients.Go(func() {
+			send("/services/forwarder/expose", local, false)
+			_ = epochs.generation("tcp", local, func() bool { return true })
+		})
+	}
+	clients.Wait()
+}
diff --git a/rdd/pkg/socketbridge/docker_ports_windows.go b/rdd/pkg/socketbridge/docker_ports_windows.go
new file mode 100644
index 000000000..4c2de4364
--- /dev/null
+++ b/rdd/pkg/socketbridge/docker_ports_windows.go
@@ -0,0 +1,431 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin Windows publication checks. Moby owns persisted bindings; the existing
+// virtual-network forwarder owns Windows listeners. No container/port database.
+//go:build windows
+
+package socketbridge
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// PortPublication reports an actual owned gvisor listener and its expected
+// guest destination, not merely a requested or observed Moby binding.
+type PortPublication func(protocol, port string) bool
+type PortGeneration func(protocol, port string) uint64
+
+type dockerBinding struct {
+	HostIP   string `json:"HostIp"`
+	HostPort string
+}
+type portContainer struct {
+	ID              string
+	HostConfig      struct{ PortBindings map[string][]dockerBinding }
+	State           *struct{ Running *bool }
+	NetworkSettings struct{ Ports map[string][]dockerBinding }
+}
+
+func (c portContainer) valid() bool {
+	if len(c.ID) != 64 || c.State == nil || c.State.Running == nil {
+		return false
+	}
+	_, err := hex.DecodeString(c.ID)
+	return err == nil
+}
+func (c portContainer) running() bool {
+	return c.State != nil && c.State.Running != nil && *c.State.Running
+}
+
+var portLifecycleRoute = regexp.MustCompile(`^(/v[0-9]+\.[0-9]+)?/containers/([^/]+)/(start|restart)$`)
+
+func dockerRead(ctx context.Context, transport http.RoundTripper, path string, into any) (int, error) {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://orbwin-guest"+path, nil)
+	if err != nil {
+		return 0, err
+	}
+	response, err := transport.RoundTrip(request)
+	if err != nil {
+		return 0, err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, (4<<20)+1))
+	if err != nil {
+		return response.StatusCode, err
+	}
+	if len(body) > 4<<20 {
+		return response.StatusCode, fmt.Errorf("Docker publication inspection exceeded 4 MiB")
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return response.StatusCode, nil
+	}
+	return response.StatusCode, json.Unmarshal(body, into)
+}
+
+func portProtocol(key string) (string, error) {
+	parts := strings.Split(key, "/")
+	if len(parts) != 2 {
+		return "", fmt.Errorf("invalid published container port")
+	}
+	number, err := strconv.ParseUint(parts[0], 10, 16)
+	if err != nil || number == 0 || (parts[1] != "tcp" && parts[1] != "udp") {
+		return "", fmt.Errorf("Windows publishing requires TCP/UDP ports 1–65535")
+	}
+	return parts[1], nil
+}
+func hostBinding(binding dockerBinding) error {
+	if binding.HostIP != "" && binding.HostIP != "0.0.0.0" && binding.HostIP != "127.0.0.1" {
+		return fmt.Errorf("Windows publishing currently supports IPv4 localhost; use an empty, wildcard or 127.0.0.1 host address")
+	}
+	return nil
+}
+
+// Convert automatic ports to explicit available Windows ports before Moby
+// creates the container, retaining unknown fields/number precision throughout.
+// A later port claim is handled by the start preflight and publication check.
+func rewriteCreatePorts(ctx context.Context, transport http.RoundTripper, prefix string, body []byte, allocate func(string) (string, error)) ([]byte, error) {
+	var document jsonFields
+	if err := json.Unmarshal(body, &document); err != nil {
+		return nil, err
+	}
+	raw := document["HostConfig"]
+	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+		return body, nil
+	}
+	var host jsonFields
+	if err := json.Unmarshal(raw, &host); err != nil {
+		return nil, err
+	}
+	bindings := map[string][]jsonFields{}
+	if raw = host["PortBindings"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+		if err := json.Unmarshal(raw, &bindings); err != nil {
+			return nil, err
+		}
+	}
+	var publishAll bool
+	if raw = host["PublishAllPorts"]; len(raw) > 0 {
+		if err := json.Unmarshal(raw, &publishAll); err != nil {
+			return nil, err
+		}
+	}
+	changed := false
+	if publishAll {
+		var image string
+		if err := json.Unmarshal(document["Image"], &image); err != nil {
+			return nil, err
+		}
+		var metadata struct {
+			Config struct{ ExposedPorts map[string]json.RawMessage }
+		}
+		status, err := dockerRead(ctx, transport, prefix+"/images/"+url.PathEscape(image)+"/json", &metadata)
+		if err != nil {
+			return nil, err
+		}
+		if status != 200 {
+			return nil, fmt.Errorf("cannot inspect image exposed ports (Docker status %d)", status)
+		}
+		exposed := map[string]json.RawMessage{}
+		if raw = document["ExposedPorts"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+			if err = json.Unmarshal(raw, &exposed); err != nil {
+				return nil, err
+			}
+		}
+		for key := range metadata.Config.ExposedPorts {
+			exposed[key] = nil
+		}
+		for key := range exposed {
+			if len(bindings[key]) == 0 {
+				bindings[key] = []jsonFields{{"HostIp": json.RawMessage(`""`), "HostPort": json.RawMessage(`""`)}}
+			}
+		}
+		host["PublishAllPorts"] = json.RawMessage("false")
+		changed = true
+	}
+	count := 0
+	for key, entries := range bindings {
+		protocol, err := portProtocol(key)
+		if err != nil {
+			return nil, err
+		}
+		for _, entry := range entries {
+			if entry == nil {
+				return nil, fmt.Errorf("publication binding must be an object")
+			}
+			count++
+			if count > 2048 {
+				return nil, fmt.Errorf("publication request exceeds 2048 bindings")
+			}
+			var binding dockerBinding
+			raw, _ := json.Marshal(entry)
+			if err = json.Unmarshal(raw, &binding); err != nil {
+				return nil, err
+			}
+			if err = hostBinding(binding); err != nil {
+				return nil, err
+			}
+			if binding.HostPort == "" || binding.HostPort == "0" {
+				port, err := allocate(protocol)
+				if err != nil {
+					return nil, err
+				}
+				entry["HostPort"], _ = json.Marshal(port)
+				changed = true
+			}
+		}
+	}
+	if !changed {
+		return body, nil
+	}
+	host["PortBindings"], _ = json.Marshal(bindings)
+	document["HostConfig"], _ = json.Marshal(host)
+	return json.Marshal(document)
+}
+
+func checkConfiguredPorts(bindings map[string][]dockerBinding, published PortPublication) error {
+	for key, entries := range bindings {
+		protocol, err := portProtocol(key)
+		if err != nil {
+			return err
+		}
+		for _, binding := range entries {
+			if err = hostBinding(binding); err != nil {
+				return err
+			}
+			if binding.HostPort == "" || binding.HostPort == "0" {
+				continue
+			} // Older containers still get a post-start check.
+			port, err := strconv.ParseUint(binding.HostPort, 10, 16)
+			if err != nil || port == 0 {
+				return fmt.Errorf("invalid configured host port")
+			}
+			if published != nil && published(protocol, binding.HostPort) {
+				continue
+			}
+			address := net.JoinHostPort("127.0.0.1", binding.HostPort)
+			if protocol == "tcp" {
+				listener, e := net.Listen("tcp4", address)
+				if e != nil {
+					return fmt.Errorf("Windows host port %s/%s is unavailable: %w. Choose another port; other engines were not stopped", binding.HostPort, protocol, e)
+				}
+				if e = listener.Close(); e != nil {
+					return e
+				}
+			} else {
+				listener, e := net.ListenPacket("udp4", address)
+				if e != nil {
+					return fmt.Errorf("Windows host port %s/%s is unavailable: %w", binding.HostPort, protocol, e)
+				}
+				if e = listener.Close(); e != nil {
+					return e
+				}
+			}
+		}
+	}
+	return nil
+}
+
+type portResponse struct {
+	header   http.Header
+	status   int
+	body     bytes.Buffer
+	overflow bool
+}
+
+func (w *portResponse) Header() http.Header { return w.header }
+func (w *portResponse) WriteHeader(code int) {
+	if w.status == 0 {
+		w.status = code
+	}
+}
+func (w *portResponse) Write(body []byte) (int, error) {
+	if w.status == 0 {
+		w.status = 200
+	}
+	if w.body.Len()+len(body) > 65536 {
+		w.overflow = true
+		return 0, fmt.Errorf("start response exceeds 64 KiB")
+	}
+	return w.body.Write(body)
+}
+
+func portsPublished(bindings map[string][]dockerBinding, published PortPublication) bool {
+	for key, entries := range bindings {
+		protocol, err := portProtocol(key)
+		if err != nil {
+			return false
+		}
+		for _, binding := range entries {
+			if net.ParseIP(binding.HostIP) != nil && net.ParseIP(binding.HostIP).To4() == nil {
+				continue
+			}
+			if binding.HostPort != "" && (published == nil || !published(protocol, binding.HostPort)) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func withPortLifecycle(next http.Handler, transport http.RoundTripper, published PortPublication, reservations *portReservations, generations ...PortGeneration) http.Handler {
+	var generation PortGeneration
+	if len(generations) > 0 {
+		generation = generations[0]
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodGet && r.URL.Path == "/orbwin/port-status" {
+			publicationStatus(w, r, transport, published)
+			return
+		}
+		match := portLifecycleRoute.FindStringSubmatch(r.URL.Path)
+		if r.Method != http.MethodPost || match == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+		lifecycleCtx, cancelLifecycle := context.WithTimeout(r.Context(), 2*time.Minute)
+		defer cancelLifecycle()
+		r = r.WithContext(lifecycleCtx)
+		path := match[1] + "/containers/" + url.PathEscape(match[2]) + "/json"
+		var container portContainer
+		status, err := dockerRead(r.Context(), transport, path, &container)
+		if err != nil {
+			dockerError(w, 502, "Could not inspect configured publication before dispatch: "+err.Error())
+			return
+		}
+		if status != 200 {
+			dockerError(w, status, "Container inspection failed before dispatch; refresh the target before retrying.")
+			return
+		}
+		if !container.valid() {
+			dockerError(w, 502, "Container inspection was incomplete. No start/restart was dispatched.")
+			return
+		}
+		// Bind preflight and mutation to one inspected ID, even if a name is
+		// concurrently reassigned to a replacement container.
+		path = match[1] + "/containers/" + container.ID + "/json"
+		r.URL.Path = match[1] + "/containers/" + container.ID + "/" + match[3]
+		r.URL.RawPath = ""
+		if status == 200 {
+			release := reservations.beginStart(container.ID)
+			defer release()
+		}
+		if status == 200 {
+			if err = checkConfiguredPorts(container.HostConfig.PortBindings, published); err != nil {
+				dockerError(w, 409, err.Error())
+				return
+			}
+		}
+		response := &portResponse{header: make(http.Header)}
+		before := map[string]uint64{}
+		fresh := generation != nil && (match[3] == "restart" || !container.running())
+		if fresh {
+			for key, entries := range container.HostConfig.PortBindings {
+				protocol, _ := portProtocol(key)
+				for _, binding := range entries {
+					before[protocol+"/"+binding.HostPort] = generation(protocol, binding.HostPort)
+				}
+			}
+		}
+		next.ServeHTTP(response, r)
+		if response.overflow {
+			dockerError(w, 502, "Start response exceeded its bound. Inspect state before retrying; the container may be running.")
+			return
+		}
+		if (response.status >= 200 && response.status < 300) || response.status == http.StatusNotModified {
+			ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+			defer cancel()
+			for {
+				container = portContainer{}
+				status, err = dockerRead(ctx, transport, path, &container)
+				if err == nil && status == 200 && container.valid() && (!container.running() || ((len(container.HostConfig.PortBindings) == 0 || len(container.NetworkSettings.Ports) > 0) && portsPublished(container.NetworkSettings.Ports, published) && (!fresh || newerPublications(container.NetworkSettings.Ports, before, generation)))) {
+					break
+				}
+				select {
+				case <-ctx.Done():
+					dockerError(w, 502, "The container may be running, but its Windows port publication could not be verified. A port may be in use by another service. Refresh and inspect before retrying; no other engine was stopped.")
+					return
+				case <-time.After(100 * time.Millisecond):
+				}
+			}
+		}
+		writePortResponse(w, response)
+	})
+}
+
+func newerPublications(bindings map[string][]dockerBinding, before map[string]uint64, generation PortGeneration) bool {
+	for key, entries := range bindings {
+		protocol, err := portProtocol(key)
+		if err != nil {
+			return false
+		}
+		for _, binding := range entries {
+			if net.ParseIP(binding.HostIP) != nil && net.ParseIP(binding.HostIP).To4() == nil {
+				continue
+			}
+			if binding.HostPort != "" && generation(protocol, binding.HostPort) <= before[protocol+"/"+binding.HostPort] {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func writePortResponse(w http.ResponseWriter, response *portResponse) {
+	for key, values := range response.header {
+		w.Header()[key] = values
+	}
+	if response.status == 0 {
+		response.status = 200
+	}
+	w.WriteHeader(response.status)
+	_, _ = w.Write(response.body.Bytes())
+}
+
+func publicationStatus(w http.ResponseWriter, r *http.Request, transport http.RoundTripper, published PortPublication) {
+	var containers []struct {
+		ID    string
+		Ports []struct {
+			IP         string
+			PublicPort uint16
+			Type       string
+		}
+	}
+	status, err := dockerRead(r.Context(), transport, "/containers/json", &containers)
+	if err != nil || status != 200 {
+		dockerError(w, 502, "Could not inspect running publications")
+		return
+	}
+	type entry struct {
+		ContainerID string `json:"containerId"`
+		Port        uint16 `json:"port"`
+		Protocol    string `json:"protocol"`
+		Published   bool   `json:"published"`
+	}
+	result := []entry{}
+	for _, container := range containers {
+		for _, port := range container.Ports {
+			if port.PublicPort == 0 || net.ParseIP(port.IP) == nil || net.ParseIP(port.IP).To4() == nil {
+				continue
+			}
+			if len(result) >= 2048 {
+				dockerError(w, 502, "Publication snapshot exceeds 2048 bindings")
+				return
+			}
+			result = append(result, entry{container.ID, port.PublicPort, port.Type, published != nil && published(port.Type, strconv.Itoa(int(port.PublicPort)))})
+		}
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(result)
+}
diff --git a/rdd/pkg/socketbridge/docker_ports_windows_test.go b/rdd/pkg/socketbridge/docker_ports_windows_test.go
new file mode 100644
