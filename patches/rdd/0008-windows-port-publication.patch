@@ -0,0 +1,72 @@
+package controllers
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"sigs.k8s.io/yaml"
+)
+
+func TestGuestBridgeStaging(t *testing.T) {
+	dir := t.TempDir()
+	payload := []byte("verified guest code")
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Go(func() {
+			_, hash, err := stageGuestBridgeAt(dir, payload)
+			if err != nil || len(hash) != 64 {
+				t.Errorf("stage: %s %v", hash, err)
+			}
+		})
+	}
+	wg.Wait()
+	files, err := os.ReadDir(dir)
+	if err != nil || len(files) != 1 {
+		t.Fatalf("temporary files leaked: %v %v", files, err)
+	}
+	path := filepath.Join(dir, files[0].Name())
+	if err := os.WriteFile(path, []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := stageGuestBridgeAt(dir, payload); err == nil {
+		t.Fatal("corrupt code was accepted")
+	}
+	data, _ := os.ReadFile(path)
+	if string(data) != "corrupt" {
+		t.Fatal("unknown code overwritten")
+	}
+}
+
+func TestOwnedNetworkForwardingHasOneOwner(t *testing.T) {
+	base, err := os.ReadFile("../lima-template.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := ignoreLimaNetworkPorts(string(base))
+	var config struct {
+		PortForwards []struct {
+			Ignore            bool
+			GuestPortRange    []int
+			GuestSocket       string
+			GuestIPMustBeZero *bool
+		}
+	}
+	if err := yaml.Unmarshal([]byte(got), &config); err != nil {
+		t.Fatal(err)
+	}
+	if len(config.PortForwards) < 3 || !config.PortForwards[0].Ignore || len(config.PortForwards[0].GuestPortRange) != 2 || config.PortForwards[0].GuestPortRange[1] != 65535 {
+		t.Fatal("network ignore rule is not first")
+	}
+	if config.PortForwards[0].GuestIPMustBeZero == nil || *config.PortForwards[0].GuestIPMustBeZero {
+		t.Fatal("loopback-specific publications must also be ignored; Lima defaults wildcard GuestIP to exact match")
+	}
+	if strings.Count(got, "guestSocket:") != strings.Count(string(base), "guestSocket:") {
+		t.Fatal("Unix socket rules changed")
+	}
+	if !strings.Contains(got, "guestSocket: /var/run/docker.sock") {
+		t.Fatal("Docker Unix rule lost")
+	}
+}
