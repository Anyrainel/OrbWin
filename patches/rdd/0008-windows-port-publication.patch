index 000000000..66739aac5
--- /dev/null
+++ b/rdd/pkg/hostswitch/publication_windows.go
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: Apache-2.0
+//go:build windows
+
+package hostswitch
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+)
+
+// Observe only successful mutations of the existing forwarder. The actual
+// listener map remains authoritative. A generation distinguishes a restarted
+// listener from the still-live previous publication while guest events queue.
+type publicationEpochs struct {
+	mutex  sync.Mutex
+	next   uint64
+	active map[string]uint64
+}
+
+func (p *publicationEpochs) handler(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(io.LimitReader(r.Body, 16385))
+		_ = r.Body.Close()
+		if err != nil || len(body) > 16384 {
+			http.Error(w, "forwarder request exceeds 16 KiB", http.StatusRequestEntityTooLarge)
+			return
+		}
+		var request struct {
+			Local    string
+			Protocol string
+		}
+		if json.Unmarshal(body, &request) != nil {
+			http.Error(w, "invalid forwarder request", http.StatusBadRequest)
+			return
+		}
+		if request.Protocol == "" {
+			request.Protocol = "tcp"
+		}
+		r.Body = io.NopCloser(bytes.NewReader(body))
+		response := httptest.NewRecorder()
+		func() {
+			p.mutex.Lock()
+			defer p.mutex.Unlock()
+			next.ServeHTTP(response, r)
+			if response.Code >= 200 && response.Code < 300 {
+				if p.active == nil {
+					p.active = map[string]uint64{}
+				}
+				key := request.Protocol + "/" + request.Local
+				switch r.URL.Path {
+				case "/services/forwarder/expose":
+					p.next++
+					p.active[key] = p.next
+				case "/services/forwarder/unexpose":
+					delete(p.active, key)
+				}
+			}
+		}()
+		for key, values := range response.Header() {
+			w.Header()[key] = values
+		}
+		w.WriteHeader(response.Code)
+		_, _ = w.Write(response.Body.Bytes())
+	})
+}
+
+func (p *publicationEpochs) generation(protocol, local string, actual func() bool) uint64 {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if !actual() {
+		return 0
+	}
+	return p.active[protocol+"/"+local]
+}
