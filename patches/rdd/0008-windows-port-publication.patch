+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func clientFixture(t *testing.T) (string, *tls.Config) {
+	t.Helper()
+	directory := t.TempDir()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	authority := &x509.Certificate{SerialNumber: big.NewInt(1), IsCA: true, BasicConstraintsValid: true, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageCertSign}
+	ca, err := x509.CreateCertificate(rand.Reader, authority, authority, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf := &x509.Certificate{SerialNumber: big.NewInt(2), DNSNames: []string{"orbwin-wsl-gateway"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth, x509.ExtKeyUsageClientAuth}}
+	certificate, err := x509.CreateCertificate(rand.Reader, leaf, authority, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})
+	private := pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: encoded})
+	root := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ca})
+	for name, bytes := range map[string][]byte{"ca.pem": root, "client.pem": cert, "client.key": private} {
+		if err = os.WriteFile(filepath.Join(directory, name), bytes, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	pair, err := tls.X509KeyPair(cert, private)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool := x509.NewCertPool()
+	pool.AppendCertsFromPEM(root)
+	return directory, &tls.Config{MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{pair}, ClientCAs: pool, ClientAuth: tls.RequireAndVerifyClientCert}
+}
+
+func TestWSLRelayPreservesEarlyUpgradeAndHalfClose(t *testing.T) {
+	directory, config := clientFixture(t)
+	t.Setenv("ORBWIN_WSL_TLS_DIR", directory)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		connection, buffer, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer connection.Close()
+		fmt.Fprint(connection, "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: proof\r\n\r\n")
+		bytes, err := io.ReadAll(buffer.Reader)
+		if err == nil {
+			_, _ = connection.Write(append([]byte("drained:"), bytes...))
+		}
+	}))
+	server.TLS = config
+	server.StartTLS()
+	defer server.Close()
+	listener, err := net.Listen("unix", filepath.Join(t.TempDir(), "client.sock"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	done := make(chan struct{})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	go func() {
+		defer close(done)
+		connection, err := listener.Accept()
+		if err == nil {
+			relayWSLClient(ctx, connection, server.Listener.Addr().String())
+		}
+	}()
+	connection, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: listener.Addr().String(), Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	connection.SetDeadline(time.Now().Add(4 * time.Second))
+	fmt.Fprint(connection, "GET / HTTP/1.1\r\nHost: proof\r\nConnection: Upgrade\r\nUpgrade: proof\r\n\r\nearly-bytes")
+	reader := bufio.NewReader(connection)
+	response, err := http.ReadResponse(reader, &http.Request{Method: "GET"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode != 101 {
+		t.Fatal(response.Status)
+	}
+	if err = connection.CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	bytes, err := io.ReadAll(reader)
+	if err != nil || string(bytes) != "drained:early-bytes" {
+		t.Fatalf("half-close lost output: %q %v", bytes, err)
+	}
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("relay did not finish")
+	}
+}
+
+func TestWSLRelayCancellationAndCredentialBounds(t *testing.T) {
+	directory, config := clientFixture(t)
+	t.Setenv("ORBWIN_WSL_TLS_DIR", directory)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	server.TLS = config
+	server.StartTLS()
+	defer server.Close()
+	listener, err := net.Listen("unix", filepath.Join(t.TempDir(), "cancel.sock"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		connection, err := listener.Accept()
+		if err == nil {
+			relayWSLClient(ctx, connection, server.Listener.Addr().String())
+		}
+	}()
+	connection, err := net.Dial("unix", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancelled relay remained active")
+	}
+	if err = os.WriteFile(filepath.Join(directory, "ca.pem"), make([]byte, 65537), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = wslClientTLS(directory); err == nil {
+		t.Fatal("accepted oversized credentials")
+	}
+	if _, err = listenWSLClient(filepath.Join(t.TempDir(), "foreign.sock")); err == nil {
+		t.Fatal("accepted non-owned endpoint")
+	}
+}
