--- /dev/null
+++ b/rdd/pkg/socketbridge/docker_ports_windows_test.go
@@ -0,0 +1,350 @@
+// SPDX-License-Identifier: Apache-2.0
+//go:build windows
+
+package socketbridge
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestConcurrentAllocationClaimsAreBoundedAndCloseOnCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	pool := newPortReservations(ctx)
+	defer cancel()
+	var workers sync.WaitGroup
+	allocated := make(chan *portReservation, 32)
+	failures := make(chan error, 32)
+	for i := 0; i < 32; i++ {
+		workers.Go(func() {
+			entry, err := pool.allocate("tcp")
+			if err != nil {
+				failures <- err
+			} else {
+				allocated <- entry
+			}
+		})
+	}
+	workers.Wait()
+	close(allocated)
+	close(failures)
+	for err := range failures {
+		t.Fatal(err)
+	}
+	seen := map[string]bool{}
+	var entries []*portReservation
+	for entry := range allocated {
+		if seen[entry.key] {
+			t.Fatal("duplicate live allocation")
+		}
+		seen[entry.key] = true
+		entries = append(entries, entry)
+	}
+	if len(entries) != 32 {
+		t.Fatal("lost allocation")
+	}
+	for _, entry := range entries {
+		listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", entry.port))
+		if err == nil {
+			listener.Close()
+			t.Fatal("reservation did not hold the port")
+		}
+	}
+	cancel()
+	pool.close()
+	for _, entry := range entries {
+		listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", entry.port))
+		if err != nil {
+			t.Fatal("cancelled allocation retained its FD:", err)
+		}
+		listener.Close()
+	}
+	if _, err := pool.allocate("tcp"); err == nil {
+		t.Fatal("allocation continued after cancellation")
+	}
+}
+
+func TestFailedCreateReleasesItsAllocation(t *testing.T) {
+	var port string
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			HostConfig struct{ PortBindings map[string][]dockerBinding }
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		port = body.HostConfig.PortBindings["80/tcp"][0].HostPort
+		w.WriteHeader(500)
+		fmt.Fprint(w, `{"message":"injected create failure"}`)
+	}))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	pool := newPortReservations(ctx)
+	response := httptest.NewRecorder()
+	dockerHandlerReserved(transport, nil, pool).ServeHTTP(response, httptest.NewRequest("POST", "/containers/create", strings.NewReader(`{"HostConfig":{"PortBindings":{"80/tcp":[{"HostPort":""}]}}}`)))
+	if response.Code != 500 || port == "" {
+		t.Fatalf("wrong create outcome: %d %s", response.Code, response.Body)
+	}
+	listener, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", port))
+	if err != nil {
+		t.Fatal("failed create retained its allocation:", err)
+	}
+	listener.Close()
+}
+
+func TestAutomaticPortsPersistExplicitWindowsBindings(t *testing.T) {
+	body := []byte(`{"Future":9007199254740993,"HostConfig":{"Unknown":{"value":9007199254740995},"PortBindings":{"6379/tcp":[{"HostIp":"127.0.0.1","HostPort":"","Future":true}],"53/udp":[{"HostPort":"0"}]}}}`)
+	count := 0
+	changed, err := rewriteCreatePorts(context.Background(), nil, "", body, func(protocol string) (string, error) {
+		count++
+		if protocol != "tcp" && protocol != "udp" {
+			t.Fatal(protocol)
+		}
+		return "49199", nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 || !bytes.Contains(changed, []byte(`9007199254740993`)) || !bytes.Contains(changed, []byte(`9007199254740995`)) || !bytes.Contains(changed, []byte(`"Future":true`)) {
+		t.Fatalf("fields changed: %s", changed)
+	}
+	repeated, err := rewriteCreatePorts(context.Background(), nil, "", changed, func(string) (string, error) { t.Fatal("reallocated explicit port"); return "", nil })
+	if err != nil || !bytes.Equal(repeated, changed) {
+		t.Fatalf("explicit binding changed: %s %v", repeated, err)
+	}
+	for _, body := range []string{`{"HostConfig":{"PortBindings":{"80/tcp":[null]}}}`, `{"HostConfig":{"PortBindings":{"80/sctp":[{"HostPort":""}]}}}`, `{"HostConfig":{"PortBindings":{"80/tcp":[{"HostIp":"192.0.2.1","HostPort":""}]}}}`} {
+		if _, err := rewriteCreatePorts(context.Background(), nil, "", []byte(body), func(string) (string, error) { t.Fatal("allocated an unsupported binding"); return "", nil }); err == nil {
+			t.Fatal("accepted unsupported binding")
+		}
+	}
+}
+
+func TestPublishAllUsesImageAndRequestExposedPorts(t *testing.T) {
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "GET" || r.URL.Path != "/v1.54/images/image/json" {
+			t.Errorf("wrong inspection: %s", r.URL.Path)
+		}
+		fmt.Fprint(w, `{"Config":{"ExposedPorts":{"80/tcp":{}}}}`)
+	}))
+	body, err := rewriteCreatePorts(context.Background(), transport, "/v1.54", []byte(`{"Image":"image","ExposedPorts":{"53/udp":{}},"HostConfig":{"PublishAllPorts":true},"Future":9007199254740993}`), func(string) (string, error) { return "49198", nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value struct {
+		HostConfig struct {
+			PublishAllPorts bool
+			PortBindings    map[string][]dockerBinding
+		}
+	}
+	if json.Unmarshal(body, &value) != nil || value.HostConfig.PublishAllPorts || len(value.HostConfig.PortBindings) != 2 {
+		t.Fatalf("publish-all not expanded: %s", body)
+	}
+}
+
+func TestIncompleteInspectionCannotDispatchStart(t *testing.T) {
+	var mutations atomic.Int32
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "POST" {
+			mutations.Add(1)
+			w.WriteHeader(204)
+		} else {
+			fmt.Fprint(w, `{"State":{"Running":false}}`)
+		}
+	}))
+	response := httptest.NewRecorder()
+	dockerHandlerPorts(transport, nil).ServeHTTP(response, httptest.NewRequest("POST", "/containers/name/start", nil))
+	if response.Code != 502 || mutations.Load() != 0 {
+		t.Fatalf("partial inspection dispatched mutation: %d", response.Code)
+	}
+}
+
+func TestForeignHostPortFailsBeforeStartDispatch(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	_, port, _ := net.SplitHostPort(listener.Addr().String())
+	var mutations atomic.Int32
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
