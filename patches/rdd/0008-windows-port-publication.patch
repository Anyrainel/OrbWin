+// SPDX-License-Identifier: Apache-2.0
+//go:build windows
+
+package socketbridge
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"time"
+)
+
+// Only short-lived allocation FDs are cached. Moby owns persisted bindings and
+// the existing gvisor forwarder owns active listeners. Reservations expire after
+// 30 seconds, survive no hostagent restart, and never start/stop a container.
+type portReservation struct {
+	key, port, container string
+	listener             io.Closer
+	timer                *time.Timer
+	generation           uint64
+}
+type portReservations struct {
+	mutex   sync.Mutex
+	entries map[string]*portReservation
+	closed  bool
+}
+
+func newPortReservations(ctx context.Context) *portReservations {
+	pool := &portReservations{entries: map[string]*portReservation{}}
+	context.AfterFunc(ctx, pool.close)
+	return pool
+}
+func (p *portReservations) close() {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	p.closed = true
+	for _, entry := range p.entries {
+		if entry.timer != nil {
+			entry.timer.Stop()
+		}
+		if entry.listener != nil {
+			_ = entry.listener.Close()
+		}
+	}
+	p.entries = map[string]*portReservation{}
+}
+func (p *portReservations) discard(entries []*portReservation) {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	for _, entry := range entries {
+		if p.entries[entry.key] != entry {
+			continue
+		}
+		if entry.timer != nil {
+			entry.timer.Stop()
+		}
+		if entry.listener != nil {
+			_ = entry.listener.Close()
+			entry.listener = nil
+		}
+		delete(p.entries, entry.key)
+	}
+}
+func (p *portReservations) allocate(protocol string) (*portReservation, error) {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if p.closed {
+		return nil, fmt.Errorf("host port allocator is closing")
+	}
+	if len(p.entries) >= 256 {
+		return nil, fmt.Errorf("256 host port allocations are pending; start or remove prepared containers and retry shortly")
+	}
+	for attempt := 0; attempt < 64; attempt++ {
+		var listener io.Closer
+		var address net.Addr
+		switch protocol {
+		case "tcp":
+			value, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				return nil, err
+			}
+			listener = value
+			address = value.Addr()
+		case "udp":
+			value, err := net.ListenPacket("udp4", "127.0.0.1:0")
+			if err != nil {
+				return nil, err
+			}
+			listener = value
+			address = value.LocalAddr()
+		default:
+			return nil, fmt.Errorf("only TCP/UDP allocation is supported")
+		}
+		_, port, err := net.SplitHostPort(address.String())
+		if err != nil {
+			_ = listener.Close()
+			return nil, err
+		}
+		key := protocol + "/" + port
+		if _, busy := p.entries[key]; busy {
+			_ = listener.Close()
+			continue
+		}
+		entry := &portReservation{key: key, port: port, listener: listener}
+		p.entries[key] = entry
+		p.schedule(entry, 30*time.Second)
+		return entry, nil
+	}
+	return nil, fmt.Errorf("could not select an unclaimed Windows port within the allocation bound")
+}
+func (p *portReservations) associate(entries []*portReservation, container string) {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	for _, entry := range entries {
+		if p.entries[entry.key] == entry {
+			entry.container = container
+		}
+	}
+}
+func (p *portReservations) beginStart(container string) func() {
+	p.mutex.Lock()
+	var starting []*portReservation
+	for _, entry := range p.entries {
+		if entry.container != container || container == "" {
+			continue
+		}
+		if entry.timer != nil {
+			entry.timer.Stop()
+		}
+		if entry.listener != nil {
+			_ = entry.listener.Close()
+			entry.listener = nil
+		}
+		p.schedule(entry, 3*time.Minute)
+		starting = append(starting, entry)
+	}
+	p.mutex.Unlock()
+	return func() { p.discard(starting) }
+}
+
+// Caller holds mutex. Generation prevents an already-fired old timer from
+// deleting a claim that was transferred from create to an active start request.
+func (p *portReservations) schedule(entry *portReservation, timeout time.Duration) {
+	entry.generation++
+	generation := entry.generation
+	entry.timer = time.AfterFunc(timeout, func() {
+		p.mutex.Lock()
+		defer p.mutex.Unlock()
+		if p.entries[entry.key] != entry || entry.generation != generation {
+			return
+		}
+		if entry.listener != nil {
+			_ = entry.listener.Close()
+			entry.listener = nil
+		}
+		delete(p.entries, entry.key)
+	})
+}
