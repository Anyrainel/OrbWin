diff --git a/rdd/src/rdd-guest/wsl_client.go b/rdd/src/rdd-guest/wsl_client.go
new file mode 100644
index 000000000..01d062105
--- /dev/null
+++ b/rdd/src/rdd-guest/wsl_client.go
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin's Unix client entrypoint in the existing rdd guest bridge. It carries
+// bytes to the same Windows Docker adapter, retaining upgrades and half-close.
+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+)
+
+const dockerClientGateway = "192.168.127.1:23760"
+
+func listenWSLClient(path string) (net.Listener, error) {
+	if path != "/mnt/wsl/orbwin/docker.sock" && path != "/mnt/wsl/orbwin-proof/docker.sock" && path != "/var/run/docker.sock" {
+		return nil, fmt.Errorf("refuse a non-owned WSL socket path")
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		return nil, err
+	}
+	if file, err := os.Lstat(path); err == nil {
+		if file.Mode()&os.ModeSocket == 0 {
+			return nil, fmt.Errorf("existing WSL endpoint is not a Unix socket; preserved")
+		}
+		connection, err := net.DialTimeout("unix", path, 200*time.Millisecond)
+		if err == nil {
+			_ = connection.Close()
+			return nil, fmt.Errorf("existing WSL endpoint is active; preserved")
+		}
+		if !errors.Is(err, os.ErrNotExist) && !errors.Is(err, syscall.ECONNREFUSED) {
+			return nil, fmt.Errorf("cannot verify stale WSL socket: %w", err)
+		}
+		if err = os.Remove(path); err != nil {
+			return nil, err
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	// Match the selected upstream's current-user WSL Docker access policy. This
+	// is within one Windows user's shared WSL utility VM, not a multi-user daemon.
+	if err = os.Chmod(path, 0666); err != nil {
+		_ = listener.Close()
+		return nil, err
+	}
+	return listener, nil
+}
+
+func serveWSLClients(ctx context.Context, listener net.Listener, slots chan struct{}) error {
+	stop := context.AfterFunc(ctx, func() { _ = listener.Close() })
+	defer stop()
+	defer listener.Close()
+	for {
+		select {
+		case slots <- struct{}{}:
+		case <-ctx.Done():
+			return nil
+		}
+		connection, err := listener.Accept()
+		if err != nil {
+			<-slots
+			if ctx.Err() != nil {
+				return nil
+			}
+			return err
+		}
+		go func() { defer func() { <-slots }(); relayWSLClient(ctx, connection, dockerClientGateway) }()
+	}
+}
+
+func relayWSLClient(ctx context.Context, connection net.Conn, address string) {
+	defer connection.Close()
+	config, err := wslClientTLS(os.Getenv("ORBWIN_WSL_TLS_DIR"))
+	if err != nil {
+		log.Printf("WSL client identity is unavailable: %v", err)
+		return
+	}
+	dialCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	upstream, err := (&tls.Dialer{NetDialer: &net.Dialer{Timeout: 10 * time.Second}, Config: config}).DialContext(dialCtx, "tcp4", address)
+	cancel()
+	if err != nil {
+		log.Printf("WSL client upstream is unavailable: %v", err)
+		return
+	}
+	defer upstream.Close()
+	stop := context.AfterFunc(ctx, func() { _ = connection.Close(); _ = upstream.Close() })
+	defer stop()
+	client, ok := connection.(halfCloser)
+	if !ok {
+		return
+	}
+	server, ok := upstream.(halfCloser)
+	if !ok {
+		return
+	}
+	pipe(client, server)
+}
+
+func wslClientTLS(directory string) (*tls.Config, error) {
+	if !filepath.IsAbs(directory) {
+		return nil, fmt.Errorf("owned WSL identity path must be absolute")
+	}
+	read := func(name string) ([]byte, error) {
+		file, err := os.Open(filepath.Join(directory, name))
+		if err != nil {
+			return nil, err
+		}
+		defer file.Close()
+		bytes, err := io.ReadAll(io.LimitReader(file, 65537))
+		if err != nil {
+			return nil, err
+		}
+		if len(bytes) > 65536 {
+			return nil, fmt.Errorf("WSL identity file exceeds 64 KiB")
+		}
+		return bytes, nil
+	}
+	ca, err := read("ca.pem")
+	if err != nil {
+		return nil, err
+	}
+	certificate, err := read("client.pem")
+	if err != nil {
+		return nil, err
+	}
+	key, err := read("client.key")
+	if err != nil {
+		return nil, err
+	}
+	pair, err := tls.X509KeyPair(certificate, key)
+	if err != nil {
+		return nil, err
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca) {
+		return nil, fmt.Errorf("owned WSL CA is invalid")
+	}
+	return &tls.Config{MinVersion: tls.VersionTLS13, ServerName: "orbwin-wsl-gateway", RootCAs: pool, Certificates: []tls.Certificate{pair}}, nil
+}
