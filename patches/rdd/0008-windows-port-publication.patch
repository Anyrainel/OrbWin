+// SPDX-License-Identifier: Apache-2.0
+// OrbWin private WSL relay identity. No OS certificate store or public listener.
+//go:build windows
+
+package socketbridge
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+const wslServerName = "orbwin-wsl-gateway"
+
+func authBytes(path string) ([]byte, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	bytes, err := io.ReadAll(io.LimitReader(file, 65537))
+	if err != nil {
+		return nil, err
+	}
+	if len(bytes) > 65536 {
+		return nil, fmt.Errorf("WSL certificate file exceeds 64 KiB")
+	}
+	return bytes, nil
+}
+
+func WSLServerTLS(directory string) (*tls.Config, error) {
+	absolute, err := filepath.Abs(directory)
+	if err != nil {
+		return nil, err
+	}
+	directory = absolute
+	if stat, err := os.Lstat(directory); errors.Is(err, os.ErrNotExist) {
+		if err = createWSLIdentity(directory); err != nil {
+			return nil, err
+		}
+	} else if err != nil {
+		return nil, err
+	} else if !stat.IsDir() || stat.Mode()&os.ModeSymlink != 0 {
+		return nil, fmt.Errorf("WSL identity directory is not an owned directory; preserved")
+	}
+	if err := restrictWSLIdentity(directory); err != nil {
+		return nil, fmt.Errorf("cannot protect private WSL identity: %w", err)
+	}
+	ca, err := authBytes(filepath.Join(directory, "ca.pem"))
+	if err != nil {
+		return nil, err
+	}
+	certificate, err := authBytes(filepath.Join(directory, "server.pem"))
+	if err != nil {
+		return nil, err
+	}
+	key, err := authBytes(filepath.Join(directory, "server.key"))
+	if err != nil {
+		return nil, err
+	}
+	pair, err := tls.X509KeyPair(certificate, key)
+	if err != nil {
+		return nil, fmt.Errorf("WSL server identity is invalid; preserved: %w", err)
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca) {
+		return nil, fmt.Errorf("WSL CA is invalid; preserved")
+	}
+	// Validate the companion client identity too, so incomplete state fails at
+	// startup rather than publishing a listener no owned client can use.
+	client, err := authBytes(filepath.Join(directory, "client.pem"))
+	if err != nil {
+		return nil, err
+	}
+	clientKey, err := authBytes(filepath.Join(directory, "client.key"))
+	if err != nil {
+		return nil, err
+	}
+	clientPair, err := tls.X509KeyPair(client, clientKey)
+	if err != nil {
+		return nil, err
+	}
+	clientCert, err := x509.ParseCertificate(clientPair.Certificate[0])
+	if err != nil {
+		return nil, err
+	}
+	if _, err = clientCert.Verify(x509.VerifyOptions{Roots: pool, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}}); err != nil {
+		return nil, fmt.Errorf("WSL client identity cannot be verified; preserved: %w", err)
+	}
+	serverCert, err := x509.ParseCertificate(pair.Certificate[0])
+	if err != nil {
+		return nil, err
+	}
+	if _, err = serverCert.Verify(x509.VerifyOptions{Roots: pool, DNSName: wslServerName, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}); err != nil {
+		return nil, fmt.Errorf("WSL server identity cannot be verified; preserved: %w", err)
+	}
+	return &tls.Config{MinVersion: tls.VersionTLS13, Certificates: []tls.Certificate{pair}, ClientCAs: pool, ClientAuth: tls.RequireAndVerifyClientCert}, nil
+}
+
+func createWSLIdentity(directory string) error {
+	if err := os.MkdirAll(filepath.Dir(directory), 0700); err != nil {
+		return err
+	}
+	staged, err := os.MkdirTemp(filepath.Dir(directory), ".wsl-auth-pending-")
+	if err != nil {
+		return err
+	}
+	// Only the newly created staging directory is disposable. The published
+	// directory, existing identities and unrelated files are never removed here.
+	if filepath.Dir(staged) != filepath.Dir(directory) || !strings.HasPrefix(filepath.Base(staged), ".wsl-auth-pending-") {
+		return fmt.Errorf("invalid WSL identity staging scope")
+	}
+	defer os.RemoveAll(staged)
+	if err = restrictWSLIdentity(staged); err != nil {
+		return err
+	}
+	serial := func() (*big.Int, error) { return rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128)) }
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		return err
+	}
+	number, err := serial()
+	if err != nil {
+		return err
+	}
+	now := time.Now()
+	expires := now.AddDate(10, 0, 0)
+	ca := &x509.Certificate{SerialNumber: number, Subject: pkix.Name{CommonName: "OrbWin private WSL relay CA"}, NotBefore: now.Add(-24 * time.Hour), NotAfter: expires, IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageCRLSign}
+	der, err := x509.CreateCertificate(rand.Reader, ca, ca, &caKey.PublicKey, caKey)
+	if err != nil {
+		return err
+	}
+	write := func(name, kind string, bytes []byte) error {
+		file, err := os.OpenFile(filepath.Join(staged, name), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			return err
+		}
+		if _, err = file.Write(pem.EncodeToMemory(&pem.Block{Type: kind, Bytes: bytes})); err == nil {
+			err = file.Sync()
+		}
+		closed := file.Close()
+		if err != nil {
+			return err
+		}
+		return closed
+	}
+	if err = write("ca.pem", "CERTIFICATE", der); err != nil {
+		return err
+	}
+	for _, role := range []string{"server", "client"} {
+		key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			return err
+		}
+		number, err := serial()
+		if err != nil {
+			return err
+		}
+		leaf := &x509.Certificate{SerialNumber: number, Subject: pkix.Name{CommonName: "OrbWin WSL " + role}, NotBefore: now.Add(-24 * time.Hour), NotAfter: expires, KeyUsage: x509.KeyUsageDigitalSignature}
+		if role == "server" {
+			leaf.DNSNames = []string{wslServerName}
+			leaf.ExtKeyUsage = []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}
+		} else {
+			leaf.ExtKeyUsage = []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}
+		}
+		der, err := x509.CreateCertificate(rand.Reader, leaf, ca, &key.PublicKey, caKey)
+		if err != nil {
+			return err
+		}
+		encoded, err := x509.MarshalPKCS8PrivateKey(key)
+		if err != nil {
+			return err
+		}
+		if err = write(role+".pem", "CERTIFICATE", der); err != nil {
+			return err
+		}
+		if err = write(role+".key", "PRIVATE KEY", encoded); err != nil {
+			return err
+		}
+	}
+	if err = os.Rename(staged, directory); err != nil {
+		// A concurrent hostagent may have published a complete identity first.
+		if _, exists := os.Stat(directory); exists == nil {
+			return nil
+		}
+		return err
+	}
+	return nil
+}
+
+func restrictWSLIdentity(directory string) error {
+	user, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		return err
+	}
+	descriptor, err := windows.SecurityDescriptorFromString("D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;" + user.User.Sid.String() + ")")
+	if err != nil {
+		return err
+	}
+	dacl, _, err := descriptor.DACL()
+	if err != nil {
+		return err
+	}
+	return windows.SetNamedSecurityInfo(directory, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, dacl, nil)
+}
