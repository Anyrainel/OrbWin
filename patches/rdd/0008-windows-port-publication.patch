+func TestWSLMutualTLSRejectsAnonymousAndForeignClients(t *testing.T) {
+	directory := filepath.Join(t.TempDir(), "identity")
+	config, err := WSLServerTLS(directory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var calls atomic.Int32
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); fmt.Fprint(w, "owned") }))
+	server.TLS = config
+	server.StartTLS()
+	defer server.Close()
+	ca, err := os.ReadFile(filepath.Join(directory, "ca.pem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AppendCertsFromPEM(ca)
+	request := func(certificates []tls.Certificate) error {
+		transport := &http.Transport{TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS13, ServerName: wslServerName, RootCAs: roots, Certificates: certificates}}
+		defer transport.CloseIdleConnections()
+		client := &http.Client{Transport: transport, Timeout: 3 * time.Second}
+		response, err := client.Get(server.URL)
+		if err == nil {
+			defer response.Body.Close()
+			_, err = io.ReadAll(response.Body)
+		}
+		return err
+	}
+	if request(nil) == nil || calls.Load() != 0 {
+		t.Fatal("anonymous client reached Docker handler")
+	}
+	other := filepath.Join(t.TempDir(), "foreign")
+	if _, err = WSLServerTLS(other); err != nil {
+		t.Fatal(err)
+	}
+	foreign, err := tls.LoadX509KeyPair(filepath.Join(other, "client.pem"), filepath.Join(other, "client.key"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if request([]tls.Certificate{foreign}) == nil || calls.Load() != 0 {
+		t.Fatal("foreign client reached Docker handler")
+	}
+	owned, err := tls.LoadX509KeyPair(filepath.Join(directory, "client.pem"), filepath.Join(directory, "client.key"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = request([]tls.Certificate{owned}); err != nil || calls.Load() != 1 {
+		t.Fatalf("owned client failed: %v", err)
+	}
+	before, _ := os.ReadFile(filepath.Join(directory, "client.key"))
+	if _, err = WSLServerTLS(directory); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := os.ReadFile(filepath.Join(directory, "client.key"))
+	if !bytes.Equal(before, after) {
+		t.Fatal("silently replaced identity")
+	}
+	if err = os.WriteFile(filepath.Join(directory, "server.key"), []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = WSLServerTLS(directory); err == nil {
+		t.Fatal("accepted corrupt identity")
+	}
+	after, _ = os.ReadFile(filepath.Join(directory, "server.key"))
+	if string(after) != "corrupt" {
+		t.Fatal("reset corrupt identity without explicit repair")
+	}
+}
