+	dockerHandlerPorts(transport, func(string, string) bool { return false }).ServeHTTP(response, httptest.NewRequest("POST", "/v1.54/containers/owned/start", nil))
+	if response.Code != 409 || mutations.Load() != 0 || !strings.Contains(response.Body.String(), "unavailable") {
+		t.Fatalf("false start: %d %s mutations=%d", response.Code, response.Body, mutations.Load())
+	}
+}
+
+func TestStartWaitsForOwnedPublicationAndReportsUncertainty(t *testing.T) {
+	for _, ready := range []bool{true, false} {
+		t.Run(fmt.Sprint(ready), func(t *testing.T) {
+			listener, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, port, _ := net.SplitHostPort(listener.Addr().String())
+			listener.Close()
+			var started atomic.Bool
+			var checks atomic.Int32
+			transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "POST" {
+					if r.URL.Path != "/containers/"+strings.Repeat("a", 64)+"/start" {
+						t.Errorf("start used mutable name: %s", r.URL.Path)
+					}
+					started.Store(true)
+					w.WriteHeader(204)
+					return
+				}
+				fmt.Fprintf(w, `{"Id":%q,"State":{"Running":%t},"HostConfig":{"PortBindings":{"80/tcp":[{"HostPort":%q}]}},"NetworkSettings":{"Ports":{"80/tcp":[{"HostIp":"127.0.0.1","HostPort":%q}]}}}`, strings.Repeat("a", 64), started.Load(), port, port)
+			}))
+			request := httptest.NewRequest("POST", "/containers/owned/start", nil)
+			ctx, cancel := context.WithTimeout(request.Context(), 300*time.Millisecond)
+			defer cancel()
+			request = request.WithContext(ctx)
+			response := httptest.NewRecorder()
+			dockerHandlerPorts(transport, func(string, string) bool {
+				if !started.Load() {
+					return false
+				}
+				return ready && checks.Add(1) >= 2
+			}).ServeHTTP(response, request)
+			if ready {
+				if response.Code != 204 || checks.Load() < 2 {
+					t.Fatalf("did not wait for publication: %d", response.Code)
+				}
+			} else if response.Code != 502 || !strings.Contains(response.Body.String(), "may be running") {
+				t.Fatalf("false publication success: %d %s", response.Code, response.Body)
+			}
+		})
+	}
+}
+
+func TestRestartRequiresNewPublicationGeneration(t *testing.T) {
+	for _, replacement := range []bool{false, true} {
+		t.Run(fmt.Sprint(replacement), func(t *testing.T) {
+			var revision atomic.Uint64
+			revision.Store(1)
+			var reads atomic.Int32
+			transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "POST" {
+					if replacement {
+						timer := time.AfterFunc(40*time.Millisecond, func() { revision.Store(2) })
+						t.Cleanup(func() { timer.Stop() })
+					}
+					w.WriteHeader(204)
+					return
+				}
+				reads.Add(1)
+				fmt.Fprintf(w, `{"Id":%q,"State":{"Running":true},"HostConfig":{"PortBindings":{"80/tcp":[{"HostPort":"55000"}]}},"NetworkSettings":{"Ports":{"80/tcp":[{"HostIp":"127.0.0.1","HostPort":"55000"}]}}}`, strings.Repeat("a", 64))
+			}))
+			ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+			defer cancel()
+			pool := newPortReservations(ctx)
+			handler := dockerHandlerReserved(transport, func(string, string) bool { return true }, pool, func(string, string) uint64 { return revision.Load() })
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, httptest.NewRequest("POST", "/containers/owned/restart", nil).WithContext(ctx))
+			if replacement && response.Code != 204 {
+				t.Fatalf("replacement rejected: %d %s", response.Code, response.Body)
+			}
+			if replacement && revision.Load() != 2 {
+				t.Fatal("restart returned before queued publication replacement")
+			}
+			if !replacement && response.Code != 502 {
+				t.Fatalf("previous listener acknowledged restart: %d", response.Code)
+			}
+			if reads.Load() < 2 {
+				t.Fatal("no post-mutation inspection")
+			}
+		})
+	}
+}
