@@ -17,6 +19,20 @@ import (
 
 // Additive owned publication observation. The original v1 endpoint and Docker lifecycle
 // behavior are untouched. Stable double observation is not a reservation/CAS.
+// The public nonce identifies this HTTP bridge lifetime. It confers no authority.
+// Missing entropy disables only v2 observations; existing Docker/v1 routes remain.
+func newPublicationOwner() string { return publicationOwnerFromEntropy(rand.Reader) }
+func publicationOwnerFromEntropy(entropy io.Reader) string {
+	var nonce [16]byte
+	if entropy == nil {
+		return ""
+	}
+	if _, err := io.ReadFull(entropy, nonce[:]); err != nil || nonce == [16]byte{} {
+		return ""
+	}
+	return hex.EncodeToString(nonce[:])
+}
