 const publicationFixtureID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
 
+func TestPublicationV2OwnerLifetimeSurvivesReadsButChangesAcrossRestart(t *testing.T) {
+	c := publicationFixture(t)
+	data, err := json.Marshal(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport := publicationFixtureTransport(func(*http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(string(data)))}, nil
+	})
+	handler := func() http.Handler {
+		return withPortLifecycle(http.NotFoundHandler(), transport, func(string, string) bool { return true }, nil, func(string, string) uint64 { return 1 })
+	}
+	read := func(h http.Handler) string {
+		response := httptest.NewRecorder()
+		h.ServeHTTP(response, httptest.NewRequest("GET", "/orbwin/port-status/v2/"+publicationFixtureID, nil))
+		var snapshot struct {
+			OwnerInstance string
+			Publications  []publicationV2Binding
+		}
+		if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &snapshot) != nil || len(snapshot.OwnerInstance) != 32 || len(snapshot.Publications) != 1 || snapshot.Publications[0].Generation != 1 {
+			t.Fatal("owner snapshot unavailable")
+		}
+		return snapshot.OwnerInstance
+	}
+	first := handler()
+	owner := read(first)
+	if read(first) != owner {
+		t.Fatal("ordinary read changed publication owner")
+	}
+	if read(handler()) == owner {
+		t.Fatal("restarted bridge reused old owner despite repeated numeric epoch")
+	}
+}
