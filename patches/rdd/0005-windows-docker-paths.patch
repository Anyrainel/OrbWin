new file mode 100644
index 000000000..e50e97143
--- /dev/null
+++ b/rdd/pkg/socketbridge/docker_windows.go
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin adaptation of the existing Windows Docker bridge, not another daemon.
+//go:build windows
+
+package socketbridge
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httputil"
+	"regexp"
+	"sync"
+	"time"
+
+	"github.com/Microsoft/go-winio"
+	"github.com/Microsoft/go-winio/pkg/guid"
+)
+
+var createRoute = regexp.MustCompile(`^/(?:v[0-9]+\.[0-9]+/)?(containers|volumes)/create$`)
+
+func dockerHandler(transport http.RoundTripper) http.Handler {
+	proxy := &httputil.ReverseProxy{
+		Rewrite: func(p *httputil.ProxyRequest) {
+			p.Out.URL.Scheme = "http"
+			p.Out.URL.Host = "orbwin-guest"
+			p.Out.Host = p.In.Host
+		},
+		Transport:     transport,
+		FlushInterval: -1,
+		ErrorHandler: func(w http.ResponseWriter, _ *http.Request, _ error) {
+			dockerError(w, http.StatusBadGateway, "The OrbWin guest connection failed. Inspect engine status before retrying; a mutation may already have taken effect.")
+		},
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if match := createRoute.FindStringSubmatch(r.URL.Path); r.Method == http.MethodPost && match != nil {
+			// Only finite create JSON is buffered; builds, logs, events and upgrades
+			// use the standard streaming proxy directly.
+			_ = http.NewResponseController(w).SetReadDeadline(time.Now().Add(30 * time.Second))
+			body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 4<<20))
+			_ = r.Body.Close()
+			_ = http.NewResponseController(w).SetReadDeadline(time.Time{})
+			if err != nil {
+				dockerError(w, http.StatusBadRequest, "Cannot read container/volume create JSON within the 4 MiB limit and read deadline.")
+				return
+			}
+			body, err = rewriteCreate(body, match[1] == "volumes")
+			if err != nil {
+				dockerError(w, http.StatusBadRequest, "Invalid create request: "+err.Error())
+				return
+			}
+			r.Body = io.NopCloser(bytes.NewReader(body))
+			r.ContentLength = int64(len(body))
+			r.TransferEncoding = nil
+		}
+		proxy.ServeHTTP(dockerResponse{w}, r)
+	})
+}
+
+func dockerError(w http.ResponseWriter, status int, message string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(map[string]string{"message": message})
+}
+
+// The bridge owns listener, HTTP server and all accepted connections, including
+// hijacked exec/BuildKit streams. Cancellation closes all of them. No UI state
+// participates. No environment HTTP proxy is consulted by the fixed dialer.
+func (b *HostBridge) serveDocker(ctx context.Context, listener net.Listener) error {
+	transport := &http.Transport{
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			vm, err := guid.FromString(b.vmGUID.String())
+			if err != nil {
+				return nil, err
+			}
+			ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+			defer cancel()
+			return winio.Dial(ctx, &winio.HvsockAddr{VMID: vm, ServiceID: winio.VsockServiceID(b.vsockPort)})
+		},
+		DisableCompression:    true,
+		MaxIdleConns:          16,
+		MaxIdleConnsPerHost:   16,
+		IdleConnTimeout:       30 * time.Second,
+		ResponseHeaderTimeout: 0,
+	}
+	return serveDockerHTTP(ctx, listener, dockerHandler(transport), transport.CloseIdleConnections)
+}
+
+func serveDockerHTTP(ctx context.Context, listener net.Listener, handler http.Handler, closeIdle func()) error {
+	tracked := &dockerListener{Listener: listener, ctx: ctx, connections: map[*dockerConn]struct{}{}}
+	server := &http.Server{
+		Handler:           handler,
+		ReadHeaderTimeout: 15 * time.Second,
+		MaxHeaderBytes:    1 << 20,
+		BaseContext:       func(net.Listener) context.Context { return ctx },
+	}
+	var once sync.Once
+	shutdown := func() {
+		once.Do(func() {
+			_ = server.Close()
+			tracked.mutex.Lock()
+			tracked.stopped = true
+			connections := make([]*dockerConn, 0, len(tracked.connections))
+			for conn := range tracked.connections {
+				connections = append(connections, conn)
+			}
+			tracked.mutex.Unlock()
+			for _, conn := range connections {
+				_ = conn.Close()
+			}
+			closeIdle()
+		})
+	}
+	done := make(chan struct{})
+	go func() {
+		select {
+		case <-ctx.Done():
+		case <-done:
+			return
+		}
+		shutdown()
+	}()
+	err := server.Serve(tracked)
+	shutdown()
+	close(done)
+	if errors.Is(err, http.ErrServerClosed) || ctx.Err() != nil {
+		return nil
+	}
+	return err
+}
+
+type dockerListener struct {
+	net.Listener
+	ctx         context.Context
+	mutex       sync.Mutex
+	stopped     bool
+	connections map[*dockerConn]struct{}
+}
+
+func (l *dockerListener) Accept() (net.Conn, error) {
+	conn, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	l.mutex.Lock()
+	defer l.mutex.Unlock()
+	if l.stopped || l.ctx.Err() != nil {
+		_ = conn.Close()
+		return nil, net.ErrClosed
+	}
+	tracked := &dockerConn{Conn: conn, owner: l}
+	l.connections[tracked] = struct{}{}
+	return tracked, nil
+}
+
+type dockerConn struct {
+	net.Conn
+	owner *dockerListener
+	once  sync.Once
+}
+
+func (c *dockerConn) CloseWrite() error { return closeDockerWrite(c.Conn) }
+
+func closeDockerWrite(conn net.Conn) error {
+	if half, ok := conn.(interface{ CloseWrite() error }); ok {
+		return half.CloseWrite()
+	}
+	return http.ErrNotSupported
+}
+
+// net/http may read upgraded bytes together with the HTTP headers. The standard
+// ReverseProxy uses the hijacked conn directly, so retain the buffered reader in
+// that conn. Otherwise early TTY/BuildKit input could silently disappear.
+type dockerResponse struct{ http.ResponseWriter }
+
+func (w dockerResponse) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+func (w dockerResponse) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, buffered, err := http.NewResponseController(w.ResponseWriter).Hijack()
+	if err != nil {
+		return nil, nil, err
+	}
+	// Drain only bytes already buffered, then bypass net/http's connReader.
+	// Reading EOF through connReader would cancel the request context and close
+	// the backend before its response to a client half-close can drain.
+	reader := io.MultiReader(io.LimitReader(buffered.Reader, int64(buffered.Reader.Buffered())), conn)
+	return &dockerBufferedConn{Conn: conn, reader: reader}, buffered, nil
+}
+
+type dockerBufferedConn struct {
+	net.Conn
+	reader io.Reader
+}
+
+func (c *dockerBufferedConn) Read(bytes []byte) (int, error) { return c.reader.Read(bytes) }
+func (c *dockerBufferedConn) CloseWrite() error              { return closeDockerWrite(c.Conn) }
+
+func (c *dockerConn) Close() error {
+	err := c.Conn.Close()
+	c.once.Do(func() { c.owner.mutex.Lock(); delete(c.owner.connections, c); c.owner.mutex.Unlock() })
+	return err
+}
diff --git a/rdd/pkg/socketbridge/docker_windows_test.go b/rdd/pkg/socketbridge/docker_windows_test.go
