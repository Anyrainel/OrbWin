index 000000000..93c83d0c5
--- /dev/null
+++ b/rdd/pkg/socketbridge/docker_windows_test.go
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin path/stream contract tests; no live guest or other engine required.
+//go:build windows
+
+package socketbridge
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWindowsCreatePreservesUnknownFields(t *testing.T) {
+	body := []byte(`{"Image":"alpine","Future":{"counter":9007199254740993},"HostConfig":{"FutureMountFlag":true,"Binds":["F:\\project with spaces:/data:ro","cache:/cache"],"Mounts":[{"Type":"bind","Source":"C:/例/file.txt","Target":"/file","ReadOnly":true,"Future":{"number":9007199254740995}},{"Type":"volume","Source":"cache","Target":"/cached"}]}}`)
+	translated, err := rewriteCreate(body, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value struct {
+		Future     json.RawMessage
+		HostConfig struct {
+			FutureMountFlag bool
+			Binds           []string
+			Mounts          []struct {
+				Source   string
+				ReadOnly bool
+				Future   json.RawMessage
+			}
+		}
+	}
+	if err := json.Unmarshal(translated, &value); err != nil {
+		t.Fatal(err)
+	}
+	if string(value.Future) != `{"counter":9007199254740993}` || !value.HostConfig.FutureMountFlag || value.HostConfig.Binds[0] != "/mnt/f/project with spaces:/data:ro" || value.HostConfig.Binds[1] != "cache:/cache" || value.HostConfig.Mounts[0].Source != "/mnt/c/例/file.txt" || !value.HostConfig.Mounts[0].ReadOnly || string(value.HostConfig.Mounts[0].Future) != `{"number":9007199254740995}` || value.HostConfig.Mounts[1].Source != "cache" {
+		t.Fatalf("lost or changed fields: %s", translated)
+	}
+	unchanged := []byte("{ \"HostConfig\": {\"Binds\":[\"/mnt/c/a:/data:ro\"]}, \"Unknown\":123 }")
+	actual, err := rewriteCreate(unchanged, false)
+	if err != nil || !bytes.Equal(actual, unchanged) {
+		t.Fatalf("unchanged JSON differs: %s %v", actual, err)
+	}
+}
+
+func TestWindowsBindFormsAndRejections(t *testing.T) {
+	for input, expected := range map[string]string{
+		`C:\work:/data:ro`:            "/mnt/c/work:/data:ro",
+		`\\?\F:\work:/data:rw,z`:      "/mnt/f/work:/data:rw,z",
+		`D:/work:/data`:               "/mnt/d/work:/data",
+		`/home/user/project:/data:ro`: `/home/user/project:/data:ro`,
+		`cache:/data`:                 `cache:/data`,
+	} {
+		actual, err := rewriteBind(input)
+		if err != nil || actual != expected {
+			t.Errorf("%q -> %q %v", input, actual, err)
+		}
+	}
+	for _, input := range []string{`C:relative:/data`, `\\server\share:/data`, `\\?\UNC\server\share:/data`, `\\.\pipe\a:/data`, `C:\path`} {
+		if _, err := rewriteBind(input); err == nil {
+			t.Errorf("accepted %q", input)
+		}
+	}
+	for _, body := range []string{`null`, `[]`, `{"HostConfig":42}`, `{"HostConfig":{"Binds":[3]}}`, `{"HostConfig":{"Mounts":[{"Type":"bind","Source":3}]}}`, `{`} {
+		if _, err := rewriteCreate([]byte(body), false); err == nil {
+			t.Errorf("accepted %s", body)
+		}
+	}
+	body, err := rewriteCreate([]byte(`{"Driver":"local","DriverOpts":{"type":"none","o":"bind,ro","device":"F:\\data"},"Future":9007199254740993}`), true)
+	if err != nil || !bytes.Contains(body, []byte(`"device":"/mnt/f/data"`)) || !bytes.Contains(body, []byte(`9007199254740993`)) {
+		t.Fatalf("volume: %s %v", body, err)
+	}
+}
+
+func testDockerTransport(t *testing.T, guest http.Handler) *http.Transport {
+	t.Helper()
+	upstream := httptest.NewServer(guest)
+	t.Cleanup(upstream.Close)
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", strings.TrimPrefix(upstream.URL, "http://"))
+	}}
+	t.Cleanup(transport.CloseIdleConnections)
+	return transport
+}
+
+func TestDockerHTTPRoutesAndBounds(t *testing.T) {
+	var received []byte
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received, _ = io.ReadAll(r.Body)
+		if r.Header.Get("X-Future-Header") != "retained" || r.URL.RawQuery != "name=example" {
+			t.Errorf("request metadata changed: %v %s", r.Header, r.URL)
+		}
+		w.Header().Set("X-Future-Response", "retained")
+		w.WriteHeader(http.StatusCreated)
+		_, _ = w.Write(received)
+	}))
+	handler := dockerHandler(transport)
+	for _, route := range []string{"/v1.56/containers/create", "/containers/create"} {
+		r := httptest.NewRequest("POST", route+"?name=example", strings.NewReader(`{"HostConfig":{"Binds":["F:\\work:/data:ro"]},"Future":1}`))
+		r.Header.Set("X-Future-Header", "retained")
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		if w.Code != 201 || w.Header().Get("X-Future-Response") != "retained" || !bytes.Contains(received, []byte("/mnt/f/work:/data:ro")) {
+			t.Fatalf("route %s: %d %s", route, w.Code, w.Body.String())
+		}
+	}
+	for _, body := range []string{`{`, strings.Repeat(" ", (4<<20)+1)} {
+		received = nil
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, httptest.NewRequest("POST", "/containers/create", strings.NewReader(body)))
+		if w.Code != 400 || received != nil {
+			t.Fatalf("invalid request reached daemon: %d", w.Code)
+		}
+	}
+	// Build/upload bodies are streams, including data larger than the create cap.
+	payload := bytes.Repeat([]byte{0, 1, 2, 0xff}, (5<<20)/4)
+	r := httptest.NewRequest("POST", "/build?name=example", bytes.NewReader(payload))
+	r.Header.Set("X-Future-Header", "retained")
+	w := httptest.NewRecorder()
+	handler.ServeHTTP(w, r)
+	if w.Code != 201 || !bytes.Equal(received, payload) {
+		t.Fatal("build stream changed")
+	}
+}
+
+func TestDockerUpgradeEarlyBytesHalfCloseAndShutdown(t *testing.T) {
+	transport := testDockerTransport(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		conn, rw, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		_, _ = rw.WriteString("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: tcp\r\n\r\n")
+		_ = rw.Flush()
+		// Echo after EOF proves client half-close does not discard response data.
+		data, err := io.ReadAll(rw.Reader)
+		if err != nil {
+			return
+		}
+		_, _ = conn.Write(append([]byte("after-eof:"), data...))
+	}))
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		done <- serveDockerHTTP(ctx, listener, dockerHandler(transport), transport.CloseIdleConnections)
+	}()
+	conn, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	_, _ = fmt.Fprint(conn, "POST /v1.56/exec/id/start HTTP/1.1\r\nHost: docker\r\nConnection: Upgrade\r\nUpgrade: tcp\r\nContent-Length: 2\r\n\r\n{}early-bytes")
+	reader := bufio.NewReader(conn)
+	response, err := http.ReadResponse(reader, nil)
+	if err != nil || response.StatusCode != 101 {
+		t.Fatalf("upgrade: %v %v", response, err)
+	}
+	if err := conn.(*net.TCPConn).CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := io.ReadAll(reader)
+	if err != nil || string(data) != "after-eof:early-bytes" {
+		t.Fatalf("half-close data: %q %v", data, err)
+	}
+	// A second active hijack must be closed promptly when the bridge stops.
+	other, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.Close()
+	_ = other.SetDeadline(time.Now().Add(5 * time.Second))
+	_, _ = fmt.Fprint(other, "POST /exec/id/start HTTP/1.1\r\nHost: docker\r\nConnection: Upgrade\r\nUpgrade: tcp\r\nContent-Length: 2\r\n\r\n{}")
+	otherReader := bufio.NewReader(other)
+	if _, err := http.ReadResponse(otherReader, nil); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("bridge did not stop")
+	}
+	if _, err := otherReader.ReadByte(); err == nil {
+		t.Fatal("hijacked connection survived shutdown")
+	} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("shutdown left a blocked connection")
+	}
+}
