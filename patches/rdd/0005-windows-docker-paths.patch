index 000000000..108c7c3b2
--- /dev/null
+++ b/rdd/pkg/socketbridge/docker_paths.go
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+// OrbWin Windows Docker API adaptation. Moby remains authoritative.
+package socketbridge
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/guestexec"
+)
+
+// driveSource never resolves relative paths against the bridge process's cwd.
+// POSIX paths and volume names pass through; ambiguous Windows forms fail.
+func driveSource(source string) (string, error) {
+	original := source
+	source = strings.TrimPrefix(source, `\\?\`)
+	if source != original && (len(source) < 2 || source[1] != ':') {
+		return "", fmt.Errorf("only local drive verbatim paths are supported")
+	}
+	if strings.HasPrefix(source, `\\`) || strings.HasPrefix(source, "//") {
+		return "", fmt.Errorf("Windows UNC/device bind sources are not supported: %q", original)
+	}
+	if len(source) < 2 || source[1] != ':' {
+		return source, nil
+	}
+	letter := source[0]
+	if !((letter >= 'a' && letter <= 'z') || (letter >= 'A' && letter <= 'Z')) || len(source) < 3 || (source[2] != '/' && source[2] != '\\') {
+		return "", fmt.Errorf("bind source must be an absolute Windows drive path: %q", original)
+	}
+	if strings.Contains(source[2:], ":") || strings.ContainsAny(source, "\x00\r\n") {
+		return "", fmt.Errorf("invalid Windows bind source: %q", original)
+	}
+	return guestexec.TranslateHostPath(source)
+}
+
+func rewriteBind(bind string) (string, error) {
+	// The first colon after a drive prefix separates source from Linux target.
+	source := strings.TrimPrefix(bind, `\\?\`)
+	if source != bind && (len(source) < 2 || source[1] != ':') {
+		return "", fmt.Errorf("only local drive verbatim paths are supported")
+	}
+	if len(source) < 2 || source[1] != ':' {
+		if strings.HasPrefix(source, `\\`) || strings.HasPrefix(source, "//") {
+			return "", fmt.Errorf("Windows UNC bind sources are not supported")
+		}
+		return bind, nil
+	}
+	separator := strings.IndexByte(source[2:], ':')
+	if separator < 0 {
+		return "", fmt.Errorf("Windows bind must include an absolute Linux target")
+	}
+	separator += 2
+	mapped, err := driveSource(source[:separator])
+	if err != nil {
+		return "", err
+	}
+	return mapped + source[separator:], nil
+}
+
+type jsonFields = map[string]json.RawMessage
+
+// rewriteCreate retains unknown fields at every edited level, without float64
+// conversion. If no source changes, preserve the original wire representation.
+func rewriteCreate(body []byte, volume bool) ([]byte, error) {
+	var document jsonFields
+	if err := json.Unmarshal(body, &document); err != nil {
+		return nil, err
+	}
+	if document == nil {
+		return nil, fmt.Errorf("create body must be a JSON object")
+	}
+	changed := false
+	if volume {
+		if raw := document["DriverOpts"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+			var options jsonFields
+			if err := json.Unmarshal(raw, &options); err != nil {
+				return nil, err
+			}
+			var device, flags string
+			_ = json.Unmarshal(options["o"], &flags)
+			bind := false
+			for _, flag := range strings.Split(flags, ",") {
+				bind = bind || flag == "bind" || flag == "rbind"
+			}
+			var driver string
+			_ = json.Unmarshal(document["Driver"], &driver)
+			if bind && (driver == "" || driver == "local") && options["device"] != nil {
+				if err := json.Unmarshal(options["device"], &device); err != nil {
+					return nil, err
+				}
+				mapped, err := driveSource(device)
+				if err != nil {
+					return nil, err
+				}
+				if mapped != device {
+					options["device"], _ = json.Marshal(mapped)
+					document["DriverOpts"], _ = json.Marshal(options)
+					changed = true
+				}
+			}
+		}
+	} else if raw := document["HostConfig"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+		var host jsonFields
+		if err := json.Unmarshal(raw, &host); err != nil {
+			return nil, err
+		}
+		if raw := host["Binds"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+			var binds []string
+			if err := json.Unmarshal(raw, &binds); err != nil {
+				return nil, err
+			}
+			for i, bind := range binds {
+				mapped, err := rewriteBind(bind)
+				if err != nil {
+					return nil, err
+				}
+				if mapped != bind {
+					binds[i] = mapped
+					changed = true
+				}
+			}
+			host["Binds"], _ = json.Marshal(binds)
+		}
+		if raw := host["Mounts"]; len(raw) > 0 && !bytes.Equal(raw, []byte("null")) {
+			var mounts []jsonFields
+			if err := json.Unmarshal(raw, &mounts); err != nil {
+				return nil, err
+			}
+			for _, mount := range mounts {
+				var kind, source string
+				_ = json.Unmarshal(mount["Type"], &kind)
+				if kind != "bind" || mount["Source"] == nil {
+					continue
+				}
+				if err := json.Unmarshal(mount["Source"], &source); err != nil {
+					return nil, err
+				}
+				mapped, err := driveSource(source)
+				if err != nil {
+					return nil, err
+				}
+				if mapped != source {
+					mount["Source"], _ = json.Marshal(mapped)
+					changed = true
+				}
+			}
+			host["Mounts"], _ = json.Marshal(mounts)
+		}
+		document["HostConfig"], _ = json.Marshal(host)
+	}
+	if !changed {
+		return body, nil
+	}
+	return json.Marshal(document)
+}
