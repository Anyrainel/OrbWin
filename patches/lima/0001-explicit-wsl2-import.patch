+
+// wslImportArgs selects WSL 2 for this new distribution without changing the host default.
+func wslImportArgs(instanceDir, distroName string) []string {
+	return []string{
+		"wsl.exe",
+		"--import",
+		distroName,
+		instanceDir,
+		filepath.Join(instanceDir, filenames.BaseDiskLegacy),
+		"--version",
+		"2",
+	}
+}
