+func TestOrbWinDockerfileReadGrantIsOneSelectedFile(t *testing.T) {
+	root := t.TempDir()
+	context := filepath.Join(root, "context")
+	outside := filepath.Join(root, "generated")
+	if err := os.Mkdir(context, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(outside, 0700); err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(outside, "Dockerfile-with-features")
+	if err := os.WriteFile(file, []byte("FROM scratch\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	resolved, err := filepath.EvalSymlinks(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	relative, err := filepath.Rel(context, file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, selected := range []string{file, relative, filepath.ToSlash(file), filepath.ToSlash(relative)} {
+		config := types.BuildConfig{Context: context, Dockerfile: selected}
+		got, ok := localDockerfileReadPath(config)
+		if !ok || got != resolved {
+			t.Fatalf("%q selected %q %t, want exact %q", selected, got, ok, resolved)
+		}
+		paths := localBuildPaths(config)
+		if !slices.Contains(paths, resolved) || slices.Contains(paths, outside) || slices.Contains(paths, root) || slices.Contains(paths, "*") {
+			t.Fatalf("grant broadened or missing: %v", paths)
+		}
+	}
+	if runtime.GOOS == "windows" && filepath.VolumeName(file) == "" {
+		t.Fatal("Windows drive coverage missing")
+	}
+}
+
+func TestOrbWinDockerfileReadGrantRejectsNonlocalOrAbsentInputs(t *testing.T) {
+	root := t.TempDir()
+	file := filepath.Join(root, "Dockerfile")
+	if err := os.WriteFile(file, []byte("FROM scratch\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cases := []types.BuildConfig{
+		{Context: root}, {Context: root, Dockerfile: filepath.Join(root, "missing")},
+		{Context: root, Dockerfile: root}, {Context: root, Dockerfile: file, DockerfileInline: "FROM scratch"},
+		{Context: "https://example.invalid/context.tar", Dockerfile: file},
+		{Context: "https://github.com/example/project.git", Dockerfile: file},
+		{Context: "git@github.com:example/project.git", Dockerfile: file},
+		{Context: "", Dockerfile: file},
+	}
+	for _, config := range cases {
+		if path, ok := localDockerfileReadPath(config); ok {
+			t.Fatalf("unexpected grant %q for %#v", path, config)
+		}
+	}
+	config := types.BuildConfig{Context: root, Dockerfile: file, AdditionalContexts: map[string]string{"remote": "https://example.invalid/context.tar", "local": filepath.Join(root, "additional")}}
+	paths := localBuildPaths(config)
+	if !slices.Contains(paths, config.AdditionalContexts["local"]) || slices.Contains(paths, config.AdditionalContexts["remote"]) {
+		t.Fatal(paths)
+	}
+}
