index 0530d72..241aafe 100644
--- a/pkg/compose/build_bake.go
+++ b/pkg/compose/build_bake.go
@@ -366,9 +366,39 @@ func localBuildPaths(buildConfig types.BuildConfig) []string {
 			local = append(local, path)
 		}
 	}
+	// A selected Dockerfile can legitimately live outside a local context, as
+	// happens with Dev Containers' generated feature Dockerfile. Grant only its
+	// resolved regular file, never the containing directory or a wildcard. Keep
+	// the grant fixed if a symlink is changed before Bake validates its inputs.
+	if path, ok := localDockerfileReadPath(buildConfig); ok {
+		local = append(local, path)
+	}
 	return local
 }
 
+func localDockerfileReadPath(buildConfig types.BuildConfig) (string, bool) {
+	if buildConfig.Context == "" || buildConfig.Dockerfile == "" || buildConfig.DockerfileInline != "" || strings.Contains(buildConfig.Context, "://") {
+		return "", false
+	}
+	if _, _, err := gitutil.ParseGitRef(buildConfig.Context); err == nil {
+		return "", false
+	}
+	path := dockerFilePath(buildConfig.Context, buildConfig.Dockerfile)
+	path, err := filepath.Abs(path)
+	if err != nil {
+		return "", false
+	}
+	path, err = filepath.EvalSymlinks(path)
+	if err != nil {
+		return "", false
+	}
+	info, err := os.Stat(path)
+	if err != nil || !info.Mode().IsRegular() {
+		return "", false
+	}
+	return path, true
+}
