+func TestOrbWinDockerfileSymlinkGrantDoesNotBroadenToParent(t *testing.T) {
+	root := t.TempDir()
+	context := filepath.Join(root, "context")
+	outside := filepath.Join(root, "private")
+	if err := os.Mkdir(context, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(outside, 0700); err != nil {
+		t.Fatal(err)
+	}
+	selected := filepath.Join(context, "Dockerfile")
+	target := filepath.Join(outside, "selected")
+	if err := os.WriteFile(target, []byte("FROM scratch\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(target, selected); err != nil {
+		t.Skipf("symlink creation unavailable without additional privilege: %v", err)
+	}
+	config := types.BuildConfig{Context: context, Dockerfile: selected}
+	grant, ok := localDockerfileReadPath(config)
+	if !ok {
+		t.Fatal("selected regular symlink target not granted")
+	}
+	resolved, err := filepath.EvalSymlinks(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if grant != resolved {
+		t.Fatalf("grant %q differs from selected target %q", grant, resolved)
+	}
+	paths := localBuildPaths(config)
+	if slices.Contains(paths, outside) || slices.Contains(paths, root) {
+		t.Fatal(paths)
+	}
+	// A later link replacement cannot rewrite the already generated exact grant.
+	if err := os.Remove(selected); err != nil {
+		t.Fatal(err)
+	}
+	other := filepath.Join(outside, "other")
+	if err := os.WriteFile(other, []byte("FROM scratch\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(other, selected); err != nil {
+		t.Fatal(err)
+	}
+	args := bakeArgs(&bakeBuild{localPaths: paths}, "metadata.json", api.BuildOptions{})
+	if !slices.Contains(args, "fs.read="+grant) || slices.Contains(args, "fs.read="+other) || slices.Contains(args, "fs.read="+outside) {
+		t.Fatalf("Bake permission did not preserve exactly the selected file after link replacement: %v", args)
+	}
+}
