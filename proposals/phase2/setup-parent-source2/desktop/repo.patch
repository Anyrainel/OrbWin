+
+// Locator DATA, never guest/writer permission. Actual Go receiver checks its inherited original object.
+pub(crate) fn parent_capsule(handle: usize, creation: u64) -> Result<String, String> {
+    if handle == 0 || handle == usize::MAX || creation == 0 {
+        return Err("Persistent parent capsule refused.".into());
+    }
+    Ok(format!("--orbwin-setup-parent=2:{handle}:{creation}"))
+}
+#[cfg(test)]
+mod parent_capsule_tests {
+    use super::*;
+    #[test]
+    fn only_canonical_nonzero_original_locators() {
+        assert_eq!(
+            parent_capsule(24, u64::MAX).unwrap(),
+            "--orbwin-setup-parent=2:24:18446744073709551615"
+        );
+        assert!(parent_capsule(0, 1).is_err());
+        assert!(parent_capsule(usize::MAX, 1).is_err());
+        assert!(parent_capsule(2, 0).is_err());
+    }
+}
