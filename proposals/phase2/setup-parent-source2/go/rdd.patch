+package managementconfig
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+)
+
+var ErrSetupParent = errors.New("private setup parent association unavailable")
+
+type setupParentData struct {
+	handle   uintptr
+	creation uint64
+}
+
+func decodeSetupParent(value string) (setupParentData, error) {
+	var d setupParentData
+	const prefix = "--orbwin-setup-parent=2:"
+	if !strings.HasPrefix(value, prefix) || len(value) > 100 {
+		return d, ErrSetupParent
+	}
+	p := strings.Split(value[len(prefix):], ":")
+	if len(p) != 2 {
+		return d, ErrSetupParent
+	}
+	h, e := strconv.ParseUint(p[0], 10, 64)
+	if e != nil || h == 0 || h >= uint64(^uintptr(0))-15 || strconv.FormatUint(h, 10) != p[0] {
+		return d, ErrSetupParent
+	}
+	c, e := strconv.ParseUint(p[1], 10, 64)
+	if e != nil || c == 0 || strconv.FormatUint(c, 10) != p[1] {
+		return d, ErrSetupParent
+	}
+	return setupParentData{uintptr(h), c}, nil
+}
+
+// QUERY_INFORMATION implies QUERY_LIMITED_INFORMATION per Windows' documented
+// access contract. No write/termination/duplicate rights are permitted.
+func setupParentRights(got uint32) bool {
+	const required = uint32(0x400 | 0x100000)
+	const allowed = required | 0x1000
+	return got&required == required && got & ^allowed == 0
+}
