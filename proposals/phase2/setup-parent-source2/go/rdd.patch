+// Compile-only: original/copy/nil gates cannot invoke a Windows API.
+func TestSetupParentOpaqueOriginalGuard(t *testing.T) {
+	b := &SetupParentBinding{}
+	b.self = b
+	if RequireSetupParentBinding(context.Background(), nil, nil) == nil {
+		t.Fatal("plain context")
+	}
+	copy := &SetupParentBinding{self: b}
+	if _, e := copy.Bind(context.Background(), nil, nil); e == nil {
