+// The actual early CLI producer owns this association through protocol/service
+// settlement. Unknown never escapes to main/os.Exit or depends on a global map.
+func RunFreshSetupOperationFromParent(ctx context.Context, input io.Reader, output io.Writer, capsule string) (result error) {
+	in, inOK := input.(*os.File)
+	out, outOK := output.(*os.File)
+	if !inOK || !outOK {
+		return errPrivateAuthority
+	}
+	var binding *managementconfig.SetupParentBinding
+	defer func() {
+		if recover() != nil {
+			keepSetupParentUnknown(binding)
+		}
+		defer func() {
+			if recover() != nil {
+				keepSetupParentUnknown(binding)
+			}
+		}()
+		if binding != nil && binding.Close() != nil {
+			keepSetupParentUnknown(binding)
+		}
+	}()
+	var e error
+	// Custody settlement has its own fixed budget even if caller admission was
+	// cancelled before entry. Original startup ctx still gates Bind/Run below.
+	captureContext, captureCancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer captureCancel()
+	binding, e = managementconfig.CaptureSetupParent(captureContext, in, out, capsule)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	ctx, e = binding.Bind(ctx, in, out)
+	if e != nil {
+		return errPrivateAuthority
+	}
+	return RunFreshSetupOperation(ctx, input, output)
+}
+func keepSetupParentUnknown(binding *managementconfig.SetupParentBinding) {
+	for {
+		time.Sleep(time.Second)
+		runtime.KeepAlive(binding)
+	}
