+		}
+		b, ok := ret.Results[0].(*ast.Ident)
+		if !ok || b.Name != "b" {
+			t.Fatal("empty/replacement candidate on expiry")
+		}
+		found = true
+		break
+	}
+	if !found {
+		t.Fatal("deadline gate absent")
+	}
