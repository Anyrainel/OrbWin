+func (b *SetupParentBinding) sid(j int) []byte {
+	start := uintptr(unsafe.Pointer(&b.tokenBuffers[j][0]))
+	n := uintptr(b.tokenSizes[j])
+	u := (*windows.Tokenuser)(unsafe.Pointer(&b.tokenBuffers[j][0]))
