+		if a, ok := stmt.(*ast.AssignStmt); ok && len(a.Lhs) == 1 && len(a.Rhs) == 1 {
+			if x, ok := a.Lhs[0].(*ast.Ident); ok && x.Name == "b" {
+				if u, ok := a.Rhs[0].(*ast.UnaryExpr); ok {
+					if c, ok := u.X.(*ast.CompositeLit); ok {
+						if n, ok := c.Type.(*ast.Ident); ok && n.Name == "SetupParentBinding" {
+							allocated = true
+						}
+					}
+				}
+			}
+			if x, ok := a.Lhs[0].(*ast.Ident); ok && x.Name == "setupParentOriginal" {
+				if v, ok := a.Rhs[0].(*ast.Ident); ok && v.Name == "b" {
+					published = allocated
