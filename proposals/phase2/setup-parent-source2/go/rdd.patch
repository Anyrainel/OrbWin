+		ast.Inspect(stmt, func(n ast.Node) bool {
+			if c, ok := n.(*ast.CallExpr); ok {
+				if x, ok := c.Fun.(*ast.Ident); ok && x.Name == "freshBoundedContext" {
+					hasDeadline = true
+				}
+			}
+			return true
+		})
