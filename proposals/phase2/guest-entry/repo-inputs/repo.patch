+  "rancher-desktop-guest-agent.service",
+  "wsl-proxy.service",
+  "rdd-guest.service",
+  "orbwin-wsl-client.service",
+]);
+const hash = (b) => createHash("sha256").update(b).digest("hex");
+const baselineManifest =
+  "7565bfc06cf11e103a09c6d98ce431a5045d14c9bb2a610958ae23d08e4a9679";
+const baselineTemplate =
+  "108f0774ac549e1619da24036eedce2de23d7443ec0a5916c418a3fc6ea5cda5";
+function text(bytes, pin) {
+  assert.ok(
+    Buffer.isBuffer(bytes) && bytes.length > 0 && bytes.length <= 2 << 20,
+  );
+  const s = bytes.toString("utf8");
+  assert.ok(Buffer.from(s).equals(bytes), "guest source UTF8");
+  const normalized = s.replaceAll("\r\n", "\n");
+  assert.ok(!normalized.includes("\r"));
