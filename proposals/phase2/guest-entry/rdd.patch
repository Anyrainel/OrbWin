+	defer h.Close()
+	defer p.Close()
+	original := &handshakeFaultConn{Conn: p, panicDeadline: true}
+	if e := testPeerHandshake(context.Background(), original, k); e != ErrTransportUnknown {
+		t.Fatal("panic not unknown", e)
+	}
+	if original.closes != 0 {
+		t.Fatal("unknown original was closed")
+	}
+}
+
+func TestPeerOperationUnknownRetainsOriginalAndNeverRetries(t *testing.T) {
