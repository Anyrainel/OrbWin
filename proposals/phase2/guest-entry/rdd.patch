+package main
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	auth "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol/guestsession"
+)
+
+type selectedReadNotice struct {
+	net.Conn
+	once    sync.Once
+	entered chan struct{}
+}
+
+func (c *selectedReadNotice) Read(b []byte) (int, error) {
+	c.once.Do(func() { close(c.entered) })
+	return c.Conn.Read(b)
+}
+func awaitSelected(t *testing.T, ch <-chan error) error {
+	t.Helper()
+	select {
+	case e := <-ch:
+		return e
+	case <-time.After(2 * time.Second):
+		t.Fatal("original worker join stalled")
+		return nil
+	}
+}
+func TestSelectedKnownAdmissionFailureCancelsIdleHandshakeWithLiveParent(t *testing.T) {
+	parent, releaseParent := context.WithCancel(context.Background())
+	defer releaseParent()
+	seal := make(chan struct{})
+	life := newSelectedWorkerLifetime(parent, seal)
+	s, e := auth.New([32]byte{1}, [16]byte{1}, []byte("owned test profile"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer s.Close()
+	key, e := s.DeriveRole(auth.Docker)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer key.Close()
+	host, guest := net.Pipe()
+	defer host.Close()
+	defer guest.Close()
+	original := &selectedReadNotice{Conn: guest, entered: make(chan struct{})}
+	operation := auth.NewPeerExchange(original, key)
+	result := make(chan error, 1)
+	life.wait.Add(1)
+	go func() {
+		defer life.wait.Done()
+		err := operation.RunWithFence(life.ctx, seal)
+		if original.Close() != nil {
+			err = auth.ErrTransportUnknown
+		}
+		result <- err
+	}()
+	select {
+	case <-original.entered:
+	case <-time.After(time.Second):
+		t.Fatal("handshake never entered original idle read")
+	}
+	// This is a known listener/admission error, not cancellation from parent/UI.
+	settled := make(chan error, 1)
+	go func() { settled <- life.stopAndJoinKnown() }()
+	if e := awaitSelected(t, settled); e != nil {
+		t.Fatal(e)
+	}
+	if e := awaitSelected(t, result); e == nil || errors.Is(e, auth.ErrTransportUnknown) {
+		t.Fatal("idle worker did not complete known cancellation", e)
+	}
+	if parent.Err() != nil || life.ctx.Err() != context.Canceled {
+		t.Fatal("parent canceled or child cancellation missing")
+	}
+	select {
+	case <-life.joined:
+	default:
+		t.Fatal("worker wasn't joined")
+	}
+	joined := life.joined
+	if life.stopAndJoinKnown() != nil || life.joined != joined {
+		t.Fatal("known join replay changed original")
+	}
+}
+func TestSelectedPresealedUnknownNeverCancelsOrStartsJoin(t *testing.T) {
+	parent, release := context.WithCancel(context.Background())
+	defer release()
+	seal := make(chan struct{})
+	close(seal)
+	life := newSelectedWorkerLifetime(parent, seal)
+	if life.stopAndJoinKnown() != errSelectedWorkersUnknown {
+		t.Fatal("unknown accepted")
+	}
+	if life.ctx.Err() != nil || parent.Err() != nil || life.joined != nil {
+		t.Fatal("unknown cancellation/join suffix")
+	}
+	if life.stopAndJoinKnown() != errSelectedWorkersUnknown {
+		t.Fatal("unknown replay reset")
+	}
+}
+func TestSelectedUnknownDuringJoinRetainsOriginalUnjoinedBacking(t *testing.T) {
+	parent, release := context.WithCancel(context.Background())
+	defer release()
+	seal := make(chan struct{})
+	life := newSelectedWorkerLifetime(parent, seal)
+	life.wait.Add(1)
+	result := make(chan error, 1)
+	go func() { result <- life.stopAndJoinKnown() }()
+	<-life.ctx.Done()
+	close(seal)
+	if e := awaitSelected(t, result); e != errSelectedWorkersUnknown {
+		t.Fatal(e)
+	}
+	if life.joined == nil || parent.Err() != nil {
+		t.Fatal("lost original waiter/context")
+	}
+	select {
+	case <-life.joined:
+		t.Fatal("unjoined worker falsely completed")
+	default:
+	}
+	// Release only this pure test-owned DATA count after proving retention.
+	life.wait.Done()
+	<-life.joined
+	if life.stopAndJoinKnown() != errSelectedWorkersUnknown {
+		t.Fatal("late join reset cached uncertainty")
+	}
+}
+func TestSelectedStopPanicPrearmsCachedUnknown(t *testing.T) {
+	parent, release := context.WithCancel(context.Background())
+	defer release()
+	life := newSelectedWorkerLifetime(parent, make(chan struct{}))
+	life.cancel = func() { panic("controlled original cancel panic") }
+	panicked := false
+	func() {
+		defer func() {
+			if recover() != nil {
+				panicked = true
+			}
+		}()
+		_ = life.stopAndJoinKnown()
+	}()
+	if !panicked || life.stopAndJoinKnown() != errSelectedWorkersUnknown || life.joined != nil {
+		t.Fatal("panic allowed default success or retry")
+	}
+}
+
+func TestSelectedConcurrentKnownStopSharesOriginalJoin(t *testing.T) {
+	parent, release := context.WithCancel(context.Background())
+	defer release()
+	life := newSelectedWorkerLifetime(parent, make(chan struct{}))
+	life.wait.Add(1)
+	results := make(chan error, 16)
+	for i := 0; i < 16; i++ {
+		go func() { results <- life.stopAndJoinKnown() }()
+	}
+	<-life.ctx.Done()
+	select {
+	case <-results:
+		t.Fatal("returned before original worker joined")
+	default:
+	}
+	life.wait.Done()
+	for i := 0; i < 16; i++ {
+		if e := awaitSelected(t, results); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if parent.Err() != nil {
+		t.Fatal("parent cancelled")
+	}
+}
