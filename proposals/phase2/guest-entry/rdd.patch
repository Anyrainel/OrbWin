+//go:build linux
+
+package main
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"net"
+	"os"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/mdlayher/vsock"
+	auth "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/proxyguestprotocol/guestsession"
+)
+
+var selectedRoleLifetime struct {
+	sync.Mutex
+	original *selectedRoleActor
+}
+
+type selectedRoleActor struct {
+	mu           sync.Mutex
+	role         auth.Role
+	key          auth.RoleKey
+	listener     *vsock.Listener
+	streams      map[*selectedRoleStream]struct{}
+	slots        chan struct{}
+	workers      *selectedWorkerLifetime
+	seal         chan struct{}
+	sealed       bool
+	stopping     bool
+	listenerStop func() bool
+	listenerDone chan error
+}
+type selectedRoleStream struct {
+	remote                      net.Conn
+	backend                     net.Conn
+	handshake                   *auth.PeerExchange
+	duplex                      *auth.Duplex
+	closeEntered, closeReturned bool
+	closeErr                    error
+}
+
+func (a *selectedRoleActor) fenced() bool { a.mu.Lock(); defer a.mu.Unlock(); return a.sealed }
+func (a *selectedRoleActor) markUnknown() {
+	a.mu.Lock()
+	if !a.sealed {
+		a.sealed = true
+		close(a.seal)
+	}
+	a.mu.Unlock()
+}
+func (a *selectedRoleActor) keep() {
+	a.markUnknown()
+	// Same actual owner/slots/frames/workers remain. Existing in-flight managed
+	// calls may finish; no post-seal concurrency/release proof is claimed.
+	for {
+		selectedRoleKeeperPause()
+		runtime.KeepAlive(a)
+	}
+}
+func (a *selectedRoleActor) admit(ctx context.Context) *selectedRoleStream {
+	select {
+	case a.slots <- struct{}{}:
+	case <-ctx.Done():
+		return nil
+	case <-a.seal:
+		return nil
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.sealed || a.stopping || ctx.Err() != nil {
+		<-a.slots
+		return nil
+	}
+	s := &selectedRoleStream{}
+	a.streams[s] = struct{}{}
+	return s
+}
+func (a *selectedRoleActor) release(s *selectedRoleStream) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.sealed {
+		return
+	} // Never discard even a locally settled slot after seal.
+	if _, ok := a.streams[s]; !ok {
+		panic("original selected stream slot missing")
+	}
+	delete(a.streams, s)
+	<-a.slots
+}
+func (a *selectedRoleActor) closeRejected(s *selectedRoleStream) {
+	if a.fenced() {
+		a.keep()
+	}
+	s.closeEntered = true
+	s.closeErr = auth.ErrTransportUnknown
+	s.closeErr = s.remote.Close()
+	s.closeReturned = true
+	if s.closeErr != nil {
+		a.keep()
+	}
+	a.release(s)
+}
+
+// Dormant: no main/unit/builder argv wiring. The selected product must make
+// authenticated entry mandatory only after genuine private Windows delivery.
+func runSelectedRoleMode(ctx context.Context, role auth.Role) error {
+	if ctx == nil || ctx.Err() != nil || role != auth.Docker && role != auth.Containerd {
+		return auth.ErrProtocol
+	}
+	a := &selectedRoleActor{role: role, streams: make(map[*selectedRoleStream]struct{}), slots: make(chan struct{}, 256), seal: make(chan struct{})}
+	selectedRoleLifetime.Lock()
+	if selectedRoleLifetime.original != nil {
+		selectedRoleLifetime.Unlock()
+		return auth.ErrProtocol
+	}
+	selectedRoleLifetime.original = a
+	selectedRoleLifetime.Unlock()
+	a.workers = newSelectedWorkerLifetime(ctx, a.seal)
+	workerCtx := a.workers.ctx
+	defer func() {
+		// Guard settlement itself as well as the body panic; no panic may unwind
+		// through original listener/worker/key cleanup.
+		defer func() {
+			if recover() != nil {
+				a.keep()
+			}
+		}()
+		if recover() != nil {
+			a.keep()
+		}
+		// Stop actual admission first; known stopping is NOT unknown seal.
+		a.mu.Lock()
+		if a.sealed {
+			a.mu.Unlock()
+			a.keep()
+		}
+		a.stopping = true
+		a.mu.Unlock()
+		// Same original cancellation precedes every actual worker join, including
+		// non-context Accept failure. No actor lock spans cancellation/wait/IO.
+		if a.workers.stopAndJoinKnown() != nil {
+			a.keep()
+		}
+		if a.listenerStop != nil && !a.listenerStop() {
+			if <-a.listenerDone != nil {
+				a.keep()
+			}
+		}
+		if a.fenced() {
+			a.keep()
+		}
+		a.finish()
+	}()
+	var err error
+	a.key, err = auth.ReadRoleCredential(os.Stdin, role)
+	if err != nil {
+		return auth.ErrProtocol
+	}
+	if workerCtx.Err() != nil {
+		return workerCtx.Err()
+	}
+	// Normal-return provider boundary only: hidden pre-return ignored closes in
+	// mdlayher's constructor remain a separate native-qualification hard gate.
+	a.listener, err = vsock.Listen(0, nil)
+	if err != nil || a.listener == nil {
+		a.keep()
+	}
+	addr, ok := a.listener.Addr().(*vsock.Addr)
+	if !ok || addr == nil || addr.Port == 0 || addr.Port == ^uint32(0) {
+		return auth.ErrProtocol
+	}
+	var report [16]byte
+	copy(report[:8], []byte("ORBPORT2"))
+	report[8] = 2
+	report[9] = byte(role)
+	binary.LittleEndian.PutUint32(report[12:], addr.Port)
+	if n, e := os.Stdout.Write(report[:]); e != nil || n != len(report) {
+		return auth.ErrProtocol
+	}
+	// Locator report is DATA, never authentication/readiness.
+	a.listenerDone = make(chan error, 1)
+	a.listenerStop = context.AfterFunc(workerCtx, func() {
+		var e error
+		defer func() {
+			if recover() != nil {
+				e = auth.ErrTransportUnknown
+			}
+			if e != nil {
+				a.markUnknown()
+			}
+			a.listenerDone <- e
+		}()
+		if a.fenced() {
+			e = auth.ErrTransportUnknown
+			return
+		}
+		e = a.listener.SetDeadline(time.Now())
+	})
+
+	for workerCtx.Err() == nil {
+		s := a.admit(workerCtx)
+		if s == nil {
+			break
+		}
+		// The exact slot exists before Accept writes the original output cell.
+		s.remote, err = a.listener.Accept()
+		if err != nil {
+			if s.remote != nil {
+				a.keep()
+			}
+			a.release(s)
+			if workerCtx.Err() != nil {
+				break
+			}
+			return auth.ErrProtocol
+		}
+		if s.remote == nil || a.fenced() {
+			a.keep()
+		}
+		a.workers.wait.Add(1)
+		go func() { defer a.workers.wait.Done(); a.stream(workerCtx, s) }()
+	}
+	return ctx.Err()
+}
+func (a *selectedRoleActor) finish() {
+	if a.fenced() {
+		a.keep()
+	}
+	if a.listener != nil {
+		if a.listener.Close() != nil {
+			a.keep()
+		}
+		a.listener = nil
+	}
+	a.key.Close()
+	// Role actor itself remains consumed; successful STREAM slots are reusable.
+}
+func (a *selectedRoleActor) stream(ctx context.Context, s *selectedRoleStream) {
+	defer func() {
+		if recover() != nil {
+			a.keep()
+		}
+	}()
+	if a.fenced() {
+		a.keep()
+	}
+	s.handshake = auth.NewPeerExchange(s.remote, a.key)
+	if err := s.handshake.RunWithFence(ctx, a.seal); err != nil {
+		if errors.Is(err, auth.ErrTransportUnknown) || a.fenced() {
+			a.keep()
+		}
+		a.closeRejected(s)
+		return
+	}
+	if ctx.Err() != nil {
+		a.closeRejected(s)
+		return
+	}
+	if a.fenced() {
+		a.keep()
+	}
+	path := "/run/orbwin/moby-internal.sock"
+	if a.role == auth.Containerd {
+		path = "/run/k3s/containerd/containerd.sock"
+	}
+	var err error
+	s.backend, err = (&net.Dialer{}).DialContext(ctx, "unix", path)
+	if err != nil {
+		if s.backend != nil {
+			a.keep()
+		}
+		a.closeRejected(s)
+		return
+	}
+	if s.backend == nil || a.fenced() {
+		a.keep()
+	}
+	remote, rok := s.remote.(auth.HalfConn)
+	backend, bok := s.backend.(auth.HalfConn)
+	if !rok || !bok {
+		a.keep()
+	} // No TCP/full-close fallback for missing half-close.
+	s.duplex = auth.NewDuplex(remote, backend)
+	err = s.duplex.Run(ctx, a.seal)
+	if errors.Is(err, auth.ErrTransportUnknown) || !s.duplex.Settled() || a.fenced() {
+		a.keep()
+	}
+	// Known copy/halfclose/cancel errors were returned by actual workers, joined,
+	// and both original Close calls settled positively. Refuse only this stream.
+	a.release(s)
+}
