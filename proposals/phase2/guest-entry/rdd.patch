+	op := NewPeerExchange(original, key)
+	if op.Run(context.Background()) != ErrTransportUnknown {
+		t.Fatal("missing original uncertainty")
+	}
+	frame := op.state
+	if frame.conn != original || frame.peer == nil || frame.nonce == ([32]byte{}) {
+		t.Fatal("lost original graph/backing")
+	}
+	original.panicDeadline = false
+	if op.Run(context.Background()) != ErrTransportUnknown || op.state != frame || original.closes != 0 {
+		t.Fatal("retried or closed original")
+	}
+}
