+package main
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+var errSelectedWorkersUnknown = errors.New("selected guest worker settlement unknown")
+
+// One original actor's context/WaitGroup lifetime, never native authority.
+// Installed before first actor effect; ctx/cancel/seal remain immutable.
+type selectedWorkerLifetime struct {
+	ctx           context.Context
+	cancel        context.CancelFunc
+	seal          <-chan struct{}
+	wait          sync.WaitGroup
+	joinMu        sync.Mutex
+	joinAttempted bool
+	joinErr       error
+	resultDone    chan struct{}
+	joined        chan struct{}
+}
+
+func newSelectedWorkerLifetime(parent context.Context, seal <-chan struct{}) *selectedWorkerLifetime {
+	ctx, cancel := context.WithCancel(parent)
+	return &selectedWorkerLifetime{ctx: ctx, cancel: cancel, seal: seal}
+}
+func (w *selectedWorkerLifetime) unknown() bool {
+	select {
+	case <-w.seal:
+		return true
+	default:
+		return false
+	}
+}
+
+// Called only after original actor admission/Add stops. Short state locks are
+// never held over cancellation, original callback IO, or worker waits. Observed
+// unknown refuses suffix; raced prior admission is not post-seal prevention.
+func (w *selectedWorkerLifetime) stopAndJoinKnown() (result error) {
+	w.joinMu.Lock()
+	if w.joinAttempted {
+		done := w.resultDone
+		w.joinMu.Unlock()
+		if w.unknown() {
+			return errSelectedWorkersUnknown
+		}
+		select {
+		case <-w.seal:
+			return errSelectedWorkersUnknown
+		case <-done:
+		}
+		w.joinMu.Lock()
+		result = w.joinErr
+		w.joinMu.Unlock()
+		return result
+	}
+	w.joinAttempted = true
+	w.joinErr = errSelectedWorkersUnknown
+	w.resultDone = make(chan struct{})
+	w.joinMu.Unlock()
+	result = errSelectedWorkersUnknown
+	defer func() {
+		p := recover()
+		if p != nil {
+			result = errSelectedWorkersUnknown
+		}
+		w.joinMu.Lock()
+		w.joinErr = result
+		close(w.resultDone)
+		w.joinMu.Unlock()
+		if p != nil {
+			panic(p)
+		}
+	}()
+	if w.unknown() {
+		return result
+	}
+	w.cancel()
+	// Original join backing exists before the sole waiter runs. On unknown the
+	// actual waiter/WaitGroup/context remain held by this same retained lifetime.
+	w.joined = make(chan struct{})
+	go func() { w.wait.Wait(); close(w.joined) }()
+	select {
+	case <-w.seal:
+		return result
+	case <-w.joined:
+		if w.unknown() {
+			return result
+		}
+		return nil
+	}
+}
