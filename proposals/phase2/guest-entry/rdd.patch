+}
+func TestMalformedConnectionThenValidKeepsRoleUsable(t *testing.T) {
+	s := session(t, 1)
+	defer s.Close()
+	key, _ := exportedKey(t, s, Docker)
+	defer key.Close()
+	h, p := net.Pipe()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	peer := NewPeerExchange(p, key)
+	go func() {
+		e := peer.Run(ctx)
+		if p.Close() != nil {
+			e = ErrTransportUnknown
+		}
+		done <- e
+	}()
+	if _, err := h.Write(make([]byte, MessageSize)); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; err == nil || err == ErrTransportUnknown {
+		t.Fatal("malformed not known refused", err)
+	}
+	if err := h.Close(); err != nil {
+		t.Fatal(err)
+	}
+	h, p = net.Pipe()
+	defer h.Close()
+	defer p.Close()
+	host := NewHostExchange(h, s, Docker)
+	peer = NewPeerExchange(p, key)
+	go func() { done <- peer.Run(ctx) }()
+	if err := host.Run(ctx); err != nil {
+		t.Fatal("valid connection poisoned by prior refusal", err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
