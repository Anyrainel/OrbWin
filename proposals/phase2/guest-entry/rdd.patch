+package guestsession
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"time"
+)
+
+var ErrTransportUnknown = errors.New("guest authentication transport completion unknown")
+
+// PeerExchange retains the original managed connection and wire backing. The
+// actual caller publishes this object in its original stream BEFORE Run. It is
+// protocol/managed-I/O custody, never a raw FD completion or native authority.
+type PeerExchange struct{ state *peerExchangeState }
+type peerExchangeState struct {
+	host      *Session
+	role      Role
+	seal      <-chan struct{}
+	mu        sync.Mutex
+	conn      net.Conn
+	key       RoleKey
+	ctx       context.Context
+	input     [MessageSize]byte
+	output    []byte
+	nonce     [32]byte
+	peer      *Connection
+	attempted bool
+	result    error
+}
+
+func NewPeerExchange(conn net.Conn, key RoleKey) *PeerExchange {
+	return &PeerExchange{state: &peerExchangeState{conn: conn, key: key}}
+}
+
+// NewHostExchange uses the SAME codec; conn/session are not native capabilities.
+func NewHostExchange(conn net.Conn, s *Session, r Role) *PeerExchange {
+	return &PeerExchange{state: &peerExchangeState{conn: conn, host: s, role: r}}
+}
+func negativeSeal(seal <-chan struct{}) bool {
+	if seal == nil {
+		return false
+	}
+	select {
+	case <-seal:
+		return true
+	default:
+		return false
+	}
+}
+func (PeerExchange) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED guest exchange]")) }
+func (PeerExchange) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+
+func setHandshakeDeadline(conn net.Conn, t time.Time) (err error) {
+	defer func() {
+		if recover() != nil {
+			err = ErrTransportUnknown
+		}
+	}()
+	if conn.SetDeadline(t) != nil {
+		return ErrTransportUnknown
+	}
+	return nil
+}
+
+// Run exchanges exact existing-codec messages before payload. Success means a
+// local complete ACK write on peer, or authentic received ACK on host. Neither
+// is native readiness. No connection close or retry.
+// On ErrTransportUnknown caller must retain this SAME operation and connection.
+func (p *PeerExchange) Run(ctx context.Context) error { return p.RunWithFence(ctx, nil) }
+
+// RunWithFence accepts only a negative admission seal, never authority.
+func (p *PeerExchange) RunWithFence(ctx context.Context, seal <-chan struct{}) (result error) {
+	if p == nil || p.state == nil {
+		return ErrProtocol
+	}
+	o := p.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.attempted {
+		return o.result
+	}
+	o.attempted = true
+	o.result = ErrTransportUnknown
+	o.ctx = ctx
+	o.seal = seal
+	defer func() {
+		if recover() != nil {
+			result = ErrTransportUnknown
+		}
+		o.result = result
+		// Unknown wire storage and parser remain on the original operation.
+		if result != ErrTransportUnknown {
+			clear(o.input[:])
+			clear(o.output)
+			clear(o.nonce[:])
+			if o.peer != nil {
+				o.peer.Close()
+			}
+		}
+	}()
+	if negativeSeal(o.seal) {
+		return ErrTransportUnknown
+	}
+	if ctx == nil || o.conn == nil || ctx.Err() != nil {
+		return ErrProtocol
+	}
+	if _, err := rand.Read(o.nonce[:]); err != nil {
+		return ErrProtocol
+	}
+	var err error
+	if o.host != nil {
+		o.peer, err = o.host.Host(o.role, o.nonce)
+	} else {
+		o.peer, err = NewPeer(o.key, o.nonce)
+	}
+	if err != nil {
+		return err
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+		deadline = d
+	}
+	if negativeSeal(o.seal) {
+		return ErrTransportUnknown
+	}
+	if setHandshakeDeadline(o.conn, deadline) != nil {
+		return ErrTransportUnknown
+	}
+	done := make(chan error, 1)
+	stop := context.AfterFunc(ctx, func() {
+		if negativeSeal(o.seal) {
+			done <- ErrTransportUnknown
+			return
+		}
+		done <- setHandshakeDeadline(o.conn, time.Now())
+	})
+	defer func() {
+		// Observe panic BEFORE any cleanup suffix. Stop/join only the original
+		// callback; never reset deadlines after unknown/panic.
+		if recover() != nil {
+			result = ErrTransportUnknown
+		}
+		if !stop() {
+			if <-done != nil {
+				result = ErrTransportUnknown
+			}
+		}
+		if negativeSeal(o.seal) {
+			result = ErrTransportUnknown
+		}
+		if result != ErrTransportUnknown && setHandshakeDeadline(o.conn, time.Time{}) != nil {
+			result = ErrTransportUnknown
+		}
+	}()
+	for step := 0; step < 2; step++ {
+		if negativeSeal(o.seal) {
+			return ErrTransportUnknown
+		}
+		if o.host != nil {
+			o.output, err = o.peer.EncodeNext()
+			if err != nil {
+				return err
+			}
+			if negativeSeal(o.seal) {
+				return ErrTransportUnknown
+			}
+			if err = writeExact(o.conn, o.output); err != nil {
+				return err
+			}
+			clear(o.output)
+		}
+		if negativeSeal(o.seal) {
+			return ErrTransportUnknown
+		}
+		if _, err = io.ReadFull(o.conn, o.input[:]); err != nil {
+			return ErrProtocol
+		}
+		if err = o.peer.Accept(o.input[:]); err != nil {
+			return err
+		}
+		if o.host == nil {
+			o.output, err = o.peer.EncodeNext()
+			if err != nil {
+				return err
+			}
+			if negativeSeal(o.seal) {
+				return ErrTransportUnknown
+			}
+			if err = writeExact(o.conn, o.output); err != nil {
+				return err
+			}
+			clear(o.output)
+		}
+	}
+	if o.host != nil && !o.peer.Complete() {
+		return ErrProtocol
+	}
+
+	if ctx.Err() != nil {
+		return ErrProtocol
+	}
+	return nil
+}
