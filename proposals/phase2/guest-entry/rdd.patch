+func TestPeerHandshakeCancellationAndTruncation(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		s := session(t, 1)
+		key, _ := exportedKey(t, s, Docker)
+		h, p := net.Pipe()
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan error, 1)
+		go func() { done <- testPeerHandshake(ctx, p, key) }()
+		if partial {
+			_, _ = h.Write([]byte{2, 0, byte(Docker)})
+			_ = h.Close()
+		} else {
+			cancel()
+		}
+		select {
+		case e := <-done:
+			if e == nil {
+				t.Fatal("partial/cancel accepted")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("cancellation didn't join")
+		}
+		cancel()
+		h.Close()
+		p.Close()
+		key.Close()
+		s.Close()
+	}
