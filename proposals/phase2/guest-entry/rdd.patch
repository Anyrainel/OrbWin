+func exportedKey(t *testing.T, s *Session, r Role) (RoleKey, []byte) {
+	t.Helper()
+	k, e := s.DeriveRole(r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer k.Close()
+	var b bytes.Buffer
+	if e = k.WriteCredential(&b); e != nil {
+		t.Fatal(e)
+	}
+	raw := append([]byte(nil), b.Bytes()...)
+	imported, e := ReadRoleCredential(bytes.NewReader(raw), r)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return imported, raw
+}
+func TestRoleCredentialBoundariesAndRedaction(t *testing.T) {
+	s := session(t, 1)
+	defer s.Close()
+	k, raw := exportedKey(t, s, Docker)
+	defer k.Close()
+	if len(raw) != CredentialSize {
+		t.Fatal("bound")
+	}
+	for _, cut := range []int{0, 1, 8, 12, 60, 91} {
+		if _, e := ReadRoleCredential(bytes.NewReader(raw[:cut]), Docker); e == nil {
+			t.Fatal("truncation", cut)
+		}
+	}
+	cases := [][]byte{append(append([]byte{}, raw...), 0)}
+	for _, offset := range []int{0, 8, 9, 10, 11} {
+		b := append([]byte{}, raw...)
+		b[offset] ^= 255
+		cases = append(cases, b)
+	}
+	for _, b := range cases {
+		if _, e := ReadRoleCredential(bytes.NewReader(b), Docker); e == nil {
+			t.Fatal("malformed accepted")
+		}
+	}
+	if _, e := ReadRoleCredential(bytes.NewReader(raw), Containerd); e == nil {
+		t.Fatal("role confusion")
+	}
+	k.Close()
+	if k.WriteCredential(io.Discard) == nil {
+		t.Fatal("closed credential exported")
+	}
+}
+
+func hostExchange(s *Session, role Role, c net.Conn) error {
+	h, e := s.Host(role, [32]byte{2})
+	if e != nil {
+		return e
+	}
+	defer h.Close()
+	var input [MessageSize]byte
+	for i := 0; i < 2; i++ {
+		b, e := h.EncodeNext()
+		if e != nil {
+			return e
+		}
+		e = writeExact(c, b)
+		clear(b)
+		if e != nil {
+			return e
+		}
+		if _, e = io.ReadFull(c, input[:]); e != nil {
+			return e
+		}
+		if e = h.Accept(input[:]); e != nil {
+			return e
+		}
+	}
+	if !h.Complete() {
+		return ErrProtocol
+	}
+	return nil
+}
+func TestPeerHandshakeExactPayloadBoundary(t *testing.T) {
+	s := session(t, 1)
+	defer s.Close()
+	key, _ := exportedKey(t, s, Docker)
+	defer key.Close()
+	host, peer := net.Pipe()
+	defer host.Close()
+	defer peer.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- testPeerHandshake(ctx, peer, key) }()
+	if e := hostExchange(s, Docker, host); e != nil {
+		t.Fatal(e)
+	}
+	if e := <-done; e != nil {
+		t.Fatal(e)
+	}
+	// No read-ahead consumed the first application byte, nor did authentication
+	// invent an extra framing layer around the existing streaming connection.
+	payload := []byte("first Docker/BuildKit application bytes")
+	go func() { _, _ = host.Write(payload) }()
+	b := make([]byte, len(payload))
+	if _, e := io.ReadFull(peer, b); e != nil || !bytes.Equal(b, payload) {
+		t.Fatal("payload boundary", e)
+	}
+}
+func TestPeerHandshakeWrongOwnerRefusesBeforePayload(t *testing.T) {
