+func TestSelectedKeeperControlledTimerRetainsOriginal(t *testing.T) {
+	original := &struct{ marker int }{marker: 7}
+	entered := make(chan struct{})
+	stop := make(chan struct{})
+	done := make(chan *struct{ marker int }, 1)
+	start := time.Now()
+	go func() {
+		close(entered)
+		// Only this DATA model has stop. Actual actor loop has no exit/cancel.
+		for {
+			selectedRoleKeeperPause()
+			runtime.KeepAlive(original)
+			select {
+			case <-stop:
+				done <- original
+				return
+			default:
+			}
+		}
+	}()
+	<-entered
+	select {
+	case <-done:
+		t.Fatal("timer model exited before explicit test stop")
+	default:
+	}
+	close(stop)
+	select {
+	case got := <-done:
+		if got != original || got.marker != 7 || time.Since(start) < selectedRoleKeeperDelay {
+			t.Fatal("original/timer lost")
+		}
+	case <-time.After(4 * time.Second):
+		t.Fatal("controlled model did not finish after timer")
+	}
+}
+func TestSelectedActorKeeperBoundToTimerAndSameOriginal(t *testing.T) {
+	f, e := parser.ParseFile(token.NewFileSet(), "selected_session_linux.go", nil, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var keeper *ast.FuncDecl
+	for _, d := range f.Decls {
+		if fn, ok := d.(*ast.FuncDecl); ok && fn.Name.Name == "keep" && fn.Recv != nil {
+			keeper = fn
+		}
+	}
+	if keeper == nil || len(keeper.Body.List) != 2 {
+		t.Fatal("unrecognized actual keeper")
+	}
+	first, ok := keeper.Body.List[0].(*ast.ExprStmt)
+	if !ok {
+		t.Fatal("keeper lost negative marking")
+	}
+	mark, ok := first.X.(*ast.CallExpr)
+	if !ok {
+		t.Fatal("negative mark not a call")
+	}
+	selector, ok := mark.Fun.(*ast.SelectorExpr)
+	if !ok || selector.Sel.Name != "markUnknown" {
+		t.Fatal("negative mark changed")
+	}
+	receiver, ok := selector.X.(*ast.Ident)
+	if !ok || receiver.Name != "a" {
+		t.Fatal("negative mark rebound")
+	}
+	loop, ok := keeper.Body.List[1].(*ast.ForStmt)
+	if !ok || loop.Cond != nil || loop.Init != nil || loop.Post != nil || len(loop.Body.List) != 2 {
+		t.Fatal("actual keeper isn't non-exiting fixed loop")
+	}
+	pause, ok := loop.Body.List[0].(*ast.ExprStmt)
+	if !ok {
+		t.Fatal("missing timer")
+	}
+	call, ok := pause.X.(*ast.CallExpr)
+	if !ok || len(call.Args) != 0 {
+		t.Fatal("timer call changed")
+	}
+	name, ok := call.Fun.(*ast.Ident)
+	if !ok || name.Name != "selectedRoleKeeperPause" {
+		t.Fatal("timer helper changed")
+	}
+	keep, ok := loop.Body.List[1].(*ast.ExprStmt)
+	if !ok {
+		t.Fatal("missing KeepAlive")
+	}
+	call, ok = keep.X.(*ast.CallExpr)
+	if !ok || len(call.Args) != 1 {
+		t.Fatal("KeepAlive call changed")
+	}
+	selector, ok = call.Fun.(*ast.SelectorExpr)
+	if !ok || selector.Sel.Name != "KeepAlive" {
+		t.Fatal("missing KeepAlive")
+	}
+	pkg, ok := selector.X.(*ast.Ident)
+	arg, aok := call.Args[0].(*ast.Ident)
+	if !ok || pkg.Name != "runtime" || !aok || arg.Name != "a" || selectedRoleKeeperDelay <= 0 {
+		t.Fatal("not same original actor/positive timer")
+	}
+}
