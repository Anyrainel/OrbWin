+package guestsession
+
+import (
+	"bytes"
+	"io"
+)
+
+// CredentialSize is a single derived role key, never a master credential.
+const CredentialSize = 92
+
+var credentialMagic = [8]byte{'O', 'R', 'B', 'R', 'O', 'L', 'E', '2'}
+
+// ReadRoleCredential parses DATA only. The actual selected guest caller must use
+// its private original stdin and close the host write end after the fixed frame.
+// No descriptor/path/argv/environment lookup or native admission occurs here.
+func ReadRoleCredential(r io.Reader, expected Role) (RoleKey, error) {
+	var b [CredentialSize]byte
+	defer clear(b[:])
+	if r == nil || !valid(expected) {
+		return RoleKey{}, ErrProtocol
+	}
+	if _, err := io.ReadFull(r, b[:]); err != nil {
+		return RoleKey{}, ErrProtocol
+	}
+	var tail [1]byte
+	if n, err := r.Read(tail[:]); n != 0 || err != io.EOF {
+		return RoleKey{}, ErrProtocol
+	}
+	if !bytes.Equal(b[:8], credentialMagic[:]) || b[8] != 2 || Role(b[9]) != expected || b[10] != 0 || b[11] != 0 {
+		return RoleKey{}, ErrProtocol
+	}
+	o := &roleState{role: expected}
+	copy(o.id[:], b[12:28])
+	copy(o.digest[:], b[28:60])
+	copy(o.key[:], b[60:92])
+	if o.id == ([16]byte{}) || o.digest == ([32]byte{}) || o.key == (secret{}) {
+		clear(o.key[:])
+		return RoleKey{}, ErrProtocol
+	}
+	return RoleKey{state: o}, nil
+}
+
+// WriteCredential emits only this already-derived role's fixed envelope. It is a
+// wire operation, not Windows secret-delivery authority or actor readiness.
+func (k RoleKey) WriteCredential(w io.Writer) error {
+	if k.state == nil || w == nil {
+		return ErrProtocol
+	}
+	var b [CredentialSize]byte
+	defer clear(b[:])
+	o := k.state
+	o.mu.Lock()
+	if o.closed || !valid(o.role) {
+		o.mu.Unlock()
+		return ErrProtocol
+	}
+	copy(b[:8], credentialMagic[:])
+	b[8] = 2
+	b[9] = byte(o.role)
+	copy(b[12:28], o.id[:])
+	copy(b[28:60], o.digest[:])
+	copy(b[60:], o.key[:])
+	o.mu.Unlock()
+	return writeExact(w, b[:])
+}
+
+func writeExact(w io.Writer, b []byte) error {
+	// A partial/failed write is not retried, and never treated as acceptance.
+	n, err := w.Write(b)
+	if err != nil || n != len(b) {
+		return ErrProtocol
+	}
+	return nil
+}
