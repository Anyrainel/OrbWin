+package guestsession
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// This in-memory half-close transport exists only in tests. No socket, listener,
+// server process or native handle is constructed. It preserves both directions.
+type memoryHalf struct {
+	r                          *io.PipeReader
+	w                          *io.PipeWriter
+	halves, closes, deadlines  atomic.Int32
+	halfErr, closeErr, readErr error
+	panicRead, panicClose      bool
+}
+type memoryAddr struct{}
+
+func (memoryAddr) Network() string { return "in-memory" }
+func (memoryAddr) String() string  { return "in-memory" }
+func (c *memoryHalf) Read(b []byte) (int, error) {
+	if c.panicRead {
+		panic("controlled read")
+	}
+	if c.readErr != nil {
+		return 0, c.readErr
+	}
+	return c.r.Read(b)
+}
+func (c *memoryHalf) Write(b []byte) (int, error) { return c.w.Write(b) }
+func (c *memoryHalf) CloseWrite() error {
+	c.halves.Add(1)
+	if c.halfErr != nil {
+		return c.halfErr
+	}
+	return c.w.Close()
+}
+func (c *memoryHalf) Close() error {
+	c.closes.Add(1)
+	if c.panicClose {
+		panic("controlled close")
+	}
+	if c.closeErr != nil {
+		return c.closeErr
+	}
+	return errors.Join(c.r.Close(), c.w.Close())
+}
+func (c *memoryHalf) LocalAddr() net.Addr                { return memoryAddr{} }
+func (c *memoryHalf) RemoteAddr() net.Addr               { return memoryAddr{} }
+func (c *memoryHalf) SetReadDeadline(t time.Time) error  { return c.SetDeadline(t) }
+func (c *memoryHalf) SetWriteDeadline(t time.Time) error { return c.SetDeadline(t) }
+func (c *memoryHalf) SetDeadline(t time.Time) error {
+	c.deadlines.Add(1)
+	if !t.IsZero() {
+		return errors.Join(c.r.CloseWithError(os.ErrDeadlineExceeded), c.w.CloseWithError(os.ErrDeadlineExceeded))
+	}
+	return nil
+}
+func memoryPair(t *testing.T) (*memoryHalf, *memoryHalf) {
+	t.Helper()
+	ar, bw := io.Pipe()
+	br, aw := io.Pipe()
+	a, b := &memoryHalf{r: ar, w: aw}, &memoryHalf{r: br, w: bw}
+	// Cleanup concerns only this test-owned DATA transport, never uncertain OS IO.
+	t.Cleanup(func() { ar.Close(); br.Close(); aw.Close(); bw.Close() })
+	return a, b
+}
+func duplexFixture(t *testing.T) (*Duplex, *memoryHalf, *memoryHalf, *memoryHalf, *memoryHalf) {
+	client, a := memoryPair(t)
+	b, server := memoryPair(t)
+	return NewDuplex(a, b), client, a, b, server
+}
+func awaitDuplex(t *testing.T, done <-chan error) error {
+	t.Helper()
+	select {
+	case e := <-done:
+		return e
+	case <-time.After(3 * time.Second):
+		t.Fatal("duplex did not settle")
+		return nil
+	}
+}
+func TestDuplexHalfClosePreservesReverseBuildkitBytes(t *testing.T) {
+	d, client, a, b, server := duplexFixture(t)
+	done := make(chan error, 1)
+	go func() { done <- d.Run(context.Background(), nil) }()
+	upload := bytes.Repeat([]byte("build context"), 5000)
+	reply := []byte("reverse response after request EOF")
+	clientDone := make(chan error, 1)
+	go func() {
+		if _, e := client.Write(upload); e != nil {
+			clientDone <- e
+			return
+		}
+		if e := client.CloseWrite(); e != nil {
+			clientDone <- e
+			return
+		}
+		got, e := io.ReadAll(client)
+		if e == nil && !bytes.Equal(got, reply) {
+			e = ErrProtocol
+		}
+		clientDone <- e
+	}()
+	got, e := io.ReadAll(server)
+	if e != nil || !bytes.Equal(got, upload) {
+		t.Fatal("request", e)
+	}
+	if _, e = server.Write(reply); e != nil {
+		t.Fatal(e)
+	}
+	if e = server.CloseWrite(); e != nil {
+		t.Fatal(e)
+	}
+	if e = awaitDuplex(t, clientDone); e != nil {
+		t.Fatal("reverse", e)
+	}
+	if e = awaitDuplex(t, done); e != nil || !d.Settled() {
+		t.Fatal("settlement", e)
+	}
+	if a.halves.Load() != 1 || b.halves.Load() != 1 || a.closes.Load() != 1 || b.closes.Load() != 1 {
+		t.Fatal("original half/full close counts")
+	}
+	if d.Run(context.Background(), nil) != nil || a.closes.Load() != 1 || b.closes.Load() != 1 {
+		t.Fatal("replay closed again")
+	}
+}
+func TestDuplexKnownCopyAndHalfCloseErrorsAreReturnedAfterJoin(t *testing.T) {
+	for _, half := range []bool{false, true} {
+		d, client, a, b, _ := duplexFixture(t)
+		boom := errors.New("original copy/halfclose refusal")
+		if half {
+			b.halfErr = boom
+		} else {
+			a.readErr = boom
+		}
+		done := make(chan error, 1)
+		go func() { done <- d.Run(context.Background(), nil) }()
+		if half {
+			if e := client.CloseWrite(); e != nil {
+				t.Fatal(e)
+			}
+		}
+		e := awaitDuplex(t, done)
+		if !errors.Is(e, boom) || !d.Settled() {
+			t.Fatal("known error lost or unjoined", e)
+		}
+		if a.closes.Load() != 1 || b.closes.Load() != 1 {
+			t.Fatal("original closes missing")
+		}
+	}
+}
+func TestDuplexCancellationJoinsBeforeCheckedClose(t *testing.T) {
+	d, _, a, b, _ := duplexFixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- d.Run(ctx, nil) }()
+	cancel()
+	if e := awaitDuplex(t, done); !errors.Is(e, context.Canceled) || !d.Settled() {
+		t.Fatal(e)
+	}
+	if a.closes.Load() != 1 || b.closes.Load() != 1 {
+		t.Fatal("cancel original closure")
+	}
+}
+func TestDuplexUnknownCloseStopsBeforeSecondCloseAndCaches(t *testing.T) {
+	for _, panicClose := range []bool{false, true} {
+		d, client, a, b, server := duplexFixture(t)
+		b.closeErr = errors.New("original close uncertain")
+		b.panicClose = panicClose
+		done := make(chan error, 1)
+		go func() { done <- d.Run(context.Background(), nil) }()
+		client.CloseWrite()
+		server.CloseWrite()
+		if e := awaitDuplex(t, done); e != ErrTransportUnknown || d.Settled() {
+			t.Fatal("close uncertainty lost", e)
+		}
+		if b.closes.Load() != 1 || a.closes.Load() != 0 || d.state.closes[0].conn != b {
+			t.Fatal("suffix/lost original")
+		}
+		if d.Run(context.Background(), nil) != ErrTransportUnknown || b.closes.Load() != 1 {
+			t.Fatal("unknown retried")
+		}
+	}
+}
+func TestDuplexNegativeSealRetainsUnjoinedOriginalsWithoutSuffix(t *testing.T) {
+	d, _, a, b, _ := duplexFixture(t)
+	seal := make(chan struct{})
+	done := make(chan error, 1)
+	go func() { done <- d.Run(context.Background(), seal) }()
+	close(seal)
+	if e := awaitDuplex(t, done); e != ErrTransportUnknown || d.Settled() {
+		t.Fatal(e)
+	}
+	if a.closes.Load() != 0 || b.closes.Load() != 0 || a.deadlines.Load() != 0 || b.deadlines.Load() != 0 || d.state.a != a || d.state.b != b {
+		t.Fatal("sealed graph changed")
+	}
+}
+func TestDuplexWorkerPanicKeepsOriginalBuffersAndNoClose(t *testing.T) {
+	d, _, a, b, _ := duplexFixture(t)
+	a.panicRead = true
+	done := make(chan error, 1)
+	go func() { done <- d.Run(context.Background(), nil) }()
+	if e := awaitDuplex(t, done); e != ErrTransportUnknown || d.Settled() {
+		t.Fatal(e)
+	}
+	if a.closes.Load() != 0 || b.closes.Load() != 0 || d.state.directions[0].src != a {
+		t.Fatal("panic lost original or closed suffix")
+	}
+}
