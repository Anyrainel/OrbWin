+
+// Controlled DATA-only connection fault: no native handle or provider exists.
+type handshakeFaultConn struct {
+	net.Conn
+	panicDeadline bool
+	closes        int
+}
+
+func (c *handshakeFaultConn) SetDeadline(t time.Time) error {
+	if c.panicDeadline {
+		panic("controlled deadline")
+	}
+	return c.Conn.SetDeadline(t)
+}
+func (c *handshakeFaultConn) Close() error { c.closes++; return c.Conn.Close() }
+func TestPeerDeadlinePanicReturnsUnknownWithoutClosingOriginal(t *testing.T) {
+	s := session(t, 1)
+	defer s.Close()
