+package guestsession
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// HalfConn preserves independent EOF; these values carry no native authority.
+type HalfConn interface {
+	net.Conn
+	CloseWrite() error
+}
+type Duplex struct{ state *duplexState }
+type copyDirection struct {
+	src, dst                  HalfConn
+	buffer                    [32768]byte
+	readN, writeN             int
+	readErr, writeErr, error  error
+	halfEntered, halfReturned bool
+	halfErr                   error
+}
+type managedClose struct {
+	conn              HalfConn
+	entered, returned bool
+	err               error
+}
+type duplexState struct {
+	mu                                sync.Mutex
+	a, b                              HalfConn
+	directions                        [2]copyDirection
+	closes                            [2]managedClose
+	seal                              <-chan struct{}
+	unknown                           chan struct{}
+	unknownOnce                       sync.Once
+	interruptOnce                     sync.Once
+	deadlineEntered, deadlineReturned [2]bool
+	deadlineErr                       [2]error
+	done                              chan int
+	callbackDone                      chan struct{}
+	callbackStop                      func() bool
+	attempted                         bool
+	result                            error
+	settled                           atomic.Bool
+}
+
+func (Duplex) Format(f fmt.State, _ rune)   { _, _ = f.Write([]byte("[REDACTED guest duplex]")) }
+func (Duplex) MarshalJSON() ([]byte, error) { return nil, ErrSecretJSON }
+
+func NewDuplex(a, b HalfConn) *Duplex {
+	o := &duplexState{a: a, b: b, unknown: make(chan struct{}), done: make(chan int, 2)}
+	o.directions[0].src = a
+	o.directions[0].dst = b
+	o.directions[1].src = b
+	o.directions[1].dst = a
+	o.closes[0].conn = b
+	o.closes[1].conn = a
+	return &Duplex{state: o}
+}
+func (d *Duplex) Settled() bool { return d != nil && d.state != nil && d.state.settled.Load() }
+func (o *duplexState) fenced() bool {
+	if negativeSeal(o.seal) {
+		return true
+	}
+	select {
+	case <-o.unknown:
+		return true
+	default:
+		return false
+	}
+}
+func (o *duplexState) fence() { o.unknownOnce.Do(func() { close(o.unknown) }) }
+func (o *duplexState) interrupt() {
+	o.interruptOnce.Do(func() {
+		defer func() {
+			if recover() != nil {
+				o.fence()
+			}
+		}()
+		for i, c := range []HalfConn{o.a, o.b} {
+			if o.fenced() {
+				o.fence()
+				return
+			}
+			o.deadlineEntered[i] = true
+			o.deadlineErr[i] = ErrTransportUnknown
+			o.deadlineErr[i] = c.SetDeadline(time.Now())
+			o.deadlineReturned[i] = true
+			if o.deadlineErr[i] != nil {
+				o.fence()
+				return
+			}
+		}
+	})
+}
+func (o *duplexState) copy(i int) {
+	d := &o.directions[i]
+	defer func() {
+		if recover() != nil {
+			d.error = ErrTransportUnknown
+			o.fence()
+		}
+		o.done <- i
+	}()
+	empty := 0
+	for {
+		if o.fenced() {
+			d.error = ErrTransportUnknown
+			o.fence()
+			return
+		}
+		d.readN, d.readErr = d.src.Read(d.buffer[:])
+		if d.readN < 0 || d.readN > len(d.buffer) {
+			d.error = ErrTransportUnknown
+			o.fence()
+			return
+		}
+		if d.readN == 0 && d.readErr == nil {
+			empty++
+			if empty >= 100 {
+				d.error = io.ErrNoProgress
+				return
+			}
+			continue
+		}
+		empty = 0
+		for sent := 0; sent < d.readN; {
+			if o.fenced() {
+				d.error = ErrTransportUnknown
+				o.fence()
+				return
+			}
+			d.writeN, d.writeErr = d.dst.Write(d.buffer[sent:d.readN])
+			if d.writeN < 0 || d.writeN > d.readN-sent {
+				d.error = ErrTransportUnknown
+				o.fence()
+				return
+			}
+			sent += d.writeN
+			if d.writeErr != nil {
+				d.error = d.writeErr
+				return
+			}
+			if d.writeN == 0 {
+				d.error = io.ErrShortWrite
+				return
+			}
+		}
+		if d.readErr != nil {
+			if !errors.Is(d.readErr, io.EOF) {
+				d.error = d.readErr
+				return
+			}
+			if o.fenced() {
+				d.error = ErrTransportUnknown
+				o.fence()
+				return
+			}
+			d.halfEntered = true
+			d.halfErr = ErrTransportUnknown
+			d.halfErr = d.dst.CloseWrite()
+			d.halfReturned = true
+			d.error = d.halfErr
+			return
+		}
+	}
+}
+func (d *Duplex) Run(ctx context.Context, seal <-chan struct{}) (result error) {
+	if d == nil || d.state == nil {
+		return ErrProtocol
+	}
+	o := d.state
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.attempted {
+		return o.result
+	}
+	o.attempted = true
+	o.result = ErrTransportUnknown
+	o.seal = seal
+	defer func() {
+		if recover() != nil {
+			result = ErrTransportUnknown
+			o.fence()
+		}
+		o.result = result
+	}()
+	if ctx == nil || o.a == nil || o.b == nil {
+		o.fence()
+		return ErrTransportUnknown
+	}
+	if o.fenced() {
+		o.fence()
+		return ErrTransportUnknown
+	}
+	var copyErrors [2]error
+	if ctx.Err() == nil {
+		go o.copy(0)
+		go o.copy(1)
+		o.callbackDone = make(chan struct{})
+		o.callbackStop = context.AfterFunc(ctx, func() { defer close(o.callbackDone); o.interrupt() })
+		received := 0
+		for received < 2 {
+			select {
+			case <-o.unknown:
+				o.callbackStop()
+				return ErrTransportUnknown
+			case <-seal:
+				o.fence()
+				o.callbackStop()
+				return ErrTransportUnknown
+			case i := <-o.done:
+				received++
+				copyErrors[i] = o.directions[i].error
+				if copyErrors[i] != nil {
+					o.interrupt()
+				}
+			}
+		}
+		if !o.callbackStop() {
+			<-o.callbackDone
+		}
+		if o.fenced() {
+			o.fence()
+			return ErrTransportUnknown
+		}
+	}
+	// All actual copy workers and the original cancel callback are joined here.
+	for i := range o.closes {
+		if o.fenced() {
+			o.fence()
+			return ErrTransportUnknown
+		}
+		c := &o.closes[i]
+		c.entered = true
+		c.err = ErrTransportUnknown
+		c.err = c.conn.Close()
+		c.returned = true
+		if c.err != nil {
+			o.fence()
+			return ErrTransportUnknown
+		}
+	}
+	for i := range o.directions {
+		clear(o.directions[i].buffer[:])
+	}
+	o.settled.Store(true)
+	return errors.Join(copyErrors[0], copyErrors[1], ctx.Err())
+}
