+package managementconfig
+
+import "errors"
+
+var ErrGuestNegative = errors.New("guest negative state refuses mutation; preserved state requires scoped recovery")
+
+// DATA only: pending status must be examined before any potentially live output.
+func guestReadOpenState(failed, pending, has, valid bool, status uint32, disposition uintptr) (discard, unknown bool) {
+	if pending || status == 0x103 {
+		return false, true
+	}
+	if failed {
+		return !has, has
+	}
+	if !valid || status != 0 || disposition != 1 {
+		return false, true
+	}
+	return false, false
+}
+func guestReadNames(names []string, slot bool) bool {
+	seen := map[string]bool{}
+	for _, n := range names {
+		if seen[n] {
+			return false
+		}
+		seen[n] = true
+		if slot {
+			if n != "pending" && n != "complete" {
+				return false
+			}
+		} else if n != "profile" && n != "slot.0" && n != "slot.1" {
+			return false
+		}
+	}
+	return true
+}
+
+// Reader-only epoch has no original pending producer factory. This is only a
+// refusal cut, never a configurable authorizer. Replace it with genuine typed
+// source admission when that producer is implemented; never flip it to nil.
+func requireGuestNegativeOriginalProducer() error { return ErrGuestNegative }
