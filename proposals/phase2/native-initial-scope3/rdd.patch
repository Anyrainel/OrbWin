+	assertCallBefore(t, main, "RuntimeInspectionCLI", "guestNegativeBeforeEnvironment")
+	// Main's actual early handled branch exits directly, never ordinary fallback.
+	mainAST, e := parser.ParseFile(token.NewFileSet(), filepath.Join(root, "cmd/rdd/main.go"), nil, 0)
