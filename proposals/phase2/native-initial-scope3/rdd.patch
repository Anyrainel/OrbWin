+	o, a := s.owner, s.authority
+	o.mu.Lock()
+	a.publisher.mu.Lock()
+	a.created.mu.Lock()
+	a.image.mu.Lock()
+	a.mu.Lock()
+	o.storage.mu.Lock()
+	s.mu.Lock()
+	unlock := func() {
+		s.mu.Unlock()
+		o.storage.mu.Unlock()
+		a.mu.Unlock()
+		a.image.mu.Unlock()
+		a.created.mu.Unlock()
+		a.publisher.mu.Unlock()
+		o.mu.Unlock()
