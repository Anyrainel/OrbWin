+		d, e := n.open(ctx, guard, name, true, true, false)
+		if e == windows.STATUS_OBJECT_NAME_NOT_FOUND {
+			continue
+		}
+		if e != nil {
+			return ErrGuestNegative
+		}
+		entries, e := n.list(ctx, d, true)
+		if e != nil {
+			return ErrGuestNegative
+		}
+		n.snapshots = append(n.snapshots, guestNegativeSnapshot{d, entries, true})
