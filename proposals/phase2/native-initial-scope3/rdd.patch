+func (n *nativeGuestNegativeRead) owns(o *guestNegativeObject) bool {
+	if o == nil || o.frame == nil || o.frame.owner != n || !o.frame.returned || o.frame.err != nil || o.frame.closeAttempted || o.frame.handle == 0 {
