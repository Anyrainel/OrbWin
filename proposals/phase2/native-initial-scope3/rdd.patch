+}
+type initialGuestKey struct {
+	handle         windows.Handle
+	name           string
+	descriptor     [32]byte
+	closeAttempted bool
+}
+
+// One reusable synchronous cell. A pending/contradictory/unreturned call keeps
+// this exact frame forever; only a positively returned call may replace it.
+type initialGuestNativeFrame struct {
+	entered, returned   bool
+	raw                 uintptr
+	err                 error
+	key                 *initialGuestKey
+	text                []uint16
+	words               []uint64
+	needed, count, kind uint32
+	info                windows.ByHandleFileInformation
+	align               uint64
+	full                [24]byte
+	path                [1040]uint16
+	io                  windows.IO_STATUS_BLOCK
