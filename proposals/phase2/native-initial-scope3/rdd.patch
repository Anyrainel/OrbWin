+	if o.initialGuestGuardCloseKnownLocked() {
+		t.Fatal("unreturned query released parent")
+	}
+	g.queries[0].returned = true
+	if !o.initialGuestGuardCloseKnownLocked() {
+		t.Fatal("known terminal query held forever")
+	}
+	g.sequence.unknown = true
