+// Package negativeguard validates DATA. It owns no native object or permission.
+package negativeguard
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"unicode/utf8"
+)
+
+const Budget = 8192
+const Purpose = "orbwin-guest-negative-v1"
+
+var ErrRecord = errors.New("guest negative record refused")
+
+type Object struct {
+	Volume uint32 `json:"volume"`
+	High   uint32 `json:"high"`
+	Low    uint32 `json:"low"`
+}
+
+func (o Object) valid() bool { return o.High != 0 || o.Low != 0 }
+
+type Fact struct {
+	Object     Object
+	Descriptor [32]byte
+}
+
+func (f Fact) valid() bool { return f.Object.valid() && f.Descriptor != ([32]byte{}) }
+
+type Witness struct {
+	Object     Object   `json:"object"`
+	Size       uint64   `json:"size"`
+	Written    uint64   `json:"written"`
+	Descriptor [32]byte `json:"descriptor"`
+	Body       [32]byte `json:"body"`
+}
+
+func (w Witness) valid() bool {
+	return w.Object.valid() && w.Size > 0 && w.Written > 0 && w.Descriptor != ([32]byte{}) && w.Body != ([32]byte{})
+}
+
+type Seed struct {
+	Object     Object   `json:"object"`
+	Descriptor [32]byte `json:"descriptor"`
+	Written    uint64   `json:"written"`
+	Binding    string   `json:"binding"`
+}
+
+func (s Seed) valid() bool {
+	b, e := hex.DecodeString(s.Binding)
+	return s.Object.valid() && s.Descriptor != ([32]byte{}) && s.Written > 0 && e == nil && len(b) == 32 && s.Binding == hex.EncodeToString(b) && !bytes.Equal(b, make([]byte, 32))
+}
+
+type Source struct {
+	Kind                           string
+	Private, Public, Controller    Fact
+	Authority, AuthorityLock       Fact
+	Intent                         Witness
+	Seed                           Seed
+	Admission, Committed           Witness
+	ControlRetention, ControlBirth Witness
+	ServingImage                   Witness
+}
+
+func (s Source) valid() bool {
+	if !s.Private.valid() || !s.Public.valid() || !s.Controller.valid() || !s.Intent.valid() || !s.Seed.valid() || !s.ServingImage.valid() {
+		return false
+	}
+	if s.Controller.Object.Volume != s.Public.Object.Volume || s.Intent.Object.Volume != s.Private.Object.Volume || s.Seed.Object.Volume != s.Private.Object.Volume {
+		return false
+	}
+	ids := map[Object]bool{}
+	add := func(o Object) bool {
+		if ids[o] {
+			return false
+		}
+		ids[o] = true
+		return true
+	}
+	for _, o := range []Object{s.Private.Object, s.Public.Object, s.Controller.Object, s.Intent.Object, s.Seed.Object, s.ServingImage.Object} {
+		if !add(o) {
+			return false
+		}
+	}
+	switch s.Kind {
+	case "initial-fresh":
+		if s.Authority != (Fact{}) || s.AuthorityLock != (Fact{}) || s.Admission != (Witness{}) || s.Committed != (Witness{}) {
+			return false
+		}
+	case "existing-writer":
+		if !s.Authority.valid() || !s.AuthorityLock.valid() || !s.Admission.valid() || !s.Committed.valid() {
+			return false
+		}
+		for _, o := range []Object{s.Authority.Object, s.AuthorityLock.Object, s.Admission.Object, s.Committed.Object} {
+			if o.Volume != s.Private.Object.Volume || !add(o) {
+				return false
+			}
+		}
+	default:
+		return false
+	}
+	if (s.ControlRetention == (Witness{})) != (s.ControlBirth == (Witness{})) {
+		return false
+	}
+	if s.ControlRetention != (Witness{}) {
+		for _, w := range []Witness{s.ControlRetention, s.ControlBirth} {
+			if !w.valid() || w.Object.Volume != s.Private.Object.Volume || !add(w.Object) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// commonSource matches persistent origin roles only; later serving/authority facts
+// still require their actual native producer, never comparison of this DATA alone.
+func commonSource(a, b Source) bool {
+	return a.Private == b.Private && a.Public == b.Public && a.Controller == b.Controller && a.Intent == b.Intent && a.Seed == b.Seed
+}
+func sourceObjects(s Source) []Object {
+	return []Object{s.Private.Object, s.Public.Object, s.Controller.Object, s.Authority.Object, s.AuthorityLock.Object, s.Intent.Object, s.Seed.Object, s.Admission.Object, s.Committed.Object, s.ControlRetention.Object, s.ControlBirth.Object, s.ServingImage.Object}
+}
+
+type Profile struct {
+	Schema         int
+	Purpose        string
+	ProfileVersion uint32
+	Source         Source
+}
+
+func (p Profile) valid() bool {
+	return p.Schema == 1 && p.Purpose == Purpose && p.ProfileVersion == 1 && p.Source.valid()
+}
+
+type Pending struct {
+	Schema                            int
+	Purpose                           string
+	Generation                        uint64
+	Phase                             string
+	Profile                           Witness
+	Directory                         Fact
+	Source                            Source
+	PreviousPending, PreviousComplete Witness
+	GuestProfileDigest, RecipeDigest  [32]byte
+	OperationNonce                    [16]byte
+}
+
+func (p Pending) valid() bool {
+	if p.Schema != 1 || p.Purpose != Purpose || p.Generation == 0 || p.Phase != "guest-lifetime-pending" || !p.Profile.valid() || !p.Directory.valid() || !p.Source.valid() || p.GuestProfileDigest == ([32]byte{}) || p.RecipeDigest == ([32]byte{}) || p.OperationNonce == ([16]byte{}) {
+		return false
+	}
+	if p.Profile.Object.Volume != p.Directory.Object.Volume || p.Directory.Object.Volume != p.Source.Private.Object.Volume || p.Profile.Object == p.Directory.Object {
+		return false
+	}
+	for _, o := range sourceObjects(p.Source) {
+		if o.valid() && (o == p.Directory.Object || o == p.Profile.Object) {
+			return false
+		}
+	}
+	if p.Generation == 1 {
+		return p.PreviousPending == (Witness{}) && p.PreviousComplete == (Witness{})
+	}
+	for _, previous := range []Witness{p.PreviousPending, p.PreviousComplete} {
+		if previous.Object == p.Profile.Object || previous.Object == p.Directory.Object {
+			return false
+		}
+	}
+	return p.PreviousPending.valid() && p.PreviousComplete.valid() && p.PreviousPending.Object != p.PreviousComplete.Object && p.PreviousPending.Object.Volume == p.Directory.Object.Volume && p.PreviousComplete.Object.Volume == p.Directory.Object.Volume
+}
+
+type Complete struct {
+	Schema                             int
+	Purpose                            string
+	Generation                         uint64
+	Phase, Outcome                     string
+	Profile                            Witness
+	Directory                          Fact
+	Pending                            Witness
+	OriginalSource                     Source
+	FinalAuthority, FinalAuthorityLock Fact
+	LedgerDigest, RetirementDigest     [32]byte
+	OfflineDisk                        Fact
+	OfflineDiskBytes                   uint64
+	OfflineEvidenceDigest              [32]byte
+}
+
+func (c Complete) valid() bool {
+	if c.Schema != 1 || c.Purpose != Purpose || c.Generation == 0 || c.Phase != "same-live-owner-completed" || !c.Profile.valid() || !c.Directory.valid() || !c.Pending.valid() || !c.OriginalSource.valid() || c.LedgerDigest == ([32]byte{}) || c.RetirementDigest == ([32]byte{}) {
+		return false
+	}
+	if c.Profile.Object.Volume != c.Directory.Object.Volume || c.Pending.Object.Volume != c.Directory.Object.Volume || c.Directory.Object.Volume != c.OriginalSource.Private.Object.Volume || c.Profile.Object == c.Pending.Object || c.Profile.Object == c.Directory.Object || c.Pending.Object == c.Directory.Object {
+		return false
+	}
+	final := c.FinalAuthority.valid() && c.FinalAuthorityLock.valid() && c.FinalAuthority.Object != c.FinalAuthorityLock.Object && c.FinalAuthority.Object.Volume == c.Directory.Object.Volume && c.FinalAuthorityLock.Object.Volume == c.Directory.Object.Volume
+	offline := c.OfflineDisk.valid() && c.OfflineDiskBytes > 0 && c.OfflineEvidenceDigest != ([32]byte{})
+	if final && (c.FinalAuthority.Object == c.Directory.Object || c.FinalAuthority.Object == c.Profile.Object || c.FinalAuthority.Object == c.Pending.Object || c.FinalAuthorityLock.Object == c.Directory.Object || c.FinalAuthorityLock.Object == c.Profile.Object || c.FinalAuthorityLock.Object == c.Pending.Object) {
+		return false
+	}
+	if final && c.OriginalSource.Kind == "existing-writer" && (c.FinalAuthority != c.OriginalSource.Authority || c.FinalAuthorityLock != c.OriginalSource.AuthorityLock) {
+		return false
+	}
+	if c.Outcome == "retired-guest" {
+		return final && offline
+	}
+	if c.Outcome != "no-guest-effect" {
+		return false
+	}
+	return (final || c.FinalAuthority == (Fact{}) && c.FinalAuthorityLock == (Fact{})) && c.OfflineDisk == (Fact{}) && c.OfflineDiskBytes == 0 && c.OfflineEvidenceDigest == ([32]byte{})
+}
+func encode(v any, valid bool) ([]byte, error) {
+	if !valid {
+		return nil, ErrRecord
+	}
+	b, e := json.Marshal(v)
+	if e != nil || len(b)+1 > Budget {
+		return nil, ErrRecord
+	}
+	return append(b, '\n'), nil
+}
+func EncodeProfile(v Profile) ([]byte, error)   { return encode(v, v.valid()) }
+func EncodePending(v Pending) ([]byte, error)   { return encode(v, v.valid()) }
+func EncodeComplete(v Complete) ([]byte, error) { return encode(v, v.valid()) }
+func decode(b []byte, v any, canonical func() ([]byte, error)) error {
+	if len(b) == 0 || len(b) > Budget || !utf8.Valid(b) {
+		return ErrRecord
+	}
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if d.Decode(v) != nil {
+		return ErrRecord
+	}
+	want, e := canonical()
+	if e != nil || !bytes.Equal(b, want) {
+		return ErrRecord
+	}
+	return nil
+}
+func ParseProfile(b []byte) (v Profile, e error) {
+	e = decode(b, &v, func() ([]byte, error) { return EncodeProfile(v) })
+	if e != nil {
+		v = Profile{}
+	}
+	return
+}
+func ParsePending(b []byte) (v Pending, e error) {
+	e = decode(b, &v, func() ([]byte, error) { return EncodePending(v) })
+	if e != nil {
+		v = Pending{}
+	}
+	return
+}
+func ParseComplete(b []byte) (v Complete, e error) {
+	e = decode(b, &v, func() ([]byte, error) { return EncodeComplete(v) })
+	if e != nil {
+		v = Complete{}
+	}
+	return
+}
+
+// Observation is caller DATA consistency only, never proof of native ID/SD/read.
+type Observation struct {
+	Body []byte
+	File Witness
+}
+
+func (o Observation) absent() bool { return len(o.Body) == 0 && o.File == (Witness{}) }
+func (o Observation) valid() bool {
+	return len(o.Body) > 0 && len(o.Body) <= Budget && o.File.valid() && o.File.Size == uint64(len(o.Body)) && o.File.Body == sha256.Sum256(o.Body)
+}
+
+type Slot struct{ Pending, Complete Observation }
+type State byte
+
+const (
+	Refuse State = iota
+	PendingShape
+	CompletedShape
+)
+
+// History classifies a bounded shape. No positive native admission is returned.
+func History(profile Observation, directory Fact, slots [2]Slot) State {
+	if !profile.valid() || !directory.valid() || profile.File.Object.Volume != directory.Object.Volume || profile.File.Object == directory.Object {
+		return Refuse
+	}
+	pr, e := ParseProfile(profile.Body)
+	if e != nil || pr.Source.Private.Object.Volume != directory.Object.Volume {
+		return Refuse
+	}
+	for _, o := range sourceObjects(pr.Source) {
+		if o.valid() && (o == directory.Object || o == profile.File.Object) {
+			return Refuse
+		}
+	}
+	seen := map[Object]bool{profile.File.Object: true, directory.Object: true}
+	type row struct {
+		p        Pending
+		c        Complete
+		pw, cw   Witness
+		complete bool
+	}
+	var rows []row
+	for i, s := range slots {
+		if s.Pending.absent() && s.Complete.absent() {
+			continue
+		}
+		if !s.Pending.valid() {
+			return Refuse
+		}
+		p, e := ParsePending(s.Pending.Body)
+		if e != nil || p.Generation%2 != uint64(i) || p.Profile != profile.File || p.Directory != directory || !commonSource(pr.Source, p.Source) {
+			return Refuse
+		}
+		if s.Pending.File.Object.Volume != directory.Object.Volume || seen[s.Pending.File.Object] {
+			return Refuse
+		}
+		seen[s.Pending.File.Object] = true
+		for _, o := range sourceObjects(p.Source) {
+			if o.valid() && (o == s.Pending.File.Object || !s.Complete.absent() && o == s.Complete.File.Object) {
+				return Refuse
+			}
+		}
+		r := row{p: p, pw: s.Pending.File}
+		if !s.Complete.absent() {
+			if !s.Complete.valid() || s.Complete.File.Object.Volume != directory.Object.Volume || seen[s.Complete.File.Object] {
+				return Refuse
+			}
+			seen[s.Complete.File.Object] = true
+			c, e := ParseComplete(s.Complete.Body)
+			if e != nil || c.Generation != p.Generation || c.Profile != profile.File || c.Directory != directory || c.Pending != s.Pending.File || c.OriginalSource != p.Source {
+				return Refuse
+			}
+			r.c = c
+			r.cw = s.Complete.File
+			r.complete = true
+		}
+		rows = append(rows, r)
+	}
+	if len(rows) == 0 {
+		return Refuse
+	}
+	// Records cannot be any historical/native source role, even when that role
+	// changed between generations. Source-to-source sharing remains legitimate.
+	allSources := sourceObjects(pr.Source)
+	for _, r := range rows {
+		allSources = append(allSources, sourceObjects(r.p.Source)...)
+		if r.complete {
+			allSources = append(allSources, r.c.FinalAuthority.Object, r.c.FinalAuthorityLock.Object, r.c.OfflineDisk.Object)
+		}
+	}
+	for _, o := range allSources {
+		if o.valid() && seen[o] {
+			return Refuse
+		}
+	}
+	if len(rows) == 1 {
+		r := rows[0]
+		if r.complete {
+			return CompletedShape
+		}
+		if r.p.Generation == 1 {
+			return PendingShape
+		}
+		return Refuse
+	}
+	if rows[0].p.Generation > rows[1].p.Generation {
+		rows[0], rows[1] = rows[1], rows[0]
+	}
+	a, b := rows[0], rows[1]
+	if !a.complete || b.p.Generation-a.p.Generation != 1 || b.p.PreviousPending != a.pw || b.p.PreviousComplete != a.cw {
+		return Refuse
+	}
+	if b.complete {
+		return CompletedShape
+	}
+	return PendingShape
+}
+func NextGeneration(g uint64) (uint64, error) {
+	if g == ^uint64(0) {
+		return 0, ErrRecord
+	}
+	return g + 1, nil
+}
