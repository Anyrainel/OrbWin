+		}
+		c.exitRaw, _, c.lastError = initialGuestExit.Call(uintptr(c.process), uintptr(unsafe.Pointer(&c.exitCode)))
+		if uint32(c.exitRaw) == 0 || c.exitCode != 0 {
+			s.fail()
+			return
+		}
+		c.result = nil
+	}
+	close(c.done)
+}
+func (i *InitialGuestCreationScope) AwaitInitialImport(ctx context.Context) (result error) {
+	s, e := i.exact()
+	if e != nil || !freshBoundedContext(ctx) {
+		return ErrInitialGuestScope
+	}
+	s.mu.Lock()
+	c := s.command
+	if c == nil || !c.state.waitEntered || s.unknown.Load() {
+		s.mu.Unlock()
+		return ErrInitialGuestScope
+	}
+	done := c.done
+	s.mu.Unlock()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	unlock, e := s.lockSource(ctx)
+	if e != nil {
+		return e
+	}
+	defer unlock()
+	if s.command != c || c.result != nil || !c.state.settled() {
+		return ErrInitialGuestScope
+	}
+	if s.proofAttempted {
+		return s.proofErr
+	}
+	s.proofAttempted = true
+	s.proofErr = ErrInitialGuestScope
+	defer func() {
+		if recover() != nil {
+			result = s.fail()
+		}
+	}()
+	// CLI0 is insufficient. Only this SAME original creation operation binds
+	// its registration/disk. No adoption or retry after an import error exists.
+	if s.owner.storage.check() != nil || s.proveNegativeGuard(ctx) != nil || s.captureRegistration(ctx, true) != nil {
+		return ErrInitialGuestScope
+	}
+	s.disk, e = s.openFile(ctx, s.directories[3], "ext4.vhdx", false, false, windows.FILE_READ_ATTRIBUTES, 1)
+	if e != nil || s.disk.identity.size == 0 || !freshBoundedContext(ctx) {
+		return ErrInitialGuestScope
+	}
+	s.importObserved = true
+	s.proofErr = nil
+	return nil // observation, not guest/writer/checkpoint admission
+}
+func (c *initialGuestCommand) closeProcess() error {
+	if c.process == 0 {
+		if c.state.entered && !c.state.settled() {
+			return ErrInitialGuestScope
+		}
+		return nil
+	}
+	if c.closeAttempted || !c.state.settled() {
+		return ErrInitialGuestScope
+	}
+	c.closeAttempted = true
+	c.closeRaw, _, c.lastError = initialGuestProcessClose.Call(uintptr(c.process))
+	if uint32(c.closeRaw) == 0 {
+		return ErrInitialGuestScope
+	}
+	c.process = 0
+	return nil
+}
