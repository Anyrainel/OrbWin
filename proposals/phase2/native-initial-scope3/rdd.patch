+	if uint32(f.raw) == 0x103 {
+		return s.fail()
+	}
+	known, success := initialGuestLinkReply(f.raw, uintptr(f.io.Status), f.io.Information)
+	if !known {
+		return s.fail()
+	}
+	if !success {
+		return ErrInitialGuestScope
+	}
+	s.archiveLinked = true
+	return nil
+}
