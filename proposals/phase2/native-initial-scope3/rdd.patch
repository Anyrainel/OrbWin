+package managementconfig
+
+import (
+	"crypto/sha256"
+	negativeguard "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig/guestnegative"
+	"strings"
+	"testing"
+)
+
+func TestInitialGuestGuardPhysicalRoleMatchesStrictHistory(t *testing.T) {
+	fact := func(id uint32) negativeguard.Fact {
+		return negativeguard.Fact{Object: negativeguard.Object{Volume: 1, Low: id}, Descriptor: [32]byte{1}}
+	}
+	witness := func(id uint32) negativeguard.Witness {
+		return negativeguard.Witness{Object: fact(id).Object, Size: 1, Written: 1, Descriptor: [32]byte{1}, Body: [32]byte{1}}
+	}
+	observe := func(id uint32, body []byte) negativeguard.Observation {
+		w := witness(id)
+		w.Size = uint64(len(body))
+		w.Body = sha256.Sum256(body)
+		return negativeguard.Observation{Body: body, File: w}
+	}
+	source := negativeguard.Source{Kind: "initial-fresh", Private: fact(1), Public: fact(2), Controller: fact(3), Intent: witness(4), Seed: negativeguard.Seed{Object: fact(5).Object, Descriptor: [32]byte{1}, Written: 1, Binding: strings.Repeat("01", 32)}, ServingImage: witness(6)}
+	profileBytes, e := negativeguard.EncodeProfile(negativeguard.Profile{Schema: 1, Purpose: negativeguard.Purpose, ProfileVersion: 1, Source: source})
+	if e != nil {
+		t.Fatal(e)
+	}
+	profile := observe(10, profileBytes)
+	pendingBytes, e := negativeguard.EncodePending(negativeguard.Pending{Schema: 1, Purpose: negativeguard.Purpose, Generation: guestInitialGuardGeneration, Phase: "guest-lifetime-pending", Profile: profile.File, Directory: fact(11), Source: source, GuestProfileDigest: [32]byte{1}, RecipeDigest: [32]byte{2}, OperationNonce: [16]byte{3}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	index, name := guestInitialGuardSlotRole()
+	if index != 1 || name != "slot.1" {
+		t.Fatal("wrong native physical role", index, name)
+	}
+	var slots [2]negativeguard.Slot
+	slots[index].Pending = observe(12, pendingBytes)
+	if negativeguard.History(profile, fact(11), slots) != negativeguard.PendingShape {
+		t.Fatal("physical role differs from strict classifier")
+	}
+	slots[0], slots[1] = slots[1], slots[0]
+	if negativeguard.History(profile, fact(11), slots) != negativeguard.Refuse {
+		t.Fatal("reversed physical parity accepted")
+	}
+}
+
+func TestInitialGuestGuardCannotSkipDurabilityCut(t *testing.T) {
+	for cut := guestInitialGuardDirectory; cut <= guestInitialGuardPendingBarrier; cut++ {
+		var s guestInitialGuardSequence
+		for step := guestInitialGuardDirectory; step < cut; step++ {
+			if !s.begin(step) || !s.settle(true, true) {
+				t.Fatal("prefix", step)
+			}
+		}
+		if s.durable || s.begin(cut+1) {
+			t.Fatal("missing persistent cut accepted", cut)
+		}
+		if !s.begin(cut) || s.closeKnown() || s.begin(cut) {
+			t.Fatal("unreturned operation released/reentered", cut)
+		}
+		if s.settle(false, false) || s.closeKnown() || s.settle(true, true) || s.begin(cut) || s.durable {
+			t.Fatal("unknown replay/release", cut)
+		}
+	}
+}
+func TestInitialGuestGuardKnownFailureHasNoRetryOrSuffix(t *testing.T) {
+	for cut := guestInitialGuardDirectory; cut <= guestInitialGuardPendingBarrier; cut++ {
+		var s guestInitialGuardSequence
+		for step := guestInitialGuardDirectory; step <= cut; step++ {
+			if !s.begin(step) {
+				t.Fatal("prefix", step)
+			}
+			if s.settle(true, step != cut) != (step != cut) {
+				t.Fatal("settlement", step)
+			}
+		}
+		if !s.closeKnown() || s.begin(cut) || s.begin(cut+1) || s.durable {
+			t.Fatal("known partial retried/continued", cut)
+		}
+	}
+}
+func TestInitialGuestGuardOnlyFinalBarrierIsDurable(t *testing.T) {
+	var s guestInitialGuardSequence
+	for step := guestInitialGuardDirectory; step <= guestInitialGuardPendingBarrier; step++ {
+		if !s.begin(step) || !s.settle(true, true) {
+			t.Fatal(step)
+		}
+		if s.durable != (step == guestInitialGuardPendingBarrier) {
+			t.Fatal("premature durable", step)
+		}
+	}
+	if !s.closeKnown() || s.begin(guestInitialGuardDirectory) || s.settle(true, true) {
+		t.Fatal("recipe repeated")
+	}
+}
+
+func TestInitialGuestPreparationBindsActualSnapshotAndServingCode(t *testing.T) {
+	var image [32]byte
+	image[0] = 1
+	p, r, ok := guestInitialPreparationDigests("original-archive", image, "")
+	if !ok || p == r || p == ([32]byte{}) || r == ([32]byte{}) {
+		t.Fatal("binding absent")
+	}
+	q, s, ok := guestInitialPreparationDigests("different-archive", image, "")
+	if !ok || q == p || s == r {
+		t.Fatal("archive omitted")
+	}
+	image[1] = 2
+	q, s, ok = guestInitialPreparationDigests("original-archive", image, "")
+	if !ok || q == p || s == r {
+		t.Fatal("actual serving image omitted")
+	}
+	for _, commit := range []string{"not-a-commit", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"} {
+		if _, _, ok := guestInitialPreparationDigests("archive", image, commit); ok {
+			t.Fatal("noncanonical commit")
+		}
+	}
+	if _, _, ok := guestInitialPreparationDigests("", image, ""); ok {
+		t.Fatal("management-only build accepted")
+	}
+	if _, _, ok := guestInitialPreparationDigests("archive", [32]byte{}, ""); ok {
+		t.Fatal("missing actual image accepted")
+	}
+}
