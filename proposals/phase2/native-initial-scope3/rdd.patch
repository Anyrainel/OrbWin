+package managementconfig
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"strings"
+)
+
+const guestInitialPreparationRole = "orbwin-owned-guest-preparation-v1"
+
+const guestInitialGuardGeneration uint64 = 1
+
+// One fixed role selects BOTH the native directory name and History's array
+// index. Generation1 lives in slot.1; its canonical empty peer is slot.0.
+func guestInitialGuardSlotRole() (index int, name string) {
+	index = int(guestInitialGuardGeneration % 2)
+	return index, [2]string{"slot.0", "slot.1"}[index]
+}
+
+// The hash inputs are DATA from the producer's private original snapshot. This
+// pure helper cannot select an archive, issue a scope, or authorize execution.
+func guestInitialPreparationDigests(archive string, image [32]byte, commit string) (profile, recipe [32]byte, ok bool) {
+	if archive == "" || image == ([32]byte{}) {
+		return
+	}
+	if commit != "" {
+		b, e := hex.DecodeString(commit)
+		if e != nil || len(b) != 20 || hex.EncodeToString(b) != commit {
+			return
+		}
+	}
+	h := sha256.New()
+	if _, e := io.Copy(h, strings.NewReader(archive)); e != nil {
+		return
+	}
+	var archiveHash [32]byte
+	copy(archiveHash[:], h.Sum(nil))
+	descriptor := struct {
+		Purpose        string
+		Version        int
+		Archive, Image [32]byte
+		Commit         string
+	}{guestInitialPreparationRole, 1, archiveHash, image, commit}
+	b, e := json.Marshal(descriptor)
+	if e != nil {
+		return
+	}
+	profile = sha256.Sum256(b)
+	recipe = sha256.Sum256(append([]byte("orbwin-initial-guest-recipe-v1\x00"), b...))
+	ok = true
+	return
+}
+
+// Pure sequencing DATA for the one initial CREATE-only recipe. None of these
+// fields authorizes a native effect or substitutes for actual source custody.
+type guestInitialGuardStep uint8
+
+const (
+	guestInitialGuardDirectory guestInitialGuardStep = iota + 1
+	guestInitialGuardRootBarrier
+	guestInitialGuardProfile
+	guestInitialGuardProfileBarrier
+	guestInitialGuardSlot
+	guestInitialGuardSlotBarrier
+	guestInitialGuardPending
+	guestInitialGuardPendingBarrier
+)
+
+type guestInitialGuardSequence struct {
+	next                              guestInitialGuardStep
+	entered, failed, unknown, durable bool
+}
+
+func (s *guestInitialGuardSequence) begin(step guestInitialGuardStep) bool {
+	if s == nil || s.failed || s.unknown || s.durable || s.entered {
+		return false
+	}
+	if s.next == 0 {
+		s.next = guestInitialGuardDirectory
+	}
+	if step != s.next || step < guestInitialGuardDirectory || step > guestInitialGuardPendingBarrier {
+		return false
+	}
+	s.entered = true
+	return true
+}
+func (s *guestInitialGuardSequence) settle(known, successful bool) bool {
+	if s == nil || !s.entered || s.failed || s.unknown || s.durable {
+		return false
+	}
+	if !known {
+		s.unknown, s.failed = true, true
+		return false
+	}
+	s.entered = false
+	if !successful {
+		s.failed = true
+		return false
+	}
+	if s.next == guestInitialGuardPendingBarrier {
+		s.durable = true
+	} else {
+		s.next++
+	}
+	return true
+}
+func (s *guestInitialGuardSequence) closeKnown() bool {
+	return s != nil && !s.entered && !s.unknown
+}
