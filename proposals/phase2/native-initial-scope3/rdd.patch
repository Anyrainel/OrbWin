+func (s *nativeInitialGuestScope) checkArchive(ctx context.Context) error {
+	if s.image == nil || s.basedisk == nil || !s.originalHeld() {
+		return ErrInitialGuestScope
+	}
+	for _, o := range []*runtimeStorageObject{s.image, s.basedisk} {
+		measured, e := s.measure(o.resource, false, true, 2)
+		if e != nil || measured.identity != o.identity {
+			return ErrInitialGuestScope
+		}
+	}
+	if s.fullIDs[s.image.resource] != s.fullIDs[s.basedisk.resource] {
+		return ErrInitialGuestScope
+	}
+	if _, e := windows.SetFilePointer(s.basedisk.resource.handle, 0, nil, windows.FILE_BEGIN); e != nil {
+		return ErrInitialGuestScope
+	}
+	h := sha256.New()
+	buffer := make([]byte, initialGuestNativeChunkBudget)
+	var total uint64
+	for total < s.basedisk.identity.size {
+		if !freshBoundedContext(ctx) {
+			return ErrInitialGuestScope
+		}
+		remaining := s.basedisk.identity.size - total
+		chunk := buffer[:initialGuestNativeChunk(remaining)]
+		count, e := s.owner.storage.transferStorage(s.basedisk.resource, chunk, false)
+		if e != nil || count == 0 || count > uint32(len(chunk)) {
+			return ErrInitialGuestScope
+		}
+		h.Write(chunk[:count])
+		total += uint64(count)
+	}
