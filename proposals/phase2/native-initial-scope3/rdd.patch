+func initialGuestParentsHeld(o *FreshSetupOwner, a *nativeManagedRuntimeAuthority) bool {
+	if o == nil || a == nil || o.self != o || o.closed || o.unknown || o.storage == nil || o.created == nil || o.created != a.created || o.image == nil || o.image != a.image || a.self == nil || a.self.native != a || a.publisher == nil || !a.main.captured || !a.admitted() || !servingImageCaptureKnown(a.image) {
+		return false
+	}
+	tuple := o.created.freshAuthority
+	if tuple == nil || tuple.self != tuple || tuple.owner != o || tuple.created != o.created {
+		return false
+	}
+	if o.created.managedOwnerLock == 0 || o.created.managedOwnerLock == windows.InvalidHandle {
+		return false
+	}
+	locks := 0
+	for _, h := range o.created.authorityHandles {
+		if h == o.created.managedOwnerLock {
+			locks++
+		}
+	}
+	if locks != 1 {
+		return false
+	}
+	count := 0
+	for _, member := range a.image.managedAuthorities {
+		if member == a.self {
+			count++
+		}
+	}
