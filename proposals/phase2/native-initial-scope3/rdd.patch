+	return nil
+}
+func (s *nativeInitialGuestScope) value(k *initialGuestKey, name string) ([]byte, uint32, error) {
+	f := s.newFrame()
+	if f == nil {
+		return nil, 0, ErrInitialGuestScope
+	}
+	var e error
+	f.text, e = windows.UTF16FromString(name)
+	if e != nil {
+		return nil, 0, ErrInitialGuestScope
+	}
+	f.words = make([]uint64, 256)
+	f.count = uint32(len(f.words) * 8)
+	f.entered = true
+	f.raw, _, _ = managedRegQuery.Call(uintptr(k.handle), uintptr(unsafe.Pointer(&f.text[0])), 0, uintptr(unsafe.Pointer(&f.kind)), uintptr(unsafe.Pointer(&f.words[0])), uintptr(unsafe.Pointer(&f.count)))
