+// Read source only: regression catches the original unreachable private-only
+// walker even though no actual API/native fixture runs in this test program.
+func TestInitialGuestSystemCaptureUsesClosedOwnedWalker(t *testing.T) {
+	_, source, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("source location unavailable")
+	}
+	parse := func(name string) *ast.File {
+		f, e := parser.ParseFile(token.NewFileSet(), filepath.Join(filepath.Dir(source), name), nil, 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		return f
+	}
+	var capture, walk, volumeOpen, relativeOpen, reply, keep, precheck bool
+	for _, file := range []string{"runtime_guest_initial_scope_windows.go", "runtime_guest_initial_system_windows.go", "runtime_guest_initial_command_windows.go"} {
+		f := parse(file)
+		for _, decl := range f.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || fn.Body == nil {
+				continue
+			}
+			ast.Inspect(fn.Body, func(node ast.Node) bool {
+				call, ok := node.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				sel, ok := call.Fun.(*ast.SelectorExpr)
+				if !ok {
+					return true
+				}
+				if fn.Name.Name == "captureSystemWSL" {
+					if sel.Sel.Name == "walk" {
+						walk = true
+					}
+					if sel.Sel.Name == "captureSystemAncestors" {
+						capture = true
+					}
+				}
+				if fn.Name.Name == "captureSystemAncestors" {
+					if sel.Sel.Name == "walk" {
+						walk = true
+					}
+					if sel.Sel.Name == "open" {
+						relativeOpen = true
+					}
+					if sel.Sel.Name == "nativeOpenReply" {
+						reply = true
+					}
+					if sel.Sel.Name == "keep" {
+						keep = true
+					}
+					if x, ok := sel.X.(*ast.Ident); ok && x.Name == "runtimeStorageCreateFile" && sel.Sel.Name == "Call" {
+						volumeOpen = true
+					}
+				}
+				if sel.Sel.Name == "checkSystemAncestors" {
+					precheck = true
+				}
+				return true
+			})
+		}
+	}
+	if walk || !capture || !volumeOpen || !relativeOpen || !reply || !keep || !precheck {
+		t.Fatalf("closed capture route missing: %v %v %v %v %v %v %v", walk, capture, volumeOpen, relativeOpen, reply, keep, precheck)
+	}
+}
