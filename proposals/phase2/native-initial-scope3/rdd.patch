+// This wrapper is not a source ledger. Both actual parents retain the original
+// native object independently, even if a caller overwrites a wrapper value.
+type InitialGuestCreationScope struct{ native *nativeInitialGuestScope }
+type nativeInitialGuestScope struct {
+	self                                                 *InitialGuestCreationScope
+	owner                                                *FreshSetupOwner
+	authority                                            *nativeManagedRuntimeAuthority
+	guard                                                *nativeInitialGuestGuard
+	mu                                                   sync.Mutex
+	unknown, closed                                      atomic.Bool
+	importEntered                                        atomic.Bool // irreversible ORIGINAL admission; never parsed completion DATA
+	closeAttempted                                       bool
+	closeErr                                             error
+	frame                                                *initialGuestNativeFrame
+	keys                                                 []*initialGuestKey
+	currentUser, lxss, selected                          *initialGuestKey
+	user                                                 []byte
