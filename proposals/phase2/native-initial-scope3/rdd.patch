+package managementconfig
+
+import (
+	"encoding/binary"
+	"errors"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+var ErrInitialGuestScope = errors.New("initial guest source unavailable or incomplete; preserved state requires scoped recovery")
+
+const initialGuestArchiveMaximum uint64 = 64 << 30
+const initialGuestOutputBudget = 4096
+
+// Locator DATA only; the actual caller uses retained GetSystemDirectoryW output.
+func initialGuestSystemComponents(path string) (string, []string, bool) {
+	if len(path) < 4 || len(path) > 1024 || path[1] != ':' || path[2] != '\\' || !((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) || strings.ContainsAny(path[2:], ":/\x00") {
+		return "", nil, false
+	}
+	parts := strings.Split(path[3:], `\`)
+	if len(parts) < 2 || len(parts) > 32 || !strings.EqualFold(parts[len(parts)-1], "System32") {
+		return "", nil, false
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") || strings.ContainsAny(part, `<>"|?*`) {
+			return "", nil, false
+		}
+	}
+	return path[:3], parts, true
+}
+
+// Negative cache only. Local native settlement cannot certify guest absence.
+func initialGuestParentRelease(closed, originalImportEntered bool) bool {
+	return closed && !originalImportEntered
+}
+
+// DATA recipe, never permission. Only the native scope supplies its original
+// instance path to this private fixed-role constructor.
+func initialGuestImportArgs(instance string) []string {
+	if len(instance) < 4 || len(instance) > 900 || instance[1] != ':' || instance[2] != '\\' || strings.ContainsAny(instance[2:], ":/\x00") {
+		return nil
+	}
+	parts := strings.Split(instance[3:], `\`)
+	for _, p := range parts {
+		if p == "" || p == "." || p == ".." {
+			return nil
+		}
+	}
+	if len(parts) < 3 || parts[len(parts)-3] != ".rdorbwin" || parts[len(parts)-2] != "lima" || parts[len(parts)-1] != "orbwin" {
+		return nil
+	}
+	return []string{"--import", "lima-orbwin", instance, instance + `\basedisk`, "--version", "2"}
+}
+func initialGuestSIDBytes(value string) ([]byte, bool) {
+	p := strings.Split(value, "-")
+	if len(p) < 4 || len(p) > 18 || p[0] != "S" || p[1] != "1" {
+		return nil, false
+	}
+	authority, e := strconv.ParseUint(p[2], 10, 48)
+	if e != nil || strconv.FormatUint(authority, 10) != p[2] {
+		return nil, false
+	}
+	b := make([]byte, 8+4*(len(p)-3))
+	b[0] = 1
+	b[1] = byte(len(p) - 3)
+	for i := 0; i < 6; i++ {
+		b[7-i] = byte(authority)
+		authority >>= 8
+	}
+	for i, s := range p[3:] {
+		n, e := strconv.ParseUint(s, 10, 32)
+		if e != nil || strconv.FormatUint(n, 10) != s {
+			return nil, false
+		}
+		for j := 0; j < 4; j++ {
+			b[8+4*i+j] = byte(n)
+			n >>= 8
+		}
+	}
+	return b, true
+}
+
+type initialGuestCommandState struct{ entered, returned, captured, waitEntered, waitReturned, failed, unknown bool }
+
+func (s *initialGuestCommandState) begin() bool {
+	if s.entered || s.failed || s.unknown {
+		return false
+	}
+	s.entered = true
+	return true
+}
+func (s *initialGuestCommandState) started(known, success bool) bool {
+	if !s.entered || s.returned || s.unknown {
+		return false
+	}
+	s.returned = true
+	if !known {
+		s.unknown = true
+		s.failed = true
+		return false
+	}
+	if !success {
+		s.failed = true
+		return false
+	}
+	return true
+}
+func (s *initialGuestCommandState) capture(known bool) bool {
+	if !s.returned || s.failed || s.unknown || s.captured {
+		return false
+	}
+	if !known {
+		s.unknown = true
+		s.failed = true
+		return false
+	}
+	s.captured = true
+	return true
+}
+func (s *initialGuestCommandState) beginWait() bool {
+	if !s.captured || s.waitEntered || s.unknown {
+		return false
+	}
+	s.waitEntered = true
+	return true
+}
+func (s *initialGuestCommandState) waited(known, success bool) bool {
+	if !s.waitEntered || s.waitReturned {
+		return false
+	}
+	s.waitReturned = true
+	if !known {
+		s.unknown = true
+	}
+	if !known || !success {
+		s.failed = true
+		return false
+	}
+	return !s.unknown && !s.failed
+}
+func (s *initialGuestCommandState) settled() bool {
+	return !s.unknown && (!s.entered && s.failed || s.waitReturned)
+}
+
+// Only live bytes are bounded; no lifetime frame/chunk counter or restart cap.
+type initialGuestStreamState struct {
+	bytes         uint64
+	request       int
+	busy, unknown bool
+}
+
+func (s *initialGuestStreamState) begin(n int) bool {
+	if s.busy || s.unknown || n < 0 || s.bytes > initialGuestArchiveMaximum || uint64(n) > initialGuestArchiveMaximum-s.bytes {
+		return false
+	}
+	s.busy = true
+	s.request = n
+	return true
+}
+func (s *initialGuestStreamState) settle(n int, known bool) bool {
+	if !s.busy || s.unknown {
+		return false
+	}
+	if !known || n < 0 || n > s.request {
+		s.unknown = true
+		return false
+	}
+	s.busy = false
+	s.bytes += uint64(n)
+	return true
+}
+
+type initialGuestOutput struct {
+	mu   sync.Mutex
+	tail []byte
+}
+
+func (b *initialGuestOutput) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	n := len(p)
+	if n >= initialGuestOutputBudget {
+		b.tail = append(b.tail[:0], p[n-initialGuestOutputBudget:]...)
+	} else {
+		extra := len(b.tail) + n - initialGuestOutputBudget
+		if extra > 0 {
+			copy(b.tail, b.tail[extra:])
+			b.tail = b.tail[:len(b.tail)-extra]
+		}
+		b.tail = append(b.tail, p...)
+	}
+	return n, nil
+}
+
+// Fixed FILE_LINK_INFORMATION DATA. Native owner copies into aligned retained
+// words before entry. No caller name/flags/parent or ReplaceIfExists input.
+func initialGuestLinkRecord() []byte {
+	name := "basedisk"
+	b := make([]byte, 20+2*len(name))
+	binary.LittleEndian.PutUint32(b[16:20], uint32(2*len(name)))
+	for j, u := range []byte(name) {
+		binary.LittleEndian.PutUint16(b[20+2*j:], uint16(u))
+	}
+	return b
+}
+func initialGuestLinkReply(raw, status, information uintptr) (known, success bool) {
+	if uint32(raw) == 0x103 || uint32(status) == 0x103 {
+		return false, false
+	}
+	return true, uint32(raw) == 0 && uint32(status) == 0 && information == 0
+}
+func initialGuestRegistryReply(raw uintptr) (uint32, bool) { return uint32(raw), uint32(raw) == 997 }
+
+// Match the existing native storage16KiB per-call budget; the Windows compile
+// guard asserts equality. This bounds a reusable cell, not archive lifetime.
+const initialGuestNativeChunkBudget = 16 << 10
+
+func initialGuestNativeChunk(remaining uint64) int {
+	if remaining > initialGuestNativeChunkBudget {
+		return initialGuestNativeChunkBudget
+	}
+	return int(remaining)
+}
+
+type initialGuestOwnedWriteCell struct {
+	data          []byte
+	busy, unknown bool
+}
+
+func (c *initialGuestOwnedWriteCell) copyInput(borrowed []byte) ([]byte, bool) {
+	if c.busy || c.unknown || len(borrowed) == 0 || len(borrowed) > initialGuestNativeChunkBudget {
+		return nil, false
+	}
+	if cap(c.data) < len(borrowed) {
+		c.data = make([]byte, len(borrowed))
+	} else {
+		c.data = c.data[:len(borrowed)]
+	}
+	copy(c.data, borrowed)
+	c.busy = true
+	return c.data, true
+}
+func (c *initialGuestOwnedWriteCell) settle(positive bool) bool {
+	if !c.busy || c.unknown {
+		return false
+	}
+	if !positive {
+		c.unknown = true
+		return false
+	}
+	c.busy = false
+	return true
+}
+
+type initialGuestFileLinkRole uint8
+
+const (
+	initialGuestPrivateSingleLink initialGuestFileLinkRole = iota + 1
+	initialGuestOriginalArchivePair
+	initialGuestActualSystemCode
+)
+
+func initialGuestLinksAllowed(role initialGuestFileLinkRole, count uint32) bool {
+	switch role {
+	case initialGuestPrivateSingleLink:
+		return count == 1
+	case initialGuestOriginalArchivePair:
+		return count == 2
+	case initialGuestActualSystemCode:
+		return count > 0
+	default:
+		return false
+	}
+}
