+package negativeguard
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func fact(id uint32) Fact { return Fact{Object: Object{Volume: 1, Low: id}, Descriptor: [32]byte{1}} }
+func witness(id uint32) Witness {
+	return Witness{Object: fact(id).Object, Size: 1, Written: 1, Descriptor: [32]byte{1}, Body: [32]byte{1}}
+}
+func source(initial bool) Source {
+	s := Source{Kind: "existing-writer", Private: fact(1), Public: fact(2), Controller: fact(3), Authority: fact(4), AuthorityLock: fact(5), Intent: witness(6), Seed: Seed{Object: fact(7).Object, Descriptor: [32]byte{1}, Written: 1, Binding: strings.Repeat("01", 32)}, Admission: witness(8), Committed: witness(9), ServingImage: witness(12)}
+	if initial {
+		s.Kind = "initial-fresh"
+		s.Authority = Fact{}
+		s.AuthorityLock = Fact{}
+		s.Admission = Witness{}
+		s.Committed = Witness{}
+	}
+	return s
+}
+func observe(id uint32, b []byte) Observation {
+	w := witness(id)
+	w.Size = uint64(len(b))
+	w.Body = sha256.Sum256(b)
+	return Observation{Body: b, File: w}
+}
+func profile(t *testing.T) Observation {
+	t.Helper()
+	b, e := EncodeProfile(Profile{1, Purpose, 1, source(true)})
+	if e != nil {
+		t.Fatal(e)
+	}
+	return observe(21, b)
+}
+func makeSlot(t *testing.T, pr Observation, g uint64, prev Slot, done bool) Slot {
+	t.Helper()
+	p := Pending{Schema: 1, Purpose: Purpose, Generation: g, Phase: "guest-lifetime-pending", Profile: pr.File, Directory: fact(20), Source: source(g == 1), GuestProfileDigest: [32]byte{1}, RecipeDigest: [32]byte{2}, OperationNonce: [16]byte{3}}
+	if g > 1 {
+		p.PreviousPending = prev.Pending.File
+		p.PreviousComplete = prev.Complete.File
+		if p.PreviousPending == (Witness{}) {
+			p.PreviousPending = witness(500)
+			p.PreviousComplete = witness(501)
+		}
+	}
+	b, e := EncodePending(p)
+	if e != nil {
+		t.Fatal(e)
+	}
+	s := Slot{Pending: observe(uint32(100+g*2), b)}
+	if done {
+		c := Complete{Schema: 1, Purpose: Purpose, Generation: g, Phase: "same-live-owner-completed", Outcome: "no-guest-effect", Profile: pr.File, Directory: fact(20), Pending: s.Pending.File, OriginalSource: p.Source, LedgerDigest: [32]byte{1}, RetirementDigest: [32]byte{2}}
+		b, e = EncodeComplete(c)
+		if e != nil {
+			t.Fatal(e)
+		}
+		s.Complete = observe(uint32(101+g*2), b)
+	}
+	return s
+}
+func arrangement(s ...Slot) [2]Slot {
+	var out [2]Slot
+	for _, r := range s {
+		p, _ := ParsePending(r.Pending.Body)
+		out[p.Generation%2] = r
+	}
+	return out
+}
+func TestCanonicalInitialReclaimedAndConsecutiveStates(t *testing.T) {
+	pr := profile(t)
+	one := makeSlot(t, pr, 1, Slot{}, false)
+	done1 := makeSlot(t, pr, 1, Slot{}, true)
+	two := makeSlot(t, pr, 2, done1, false)
