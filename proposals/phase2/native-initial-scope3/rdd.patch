+	count, e := s.owner.storage.transferStorage(s.basedisk.resource, extra, false)
+	if count != 0 || e != nil && e != windows.ERROR_HANDLE_EOF || !bytes.Equal(h.Sum(nil), s.archiveHash[:]) {
+		return ErrInitialGuestScope
+	}
+	return nil
+}
