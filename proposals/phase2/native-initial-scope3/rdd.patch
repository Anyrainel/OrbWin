+func (i *InitialGuestCreationScope) exact() (*nativeInitialGuestScope, error) {
+	if i == nil || i.native == nil || i.native.self != i {
+		return nil, ErrInitialGuestScope
+	}
+	return i.native, nil
+}
+
+// Parent Close reads only this negative cached barrier. It never waits for the
+// scope mutex or native work while holding ancestor locks.
+func (s *nativeInitialGuestScope) closedForParents(o *FreshSetupOwner, a *nativeManagedRuntimeAuthority) bool {
+	return s != nil && s.owner == o && s.authority == a && !s.unknown.Load() && initialGuestParentRelease(s.closed.Load(), s.importEntered.Load())
+}
+
+// Caller holds o -> publisher -> Created -> image -> authority -> storage.
+func (s *nativeInitialGuestScope) originalHeld() bool {
+	if s == nil || s.unknown.Load() || s.closed.Load() || s.owner == nil || s.authority == nil {
+		return false
+	}
+	o, a := s.owner, s.authority
+	return o.initialGuestScope == s && a.initialGuestScope == s && initialGuestParentsHeld(o, a) && s.guard != nil && o.guestGuard == s.guard && s.guard.owner == o && s.guard.err == nil && s.guard.sequence.durable && !s.guard.sequence.failed && s.guard.originalLocked() && s.guard.imageHash == a.image.image.Hash
