+	}
+	f := filepath.Join(root, "pkg/service/cmd/fresh_setup_windows.go")
+	assertCallBefore(t, functionCalls(t, f, "RunFreshSetupOperation"), "RequireGuestMutationBeforeOptions", "newFreshProtocolIO")
