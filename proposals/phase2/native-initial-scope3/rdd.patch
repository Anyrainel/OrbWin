+func guestSourceRoot(t *testing.T) string {
+	t.Helper()
+	_, p, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("source")
+	}
+	return filepath.Clean(filepath.Join(filepath.Dir(p), "../.."))
+}
+func functionCalls(t *testing.T, path, name string) []string {
+	t.Helper()
+	f, e := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var calls []string
+	found := false
+	for _, d := range f.Decls {
+		fn, ok := d.(*ast.FuncDecl)
+		if !ok || fn.Name.Name != name {
+			continue
+		}
+		found = true
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			c, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			switch x := c.Fun.(type) {
+			case *ast.Ident:
+				calls = append(calls, x.Name)
+			case *ast.SelectorExpr:
+				calls = append(calls, x.Sel.Name)
+			}
+			return true
+		})
+	}
+	if !found {
+		t.Fatal("missing actual source function", name)
+	}
+	return calls
+}
+func assertCallBefore(t *testing.T, calls []string, a, b string) {
+	t.Helper()
+	ia, ib := -1, -1
+	for i, v := range calls {
+		if v == a && ia < 0 {
+			ia = i
+		}
+		if v == b && ib < 0 {
+			ib = i
+		}
+	}
+	if ia < 0 || ib < 0 || ia >= ib {
+		t.Fatalf("actual source edge %s before %s: %v", a, b, calls)
+	}
+}
