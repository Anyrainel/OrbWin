+type initialGuestArchiveWriter struct {
+	scope    *nativeInitialGuestScope
+	ctx      context.Context
+	resource *runtimeStorageResource
+	hash     hash.Hash
+}
+
+func (w *initialGuestArchiveWriter) Write(body []byte) (int, error) {
+	s := w.scope
+	if len(body) == 0 {
+		return 0, nil
+	}
+	if !s.originalHeld() || !freshBoundedContext(w.ctx) || !s.stream.begin(len(body)) {
+		return 0, ErrInitialGuestScope
+	}
+	total := 0
+	for total < len(body) {
+		if !freshBoundedContext(w.ctx) {
+			s.stream.settle(total, true)
+			e := w.ctx.Err()
+			if e == nil {
+				e = ErrInitialGuestScope
+			}
+			return total, e
+		}
+		size := initialGuestNativeChunk(uint64(len(body) - total))
+		// io.Writer p is BORROWED, including after an error return. Publish an
+		// independent scope-owned copy BEFORE native storage retains its slice.
+		owned, ok := s.writeCell.copyInput(body[total : total+size])
+		if !ok {
+			s.stream.settle(total, false)
+			return total, s.fail()
+		}
+		count, e := s.owner.storage.transferStorage(w.resource, owned, true)
+		if e != nil || count != uint32(len(owned)) {
+			s.writeCell.settle(false)
+			s.stream.settle(total, false)
+			if count <= uint32(len(owned)) {
+				total += int(count)
+			}
+			return total, s.fail()
+		}
+		// Only positively completed COPIED bytes contribute to the digest.
+		w.hash.Write(owned)
+		if !s.writeCell.settle(true) {
+			s.stream.settle(total, false)
+			return total, s.fail()
+		}
+		total += int(count)
+	}
+	if !s.stream.settle(total, true) {
+		return total, s.fail()
+	}
+	return total, nil
+}
+func (s *nativeInitialGuestScope) linkBasedisk(ctx context.Context, image *runtimeStorageObject) error {
+	if !s.originalHeld() || !freshBoundedContext(ctx) || image == nil || len(s.directories) != 4 {
+		return ErrInitialGuestScope
+	}
+	f := s.newFrame()
+	if f == nil {
+		return ErrInitialGuestScope
+	}
+	// RootDirectory=NULL selects the SAME original source file's parent;
+	// fixed sibling basedisk only, no Replace/DELETE/other-file role.
+	record := initialGuestLinkRecord()
+	length := len(record)
+	f.words = make([]uint64, (length+7)/8)
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), len(f.words)*8), record)
+	if !freshBoundedContext(ctx) {
+		return ErrInitialGuestScope
+	}
+	f.entered = true
+	f.raw, _, _ = initialGuestSetInformation.Call(uintptr(image.resource.handle), uintptr(unsafe.Pointer(&f.io)), uintptr(unsafe.Pointer(&f.words[0])), uintptr(length), 11)
