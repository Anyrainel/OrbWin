+		return nil, 0, e
+	}
+	if f.count > uint32(len(f.words)*8) {
+		return nil, 0, ErrInitialGuestScope
+	}
+	return append([]byte(nil), unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), int(f.count))...), f.kind, nil
+}
+func (s *nativeInitialGuestScope) closeKey(k *initialGuestKey) error {
+	if k == nil || k.handle == 0 {
+		return nil
+	}
+	if k.closeAttempted {
+		return ErrInitialGuestScope
+	}
+	k.closeAttempted = true
+	f := s.newFrame()
+	if f == nil {
+		return ErrInitialGuestScope
+	}
+	f.entered = true
+	f.raw, _, _ = initialGuestRegClose.Call(uintptr(k.handle))
+	if s.status(f) != nil {
+		return s.fail()
+	}
+	k.handle = 0
+	return nil
+}
+func (s *nativeInitialGuestScope) ensureLxss(ctx context.Context) error {
+	if s.currentUser == nil {
+		root, e := s.openKey(nil, "")
+		if e != nil {
+			return ErrInitialGuestScope
+		}
+		s.currentUser = root
+	}
+	if s.lxss != nil {
+		return s.checkKey(s.lxss)
+	}
+	parent := s.currentUser
+	for _, name := range []string{"Software", "Microsoft", "Windows", "CurrentVersion", "Lxss"} {
+		if !freshBoundedContext(ctx) {
+			return ErrInitialGuestScope
+		}
+		k, e := s.openKey(parent, name)
+		if e != nil {
+			return e
+		}
+		parent = k
+	}
+	s.lxss = parent
+	return nil
+}
