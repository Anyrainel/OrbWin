+// Absence is only one observation in the original scope; never an import grant.
+// This never changes registry data and never adopts after an import error.
+func (s *nativeInitialGuestScope) captureRegistration(ctx context.Context, expectPresent bool) error {
+	if !freshBoundedContext(ctx) {
+		return ErrInitialGuestScope
+	}
+	e := s.ensureLxss(ctx)
+	if e == windows.ERROR_FILE_NOT_FOUND || e == windows.ERROR_PATH_NOT_FOUND {
+		if expectPresent {
+			return ErrInitialGuestScope
+		}
+		return nil
+	}
+	if e != nil {
+		return ErrInitialGuestScope
+	}
+	found := false
+	for index := uint32(0); index <= 512; index++ {
+		if !freshBoundedContext(ctx) {
+			return ErrInitialGuestScope
+		}
+		f := s.newFrame()
+		if f == nil {
+			return ErrInitialGuestScope
+		}
+		f.text = make([]uint16, 64)
+		f.count = uint32(len(f.text))
+		f.entered = true
+		f.raw, _, _ = managedRegEnum.Call(uintptr(s.lxss.handle), uintptr(index), uintptr(unsafe.Pointer(&f.text[0])), uintptr(unsafe.Pointer(&f.count)), 0, 0, 0, 0)
+		e = s.status(f)
+		if e == windows.ERROR_NO_MORE_ITEMS {
+			if found != expectPresent {
+				return ErrInitialGuestScope
+			}
+			return s.checkKey(s.lxss)
+		}
+		if e != nil || index == 512 || f.count == 0 || f.count >= uint32(len(f.text)) {
+			return ErrInitialGuestScope
+		}
+		guid := strings.ToLower(windows.UTF16ToString(f.text[:f.count]))
+		if !freshRuntimeGUID(guid) {
+			return ErrInitialGuestScope
+		}
+		key, e := s.openKey(s.lxss, guid)
+		if e != nil {
+			return ErrInitialGuestScope
+		}
+		body, kind, e := s.value(key, "DistributionName")
+		if e != nil || kind != windows.REG_SZ {
+			return ErrInitialGuestScope
+		}
+		name, e := inspectionRegistryString(body)
+		if e != nil {
+			return ErrInitialGuestScope
+		}
+		if runtimeFreshOwnedRegistrationName(name) {
+			if !expectPresent || found {
+				return ErrInitialGuestScope
+			}
+			found = true
+			body, kind, e = s.value(key, "BasePath")
+			if e != nil || kind != windows.REG_SZ {
+				return ErrInitialGuestScope
+			}
+			base, e := inspectionRegistryString(body)
+			if e != nil {
+				return ErrInitialGuestScope
+			}
+			body, kind, e = s.value(key, "Version")
+			if e != nil || kind != windows.REG_DWORD || len(body) != 4 || !runtimeFreshGuestRegistrationMatches(name, base, s.owner.storage.home, binary.LittleEndian.Uint32(body)) {
+				return ErrInitialGuestScope
+			}
+			s.selected = key
+		} else {
+			if s.closeKey(key) != nil {
+				return ErrInitialGuestScope
+			}
+			if len(s.keys) == 0 || s.keys[len(s.keys)-1] != key {
+				return s.fail()
+			}
+			s.keys = s.keys[:len(s.keys)-1]
+		}
+	}
+	return ErrInitialGuestScope
