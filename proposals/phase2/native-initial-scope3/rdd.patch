+func (*InitialGuestCreationScope) String() string   { return "original initial guest creation scope" }
+func (*InitialGuestCreationScope) GoString() string { return "original initial guest creation scope" }
+func (s *nativeInitialGuestScope) fail() error {
+	s.unknown.Store(true)
+	s.authority.image.managedUnknown.Store(true)
+	runtimeStorageDomain.Lock()
+	runtimeStorageDomain.failed = true
+	runtimeStorageDomain.Unlock()
+	return ErrInitialGuestScope
