+func (s *nativeInitialGuestScope) openKey(parent *initialGuestKey, name string) (*initialGuestKey, error) {
+	f := s.newFrame()
+	if f == nil {
+		return nil, ErrInitialGuestScope
+	}
+	k := &initialGuestKey{}
+	f.key = k
+	s.keys = append(s.keys, k)
+	var e error
+	f.text, e = windows.UTF16FromString(name)
+	if e != nil {
+		return nil, ErrInitialGuestScope
+	}
+	f.entered = true
+	if parent == nil {
+		k.name = `\REGISTRY\USER\` + s.owner.storage.sid
+		f.raw, _, _ = inspectionOpenCurrentUser.Call(windows.KEY_READ, uintptr(unsafe.Pointer(&k.handle)))
+	} else {
+		k.name = parent.name + `\` + name
+		f.raw, _, _ = managedRegOpenKey.Call(uintptr(parent.handle), uintptr(unsafe.Pointer(&f.text[0])), 8, windows.KEY_READ, uintptr(unsafe.Pointer(&k.handle)))
+	}
+	e = s.status(f)
+	if e != nil {
+		if s.unknown.Load() {
+			return nil, e
+		}
+		if k.handle != 0 {
+			return nil, s.fail()
+		}
+		s.keys = s.keys[:len(s.keys)-1]
+		return nil, e
+	}
+	if k.handle == 0 || k.handle == windows.InvalidHandle {
+		return nil, s.fail()
+	}
+	if s.checkKey(k) != nil {
+		return nil, ErrInitialGuestScope
+	}
+	return k, nil
+}
+func (s *nativeInitialGuestScope) checkKey(k *initialGuestKey) error {
+	if k == nil || k.handle == 0 || k.closeAttempted {
+		return ErrInitialGuestScope
+	}
+	f := s.newFrame()
+	if f == nil {
+		return ErrInitialGuestScope
+	}
+	f.words = make([]uint64, 512)
+	f.entered = true
+	f.raw, _, _ = inspectionQueryKey.Call(uintptr(k.handle), 3, uintptr(unsafe.Pointer(&f.words[0])), uintptr(len(f.words)*8), uintptr(unsafe.Pointer(&f.needed)))
+	f.returned = true
+	if uint32(f.raw) == 0x103 {
+		return s.fail()
+	}
+	if uint32(f.raw) != 0 || f.needed < 6 || f.needed > uint32(len(f.words)*8) {
+		return ErrInitialGuestScope
+	}
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&f.words[0])), int(f.needed))
+	size := binary.LittleEndian.Uint32(raw)
+	if size == 0 || size%2 != 0 || size+4 != f.needed {
+		return ErrInitialGuestScope
+	}
+	name, e := inspectionRegistryString(append(append([]byte(nil), raw[4:]...), 0, 0))
+	if e != nil || !strings.EqualFold(name, k.name) {
+		return ErrInitialGuestScope
+	}
+	_, _, e = s.value(k, "SymbolicLinkValue")
+	if e != windows.ERROR_FILE_NOT_FOUND {
+		return ErrInitialGuestScope
+	}
+	f = s.newFrame()
+	if f == nil {
+		return ErrInitialGuestScope
+	}
+	f.entered = true
+	f.raw, _, _ = inspectionGetKeySecurity.Call(uintptr(k.handle), 7, 0, uintptr(unsafe.Pointer(&f.needed)))
+	f.returned = true
+	if uint32(f.raw) == 997 {
+		return s.fail()
+	}
+	if uint32(f.raw) != 122 || f.needed < 20 || f.needed > inspectionSecurityLimit {
+		return ErrInitialGuestScope
+	}
+	capacity := f.needed
+	f.words = make([]uint64, (capacity+7)/8)
+	f.entered = true
+	f.returned = false
+	f.raw, _, _ = inspectionGetKeySecurity.Call(uintptr(k.handle), 7, uintptr(unsafe.Pointer(&f.words[0])), uintptr(unsafe.Pointer(&f.needed)))
+	if s.status(f) != nil || f.needed > capacity || f.needed < 20 {
+		return ErrInitialGuestScope
+	}
