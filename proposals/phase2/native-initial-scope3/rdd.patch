+func (n *nativeGuestNegativeRead) close() (result error) {
+	if n.closed {
+		return n.closeErr
+	}
+	if !n.original() || n.closing {
+		return ErrGuestNegative
+	}
+	n.closing = true
+	n.closeErr = ErrGuestNegative
+	defer func() {
+		if recover() != nil {
+			n.fence()
+			result = ErrGuestNegative
+		}
+	}()
+	for _, f := range n.frames {
+		if f.entered && !f.returned {
+			n.fence()
+			return ErrGuestNegative
+		}
+	}
+	if n.selection != nil && n.selection.KnownForReadOnlyInspection() != nil {
+		n.fence()
+		return ErrGuestNegative
+	}
+	for i := len(n.frames) - 1; i >= 0; i-- {
+		f := n.frames[i]
+		if f.handle == 0 {
+			continue
+		}
+		if f.closeAttempted {
+			n.fence()
+			return ErrGuestNegative
+		}
+		f.closeAttempted = true
+		f.raw, _, f.err = guestNegativeClose.Call(uintptr(f.handle))
+		f.closeReturned = true
+		if uint32(f.raw) == 0 {
+			n.fence()
+			return ErrGuestNegative
+		}
+		f.handle = 0
+	}
+	if n.selection != nil && n.selection.Close() != nil {
+		n.fence()
+		return ErrGuestNegative
+	}
+	n.closed = true
+	n.closeErr = nil
+	guestNegativeReads.Lock()
+	delete(guestNegativeReads.owners, n)
+	guestNegativeReads.Unlock()
+	return nil
+}
+
+// Before-options negative cut ONLY. Missing producer/profile/pending refuses.
+// Native unknown never returns to an os.Exit caller; exact owner stays live.
+func RequireGuestNegativeBeforeOptions(ctx context.Context) (failure error) {
+	if runtime.GOARCH != "amd64" || !freshBoundedContext(ctx) {
+		guestNegativeWaitForKnownExit()
+		return ErrGuestNegative
+	}
+	n := &nativeGuestNegativeRead{}
+	n.self = n
+	guestNegativeReads.Lock()
+	if guestNegativeReads.failed || len(guestNegativeReads.owners) >= 16 {
+		guestNegativeReads.Unlock()
+		guestNegativeWaitForKnownExit()
+		return ErrGuestNegative
+	}
+	guestNegativeReads.owners[n] = true
+	guestNegativeReads.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer runtime.KeepAlive(n)
+	defer func() {
+		if recover() != nil {
+			n.fence()
+			failure = ErrGuestNegative
+		}
+		if n.close() != nil {
+			n.fence()
+		}
+		guestNegativeWaitForKnownExit()
+	}()
+	return n.capture(ctx)
+}
+
+// Read consistency cannot mint the original same-process pending producer or
+// inherited schema2 endpoint. Refuse mutable entry until its real factory exists.
+func RequireGuestMutationBeforeOptions(ctx context.Context) error {
+	if RequireGuestNegativeBeforeOptions(ctx) != nil {
+		return ErrGuestNegative
+	}
+	return requireGuestNegativeOriginalProducer()
+}
+
+// Cached conjunction only; never query/retry/close from keeper. A live normal
+// concurrent reader may positively settle; any sticky domain failure cannot.
+func guestNegativeWaitForKnownExit() {
+	for {
+		guestNegativeReads.Lock()
+		known := !guestNegativeReads.failed && len(guestNegativeReads.owners) == 0
+		guestNegativeReads.Unlock()
+		if known && authoritypath.ProductSelectionExitKnown() {
+			return
+		}
+		time.Sleep(time.Second)
+	}
+}
