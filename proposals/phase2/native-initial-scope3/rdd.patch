+//go:build windows
+
+package managementconfig
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"runtime"
+	"unsafe"
+
+	"github.com/rancher-sandbox/rancher-desktop-daemon/pkg/embedded"
+	negativeguard "github.com/rancher-sandbox/rancher-desktop-daemon/pkg/managementconfig/guestnegative"
+	"golang.org/x/sys/windows"
+)
+
+// Initial negative-only derivative: SAME Fresh owner and SAME storage closers.
+// No complete/reclaim/execution method, path/handle getter or parsed-DATA grant.
+// Caller holds o.mu -> image.mu -> n.mu. Unknown retains that original graph.
+type nativeInitialGuestGuard struct {
+	owner                         *FreshSetupOwner
+	archive                       string
+	imageHash                     [32]byte
+	profileDigest, recipeDigest   [32]byte
+	sequence                      guestInitialGuardSequence
+	queries                       []*initialGuestGuardQuery
+	fullIDs                       map[*runtimeStorageResource][24]byte
+	guard, slot, profile, pending *runtimeStorageObject
+	profileBody, pendingBody      []byte
+	source                        negativeguard.Source
+	err                           error
+}
+type initialGuestGuardQuery struct {
+	input             windows.Handle // borrowed actual input; never another closer
+	info              windows.ByHandleFileInformation
+	alignment         uint64
+	full              [24]byte
+	kind              uint32
+	sd                *windows.SECURITY_DESCRIPTOR
+	entered, returned bool
+	err               error
+}
+
+func (g *nativeInitialGuestGuard) originalLocked() bool {
+	if g == nil || g.owner == nil || g.owner.guestGuard != g || g.owner.self != g.owner || g.owner.closed || g.owner.unknown || g.owner.storage == nil || g.sequence.unknown {
+		return false
+	}
+	o := g.owner
+	freshSetupOwners.Lock()
+	registered := freshSetupOwners.owners[o]
+	freshSetupOwners.Unlock()
+	return registered && o.nativeOutputsAdmittedLocked() && o.image != nil && servingImageCaptureKnown(o.image)
+}
+func (g *nativeInitialGuestGuard) failLocked(unknown bool) error {
+	g.err = ErrGuestNegative
+	g.sequence.failed = true
+	if unknown {
+		g.sequence.unknown = true
+		g.owner.unknown = true
+		g.owner.storage.fence()
+	}
+	return ErrGuestNegative
+}
+
+// Pure cached barrier checked BEFORE Fresh Close's first native/ancestor suffix.
+func (o *FreshSetupOwner) initialGuestGuardCloseKnownLocked() bool {
+	g := o.guestGuard
+	if g == nil {
+		return true
+	}
+	if g.owner != o || !g.sequence.closeKnown() {
+		return false
+	}
+	for _, q := range g.queries {
+		if q == nil || q.entered && !q.returned {
+			return false
+		}
+	}
+	return true
+}
+func (g *nativeInitialGuestGuard) queryLocked(h windows.Handle) *initialGuestGuardQuery {
+	if !g.originalLocked() || h == 0 || h == windows.InvalidHandle || len(g.queries) >= 128 {
+		return nil
+	}
+	q := &initialGuestGuardQuery{input: h}
+	g.queries = append(g.queries, q)
+	return q
+}
+func (g *nativeInitialGuestGuard) afterQueryLocked(q *initialGuestGuardQuery, e error) error {
+	q.err, q.returned = e, true
+	if e == windows.ERROR_IO_PENDING || e == windows.STATUS_PENDING {
+		return g.failLocked(true)
+	}
+	if e != nil {
+		return ErrGuestNegative
+	}
+	return nil
+}
+
+// New native outputs are retained before entry. Accepted SD policy and its
+// synchronous allocation/copy wrapper contract are reused without new exemptions.
+func (g *nativeInitialGuestGuard) measureLocked(ctx context.Context, r *runtimeStorageResource, directory, private bool) (*runtimeStorageObject, error) {
+	if !freshBoundedContext(ctx) || !g.originalLocked() || r == nil || r.attempted || r.handle == 0 {
+		return nil, ErrGuestNegative
+	}
+	n, image := g.owner.storage, g.owner.image
+	owned := false
+	for _, v := range n.resources {
+		owned = owned || v == r
+	}
+	if len(image.resources) > 0 && len(image.chain) > 0 && image.resources[len(image.resources)-1] == r && r.handle == image.chain[len(image.chain)-1] {
+		owned = true
+	}
+	if !owned {
+		return nil, ErrGuestNegative
+	}
+	q := g.queryLocked(r.handle)
+	if q == nil {
+		return nil, ErrGuestNegative
+	}
+	q.entered = true
+	if g.afterQueryLocked(q, windows.GetFileInformationByHandle(q.input, &q.info)) != nil {
+		return nil, ErrGuestNegative
+	}
+	info := q.info
+	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory || !directory && info.NumberOfLinks != 1 {
+		return nil, ErrGuestNegative
+	}
+	q = g.queryLocked(r.handle)
+	if q == nil {
+		return nil, ErrGuestNegative
+	}
+	q.entered = true
+	if g.afterQueryLocked(q, windows.GetFileInformationByHandleEx(q.input, windows.FileIdInfo, &q.full[0], 24)) != nil || !inspectionFullIDKnown(q.full) {
+		return nil, ErrGuestNegative
+	}
+	full := q.full
+	if old, present := g.fullIDs[r]; present && old != full {
+		return nil, ErrGuestNegative
+	}
+	if g.fullIDs == nil {
+		g.fullIDs = make(map[*runtimeStorageResource][24]byte)
+	}
+	g.fullIDs[r] = full
+	q = g.queryLocked(r.handle)
+	if q == nil {
+		return nil, ErrGuestNegative
+	}
+	q.entered = true
+	q.kind, q.err = windows.GetFileType(q.input)
+	if g.afterQueryLocked(q, q.err) != nil || q.kind != windows.FILE_TYPE_DISK {
+		return nil, ErrGuestNegative
+	}
+	if private {
+		if verifyPrivate(r.handle, n.sid, directory) != nil {
+			return nil, ErrGuestNegative
+		}
+	} else if checkReadObject(r.handle, n.sid, directory) != nil {
+		return nil, ErrGuestNegative
+	}
+	q = g.queryLocked(r.handle)
+	if q == nil {
+		return nil, ErrGuestNegative
+	}
+	q.entered = true
+	q.sd, q.err = windows.GetSecurityInfo(q.input, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if g.afterQueryLocked(q, q.err) != nil || q.sd == nil {
+		return nil, ErrGuestNegative
+	}
+	size := q.sd.Length()
+	control, _, e := q.sd.Control()
+	if e != nil || control&windows.SE_SELF_RELATIVE == 0 || size < 20 || size > 65536 {
+		return nil, ErrGuestNegative
+	}
+	id := runtimeStorageIdentity{volume: info.VolumeSerialNumber, high: info.FileIndexHigh, low: info.FileIndexLow, attributes: info.FileAttributes, links: info.NumberOfLinks, size: uint64(info.FileSizeHigh)<<32 | uint64(info.FileSizeLow), written: info.LastWriteTime, descriptor: sha256.Sum256(unsafe.Slice((*byte)(unsafe.Pointer(q.sd)), int(size)))}
+	if directory {
+		id.size = 0
+		id.written = windows.Filetime{}
+	}
+	return &runtimeStorageObject{resource: r, identity: id, directory: directory, private: private}, nil
+}
+func initialGuestGuardFact(o *runtimeStorageObject) negativeguard.Fact {
+	return negativeguard.Fact{Object: negativeguard.Object{Volume: o.identity.volume, High: o.identity.high, Low: o.identity.low}, Descriptor: o.identity.descriptor}
+}
+func initialGuestGuardWitness(o *runtimeStorageObject, body []byte) negativeguard.Witness {
+	f := initialGuestGuardFact(o)
+	return negativeguard.Witness{Object: f.Object, Size: o.identity.size, Written: uint64(o.identity.written.HighDateTime)<<32 | uint64(o.identity.written.LowDateTime), Descriptor: f.Descriptor, Body: sha256.Sum256(body)}
+}
+func (g *nativeInitialGuestGuard) openLocked(ctx context.Context, parent *runtimeStorageObject, name string, directory bool, disposition, access, share uint32) (*runtimeStorageObject, error) {
+	if !g.originalLocked() || !freshBoundedContext(ctx) || parent == nil {
+		return nil, ErrGuestNegative
+	}
+	sd, e := privateDescriptor(g.owner.storage.sid, directory)
+	if e != nil {
+		return nil, ErrGuestNegative
+	}
+	if disposition == windows.FILE_OPEN {
+		sd = nil
+	}
+	n := g.owner.storage
+	if !freshBoundedContext(ctx) {
+		return nil, ErrGuestNegative
+	}
+	h, e := n.open(parent.resource.handle, name, directory, disposition, access, share, sd)
+	if e != nil {
+		return nil, e
+	}
+	r := n.keep(h) // exact output attachment, sole original storage closer
+	return g.measureLocked(ctx, r, directory, true)
+}
+func (g *nativeInitialGuestGuard) barrierLocked(ctx context.Context, o *runtimeStorageObject) error {
+	if !g.originalLocked() || !freshBoundedContext(ctx) || o == nil {
+		return ErrGuestNegative
+	}
+	return g.owner.storage.flushStorage(o.resource)
+}
+func (g *nativeInitialGuestGuard) immutableRecordLocked(ctx context.Context, parent *runtimeStorageObject, name string, body []byte) (*runtimeStorageObject, error) {
+	if len(body) == 0 || len(body) > negativeguard.Budget {
+		return nil, ErrGuestNegative
+	}
+	n := g.owner.storage
+	writer, e := g.openLocked(ctx, parent, name, false, windows.FILE_CREATE, windows.FILE_READ_DATA|windows.FILE_WRITE_DATA, windows.FILE_SHARE_READ)
+	if e != nil {
+		return nil, e
+	}
+	if _, e = n.transferStorage(writer.resource, body, true); e != nil {
+		return nil, e
+	}
+	if g.barrierLocked(ctx, writer) != nil {
+		return nil, ErrGuestNegative
+	}
+	expected, e := g.measureLocked(ctx, writer.resource, false, true)
+	if e != nil {
+		return nil, e
+	}
+	if expected.identity.size != uint64(len(body)) {
+		return nil, ErrGuestNegative
+	}
+	// The original writer positively closes before immutable admission. Account
+	// only for documented writer-close timestamp finalization, then bind exact ID.
+	if n.closeTemporary(writer.resource) != nil {
+		return nil, ErrGuestNegative
+	}
+	reader, e := g.openLocked(ctx, parent, name, false, windows.FILE_OPEN, windows.FILE_READ_DATA, windows.FILE_SHARE_READ)
+	if e != nil || !runtimeStorageCreatedSame(reader.identity, expected.identity) || g.fullIDs[reader.resource] != g.fullIDs[writer.resource] {
+		return nil, ErrGuestNegative
+	}
+	actual, e := n.read(reader, false)
+	if e != nil || !bytes.Equal(actual, body) || !freshBoundedContext(ctx) {
+		return nil, ErrGuestNegative
+	}
+	measured, e := g.measureLocked(ctx, reader.resource, false, true)
+	if e != nil || measured.identity != reader.identity {
+		return nil, ErrGuestNegative
+	}
+	return reader, nil
+}
+
+// PrepareInitialGuestNegativeGuard creates only durable NEGATIVE evidence. It
+// does not relax any reader/guest/controller gate in this dormant source slice.
+// No caller path, digest, parsed record or future Created/publisher is accepted.
+func (o *FreshSetupOwner) PrepareInitialGuestNegativeGuard(ctx context.Context) (failure error) {
+	if o == nil || o.self != o || !freshBoundedContext(ctx) {
+		return ErrGuestNegative
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if !o.createdAdmissionLocked(ctx) || !o.legacyDenialReadyLocked() || o.guestGuard != nil || o.seed == nil || o.intent.Schema != 2 || o.storage.freshRecovery != nil {
+		return ErrGuestNegative
+	}
+	// Pure original publication BEFORE the first native proof or query.
+	g := &nativeInitialGuestGuard{owner: o, archive: embedded.Distro, err: ErrGuestNegative}
+	o.guestGuard = g
+	defer func() {
+		if recover() != nil {
+			o.fence()
+			g.sequence.unknown = true
+			g.sequence.failed = true
+			g.err = ErrGuestNegative
+			failure = ErrGuestNegative
+		}
+	}()
+	if g.archive == "" {
+		g.sequence.failed = true
+		return ErrGuestNegative
+	}
+	if o.origin.checkMappedSelf(ctx, o.intent.Transaction) != nil {
+		g.sequence.failed = true
+		return ErrGuestNegative
+	}
+	o.image.mu.Lock()
+	defer o.image.mu.Unlock()
+	n := o.storage
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	defer func() {
+		if recover() != nil {
+			g.failLocked(true)
+			failure = ErrGuestNegative
+		}
+		if failure != nil {
+			g.err = ErrGuestNegative
