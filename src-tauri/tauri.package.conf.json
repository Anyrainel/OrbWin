{
  "$schema": "https://schema.tauri.app/config/2",
  "build": { "beforeBuildCommand": "npm run package:prepare && npm run build" },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "An isolated Windows container development environment",
    "resources": { "../artifacts/package/runtime/": "runtime/" },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "OrbWin",
        "compression": "zlib",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": { "English": "installer-language.nsh" }
      }
    }
  }
}
